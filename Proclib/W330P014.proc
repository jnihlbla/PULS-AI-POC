//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SUMMERAR VECKOSTATISTIKEN TILL AF-OMFATTNINGAR                             
//*  KOMPLETTERAR MED MARKNADSBEGREPP SAMT KONCERN                              
//*                                                                             
//*                                                                             
//*  FREKVENS:     REDOVISNINGSPERIOD                                           
//*                        RTN W330R1                                           
//*                                                                             
//*  ÅTERSTART:    W33014   NORMAL                                              
//*                         LÄSER WDB2, WDB1 MED HJÄLP AV SUBPGM                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W330P014 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W330..W330V1,                                             
//             INDUT=&W330..W330R1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33014   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W33014,W33014,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY,DCB=(RECFM=VB,BLKSIZE=1408,BUFNO=1)                        
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATWEEK(+0),DISP=SHR            -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDB2     INCLUDE MEMBER=WDB2                                                  
//WDB1     INCLUDE MEMBER=WDB1                                                  
//W33014D1 DD  DSN=&INDIN..W33013(+0),DISP=SHR                                  
//************ VECKOSTATISTIK                                                   
//*                                                                             
//W33014D2 DD  DSN=&INDUT..W33015(+1),DISP=(NEW,CATLG,DELETE), -LIM(20)         
//************ VECKOSTATISTIKEN FÖRDELAD I AF-OMFATTNINGAR                      
//             MGMTCLAS=&BACKUPC,VOL=(,,,2),                                    
//             SPACE=(27998,(5000,3500),RLSE)                                   
//*                                                                             
