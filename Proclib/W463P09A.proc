//*                                                                             
//*  DIREKTLEVERANSUPPFÖLJNING TILL LEVERANTÖR                                  
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W463D1                                         
//*                                                                             
//*  RESTART:      W4639A    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W463P09A PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W463..W463D1,                                             
//             INDUT=&W463..W463D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W4639A   EXEC PGM=V16459,PARM='W4639A/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),DEST=LOCAL,HOLD=YES                             
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W4639AD1 DD  DSN=&INDIN..W46382(+0),DISP=SHR                                  
//************ FÖRSENADE ORDERRADER                                             
//*                                                                             
//W4639AD2 DD  DSN=&INDIN..W4639X,DISP=SHR                                      
//************ LEVERANSBESKED                                                   
//*                                                                             
//W4639AD3 DD  DSN=&INDUT..W4639A(+1),DISP=(NEW,CATLG,DELETE), -LIM(10)         
//************ OUTPUT FILE - ALL SUPPLIERS                                      
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEB                                 
