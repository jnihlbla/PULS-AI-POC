//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LÄSER INLEVERANSER R32                                                     
//*  SKAPAR LISTPOSTER ÖVER INLEVERANSER TILL NEDERLÄNDSK TULL                  
//*  SKAPAR POSTER FÖR FRAMSTÄLLNING AV FIL TILL INTRASTAT                      
//*                                                                             
//*  FREKVENS:     MÅNAD    RTN W611M1                                          
//*                                                                             
//*  ÅTERSTART:    W61170      NORMAL                                           
//*                LÄSER  WDL2 WDK6                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W611P070 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W611..W611M1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61170   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W61170,W61170,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDL2     INCLUDE MEMBER=WDL2                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//W61170D1 DD  DSN=&INDUT..W61168(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ LISTPOSTER INLEVERANSER C2                                       
//         SPACE=(35,(200,100),RLSE),AVGREC=K,                                  
//         MGMTCLAS=&DEL2BKPC                                                   
//*                                                                             
//W61170D2 DD  DSN=&INDUT..W61169(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ INLEVERANSER CDC FRÅN ANNAT EU-LAND                              
//         SPACE=(26,(300,100),RLSE),AVGREC=K,                                  
//         MGMTCLAS=&DEL2BKPC                                                   
//*                                                                             
