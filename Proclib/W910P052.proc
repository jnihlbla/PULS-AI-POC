//W910P052 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W910..W91054,                                            
//             INDIN2=&W910,                                                    
//             INDUT=&WUT..W91054,                                              
//             INDUT2=&W910..W91054                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W91052   EXEC PGM=V16459,PARM='W91052/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                                         
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(8192,(10000,1000))                                        
//SORTMSG  DD  SYSOUT=*                                                         
//W91052D1 DD  DSN=&INDIN1..W91052(+0),DISP=SHR                                 
//************ ARTIKEL-INFO TILL VR                                             
//*                                                                             
//W91052D2 DD  DSN=&INDIN2..W91056(+0),DISP=SHR                                 
//************ WDF2A1-EXTRAKT                                                   
//*                                                                             
//*                                                                             
//W91052D3 DD  DSN=&INDUT..W91054(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ ARTIKEL-INFO TILL VR                                             
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//COPY     EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDUT..W91054(+1),DISP=SHR                                  
//************                                                                  
//*                                                                             
//SYSUT2   DD  DSN=&INDUT2..W91054(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ FIL MED ARTIKELINFO TILL PGM W91051                              
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
