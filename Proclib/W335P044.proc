//W335P044 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W335..W335D5,                                             
//             INDUT=&W335..W335D5                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33544   EXEC PGM=W33544                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//W33544D1 DD  DSN=&INDIN..W33542(+0),DISP=SHR                                  
//************ EXTRAKT FRÅN 91042 WDK6 ÄNDRADE SEN SIST                         
//*                                                                             
//W33544D2 DD  DSN=&INDUT..W33543(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ ANTAL REC SOM SKALL SÄNDAS INNEHÅLLER ETT RECORD.                
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//W33544D3 DD  DSN=&INDUT..W33544(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED DEN INFO SOM SKALL SÄNDAS                              
