//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKRIVER LISTA, INLVERANSER C2 PER STATNR                                   
//*  SENASTE MÅNADEN                                                            
//*                                                                             
//*  FREKVENS:     MÅNAD    RTN W611M1                                          
//*                                                                             
//*  ÅTERSTART:    W61171    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W611P071 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W611..W611M1,                                             
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61171   EXEC PGM=V16459,PARM='W61171/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//*                                                                             
//OUT1  OUTPUT CLASS=A,FORMS=3803,FORMDEF=SLSR6C,PAGEDEF=SLSR6C                 
//*                                                                             
//W61171D1 DD  DSN=&INDIN..W61170(+0),DISP=SHR                                  
//************ LISTPOSTER, INLVERANSER C2 PER STATNR                            
//*                                                                             
//W61171D2 DD  SYSOUT=(,),OUTPUT=(*.OUT1),DEST=&DEST1                           
//************ W61171-001   LISTA,INLEVERANSER C2 PER STATNR SENASTE MÅN        
//************ W61171-001NL LISTA,INLEVERANSER C2 PER STATNR SENASTE MÅN        
//*                                                                             
