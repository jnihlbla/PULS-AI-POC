//*  SKAPAR ARTIKELINFO-LISTA MED HJÄLP AV PARAMETRAR=URVAL                     
//*  FRÅN BILD 2322                                                             
//*                                                                             
//*  FREKVENS:     FLERA GGR PER DAG     RTN W217S3                             
//*                                                                             
//*  ÅTERSTART:    W21710    NORMAL                                             
//*  ÅTERSTART:    W217J210                                                     
//*                HAR PARAMETRAR MED FRÅN SOP. SÅ                              
//*                LÄNGE SOM MAN EJ GÖR END PÅ JOBBET I SOP                     
//*                KAN JOBBET ÅTERSTARTAS. VID END ÄR PARAMETRARNA              
//*                FÖRLORADE. PARAMETRARNA DISPLAYAS I SYSOUTEN.                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W217P110 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W217..W217S4,                                             
//             INDUT=&WUT                                                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W217PD10),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W21709(+0),DISP=SHR                                  
//************ ARTIKELEXTRAKT                                                   
//*                                                                             
//SORTOUT  DD  DSN=&&W21709,DISP=(NEW,PASS,DELETE),                             
//************ SORTED ARTIKELEXTRAKT                                            
//             DATACLAS=PSEB                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W21710   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,DSNMTV01,W21710,,00')                                
//*            PARM=('&DBB,W21710,W21710,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                                         
//SYSPRINT DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//WDF5     INCLUDE MEMBER=WDF5                                                  
//WDD9     INCLUDE MEMBER=WDD9                                                  
//WDL2     INCLUDE MEMBER=WDL2                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//W6D1     INCLUDE MEMBER=W6D1                                                  
//W6H7     INCLUDE MEMBER=W6H7                                                  
//WDG2     INCLUDE MEMBER=WDG2                                                  
//WDA5     INCLUDE MEMBER=WDA5                                                  
//WDK7     INCLUDE MEMBER=WDK7                                                  
//WDK9     INCLUDE MEMBER=WDK9                                                  
//WDR2     INCLUDE MEMBER=WDR2                                                  
//WDB6     INCLUDE MEMBER=WDB6                                                  
//WDD7     INCLUDE MEMBER=WDD7                                                  
//WDL8     INCLUDE MEMBER=WDL8                                                  
//*                                                                             
//DDOTV02  DD  DSN=&&W21710BT,DISP=(NEW,PASS,DELETE),                           
//             SPACE=(TRK,(1,1),RLSE),                                          
//             DCB=(RECFM=VB,LRECL=4092)                                        
//DDITV02  DD  DSN=&INDRTE..CONSTANT(W21710I2),DISP=SHR                         
//*                                                                             
//W21710D1 DD  DUMMY                                                            
//************ PARAMETRAR FRÅN BILD 2322  (OVERRIDE I JCL)                      
//*                                                                             
//W21710D2 DD  DSN=&&W21709,DISP=(OLD,DELETE,DELETE)                            
//************ SORTED ARTIKELEXTRAKT                                            
//*                                                                             
//W21710D3 DD  DSN=&INDUT..W21710(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//************ FIL FÖR MAILSÄNDNING                                             
//             MGMTCLAS=NOBACKUP,DATACLAS=PSEN                                  
//*                                                                             
