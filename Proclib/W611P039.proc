//*                                                                             
//*  FREKVENS:     VECKA     RTN W611V3                                         
//*                                                                             
//*  ÅTERSTART:    W61139    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W611P039 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN2=&W271..W611V3,                                            
//             INDUT=&W611..W611V3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61139   EXEC PGM=W61139                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                    -- ABEND         
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W61139D1 DD  DSN=&INDIN2..W27112,DISP=SHR                                     
//************ VECKANS REFILLORDRAR                                             
//*                                                                             
//W61139D2 DD  DSN=&&W61139,DISP=(NEW,PASS,DELETE),                             
//************ REFILLORDAR MED IDDC                                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W611PD38),DISP=SHR                         
//SORTIN   DD  DSN=&&W61139,DISP=(OLD,DELETE,DELETE)                            
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W61139(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ SORTADE PÅ IDARTNR/IDDC                                          
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
