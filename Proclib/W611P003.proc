//W611P003 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=5                                                            
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61103   EXEC PGM=DFSRRC00,                                                   
