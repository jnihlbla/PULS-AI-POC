//*  SKAPAR VIPS-FIL ALT. LISTFIL INNEHÅLLANDE RETURVARNINGAR SAMT              
//*  UPPDATERAR DIVERSE FÄLT PÅ WDA2 (WLKREE)                                   
//*                                                                             
//*  FREKVENS:     EN GGR PER DAG    RTN W418D2                                 
//*                                                                             
//*  ÅTERSTART:    W41836    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W418P036 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=3,                                                           
//             INDUT=&W418..W418D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W41836   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W41836,W41836,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W41836D1 DD  DSN=&INDUT..W41870(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ VIPS-POSTER POSTTYP=RKJ                                          
//             SPACE=(25,(5,5),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&NOBACKUP                                               
//W41836D2 DD  DSN=&INDUT..W41871(+1),DISP=(NEW,CATLG,DELETE),  -LIM(2)         
//************ LIST-POSTER                                                      
//             SPACE=(25,(5,5),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
