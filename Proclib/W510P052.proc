//*                                                                             
//*  LÄSER NER SALDON FÖR SAMTLIGA ARTIKLAR FÖR SDC,USA OCH CANADA              
//*        OCH CHINA OCH SORTERAR DESSA PER ARTIKELNUMMER                       
//*                                                                             
//*  FREKVENS:     DAG    RTN W510D2                                            
//*                                                                             
//*  ÅTERSTART:    W51052 NORMAL                                                
//*                LÄSER  WDK7                                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W011P052 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W510..&RTEGRP.                                            
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51052   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W51052,W51052,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DUMMY                                                            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDB6     INCLUDE MEMBER=WDB6                                                  
//WDK7     INCLUDE MEMBER=WDK7                                                  
//W51052D1 DD  DSN=&INDUT..W51052(+1),DISP=(NEW,CATLG,DELETE),  -LIM(9)         
//************ SAMTLIGA ARTIKLAR FÖR USA OCH CANADA                             
//             DATACLAS=PSEB,MGMTCLAS=&BACKUPC                                  
//W51052D2 DD  DSN=&INDUT..W51053(+1),DISP=(NEW,CATLG,DELETE),  -LIM(9)         
//************ SAMTLIGA ARTIKLAR FÖR SDC-LAGREN                                 
//             DATACLAS=PSEB,MGMTCLAS=&BACKUPC                                  
//W51052D3 DD  DSN=&INDUT..W5105C(+1),DISP=(NEW,CATLG,DELETE),  -LIM(9)         
//************ SAMTLIGA ARTIKLAR FÖR CHINA-LAGREN                               
//             DATACLAS=PSEB,MGMTCLAS=&BACKUPC                                  
//W51052D4 DD  DSN=&INDUT..W5105D(+1),DISP=(NEW,CATLG,DELETE),  -LIM(9)         
//************ SAMTLIGA ARTIKLAR FÖR INDIA-LAGREN                               
//             DATACLAS=PSEB,MGMTCLAS=&BACKUPC                                  
