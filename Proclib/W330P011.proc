//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  YR 2000 COBOLSORT OF FILES W33011 AND 18.                                  
//*                                                                             
//*  FREQUENCE:    WEEKLY    RTN W330V1                                         
//*                                                                             
//*  RESTART:      W33011    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W330P011 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W330..W330V1,                                             
//             INDUT=&W330..W330V1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33011   EXEC PGM=W33011                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),DEST=LOCAL,HOLD=YES        -- ABEND             
//SYSUDUMP DD  SYSOUT=(D,,DUMP),DEST=LOCAL,HOLD=YES        -- ABEND             
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DUMMY                                                            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W33011D1 DD  DSN=&INDIN..W33011(+0),DISP=SHR                                  
//************ UNSORTED SUMMERAD WEEKLY SALES FILE                              
//*                                                                             
//W33011D2 DD  DSN=&INDIN..W33018(+0),DISP=SHR                                  
//************ UNSORTED S & T SALESFILE                                         
//*                                                                             
//W33011D3 DD  DSN=&INDUT..W33011(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ SORTED WEEKLY SUMMERED SALES FILE                                
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//W33011D4 DD  DSN=&INDUT..W33018(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ SORTED SALES AND TARGET WEEKLY SALES FILE.                       
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
