//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  FETCH ALL SEA CONTAINERS AND CALCULATE ETA-POD-DEP DATE.                   
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W612DB                                         
//*                                                                             
//*  RESTART:      W6122800  NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W612P028 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W612..W612DB,                                             
//             INDUT=&W612..W612DB                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W6122800 EXEC PGM=V16459,PARM='W61228/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//W61228D1 DD  DSN=&INDIN..W612214(0),DISP=SHR                                  
//************ INBOUND REFILL INVOICE INFO (FROM WDGX6302)                      
//*                                                                             
//W61228D2 DD  DSN=&INDUT..W612281(+1),DISP=(NEW,CATLG,DELETE), -LIM(03)        
//************ OUTPUT FILE WITH ALL FLOWS OF RECEIVING AND SENDING DC           
//************ WHERE WE HAVE SEA CONTAINERS.                                    
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W61228D3 DD  DSN=&INDUT..W612282(+1),DISP=(NEW,CATLG,DELETE), -LIM(03)        
//************ OUTPUT FILE WITH CALCULATED ETA-POD-DEP DATE.                    
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
