//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR DAGLIG UPPFÖLJNINGSFIL OCH KOPIERAR TILL EXTRAKT                    
//*  KINA NDC OCH LDC SKALL INGÅ HÄR.                                           
//*                                                                             
//*  FREQUENCE:    DAILY    RTN W428V1                                          
//*                                                                             
//*  RESTART:      W42826    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W428P026 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W428..W428V1,                                            
//             INDIN2=&W011..NDC,                                               
//             INDIN3=&W011..LDC,                                               
//             INDUT1=&W428..W428V1,                                            
//             INDUT2=&WXTR..W428V1                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* EXTRACT DC'S NDC-NA, NDC-CN FROM NDC FILE                                   
//* EXTRACT DC'S LDC-CN FROM LDC FILE                                           
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W428PD26),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN2..W01184(+0),DISP=SHR                                 
//         DD  DSN=&INDIN3..W01184(+0),DISP=SHR                                 
//************ LAGERBAND FRÅN NDC:ERNA OCH LDC-KINA                             
//*                                                                             
//SORTOUT  DD  DSN=&&W01184,DISP=(NEW,PASS,DELETE),                             
//************ SORTAT LAGERBAND FRÅN NDC:ERNA PÅ IDDC OCH ARTIKEL               
//         SPACE=(193,(200,266),RLSE),AVGREC=K                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W42826   EXEC PGM=V16459,PARM='W42826/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//*                                                                             
//W42826D1 DD  DSN=&INDIN1..W42824(+0),DISP=SHR                                 
//************ LEV ANM, NDC:ER OCH KINA LDC:ER                                  
//*                                                                             
//W42826D2 DD  DSN=&&W01184,DISP=(OLD,DELETE,DELETE)                            
//************ DAGLIGA LAGERBANDET                                              
//*                                                                             
//W42826D3 DD  DSN=&INDUT1..W42826(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ UPPFÖLJNINGSFIL, LEVERANSANMÄRKNINGAR, NDC:ER,LDC-CN             
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  KOPIERAR W42826 TILL EXTRAKTFIL WXTR8I                                     
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//WXTR81   EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDUT1..W42826(+1),DISP=SHR                                 
//*                                                                             
//SYSUT2   DD  DSN=&INDUT2..WXTR8I(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//             MGMTCLAS=NOBACKUP,DATACLAS=PSEB                                  
//*                                                                             
