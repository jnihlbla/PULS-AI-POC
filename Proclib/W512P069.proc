//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  OBSOLESCENCE REPORT FOR SEPV (COMPANY CODE 57)                             
//*  PART NO SPLIT PER OBSOLESCENCE GROUPS                                      
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W512M2                                       
//*                                                                             
//*  RESTART:      W51269    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W512P069 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W512..W512M2,                                             
//             INDUT=&W512..W512M2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT01   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W512PD69),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51268(+0),DISP=SHR                                  
//************ STOCK VALUE FILE                                                 
//*                                                                             
//SORTOUT  DD  DSN=&&W51268,DISP=(NEW,PASS,DELETE),                             
//************ W51268 SORTED ON TURNOVER GROUP AND PARTNUMBER                   
//            DATACLAS=PSEB                                                     
//*                                                                             
//**********************************************************************        
//W51269   EXEC PGM=V16459,PARM='W51269/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//*                                                                             
//W51269D1 DD  DSN=&&W51268,DISP=SHR                                            
//************ STOCK VALUE FILE SORTED WITH TURNOVER GROUP, PARTNUMBER          
//*                                                                             
//W51269D2 DD  DSN=&INDUT..W51269(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//************ UT FILE - OBSOLESCENCE REPORT FOR SEPV                           
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
