//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W116P084 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W116..W116D4,                                             
//             INDUT=&W116..W116D4                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11684   EXEC PGM=V16459,PARM='W11684/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//W11684D1 DD  DSN=&INDRTE..CONSTANT(W116DC01),DISP=SHR                         
//************ CONSTANT WITH DC FOR FULL PART RANGE                             
//*                                                                             
//W11684D2 DD  DSN=&INDIN..W11606(+0),DISP=SHR                                  
//************ ARTIKELINFO                                                      
//*                                                                             
//W11684D3 DD  DSN=&INDUT..W11684(+1),DISP=(NEW,CATLG,DELETE),   -LIM(1)        
//************ ARTIKELINFO COMPLETED WITH DC FOR FULL PART RANGE                
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEB                                 
//*                                                                             
