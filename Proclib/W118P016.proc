//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  EXCHANGE PART INFO FROM PRINS - INSERT/UPDATE                              
//*  SUPERSESSION  INFO FROM PRINS - INSERT/UPDATE                              
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W118D1                                         
//*                                                                             
//*  RESTART:      W11816    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W118P016 PROC STPLIB=&INDRTE..LOAD,                                           
//*                                                                             
//             INDIN=&W118..W118D1,                                             
//             INDUT=&W118..W118D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11816   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W11816,W11816,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W11816D1 DD  DSN=&INDIN..W11811(+0),DISP=SHR                                  
//************ FILE WITH PART INFO FROM PRINS                                   
//*                                                                             
//W11816D2 DD  DSN=&INDUT..W11814(+1),DISP=(NEW,CATLG,DELETE),  -LIM(2)         
//************ ERROR FILE TO PARTS PLANNER                                      
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
