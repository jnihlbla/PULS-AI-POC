//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LIST INVENTORY VALUE PER CHINA DC AND SUMMARY OF CHINA LDC AND NDC         
//*  TO CREATE MANAGEMENT FOLLOW-UP REPORTS IN WEB                              
//*                                                                             
//*  FREQUENCY:    WEEKLY    RTN W612V4                                         
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                W6128300  NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W612P083 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W612..W612V4,                                             
//             INDUT=&W612..W612V4                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W612PD83),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W61280(+0),DISP=SHR                                  
//************ SUMMERAD AK-FIL                                                  
//*                                                                             
//SORTOUT  DD  DSN=&&W61280,DISP=(NEW,PASS,DELETE),                             
//************ SORTED AND FILTERED BASED ON CHINA LDC AND NDC                   
//         SPACE=(58,(500,33),RLSE),AVGREC=K                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61283 EXEC PGM=V16459,PARM='W61283/8/'                                       
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//W61283D1 DD  DSN=&&W61280,DISP=(OLD,DELETE,DELETE)                            
//************ SORTED AND FILTERED BASED ON CHINA LDC AND NDC                   
//*                                                                             
//W61283D2 DD  DSN=&INDUT..W61283(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ INVENTORY VALUE PER DC                                           
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W61283D3 DD  DSN=&INDUT..W61284(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ INVENTORY VALUE FOR ALL DC                                       
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
