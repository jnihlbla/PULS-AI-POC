//*                                                                             
//*  LÄSER VALUTA INFO IFRÅN BILLIT OCH SKAPAR MÅNADSUPPD.FIL                   
//*                                                                             
//*  FREKVENS:     BESTÄLLES  RTN W930S2 (BESTÄLLES FRÅN BILLIT)                
//*                                                                             
//*  ÅTERSTART:    W93002    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W930P002 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDREG=&W930,                                                    
//             INDUT=&W930..W930S2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W93002   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W93002,W93002,W93002T,,N00,,,,,,,,&IMS')                         
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W93002D1 DD  DSN=&INDREG..W93001(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//************ VALUTA INFO FÖR UPPDATERING I PROCEDUR W930P001                  
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                   -- DISPLAY            
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W930PD02),DISP=SHR                         
//SORTIN   DD  DSN=&INDREG..W93001(+1),DISP=SHR                                 
//********      FB FILE                                                         
//SORTOUT  DD  DSN=&INDUT..W93001(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//********      VB FILE TO SEND TO D&P                                          
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
