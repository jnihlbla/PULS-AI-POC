//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                   *         
//*      UPPDATERING AV LEVERANTÖRREG OCH ARTIKELREG                  *         
//*      MED ANSKAFFNINGSDATA                                         *         
//*      SJÄLVA UPPDATERINGARNA GÅR PÅ UTFIL TILL FÖLJANDE PGM        *         
//*                                                                   *         
//*      PERIODICITET: DAG                                            *         
//*                                                                   *         
//*      ÅTERSTART:    SORT   NORMAL                                  *         
//*                    W21312 NORMAL                                  *         
//*                           LÄSER WDK6 WDF1                         *         
//*                                                                   *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W213P002 PROC INDUT=&W213..W200D1,                                            
//             INDIN2=&W092..W200D1,                                            
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT    EXEC PGM=SORT                                                         
//SORTIN   DD  DSN=&INDIN2..W09253,DISP=SHR                                     
//**************  TRANSTYP R02 OCH R17 FRÅN TRATTEN                             
//         DD  DSN=&INDIN2..W0924B,DISP=SHR                                     
//**************  TRANSTYP R02 OCH R17 FRÅN STANSBILD                           
//*                                                                             
//SORTOUT  DD  DSN=&&W21302,DISP=(NEW,PASS,DELETE),                             
//**************  SORTERADE TRANSAR                                             
//             SPACE=(6233,(9,9),RLSE)                                          
//*                                                                             
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W213PD12),DISP=SHR                         
//SYSOUT   DD  SYSOUT=*                                                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W21312  EXEC PGM=DFSRRC00,                                                    
//             PARM='&DBB,W21312,W21312,,00'                                    
//STEPLIB  DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//W21312D1 DD  DSN=&&W21302,DISP=(OLD,DELETE,DELETE)                            
//**************   TRANSTYP R17 OCH R02 FRÅN SORTEN                             
//*                                                                             
//W21312D2 DD  DSN=&INDUT..W21313(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//**************   FELPOSTER TILL TRATTEN                                       
//             SPACE=(76,(100,500),RLSE),AVGREC=U,                              
//             MGMTCLAS=&NOBACKUP                                               
//*                                                                             
//W21312D3 DD  DSN=&INDUT..W21314(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ DB-ÄNDRINGAR TILL W213P014                                       
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
//W21312D4 DD  DSN=&INDUT..W21312(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UPPDATERINGAR TILL HÄNDELSEBASER   TILL W213P035                 
//             SPACE=(14,(1,3),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W21312D5 DD  DSN=&INDUT..W21315(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//**************   UTFIL ARTIKLAR VID ANSKAFFARBYTE                             
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&NOBACKUP                                               
//*                                                                             
//WDF1     INCLUDE MEMBER=WDF1                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//*                                                                             
