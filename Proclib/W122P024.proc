//*                                                                             
//*  BORTTAG BENÄMNINGSREGISTER(WDD3)                                           
//*                                                                             
//*  FREKVENS:     BESTÄLLNING  RTN W122B1                                      
//*                                                                             
//*  ÅTERSTART:    W12224    BACKOUT VIA SOP                                    
//*                         UPPDATERAR WDD3                                     
//*                                                                             
//*          HÄR SKAPAS FIL SOM BL.A GÅR TILL W122P060 (RENSN WDK9),            
//*          DÄRFÖR GÖRS ORDER PÅ W122B2 (I RBMP) I DETTA JOBB (JCL).           
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W122P024 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W122..W122B1,                                             
//             INDUT=&W122..W122B1                                              
//W12224   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W12224,W12224,,00')                                  
//STEPLIB  DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DSN=&INDPLOG..W122P024(+1),                                      
//             DISP=(NEW,CATLG,CATLG),                                          
//             DCB=(RECFM=VB,LRECL=6229,BLKSIZE=27998,BUFNO=5),                 
//             SPACE=(TRK,(100,50),RLSE),                                       
//             MGMTCLAS=&EMID70                                                 
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                      -- DISPLAY         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                      -- POSTSUM         
//WDD3     INCLUDE MEMBER=WDD3                                                  
//W12224D1 DD  DSN=&INDIN..W12207(+0),DISP=SHR                                  
//************ INFIL                                                            
//*                                                                             
//W12224D2 DD  DSN=&INDUT..W12225(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL: INNEHÅLL=POSTER DELETADE FRÅN WDD3                        
//             MGMTCLAS=&NOBACKUP,SPACE=(23456,(200,100),RLSE)                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
