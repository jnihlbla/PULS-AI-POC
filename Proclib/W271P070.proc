//W271P070 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W271..W271V7,                                             
//             INDUT=&W271..W271V7                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W271PD70),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W27169(+0),DISP=SHR                                  
//************ RESTORDERPOSTER, NDC                                             
//*                                                                             
//SORTOUT  DD  DSN=&&W27169,DISP=(NEW,PASS,DELETE),                             
//************ SORTERADE RESTORDERPOSTER PER LAND / ARTNR                       
//         SPACE=(80,(2,6),RLSE),AVGREC=K                                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W27170   EXEC PGM=W27170                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//W27170D1 DD  DSN=&&W27169,DISP=(OLD,DELETE,DELETE)                            
//************ SORTERADE RESTORDERPOSTER PER LAND / ARTNR                       
//*                                                                             
//W27170D2 DD  DSN=&&W27170,DISP=(NEW,PASS,DELETE),                             
//************ RESTORDERPOSTER PER LAND / ARTNR                                 
//             SPACE=(80,(2,6),RLSE),AVGREC=K                                   
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT2    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W271PD71),DISP=SHR                         
//SORTIN   DD  DSN=&&W27170,DISP=(OLD,DELETE,DELETE)                            
//************ RESTORDERPOSTER, NDC                                             
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W27170(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ RESTORDERPOSTER PER LAND / ARTNR                                 
//             SPACE=(80,(2,6),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&DEL2BKPC                                               
