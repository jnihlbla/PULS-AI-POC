//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKRIVER MÅNADSLISTA MED ARTIKLAR DÄR R-NOTEN                               
//*  (KDKVAINF PÅ W6D2) ÄR ÄLDRE ÄN 1 ÅR.                                       
//*                                                                             
//*  FREKVENS:     REDOVISNINGSPERIOD     RTN W426R2                            
//*                                                                             
//*  ÅTERSTART:              NORMAL                                             
//*                W42641    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W426P041 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W426..W426R2,                                             
//             INDIN2=&W011..&RTEGRP.,                                          
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W426PD41),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W4267A,DISP=(OLD,PASS,DELETE)                        
//************                                                                  
//*                                                                             
//SORTOUT  DD  DSN=&&W4267A,DISP=(NEW,PASS,DELETE),                             
//************ SORTAD KVALITETSINFO                                             
//         SPACE=(15,(150,50),RLSE),AVGREC=K                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W42641   EXEC PGM=V16459,PARM='W42641/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//A4LF  OUTPUT FORMDEF=SLSR6C,PAGEDEF=SLSR6C                                    
//************ A4 LANDSCAPE, SINGLE SIDE, RASTER  (FOLDED PAPER)                
//W42641D1 DD  DSN=&&W4267A,DISP=(OLD,DELETE,DELETE)                            
//************ SORTAD KVALITETSINFO                                             
//*                                                                             
//W42641D2 DD  DSN=&INDIN2..W01160(+0),DISP=SHR                                 
//************ LAGERBAND                                                        
//*                                                                             
//W42641D3 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF)                     
//************ W42641-001  LISTA ARTIKLAR MED R-NOT > 1 ÅR                      
//************ IDFKNGRP 1XXX,5XXX,6XXX,7XXX,87XX,89XX                           
//W42641D4 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF)                     
//************ W42641-002  LISTA ARTIKLAR MED R-NOT > 1 ÅR                      
//************ IDFKNGRP 2XXX,32XX-333X,4XXX                                     
//W42641D5 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF)                     
//************ W42641-003  LISTA ARTIKLAR MED R-NOT > 1 ÅR                      
//************ IDFKNGRP 3XXX ÖVRIGT                                             
//W42641D6 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF)                     
//************ W42641-004  LISTA ARTIKLAR MED R-NOT > 1 ÅR                      
//************ IDFKNGRP 81XX,82XX,83XX,84XX,86XX                                
//W42641D7 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF)                     
//************ W42641-005  LISTA ARTIKLAR MED R-NOT > 1 ÅR                      
//************ IDFKNGRP 85XX,88XX                                               
