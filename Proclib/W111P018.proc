//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                   *         
//*      ERSÄTTNINGSBEVAKNING - BEHANDLA TRANS FRÅN INVENTERINGEN     *         
//*                                                                   *         
//*      PERIODICITET: DAG  RTN W111D1                                *         
//*                                                                   *         
//*      ÅTERSTART NORMAL                                             *         
//*                W11118 LÄSER      WDD2 WDD7 WDK6 WDK9 WDH1         *         
//*                                                                   *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W111P018 PROC INDUT=&W111..W111D1,                                            
//             INDIN=&W111..W111D1,                                             
//             INDIN2=&W513..W111D1,                                            
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11118  EXEC PGM=DFSRRC00,                                                    
//             PARM='&DBB,W11118,W11118,,00'                                    
//STEPLIB  DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR             -- DATKORT           
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR      -- DATKORT           
//DATUT    DD  SYSOUT=*                                    -- DATKORT           
//V16247D3 DD  SYSOUT=*                                    -- POSTSUM           
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//*                                                                             
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDK9     INCLUDE MEMBER=WDK9                                                  
//WDD7     INCLUDE MEMBER=WDD7                                                  
//WDD2     INCLUDE MEMBER=WDD2                                                  
//WDR5     INCLUDE MEMBER=WDR5                                                  
//WDL2     INCLUDE MEMBER=WDL2                                                  
//WDH1     INCLUDE MEMBER=WDH1                                                  
//*                                                                             
//W11118D1 DD  DSN=&INDIN2..W51385,DISP=SHR                                     
//*                                                                             
//W11118D9 DD  DSN=&INDIN..W11128(0),DISP=SHR                                   
//*                                                                             
//W11118D2 DD  DSN=&INDUT..W11114(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ POSTER TILL W218D2 FÖR BERÄKN AV TIDISPIN                        
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&NOBACKUP                                               
//*                                                                             
//W11118D3 DD  DSN=&INDUT..W11115(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ ERSATTA ARTIKLAR TILL PPMS (W910D1)                              
//             SPACE=(27,(1,2),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&NOBACKUP                                               
//*                                                                             
//W11118D4 DD  DSN=&INDUT..W11116(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ ERSÄTTNINGSTRANSAR HTYP 9101 -> VR OCH VIPS                      
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W11118D6 DD  DSN=&INDUT..W11118(+1),DISP=(NEW,CATLG,DELETE),  -LIM(5)         
//************ HÄNDELSEPOSTER HTYP 1157/58 OCH 2303                             
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W11118D7 DD  DSN=&INDUT..W11119(+1),DISP=(NEW,CATLG,DELETE),  -LIM(5)         
//************ UPPDATERINGSPOSTER WDK6/WDD7                                     
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W11118D8 DD  DSN=&INDUT..W11121(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ TRANSAR TILL INVENTERINGEN (W513)                                
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&NOBACKUP                                               
//*                                                                             
//W11118DA DD  DSN=&INDUT..W11128(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
