//W463P036 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W463..W463S5,                                             
//             INDUT=&W463..W463S5                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W463PD36),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W46335(+0),DISP=SHR                                  
//************ FIL FRÅN PIE                                                     
//*                                                                             
//SORTOUT  DD  DSN=&&W46335,DISP=(NEW,PASS,DELETE),                             
//************ SORTAD PIE FIL                                                   
//         SPACE=(55,(500,500),RLSE),AVGREC=U                                   
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W46336   EXEC PGM=W46336                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W46336D1 DD  DSN=&&W46335,DISP=(OLD,DELETE,DELETE)                            
//************ PIE PACNINGSINFO                                                 
//*                                                                             
//W46336D2 DD  DSN=&INDUT..W46336(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ FIL TILL AUTOMATPACKNING VIA DISPATCHER (W4635200)               
//             SPACE=(945,(300,233),RLSE),AVGREC=U,                             
//             MGMTCLAS=&NOBACKUP                                               
