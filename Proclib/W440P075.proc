//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W440P075 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W440..W440V3,                                             
//             INDUT=&W440..W440V3,                                             
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W440PD75),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W44072(+0),DISP=SHR                                  
//************ KVOFFERT PER IDGMTREF/ARTNR/CLAGER URVAL FRÅN WDE9               
//*                                                                             
//SORTOUT  DD  DSN=&&W44072S,DISP=(NEW,PASS,DELETE),                            
//************ KVOFFERT URVAL FRÅN WDE9 SORTERAT PÅ IDARTNR                     
//         SPACE=(27,(5,15),RLSE),AVGREC=K                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W440PD75),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W44073(+0),DISP=SHR                                  
//************ KVOFFERT PER IDGMTREF/ARTNR/CLAGER URVAL FRÅN WDQ1               
//*                                                                             
//SORTOUT  DD  DSN=&&W44073S,DISP=(NEW,PASS,DELETE),                            
//************ KVOFFERT URVAL WDQ1 SORTERAT PÅ IDARTNR                          
//         SPACE=(27,(5,15),RLSE),AVGREC=K                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W440PD74),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W44074(+0),DISP=SHR                                  
//************ KVOFFERT URVAL WDK9                                              
//*                                                                             
//SORTOUT  DD  DSN=&&W44074S,DISP=(NEW,PASS,DELETE),                            
//************ KVOFFERT URVAL WDK9 SORTERAT PÅ IDARTNR                          
//         SPACE=(13,(5,15),RLSE),AVGREC=K                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W44075   EXEC PGM=V16459,PARM='W44075/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W44075D1 DD  DSN=&&W44072S,DISP=(OLD,DELETE,DELETE)                           
//************ KVOFFERT URVAL WDE9 SORTERAT PÅ IDARTNR                          
//*                                                                             
//W44075D2 DD  DSN=&&W44073S,DISP=(OLD,DELETE,DELETE)                           
//************ KVOFFERT URVAL WDQ1 SORTERAT PÅ IDARTNR                          
//*                                                                             
//W44075D3 DD  DSN=&&W44074S,DISP=(OLD,DELETE,DELETE)                           
//************ KVOFFERT URVAL WDK9 SORTERAT PÅ IDARTNR                          
//*                                                                             
//A4LF OUTPUT FORMDEF=SLSR6C,PAGEDEF=SLSR6C                                     
//*                                                                             
//W44075D4 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF),                    
//************ W44075-001  DIFFLISTA KVOFFERT                                   
//             DCB=(RECFM=FBA,LRECL=121,BLKSIZE=121)                            
//*                                                                             
//W44075D5 DD  DSN=&INDUT..W44059(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ FIL FÖR DIFFERENSER PÅ KVOFFERT                                  
//             SPACE=(41,(5,15),RLSE),AVGREC=K,                                 
//             MGMTCLAS=&BACKUPC                                                
