//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  HANDLE INPUT FILE FROM PRICE SC.                                           
//*  CREATE OUTPUT FILE WITH RETAIL PRICES                                      
//*  WHICH SHOULD UPDATE WDC3 IN NEXT JOB.                                      
//*                                                                             
//*  FREQUENCE:    SEVERAL TIMES A DAY     RTN W116SG                           
//*                                                                             
//*  RESTART:      W11694    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W116P094 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W116..W116SG,                                             
//             INDUT=&W116..W116SG                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11694   EXEC PGM=W11694                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W11694D1 DD  DUMMY                                                            
//************ PARAMETER FILE (VCOM SENDERTAG)                                  
//*                                                                             
//W11694D2 DD  DSN=&INDIN..W11694(+0),DISP=SHR                                  
//************ INPUT FILE FROM PRICE SC                                         
//*                                                                             
//W11694D3 DD  DSN=&INDUT..W11695(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ OUTPUT FILE WITH RETAIL PRICES                                   
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
