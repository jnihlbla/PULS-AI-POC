//W515P061 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W515..W515D2,                                             
//             INDUT=&W515..W515D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51561   EXEC PGM=W51561                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W51561D1 DD  DSN=&INDIN..W51561(+0),DISP=SHR                                  
//************ EKONOMISK HÄNDELSEFIL                                            
//*                                                                             
//W51561D2 DD  DSN=&INDIN..W5156A(+0),DISP=SHR                                  
//************ EKONOMISK HÄNDELSEFIL                                            
//*                                                                             
//W51561D3 DD  DSN=&INDUT..W51562(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ POSTER TILL PGM W51562 FÖR KONTROLL                              
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W51561D4 DD  DSN=&INDUT..W5156B(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ POSTER TILL PGM W51564 FÖR INLADNING DATABAS                     
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
