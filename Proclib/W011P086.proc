//W011P086 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT1=&W011..LDC,                                               
//             INDUT2=&W011..SDC,                                               
//             INDUT3=&W011..NDC                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W01186   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W01186,W01186,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDL7     INCLUDE MEMBER=WDL7                                                  
//WDL4     INCLUDE MEMBER=WDL4                                                  
//W01186D1 DD  DSN=&&OILDC,DISP=(NEW,PASS,DELETE),                              
//************ SAMTLIGA DATAELEMENT FRÅN WDL711+L411 (LDC:ER)                   
//         DATACLAS=PSEB                                                        
//*                                                                             
//W01186D2 DD  DSN=&&OISDC,DISP=(NEW,PASS,DELETE),                              
//************ SAMTLIGA DATAELEMENT FRÅN WDL711+L411 (SDC:ER)                   
//         DATACLAS=PSEB                                                        
//*                                                                             
//W01186D3 DD  DSN=&&OINDC,DISP=(NEW,PASS,DELETE),                              
//************ SAMTLIGA DATAELEMENT FRÅN WDL711+L411 (NDC:ER)                   
//         DATACLAS=PSEB                                                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//* LDC                                                                         
//*                                                                             
//SORT01   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTDCAR),DISP=SHR                         
//SORTIN   DD  DSN=&&OILDC,DISP=(OLD,DELETE,DELETE)                             
//************ SAMTLIGA DATAELEMENT FRÅN WDL711+L411 (LDC:ER)                   
//*                                                                             
//SORTOUT  DD  DSN=&INDUT1..W01186(+1),                        -LIM(1)          
//             DISP=(NEW,CATLG,DELETE),                                         
//************ SAMTLIGA DATAELEMENT FRÅN WDL711+L411 (SORT DC/ART)              
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//* SDC                                                                         
//*                                                                             
//SORT02   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTDCAR),DISP=SHR                         
//SORTIN   DD  DSN=&&OISDC,DISP=(OLD,DELETE,DELETE)                             
//************ SAMTLIGA DATAELEMENT FRÅN WDL711+L411 (SDC:ER)                   
//*                                                                             
//SORTOUT  DD  DSN=&INDUT2..W01186(+1),                        -LIM(1)          
//             DISP=(NEW,CATLG,DELETE),                                         
//************ SAMTLIGA DATAELEMENT FRÅN WDL711+L411 (SORT DC/ART)              
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=&BACKUPC                                                
//* NDC                                                                         
//*                                                                             
//SORT03   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTDCAR),DISP=SHR                         
//SORTIN   DD  DSN=&&OINDC,DISP=(OLD,DELETE,DELETE)                             
//************ SAMTLIGA DATAELEMENT FRÅN WDL711+L411 (NDC:ER)                   
//*                                                                             
//SORTOUT  DD  DSN=&INDUT3..W01186(+1),                        -LIM(1)          
//             DISP=(NEW,CATLG,DELETE),                                         
//************ SAMTLIGA DATAELEMENT FRÅN WDL711+L411 (SORT DC/ART)              
