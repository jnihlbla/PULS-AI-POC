//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W412P013 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W412..W412V3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W41213   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W41213,W41213,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDR4     INCLUDE MEMBER=WDR4                                                  
//W41213D1 DD  DSN=&INDUT..W41213(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ VOR-KÖ (VORATG<2)                                                
//             SPACE=(16,(2,1),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&DEL2BKPC                                               
//W41213D2 DD  DSN=&INDUT..W41214(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ VOR-KÖ RENSN.POSTER                                              
//             SPACE=(16,(2,1),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&DEL2BKPC                                               
//W41213D3 DD  DSN=&INDUT..W41216(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ VOR-KÖ LEDTIDER                                                  
//             SPACE=(34,(2,1),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&DEL2BKPC                                               
//W41213D4 DD  DSN=&INDUT..W41217(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ VECKANS EJ LÖSTA KLASS 0 RADER                                   
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
