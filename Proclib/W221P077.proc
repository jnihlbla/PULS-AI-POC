//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  TO IDENTIFY PARTS THAT HAVE CHANGED KDRES FROM 00 TO                       
//*  X1/X2 SINCE LAST WEEK                                                      
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W221V3                                         
//*                                                                             
//*  RESTART:      W22177    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W221P077 PROC STPLIB=&INDRTE..LOAD, -- TA EV BORT KOMMA                       
//             INDIN1=&W011..&RTEGRP.,                                          
//             INDIN2=&W011,                                                    
//             INDUT=&W221..W221V3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W22177   EXEC PGM=V16459,PARM='W22177/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W22177D1 DD  DSN=&INDIN2..W01177(-1),DISP=SHR                                 
//************ UNLOADED PARTS REGISTER                                          
//*                                                                             
//W22177D2 DD  DSN=&INDIN1..W01160(+0),DISP=SHR                                 
//************ WEEKLY PARTS REGISTER                                            
//*                                                                             
//W22177D3 DD  DSN=&INDUT..W22177(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ PART NUMBERS WITH KDERS CHANGED                                  
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
