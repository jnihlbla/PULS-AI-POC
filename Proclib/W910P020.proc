//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR EXTRAKT UR W91042 TILL PPMAS                                        
//*                                                                             
//*  FREKVENS:     VECKA    RTN W910D2                                          
//*                                                                             
//*  ÅTERSTART:    W91020   NORMAL                                              
//*                                                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W910P010 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W910,                                                     
//             INDUT=&W910..W910D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W91020   EXEC PGM=V16459,PARM='W91020/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR         -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//W91020D1 DD  DSN=&INDIN..W91042(+0),DISP=SHR                                  
//************ ARTIKELINFO                                                      
//*                                                                             
//W91020D2 DD  DSN=&INDUT..W91020(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//************ EXTRAKT AV INFIL FÖR SKICK TILL PPMAS                            
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
