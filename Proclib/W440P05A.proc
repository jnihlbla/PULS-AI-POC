//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES FILE FOR VOR-OKS CHECK                                             
//*      AND FILE FOR DELETE ON NEW VOR-QUEUE (WDA6)                            
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W440V3                                         
//*                                                                             
//*  RESTART:      W4405A      NORMAL                                           
//*                READS        WDA6  (SB)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W440P05D PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W440..W440V3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W4405A   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W4405A,W4405A,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                    -- ABEND         
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDA6     INCLUDE MEMBER=WDA6                                                  
//W4405AD1 DD  DSN=&&W44064,DISP=(NEW,PASS,DELETE),                             
//************ VOR TILL OKS UPPF.                                               
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//W4405AD2 DD  DSN=&INDUT..W4405B(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ VOR, KANDIDATER TILL RENSNING                                    
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//W4405AD3 DD  DSN=&INDUT..W4405A(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ VOR, FOLLOW UP EXTRACT                                           
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTDCAR),DISP=SHR                         
//SORTIN   DD  DSN=&&W44064,DISP=(OLD,DELETE,DELETE)                            
//************ VOR TILL OKS UPPF.                                               
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W44064(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ SORTERAD VOR TILL OKS UPPF.                                      
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
