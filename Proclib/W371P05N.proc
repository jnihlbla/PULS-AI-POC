//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  REPORT OF BINNED CORES AND DEVIATIONS FOR                                  
//*  MAASTRICHT ORGANISATION                                                    
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W371D3                                         
//*                                                                             
//*  RESTART:      W3715N    NORMAL                                             
//*                READS        WDK7                                            
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W371P05N PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W371..W371D3,                                             
//             INDUT=&W371..W371D3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W371PD5N),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W3714X(+0),DISP=SHR                                  
//*                                                                             
//SORTOUT  DD  DSN=&&W3714X,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W3715N   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,DSNMTV01,W3715N,,00')                                
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDK7     INCLUDE MEMBER=WDK7                                                  
//DDOTV02  DD  DSN=&&W3715NBT,DISP=(NEW,PASS,DELETE),                           
//             SPACE=(TRK,(1,1),RLSE),                                          
//             DCB=(RECFM=VB,LRECL=4092)                                        
//DDITV02  DD  DSN=&INDRTE..CONSTANT(W3715NI2),DISP=SHR                         
//W3715ND1 DD  DSN=&&W3714X,DISP=(OLD,DELETE,DELETE)                            
//************ INPUT FILE FROM W371P04X                                         
//*                                                                             
//W3715ND2 DD  DSN=&INDUT..W3715N(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//************ REPORT OF BINNED CORES AND DEVIATIONS FOR                        
//************ MAASTRICHT ORGANISATION                                          
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
