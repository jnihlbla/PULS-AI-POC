//*  LÄSER HELA PEDAL-BASEN WDR9 OCH ALLA HÄNDELSER PÅ INFILEN OCH              
//*  SKAPAR FILER FÖR RENSNING AV WDR9, SAMT FÖR KONTROLL O ANALYS              
//*                                                                             
//*  FREKVENS:     DAG     RTN W570D2                                           
//*                                                                             
//*  ÅTERSTART:    W57061    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W570P061 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W570..W570D2,                                             
//             INDUT=&W570..W570D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W57061   EXEC PGM=W57061                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W57061D1 DD  DSN=&INDIN..W57061(+0),DISP=SHR                                  
//************ EKONOMISK HÄNDELSEFIL                                            
//*                                                                             
//W57061D2 DD  DSN=&INDIN..W5706A(+0),DISP=SHR                                  
//************ EKONOMISK HÄNDELSEFIL                                            
//*                                                                             
//W57061D3 DD  DSN=&INDUT..W57062(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ POSTER TILL PGM W57062 FÖR KONTROLL                              
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W57061D4 DD  DSN=&INDUT..W5706B(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ POSTER TILL PGM W57064 FÖR INLADNING DATABAS                     
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
