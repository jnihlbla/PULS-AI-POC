//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  GENERERING AV NATTBATCHENS DATUMKORT                                       
//*                                                                             
//*  FREKVENS:     DAG    RTN W030D2                                            
//*                                                                             
//*  ÅTERSTART:    W03012   NORMAL                                              
//*                DFUP     NORMAL                                              
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W030P012 PROC STPLIB=&INDRTE..LOAD,DATUM=,                                    
//             INDIN2=&INDRTE.,                                                 
//             INDUT=&W030..W030D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W03012   EXEC PGM=W03012,PARM='&DATUM'                                        
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                      -- DISPLAY         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                      -- POSTSUM         
//W03012D1 DD  DSN=&INDIN2..SOPCAL(+0),DISP=SHR                                 
//************ SOPS KALENDERFIL                                                 
//*                                                                             
//W03012D2 DD  DSN=&INDUT..W03012(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ DATUMKORT FÖR NATTBATCH                                          
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=80),                              
//             MGMTCLAS=&DEL2BKPC,SPACE=(80,(1))                                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
