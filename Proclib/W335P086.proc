//W335P086 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W011..&RTEGRP.,                                          
//             INDIN2=&W335..W335D6,                                            
//             INDIN3=&W011..NDC,                                               
//             INDUT=&W335..W335D6                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33586   EXEC PGM=V16459,PARM='W33586/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(500,500))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W33586D1 DD  DSN=&INDIN3..W01184(+0),DISP=SHR                                 
//************ DAG-LAGERBAND NDC                                                
//*                                                                             
//W33586D2 DD  DSN=&INDIN1..W01161(+0),DISP=SHR                                 
//************ PULS ALLA PRISRADER                                              
//*                                                                             
//W33586D3 DD  DSN=&INDIN2..W33591(+0),DISP=SHR                                 
//************                                                                  
//*                                                                             
//TPFIL1   DD  DSN=&&TEMP,DISP=(NEW,DELETE,DELETE),                             
//************ TEMPORÄR ARTIKELRADFIL                                           
//             DATACLAS=PSEB                                                    
//TPFIL2   DD  DSN=&&TEMP,DISP=(NEW,DELETE,DELETE),                             
//************ TEMPORÄR ARTIKELRADFIL+LEV                                       
//             DATACLAS=PSEB                                                    
//TPFIL3   DD  DSN=&&TEMP,DISP=(NEW,DELETE,DELETE),                             
//************ TEMPORÄR LEVERATNÖRSFIL                                          
//             DATACLAS=PSEB                                                    
//TPFIL4   DD  DSN=&&TEMP,DISP=(NEW,DELETE,DELETE),                             
//************ TEMPORÄR ARTIKELRADFIL                                           
//             DATACLAS=PSEB                                                    
//TPFIL5   DD  DSN=&&TEMP,DISP=(NEW,DELETE,DELETE),                             
//************ TEMPORÄR NDCFIL                                                  
//             DATACLAS=PSEB                                                    
//TPFIL6   DD  DSN=&&TEMP,DISP=(NEW,DELETE,DELETE),                             
//************ TEMPORÄR ARTIKELFIL                                              
//             DATACLAS=PSEB                                                    
//TPFIL7   DD  DSN=&&TEMP,DISP=(NEW,DELETE,DELETE),                             
//************ TEMPORÄR ARTIKELFIL                                              
//             DATACLAS=PSEB                                                    
//*                                                                             
//W33586D4 DD  DSN=&INDUT..W33586(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ SENASTE GODKÄNDA PRISRAD PER ARTIKEL OCH LEVERANTÖR              
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEB                                 
