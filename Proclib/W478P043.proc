//             INDUT=&W478..W478D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W478PD43),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W47842(+0),DISP=SHR                                  
//************ DAGENS ORDERDELAR                                                
//*                                                                             
//*                                                                             
//SORTOUT  DD  DSN=&&W47842,DISP=(NEW,PASS,DELETE),                             
//************ VECKANS ORDERDELAR SORTERAD                                      
//************ IDDISTR, IDKUNDNR                                                
//         SPACE=(6233,(50,10),RLSE),AVGREC=K                                   
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47843   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W47843,W47843,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
