//*                                                                             
//*  SW TEXT IN FILES                                                           
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W561D3                                         
//*                                                                             
//*  RESTART:      W56170    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W561P070 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W561..W561D3,                                             
//             INDUT=&W561..W561D3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W561PD02),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W56172A(+0),DISP=SHR                                 
//************ INFILE W56172A                                                   
//*                                                                             
//SORTOUT  DD  DSN=&&W56172A,DISP=(NEW,PASS,DELETE),                            
//************ SORTERAD INFIL W56172A                                           
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56170   EXEC PGM=W56170                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SORTMSG  DD  SYSOUT=*                                                         
//W56170D1 DD  DSN=&&W56172A,DISP=(OLD,DELETE,DELETE)                           
//************ SORTED INFILE W56172                                             
//*                                                                             
//W56170D2 DD  DSN=&INDIN..W56173B(+0),DISP=SHR                                 
//************ SORTED INFILE W56173                                             
//*                                                                             
//W56170D3 DD  DSN=&&W56172,DISP=(NEW,PASS,DELETE),                             
//************ OUTFILE W56172                                                   
//             DATACLAS=PSEB                                                    
//*                                                                             
//W56170D4 DD  DSN=&INDUT..W56173(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ OUTFILE W56173                                                   
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT3    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W561PD02),DISP=SHR                         
//SORTIN   DD  DSN=&&W56172,DISP=(OLD,DELETE,DELETE)                            
//************ OUTFILE W56172                                                   
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W56172(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ OUTFILE W56172                                                   
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
