//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATE VSIM REGISTER FILE CONTAINING PART INFO                             
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W271S2                                         
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                W2711H    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W271P01H PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W271..W271S2,                                            
//             INDIN2=&W011..QASE,                                              
//             INDIN3=&W011..SDC,                                               
//             INDIN4=&W011..NDC,                                               
//             INDIN5=&W011..LDC,                                               
//             INDUT=&W271..W271S2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT01   EXEC PGM=SORT,REGION=8M                                              
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W271PD1H),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN1..W2711G(+0),DISP=SHR                                 
//************ PART INFO FROM WDE3 AND WDR2                                     
//*                                                                             
//SORTOUT  DD  DSN=&&W2711GU,DISP=(NEW,PASS,DELETE),                            
//************ UNIQUE PARTS FROM WDE3 AND WDR2 SORTED                           
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT02   EXEC PGM=SORT,REGION=8M                                              
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W271PE1H),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN1..W2711G(+0),DISP=SHR                                 
//************ PART INFO FROM WDE3 AND WDR2                                     
//*                                                                             
//SORTOUT  DD  DSN=&&W2711G,DISP=(NEW,PASS,DELETE),                             
//************ PART INFO FROM WDE3 AND WDR2 SORTED                              
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT03   EXEC PGM=SORT,REGION=8M                                              
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W271PF1H),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN3..W01184(+0),DISP=SHR                                 
//         DD  DSN=&INDIN4..W01184(+0),DISP=SHR                                 
//         DD  DSN=&INDIN5..W01184(+0),DISP=SHR                                 
//************ PART INFO FROM WDK7                                              
//*                                                                             
//SORTOUT  DD  DSN=&&W01184,DISP=(NEW,PASS,DELETE),                             
//************ PART INFO FROM WDK7 SORTED BY PART, DC                           
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W2711H   EXEC PGM=V16459,PARM='W2711H/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//W2711HD1 DD  DSN=&&W2711GU,DISP=(OLD,DELETE,DELETE)                           
//************ PART INFO FROM WDE3 AND WDR2                                     
//*                                                                             
//W2711HD2 DD  DSN=&INDIN2..W01160(+0),DISP=SHR                                 
//************ PART INFO FROM WDK6                                              
//*                                                                             
//W2711HD3 DD  DSN=&INDIN2..W01174(+0),DISP=SHR                                 
//************ PART INFO FROM WDD3                                              
//*                                                                             
//TEMPFIL  DD  DSN=&&TEMPFIL,DISP=(NEW,PASS,DELETE),                            
//************ PART INFO BASED ON WDK6 AND WDD3                                 
//             DATACLAS=PSEB                                                    
//*                                                                             
//W2711HD4 DD  DSN=&&W2711G,DISP=(OLD,DELETE,DELETE)                            
//************ PART INFO FROM WDE3 AND WDR2                                     
//*                                                                             
//TEMPFIL2 DD  DSN=&&TEMPFIL2,DISP=(NEW,PASS,DELETE),                           
//************ PART INFO BASED ON WDK6 WDD3 AND WDE3                            
//             DATACLAS=PSEB                                                    
//*                                                                             
//W2711HD5 DD  DSN=&&W01184,DISP=(OLD,DELETE,DELETE)                            
//************ PART INFO FROM WDK7                                              
//*                                                                             
//W2711HD6 DD  DSN=&INDUT..W2711H(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//************ REFILL PROPOSALS (WDE3, WDK6, WDD3, WDR2, WDK7)                  
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
