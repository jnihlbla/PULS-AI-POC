//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  TAR IN DAGFILER MED OKS/EFR-HISTORIK OCH SKAPAR EN VECKOFIL MED            
//*  MEDELVÄRDE PÅ EFR PACKAT RESP OPACKAT                                      
//*                                                                             
//*  FREKVENS:     VECKA    RTN WXTRV2                                          
//*                                                                             
//*  ÅTERSTART:              NORMAL                                             
//*                WXTR12    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTRP012 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WXTR..WXTRV2,                                             
//             INDREG=&WXTR,                                                    
//             DEST=LOCAL                                                       
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WXTRP121),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..WXTR05,DISP=SHR                                      
//************ TA IN FIL MED VECKANS ALLA DAGFILER                              
//*                                                                             
//SORTOUT  DD  DSN=&&WXTR05,DISP=(NEW,PASS,DELETE),                             
//************ WXTR15 SORTAD PÅ DC, PRC, KDORDKL OCH DISTR                      
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTR12   EXEC PGM=V16459,PARM='WXTR12/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(1000,1000))                                         
//SORTMSG  DD  SYSOUT=*                                                         
//WXTR12D1 DD  DSN=&&WXTR05,DISP=(OLD,DELETE,DELETE)                            
//************ WXTR05 SORTAD DVS DAGFILER                                       
//*                                                                             
//WXTR12D2 DD  DSN=&INDREG..WXTRAA(+0),DISP=SHR                  -LIM 3         
//************ COUNTRY TABELL                                                   
//*                                                                             
//WXTR12D3 DD  DSN=&&WXTR12,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//************ WXTR12 VECKOFIL FÖR AKTUELL VECKA                                
//*                                                                             
//WXTR12D4 DD  DSN=&&TEMP1,DISP=(NEW,PASS,DELETE),                              
//             DATACLAS=PSEN                                                    
//************ TEMPFIL                                                          
//*                                                                             
//WXTR12D5 DD  SYSOUT=(A,,STD),DEST=&DEST                                       
//************ EFRLISTA TILL SAR                                                
//*                                                                             
//* * * * * * * * * * * * SLÅ IHOP SENASTE VECKA MED ÖVRIGA VECKOR              
//SORT2    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WXTRP122),DISP=SHR                         
//SORTIN   DD  DSN=&&WXTR12,DISP=(OLD,DELETE,DELETE)                            
//************ TA IN VECKOFIL MED AKTUELL VECKA                                 
//         DD  DSN=&INDREG..WXTR12(+0),DISP=SHR                                 
//************ TA IN VECKOFIL MED GAMLA VECKOR                                  
//*                                                                             
//SORTOUT  DD  DSN=&INDREG..WXTR12(+1),                        -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),                                         
//************ WXTR12 NU MED GAMLA VECKOR OCH AKTUELL VECKA                     
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
