//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W15904   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W15904,W15904,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
