//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR FIL FÖR E-PLUS MED TÄCKNINGSBIDRAG FÖR                              
//*  RESULTAT FRÅN URVALSBILDERNA 3202 OCH 3203                                 
//*                                                                             
//*  FREKVENS:     BESTÄLLES    RTN W330B2                                      
//*                                                                             
//*  ÅTERSTART:    W33082S   NORMAL                                             
//*                W33082   NORMAL                                              
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W330P082 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W330..W330B2,                                             
//             INDUT=&W330..W330B2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33082S  EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W330PD82),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W33035(+0),DISP=SHR                                  
//************ URVALET FRÅN 3202 OCH 3203. EJ RESULTAT.                         
//*                                                                             
//SORTOUT  DD  DSN=&&W33035S,DISP=(NEW,PASS,DELETE),                            
//************ SORTERAT URVAL.                                                  
//             SPACE=(6233,(9000,1000),RLSE)                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33082   EXEC PGM=W33082                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DSN=&INDRTE..CONSTANT(W330PD83),DISP=SHR     -- SORTKORT         
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W33082D1 DD  DSN=&&W33035S,DISP=(OLD,DELETE,DELETE)                           
//*                                                                             
//W33082D2 DD  DSN=&INDIN..W33081,DISP=SHR                                      
//************ RESULTATET FRÅN URVALET                                          
//*                                                                             
//W33082D3 DD  DSN=&INDUT..W33083(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ URVAL OCH RESULTAT MED TÄCKNINGSGRAD(KDNIVA=4)                   
//             MGMTCLAS=DEL2,VOL=(,,,2),                                        
//             SPACE=(23291,(1000,2000),RLSE)                                   
//*                                                                             
//W33082D4 DD  DSN=&INDUT..W33085(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ URVAL OCH RESULTAT MED TÄCKNINGSGRAD(KDNIVA=2)                   
//             MGMTCLAS=DEL2,VOL=(,,,2),                                        
//             SPACE=(23291,(1000,2000),RLSE)                                   
//*                                                                             
//W33082D5 DD  DSN=&INDUT..W33087(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ URVAL OCH RESULTAT MED TÄCKNINGSGRAD(KDNIVA=0)                   
//             MGMTCLAS=DEL2,VOL=(,,,2),                                        
//             SPACE=(23291,(1500,2500),RLSE)                                   
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
