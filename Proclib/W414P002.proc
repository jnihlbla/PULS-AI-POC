//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W414P002 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W414..W414D1,                                             
//             INDUT=&W414..W414D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W414PD02),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W41402(+0),DISP=SHR                                  
//************ RAD O. OBKR-TRANSAR                                              
//*                                                                             
//SORTOUT  DD  DSN=&&W41402S,DISP=(NEW,PASS,DELETE),                            
//************ SORTERAD EFTER ARTNR                                             
//             SPACE=(27998,(753,219),RLSE)                                     
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W41402   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W41402,W41402,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDK7     INCLUDE MEMBER=WDK7                                                  
//WDB2     INCLUDE MEMBER=WDB2                                                  
//WDD9     INCLUDE MEMBER=WDD9                                                  
//*                                                                             
//W41402D1 DD  DSN=&&W41402S,DISP=(OLD,DELETE,DELETE)                           
//*                                                                             
//W41402D2 DD  DSN=&INDUT..W41403(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ ORDERRADER OCH OBKR. KOMPL. MED ART.INFO                         
//             MGMTCLAS=&DEL2BKPC,SPACE=(27998,(753,219),RLSE)                  
//*                                                                             
//W41402D3 DD  DSN=&INDUT..W41403A(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//************ PASSIVE PARTS INFO                                               
//             MGMTCLAS=&DEL2BKPC,SPACE=(27998,(753,219),RLSE)                  
