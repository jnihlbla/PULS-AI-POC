//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  FUNCTION: Create a formatted report using AFP Conversion and     *         
//*            Indexing Facility (ACIF) and then convert it to        *         
//*            PDF file using CA-spool PDF-transformer.               *         
//*                                                                   *         
//*  PARAMETERS:                                                      *         
//*                                                                   *         
//*    DSIN:     The name of a plain-text report file.                *         
//*                                                                   *         
//*    DSOUTPDF: The name of the output PDF file.                     *         
//*                                                                   *         
//*    PDFDISP:  Dispostion for the output PDF file.                  *         
//*              Default is (NEW,CATLG,DELETE)                        *         
//*                                                                   *         
//*    PDFMGMTC: Management class for the output PDF file.            *         
//*              Default class is DEL2.                               *         
//*                                                                   *         
//*    PDFDATAC: Data class for the output PDF file.                  *         
//*              Default class is PSEN.                               *         
//*                                                                   *         
//*    ACIFLIB:  The name of a library containing parameters for      *         
//*              ACIF. See ACIFCMDF and ACIFCMDS below.               *         
//*              By default, the CONSTANT library in the current      *         
//*              runtime environment is used.                         *         
//*                                                                   *         
//*    ACIFCMDF: The name of an ACIFLIB member containing general     *         
//*              FIXED ACIF parameters.                               *         
//*              Default: WZ11ACIF (normally not overridden)          *         
//*                                                                   *         
//*    ACIFCMDS: The name of an ACIFLIB member containing additional  *         
//*              report-specific ACIF parameters.                     *         
//*              Examples of such paramters:                          *         
//*               CC=YES/NO          -- Does the report contain ASA   *         
//*                                     carriage control characters?  *         
//*               USERLIB=W.QASE.PSF -- Name of application-specific  *         
//*                                     resource library              *         
//*               FORMDEF=F1xxxxxx   -- Formdef used for this report  *         
//*               PAGEDEF=P1xxxxxx   -- Pagedef used for this report  *         
//*              These parameters may alternatively be be given       *         
//*              in the JCL stream via //ACIFCMDS DD *                *         
//*                                                                   *         
//*    ESFADDR: Parameter to CA-spool. Default value below enforces   *         
//*             A4 format. Specify "ESFADDR=" to revert to normal     *         
//*             CA-spool functionality. This can be triggered in D&P  *         
//*             by specifying a formdef/pagedef starting with an "*". *         
//*                                                                   *         
//*    MAXRC:   The maximum allowed return code from ACIF or CA-spool *         
//*             A higher return code results in a U0016 abend.        *         
//*             Default: 3                                            *         
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ11PDF  PROC DSIN=NULLFILE,DSOUTPDF=NULLFILE,                                
//             PDFDISP=(NEW,CATLG,DELETE),                                      
//             PDFDATAC=PSEN,PDFMGMTC=DEL2,                                     
//             ACIFLIB=&INDRTE..CONSTANT,                                       
//             ACIFCMDF=WZ11ACIF,ACIFCMDS=MISSING,                              
//             ESFADDR=('D2EPROJ=A2PDA4'),                                      
//             MAXRC=3                                                          
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ACIF     EXEC PGM=APKACIF,REGION=8M                                           
//SYSIN    DD  DSN=&ACIFLIB(&ACIFCMDF),DISP=SHR                                 
//         DD  DDNAME=ACIFCMDS                                                  
//ACIFCMDS DD  DSN=&ACIFLIB(&ACIFCMDS),DISP=SHR                                 
//*                                                                             
//INPUT    DD  DSN=&DSIN,DISP=SHR                                               
//OUTPUT   DD  DSN=&&AFPDS,DISP=(NEW,PASS),                                     
//************  AFP PRINT STREAM                                                
//             LRECL=32756,RECFM=VBM,DSORG=PS,                                  
//             DATACLAS=PSEN                                                    
//INDEX    DD  DSN=&&INDEX,DISP=(NEW,PASS),                                     
//************  INDEXING INFORMATION                                            
//             LRECL=32756,RECFM=VB,DSORG=PS,                                   
//             DATACLAS=PSEN                                                    
//RESLIB   DD  DSN=&&RESOURCE,DISP=(NEW,PASS),                                  
//************  USED AFP RESOURCES                                              
//             LRECL=12284,RECFM=VBM,DSORG=PS,                                  
//             DATACLAS=PSEN                                                    
//SYSPRINT DD  SYSOUT=*                                                         
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//CHECKA IF    (ACIF.RC <= &MAXRC) THEN                                         
//*                                                                             
//CASPOOL EXEC ESFBATCH,ADDR=&ESFADDR                                           
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUT1   DD  DSN=&&RESOURCE,DISP=(OLD,PASS)                                   
//         DD  DSN=&&AFPDS,DISP=(OLD,PASS)                                      
//SYSUT2   DD  DSN=&DSOUTPDF,DISP=&PDFDISP,                                     
//             DATACLAS=&PDFDATAC,MGMTCLAS=&PDFMGMTC                            
//*                                                                             
//CHECKA  ENDIF                                                                 
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//CHECKB   IF  (ACIF.RC > &MAXRC OR CASPOOL.ESFAPI.RC > &MAXRC) THEN            
//*                                                                             
//PABEND  EXEC PGM=ABEND,PARM='1234567890123456'                                
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//*                                                                             
//CHECKB  ENDIF                                                                 
//*                                                                             
