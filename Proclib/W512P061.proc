//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES A MONTHLY  FILE WHERE IDFTG= 57                                    
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W512M2                                       
//*                                                                             
//*  RESTART:      W51261      NORMAL                                           
//*                READS        WDB6                                            
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W512P061 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W011..&RTEGRP.,                                           
//             INDIN1=&W011..LDC,                                               
//             INDIN2=&W011..NDC,                                               
//             INDIN3=&W011..SDC,                                               
//             INDUT=&W512..W512M2                                              
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT01   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W512PD61),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN1..W01184(+0),DISP=SHR                                 
//************ LDC                                                              
//*                                                                             
//         DD  DSN=&INDIN2..W01184(+0),DISP=SHR                                 
//************ NDC                                                              
//*                                                                             
//         DD  DSN=&INDIN3..W01184(+0),DISP=SHR                                 
//************ SDC                                                              
//*                                                                             
//SORTOUT  DD  DSN=&&W01184,DISP=(NEW,PASS,DELETE),                             
//************ SORTED FILE ON IDDC AND IDARTNR                                  
//         DATACLAS=PSEN                                                        
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT02   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W011PD60),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W01160(+0),DISP=SHR                                  
//************ CDC INFO                                                         
//*                                                                             
//SORTOUT  DD  DSN=&&W01160,DISP=(NEW,PASS,DELETE),                             
//************ SORTED FILE ON IDDC AND IDARTNR                                  
//         DATACLAS=PSEN                                                        
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51261   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W51261,W51261,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSPRINT DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDB6     INCLUDE MEMBER=WDB6                                                  
//W51261D1 DD  DSN=&&W01160,DISP=(OLD,DELETE,DELETE)                            
//************ W01160 FILE                                                      
//*                                                                             
//W51261D2 DD  DSN=&&W01184,DISP=(OLD,DELETE,DELETE)                            
//************ FILE SORTED ON IDDC & IDARTNR                                    
//*                                                                             
//W51261D3 DD  DSN=&INDUT..W51261(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ FILE WITH IDFTG= 57                                              
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
