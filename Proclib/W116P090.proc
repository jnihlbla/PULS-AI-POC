//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  BYTER FÖR LOKALA LEVERANTÖRER OCH HUVUDLEVERANTÖRER UT                     
//*  SJÄLVKOST MED BESTÄLLNINGSPRIS(SEK)/SJÄLVKOST SOM ÄR                       
//*  OMRÄKNAD MED MÅNADSVALUTA.                                                 
//*                                                                             
//*  FREKVENS:     DAG     RTN W116D4                                           
//*                                                                             
//*  ÅTERSTART:    W11690      NORMAL                                           
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W116P090 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=NULLFILE,                                                 
//             INDIN2=NULLFILE,                                                 
//             INDREG=&W335,                                                    
//             INDUT=NULLFILE                                                   
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT01  EXEC PGM=SORT                                                         
//SORTIN   DD  DSN=&INDIN1,DISP=SHR                                             
//         DD  DSN=&INDIN2,DISP=SHR                                             
//SORTOUT  DD  DSN=&&W11690,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEB                                                    
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W116PD10),DISP=SHR                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11690   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W11690,W11690,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY,DCB=(RECFM=VB,BLKSIZE=1408,BUFNO=1)                        
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDB1     INCLUDE MEMBER=WDB1                                                  
//WDB1BK   DD   DSN=&INDBAS..WDB1BK,DISP=SHR                                    
//*                                                                             
//W11690D1 DD  DSN=&&W11690,DISP=SHR                                            
//************ FIL FRÅN W11689(NDC), W11621(CHINA)                              
//*                                                                             
//W11690D2 DD  DSN=&INDREG..W33588(+0),DISP=SHR                                 
//************ FIL FRÅN W33588                                                  
//*                                                                             
//W11690D3 DD  DSN=&&W11690S,DISP=(NEW,PASS,DELETE),                            
//************ SAMMA SOM D1 MED UTBYTT SJÄLVKOST FÖR LOKALA LEV                 
//************ OCH HUV-LEV SJÄLVKOST TILL MÅNADSKURS                            
//             DATACLAS=PSEB                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT02   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W116PD09),DISP=SHR                         
//SORTIN   DD  DSN=&&W11690S,DISP=(OLD,DELETE,DELETE)                           
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W11690(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ SAMMA SOM D1 MED UTBYTT SJÄLVKOST FÖR LOKALA LEV                 
//************ OCH HUV-LEV SJÄLVKOST TILL MÅNADSKURS                            
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
