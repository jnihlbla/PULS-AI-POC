//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*                                                                             
//*  FREQUENCE:    WEEKLY    RTN W810D2    (WEEKLY JOB)                         
//*                                                                             
//*  RESTART:      W81010    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W810P010 PROC STPLIB=&INDRTE..LOAD, -- PERHAPS REMOVE COMMA                   
//             INDIN1=&W111..W810D2,                                            
//             INDIN2=&WXTR..PARTINFO,                                          
//             INDUT=&W810..W810D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W81010   EXEC PGM=V16459,PARM='W81010/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR             -- DATKORT           
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR      -- DATKORT           
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//W81010D1 DD  DSN=&INDIN1..W11184A(+0),DISP=SHR                                
//************ GOODS ITEM SORTED BY ARTICLE NO                                  
//*                                                                             
//W81010D2 DD  DSN=&INDIN2..WCDCWEEK(+0),DISP=SHR                               
//************ CDC-INFORMATION                                                  
//*                                                                             
//W81010D3 DD  DSN=&INDUT..W81010(+1),DISP=(NEW,CATLG,DELETE), -LIM(3           
//************ REPORT FOR FIFO REVISIONKEMI                                     
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
