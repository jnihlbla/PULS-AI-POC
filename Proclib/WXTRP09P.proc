//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES FILE CONTAINING PART AND NDC INFORMATION, ADDS BINNING             
//*  DATE FROM W61271 FILE                                                      
//*                                                                             
//*  FREQUENCE:    DAILY     RTN WXTRD2                                         
//*                                                                             
//*  RESTART:      WXTR9P    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTRP09P PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WXTR..WXTRD2,                                             
//             INDUT=&WXTR..WXTRD2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTR9P   EXEC PGM=V16459,PARM='WXTR9P/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//WXTR9PD1 DD  DSN=&INDIN..WXTR9NA(+0),DISP=SHR                                 
//************ NDC INFORMATION                                                  
//*                                                                             
//WXTR9PD2 DD  DSN=&INDIN..WXTR9KA(+0),DISP=SHR                                 
//************ CN-INFORMATION                                                   
//*                                                                             
//WXTR9PD3 DD  DSN=&INDIN..W61271A(+0),DISP=SHR                                 
//************ WDL6 INFO - BINNING DATE                                         
//*                                                                             
//TPFIL1   DD  DSN=&&TEMP1,DISP=(NEW,DELETE,DELETE),                            
//************ WDL6 INFO - BINNING DATE                                         
//             DATACLAS=PSEB                                                    
//*                                                                             
//WXTR9PD4 DD  DSN=&INDUT..WXTR9N(+1),                          -LIM(1)         
//************ NDC-INFORMATION (NDC-LAGERBAND)                                  
//             DISP=(NEW,CATLG,DELETE),                                         
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=DEL2                                                    
//*                                                                             
//WXTR9PD5 DD  DSN=&INDUT..WXTR9K(+1),                          -LIM(1)         
//************ NDC-INFORMATION + CHINA SPECIFIC INFO                            
//             DISP=(NEW,CATLG,DELETE),                                         
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=DEL2                                                    
//*                                                                             
