//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LÄSER ARTIKELFILER USA OCH PRISTILLÄMPAR ARTIKLAR ÅT RAPPORTFIL            
//*                                                                             
//*  FREQUENCE:    MONTHLY   RTN W560R1                                         
//*                                                                             
//*  RESTART:      W56081    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W560P081 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W011..NDC,                                                
//             INDUT=&W560..W560R1                                              
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* EXTRACT NDC-US AND NDC-CA FROM NDC FILE                                     
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WSORT1  EXEC PGM=SORT                                                         
//SORTIN   DD  DSN=&INDIN..W01184(+0),DISP=SHR                                  
//************** LAGERBAND W01184                                               
//*                                                                             
//SORTOUT  DD  DSN=&&W01184,DISP=(NEW,PASS,DELETE),                             
//**************  SORTERAD ARTIKELFIL NDC                           ***         
//             DATACLAS=PSEN                                                    
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W560PD81),DISP=SHR                         
//*SORTERA W01184 PÅ ARTIKELNUMMER OCH DC                                       
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56081   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W56081,W56081,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDB2     INCLUDE MEMBER=WDB2                                                  
//WDB1     INCLUDE MEMBER=WDB1                                                  
//WDC1     INCLUDE MEMBER=WDC1                                                  
//WDC2     INCLUDE MEMBER=WDC2                                                  
//WDK7     INCLUDE MEMBER=WDK7                                                  
//WDF1     INCLUDE MEMBER=WDF1                                                  
//WDG2     INCLUDE MEMBER=WDG2                                                  
//WDB6     INCLUDE MEMBER=WDB6                                                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56081D1 DD  DSN=&&W01184,DISP=(OLD,DELETE,DELETE)                            
//************ SORTERAT LAGERBAND (NDC-NA)                                      
//*                                                                             
//W56081D2 DD  DSN=&INDUT..W56081(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ ALLA LAB-ARTIKLAR LEV 1441, MED PRISTILLÄMPAT PRIS               
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
