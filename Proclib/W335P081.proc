//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  MONTHLY UPDATE OF MULTILANGUAGE FILE TO BE SENT TO                         
//*  AS400 AMC-PRICE SYSTEMS.                                                   
//*                                                                             
//*  FREKVENS:     REDOVISNINGSPERIOD     RTN W335B9                            
//*                                                                             
//*  ÅTERSTART:    W33581      NORMAL                                           
//*                LÄSER        WDD3                                            
//*                             WDK6                                            
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W335P081 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&INDRTE.,                                                  
//             INDUT=&W335..W335B9                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33581A  EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W33581,W33581,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDD3     INCLUDE MEMBER=WDD3                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//W33581D1 DD  DSN=&&W33581,DISP=(NEW,CATLG,DELETE),                            
//************ UNSORTED MILTILANGUAGE FILE FROM WDD3 SB                         
//             SPACE=(477,(150,100),RLSE),AVGREC=K,                             
//             DATACLAS=PSEB                                                    
//*                                                                             
//W33581D2 DD  DSN=&INDUT..W33588(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ SUMFILE  TOT NO OF RECORDS ON LANGFILE                           
//             SPACE=(477,(1,1),RLSE),AVGREC=U,                                 
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33581B  EXEC PGM=SORT,REGION=8M                                              
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDIN..CONSTANT(W335PD81),DISP=SHR                          
//SORTIN   DD  DSN=&&W33581,DISP=(OLD,DELETE,DELETE)                            
//************ UNSORTED MILTILANGUAGE FILE FROM WDD3                            
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W33581(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//             SPACE=(477,(150,100),RLSE),AVGREC=K,                             
//************ SORTED MULTILANGUAGE FILE TO AS400 AMC PRICE.                    
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
