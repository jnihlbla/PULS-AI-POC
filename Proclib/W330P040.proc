//************ URVALSFIL                                                        
//*                                                                             
//W33040D4 DD  DSN=&INDUT..W33041(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ RESULTAT P-URVAL                                                 
//**           DCB=(RECFM=FB,LRECL=239,BLKSIZE=23900),                          
