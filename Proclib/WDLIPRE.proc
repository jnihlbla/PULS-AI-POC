//WDLIPRE PROC INDABE=&INDRTE                                                   
//*                                                                             
//PRE    EXEC  PGM=DFSRRC00,                                                    
//             PARM='ULU,DFSURPR0'                                              
//STEPLIB  DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//         DD  DSN=&INDGRND..DBDLIB,DISP=SHR                                    
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDABE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//DFSURCDS DD  DSN=&&DFSURCDS,DISP=(NEW,PASS,DELETE),                           
//             SPACE=(CYL,(1,1)),                                               
//             DCB=BLKSIZE=14400                                                
//*                                                                             
//ABEND   EXEC PGM=ABEND,COND=(0,EQ,PRE),PARM='1234567890123456'                
