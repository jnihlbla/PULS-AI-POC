//W555P090 PROC INDIN=&W555..W555D2,                                            
//             INDUT=&W555..W555D2,                                             
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * *                                                         
//W55512   EXEC PGM=V16459,PARM='W55512/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(8192,(10000,4000))                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//SORTMSG  DD  SYSOUT=*                                                         
//W55512D1 DD  DSN=&INDIN..W55510(+0),DISP=SHR                                  
//************ SOL-POSTER FRÅN W555P010                                         
//*                                                                             
//TPFIL1   DD  DSN=&&TEMP1,DISP=(NEW,DELETE,DELETE),                            
//************ TEMPORÄR ARBETSFIL                                               
//             DATACLAS=PSEB                                                    
//*                                                                             
//TPFIL2   DD  DSN=&&TEMP2,DISP=(NEW,DELETE,DELETE),                            
//************ TEMPORÄR ARBETSFIL                                               
//             DATACLAS=PSEB                                                    
//*                                                                             
//TPFIL3   DD  DSN=&&TEMP3,DISP=(NEW,DELETE,DELETE),                            
//************ TEMPORÄR ARBETSFIL                                               
//             DATACLAS=PSEB                                                    
//*                                                                             
//W55512D2  DD  DSN=&INDUT..W55511(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ FIL MED POSTER SOM SKALL RENSAS I SOL (SUM-DUBBLETTER)           
//             DATACLAS=PSEB,MGMTCLAS=&BACKUPC                                  
//*                                                                             
//W55512D3  DD  DSN=&INDUT..W55512(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ FIL MED POSTER SOM SKALL RENSAS I SOL (SUM-POSTER)               
//             DATACLAS=PSEB,MGMTCLAS=&BACKUPC                                  
//*                                                                             
//W55512D4  DD  DSN=&INDUT..W55513(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ FIL MED POSTER SOM SKALL UPPDATERA SOL (DET-POSTER)              
//             DATACLAS=PSEB,MGMTCLAS=&BACKUPC                                  
