//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR DAGLIG UPPFÖLJNINGSFIL OCH KOPIERAR TILL EXTRAKT                    
//*                                                                             
//*  FREQUENCE:    DAILY    RTN W428V1                                          
//*                                                                             
//*  RESTART:      W42820    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W428P020 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W418..W418D2,                                            
//             INDIN2=&W011..&RTEGRP.,                                          
//             INDIN3=&W011,                                                    
//             INDUT1=&W428..W428V1,                                            
//             INDUT2=&WXTR..W428V1                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTDCAR),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN3..LDC.W01184(+0),DISP=SHR                             
//         DD  DSN=&INDIN3..SDC.W01184(+0),DISP=SHR                             
//         DD  DSN=&INDIN3..NDC.W01184(+0),DISP=SHR                             
//************ SAMTLIGA DATAELEMENT FRÅN WDK711, IDDC = SDC                     
//*                                                                             
//SORTOUT   DD DSN=&&W01184,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEB                                                    
//*                                                                             
//W42820   EXEC PGM=V16459,PARM='W42820/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//*                                                                             
//W42820D1 DD  DSN=&INDIN1..W41842(+0),DISP=SHR                                 
//************ KOPIA AV WDA2                                                    
//*                                                                             
//W42820D2 DD  DSN=&INDIN2..W01160(+0),DISP=SHR                                 
//************ DAGLIGA LAGERBANDET (WDK6)                                       
//*                                                                             
//W42820D3 DD  DSN=&INDUT1..W42820(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ UPPFÖLJNINGSFIL  (LEVERANSANMÄRKNINGAR)                          
//*   SB37     SPACE=(400,(350,150),RLSE),AVGREC=K,                             
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//W42820D4 DD  DSN=&&W01184,DISP=(OLD,DELETE,DELETE)                            
//************ DAGLIGA LAGERBANDET (WDK7) (SORT IDDC,ARTNR)                     
//*                                                                             
//TEMPFIL  DD  SPACE=(309,(400,200)),AVGREC=K                                   
//*                                                                             
//TEMPFIL2 DD  SPACE=(309,(400,200)),AVGREC=K                                   
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  KOPIERAR W42820 TILL EXTRAKTFIL WXTR8D                                     
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTR8D   EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDUT1..W42820(+1),DISP=SHR                                 
//************ UPPFÖLJNINGSFIL (LEVERANSANMÄRKNINGAR)                           
//*                                                                             
//SYSUT2   DD  DSN=&INDUT2..WXTR8D(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ UPPFÖLJNINGSFIL (LEVERANSANMÄRKNINGAR)                           
//             MGMTCLAS=NOBACKUP,DATACLAS=PSEB                                  
//*                                                                             
