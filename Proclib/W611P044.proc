//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W611P044 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN2=&W011,                                                    
//             INDIN=&W611..W611V2,                                             
//             INDUT=&W611..W611V2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61144   EXEC PGM=V16459,PARM='W61144/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR         -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W61144D1 DD  DSN=&INDIN2..W01177(+0),DISP=SHR                                 
//************ LAGERBAND                                                        
//*                                                                             
//W61144D2 DD  DSN=&&TEMP1,DISP=(NEW,PASS,DELETE),                              
//************ SELEKTERAT LAGERBAND                                             
//         SPACE=(435,(180,25),RLSE),AVGREC=K                                   
//*                                                                             
//W61144D3 DD  DSN=&INDIN..W61142(+0),DISP=SHR                                  
//************ EXTRAKT                                                          
//*                                                                             
//W61144D4 DD  DSN=&INDUT..W61144(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ UPPDATERINGS UPPDRAG TILL DB2-BASEN                              
//             SPACE=(8,(100,25),RLSE),AVGREC=K,                                
//             MGMTCLAS=&BACKUPC                                                
