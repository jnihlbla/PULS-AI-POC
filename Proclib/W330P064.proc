//W330P064 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W330..W330B1,                                             
//             INDUT=&W330..W330B1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33064   EXEC PGM=V16459,PARM='W33064/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DUMMY                                                            
//W33064D1 DD  DSN=&INDIN..W33063(+0),DISP=SHR                                  
//************ SUMMERADE RESULTAT AV URVAL FÖR LISTA T3                         
//*                                                                             
//W33064D2 DD  DSN=&INDUT..W33064(+1),DISP=(NEW,CATLG,DELETE),  -LIM(5)         
//************ FIL FÖR LISTA T3                                                 
//**           DCB=(RECFM=FBA,LRECL=122,BLKSIZE=23424),                         
//             MGMTCLAS=NOBACKUP,                                               
//             VOL=(,,,2),SPACE=(23424,(2000,2000),RLSE)                        
//*                                                                             
