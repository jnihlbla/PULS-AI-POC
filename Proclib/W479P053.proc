//SYSUDUMP  DD SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSIN     DD DSN=&INDRTE..CONSTANT(W479P531),DISP=SHR                         
//*  SORTAS PÅ DIST, KUND, KUNDREF, PRODNR OCH PURAD                            
//SORTIN    DD DSN=&INDIN..W47952(+0),DISP=SHR                                  
//SORTOUT   DD DSN=&&SORT52,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEB                                                    
//************ TEMPORÄRFIL, SORTAD W47952                                       
