//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(20000,127))                                         
//SORTMSG  DD  SYSOUT=*                                                         
//*                                                                             
//W47953D1 DD  DSN=&&SORT52,DISP=(OLD,DELETE,DELETE)                            
//************ TEMPORÄRFIL, EV ORDER I ARBETE                                   
