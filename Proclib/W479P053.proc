//SORT63  EXEC PGM=SORT                                                         
//*                                                                             
//SYSOUT    DD SYSOUT=*                                                         
//SORTMSG   DD SYSOUT=*                                                         
//SYSUDUMP  DD SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSIN     DD DSN=&INDRTE..CONSTANT(W479P532),DISP=SHR                         
