//*  LÄSER HELA PEDAL-BASEN WDR9 OCH ALLA HÄNDELSER PÅ INFILEN OCH              
//*  SKAPAR FILER FÖR RENSNING AV WDR9, SAMT FÖR KONTROLL O ANALYS              
//*                                                                             
//*  FREKVENS:     DAG     RTN W561D2                                           
//*                                                                             
//*  ÅTERSTART:    W56161    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W561P061 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W561..W561D2,                                             
//             INDUT=&W561..W561D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56161   EXEC PGM=W56161                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W56161D1 DD  DSN=&INDIN..W56161(+0),DISP=SHR                                  
//************ EKONOMISK HÄNDELSEFIL                                            
//*                                                                             
//W56161D2 DD  DSN=&INDIN..W5616A(+0),DISP=SHR                                  
//************ EKONOMISK HÄNDELSEFIL                                            
//*                                                                             
//W56161D3 DD  DSN=&INDUT..W56162(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ POSTER TILL PGM W56162 FÖR KONTROLL                              
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W56161D4 DD  DSN=&INDUT..W5616B(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ POSTER TILL PGM W56164 FÖR INLADNING DATABAS                     
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
