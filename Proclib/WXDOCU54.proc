//*          ****************************************                           
//*          *         XICS - VERSION 5.4           *                           
//*          *  DOCUMENT COMPONENT LIBRARY UTILITY  *                           
//*          *               DOCUTL                 *                           
//*          ****************************************                           
//*                                                                             
//WXDOCU54 PROC PROG=DOCUTL,                                                    
//           LOADLIB=VPUBV1.XICS54.LOAD,                                        
//           IMGIN=NULLFILE,                                                    
//           ONLINE=3,                                                          
//           FORM=4650,                                                         
//           DEST1=&CPRINT,                                                     
//*          CONFIG=VPUBV1.XICS54.CONFIG(X4650),                                
//           CONFIG=NULLFILE,                                                   
//           OPTFIL=NULLFILE,                                                   
//           EPICFIL=NULLFILE,                                                  
//           DCLIBM1=&W153..&RTEGRP..DCLIBX,                                    
//           DCLIBM2=&W153..&RTEGRP..DCLIBY,                                    
//           DCLIBS=&W153..&RTEGRP..DCLIBZ,                                     
//           WIDSFIL=VPUBV1V.XICS54.X46WID,                                     
//           MSGFILE=VPUBV1V.XICS54.XICSMSG                                     
//*                                                                             
//DU      EXEC PGM=&PROG,                                                       
//             COND=(4,LT)                                                      
//STEPLIB   DD DSN=&LOADLIB,DISP=SHR                                            
//SYSUDUMP  DD SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//*                                                                             
//CSSIN     DD DSN=&IMGIN,DISP=OLD                  IMAGE INPUT FILE            
//*                                                                             
//CSSOUT    DD DISP=(NEW,PASS),                     OFFLINE OUTPUT              
//             SPACE=(TRK,(50,50),RLSE),                                        
//             DCB=(RECFM=VB,LRECL=8196,BLKSIZE=8200)                           
//CSS03     DD SYSOUT=(&ONLINE,,&FORM),DEST=&DEST1, ONLINE OUTPUT               
//             DCB=(RECFM=UA,BLKSIZE=150)                                       
//TAPEOUT   DD DUMMY,                               IMAGE TAPE OUT              
//             DCB=(RECFM=U,BLKSIZE=9000,DEN=3),    IMAGE TAPE OUT              
//             SPACE=(TRK,(50,50),RLSE),DISP=(NEW,PASS)                         
//*            UNIT=T9                                                          
//FT03F001  DD DSN=&CONFIG,DISP=SHR                 CONFIG FILE                 
//FT05F001  DD DSN=&OPTFIL,DISP=SHR                 OPTION ENTRIES              
//FT06F001  DD SYSOUT=*,DCB=BUFNO=1                 LOG & ERROR                 
//*                                                                             
//* CSS09     DD DSN=&EPICFIL,                      EPIC RANDOM INPUT           
//*              DISP=SHR,DCB=(RECFM=F,BLKSIZE=512),                            
//*                                                                             
//FT08F001  DD DSN=&EPICFIL,DISP=SHR                EPIC SEQNTL INPUT           
//*                                                                             
//VSRN01    DD DSN=&DCLIBM1,DISP=SHR                MERGE DCLIB 1               
//VSRN03    DD DSN=&DCLIBM2,DISP=SHR                MERGE DCLIB 2               
//VSRN02    DD DSN=&DCLIBS,DISP=OLD                 SAVE DCLIB                  
//*                                                                             
//VSRN05    DD DSN=&WIDSFIL,DISP=SHR                WIDTHS FILE                 
//VSRN06    DD DSN=&MSGFILE,DISP=SHR                MESSAGE DATA BASE           
