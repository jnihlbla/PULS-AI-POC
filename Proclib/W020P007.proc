//*  ÅTERSTART:    W02007    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W020P007 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W020..W020V1,                                             
//             INDUT=&W020..W020V1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W02007   EXEC PGM=V16459,PARM='W02007/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W02007D1 DD  DSN=&INDIN..W02007(+0),DISP=SHR                                  
//************ DIST, KUND, FÖRSTA LAGER                                         
//*                                                                             
//W02007D2 DD  DSN=&INDIN..W02008(+0),DISP=SHR                                  
//************ SRS-INFO                                                         
//*                                                                             
//W02007D3 DD  DSN=&&W02009,DISP=(NEW,PASS,DELETE),                             
//************ SRS-INFO KOMPLETTERAD MED IDDC-PRIM                              
//************ DC STÄMMER ÖVERRENS                                              
//             SPACE=(26,(125,41),RLSE),AVGREC=K                                
//*                                                                             
//W02007D4 DD  DSN=&&W02030,DISP=(NEW,PASS,DELETE),                             
//************ SRS-INFO KOMPLETTERAD MED IDDC-PRIM                              
//************ DC STÄMMER INTE !!!!! ÖVERRENS                                   
//             SPACE=(26,(125,41),RLSE),AVGREC=K                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT09   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W020PD71),DISP=SHR                         
//SORTIN   DD  DSN=&&W02009,DISP=(OLD,DELETE,DELETE)                            
//************ SRS-INFO KOMPLETTERAD MED IDDC-PRIM                              
//************ DC STÄMMER ÖVERENS                                               
//************ SORTERAD PÅ IDDC DISTR ORDKL OCH KDPRODSL                        
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W02009(+1),DISP=(NEW,CATLG,DELETE),  -LIM(6)         
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT30   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W020PD72),DISP=SHR                         
//SORTIN   DD  DSN=&&W02030,DISP=(OLD,DELETE,DELETE)                            
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W02030(+1),DISP=(NEW,CATLG,DELETE),  -LIM(6)         
//************ SRS-INFO KOMPLETTERAD MED IDDC-PRIM                              
//************ DC STÄMMER INTE !!!!! ÖVERENS                                    
//************ SORTERAD PÅ IDDC-PRIM OCH IDARTNR                                
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
