//W371P083 PROC INDREG=&W371,INDUT=&W371..W371V1,                               
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W37183   EXEC PGM=W37183                                                      
//STEPLIB   DD DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//          DD DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT    DD SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                     -- ABEND           
//V16247D3  DD SYSOUT=*                                                         
//SYSUDUMP  DD SYSOUT=*                                                         
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//*                                                                             
//W37183D1  DD DSN=&INDREG..W37181(+0),DISP=SHR                                 
//*                                                                             
//W37183D2  DD DSN=&INDUT..W37183(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//             SPACE=(6233,(10,5),RLSE),                                        
//             MGMTCLAS=&NOBACKUP                                               
