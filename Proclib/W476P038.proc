//             DSUT=NULLFILE                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W476PD38),DISP=SHR                         
//SORTIN   DD  DSN=&DSIN,DISP=SHR                                               
//************ BROKER-INFO FRÅN W4762500                                        
//*                                                                             
//SORTOUT  DD  DSN=&&W47635,DISP=(NEW,PASS,DELETE),                             
//************ SORTERAD: FAKT.NR,TYP,,ORDERNR,ARTIKELNR(VÄNSTER)                
