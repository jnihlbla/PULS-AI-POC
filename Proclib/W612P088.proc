//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W612P088 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W612..W612R4,                                             
//             INDUT=&W612..W612R4,                                             
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61288   EXEC PGM=V16459,PARM='W61288/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD SYSOUT=(D,,DUMP),DEST=QSE09012,HOLD=YES                           
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR         -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//A4LF  OUTPUT FORMDEF=SLSR6C,PAGEDEF=SLSR6C                                    
//************ A4 LANDSCAPE, SINGLE SIDE, RASTER  (FOLDED PAPER)                
//W61288D1 DD  DSN=&INDIN..W61288(+0),DISP=SHR                                  
//************ FIL FRÅN W612P208                                                
//*                                                                             
//W61288D3 DD  SYSOUT=(A,,STD),DEST=&DEST1,OUTPUT=(*.A4LF)                      
//************ W61288-002 DC41                                                  
//*                                                                             
//W61288D5 DD  SYSOUT=(A,,STD),DEST=&DEST1,OUTPUT=(*.A4LF)                      
//************ W61288-004 DC43                                                  
//*                                                                             
//W61288D6 DD  DSN=&INDUT..W61289(+1),                      --LIM(1)            
//************ W61289-005 FOLLOW UP REPORT TO D&P FOR ALL WEB DC                
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W61288D7 DD  DSN=&INDUT..W6128A(+1),                      --LIM(1)            
//************ W61288-011 DC 11 TO D&P                                          
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
