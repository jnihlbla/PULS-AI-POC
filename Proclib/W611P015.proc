//*  HÄMTAR EVENTUELL ERSÄTTANDE ARTIKEL TILL CD-ARTIKLAR                       
//*  MED ERSÄTTNINGSKOD OCH SKRIVER LISTA.                                      
//*                                                                             
//*  FREQUENCE:    WEEK      RTN W611V3                                         
//*                                                                             
//*  RESTART:      W61115    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W611P015 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W611..W611V3,                                             
//             INDIN2=&W011..&RTEGRP.,                                          
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61115   EXEC PGM=V16459,PARM='W61115/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),DEST=LOCAL,HOLD=YES                             
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//A4LF  OUTPUT FORMDEF=SLSR6C,PAGEDEF=SLSR6C                                    
//************ A4 LANDSCAPE, SINGLE SIDE, RASTER  (FOLDED PAPER)                
//W61115D1 DD  DSN=&INDIN..W61114(+0),DISP=SHR                                  
//************ CD-ART MED ERS-KOD                                               
//*                                                                             
//W61115D2 DD  DSN=&INDIN2..W01103(+0),DISP=SHR                                 
//************ ERSATTA/ERSÄTTANDE ARTIKLAR(WDD7)                                
//*                                                                             
//W61115D3 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF)                     
//************ W61115  CD-ART MED ERS-KOD - LISTA W61115-001                    
//*                                                                             
