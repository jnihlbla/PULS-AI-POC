//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LÄSER FIL MED ARTIKLAR SOM SKALL AUTOMATRETURNERAS                         
//*  FRÅN SDC/LDC LÄGGER UPP TRANSAR PÅ WDE3                                    
//*                                                                             
//*  OBS PROCEDUREN ANVÄNDER PGM W27111                                         
//*                                                                             
//*                                                                             
//*  FREKVENS:     DAG         RTN W271D4                                       
//*                                                                             
//*  ÅTERSTART:              NORMAL                                             
//*                W27111    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W271J117 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W271..W271D4,                                             
//             CPU=1                                                            
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W271PD17),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W27117(+0),DISP=SHR                                  
//         DD  DSN=&INDIN..W27159(+0),DISP=SHR                                  
//         DD  DSN=&INDIN..W2712C(+0),DISP=SHR                                  
//************ ARTIKLAR FÖR AUTOMATISK RETUR, SDC/LDC                           
//*                                                                             
//SORTOUT  DD  DSN=&&W27117,DISP=(NEW,PASS,DELETE),                             
//************ ARTIKLAR FÖR AUTOMATISK RETUR, SDC/LDC SORTERADE                 
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W27111   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W27111,W27111,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//W27111D1 DD  DSN=&&W27117,DISP=(OLD,DELETE,DELETE)                            
//************ ARTIKLAR FÖR AUTOMATISK RETUR, SDC/LDC SORTERADE                 
//*                                                                             
