//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SOP PASSWORD MAINTENANCE                                                   
//*                                                                             
//*  FREQUENCE:    ACCOUNTING PERIOD   RTN W980R1                               
//*                                                                             
//*  RESTART:      W98050    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W980P045 PROC STPLIB=&INDRTE..LOAD,                                           
//             SOPREG=&INDRTE..SOP,                                             
//             PDSLIB=&INDRTE..JCL,                                             
//             PDSTEMP=&INDRTE.TMP.JCL,                                         
//             NEXTJOB=W980J046                                                 
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W98045   EXEC PGM=W98045,PARM='&NEXTJOB'                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=M                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//*                                                                             
//SOPDD1   DD  DSN=&SOPREG,DISP=SHR            -- SOP DATA BASE                 
//PDSDD1   DD  DSN=&PDSTEMP,DISP=SHR           -- TEMP PDS JOB LIB              
//PDSDD2   DD  DSN=&PDSLIB,DISP=SHR            -- PDS JOB LIB                   
