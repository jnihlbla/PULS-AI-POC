//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES OUTPUTFILE WITH SUMMARIZED ALARM-RECORDS FOR EXCH-PARTS            
//*                                                                             
//*  FREQUENCE:    ACCOUNT   RTN W371P3                                         
//*                                                                             
//*  RESTART:      W37172    NORMAL                                             
//*                READS     WDK6                                               
//*                          WDK7                                               
//*                          WDA9                                               
//*                          WDR4                                               
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W371P072 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W371..W371P3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W37172   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,DSNMTV01,W37172,,00')                                
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//DDOTV02  DD  DSN=&&W37172BT,DISP=(NEW,PASS,DELETE),                           
//             SPACE=(TRK,(1,1),RLSE),                                          
//             DCB=(RECFM=VB,LRECL=4092)                                        
//DDITV02  DD  DSN=&INDRTE..CONSTANT(W37172I2),DISP=SHR                         
//*                                                                             
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDK7     INCLUDE MEMBER=WDK7                                                  
//WDA9     INCLUDE MEMBER=WDA9                                                  
//WDR4     INCLUDE MEMBER=WDR4                                                  
//WDR2     INCLUDE MEMBER=WDR2                                                  
//*                                                                             
//W37172D1 DD  DSN=&INDUT..W37172(+1),DISP=(NEW,CATLG,DELETE),  -LIM(5)         
//************ SUMMERAD LARMFIL                                                 
//             SPACE=(16,(10,1),RLSE),AVGREC=K,                                 
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
