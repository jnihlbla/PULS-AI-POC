//W612P078 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN2=&W011,                                                    
//             INDIN3=&W011..W011S1,                                            
//             INDUT=&W612..W612V4                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT01   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W612PD79),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN2..LDC.W01184(+0),DISP=SHR                             
//************ LDC EXTRACT FROM WDK7                                            
//*                                                                             
//SORTOUT  DD  DSN=&&W01184L,DISP=(NEW,PASS,DELETE),                            
//************ FILTERED FOR CHINA LDC'S                                         
//         DATACLAS=PSEN                                                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W612PD78),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN2..NDC.W01184(+0),DISP=SHR                             
//************ UTDRAG UR WDK7                                                   
//         DD  DSN=&&W01184L,DISP=(OLD,DELETE,DELETE)                           
//************ EXTRACT OF CHINA LDC'S FROM WDK7                                 
//*                                                                             
//SORTOUT  DD  DSN=&&W01184,DISP=(NEW,PASS,DELETE),                             
//************ SORTERAD / ARTIKELNUMMER                                         
