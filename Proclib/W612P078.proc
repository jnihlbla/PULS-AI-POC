//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61278   EXEC PGM=V16459,PARM='W61278/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W61278D1 DD  DSN=&&W01184,DISP=(OLD,DELETE,DELETE)                            
//************ UTDRAG UR WDK7                                                   
//*                                                                             
//W61278D2 DD  DSN=&INDIN3..W01160(+0),DISP=SHR                                 
//************ UTDRAG UR WDK6                                                   
//*                                                                             
//W61278D3 DD  DSN=&INDUT..W61278(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ DELAR AV W01184 KOMPLETTERAD MED BUYER                           
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
