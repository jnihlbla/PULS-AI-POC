//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES INVENTORY AUDIT LIST AND EXCLUDED PARTS LIST                       
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W571B3                                         
//*                                                                             
//*  RESTART:      W57108      NORMAL                                           
//*                READS        WDB6 WDR2 WDK7                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W571P008 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W571..W571B3,                                             
//             INDUT=&W571..W571B3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W57108   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W57108,W57108,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDB6     INCLUDE MEMBER=WDB6                                                  
//WDR2     INCLUDE MEMBER=WDR2                                                  
//WDK7     INCLUDE MEMBER=WDK7                                                  
//WDD3     INCLUDE MEMBER=WDD3                                                  
//W57108D1 DD  DSN=&INDIN..W57105(+0),DISP=SHR                                  
//************ INVENTORY INFO FROM WDJ7 AND WDD8                                
//*                                                                             
//W57108D2 DD  DSN=&INDUT..W57108.AUDITA(+1),                    -LIM(3)        
//             DISP=(NEW,CATLG,DELETE),                                         
//************ INVENTORY AUDIT LIST                                             
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W57108D3 DD  DSN=&INDUT..W57108.AUDITB(+1),                    -LIM(3)        
//             DISP=(NEW,CATLG,DELETE),                                         
//************ INVENTORY AUDIT LIST                                             
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W57108D4 DD  DSN=&INDUT..W57108.AUDITC(+1),                    -LIM(3)        
//             DISP=(NEW,CATLG,DELETE),                                         
//************ INVENTORY AUDIT LIST                                             
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W57108D5 DD  DSN=&INDUT..W57108.AUDITD(+1),                    -LIM(3)        
//             DISP=(NEW,CATLG,DELETE),                                         
//************ INVENTORY AUDIT LIST                                             
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W57108D6 DD  DSN=&INDUT..W57108.AUDITE(+1),                    -LIM(3)        
//             DISP=(NEW,CATLG,DELETE),                                         
//************ INVENTORY AUDIT LIST                                             
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W57108D7 DD  DSN=&INDUT..W57108.EXCLSTA(+1),                 -LIM(3)          
//************ INVENTORY AUDIT LIST - EXCLUDED PARTS                            
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W57108D8 DD  DSN=&INDUT..W57108.EXCLSTB(+1),                 -LIM(3)          
//************ INVENTORY AUDIT LIST - EXCLUDED PARTS                            
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W57108D9 DD  DSN=&INDUT..W57108.EXCLSTC(+1),                 -LIM(3)          
//************ INVENTORY AUDIT LIST - EXCLUDED PARTS                            
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W57108DA  DD  DSN=&INDUT..W57108.EXCLSTD(+1),                -LIM(3)          
//************ INVENTORY AUDIT LIST - EXCLUDED PARTS                            
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W57108DB  DD  DSN=&INDUT..W57108.EXCLSTE(+1),                -LIM(3)          
//************ INVENTORY AUDIT LIST - EXCLUDED PARTS                            
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
