//*                                                                             
//*  SKAPAR EN RAPPORTFIL TILL NEVIS MED NYA, ÄNDRADE ELLER                     
//*  BORTTAGNA BENÄMNINGAR                                                      
//*                                                                             
//*  FREKVENS:     DAG     RTN W159D2                                           
//*                                                                             
//*  ÅTERSTART:    W15903      NORMAL                                           
//*                LÄSER        WDD3                                            
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W159P003 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN2=&W121..W159D2,                                            
//             INREG=W159,                                                      
//             INDUT=&WUT..W159D2,                                              
//             INDUT2=&W159..W159D2                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W15903   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W15903,W15903,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDD3     INCLUDE MEMBER=WDD3                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//W15903D1 DD  DSN=&INDIN2..W12114,DISP=SHR                                     
//************ ALLA BORTTAGNA BENÄMNINGAR FRÅN W121B1                           
//*                                                                             
//W15903D2 DD  DSN=&INDUT..W15904(+1),DISP=(NEW,CATLG,DELETE),  -LIM(9)         
//************ RAPPORTFIL TILL NEVIS                                            
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W15903D3 DD  DSN=&INREG..W159XCP(+0),DISP=SHR                                 
//************ ALLA UNDANTAGSTEXTER, SOM SKALL VARA I VERSAL FORM               
//**           --> FILEN ANVÄNDS OCKSÅ I W157B2 - W157P024                      
//**           -->                       W154BH - W154P074                      
//************ DENNA FIL UPPDATERAS MANUELLT VID FÖRÄNDRINGAR.                  
//************ KOPIERA TILL NY GENERATION OCH ÄNDRA I DEN.                      
//************ N.B. PROGRAMMET HAR TABELL FÖR OCCURS 200                        
//*                                                                             
//W15903D4 DD  DSN=&INDUT2..W15903(+1),DISP=(NEW,CATLG,DELETE), -LIM(9)         
//************ UPPDATERINGSFIL TILL JOB W159J004                                
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
