//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W515PD03),DISP=SHR                         
//SORTIN   DD  DSN=&&W51571B,DISP=(OLD,DELETE,DELETE)                           
//************ OUTFILE W51571B                                                  
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W51571B(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//************ OUTFILE W51571B                                                  
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
