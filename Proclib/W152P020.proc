//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR FILER MED ÖVERSÄTTNINGSBESTÄLLNING FRÅN 'SV' TILL 'EN'              
//*  ELLER FRÅN 'EN' TILL 16 ANDRA SPRÅK                                        
//*                                                                             
//*  FREKVENS:     DAG     RTN W152V2                                           
//*                                                                             
//*  ÅTERSTART:    W15220    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W152P020 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=3,                                                           
//             INDUT=&W152..W152V2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W15220   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W15220,W15220,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//SYSPRINT DD  SYSOUT=*                                                         
//*                                                                             
//SYSOUT   DD  DSN=&INDUT..W15221(+1),DISP=(NEW,CATLG,CATLG),  -LIM(10)         
//*********    RAPPORT-MEDDELANDEN VIA DISPLAY              -- DISPLAY          
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920),                           
//             SPACE=(80,(2,5),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&BACKUPC                                                
//*---------------------------------------------------                          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*----------------------------------------------------                         
//W15220D1 DD  DSN=&INDUT..W1522K(+1),                         -LIM(10)         
//             DISP=(NEW,CATLG,DELETE),     KOMMANDOFIL                         
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
//*-------------------------------------------------------                      
//*                                                                             
//W152TOSV DD  DSN=&INDUT..W152TOSV(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),     ENGELSKA TILL SVENSKA               
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOEN DD  DSN=&INDUT..W152TOEN(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),     SVENSKA TILL ENGELSKA               
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOUS DD  DSN=&INDUT..W152TOUS(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL AMERKANSKA             
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TODE DD  DSN=&INDUT..W152TODE(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL TYSKA                  
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOFR DD  DSN=&INDUT..W152TOFR(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL FRANSKA                
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOES DD  DSN=&INDUT..W152TOES(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL SPANSKA                
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOPT DD  DSN=&INDUT..W152TOPT(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL PORTUGIS               
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TONL DD  DSN=&INDUT..W152TONL(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL NEDERLÄNDSKA           
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOIT DD  DSN=&INDUT..W152TOIT(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL ITALIENSKA             
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOFI DD  DSN=&INDUT..W152TOFI(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL FINSKA                 
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOJA DD  DSN=&INDUT..W152TOJA(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL JAPANSKA               
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOKO DD  DSN=&INDUT..W152TOKO(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL KOREANSKA              
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOZH DD  DSN=&INDUT..W152TOZH(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),          TILL TRAD.KINESISKA            
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOCN DD  DSN=&INDUT..W152TOCN(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),          TILL SIMP.KINESISKA            
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TORU DD  DSN=&INDUT..W152TORU(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL RYSKA                  
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOTH DD  DSN=&INDUT..W152TOTH(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL THAI                   
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOTR DD  DSN=&INDUT..W152TOTR(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL TÜRKISKA               
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W152TOPL DD  DSN=&INDUT..W152TOPL(+1),                       -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),             TILL POLISH                 
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//DELFIL  EXEC PGM=IEFBR14      * TAR BORT DEN GAMLA KOMMANDOFILEN              
//OLDFIL  DD DSN=&INDUT..W15220K,DISP=(OLD,DELETE,DELETE)                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//CMDCOPY  EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDUT..W1522K(+1),DISP=SHR                                  
//************* KOPIERAR DEN NYA KOMMANDOFILEN                                  
//*                                                                             
//SYSUT2   DD  DSN=&INDUT..W15220K,DISP=(NEW,CATLG,DELETE),                     
//             SPACE=(80,(22,10),RLSE),AVGREC=U,MGMTCLAS=NOBACKUP               
//************* FIXAR EN KOMMANDOFIL UTAN GEN FÖR FTP TRANSFER                  
