//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES FILES FOR VOR FOLLOW UP                                            
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W440V4                                         
//*                                                                             
//*  RESTART:      W4405D      NORMAL                                           
//*                READS        WDA6  (SB)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W440P05D PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W440..W440V4                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W4405D   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W4405D,W4405D,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                    -- ABEND         
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDA6     INCLUDE MEMBER=WDA6                                                  
//W4405DD1 DD  DSN=&INDUT..W4405D(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ OUT WITHIN 24 HOURS                                              
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//W4405DD2 DD  DSN=&INDUT..W4405E(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ OUT WITHIN A WEEK OR MORE                                        
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//W4405DD3 DD  DSN=&INDUT..W4405F(+1),DISP=(NEW,CATLG,DELETE), -LIM(52)         
//************ UNSOLVED VOR'S                                                   
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//W4405DD4 DD  DSN=&INDUT..W4405V(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ OUT WITHIN 24 HOURS OR WITHIN A WEEK OR MORE OBKR > 0            
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
