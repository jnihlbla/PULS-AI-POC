//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT86   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W479P862),DISP=SHR                         
//SORTIN   DD  DSN=&&W47986,DISP=(OLD,DELETE,DELETE)                            
//************ EFR-INFO MED STANDARDPRIS + SJÄLVKOST                            
//************ SORTERAS PÅ IDDISTR, IDKUNDNR, IDKUNDRF, IDDC, IDPRODNR          
