//             INDIN2=&W479..W479D1,                                            
//             INDUT=&W479..W479D1                                              
//*                                                                             
//SORT89   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W479P861),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN2..W47989(+0),DISP=SHR                                 
//************ EFR-INFO                                                         
//************ SORTERAS PÅ IDARTNR                                              
//*                                                                             
//SORTOUT  DD  DSN=&&W47989,DISP=(NEW,PASS,DELETE),                             
//************ EFR-POSTER SORTERADE                                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
