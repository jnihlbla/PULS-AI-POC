//*                                                                             
//*  SB-LÄSER WDK9 OCH SUMMERAR UPPGIFTER OM OKS. SKRIVER                       
//*  OKS/ARTIKELNUMMER PÅ UTFIL, SORTERING I ARTNR-ORDNING                      
//*                                                                             
//*  FREKVENS:     PLANERINGSPERIOD    RTN W231P1                               
//*                                                                             
//*  ÅTERSTART:    W23124                                                       
//*                LÄSER  WDK9                                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W231P024 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W231..W231P1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W23124   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W23124,W23124,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDK9     INCLUDE MEMBER=WDK9                                                  
//W23124D1 DD  DSN=&&W23125,DISP=(NEW,PASS,DELETE),                             
//************ POSTER MED OKS SUMMERAD PER ARTIKEL                              
//             SPACE=(23465,(27,18),RLSE)                                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W231PD24),DISP=SHR                         
//SORTIN   DD  DSN=&&W23125,DISP=(OLD,DELETE,DELETE)                            
//************ POSTER MED OKS SUMMERAD PER ARTIKEL                              
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W23125(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ POSTER MED SUMMERAD OKS SORTERADE PER ARTIKELNUMMER              
//             MGMTCLAS=&DEL2BKPC,SPACE=(23465,(27,18),RLSE)                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
