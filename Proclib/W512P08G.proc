//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATE FILE WITH UNIQUE PARTS FROM W01185                                  
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W512M2                                       
//*                                                                             
//*  RESTART:      W5128G    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W512P08G PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W011..&RTEGRP.,                                           
//             INDIN1=&W512..W512M2,                                            
//             INDIN2=&W011..NDC,                                               
//             INDUT=&W512..W512M2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W5128G   EXEC PGM=V16459,PARM='W5128G/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR                             
//DATUT    DD  SYSOUT=*                                                         
//W5128GD1 DD  DSN=&INDIN1..W51282(+0),DISP=SHR                                 
//************ EXTRACTION FROM W01184 WITH KDTRADP FROM WDB6                    
//*                                                                             
//W5128GD2 DD  DSN=&INDIN2..W01185(+0),DISP=SHR                                 
//************ WDK724 EXTRACT FILE                                              
//*                                                                             
//W5128GD3 DD  DSN=&INDIN..W01160(+0),DISP=SHR                                  
//************ WDK6   EXTRACT FILE                                              
//*                                                                             
//TPFIL1   DD  DSN=&&TPFIL1,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL2   DD  DSN=&&TPFIL2,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL3   DD  DSN=&&TPFIL3,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL4   DD  DSN=&&TPFIL4,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL5   DD  DSN=&&TPFIL5,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//W5128GD4 DD  DSN=&INDUT..W5128G(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//************ FILE WITH UNIQUE PARTS FROM W01185 DET - TOTAL FILE              
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W5128GD5 DD  DSN=&INDUT..W5128GA(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ FILE WITH UNIQUE PARTS FROM W01185 DET - DETAILED FILE           
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W5128GD6 DD  DSN=&INDUT..W5128GB(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ FILE WITH UNIQUE PARTS FROM W01185 EST - TOTAL FILE              
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W5128GD7 DD  DSN=&INDUT..W5128GC(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ FILE WITH UNIQUE PARTS FROM W01185 EST - DETAILED FILE           
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
