//*  HÄMTAR FAKTUROR TILL ARTIKELSTATISTIK                                      
//*                                                                             
//*  FREKVENS:     VECKA    RTN W330V1                                          
//*                                                                             
//*  ÅTERSTART:    W33002   NORMAL                                              
//*                .                                                            
//*                DFUP   NORMAL                                                
//*                .                                                            
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W330P002 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN3=&W371..W330V1,                                            
//             INDIN4=&W476..W330V1,                                            
//             INDUT=&W330..W330V1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33002   EXEC PGM=W33002                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W33002D1 DD  DSN=&INDIN4..W47654,DISP=SHR                                     
//************ FAKTUROR FRÅN DISTRIBUTION                                       
//*                                                                             
//W33002D2 DD  DSN=&INDIN3..W3710G,DISP=SHR                                     
//************ FAKTUROR FRÅN BYTES                                              
//*                                                                             
//W33002D4 DD  DSN=&INDUT..W33003(+1),DISP=(NEW,CATLG,DELETE),  -LIM(5)         
//************ FAKTURORNA MED KONVERTERAT DATUM                                 
//             MGMTCLAS=DEL2,SPACE=(23461,(1000,666),RLSE)                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
