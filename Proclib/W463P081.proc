//*  TAR IN EN FIL (FÖRSENADE GNB LEVERANSER) OCH PRINTAR LISTA                 
//*                                                                             
//*  FREKVENS:     VECKO    RTN W463D1                                          
//*                                                                             
//*  ÅTERSTART:              NORMAL                                             
//*                W46381    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W463P081 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W463..W463D1,                                             
//             DEST=&QUS05891                                                   
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W46381   EXEC PGM=V16459,PARM='W46381/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(0),DISP=SHR                                   
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//A4LF  OUTPUT FORMDEF=SLSR6C,PAGEDEF=SLSR6C                                    
//************ A4 LANDSCAPE, SINGLE SIDE, RASTER  (FOLDED PAPER)                
//W46381D1 DD  DSN=&INDIN..W46380(+0),DISP=SHR                                  
//*                                                                             
//W46381D2 DD  SYSOUT=(A,,STD),DEST=&DEST,OUTPUT=(*.A4LF)                       
//*                                                                             
