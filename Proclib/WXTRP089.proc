//*                                                                             
//*  RÄKNAR UT REOSAEK FÖR EXTRAKTFILER SDC/NDC/LDC                             
//*                                                                             
//*  FREKVENS:     DAG     RTN WXTRD2                                           
//*                                                                             
//*  ÅTERSTART:    WXTR89      NORMAL                                           
//*                LÄSER       WDK7 WDL7                                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTRP089 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDLDC=&W011..LDC,                                               
//             INDSDC=&W011..SDC,                                               
//             INDNDC=&W011..NDC,                                               
//             INDUT=&WXTR..WXTRD2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT84   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTARDC),DISP=SHR                         
//SORTIN   DD  DSN=&INDLDC..W01184(+0),DISP=SHR                                 
//         DD  DSN=&INDSDC..W01184(+0),DISP=SHR                                 
//         DD  DSN=&INDNDC..W01184(+0),DISP=SHR                                 
//*                                                                             
//SORTOUT  DD  DSN=&&W01184,DISP=(NEW,PASS,DELETE),                             
//************ W01184 SORTED ON PARTNUMBER/IDDC                                 
//             DATACLAS=PSEB                                                    
//**********************************************************************        
//WXTR89   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,WXTR89,WXTR89,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDK7     INCLUDE MEMBER=WDK7                                                  
//WDL7     INCLUDE MEMBER=WDL7                                                  
//WDL4     INCLUDE MEMBER=WDL4                                                  
//WDB6     INCLUDE MEMBER=WDB6                                                  
//WXTR89D1 DD  DSN=&&W01184,DISP=(OLD,DELETE,DELETE)                            
//************ ARTIKELFIL                                                       
//*                                                                             
//WXTR89D2 DD  DSN=&INDUT..WXTR89(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ REOSAEK                                                          
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
