//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR FILER FÖR TVÅ ST SKAMLISTOR, ARTIKLAR MED                           
//*  AK I SDC OCH ARTIKLAR MED AK-PAV MER ÄN EN VECKA.                          
//*                                                                             
//*  FREKVENS:     DAG    RTN W612D1                                            
//*                                                                             
//*  ÅTERSTART:    W61202      NORMAL                                           
//*                LÄSER  WDL6 WDD3 WDR5                                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W612P002 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W612..W612D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61202   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W61202,W61202,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDL6     INCLUDE MEMBER=WDL6                                                  
//WDD3     INCLUDE MEMBER=WDD3                                                  
//WDR5     INCLUDE MEMBER=WDR5                                                  
//W61202D1 DD  DSN=&INDUT..W61202(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ ARTIKLAR MED AK I SDC                                            
//             SPACE=(47,(1,1),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&DEL2BKPC                                               
//W61202D2 DD  DSN=&INDUT..W61204(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ ARTIKLAR MED AK PÅ VÄG MER ÄN EN VECKA                           
//             SPACE=(73,(1,1),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&BACKUPC                                                
