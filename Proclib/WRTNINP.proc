//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//LISTCMD EXEC PGM=ICEGENER                                                     
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&&RENCMDS,DISP=(OLD,PASS)                                    
//SYSUT2   DD  SYSOUT=*                                                         
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//RENAME  EXEC W001PTSO                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WRTNINPZ)                                  
//ZINPUT   DD  DSN=&&RENCMDS,DISP=(OLD,DELETE)                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//IFENQ  IF (RC > 4094) THEN                                                    
//ENQUE   EXEC PGM=IEFBR14                                                      
//F1       DD  DSN=&F1,DISP=OLD                                                 
//T1       DD  DSN=&T1,DISP=OLD                                                 
//F2       DD  DSN=&F2,DISP=OLD                                                 
//T2       DD  DSN=&T2,DISP=OLD                                                 
//F3       DD  DSN=&F3,DISP=OLD                                                 
//T3       DD  DSN=&T3,DISP=OLD                                                 
//F4       DD  DSN=&F4,DISP=OLD                                                 
//T4       DD  DSN=&T4,DISP=OLD                                                 
//F5       DD  DSN=&F5,DISP=OLD                                                 
//T5       DD  DSN=&T5,DISP=OLD                                                 
//F6       DD  DSN=&F6,DISP=OLD                                                 
//T6       DD  DSN=&T6,DISP=OLD                                                 
//F7       DD  DSN=&F7,DISP=OLD                                                 
//T7       DD  DSN=&T7,DISP=OLD                                                 
//F8       DD  DSN=&F8,DISP=OLD                                                 
//T8       DD  DSN=&T8,DISP=OLD                                                 
//F9       DD  DSN=&F9,DISP=OLD                                                 
//T9       DD  DSN=&T9,DISP=OLD                                                 
//ENDENQ ENDIF                                                                  
