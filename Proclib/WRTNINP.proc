//CMD7    EXEC PGM=V12340,                                                      
//             PARM=(' &F7 &T7 RECFM(&RF7) LRECL(&LR7) &X7 CPY(&CP7)')          
//V12340D1 DD  DUMMY                                                            
//V12340D2 DD  DSN=&&RENCMDS,DISP=(MOD,PASS,DELETE),                            
