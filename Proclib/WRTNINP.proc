//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  RENAME INPUT FILES TO A ROUTINE IN A WAY THAT MINIMIZES                    
//*  CONFLICTS BETWEEN JOBS AND BACKUP TASKS.                                   
//*                                                                             
//*  MAX 9 GROUPS OF FILES CAN BE RENAMED.                                      
//*  IF MORE ARE REQUIRED, USE THIS PROCEDURE AS MANY TIMES AS NEEDED.          
//*                                                                             
//*  STEPS "CMD1"-"CMD9" GENERATES RENAME COMMANDS,                             
//*  STEP  "LISTCMD" DISPLAYS THE GENERATED COMMANDS,                           
//*  STEP  "RENAME" DOES THE RENAMING,                                          
//*  STEP  "ENQUE" ENSURES THAT THE FILES ARE RESERVED BY THIS JOB              
//*  UNTIL AFTER THE RENAME.                                                    
//*                                                                             
//* PARAMETERS: Fn =  FROM-FILE                                                 
//*             Tn =  TO-FILE                                                   
//*             RFn = RECFM FOR EMPTY FILE                                      
//*             LRn = LRECL FOR EMPTY FILE (2-4095)                             
//*             CPn = MBR OF GENERATIONS FOR COPY FILE (TO-FILE+C)              
//*             Xn =  EXTRA ALLOC PARAMETERS IN TSO-STYLE SYNTAX                
//*                   USE TOGETHER WITH LRn=1. LRn IS THEN IGNORED.             
//*                   EXTRA PARAMETERS MAY BE USED IF LRECL > 4095              
//*                   OR ADDITIONAL PARAMETERS ARE DESIRED.                     
//*                   EXAMPLE: LR1=1,X1='LRECL(8000)' WILL TAKE 8000            
//*                   INSTEAD OF 1 AS LRECL (LR1=1 IS IGNORED)                  
//*                                                                             
//*  FREQUENCE:    DAILY     IN ROUTINE START JOBS                              
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WRTNINP PROC F1=,T1=,RF1=,LR1=0,CP1=,X1=,                                     
//             F2=,T2=,RF2=,LR2=0,CP2=,X2=,                                     
//             F3=,T3=,RF3=,LR3=0,CP3=,X3=,                                     
//             F4=,T4=,RF4=,LR4=0,CP4=,X4=,                                     
//             F5=,T5=,RF5=,LR5=0,CP5=,X5=,                                     
//             F6=,T6=,RF6=,LR6=0,CP6=,X6=,                                     
//             F7=,T7=,RF7=,LR7=0,CP7=,X7=,                                     
//             F8=,T8=,RF8=,LR8=0,CP8=,X8=,                                     
//             F9=,T9=,RF9=,LR9=0,CP9=,X9=                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//IF1    IF (RC < &LR1) THEN                                                    
//CMD1    EXEC PGM=V12340,                                                      
//             PARM=(' &F1 &T1 RECFM(&RF1) LRECL(&LR1) &X1 CPY(&CP1)')          
//V12340D1 DD  DUMMY                                                            
//V12340D2 DD  DSN=&&RENCMDS,DISP=(MOD,PASS,DELETE),                            
//             UNIT=VIO,                                                        
//             SPACE=(TRK,1)                                                    
//END1   ENDIF                                                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//IF2    IF (RC < &LR2) THEN                                                    
//CMD2    EXEC PGM=V12340,                                                      
//             PARM=(' &F2 &T2 RECFM(&RF2) LRECL(&LR2) &X2 CPY(&CP2)')          
//V12340D1 DD  DUMMY                                                            
//V12340D2 DD  DSN=&&RENCMDS,DISP=(MOD,PASS,DELETE),                            
//             UNIT=VIO,                                                        
//             SPACE=(TRK,1)                                                    
//END2   ENDIF                                                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//IF3    IF (RC < &LR3) THEN                                                    
//CMD3    EXEC PGM=V12340,                                                      
//             PARM=(' &F3 &T3 RECFM(&RF3) LRECL(&LR3) &X3 CPY(&CP3)')          
//V12340D1 DD  DUMMY                                                            
//V12340D2 DD  DSN=&&RENCMDS,DISP=(MOD,PASS,DELETE),                            
//             UNIT=VIO,                                                        
//             SPACE=(TRK,1)                                                    
//END3   ENDIF                                                                  
//*                                                                             
