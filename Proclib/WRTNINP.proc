//             SPACE=(TRK,1)                                                    
//END7   ENDIF                                                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//IF8    IF (RC < &LR8) THEN                                                    
//CMD8    EXEC PGM=V12340,                                                      
//             PARM=(' &F8 &T8 RECFM(&RF8) LRECL(&LR8) &X8 CPY(&CP8)')          
//V12340D1 DD  DUMMY                                                            
//V12340D2 DD  DSN=&&RENCMDS,DISP=(MOD,PASS,DELETE),                            
//             UNIT=VIO,                                                        
//             SPACE=(TRK,1)                                                    
//END8   ENDIF                                                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//IF9    IF (RC < &LR9) THEN                                                    
//CMD9    EXEC PGM=V12340,                                                      
//             PARM=(' &F9 &T9 RECFM(&RF9) LRECL(&LR9) &X9 CPY(&CP9)')          
//V12340D1 DD  DUMMY                                                            
//V12340D2 DD  DSN=&&RENCMDS,DISP=(MOD,PASS,DELETE),                            
