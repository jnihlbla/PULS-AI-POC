//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  PRINT REPORT FROM ACF2 WARNING LOG                                         
//*                                                                             
//*  FREQUENCE:    WEEKLY    RTN W970V2                                         
//*                                                                             
//*  RESTART:      W97042    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W970P042 PROC STPLIB=&INDRTE..LOAD,YYWW=9901,                                 
//             INDIN=&W970..W970V2,                                             
//             INDUT=&W970..W970V2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W97042   EXEC PGM=V16459,PARM='W97042/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W97042D1 DD  DSN=&INDIN..W97041A.YYWW&YYWW,DISP=SHR                           
//************ ACF2 LOG DATA                                                    
//*                                                                             
//W97042D2 DD  DSN=&INDUT..W97042.YYWW&YYWW,                                    
//             DISP=(NEW,CATLG,DELETE),                                         
//************ W97042-001  LOG REPORT                                           
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
