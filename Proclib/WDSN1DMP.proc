//WDSN1DMP PROC PARMS=,                                                         
//             DSIN=NULLFILE,                                                   
//             DSOUT=NULLFILE,UNIT=PP,SPACE=1,                                  
//             LABEL=                                                           
//*                                                                             
//DSN1    EXEC PGM=DSN1COPY,PARM='&PARMS'                                       
