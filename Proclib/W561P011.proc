//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LÄSER IN FILER FRÅN SAP R/3                                                
//*  POSTERNA FÖRDELAS PÅ TVÅ FILER, EN TILL RSREDO OCH EN TILL BILL-IT         
//*                                                                             
//*  FREKVENS:     DAGLIGEN  RTN W515D1                                         
//*                                                                             
//*  RESTART:      W56111    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W561P011 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W561..W561D1,                                             
//             INDUT=&W561..W561D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56111   EXEC PGM=W56111                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W56111D1 DD  DSN=&INDIN..W56110(+0),DISP=SHR                                  
//************ NFIL MED INFO IFRÅN SAP                                          
//*                                                                             
//W56111D2 DD  DSN=&INDUT..W56113(+1),DISP=(NEW,CATLG,DELETE), -LIM(5)          
//************ UTFIL MED SAP INFO KTO/KST/ANALYSNR/KUNDREG TILL BILLIT          
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W56111D3 DD  DSN=&INDUT..W56111(+1),DISP=(NEW,CATLG,DELETE), -LIM(5)          
//************ TFIL MED RÄTTNINGSINFO FRÅN SAP TILL RSREDO                      
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
