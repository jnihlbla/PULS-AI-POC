//W271P02D PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W271..W271D4                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W271SR  EXEC PGM=SORT                                                         
//SORTIN   DD  DSN=&INDIN..W2712D(+0),DISP=SHR                                  
//***********      SKROTUNDERLAG FÖR GODKÄNNANDE                                
//         DD  DSN=&INDIN..W27116(+0),DISP=SHR                                  
//***********      SKROTUNDERLAG AUTOMAT AREA 98                                
//*                                                                             
//SORTOUT  DD  DSN=&&W2712D,DISP=(NEW,PASS,DELETE),                             
//***********      SORTAD FIL (IDDC,DISTR,KUND,IDARTNR)                         
//             DATACLAS=PSEN                                                    
//*                                                                             
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W271PD2D),DISP=SHR                         
//SORTMSG  DD  SYSOUT=*                                                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W2712D   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W2712D,W2712D,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W2712DD1 DD  DSN=&&W2712D,DISP=(OLD,DELETE,DELETE)                            
