//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  TO CREATE WXTR FILES FOR W02009, W02031                                    
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W020D1                                         
//*                                                                             
//*  RESTART:      W02009    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W020P009 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W020..W020D1                                              
//*            INDUT=&W020..W020D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W02009   EXEC PGM=W02009                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//W02009D1 DD  DSN=&INDIN..W02009(+0),DISP=SHR                                  
//************ FILE FROM PREVIOUS JOB                                           
//W02009D2 DD  DSN=&INDIN..W02031(+0),DISP=SHR                                  
//************ FILE FROM PREVIOUS JOB                                           
//*                                                                             
//W02009D3 DD  DSN=&&W02009X,DISP=(NEW,PASS,DELETE),                            
//************ SRSINFO KOMPLETTERAD MED CLEARINGORSAK, WXTR                     
//             DATACLAS=PSEN                                                    
//*                                                                             
//W02009D4 DD  DSN=&&W02031X,DISP=(NEW,PASS,DELETE),                            
//************ SRSINFO KOMPLETTERAD MED CLEARINGORSAK, WXTR                     
//             DATACLAS=PSEN                                                    
//*                                                                             
