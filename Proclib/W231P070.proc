//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W231PD70),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN2..W01186(+0),DISP=SHR                                 
