//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES FILE WITH GIT INFORMATION FOR SEPV                                 
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W512M2                                       
//*                                                                             
//*  RESTART:      W51266      NORMAL                                           
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W512P066 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W512..W512M2,                                             
//             INDUT=&W512..W512M2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//**********************************************************************        
//SORT61   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W512PD61),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51261(+0),DISP=SHR                                  
//************ EXTRACT OF W01160 AND W01184                                     
//*                                                                             
//SORTOUT  DD  DSN=&&W51261,DISP=(NEW,PASS,DELETE),                             
//************ W51262 SORTED IN ASCENDING ORDER                                 
//             DATACLAS=PSEB                                                    
//*                                                                             
//**********************************************************************        
//SORT62   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W512PD61),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51262(+0),DISP=SHR                                  
//************ EXTRACT FOR WDL6, R30 TRANSACTION                                
//*                                                                             
//SORTOUT  DD  DSN=&&W51262,DISP=(NEW,PASS,DELETE),                             
//************ W51262 SORTED IN ASCENDING ORDER                                 
//             DATACLAS=PSEB                                                    
//*                                                                             
//**********************************************************************        
//W51266   EXEC PGM=W51266                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W51266D1 DD  DSN=&&W51261,DISP=(OLD,DELETE,DELETE)                            
//************ FILE WITH IDFTG= 57                                              
//*                                                                             
//W51266D2 DD  DSN=&&W51262,DISP=(OLD,DELETE,DELETE)                            
//************ R30 FROM WDL6                                                    
//*                                                                             
//W51266D3 DD  DSN=&INDUT..W51266(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ INTERNAL GIT FILE                                                
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
