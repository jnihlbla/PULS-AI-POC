//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*                                                                             
//*  SKAPAR HIST-FIL OCH FIL FÖR RENSNING AV WDM6                               
//*                                                                             
//*  FREKVENS:     VECKA    RTN W371V1                                          
//*                                                                             
//*  ÅTERSTART:    W37136      NORMAL                                           
//*                LÄSER  WDM6                                                  
//*                        WDK6                                                 
//*                         WDD3                                                
//*                          WDR2                                               
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W371P036 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W371..W371V1,                                             
//             INDUT=&W371..W371V1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W37136   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W37136,W37136,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDM6     INCLUDE MEMBER=WDM6                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDD3     INCLUDE MEMBER=WDD3                                                  
//WDR2     INCLUDE MEMBER=WDR2                                                  
//W37136D1 DD  DSN=&INDUT..W37137(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ FIL FÖR RENSNING AV WDM6                                         
//             MGMTCLAS=&DEL2BKPC,SPACE=(7,(1,3),RLSE),AVGREC=K                 
//*                                                                             
//W37136D2 DD  DSN=&INDUT..W37138(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ HIST-FIL MED GODKÄNDA RAPPORTER                                  
//             MGMTCLAS=&DEL2BKPC,                                              
//             SPACE=(132,(13,35),RLSE),AVGREC=K                                
//*                                                                             
//W37136D3 DD  DSN=&INDUT..W37153(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ HIST-FIL MED GODKÄNDA RAPPORTER NDC                              
//             MGMTCLAS=&BACKUPC,SPACE=(132,(13,35),RLSE),AVGREC=K              
//*                                                                             
//W37136D4 DD  DSN=&INDUT..W37154(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UPPDATERING AV BYTBEK                                            
//             MGMTCLAS=&BACKUPC,SPACE=(8,(13,35),RLSE),AVGREC=K                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//COPY     EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDIN..W37153(+1),DISP=SHR                                  
//************ IN-REG                                                           
//*                                                                             
//SYSUT2   DD  DSN=&INDUT..W371NA(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ KOPIA AV NDC-HISTORIKEN                                          
//             SPACE=(132,(13,35),RLSE),AVGREC=K,                               
//             MGMTCLAS=&NOBACKUP                                               
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
