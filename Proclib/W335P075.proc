//             INDUT=&W335..W335R1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W335PD70),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W33570(+0),DISP=SHR                                  
//************ SORTERA INFILEN W33570                                           
//*                                                                             
//SORTOUT  DD  DSN=&&W33570OS,DISP=(NEW,PASS,DELETE),                           
//************ SORTERAD FIL W33570                                              
//         SPACE=(10,(2000,666),RLSE),AVGREC=U                                  
//*                                                                             
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W335PD74),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W33574(+0),DISP=SHR                                  
//************ SORTERA INFILEN W33574                                           
//*                                                                             
//SORTOUT  DD  DSN=&&W33574OS,DISP=(NEW,PASS,DELETE),                           
