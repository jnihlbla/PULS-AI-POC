//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                   *         
//*   SOP - CREATE SEQUENTIAL CALENDAR FILE                           *         
//*                                                                   *         
//*                                       MAINTAINED BY DEPT 36000    *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//WSOPCAL1 PROC SOPCHI=,SOPCLO=,SDATE=,EDATE=,                                  
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WGDGDEF  EXEC PGM=WGDGDEF,PARM=('&SOPCHI',&SOPCLO,2)                          
//STEPLIB DD DSN=&INDGRND..LOAD,DISP=SHR                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=*                                                         
//WGDGDED1 DD                                                                   
//WGDGDED2 DD                                                                   
//*                                                                             
//W98010  EXEC PGM=W98010,PARM='&SDATE&EDATE'                                   
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//*                                                                             
//W98010D1 DD  DSN=&SOPCHI..&SOPCLO.(+1),                       -LIM(3)         
//             DISP=(NEW,PASS,DELETE),                                          
//             DCB=(RECFM=FB,LRECL=250,BLKSIZE=6000),                           
//             SPACE=(6000,(10,5),RLSE),MGMTCLAS=&BACKUP7                       
//*                                                                             
//SYSOUT   DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=*                                                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//CATLG   EXEC PGM=IEFBR14                                                      
//CB2XXX01 DD DSN=&SOPCHI..&SOPCLO.(+1),DISP=(OLD,CATLG,DELETE)                 
