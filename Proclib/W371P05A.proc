//*                                                                             
//*  SKAPAR BYTESUPPFÖLJNING AV ARTIKELSTATISTIKEN                              
//*                                                                             
//*  FREKVENS:     VECKA     RTN W371V3                                         
//*                                                                             
//*  ÅTERSTART:    W3715A      NORMAL                                           
//*                LÄSER        WDR2                                            
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W371P05A PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN2=&W330..W330V1,                                            
//             INDIN3=&W011..&RTEGRP.,                                          
//             INDUT=&W371..W371V3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W3715A   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W3715A,W3715A,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR         -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDR2     INCLUDE MEMBER=WDR2                                                  
//W3715AD1 DD  DSN=&INDIN2..W33013(+0),DISP=SHR                                 
//************ ARTIKELSTATISTIKENS PRIMÄR REGISTER                              
//*                                                                             
//W3715AD2 DD  DSN=&INDIN3..W01160(+0),DISP=SHR                                 
//************ ARTIKELREGISTRET PÅ FIL                                          
//*                                                                             
//W3715AD3 DD  DSN=&INDIN3..W01174(+0),DISP=SHR                                 
//************ BENÄMNINGSREGISTRET PÅ FIL                                       
//*                                                                             
//W3715AD4 DD  DSN=&INDUT..W3715A(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ BYTESUPPFÖLJNINGSUDERLAG PÅ ARTIKELSTATISTIKEN                   
//             SPACE=(63,(20,60),RLSE),AVGREC=K,                                
//             MGMTCLAS=&BACKUPC                                                
