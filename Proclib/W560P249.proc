//*  LIST 'MONTLY SALES AND TRANSACTION REPORTS'                                
//*        PÅ FILER FÖR ÖVERSÄNDNING MED VCOM                                   
//*  LIST 'DAILY ERROR PARTS' PÅ FIL FÖR MEMO/API                               
//*                                                                             
//*  FREKVENS:     ACCOUNTING PERIOD                                            
//*                                                                             
//*  RESTART:      W56049    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W560P249 PROC INDIN=&W560..W560R1,                                            
//             INDIN1=&W011..&RTEGRP.,                                          
//             INDIN2=&W510..W560R1,                                            
//             INDUT=&W560..W560R1,                                             
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56049   EXEC PGM=V16459,PARM='W56049/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(8192,(10000,4000))                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//SORTMSG  DD  SYSOUT=*                                                         
//W56049D1 DD  DSN=&INDIN2..W51052(-1),DISP=SHR                                 
//************ NDC-SALDOREGISTER FRÅN FÖRRA KÖRNINGEN                           
//*                                                                             
//W56049D2 DD  DSN=&INDIN2..W51052(+0),DISP=SHR                                 
//************ NDC-SALDOREGISTER FRÅN DENNA KÖRNINGEN                           
//*                                                                             
//W56049D3 DD  DSN=&INDIN1..W01160(+0),DISP=SHR                                 
//************ FIL ME WDK6-EXTRAKT                                 ***          
//*                                                                             
//W56049D4 DD  DSN=&INDIN1..W01174(+0),DISP=SHR                                 
//************ FIL MED ARTIKELBENAMNINGAR                                       
//*                                                                             
//W56049D5 DD  DSN=&INDIN..W56019,DISP=SHR                                      
//************ FIL MED KÖROMGÅNGENS ALLA LAB-TRANSAR               ***          
//*                                                                             
//TPFILTO  DD  DSN=&&TEMPTO,DISP=(NEW,DELETE,DELETE),                           
//************ TEMPORÄR ARTIKELFIL, OLD SORTERAD                                
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFILTN  DD  DSN=&&TEMPTN,DISP=(NEW,DELETE,DELETE),                           
//************ TEMPORÄR ARTIKELFIL, NEW SORTERAD                                
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL1   DD  DSN=&&TEMP1,DISP=(NEW,DELETE,DELETE),                            
//************ TEMPORÄR ARTIKELSALDOFIL                                         
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL2   DD  DSN=&&TEMP2,DISP=(NEW,DELETE,DELETE),                            
//************ TEMPORÄR ARTIKELSALDOFIL + KDPSSLOC O REKSIFF                    
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL3   DD  DSN=&&TEMP3,DISP=(NEW,DELETE,DELETE),                            
//************ TEMPORÄR ARTIKELSALDOFIL + BEART-US                              
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL4   DD  DSN=&&TEMP4,DISP=(NEW,DELETE,DELETE),                            
//************ PERIODENS LABTRANSAR FORMERADE MED 3 BELOPP                      
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL5   DD  DSN=&&TEMP5,DISP=(NEW,DELETE,DELETE),                            
//************ PERIODENS LABTRANSAR SUMMERADE PER ARTIKEL OCH DC                
//             DATACLAS=PSEN                                                    
//*                                                                             
//W56049D6 DD  DSN=&&TEMP41,DISP=(NEW,PASS,DELETE),                             
//************** LISTA W56049-041 MONTLY SALES AND TRANSACTION REPORT           
//             DATACLAS=PSEN                                                    
//*                                                                             
