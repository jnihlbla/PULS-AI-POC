//W56049DD DD  DSN=&&TEMP45,DISP=(NEW,PASS,DELETE),                             
//************** LISTA W56049-045 MONTLY SALES AND TRANSACTION REPORT           
//             DATACLAS=PSEN                                                    
//W56049DE DD  DSN=&&TEMP46,DISP=(NEW,PASS,DELETE),                             
//************** LISTA W56049-046 MONTLY SALES AND TRANSACTION REPORT           
//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
