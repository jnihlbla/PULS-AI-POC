//*                                                                   *         
//*    KOPIERAR LISTOR PÅ FILER FÖR LAB FÖR ATT                       *         
//*    VCOM EJ KLARAR ATT HANTERA FILER MED FBA (SKALL VARA FB)       *         
//*                                                                   *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56041  EXEC PGM=ICEGENER                                                     
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&&TEMPDC,DISP=(OLD,DELETE,DELETE)                            
//****LISTA MONTLY SALES AND TRANSACTION DC 41,42,43,45,46,47,51*******         
//*                                                                             
//SYSUT2   DD  DSN=&INDUT..W56050(+1),                        -LIM(03)          
//             DISP=(NEW,CATLG,DELETE),                                         
//*********** LISTFIL  W56050-041 MONTLY SALES AND TRANSACTION REPORT           
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
