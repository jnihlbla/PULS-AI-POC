//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  PLOCKAR IN BETÄLLNINGSIDENTITET FRÅN SENDERTAG I MQ                        
//*  OCH SKICKAR VIDARE DETTA I BESTÄLLNING AV STATISTIK                        
//*                                                                             
//*  FREKVENS:     DAG     RTN W330E1                                           
//*                                                                             
//*  ÅTERSTART:    W33033    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W330P034 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W330..W330X1,                                             
//             INDUT=&W330..W330X1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//* MARKET=&MARKET                                                              
//*                                                                             
//SORT1 EXEC PGM=SORT                                                           
//SORTIN   DD  DUMMY                                                            
//SORTOUT DD DSN=&&TEMP1,                                                       
//             DISP=(NEW,PASS,DELETE),                                          
//             SPACE=(84,(100,10),RLSE),AVGREC=K,                               
//             DCB=(RECFM=VB,LRECL=84)                                          
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN DD *                                                                    
  OPTION COPY                                                                   
  OUTFILE FNAMES=SORTOUT,FTOV                                                   
/*                                                                              
//*****************************************************************             
//SORT2 EXEC PGM=SORT                                                           
//SORTIN  DD DSN=&&TEMP1,DISP=(OLD,DELETE,DELETE)                               
//        DD DSN=&INDIN..W33033(0),DISP=SHR                                     
//SORTOUT DD DSN=&INDUT..W33033(+1),                                            
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=BACKUPC,DATACLAS=PSEN                                   
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN DD *                                                                    
  SORT FIELDS=COPY                                                              
/*                                                                              
//*****************************************************************             
//W33033   EXEC PGM=W33033                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W33033D1 DD  DSN=&INDIN..W33033(+1),DISP=(OLD,KEEP,KEEP)                      
//************ BESTÄLLNINGSFIL MED SENDERTAG                                    
//*                                                                             
//W33033D2 DD  DSN=&INDUT..W33036(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ BESTÄLLNINGSFIL FRÅN IDENTIFIERAT MARKNADSBOLAG                  
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
