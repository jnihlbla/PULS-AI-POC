//*                                                                             
//W463P020 PROC INDIN=&W463..W463S7,                                            
//             INDUT=&WUT..W463S7,                                              
//             INDUT2=&W463..W463S7,                                            
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W46320S  EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SORTMSG  DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W463PD20),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W46312(+0),DISP=SHR                                  
//SORTOUT  DD  DSN=&&W46312,DISP=(NEW,PASS,DELETE),                             
//             SPACE=(347,(5,1),RLSE),AVGREC=K,                                 
//             MGMTCLAS=NOBACKUP                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W46320  EXEC PGM=W46320                                                       
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                                         
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//V16247D3 DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//************ PACKUNDERLAGSINFO - DIREKTLEV, SORTERAD              ***         
//W46320D1 DD  DSN=&&W46312,DISP=(OLD,DELETE,DELETE)                            
//**************  EDI-ORDER                                         ***         
//W46320D2 DD  DSN=&INDUT..W46340(+1),DISP=(NEW,CATLG,DELETE),                  
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//**************  EDI-LOGG                                          ***         
//W46320D3 DD  DSN=&INDUT2..W46341(+1),DISP=(NEW,CATLG,DELETE),                 
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
