//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  MATCHAR URVAL   (TPO 3) MED WDD2                                           
//*                                                                             
//*  FREKVENS:     DAG    RTN W225D1                                            
//*                                                                             
//*  ÅTERSTART:    W22534                                                       
//*                LÄSER  WDD2 WDK6 WDG2                                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W225P034 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W225..W225D1,                                             
//             INDUT=&W225..W225D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W22534   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W22534,W22534,,00')                                  
//STEPLIB  DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY,DCB=(RECFM=VB,BLKSIZE=1408,BUFNO=1)                        
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDD2     INCLUDE MEMBER=WDD2                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDG2     INCLUDE MEMBER=WDG2                                                  
//W22534D1 DD  DSN=&INDIN..W22531(+0),DISP=SHR                                  
//************ FIL MED URVAL (TPO 3)                                            
//*                                                                             
//W22534D2 DD  DSN=&INDUT..W22534(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ FIL MED MATCHADE URVAL                                           
//             MGMTCLAS=&DEL2BKPC,SPACE=(23400,(20,1),RLSE)                     
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
