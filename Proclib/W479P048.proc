//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SELECTS RECORDS FOR PREVIOUS MONTH FROM W47955C FILES                      
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W479M3                                       
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                W47948    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W479P048 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W479..W479M3,                                             
//             INDUT=&W479..W479M3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W479PD48),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W47955C,DISP=SHR                                     
//************ ALL GENS OF W47955C(FOR PREVIOUS MONTH DATA)                     
//*                                                                             
//SORTOUT  DD  DSN=&&W47955C,DISP=(NEW,PASS,DELETE),                            
//************ SORTED FILE                                                      
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47948   EXEC PGM=W47948                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//W47948D1 DD  DSN=&&W47955C,DISP=(OLD,DELETE,DELETE)                           
//************ ALL GENS OF W47955C SORTED(FOR PREVIOUS MONTH DATA)              
//*                                                                             
//W47948D2 DD  DSN=&INDUT..W47948(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ PREVIOUS MONTH DATA                                              
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
