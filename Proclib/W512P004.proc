//*  SKAPAR EXCEL FÖR LAGERVÄRDERINGEN PER DC OCH PRODUKTSLAG                   
//*                                                                             
//*  FREKVENS:   MÅNADSSLUT RTN W500M1 OCH ÅRSSLUT WYR001                       
//*                                                                             
//*  ÅTERSTART:    W51204    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W512P004 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W510..W500M1,                                            
//             INDIN2=&W510..W510D4,                                            
//             INDREG=&W011,                                                    
//             INDUT=&W512..W500M1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51204   EXEC PGM=V16459,PARM='W51204/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(CYL,(100,100))                                            
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR            -- DATKORT            
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR         -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//W51204D1 DD  DSN=&INDIN2..W51053(+0),DISP=SHR                                 
//************ ARTIKELSALDOFIL EJ DC 11                                         
//         DD  DSN=&INDIN2..W51054(+0),DISP=SHR                                 
//************ ARTIKELSALDOFIL DC 11                                            
//         DD  DSN=&INDIN1..W51058(+0),DISP=SHR                                 
//************ BACK-FIL BACKAR SALDO TILL MIDNATT                               
//*                                                                             
//W51204D2 DD  DSN=&INDREG..W01172(+0),DISP=SHR                                 
//************ ARTIKELUPPGIFTER FÖR DC 11                                       
//*                                                                             
//TPFIL1   DD  DSN=&&TPFIL1,DISP=(NEW,PASS,DELETE),                             
//************ TEMPFIL FÖR SORTERADE ARTIKELSALDO-POSTER                        
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL2   DD  DSN=&&TPFIL2,DISP=(NEW,PASS,DELETE),                             
//************ TEMPFIL FÖR SORTERADE ARTIKELSALDO-POSTER                        
//             DATACLAS=PSEN                                                    
//*                                                                             
//W51204D3 DD  DSN=&INDUT..W51205(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ FILE TO PCMILJÖ-EXCEL                                            
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
