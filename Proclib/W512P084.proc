//*                                                                   *         
//*      KURANSGRUPPERING                                             *         
//*                                                                   *         
//*      PERIODICITET:   MÅNADSSLUT                                   *         
//*                                                                   *         
//*      ÅTERSTART:      NORMAL                                       *         
//*                                                                   *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W512P084 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W512..W512M2,                                            
//             INDUT=&W512..W512M2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* EXTRACT CORRECT NDC FROM NDC FILE                                           
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT94B  EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W512PD94),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN1..W51294B(+0),DISP=SHR                                
//************ ALL DATA ELEMENTS FROM WDL711 + L411                             
//*                                                                             
//SORTOUT  DD  DSN=&&W51294B,DISP=(NEW,PASS,DELETE),                            
//************ SORTED ALL DATA ELEMENTS FROM WDL711 + L411                      
//         DATACLAS=PSEN                                                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51284  EXEC PGM=W51284                                                       
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//V16247D3 DD  SYSOUT=*                                  (POSTSUM)              
//*                                                                             
//W51284D1 DD  DSN=&INDIN1..W5128PA(+0),DISP=SHR                                
//************ IN FILE FROM PREV JOB W512J08P                                   
//*                                                                             
//W51284D2 DD  DSN=&&W51294B,DISP=(OLD,PASS,DELETE)                             
//************ SORTED ALL DATA ELEMENTS FROM WDL711 + L411                      
//*                                                                             
//W51284D3 DD  DSN=&&W51284,DISP=(NEW,PASS,DELETE),                             
//************ FIL FÖR LISTNING AV KURANSGRP.REGLER                             
//             DATACLAS=PSEB                                                    
//*                                                                             
//SORT84  EXEC PGM=SORT                                                         
//SORTIN   DD  DSN=&&W51284,DISP=(OLD,DELETE,DELETE)                            
//************** KURANSVÄRDEN FÖR DC                                 ***        
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W51284(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//**************  SORTERAD KURANSVÄRDE PÅ DC/PRODUKTSLAG            ***         
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W512PD85),DISP=SHR                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
