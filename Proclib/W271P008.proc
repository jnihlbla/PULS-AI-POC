//W271P008 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W011..NDC,                                               
//             INDIN3=&W011..LDC,                                               
//             INDIN4=&W011..SDC,                                               
//             INDIN=&W271..W271D8,                                             
//             INDIN2=&W011..&RTEGRP.,                                          
//             INDUT=&W271..W271D8                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W271PD08),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN1..W01184(+0),DISP=SHR                                 
//************ ARTIKELUPPGIFTER, NDC                                            
//*                                                                             
//         DD  DSN=&INDIN3..W01184(+0),DISP=SHR                                 
//************ ARTIKELUPPGIFTER, LDC                                            
//*                                                                             
//         DD  DSN=&INDIN4..W01184(+0),DISP=SHR                                 
//************ ARTIKELUPPGIFTER, SDC                                            
//*                                                                             
//SORTOUT  DD  DSN=&&W27184,DISP=(NEW,PASS,DELETE),                             
//************ ARTIKELUPPGIFTER, SAMTLIGA DC                                    
//         DATACLAS=PSEB                                                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W27108   EXEC PGM=V16459,PARM='W27108/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W27108D1 DD  DSN=&INDIN2..W01160(+0),DISP=SHR                                 
//************ ARTIKELFIL, CDC                                                  
//*                                                                             
//W27108D2 DD  DSN=&INDIN..W27108(+0),DISP=SHR                                  
//************ GÅRDAGENS ERSKOD                                                 
//*                                                                             
//W27108D3 DD  DSN=&&W27184,DISP=(OLD,DELETE,DELETE)                            
//************ ARTIKLAR, SAMTLIGA NDC                                           
//*                                                                             
//W27108D4 DD  DSN=&INDUT..W27109(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ ARTIKLAR SOM FÅTT ERSKOD 05 06 09 25 ELLER 26                    
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//W27108D5 DD  DSN=&INDUT..W27108(+1),DISP=(NEW,CATLG,DELETE),  -LIM(2)         
//************ DAGENS VÄRDE PÅ ERSKOD                                           
//             SPACE=(7,(100,16),RLSE),AVGREC=K,                                
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
