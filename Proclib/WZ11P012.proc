//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  RECEIVE FILE FROM MQ                                                       
//*                                                                             
//*  FREQUENCE:    N/A                                                          
//*                                                                             
//*  RESTART:      WZ1112    NORMAL                                             
//*                                                                             
//*  ARGUMENTS:    RTEGRP   - RUNTIME ENVIRONMENT (DEVE,IGRT ...)               
//*                           (DEFAULT VALUE FROM ENVXXXX INCLUDE)              
//*                                                                             
//*                ABSADDRS - ABSTRACT ADDRESS IN WZ01ATAB                      
//*                                                                             
//*                DSOUT    - OUTPUT FILE NAME                                  
//*                                                                             
//*                RECFM    - OUTPUT FILE FORMAT. FB OR VB                      
//*                           DEFAULT VB                                        
//*                                                                             
//*                LRECL    - OUTPUT RECORD LENGTH.                             
//*                           DEFAULT 3000                                      
//*                                                                             
//*                QMGR     - QUEUE MANAGER IS IDENTIFIED IN THE PGM            
//*                           BASED ON RTEGRP. HOWEVER, IT CAN BE               
//*                           OVERRIDED THROUGH PARM IF REQUIRED.               
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ11P012 PROC STPLIB=&INDRTE..LOAD,                                           
//             ABSADDRS=NOADDRESS,                                              
//             DSOUT=NULLFILE,                                                  
//             RECFM=VB,                                                        
//             LRECL=3000,                                                      
//             QMGR=NULL                                                        
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ1112   EXEC PGM=WZ1112,PARM='&RTEGRP.&ABSADDRS;&DSOUT;&RECFM;&LRECL         
//             ;&QMGR;'                                                         
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//*                                                                             
