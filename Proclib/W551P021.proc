//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  STANDARD PRICE YEARLY PROCESS                                              
//*  FETCH LATEST PRICE ROW FROM WDK724 FOR US AND CN                           
//*  FREQUENCE:    DAILY     RTN W551B1                                         
//*                                                                             
//*  RESTART:      W55121      NORMAL                                           
//*                READS        WDK7 AND WDK6                                   
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W551P021 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W011..NDC,                                               
//             INDIN2=&W551..W551B1,                                            
//             INDUT=&W551..W551B1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORTPR1  EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W551PD21),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN1..W01185(+0),DISP=SHR                                 
//************ EXTRACT FILE OF WDK724                                           
//*                                                                             
//SORTOUT  DD  DSN=&&W01185,DISP=(NEW,PASS,DELETE),                             
//************ SORTED FILE                                                      
//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORTPR2  EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W551PD21),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN2..W55147(+0),DISP=SHR                                 
//************ FILE WITH SPIS INFO (WDC6)                                       
//*                                                                             
//SORTOUT  DD  DSN=&&W55147,DISP=(NEW,PASS,DELETE),                             
//************ SORTED FILE                                                      
//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W55121   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W55121,W55121,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//WDK6     INCLUDE MEMBER=WDK6                                                  
//W55121D1 DD  DSN=&&W01185,DISP=(OLD,PASS,DELETE)                              
//******************IN FILE WDK724 EXTRCT                                       
//W55121D2 DD  DSN=&&W55147,DISP=(OLD,PASS,DELETE)                              
//******************IN FILE WITH SPIS INFO (WDC6) FROM W551P047                 
//W55121D3 DD  DSN=&INDUT..W55121(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ OUT FILE WITH PRICE INFO                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
