//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  STÄDNING SATSSTRUKTUR OCH LEVERANSPLAN                                     
//*  SKAPADE AV BEGÄRAN OM ORDERNR FRÅN SATSORDER                               
//*  SKAPAR EN UTFIL FÖR SENARE UPPDATERING AV                                  
//*  WDD9 WDG3 WDJ1 WDK6                                                        
//*                                                                             
//*  FREKVENS:     VECKA   RTN W215S1                                           
//*                                                                             
//*  ÅTERSTART:    W21502  NORMAL                                               
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W215P001 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W215..W215S1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W21502   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W21502,W21502,,00')                                  
//STEPLIB  DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDJ1     INCLUDE MEMBER=WDJ1                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDD9     INCLUDE MEMBER=WDD9                                                  
//WDG3     INCLUDE MEMBER=WDG3                                                  
//W21502D1 DD  DSN=&INDUT..W21502(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ FIL MED BEGÄRAN OM ORDERNR TILL SATSORDER                        
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
//*                                                                             
//W21502D2 DD  DSN=&INDUT..W21507(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ LISTFIL TILL W215P002                                            
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
//*                                                                             
//W21502D3 DD  DSN=&INDUT..W21510(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ UPPDATERINGSFIL TILL W215P003                                    
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
