//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*  PROCEDURE FOR SENDING MESSAGES TO TSO USERS                      *         
//*  THE LENGTH OF THE MESSAGE TEXT MUST BE < OR = 25 CHARACTERS      *         
//*                                                                   *         
//*                                    MAINTAINED BY DEPT. 9231       *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WNOTIFY  PROC USERID=,MSG=                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SEND    EXEC PGM=WNOTIFY,                                                     
// PARM='&USERID//&MSG//'                                                       
//STEPLIB  DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                                         
