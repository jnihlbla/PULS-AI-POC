//*                                                                             
//*  FEEDBACK RECORDS TO IMS ADVANSYS FOR DIRECT BUSINESS                       
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W463D8                                         
//*                                                                             
//*  RESTART:      W46365    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W463P065 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDREG=&W463,                                                    
//             INDIN=&W463..W463D8,                                             
//             INDUT=&W463..W463D8                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W46365   EXEC PGM=W46365                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W46365D1 DD  DSN=&INDIN..W46365,DISP=SHR                                      
//************ ERROR RECORDS                                                    
//*                                                                             
//W46365D2 DD  DSN=&INDIN..JP.W46370,DISP=SHR                                   
//         DD  DSN=&INDIN..MQ.W46370,DISP=SHR                                   
//************ FEEDBACK RECORDS                                                 
//*                                                                             
//W46365D3 DD  DSN=&INDREG..W46363(+0),DISP=SHR                                 
//************ SERIAL NUMBER FILE IN                                            
//*                                                                             
//W46365D4 DD  DSN=&INDREG..W46363(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ SERIAL NUMBER FILE OUT                                           
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//W46365D5 DD  DSN=&INDUT..W46369(+1),DISP=(NEW,CATLG,DELETE), -LIM(30)         
//************ ERROR AND FEEDBACK RECORDS FOR VCOM TRANSMISSION                 
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
