//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*  PROCEDURE FOR REMOVING EXECUTION BLOCKS.                         *         
//*                                                                   *         
//*                                    MAINTAINED BY DEPT. 36000      *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WFREE    PROC NAME=,INDEX=&W,MAXRC=4                                          
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *           
//CARDGEN EXEC PGM=V12340,COND=(&MAXRC,LT),                                     
//         PARM=(' DELETE &INDEX..&NAME GDG ')                                  
//V12340D1 DD  DUMMY,DCB=BLKSIZE=80                                             
//V12340D2 DD  DSN=&&CARDS,DISP=(NEW,PASS,DELETE),                              
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=160),                             
//             SPACE=(TRK,1)                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *           
//DEL    EXEC  PGM=IDCAMS,COND=(&MAXRC,LT)                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&&CARDS,DISP=(OLD,DELETE,DELETE)                             
