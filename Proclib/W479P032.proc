//*                                                                             
//*  ACCUMULATED NIL PICKS AND DEVIATIONS WEEKLY FOLLOW UP                      
//*                                                                             
//*  FREQUENCE:   WEEKLY     RTN W479V5                                         
//*                                                                             
//*  RESTART:     W47932    NORMAL                                              
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W479P032 PROC STPLIB=&INDRTE..LOAD, -- TA EV BORT KOMMA                       
//             INDIN=&W479..W479V2,                                             
//             INDUT=&W479..W479V5                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47932   EXEC PGM=V16459,PARM='W47932/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W47932D1 DD  DSN=&INDIN..W4795C(+0),DISP=SHR                                  
//************ PACKRAD                                                          
//*                                                                             
//W47932D2 DD  DSN=&&TEMP1,DISP=(NEW,DELETE,DELETE),                            
//************ TEMPORÄR SORTERAD IN-PACKRADS-FIL.                               
//             DATACLAS=PSEN                                                    
//*                                                                             
//W47932D3 DD  DSN=&INDUT..W47932(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ OUTPUT W47932                                                    
//             DATACLAS=PSEN                                                    
//*                                                                             
//W47932D4 DD  DSN=&INDUT..W47935(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ OUTPUT W47935                                                    
//             DATACLAS=PSEN                                                    
//*                                                                             
