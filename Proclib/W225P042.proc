//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR LISTFIL, ANTAL ARTIKLAR PER ANSKAFFARE MED                          
//*  ANTAL RO, TÄCKTA RO SAMT EJ TÄCKTA RO                                      
//*                                                                             
//*  FREKVENS:          VECKA   RTN W225V2                                      
//*                                                                             
//*  ÅTERSTART:              NORMAL                                             
//*                W22542      NORMAL                                           
//*                LÄSER  WDD9                                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W225P042 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W225..W225V2,                                             
//             INDUT=&W225..W225V2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W225PD42),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W22541(+0),DISP=SHR                                  
//************ ARTIKLAR MED RESTORDER                                           
//*                                                                             
//SORTOUT  DD  DSN=&&W22541,DISP=(NEW,PASS,DELETE),                             
//************ ARTIKLAR MED RESTORDER PER ANSKAFFARE                            
//         SPACE=(19,(10,13),RLSE),AVGREC=K                                     
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W22542   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W22542,W22542,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDD9     INCLUDE MEMBER=WDD9                                                  
//W22542D1 DD  DSN=&&W22541,DISP=(OLD,DELETE,DELETE)                            
//************ ARTIKLAR MED RESTORDER PER ANSKAFFARE                            
//*                                                                             
//W22542D2 DD  DSN=&INDUT..W22543(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ TÄCKTA/EJ TÄCKTA RESTORDER PER ANSKAFFARE                        
//             SPACE=(22,(5,6),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&BACKUPC                                                
//W22542D3 DD  DSN=&INDUT..W22542(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ TÄCKTA/EJ TÄCKTA RESTORDER PER ARTIKEL                           
//             SPACE=(7,(5,6),RLSE),AVGREC=K,                                   
//             MGMTCLAS=&BACKUPC                                                
