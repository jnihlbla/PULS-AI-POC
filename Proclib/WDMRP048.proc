//*                                                                             
//*  LADDA DATA MANAGER MED JOBB OCH RAPPORTER                                  
//*                                                                             
//*  FREKVENS:     VECKA        RTN WDMRV2                                      
//*                                                                             
//*  ÅTERSTART:    DMR    NORMAL                                                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WDMRP048 PROC INDIN=&WDMR..WDMRV2,                                            
//             INDUT=&WDMR..WDMRV2,                                             
//             DMR=W.PROD,                                                      
//             MPAID=F1DAV1.MPAID,                                              
//             STPLIB=F1DAV1.DMR.LOAD                                           
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//DMR     EXEC PGM=MPR00,REGION=4096K                                           
//STEPLIB   DD DSN=&STPLIB.,DISP=SHR                                            
//MPOUT     DD DSN=&INDUT..WDMR48(+1),                         -LIM(03)         
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=&DEL2BKPC,BLKSIZE=23476,                                
//             SPACE=(130,(500,500),RLSE),AVGREC=K                              
//SYSUDUMP  DD SYSOUT=*                                                         
//PROD      DD DSN=&DMR..INDEX,DISP=SHR                                         
//PRODD     DD DSN=&DMR..DATA,DISP=SHR                                          
//PRODS     DD DSN=&DMR..DMSOURCE,DISP=SHR                                      
//PRODE     DD DSN=&DMR..RECOVER,DISP=SHR                                       
//PRODJ     DD DSN=&DMR..LOG,DISP=SHR                                           
//MPAID     DD DSN=&MPAID,DISP=SHR                                              
//MPIN      DD DSN=&INDRTE..CONSTANT(WDMRLON),DISP=SHR                          
//          DD DSN=&INDIN..WDMR43(+0),DISP=SHR                                  
//          DD DSN=&INDIN..WDMR46(+0),DISP=SHR                                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
