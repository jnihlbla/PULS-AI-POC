//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LÄSER WDK7 MED SB, SKRIVER SAMTLIGA ITEM FRÅN                              
//*  WDK711 PÅ FILER, EN FÖR VART SDC                                           
//*                                                                             
//*  ANVÄNDS AV REFILLSYSTEMET VID NATT OCH VECKOKÖRNING DÅ                     
//*  ORDINARIE GRUNDFILER EJ ÄR AKTUELLA                                        
//*                                                                             
//*  LDC         W011.LDC.W01184                                                
//*  SDC         W011.SDC.W01184                                                
//*                                                                             
//*  SDC 21, 22, 23, 24, 25, 26                                                 
//*  LDC 1A, 1B, 1C, 1K,                                                        
//*      2A, 2B, 2C, 2D, 2E, 2F,                                                
//*      2G, 2H, 2I, 2J, 2K, 2L,                                                
//*      2M, 2N, 2O, 3A,3B, 3C, 3D,                                             
//*      3E, 3F, 3G, 3H, 3I                                                     
//*                                                                             
//*                                                                             
//*  FREKVENS:     DAG, VECKA  W271D1 W271V1                                    
//*                                                                             
//*  ÅTERSTART:    W27147      NORMAL                                           
//*                LÄSER  WDK7                                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W271P047 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT1=&W271..LDC,                                               
//             INDUT2=&W271..SDC,                                               
//             INDUT3=&W271..CHN                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W27147   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W27147,W27147,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDK7     INCLUDE MEMBER=WDK7                                                  
//W27147D1 DD  DSN=&&K7LDC,DISP=(NEW,PASS,DELETE),                              
//************ SAMTLIGA DATAELEMENT FRÅN WDK711, IDDC = LDC                     
//         DATACLAS=PSEN                                                        
//*                                                                             
//W27147D2 DD  DSN=&&K7SDC,DISP=(NEW,PASS,DELETE),                              
//************ SAMTLIGA DATAELEMENT FRÅN WDK711, IDDC = SDC                     
//         DATACLAS=PSEN                                                        
//*                                                                             
//W27147D3 DD  DUMMY                                                            
//*                                                                             
//W27147D4 DD  DSN=&&K7CHN,DISP=(NEW,PASS,DELETE),                              
//************ INTERN REFILL NDC-CN                                             
//         DATACLAS=PSEN                                                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//* LDC                                                                         
//*                                                                             
//SORT01   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTDCAR),DISP=SHR                         
//SORTIN   DD  DSN=&&K7LDC,DISP=(OLD,DELETE,DELETE)                             
//************ SAMTLIGA DATAELEMENT FRÅN WDK711, IDDC = LDC                     
//*                                                                             
//SORTOUT   DD DSN=&INDUT1..W27147(+1),                        -LIM(1)          
//             DISP=(NEW,CATLG,DELETE),                                         
//************ SAMTLIGA DATAELEMENT FRÅN WDK711, IDDC =LDC, SORT; IDART         
//         DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                      
//*                                                                             
//* SDC                                                                         
//*                                                                             
//SORT02   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTDCAR),DISP=SHR                         
//SORTIN   DD  DSN=&&K7SDC,DISP=(OLD,DELETE,DELETE)                             
//************ SAMTLIGA DATAELEMENT FRÅN WDK711, IDDC = SDC                     
//*                                                                             
//SORTOUT   DD DSN=&INDUT2..W27147(+1),                        -LIM(1)          
//             DISP=(NEW,CATLG,DELETE),                                         
//************ SAMTLIGA DATAELEMENT FRÅN WDK711, IDDC =SDC, SORT; IDART         
//         DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                      
//*                                                                             
//* INTERN REFILL NDC-CN                                                        
//*                                                                             
//SORT03   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTDCAR),DISP=SHR                         
//SORTIN   DD  DSN=&&K7CHN,DISP=(OLD,DELETE,DELETE)                             
//************ SAMTLIGA DATAELEMENT FRÅN WDK711, IDDC = SDC                     
//*                                                                             
//SORTOUT   DD DSN=&INDUT3..W27147(+1),                        -LIM(1)          
//             DISP=(NEW,CATLG,DELETE),                                         
//************ INTERN REFILL NDC-CN                         SORT; IDART         
//         DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                      
//*                                                                             
