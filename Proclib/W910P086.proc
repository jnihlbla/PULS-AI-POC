//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LÄSER WDD3 MED SB, SKRIVER SAMTLIGA BENÄMNINGAR PER                        
//*  ARTIKEL FRÅN WDD311 PÅ FILEN W91087, SORT;IDARTNR                          
//*                                                                             
//*                                                                             
//*  FREKVENS:    PERIOD  RTN W910P2                                            
//*                                                                             
//*                                                                             
//*  ÅTERSTART:    W91086      NORMAL                                           
//*                LÄSER  WDD3                                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W910P086 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W910..W910P2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W91086   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W91086,W91086,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDD3     INCLUDE MEMBER=WDD3                                                  
//W91086D1 DD  DSN=&&W91087,DISP=(NEW,PASS,DELETE),                             
//************ BENÄMNINGAR PER ARTIKEL                                          
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=NOBACKUP                                                
//*                                                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W910PD86),DISP=SHR                         
//SORTIN   DD  DSN=&&W91087,DISP=(OLD,DELETE,DELETE)                            
//************ BENÄMNINGAR PER ARTIKEL                                          
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W91087(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ BENÄMNINGAR PER ARTIKEL, SORT IDARTNR                            
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=NOBACKUP                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
