//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  TO PRINT A REPORT VIA D&P                                                  
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W479M2                                         
//*                                                                             
//*  RESTART:      W47929    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W479P029 PROC STPLIB=&INDRTE..LOAD, -- TA EV BORT KOMMA                       
//             INDIN=&W479..W479M2,                                             
//             INDUT=&W479..W479M2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47929   EXEC PGM=V16459,PARM='W47929/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//*EZTVFM   DD  SPACE=(4096,(100,100))                                          
//EZTP.EZTVFM  DD  SPACE=(CYL,(95,50))                                          
//SORTMSG  DD  SYSOUT=*                                                         
//W47929D1 DD  DSN=&INDIN..W47928(+0),DISP=SHR                                  
//************ INVOICE FILE WITH DEPT NUMBER                                    
//W47929D2 DD  DSN=&INDUT..W47929(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ W47929-001 LISTA                                                 
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//*                                                                             
