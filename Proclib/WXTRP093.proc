//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  COPIES WXTR9C(+0) TO WXTR.PARTINFO.WCDCWEEK(+1)                            
//*  COPIES WXTR9S(+0) TO WXTR.PARTINFO.WSDCWEEK(+1)                            
//*  COPIES WXTR9N(+0) TO WXTR.PARTINFO.WNDCWEEK(+1)                            
//*  COPIES WXTR9K(+0) TO WXTR.PARCINFO.WNDCWEEK(+1)                            
//*                                                                             
//*  FREQUENCE:    WEEKLY  (RTN WXTRD2)                                         
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                          NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTRP093 PROC INDIN=&WXTR..WXTRD2,                                            
//             INDUT2=&WXTR..PARTINFO,                                          
//             INDUT3=&WXTR..PARTINFO,                                          
//             INDUT4=&WXTR..PARTINFO,                                          
//             INDUT5=&WXTR..PARCINFO                                           
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ICEGENE1 EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDIN..WXTR9C(+0),DISP=SHR                                  
//************ CDC-INFORMATION                                                  
//*                                                                             
//SYSUT2   DD  DSN=&INDUT2..WCDCWEEK(+1),                       -LIM(3)         
//             DISP=(NEW,CATLG,DELETE),                                         
//************ CDC-INFORMATION                                                  
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ICEGENE2 EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDIN..WXTR9S(+0),DISP=SHR                                  
//************ SDC-INFORMATION                                                  
//*                                                                             
//SYSUT2   DD  DSN=&INDUT3..WSDCWEEK(+1),                       -LIM(3)         
//             DISP=(NEW,CATLG,DELETE),                                         
//************ SDC-INFORMATION                                                  
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ICEGENE3 EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDIN..WXTR9N(+0),DISP=SHR                                  
//************ SDC-INFORMATION                                                  
//*                                                                             
//SYSUT2   DD  DSN=&INDUT4..WNDCWEEK(+1),                       -LIM(3)         
//             DISP=(NEW,CATLG,DELETE),                                         
//************ SDC-INFORMATION                                                  
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ICEGENE4 EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDIN..WXTR9K(+0),DISP=SHR                                  
//************ CN-INFORMATION                                                   
//*                                                                             
//SYSUT2   DD  DSN=&INDUT5..WNDCWEEK(+1),                       -LIM(3)         
//             DISP=(NEW,CATLG,DELETE),                                         
//************ CN-INFORMATION                                                   
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
