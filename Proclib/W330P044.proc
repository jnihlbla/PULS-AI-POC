//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W330P044 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W330..W330B1,                                             
//             INDUT=&W330..W330B1                                              
//*                                                                             
//SORT1    EXEC PGM=SORT,REGION=5M                                              
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W330PD44),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W33031(+0),DISP=SHR                                  
//************ URVALSFILEN                                                      
//*                                                                             
//SORTOUT  DD  DSN=&&W33031S,DISP=(NEW,PASS,DELETE),                            
//************ SORTERAD IDUSER TIREGDAT TIREGTID                                
//             SPACE=(6233,(5000,1000),RLSE)                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33044   EXEC PGM=DFSRRC00,REGION=5M,                                         
//             PARM=('&DBB,W33044,W33044,,00')                                  
//STEPLIB  DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DUMMY                                                            
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDG2     INCLUDE MEMBER=WDG2                                                  
//W33044D1 DD  DSN=&&W33031S,DISP=(OLD,DELETE,DELETE)                           
//*                                                                             
//W33044D2 DD  DSN=&INDIN..W33043(+0),DISP=SHR                                  
//************ RESULTATFIL P1-URVAL                                             
//*                                                                             
//W33044D5 DD  DSN=&INDIN..W33099(+0),DISP=SHR                                  
//************ FUNKTIONSGRUPPSBENÄMNINGAR (STRUKTUWREGISTRET)                   
//*                                                                             
//W33044D6 DD  DSN=&INDUT..W33045(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ URVAL OCH RESULTATFIL FÖR P1-URVAL                               
//             MGMTCLAS=DEL2,                                                   
//             VOL=(,,,3),SPACE=(23476,(1500,2500),RLSE)                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
