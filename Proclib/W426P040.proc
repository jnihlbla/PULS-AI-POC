//*                                                                             
//*  LISTA ÖVER JUSTERADE KONTROLLRAPPORTER                                     
//*                                                                             
//*  FREKVENS:     VECKA    RTN W426V2                                          
//*                                                                             
//*  ÅTERSTART:    W42637    NORMAL                                             
//*                W42640    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W426P040 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W426..W426V2,                                             
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W42637   EXEC PGM=W42637                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DUMMY                                                            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W42637D1 DD  DSN=&INDIN..W42639,DISP=SHR                                      
//************ JUSTERADE KONTROLLRAPPORTER                                      
//*                                                                             
//W42637D2 DD  DSN=&&W42637,DISP=(NEW,PASS,DELETE),                             
//************ SORTERADE KONTROLLRAPPORTER                                      
//         SPACE=(300,(10,63),RLSE),AVGREC=U                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W42640   EXEC PGM=V16459,PARM='W42640/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//A4LF  OUTPUT FORMDEF=SLSR6C,PAGEDEF=SLSR6C                                    
//************ A4 LANDSCAPE, SINGLE SIDE, RASTER  (FOLDED PAPER)                
//W42640D1 DD  DSN=&&W42637,DISP=(OLD,DELETE,DELETE)                            
//************ SORTERADE KONTROLLRAPPORTER                                      
//*                                                                             
//W42640D2 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF),                    
//************ W42640-001  KONTROLLRAPPORT JUSTERINGAR PV C1                    
//             DCB=(RECFM=FBA,LRECL=121,BLKSIZE=121)                            
//*                                                                             
//W42640D3 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF),                    
//************ W42640-002  KONTROLLRAPPORT JUSTERINGAR PV C2                    
//             DCB=(RECFM=FBA,LRECL=121,BLKSIZE=121)                            
//*                                                                             
//W42640D4 DD  DUMMY                                                            
//*42640D4 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF),                    
//************ W42640-003  KONTROLLRAPPORT JUSTERINGAR PV C2,PÅ ENG.            
//*            DCB=(RECFM=FBA,LRECL=121,BLKSIZE=121)                            
//*                                                                             
