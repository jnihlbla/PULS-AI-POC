//*                                                                             
//*  ACCUMULATED NIL PICKS AND DEVIATIONS WEEKLY FOLLOW UP                      
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W479M1                                         
//*                                                                             
//*  RESTART:      W47936    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W479P036 PROC STPLIB=&INDRTE..LOAD, -- TA EV BORT KOMMA                       
//*                                                                             
//             INDIN=&W479..W479M1,                                             
//             INDUT=&W479..W479M1                                              
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W479PD36),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W47935,DISP=SHR                                      
//***FRÅN W479P032 TA IN ALLA GENERATIONER OCH SORTERA TILL EN FIL.             
//*                                                                             
//SORTOUT  DD  DSN=&&W4793B,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//************ SORTERADE LDC-ORDER (IDDC)                                       
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47936   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W47936,W47931,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR                             
//DATUT    DD  SYSOUT=*                                                         
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W47936D1 DD  DSN=&&W4793B,DISP=(OLD,DELETE,DELETE)                            
//************ INPUT TO W47936                                                  
//*                                                                             
//W47936D2 DD  DSN=&INDUT..W47936(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//************ OUTPUT W47931 TO D&P                                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//*OUTPUT GÅR DIREKT TILL D&P I WEB.                                            
