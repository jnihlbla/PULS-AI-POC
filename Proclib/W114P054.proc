//W114P054 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=1,                                                           
//             INDUT=&WUT..W114D6,                                              
//             INDUT2=&W114..W114D6                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11454   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W11454,W11454,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//SYSOUT   DD  SYSOUT=*                                      -- DISPLAY         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                      -- POSTSUM         
//*                                                                             
//W11454D2 DD  DSN=&INDUT..W11454(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ TRANSAR TILL NAP PV                                              
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W11454D3 DD  DSN=&INDUT2..W11455(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)        
//************ MAIL DATA TILL NAP PV                                            
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W11454D4 DD  DSN=&INDUT2..W11456(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)        
//************ MAIL ADR  TILL NAP PV                                            
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//SOPDD1   DD  DSN=&INDRTE..SOP,DISP=SHR                                        
//PDSDD1   DD  DSN=&INDRTE.TMP.JCL,DISP=SHR                                     
//PDSDD2   DD  DSN=&INDRTE..JCL,DISP=SHR                                        
