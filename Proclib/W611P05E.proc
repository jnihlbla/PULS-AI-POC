//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  JOB TO CREATE A FILE BASED ON DEPARTMENT AND TEAM FROM                     
//*  OUTPUT OF W6115D AND SEND IT FOR DISTRIBUTION AND PRINTING                 
//*                                                                             
//*  FREQUENCY:  WEEKLY   RTN W611V1                                            
//*                                                                             
//*  RESTART:      W6115E    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W611P05E PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W611..W611V1,                                             
//             INDUT=&W611..W611V1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT50   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W611PD5E),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W6115D(+0),DISP=SHR                                  
//************ BELÄGGNINGSFIL                                                   
//*                                                                             
//SORTOUT  DD  DSN=&&W6115E,DISP=(NEW,PASS,DELETE),                             
//************ SORTERAD BELÄGGNINGSFIL                                          
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W6115E   EXEC PGM=V16459,PARM='W6115E/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W6115ED1 DD  DSN=&&W6115E,DISP=(OLD,PASS,DELETE)                              
//************ SORTERAD GENOMLOPPSTID FIL                                       
//*                                                                             
//W6115ED2 DD  DSN=&INDUT..W6115E(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ W6115E-001 LISTA GENOMLOPPSTIDER OCH AK-BELÄGGNING               
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
