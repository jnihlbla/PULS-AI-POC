//W561P069 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W561..W561D3,                                             
//             INDUT=&W561..W561D3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W561PD01),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W56171A(+0),DISP=SHR                                 
//************ INFILE W56171A                                                   
//*                                                                             
//SORTOUT  DD  DSN=&&W56171A,DISP=(NEW,PASS,DELETE),                            
//************ SORTERAD INFIL W56171A                                           
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT2    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W561PD01),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W56173A(+0),DISP=SHR                                 
//************ INFIL W56173A                                                    
//*                                                                             
//SORTOUT  DD  DSN=&&W56173A,DISP=(NEW,PASS,DELETE),                            
//************ SORTERAD UTFIL W56173A                                           
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56169   EXEC PGM=V16459,PARM='W56169/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W56169D1 DD  DSN=&&W56171A,DISP=(OLD,DELETE,DELETE)                           
//************ SORTED INFILE W56171                                             
//*                                                                             
//W56169D2 DD  DSN=&&W56173A,DISP=(OLD,DELETE,DELETE)                           
//************ SORTED INFILE W56173                                             
//*                                                                             
//W56169D3 DD  DSN=&&W56171B,DISP=(NEW,PASS,DELETE),                            
//************ OUTFILE W5617B                                                   
//             DATACLAS=PSEN                                                    
//*                                                                             
//W56169D4 DD  DSN=&&W56173B,DISP=(NEW,PASS,DELETE),                            
//************ OUTFILE W56173B                                                  
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT3    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W561PD03),DISP=SHR                         
//SORTIN   DD  DSN=&&W56171B,DISP=(OLD,DELETE,DELETE)                           
//************ OUTFILE W56171B                                                  
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W56171B(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//************ OUTFILE W56171B                                                  
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
