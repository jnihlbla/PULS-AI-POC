//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR TOTALFIL FÖR FIP                                                    
//*                                                                             
//*  FREQUENCE:    WEEKLY   RTN WXTRV2                                          
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                WXTR13    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTRP013 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WXTR..WXTRV2,                                             
//             INDREG=&WXTR                                                     
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTR13   EXEC PGM=V16459,PARM='WXTR13/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//WXTR13D1 DD  DSN=&INDIN..WXTR16(+0),DISP=SHR                                  
//************ VECKANS FAKTURERAT                                               
//*                                                                             
//WXTR13D2 DD  DSN=&INDIN..WXTR15(+0),DISP=SHR                                  
//************ VECKANS INKOMMET                                                 
//*                                                                             
//WXTR13D3 DD  DSN=&INDIN..WXTR08(+0),DISP=SHR                                  
//************ VECKANS PACKAT                                                   
//*                                                                             
//WXTR13D4 DD  DSN=&&WXTR13,DISP=(NEW,PASS,DELETE),                             
//************ TOTALFIL MED FAKT/INK/PACKAT                                     
//             DATACLAS=PSEN                                                    
//*********************** SLÅ IHOP SENASTE VECKA MED ÖVRIGA VECKOR              
//SORT13   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WXTRPD13),DISP=SHR                         
//SORTIN   DD  DSN=&&WXTR13,DISP=(OLD,DELETE,DELETE)                            
//         DD  DSN=&INDREG..WXTR13(+0),DISP=SHR                                 
//************ TA IN VECKOFIL MED AKTUELL VECKA + FÖREGÅENDE VECKOR             
//************ SORTAS PÅ VECKA, DC, PRC, ORDKL & DISTRIKT                       
//*                                                                             
//SORTOUT  DD  DSN=&INDREG..WXTR13(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ WXTR13 NU MED FÖREGÅENDE VECKOR OCH AKTUELL VECKA                
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
