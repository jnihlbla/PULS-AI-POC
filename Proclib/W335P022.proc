//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR ARTIKELINFO-LISTA MED HJÄLP AV PARAMETRAR=URVAL                     
//*  FRÅN BILD 3331                                                             
//*                                                                             
//*  FREKVENS:     BESTÄLLNING      RTN W335S1                                  
//*                                                                             
//*  ÅTERSTART:    W33522    NORMAL  (BMP)                                      
//*  ÅTERSTART:    W335J022                                                     
//*                HAR PARAMETRAR MED FRÅN SOP. SÅ                              
//*                LÄNGE SOM MAN EJ GÖR END PÅ JOBBET I SOP                     
//*                KAN JOBBET ÅTERSTARTAS. VID END ÄR PARAMETRARNA              
//*                FÖRLORADE. PARAMETRARNA DISPLAYAS I SYSOUTEN.                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W335P022 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDREG=&W910,                                                    
//             INDUT=&W335..W335S1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33522   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W33522,W33522,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//W33522D1 DD  DDNAME=SYSIN                                                     
//************ PARAMETRAR FRÅN BILD 3331  (OVERRIDE I JCL)                      
//*                                                                             
//W33522D2 DD  DSN=&INDREG..W91042(+0),DISP=SHR                                 
//************ ARTIKELEXTRAKT                                                   
//*                                                                             
//W33522D3 DD  DSN=&INDUT..W33522(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//************ FIL FÖR MAILSÄNDNING                                             
//             MGMTCLAS=BACKUPC,DATACLAS=PSEB                                   
//*                                                                             
