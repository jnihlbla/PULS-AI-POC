//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR ARTIKELFIL W91042                                                   
//*  CDC-UPPGIFTER OCH SUMMERADE SDC-, USA- OCH KANADA- UPPGIFTER               
//*                                                                             
//*  FREKVENS:     DAG    RTN W011D2                                            
//*                                                                             
//*  ÅTERSTART:              NORMAL                                             
//*                W91042    NORMAL                                             
//*                READS        WDB6                                            
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W910P042 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W011..&RTEGRP.,                                          
//             INDIN2=&W011..LDC,                                               
//             INDIN3=&W011..SDC,                                               
//             INDIN4=&W011..NDC,                                               
//             INDUT=&W910.                                                     
//*                                                                             
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W910PD42),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN2..W01184(+0),DISP=SHR                                 
//************ SAMTLIGA DATAELEMENT FRÅN WDK711, LDC                            
//         DD  DSN=&INDIN3..W01184(+0),DISP=SHR                                 
//************ SAMTLIGA DATAELEMENT FRÅN WDK711, SDC                            
//         DD  DSN=&INDIN4..W01184(+0),DISP=SHR                                 
//************ SAMTLIGA DATAELEMENT FRÅN WDK711, NDC                            
//*                                                                             
//SORTOUT  DD  DSN=&&W01184,DISP=(NEW,PASS,DELETE),                             
//************ SAMTLIGA DATAELEMENT FRÅN WDK7, SAMTLIGA  DC                     
//         DATACLAS=PSEB                                                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W91042   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W91042,W91042,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDB6     INCLUDE MEMBER=WDB6                                                  
//*                                                                             
//W91042D1 DD  DSN=&INDIN1..W01160(+0),DISP=SHR                                 
//************ SAMTLIGA DATAELEMENT FRÅN WDK601 OCH WDK611                      
//*                                                                             
//W91042D2 DD  DSN=&INDIN1..W01161(+0),DISP=SHR                                 
//************ SAMTLIGA DATAELEMENT FRÅN WDK621                                 
//*                                                                             
//W91042D3 DD  DSN=&INDIN1..W01162(+0),DISP=SHR                                 
//************ SAMTLIGA DATAELEMENT FRÅN WDK625, NOTERINGAR                     
//*                                                                             
//W91042D4 DD  DSN=&INDIN1..W01166(+0),DISP=SHR                                 
//************ UTVALDA DATAELEMENT FRÅN WDD201                                  
//*                                                                             
//W91042D5 DD  DSN=&INDIN1..W01168(+0),DISP=SHR                                 
//************ UTVALDA DATAELEMENT FRÅN WDK901                                  
//*                                                                             
//W91042D7 DD  DSN=&INDIN1..W01174(+0),DISP=SHR                                 
//************ SAMTLIGA BENÄMNINGAR FRÅN WDD3                                   
//*                                                                             
//W91042D8 DD  DSN=&&W01184,DISP=(OLD,DELETE,DELETE)                            
//************ SAMTLIGA DATAELEMENT FRÅN WDK711, SAMTLIGA SDC                   
//*                                                                             
//W91042DA DD  DSN=&INDIN1..W01169(+0),DISP=SHR                                 
//************ UTVALDA DATAELEMENT FRÅN WDF7                                    
//*                                                                             
//W91042D9 DD  DSN=&INDUT..W91042(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ ARTIKELFIL, CDC- OCH SUMMERADE SDC-UPPGIFTER                     
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=&BACKUPC                                                
