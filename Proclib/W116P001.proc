//SORT2    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W116PD04),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN2..W23321(+0),DISP=SHR                                 
