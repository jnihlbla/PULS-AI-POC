//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W116PD01),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W11607(+0),DISP=SHR                                  
//************ W11607 INFILE FOR SORT                                           
//*                                                                             
//SORTOUT  DD  DSN=&&W11607,DISP=(NEW,PASS,DELETE),                             
//************ W11607 INFILE SORTED                                             
