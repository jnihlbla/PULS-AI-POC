//*  SAMLAR UPPGIFTER OM FARLIGT-GODS ARTIKLAR                                  
//*  SKRIVER FIL W11184                                                         
//*                                                                             
//*  FREKVENS:     VECKA     RTN W100V1                                         
//*                                                                             
//*  ÅTERSTART:    W11184    NORMAL                                             
//*                LÄSER WDD5 WDK6                                              
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W111P084 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W111..W100V1,                                             
//             INDUT2=&WXTR..W100V1                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11184   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W11184,W11184,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDD5     INCLUDE MEMBER=WDD5                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//W11184D1 DD  DSN=&&W11184,DISP=(NEW,PASS,DELETE),                             
//************ FARLIGT-GODS ARTIKLAR                                            
//         SPACE=(182,(1500,500),RLSE),AVGREC=U                                 
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W111PD84),DISP=SHR                         
//SORTIN   DD  DSN=&&W11184,DISP=(OLD,DELETE,DELETE)                            
//************ FARLIGT-GODS ARTIKLAR                                            
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W11184(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ FARLIGT-GODS ARTIKLAR SORTERADE PÅ ARTIKELNR                     
//             SPACE=(182,(1500,500),RLSE),AVGREC=U,                            
//             MGMTCLAS=&BACKUPC                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ICEGEN1  EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDUT..W11184(+1),DISP=(OLD,CATLG,DELETE)                   
//*                                                                             
//SYSUT2   DD  DSN=&INDUT2..WXTR2D(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//************ ARTKELINFO FARLIGT GODS                                          
//             MGMTCLAS=NOBACKUP,SPACE=(182,(1500,500),RLSE),AVGREC=U           
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ICEGEN2  EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDUT..W11184(+1),DISP=(OLD,CATLG,DELETE)                   
//*                                                                             
//SYSUT2   DD  DSN=&INDUT..W11184A(+1),DISP=(NEW,CATLG,DELETE),                 
//************ ARTKELINFO FARLIGT GODS                                          
//             MGMTCLAS=NOBACKUP,SPACE=(182,(1500,500),RLSE),AVGREC=U           
//*                                                                             
