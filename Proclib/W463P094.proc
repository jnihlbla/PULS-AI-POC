//*  FREKVENS:     VECKA     RTN W463V2                                         
//*                                                                             
//*  ÅTERSTART:    W46394    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W463P096 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W463..W463V2,                                             
//             INDUT=&W463..W463V2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W463PD94),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W4639S(+0),DISP=SHR                                  
//************ DDGS SCORECARD                                                   
//*                                                                             
//SORTOUT  DD  DSN=&&W4639S,DISP=(NEW,PASS,DELETE),                             
//************ DDGS SCORECARDM SORTERAD FÖR RAPPORT                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W46394   EXEC PGM=W46394                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W46394D1 DD  DSN=&&W4639S,DISP=(OLD,DELETE,DELETE)                            
//************ DDGS SCORECARD SORTERAD FÖR RAPPORT                              
//*                                                                             
//W46394D2 DD  DSN=&INDUT..W4639T(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ DDGS SCORECARD TILL D&P EXCEL-FORMAT                             
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
