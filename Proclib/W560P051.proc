//*                                                                   *         
//*      KURANSGRUPPERING                                             *         
//*                                                                   *         
//*      PERIODICITET:   MÅNADSSLUT                                   *         
//*                                                                   *         
//*      ÅTERSTART:      NORMAL                                       *         
//*                                                                   *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W560P051 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W011..NDC,                                               
//             INDIN2=&W560..W560M1,                                            
//             INDUT=&W560..W560M1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* EXTRACT CORRECT NDC FROM NDC FILE                                           
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT86   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTARDC),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN1..W01186(+0),DISP=SHR                                 
//************ LAGERBAND FRÅN NDC:ERNA                                          
//*                                                                             
//SORTOUT  DD  DSN=&&W01186,DISP=(NEW,PASS,DELETE),                             
//         DATACLAS=PSEN                                                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56051  EXEC PGM=W56051                                                       
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//V16247D3 DD  SYSOUT=*                                  (POSTSUM)              
//*                                                                             
//W56051D1 DD  DSN=&INDIN2..W56050(+0),DISP=SHR                                 
//************ LAGERSALDO FÖR DC                                                
//*                                                                             
//W56051D2 DD  DSN=&&W01186,DISP=(OLD,PASS,DELETE)                              
//************ ORDERINGÅNG FÖR DET SENASTE ÅRET FÖR DC                          
//*                                                                             
//W56051D3 DD  DSN=&&W56051,DISP=(NEW,PASS,DELETE),                             
//************ FIL FÖR LISTNING AV KURANSGRP.REGLER                             
//             DATACLAS=PSEB                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//SORT51  EXEC PGM=SORT                                                         
//SORTIN   DD  DSN=&&W56051,DISP=(OLD,PASS,DELETE)                              
//************** KURANSVÄRDEN FÖR DC                                 ***        
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W56051(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//**************  SORTERAD KURANSVÄRDE PÅ DC/PRODUKTSLAG            ***         
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W560PD52),DISP=SHR                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
