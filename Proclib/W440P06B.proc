//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATE REPORT FROM WDA6 FOR TIKLAR = 0 & TIKLAR = YESTERDAY'S DATE         
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W440D3                                         
//*                                                                             
//*  RESTART:      W4406B      NORMAL                                           
//*                READS       WDA6                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W440P06B PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W440..W440D3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W4406B   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W4406B,W4406B,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDA6     INCLUDE MEMBER=WDA6                                                  
//************ TIKLAR = ZERO FILE                                               
//W4406BD1 DD  DSN=&&W4406B1,DISP=(NEW,PASS,DELETE),                            
//             DATACLAS=PSEB                                                    
//*                                                                             
//************ TIKLAR = PREV DAY FILE                                           
//W4406BD2 DD  DSN=&&W4406B2,DISP=(NEW,PASS,DELETE),                            
//             DATACLAS=PSEB                                                    
//*                                                                             
//**********************************************************************        
//*BELOW STEPS WILL TAKE BACKUP OF FILES CREATED IN PREVIOUS STEP               
//**********************************************************************        
//*BACKUP FILE TIKLAR=0                                                         
//BACKUPB1 EXEC PGM=IEBGENER                                                    
//SYSIN    DD DUMMY                                                             
//SYSPRINT DD SYSOUT=*                                                          
//SYSUT1   DD DSN=&&W4406B1,DISP=SHR                                            
//SYSUT2   DD DSN=&INDUT..W4406B1C(+1),                                         
//            DISP=(NEW,CATLG,DELETE),                                          
//            MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                   
//*                                                                             
//*BACKUP FILE TIKLAR=YESTERDAY'S DATE                                          
//BACKUPB2 EXEC PGM=IEBGENER                                                    
//SYSIN    DD DUMMY                                                             
//SYSPRINT DD SYSOUT=*                                                          
//SYSUT1   DD DSN=&&W4406B2,DISP=SHR                                            
//SYSUT2   DD DSN=&INDUT..W4406B2C(+1),                                         
//            DISP=(NEW,CATLG,DELETE),                                          
//            MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                   
