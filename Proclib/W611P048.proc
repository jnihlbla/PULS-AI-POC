//*                                                                             
//*  LISTAR ARTIKLAR SOM INTE HAR NÅGOT                                         
//*  BEHOV INOM X ANTAL DAGAR                                                   
//*                                                                             
//*  FREQUENCE:    WEEK      RTN W611V3                                         
//*                                                                             
//*  RESTART:      W61148      NORMAL                                           
//*                          NORMAL                                             
//*                READS        WDK6 WDK7 WDR2                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W611P048 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W611..W611V3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61148   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W61148,W61148,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDK7     INCLUDE MEMBER=WDK7                                                  
//WDR2     INCLUDE MEMBER=WDR2                                                  
//WDD7     INCLUDE MEMBER=WDD7                                                  
//WDL6     INCLUDE MEMBER=WDL6                                                  
//WDB6     INCLUDE MEMBER=WDB6                                                  
//W61148D1 DD  DSN=&&W61148,DISP=(NEW,PASS,DELETE),                             
//************ ARTIKELLISTA MED BEHOV INOM X DAGAR                              
//             MGMTCLAS=NOBACKUP,DATACLAS=PSEN                                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W611PD48),DISP=SHR                         
//SORTIN   DD  DSN=&&W61148,DISP=(OLD,DELETE,DELETE)                            
//************ OSORTERAD                                                        
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W61148(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ SORTERAD                                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
