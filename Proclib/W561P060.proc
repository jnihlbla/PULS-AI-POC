//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LÄSER IN ALLA PEDALHÄNDELSER PÅ FIL OCH KOMPLETTERAR DESSA                 
//*                                                                             
//*  FREKVENS:     DAG     RTN W561D2                                           
//*                                                                             
//*  ÅTERSTART:    W56160    NORMAL  (BATCH)                                    
//*                READS     WDK6                                               
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W561P060 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W510..W561D2,                                            
//             INDIN2=&W426..W561D2,                                            
//             INDIN3=&W476..W561D2,                                            
//             INDUT=&W561..W561D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W561S1  EXEC PGM=SORT                                                         
//SORTIN   DD  DSN=&INDIN1..W51043,DISP=SHR                                     
//************ INFIL-FAKTURA HÄNDELSER                                          
//         DD  DSN=&INDIN2..W42637,DISP=SHR                                     
//************ INFIL-KRF HÄNDELSER                                              
//         DD  DSN=&INDIN3..W4768G,DISP=SHR                                     
//************ FAKTURA HÄNDELSER                                                
//*                                                                             
//SORTOUT  DD  DSN=&&W56160,DISP=(NEW,PASS,DELETE),                             
//******** SORTERADE PÅ IDVERGL STIGANDE O IDARTNR FALLANDE                     
//             DATACLAS=PSEB                                                    
//*                                                                             
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W561PD60),DISP=SHR                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56160   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W56160,W56160,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDK6     INCLUDE MEMBER=WDK6                                                  
//W56160D1 DD  DSN=&&W56160,DISP=(OLD,PASS,DELETE)                              
//************ SORTERADE PEDAL-HÄNDELSER                                        
//W56160D2 DD  DSN=&INDUT..W56161A(+1),DISP=(NEW,CATLG,DELETE), -LIM(10)        
//************ KOMPLETTERADE PEDAL-HÄNDELSER                                    
//             DATACLAS=PSEB,MGMTCLAS=&BACKUPC                                  
//W56160D3 DD  DSN=&INDUT..W56161C(+1),DISP=(NEW,CATLG,DELETE), -LIM(10)        
//************ KOMPLETTERADE PEDAL-HÄNDELSER                                    
//             DATACLAS=PSEB,MGMTCLAS=&BACKUPC                                  
