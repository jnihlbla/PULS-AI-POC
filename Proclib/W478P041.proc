//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W478PD41),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W47840,DISP=SHR                                      
//************ DAGFILER                                                         
//*                                                                             
//SORTOUT  DD  DSN=&&W47841,DISP=(NEW,PASS,DELETE),                             
