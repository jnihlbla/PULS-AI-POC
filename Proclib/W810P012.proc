//*  SECURE LISTS TO PURCHASE PLANNING, RO SUMMERING                            
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W810D2                                         
//*                                                                             
//*  RESTART:      W81012    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W810P012 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W440,                                                    
//             INDIN2=&WXTR..PARTINFO,                                          
//             INDUT=&W810..W810D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W81012   EXEC PGM=V16459,PARM='W81012/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//W81012D1 DD  DSN=&INDIN1..W44061(+0),DISP=SHR                                 
//************ ESTORDER-FILEN (ANVÄNDS AV LINJEN)                               
//*                                                                             
//W81012D2 DD  DSN=&INDIN2..WCDCDAY(+0),DISP=SHR                                
//************ CDC-INFORMATION                                                  
//*                                                                             
//W81012D3 DD  DSN=&INDUT..W81012(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//************ W81012  SECURE LISTS TO PURCHASE PLANNING, RO SUMMERING          
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
