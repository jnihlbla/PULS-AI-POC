//************ LIST BIN FILL DC 11 LAGOMR= 20 21                                
//W61510DC DD  SYSOUT=(A,,STD),DEST=&DEST1,OUTPUT=(*.A4LF)                      
//************ LIST BIN FILL DC 11 LAGOMR= 15                                   
