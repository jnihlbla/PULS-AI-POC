//WDMRP074 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WDMR..WDMRV4,                                             
//             INDUT=&WDMR..WDMRV4                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WDMRPD74),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..WDMR72(+0),DISP=SHR                                  
//************ DBD-DATA                                                         
//*                                                                             
//SORTOUT  DD  DSN=&&WDMR72S,DISP=(NEW,PASS,DELETE),                            
//************                                                                  
//             SPACE=(23472,(6,2),RLSE)                                         
//*                                                                             
//SORT2    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WDMRPD74),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..WDMROD(+0),DISP=SHR                                  
//************ GAMMALT DBD-DATA                                                 
//*                                                                             
//SORTOUT  DD  DSN=&&WDMRODS,DISP=(NEW,PASS,DELETE),                            
//************                                                                  
//             SPACE=(23472,(6,2),RLSE)                                         
//*                                                                             
//WDMR74   EXEC PGM=V16459,PARM='WDMR74/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DUMMY                                                            
//WDMR74D1 DD  DSN=&&WDMR72S,DISP=(OLD,DELETE,DELETE)                           
//************ NY DBDFIL                                                        
//*                                                                             
//WDMR74D2 DD  DSN=&&WDMRODS,DISP=(OLD,DELETE,DELETE)                           
//************ GAMMAL DBDFIL                                                    
//*                                                                             
//SORTFIL  DD  DSN=&&SORT,DISP=(NEW,DELETE,DELETE),                             
//************ TEMPFIL FÖR SORTERING                                            
//             SPACE=(22,(6000,2000),RLSE),AVGREC=U                             
//*                                                                             
//STYRFIL  DD  DSN=&&STYR,DISP=(NEW,DELETE,DELETE),                             
//************ TEMPFIL MED UPPMÄRKTA POSTER                                     
//             SPACE=(22,(6000,2000),RLSE),AVGREC=U                             
//*                                                                             
//WDMR74D5 DD  DSN=&INDUT..WDMR74(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ DBD:ER SOM SKALL UPPDATERAS                                      
//             MGMTCLAS=DEL2,SPACE=(23458,(5,10),RLSE)                          
//*                                                                             
