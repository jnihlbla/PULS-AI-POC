//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W51044D1 DD  DSN=&INDIN..W51067,DISP=SHR                                      
//************ GODKÄNDA HÄNDELSER FRÅN PEDAL                                    
//*                                                                             
//W51044D2 DD  DSN=&INDIN2..W01160(+0),DISP=SHR                                 
//************ LB-FIL MED WDK6 INFO                                             
//*                                                                             
//TPFIL1   DD  DSN=&&TEMP,DISP=(NEW,DELETE,DELETE),                             
//************ TEMPORÄR SORTERAD PEDALFIL                                       
//             DATACLAS=PSEN                                                    
//W51044D3 DD  DSN=&INDUT..W51046(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ FIL MED TULLINFO TILL W475  BORN                                 
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
