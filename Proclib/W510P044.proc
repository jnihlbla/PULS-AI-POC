//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51044   EXEC PGM=V16459,PARM='W51044/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
