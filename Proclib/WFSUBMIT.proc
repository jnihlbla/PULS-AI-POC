//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                   *         
//*      SERVICE PROCEDURE FOR SUBMITTING A JOB FROM                  *         
//*      A PDS JCL LIBRARY TO INTERNAL READER                         *         
//*                                                                   *         
//*      RESTART:      NORMAL                                         *         
//*                                            MAINTAINED BY 36000    *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//WFSUBMIT PROC JCLLIB=NULLFILE,SUBMIT=DUMMY,MAXRC=4                            
//SUBMIT   EXEC PGM=V16459,PARM='ICEGENER/4/',COND=(&MAXRC,LT)                  
//SYSPRINT  DD  SYSOUT=*                                                        
//SYSIN     DD  DUMMY                                                           
//SYSUT1    DD  DSN=&JCLLIB.(&SUBMIT),DISP=SHR                                  
//SYSUT2    DD  SYSOUT=(A,INTRDR)                                               
