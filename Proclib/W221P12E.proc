//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR AUTOMATISKA MAIL PÅ 220 LARM TILL LEVERANTÖREN --NDC--              
//*                                                                             
//*  FREKVENS:     DAG     RTN W221D7                                           
//*                                                                             
//*  ÅTERSTART:    W2212E      NORMAL                                           
//*                LÄSER        WDF1 WDB6 WDP3                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W221P12E PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W221..W221D7,                                             
//             INDUT=&W221..W221D7                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W221PD2E),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W2212D01(+0),DISP=SHR                                
//SORTOUT  DD  DSN=&&W2212D01,DISP=(NEW,PASS,DELETE),                           
//************ CN ARTIKLAR SORTERAT LEV-DC-ANSK, DC=7X, 4X, ...                 
//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W2212E   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W2212E,W2212E,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDF1     INCLUDE MEMBER=WDF1                                                  
//WDB6     INCLUDE MEMBER=WDB6                                                  
//WDP3     INCLUDE MEMBER=WDP3                                                  
//*                                                                             
//W2212ED1 DD  DSN=&&W2212D01,DISP=(OLD,DELETE,DELETE)                          
//************ DAGENS ARTIKLAR MED 220-LARM,SORTERADE DC                        
//*                                                                             
//W2212ED2 DD  DSN=&INDUT..W2212F(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ UPPDATERINGSPOSTER TILL W2212F00                                 
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
//W2212ED3 DD  DSN=&INDUT..W2212ER(+1),DISP=(NEW,CATLG,DELETE), -LIM(6)         
//************ FELLISTA PÅ LEVERANTÖRER UTAN MAILADRESS                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W2212ED4 DD  DSN=&INDUT..W2212E(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ ARTIKLAR MED 220-LARM FÖR SÄNDNING VIA MAIL                      
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
