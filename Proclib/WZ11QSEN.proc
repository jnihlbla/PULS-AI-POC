//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  MQFT FILE-TO-QUEUE (SEND FILE)                                             
//*                                                                             
//*  FREQUENCE:    N/A                                                          
//*                                                                             
//*  RESTART:      WZ1120    NORMAL                                             
//*                                                                             
//*  ARGUMENTS:    RTEGRP   - RUNTIME ENVIRONMENT (DEVE,IGRT ...)               
//*                           (DEFAULT VALUE FROM ENVXXXX INCLUDE)              
//*                                                                             
//*                ABSADDRS - ABSTRACT ADDRESS IN WZ01ATAB                      
//*                                                                             
//*                DSIN     - FILE TO BE SENT                                   
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ11QSEN PROC STPLIB=&INDRTE..LOAD,                                           
//             ABSADDRS=NO-ADDRESS,                                             
//             DSIN=NULLFILE                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ1120   EXEC PGM=WZ1120,PARM='&RTEGRP.&ABSADDRS'                             
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//WZ1120D1 DD  DSN=&&IPARM,DISP=(NEW,PASS,DELETE),                              
//************ PARAMTERS TO MQFT                                                
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//MQFT     EXEC PGM=MQFT,PARM='-F DD:IN -I DD:IPARM'                            
//SYSPRINT DD  SYSOUT=*                                                         
//IPARM    DD  DSN=&&IPARM,DISP=(OLD,DELETE,DELETE)                             
//************ PARAMTERS TO MQFT                                                
//*                                                                             
//IN       DD  DSN=&DSIN,DISP=SHR                                               
