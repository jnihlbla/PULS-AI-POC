//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                   *         
//*      KURANSGRUPPERING   INTERNAL GIT                              *         
//*                                                                   *         
//*      PERIODICITET:   MÅNADSSLUT    RTN W512M2                     *         
//*                                                                   *         
//*      ÅTERSTART:      W51276      NORMAL                           *         
//*                                                                   *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W512P076 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W512..W512M2,                                             
//             INDUT=&W512..W512M2                                              
//*                                                                             
//**********************************************************************        
//SORT01   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTDCAR),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51264(+0),DISP=SHR                                  
//************ PART INFO FILE                                                   
//*                                                                             
//SORTOUT  DD  DSN=&&W51264,DISP=(NEW,PASS,DELETE),                             
//************ W51264 SORTED ON IDDC AND IDARTNR                                
//             DATACLAS=PSEB                                                    
//*                                                                             
//**********************************************************************        
//SORT02   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTDCAR),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51266(+0),DISP=SHR                                  
//************ INTERNAL GIT INFO                                                
//*                                                                             
//SORTOUT  DD  DSN=&&W51266,DISP=(NEW,PASS,DELETE),                             
//************ W51266 SORTED ON IDDC AND IDARTNR                                
//             DATACLAS=PSEB                                                    
//*                                                                             
//**********************************************************************        
//SORT03   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W512PD93),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51296E(+0),DISP=SHR                                 
//************ VCCS RECORDS AND QTY AS PER DC                                   
//*                                                                             
//SORTOUT  DD  DSN=&&W51296E,DISP=(NEW,PASS,DELETE),                            
//************ W51296E SORTED ON IDDC AND IDARTNR                               
//             DATACLAS=PSEB                                                    
//*                                                                             
//**********************************************************************        
//W51276  EXEC PGM=W51276                                                       
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//V16247D3 DD  SYSOUT=*                                  (POSTSUM)              
//*                                                                             
//W51276D1 DD  DSN=&&W51264,DISP=(OLD,DELETE,DELETE)                            
//************ PART INFO FILE                                                   
//*                                                                             
//W51276D2 DD  DSN=&&W51266,DISP=(OLD,DELETE,DELETE)                            
//************ GIT-INFO-FILE                                                    
//*                                                                             
//W51276D3 DD  DSN=&&W51296E,DISP=(OLD,DELETE,DELETE)                           
//************ VCCS RECORD AND QTY AS PER DC                                    
//*                                                                             
//W51276D4 DD  DSN=&INDUT..W51276(+1),DISP=(NEW,CATLG,DELETE), -LIM(25)         
//*********** W51276-001 FILE                                                   
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W51276D5 DD  DSN=&INDUT..W51276A(+1),                        -LIM(25)         
//*********** W51276A-001 TOTAL DC FILE                                         
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
