//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKRIVER UTLISTA "LEADTIME ACCORDING TO GOAL"                               
//*                                                                             
//*  FREKVENS:     VECKA     RTN W612V3                                         
//*                                                                             
//*  ÅTERSTART:              NORMAL                                             
//*                W61274    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W612P074 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W612..W612V3,                                             
//             INDUT=&W612..W612V3.DC61,                                        
//             INDUT2=&W612..W612V3.DC62,                                       
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W612PD74),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W61264(+0),DISP=SHR                                  
//************ INLAGD GODS UNDER VECKAN                                         
//*                                                                             
//SORTOUT  DD  DSN=&&W61264,DISP=(NEW,PASS,DELETE),                             
//************ SORTERADE PÅ IDDC                                                
//         SPACE=(20,(1,1),RLSE),AVGREC=U                                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61274   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W61274,W61274,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR         -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//WDB6     INCLUDE MEMBER=WDB6                                                  
//W61274D1 DD  DSN=&&W61264,DISP=(OLD,DELETE,DELETE)                            
//************ SORTERADE PÅ IDDC                                                
//*                                                                             
//W61274D2 DD  SYSOUT=(A,,STD),DEST=&DEST1                                      
//************ W61274-001  LEADTIME ACCORDING TO GOAL                           
//W61274D3 DD  DSN=&INDUT..W61274(+1),DISP=(NEW,CATLG,DELETE),  -LIM(5)         
//****************LISTA SOM UTFIL TILL D&P                                      
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//W61274D4 DD  DSN=&INDUT2..W61274(+1),DISP=(NEW,CATLG,DELETE),  -LIM(5)        
//****************LISTA SOM UTFIL TILL D&P                                      
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
