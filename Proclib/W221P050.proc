//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  OMSPEC AV LEVERANSPLAN                                                     
//*                                                                             
//*  FREQUENCE:    WEEK      RTN W200V1                                         
//*                                                                             
//*  RESTART:      W22150      NORMAL                                           
//*                READS        WDK6 WDK7 WDK9 WDD9 WDL2 WDR2                   
//*                             WDF1 WDF3 WDB6 WDD3 WDD6 WDD7                   
//*                             WDG3 WDR5                                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W221P050 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W221..W200V1,                                             
//             INDUT=&W221..W200V1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W22150   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W22150,W22150,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR             -- DATKORT           
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR      -- DATKORT           
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDK7     INCLUDE MEMBER=WDK7                                                  
//WDK9     INCLUDE MEMBER=WDK9                                                  
//WDD9     INCLUDE MEMBER=WDD9                                                  
//WDL2     INCLUDE MEMBER=WDL2                                                  
//WDR2     INCLUDE MEMBER=WDR2                                                  
//WDF1     INCLUDE MEMBER=WDF1                                                  
//WDF3     INCLUDE MEMBER=WDF3                                                  
//WDB6     INCLUDE MEMBER=WDB6                                                  
//WDD3     INCLUDE MEMBER=WDD3                                                  
//WDD7     INCLUDE MEMBER=WDD7                                                  
//WDG3     INCLUDE MEMBER=WDG3                                                  
//*                                                                             
//W22150D1 DD  DSN=&INDIN..W22142(+0),DISP=SHR                                  
//************ BEGÄRAN OMSPEC/KONCEPT W221P040                                  
//*                                                                             
//W22150D2 DD  DSN=&INDUT..W22151(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ FRAMST. AV LEVPLAN.KONCEPT                                       
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W22150D3 DD  DSN=&INDUT..W22152(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ FRAMST. AV LEVPLAN.STATISTIK                                     
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
//W22150D4 DD  DSN=&INDUT..W22154(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ FRAMST. AV AUT GODK (KONCEPT) LEVPLAN                            
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
//*                                                                             
//W22150D5 DD  DSN=&INDUT..W22159(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ FRAMST. AV LEVPLAN.FÖRSLAG FÖR UPPD AV WDD6                      
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W22150D6 DD  DSN=&INDUT..W2215A(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ UPPDATERINGSPOSTER TILL BMP W2215A00                             
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
