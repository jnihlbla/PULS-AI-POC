//*  LÄSER FILER MED DAGENS SAPBOKNINGAR OCH SKAPAR EN FIL FÖR                  
//*  MÅNADS-AVSTÄMNING                                                          
//*                                                                             
//*  FREKVENS:     DAG    RTN W561D3                                            
//*                                                                             
//*  ÅTERSTART:    W56174    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W510P074 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W561..W561D3,                                             
//             INDIN2=&W011,                                                    
//             INDUT=&W561..W561D3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56174   EXEC PGM=V16459,PARM='W56174/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),DEST=LOCAL,HOLD=YES                             
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W56174D1 DD  DSN=&INDIN..W56170(+0),DISP=SHR                                  
//************ DAGENS PEDALPOSTER FÖR AVSTÄMNING                                
//*                                                                             
//TPFIL1   DD  DSN=&&TPFIL1,DISP=(NEW,PASS,DELETE),                             
//************ SORTERADE AVSTÄMNINGSPOSTER                                      
//             DATACLAS=PSEN                                                    
//*                                                                             
//W56174D2 DD  DSN=&INDIN2..W01172(+0),DISP=SHR                                 
//************ LAGERBAND                                                        
//*                                                                             
//W56174D3 DD  DSN=&INDUT..W56176(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ PCFILEN                                                          
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
