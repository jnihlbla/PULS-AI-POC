//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES FILE CONTAINING PART AND SDC INFORMATION, ADDS BINNING             
//*  DATE FROM W61271 FILE                                                      
//*                                                                             
//*  FREQUENCE:    DAILY     RTN WXTRD2                                         
//*                                                                             
//*  RESTART:      WXTR9T    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTRP09T PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WXTR..WXTRD2,                                             
//             INDUT=&WXTR..WXTRD2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTR9T   EXEC PGM=V16459,PARM='WXTR9T/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//WXTR9TD1 DD  DSN=&INDIN..WXTR9SA(+0),DISP=SHR                                 
//************ SDC INFORMATION                                                  
//*                                                                             
//WXTR9TD2 DD  DSN=&INDIN..W61271A(0),DISP=SHR                                  
//************ WDL6 INFO - BINNING DATE                                         
//*                                                                             
//TPFIL1   DD  DSN=&&TPFIL1,DISP=(NEW,DELETE,DELETE),                           
//************ WDL6 INFO - BINNING DATE                                         
//             DATACLAS=PSEB                                                    
//*                                                                             
//WXTR9TD3 DD  DSN=&INDUT..WXTR9S(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ SDC INFORMATION                                                  
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=DEL2                                                    
//*                                                                             
