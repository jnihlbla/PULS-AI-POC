//WDMRP018 PROC STPLIB=&INDRTE..LOAD,                                           
//             PARMS=JJJJ,                                                      
//             INDIN=&WDMR..WDMRV1,                                             
//             INDUT=&WDMR..WDMRV1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WDMR18   EXEC PGM=WDMR18,PARM='&PARMS'                                        
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDMR18D1 DD  DSN=&INDIN..WDMR11(+0),DISP=SHR                                  
//************ PROCEDURER                                                       
//*                                                                             
//WDMR18D2 DD  DSN=&INDIN..WDMR12(+0),DISP=SHR                                  
//************ JOB-STEP                                                         
//*                                                                             
//WDMR18D3 DD  DSN=&INDIN..WDMR13(+0),DISP=SHR                                  
//************ PROGRAM                                                          
//*                                                                             
//WDMR18D4 DD  DSN=&INDIN..WDMR14(+0),DISP=SHR                                  
//************ DATASET                                                          
//*                                                                             
//WDMR18D5 DD  DSN=&INDUT..WDMR1F(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ PROCEDURER TILL DATA MANAGER                                     
//             MGMTCLAS=DEL2,                                                   
//             SPACE=(80,(23000,1000),RLSE),AVGREC=U                            
//*                                                                             
//WDMR18D6 DD  DSN=&INDUT..WDMR1G(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ JOB-STEP TILL DATA MANAGER                                       
//             MGMTCLAS=DEL2,                                                   
//             SPACE=(80,(1600,500),RLSE),AVGREC=U                              
//*                                                                             
//WDMR18D7 DD  DSN=&INDUT..WDMR1H(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ PROGRAM TILL DATA MANAGER                                        
//             MGMTCLAS=DEL2,                                                   
//             SPACE=(80,(43000,2000),RLSE),AVGREC=U                            
//*                                                                             
//WDMR18D8 DD  DSN=&INDUT..WDMR1I(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ DATASET TILL DATA MANAGER                                        
//             MGMTCLAS=DEL2,                                                   
//             SPACE=(80,(47000,2000),RLSE),AVGREC=U                            
//*                                                                             
