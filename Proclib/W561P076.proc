//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES RECEIVING GOODS BY LPC REPORT                                      
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W561D3                                         
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                W56176    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W561P076 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W561..W561D3,                                             
//             INDUT=&W561..W561D3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W561PD76),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W56175A(+0),DISP=SHR                                 
//************ SORTS W56175A WITH INVOICE NUMBER AND LPC                        
//*                                                                             
//SORTOUT  DD  DSN=&&W56175A,DISP=(NEW,PASS,DELETE),                            
//************ SORTED W56175A RECEIVING GOODS BY LPC FILE                       
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56176   EXEC PGM=V16459,PARM='W56176/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//W56176D1 DD  DSN=&&W56175A,DISP=(OLD,DELETE,DELETE)                           
//************ SORTED W56175A RECEIVING GOODS BY LPC FILE                       
//*                                                                             
//W56176D2 DD  DSN=&INDUT..W56176A(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ RECEIVING GOODS BY LPC REPORT                                    
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
