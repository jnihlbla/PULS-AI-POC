//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SELEKTERAR FÄRDIGA ORDER SOM SKALL RENSAS FRÅN REG.                        
//*                                                                             
//*  FREKVENS:     VECKA    RTN W479V3                                          
//*                                                                             
//*  ÅTERSTART:    W47910                                                       
//*                LÄSER  WDE4-FIL WDE6 WDQ2 WDQ3                               
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W479P010 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W479..W479V3,                                             
//             INDUT=&W479..W479V3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47910   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W47910,W47910,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDRTE.DYN.LOAD,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM16),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//W47910D1 DD  DSN=&INDIN..W47909(+0),DISP=SHR                                  
//************ E401+E411 POSTER SORTERAT PER PRODNR+SEGMNR                      
//*                                                                             
//W47910D2 DD  DSN=&INDUT..W47910(+1),DISP=(NEW,PASS,DELETE),   -LIM(1)         
//************ E4 RENSNINGSPOSTER                                               
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W47910D3 DD  DSN=&INDUT..W47912(+1),DISP=(NEW,PASS,DELETE),                   
//************ E6 RENSNINGSPOSTER                                               
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//W47910D5 DD  DSN=&&W479A5,DISP=(NEW,PASS,DELETE),                             
//************ A5 RENSNINGSPOSTER                                               
//             DATACLAS=PSEN,MGMTCLAS=&DEL2BKPC                                 
//*                                                                             
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                   -- DISPLAY            
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W479PD10),DISP=SHR                         
//SORTIN   DD  DSN=&&W479A5,DISP=(OLD,DELETE,DELETE)                            
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W479A5(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ SORTERADE A5 RENSNINGSPOSTER UTAN DUBLETTER                      
//             DATACLAS=PSEN,MGMTCLAS=&NOBACKUP                                 
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* KATALOGISERING LAGD I SISTA STEGET:                                         
//W47910D2 DD  DSN=&INDUT..W47910(+1),DISP=(OLD,CATLG,DELETE)                   
//W47910D3 DD  DSN=&INDUT..W47912(+1),DISP=(OLD,CATLG,DELETE)                   
