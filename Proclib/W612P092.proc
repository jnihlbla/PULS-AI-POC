//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LIST (FREE) LOCATIONS                                                      
//*                                                                             
//*  FREQUENCE:    ORDERED     RTN W612M1                                       
//*                                                                             
//*  RESTART:      W61292    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W612P092 PROC STPLIB=&INDRTE..LOAD,                                           
//             DEST1=&CPRINT,                                                   
//             INDIN=&W011,                                                     
//             INDIN2=&W488..W488S3,                                            
//             INDIN3=&W612..W612M1                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61292   EXEC PGM=V16459,PARM='W61292/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),DEST=LOCAL,HOLD=YES                             
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//A4LF  OUTPUT FORMDEF=SLSR6C,PAGEDEF=SLSR6C                                    
//************ A4 LANDSCAPE, SINGLE SIDE, RASTER  (FOLDED PAPER)                
//W61292D1 DD  DSN=&INDIN..NDC.W01184(+0),DISP=SHR                              
//************ PART FILE NDC WITH PRIME LOCATION                                
//*                                                                             
//W61292D2 DD DSN=&INDIN2..W48881(+0),DISP=SHR                                  
//************ PART FILE NDC WITH BUFFER LOCATION                               
//*                                                                             
//W61292D3 DD  DSN=&&W61292,DISP=(NEW,PASS,DELETE),                             
//************ MERGE FILE                                                       
//         SPACE=(20,(100,133),RLSE),AVGREC=K                                   
//*                                                                             
//W61292D4 DD  DSN=&INDIN3..W61290(+0),DISP=SHR                                 
//************ LOCATION FILE                                                    
//*                                                                             
//W61292D5 DD  SYSOUT=(A,,STD),DEST=&DEST1,OUTPUT=(*.A4LF)                      
//************ W61292R1  LIST LOCATION RUTHERFORD                               
//*                                                                             
//W61292D7 DD  SYSOUT=(A,,STD),DEST=&DEST1,OUTPUT=(*.A4LF)                      
//************ W61292R3  LIST LOCATION LOS ANGELES                              
//*                                                                             
//W61292D8 DD  SYSOUT=(A,,STD),DEST=&DEST1,OUTPUT=(*.A4LF)                      
//************ W61292R4  LIST LOCATION CANADA                                   
//*                                                                             
//W61292D9 DD  SYSOUT=(A,,STD),DEST=&DEST1,OUTPUT=(*.A4LF)                      
//************ W61292R4  LIST LOCATION JAPAN                                    
//*                                                                             
//W61292DA DD  SYSOUT=(A,,STD),DEST=&DEST1,OUTPUT=(*.A4LF)                      
//************ W61292R4  LIST LOCATION AUSTRALIEN                               
//*                                                                             
