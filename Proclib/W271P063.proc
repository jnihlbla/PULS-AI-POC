//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W271PD63),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W27162(+0),DISP=SHR                                  
//************ RESTORDERPOSTER                                                  
//*                                                                             
//SORTOUT  DD  DSN=&&W27162,DISP=(NEW,PASS,DELETE),                             
