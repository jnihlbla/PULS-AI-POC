//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SOP - TA HAND OM DATA FRÅN SUBMITPAKETET                                   
//*        OCH GÖR EN BESTÄLLNING I SOP                                         
//*                                                                             
//*  FREKVENS:     KÖRS VIA SUBMITPAKETET                                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WSOPGEN  PROC DSOUT=NULLFILE,                                                 
//             STPLIB=&INDRTE..LOAD,                                            
//             PROCESS=DUMMY,DATE=000000,                                       
//             SOPREG=&INDRTE..SOP,                                             
//             PDSLIB=&INDRTE..JCL,                                             
//             PDSTEMP=&INDRTE.TMP.JCL                                          
//*                                                                             
//GENER   EXEC PGM=V16459,                                                      
//             PARM='ICEGENER/3/'                                               
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DDNAME=INPUT                                                     
//*                                                                             
//SYSUT2   DD  DSN=&DSOUT,DISP=(NEW,CATLG,DELETE),                              
//************ DATA FRÅN SUBMITPAKETET                                          
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=6160),                            
//             MGMTCLAS=&BACKUPC,SPACE=(6160,(10,15),RLSE)                      
//*                                                                             
//W98022  EXEC PGM=W98022,                                                      
//             PARM='ORDER &PROCESS ON &DATE/'                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//SYSUDUMP DD  SYSOUT=*                                     -- ABEND            
//W98022D1 DD  DUMMY                                                            
//SOPDD1   DD  DSN=&SOPREG,DISP=SHR            -- SOP DATA BASE                 
//PDSDD1   DD  DSN=&PDSTEMP,DISP=SHR           -- TEMP PDS JOB LIB              
//PDSDD2   DD  DSN=&PDSLIB,DISP=SHR            -- PDS JOB LIB                   
