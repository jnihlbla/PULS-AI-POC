//*                                                                             
//*  SUGA UT INFORMATION UR PROCLIB FÖR ATT UPPDATERA DATA MANAGER              
//*                                                                             
//*  FREKVENS:     BESTÄLLNING  RTN WDMRV1                                      
//*                                                                             
//*  ÅTERSTART:    WDMR02    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WDMRP002 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WDMR..WDMRV1,                                             
//             INDUT=&WDMR..WDMRV1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WDMR02   EXEC PGM=WDMR02                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//WDMR02D1 DD  DSN=&INDIN..WDMR01(+0),DISP=SHR                                  
//************ INFIL MED MEDLEMMAR FRÅN PROCLIB                                 
//*                                                                             
//WDMR02D2 DD  DSN=&INDUT..WDMR02(+1),DISP=(NEW,CATLG,DELETE), -LIM(01)         
//************ UTFIL FÖR VIDARE BEARBETNING                                     
//             MGMTCLAS=DEL2,                                                   
//             SPACE=(120,(25000,2000),RLSE),AVGREC=U                           
//*                                                                             
//WDMR02D3 DD  DSN=&INDUT..WDMR03(+1),DISP=(NEW,CATLG,DELETE), -LIM(01)         
//************ UTFIL FÖR DD-KORT MED SYSOUT                                     
//             MGMTCLAS=&BACKUPC,                                               
//             SPACE=(12,(8000,1000),RLSE),AVGREC=U                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
