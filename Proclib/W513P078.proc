//************ LISTA W51378-024 KVITTENS AV PRM-SDC24 FRÅN BILD 5305            
//*                                                                             
//W51378D6 DD  SYSOUT=(A,,STD),DEST=&DEST5                                      
//************ LISTA W51378-025 KVITTENS AV PRM-SDC25 FRÅN BILD 5305            
//*                                                                             
//W51378D7 DD  SYSOUT=(A,,STD),DEST=&DEST6                                      
//************ LISTA W51378-026 KVITTENS AV PRM-SDC26 FRÅN BILD 5305            
//*                                                                             
//W51378D8 DD  SYSOUT=(A,,F001),DEST=&DEST7                                     
//************ LIST  W51378-091 FOR EXCHANGE TERMINAL (DC 91)   5305            
