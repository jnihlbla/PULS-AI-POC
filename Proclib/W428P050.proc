//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  TO EXECUTE PGM W42850                                                      
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W428V1                                         
//*                                                                             
//*  RESTART:      W42850    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W428P050 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W418..W418D2,                                             
//             INDUT=&W428..W428V1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W42850   EXEC PGM=V16459,PARM='W42850/1/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR         -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//W42850D1 DD  DSN=&INDIN..W41842(+0),DISP=SHR                                  
//************ INPUT FILE FROM WDA2 DB                                          
//*                                                                             
//W42850D2 DD  DSN=&INDUT..W42850(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ O/P FILE FOR ALL THE BINNED LINES FOR LAST WEEK                  
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W42850D3 DD  DSN=&INDUT..W42851(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ O/P FILE FOR ALL NON TREATED LINES TILL NOW                      
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
