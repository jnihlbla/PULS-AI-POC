//WB1103   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,WB1103,WB1103,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
