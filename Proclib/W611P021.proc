//W611P021 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W611..W611D1,                                             
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61121   EXEC PGM=V16459,PARM='W61121/8/'                                     
//STDCP    OUTPUT DEST=&DEST1,FORMDEF=SLSR6C,PAGEDEF=SLSR6C                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W61121D1 DD  DSN=&INDIN..W61120(+0),DISP=SHR                                  
//************ AVISERINGAR                                                      
//*                                                                             
//W61121D2 DD  SYSOUT=(A,,3803),OUTPUT=*.STDCP                                  
//************ W61121-001  GAMLA INLEVERANS-AVISERINGAR                         
//*                                                                             
//W61121D3 DD  SYSOUT=(A,,3803),OUTPUT=*.STDCP                                  
//************ W61121-002  GAMLA REREFILL-AVISERINGAR (F2R)                     
