//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W612P059 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=1,                                                           
//             INDIN=&W612..W612V8,                                             
//             INDUT=&WXTR..W612V8                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W612PD49),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W61249,DISP=SHR                                      
//************ LISTFIL                                                          
//*                                                                             
//SORTOUT  DD  DSN=&&W61249,DISP=(NEW,PASS,DELETE),                             
//************ SORTERAD W61249                                                  
//         SPACE=(63,(1,3),RLSE),AVGREC=K                                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61259   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W61259,W61259,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*61259D1 DD  DSN=&&W61249,DISP=(OLD,DELETE,DELETE)                            
//W61259D1 DD  DSN=&&W61249,DISP=SHR                                            
//************ SORTERAD W61249                                                  
//*                                                                             
//GENER    EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&&W61249,DISP=(OLD,DELETE,DELETE)                            
//************  SORTERAD W61249                                                 
//*                                                                             
//SYSUT2   DD  DSN=&INDUT..REFAVV(+1),                                          
//             DISP=(NEW,CATLG,DELETE), -LIM(104)                               
//************  UTFIL FÖR EPLUS-UPPFÖLJNING                                     
//             SPACE=(27998,(100,133),RLSE),AVGREC=U,                           
//             MGMTCLAS=&NOBACKUP                                               
