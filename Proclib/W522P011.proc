//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES INTRASTAT-FILE TO DIFFERENT COUNTRIES                              
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W522M1                                       
//*                                                                             
//*  RESTART:      W52211      NORMAL  (BMP)                                    
//*                                                                             
//*  READS:        WDG2                                                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W522P011 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=1,                                                           
//             INDIN=&W522..W522M1,                                             
//             INDUT=&W522..W522M1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W52211   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W52211,W52211,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//*                                                                             
//W52211D1 DD  DSN=&INDIN..W52201(+0),DISP=SHR                                  
//************ INFIL                                                            
//*                                                                             
//W52211D2 DD  DSN=&INDUT..W52213(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED INTRASTATINFO TILL ON-DEMAND                           
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W52211D3 DD  DSN=&INDUT..W52215(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED INTRASTATINFO SOM SKALL SPARAS                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W52211D4 DD  DSN=&INDUT..W52216(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED INTRASTATINFO SOM SKALL SPARAS                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W522S1  EXEC PGM=SORT                                                         
//SORTIN   DD  DSN=&INDUT..W52216(+1),DISP=SHR                                  
//*                                                                             
//***********SPLIT THE FILES FOR INTRASTAT                                      
//SORTOF1  DD  DSN=&INDUT..W52216A(+1),DISP=(NEW,CATLG,DELETE),                 
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//SORTOF2  DD  DSN=&INDUT..W52216B(+1),DISP=(NEW,CATLG,DELETE),                 
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//SORTOF3  DD  DSN=&INDUT..W52216D(+1),DISP=(NEW,CATLG,DELETE),                 
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W522PD16),DISP=SHR                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
