//*  LÄSER FILER MED DAGENS SAPBOKNINGAR OCH SKAPAR EN FIL FÖR                  
//*  MÅNADS-AVSTÄMNING I PROCEDUR W510P075                                      
//*                                                                             
//*  FREKVENS:     DAG    RTN W510D4                                            
//*                                                                             
//*  ÅTERSTART:    W51072    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W510P072 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W510..W510D4,                                             
//             INDIN2=&W011,                                                    
//             INDUT=&W510..W510D4                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51072   EXEC PGM=V16459,PARM='W51072/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),DEST=LOCAL,HOLD=YES                             
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W51072D1 DD  DSN=&INDIN..W51068(+0),DISP=SHR                                  
//************ DAGENS PEDALPOSTER FÖR AVSTÄMNING                                
//         DD  DSN=&INDIN..W5106D(+0),DISP=SHR                                  
//         DD  DSN=&INDIN..W51081(+0),DISP=SHR                                  
//*                                                                             
//TPFIL1   DD  DSN=&&TPFIL1,DISP=(NEW,PASS,DELETE),                             
//************ SORTERADE AVSTÄMNINGSPOSTER                                      
//             DATACLAS=PSEN                                                    
//*                                                                             
//W51072D2 DD  DSN=&INDIN2..W01172(+0),DISP=SHR                                 
//************ LAGERBAND                                                        
//*                                                                             
//W51072D3 DD  DSN=&INDUT..W51076(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ PCFILEN                                                          
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
