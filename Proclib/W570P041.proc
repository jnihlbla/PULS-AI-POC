//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR FIL MED BACKNINGSTRANSAR FÖR MÅNADSSKIFTET                          
//*                                                                             
//*  FREKVENS:     MÅNAD    RTN W570M2                                          
//*                                                                             
//*  ÅTERSTART:    W57041    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W570P041 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W570..W570M2,                                            
//             INDIN2=&W570..W570D3,                                            
//             INDUT=&W570..W570M2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W57041   EXEC PGM=V16459,PARM='W57041/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(8192,(2000,2000))                                         
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DUMMY                                                            
//W57041D1 DD  DSN=&INDIN1..W57040(+0),DISP=SHR                                 
//************ ALLA SALDOÄNDRINGAR EFTER MIDNATT                                
//*                                                                             
//W57041D2 DD  DSN=&INDIN2..W5706N(+0),DISP=SHR                                 
//************ ALLA BOKFÖRINGSTRANSAR SOM BOKAS NÄSTA NATT                      
//*                                                                             
//TPFIL1   DD  DSN=&&TEMP,DISP=(NEW,DELETE,DELETE),                             
//************ SORTERAD SALDO-ÄNDRINGSFIL                                       
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL2   DD  DSN=&&TEMP,DISP=(NEW,DELETE,DELETE),                             
//************ SORTERAD BOKNINGS-FIL                                            
//             DATACLAS=PSEN                                                    
//*                                                                             
//W57041D3 DD  DSN=&INDUT..W57041(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//************ SALDOFIL, MED AKTUELLA BACKNINGSPOSTER                           
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
