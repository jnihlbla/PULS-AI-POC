//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W613P014 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W613..W613V2,                                             
//             INDUT=&W613..W613V2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61314   EXEC PGM=V16459,PARM='W61314/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W61314D1 DD  DSN=&INDIN..W61313(+0),DISP=SHR                                  
//************ FÖRPACKNINGSINFO FRÅN DB.                                        
//*                                                                             
//W61314D2 DD  DSN=&INDIN..W61312(+0),DISP=SHR                                  
//************ VECKANS INLEVERANSER                                             
//*                                                                             
//W61314D3 DD  DSN=&INDUT..W61314(+1),DISP=(NEW,CATLG,DELETE), -LIM(5)          
//************ VECKANS SVS-FÖRPACKNINGAR PER TYP AV FÖRPACKNING.                
//************ SPARAS TILL PERIODREDOVISNING                                    
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
//*                                                                             
//W61314D4 DD  DSN=&&TEMPFIL,DISP=(NEW,PASS,DELETE),                            
//             DATACLAS=PSEN                                                    
//*                                                                             
//W61314D5 DD  DSN=&INDUT..W61315(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ VECKANS SVS-FÖRPACKNINGAR PER TYP AV FÖRPACKNING.                
//************ SKICKAS SOM LISTA.                                               
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
