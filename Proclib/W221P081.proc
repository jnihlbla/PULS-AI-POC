//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W221P081 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=3,                                                           
//             INDIN=&W221..W221D5,                                             
//             INDUT=&W221..W221D5                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W22181   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W22181,W22181,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(0),DISP=SHR                -- DATKORT         
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR        -- DATKORT         
//DATUT    DD  SYSOUT=*                                      -- DATKORT         
//V16247D3 DD  SYSOUT=*                                      -- POSTSUM         
//W22181D1 DD  DSN=&INDIN..W22100(+0),DISP=SHR                                  
//************ PARAMETER  DAG/PERIOD                                            
//W22181D2 DD  DSN=&INDUT..W22181(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ TILL ODETTE                                                      
//             SPACE=(12,(1,16),RLSE),AVGREC=K,                                 
//             MGMTCLAS=&BACKUPC                                                
//W22181D3 DD  DSN=&INDUT..W22182(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ DELETE WDGX2218                                                  
//             SPACE=(10,(1,3),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&BACKUPC                                                
//W22181D4 DD  DSN=&INDUT..W22184(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ REPL   WDGX2216                                                  
//             SPACE=(13,(1,3),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&BACKUPC                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
