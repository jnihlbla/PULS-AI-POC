//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATE SYMBOLIC PARAMETERS FOR NEXT JOB AND ORDER IT IN SOP.               
//*  THE PARAMETERS ARE THE YEAR(S) AND DATES FOR THE DAYS OF                   
//*  THE PREVIOUS WEEK (OR SPECIFIED WEEK - YYWW)                               
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W970V2                                         
//*                                                                             
//*  RESTART:      W97040    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W970P040 PROC STPLIB=&INDRTE..LOAD,                                           
//             YYWW=,                                                           
//             ORDER=W970V2BL,                                                  
//             SOPREG=&INDRTE..SOP,                                             
//             PDSLIB=&INDRTE..JCL,                                             
//             PDSTEMP=&INDRTE.TMP.JCL                                          
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W97040   EXEC PGM=W97040,PARM='&YYWW'                                         
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W97040D1 DD  DSN=&&W97040,DISP=(NEW,PASS,DELETE),                             
//************ SYMBOLIC PARMS FOR SOP STEP BELOW                                
//             DATACLAS=PSEN                                                    
//*                                                                             
//ORDER   EXEC PGM=W98022,PARM='SYSIN/'                                         
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//SYSUDUMP DD  SYSOUT=(D,,DUMP)                             -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//W98022D1 DD  DSN=&INDRTE..CONSTANT(&ORDER),DISP=SHR                           
//         DD  DSN=&&W97040,DISP=(OLD,DELETE)                                   
//         DD  DSN=&INDRTE..CONSTANT(W970ENDO),DISP=SHR                         
//SOPDD1   DD  DSN=&SOPREG,DISP=SHR            -- SOP DATA BASE                 
//PDSDD1   DD  DSN=&PDSTEMP,DISP=SHR           -- TEMP PDS JOB LIB              
//PDSDD2   DD  DSN=&PDSLIB,DISP=SHR            -- PDS JOB LIB                   
