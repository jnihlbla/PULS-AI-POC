//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W612P01B PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=1,                                                           
//             INDIN=&W612..W612V8                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W612PD1D),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W6121C(0),DISP=SHR                                   
//************ LISTFIL                                                          
//*                                                                             
//SORTOUT  DD  DSN=&&W6121C,DISP=(NEW,PASS,DELETE),                             
//************ SORTERAD W6121C                                                  
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W6121B   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W6121B,W6121B,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W6121BD1 DD  DSN=&&W6121C,DISP=(OLD,DELETE,DELETE)                            
//************ SORTERAD W6121C                                                  
//*                                                                             
