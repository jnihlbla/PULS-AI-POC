//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  RECEIVE FILE FROM MQ                                                       
//*                                                                             
//*  FREQUENCE:   N/A                                                           
//*                                                                             
//*  RESTART:     WZ1113    NORMAL                                              
//*                                                                             
//*  SYSIN    :   MANDATORY PROPERTIES                                          
//*                 ¤ADDISPABS - KEY TO FETCH REQUIRED PARAMETERS               
//*                   EX: ¤ADDISPABS CARPARTS.PULS.MQRECEIVE                    
//*                                                                             
//*                 ¤DSOUT     - OUTPUT FILE NAME                               
//*                              POSSIBLE TO SPECIFY A VARIABLE                 
//*                              THAT WILL BE REPLACED BY THE                   
//*                              VALUE OF THE MQ HEADER MATCHING                
//*                              VARIABLE GIVEN.                                
//*                   EX: ¤DSOUT ¤DSOUT W.IGRT.TESTFIL                          
//*                       ¤DSOUT ¤DSOUT W.IGRT.TESTFL*Market*                   
//*                                                                             
//*                 ¤RECFM     - OUTPUT FILE RECORD FORMAT (VB/FB)              
//*                                                                             
//*                 ¤LRECL     - OUTPUT FILE RECORD LENGTH (MAX 3000)           
//*                                                                             
//*               PASS ADDITIONAL DATA AS REQUIRED. TWO TYPES OF                
//*               PARAMETERS ARE ACCEPTED - ¤RECKEY AND ¤SOPSYM                 
//*                                                                             
//*               ¤RECKEY   - USED TO SPECIFY THE MQ HEADER/PROPERTY            
//*                           NAME WHOSE VALUE SHOULD BE ADDED TO               
//*                           START OF EVERY RECORD. SHOULD ALSO SPECIFY        
//*                           THE LENGTH.                                       
//*                                                                             
//*                           FORMAT:                                           
//*                           ¤RECKEY <MQ_HDR_NAME>;<MQ_HDR_VALUE_LEN>          
//*                                                                             
//*                           FOR EXAMPLE:                                      
//*                           RECEIVED FILE CONTENT IS AS BELOW..               
//*                           0001ABCD                                          
//*                           0002EFGH                                          
//*                           WITH MQ HEADER Market=SE                          
//*                                                                             
//*                           SYSIN HAS BELOW:                                  
//*                           ¤RECKEY Market;2  (Case sensitive!)               
//*                                                                             
//*                           OUTPUT FILE CONTENT WILL BE AS BELOW..            
//*                           SE0001ABCD                                        
//*                           SE0002EFGH                                        
//*                                                                             
//*               ¤SOPSYM   - USED TO SPECIFY THE MQ HEADER/PROPERTY            
//*                           NAME WHOSE VALUE SHOULD BE USED TO CREATE         
//*                           SYMBOLIC PARM FOR SOP ORDER                       
//*                                                                             
//*                           FORMAT:                                           
//*                           ¤SOPSYM <MQ_HDR_NAME>;<SOP_SYMBOL_KEY>            
//*                                                                             
//*                           EXAMPLE:                                          
//*                           ¤SOPSYM Market;MARKET                             
//*                                                                             
//*                           SOP SYMBOLS WILL THEN BE WRITTEN TO               
//*                           &&SOPPARM DATASET IN THE FORMAT                   
//*                           <SOP_SYMBOL_KEY>(<MQ_HDR_VALUE>)                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ11P013 PROC STPLIB=&INDRTE..LOAD                                            
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ1113   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,WZ1113,WZ1113,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//WDR5     INCLUDE MEMBER=WDR5                                                  
//SYSIN    DD  DUMMY                                                            
//SOPSYM   DD  DSN=&&SOPSYM,DISP=(NEW,PASS,DELETE),DATACLAS=PSEN                
//*                                                                             
