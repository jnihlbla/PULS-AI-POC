//W111P092 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W910,                                                    
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11192   EXEC PGM=V16459,PARM='W11192/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//*                                                                             
//W11192D1 DD  DSN=&INDIN1..W91042(+0),DISP=SHR                                 
//************ DAGLIGT LAGERBAND                                                
//*                                                                             
//A4LF OUTPUT FORMDEF=SLS06C,PAGEDEF=SLS06C                                     
//*                                                                             
//W11192D2 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=*.A4LF                       
//************ W11192-001  PER ARTIKELNR                                        
//*                                                                             
//W11192D3 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=*.A4LF                       
//************ W11192-002  PER LEVNR                                            
