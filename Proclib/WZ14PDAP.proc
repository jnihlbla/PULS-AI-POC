//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  GENERAL PROCEDURE TO SEND A FILE VIA THE WZ01 DISPATCHER                   
//*  TO DISTRIBUTION & PRINT                                                    
//*                                                                             
//*  PARAMETERS:                                                                
//*                                                                             
//*   CONTROL= MEMBER/FILE CONTAINING THE D&P "ADDRESS", 1-3 LINES:             
//*            LINE1: REPORT TYPE (OUTPUT TYPE) - MUST BE SPECIFIED             
//*            LINE2: SUB TYPE (OUTPUT RECEIVER) - OPTIONAL, DFLT=SPACE         
//*            LINE3: LIST ID - OPTIONAL, DEFAULT IS YYMMDDHHMMSS               
//*                                                                             
//*   DSIN=    FILE CONTAINING THE REPORT DATA                                  
//*                                                                             
//*  FREQUENCE:    ?                                                            
//*                                                                             
//*  RESTART:      WZ1410    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ14PDAP PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=1,PSB=WZ1410,                                                
//             CONTROL=MISSING,DSIN=NULLFILE                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ1410   EXEC PGM=DFSRRC00,                                                   
//             PARM=('BMP,WZ1410,&PSB,,,N00,,,,,&CPU,,,&IMS')                   
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//WZ1410D1 DD  DSN=&DSIN,DISP=SHR,LRECL=3004                                    
//************                                                                  
//*                                                                             
//WZ1410D2 DD  DDNAME=SYSIN                                                     
//SYSIN    DD  DSN=&INDRTE..CONSTANT(&CONTROL),DISP=SHR                         
//************ CONTROL DATA                                                     
//*                                                                             
