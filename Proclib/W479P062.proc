//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W479P062 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W479..W479V2,                                             
//             INDUT=&W479..W479V2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47962   EXEC PGM=V16459,PARM='W47962/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(1000,500))                                          
//SORTMSG  DD  SYSOUT=*                                                         
//*                                                                             
//W47962D1 DD  DSN=&INDIN..W47951(+0),DISP=SHR                                  
//************ ORDER-REGISTRERINGS-DATUM FÖR ALLA KUNDORDER                     
//*                                                                             
//W47962D2 DD  DSN=&INDIN..W47961(+0),DISP=SHR                                  
//************ KOLLIN SOM BLIVIT HELT KLARA UNDER VECKAN                        
//*                                                                             
//W47962D3 DD  DSN=&&W47951,DISP=(NEW,PASS,DELETE),                             
//************ TEMPFIL-1 SORTAD W47962D1                                        
//             DATACLAS=PSEN,MGMTCLAS=&NOBACKUP                                 
//*                                                                             
//W47962D4 DD  DSN=&&W47961,DISP=(NEW,PASS,DELETE),                             
//************ TEMPFIL-2 SORTAD W47962D2                                        
//             DATACLAS=PSEN,MGMTCLAS=&NOBACKUP                                 
//*                                                                             
//W47962D5 DD  DSN=&&W47962,DISP=(NEW,PASS,DELETE),                             
//************ TEMPFIL-3 MATCHAD W47962D3 OCH W47962D4                          
//             DATACLAS=PSEN,MGMTCLAS=&NOBACKUP                                 
//*                                                                             
//W47962D6 DD  DSN=&INDUT..W47962(+1),DISP=(NEW,CATLG,DELETE), -LIM(02)         
//************ SORTAD W47962D5                                                  
//*            KOLLIN SOM BLIVIT HELT KLARA UNDER VECKAN                        
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
