//*                                                                             
//*  SKAPAR LISTOR ÅRSINVENTARIUM FÖR USA (LISTOR PÅ FIL)                       
//*                                                                             
//*  FREKVENS:     ÅRSRUTIN  RTN W560Y4                                         
//*                                                                             
//*  ÅTERSTART:    W56076    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W560P076 PROC INDIN=&W560..W560Y4,                                            
//             INDIN1=&W011..&RTEGRP.,                                          
//             INDIN2=&W560,                                                    
//             INDUT=&W560..W560Y4,                                             
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56076   EXEC PGM=V16459,PARM='W56076/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(8192,(10000,4000))                                        
//SORTMSG  DD  SYSOUT=*                                                         
//*                                                                             
//W56076D1 DD  DSN=&INDIN..W56074(+0),DISP=SHR                                  
//************ EXTRAKTFIL MED ARTIKELINFO FRÅN WDK6                             
//*                                                                             
//TPFIL01  DD  DSN=&&TEMP1,DISP=(NEW,DELETE,DELETE),                            
//************ TEMPORÄR EXTRAKTFIL SORTERAD                                     
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL02  DD  DSN=&&TEMP2,DISP=(NEW,DELETE,DELETE),                            
//************ TEMPORÄR EXTRAKTFIL SORTERAD                                     
//             DATACLAS=PSEN                                                    
//*                                                                             
//W56076D2 DD  DSN=&INDIN1..W01174(+0),DISP=SHR                                 
//************ EXTRAKT FRÅN WDD311 (BENÄMNINGAR)                                
//*                                                                             
//W56076D3 DD  DSN=&INDIN2..W56099(+0),DISP=SHR                                 
//************ FUNKTIONSGRUPPSBENÄMNINGAR                                       
//*                                                                             
//W56076D4 DD  DSN=&&TEMP6A,DISP=(NEW,PASS,DELETE),                             
//************** LISTA W56076-001,-002 END YEAR REPORT, SUMMARY                 
//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                   *         
//*    KOPIERAR LISTORNA PÅ FIL ÅT LAB FÖR ATT                        *         
//*    VCOM EJ KLARAR ATT HANTERA FILER MED FBA (SKALL VARA FB)       *         
//*                                                                   *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W560GEN EXEC PGM=ICEGENER                                                     
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&&TEMP6A,DISP=(OLD,DELETE,DELETE)                            
//************** LISTA END YEAR REPORT, DETAIL AND SUMMARY          ***         
//*                                                                             
//SYSUT2   DD  DSN=&INDUT..W56076(+1),DISP=(NEW,CATLG,DELETE), -LIM(03)         
//*********** LISTFIL  W56076-001 AND W56076-002                                
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
