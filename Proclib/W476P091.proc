//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  UPDATING OF REFILLING DATABASE                                             
//*                                                                             
//*  FREQUENCE:    DAILY    RTN W476S5                                          
//*                                                                             
//*  RESTART:      W47691    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W476P091 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=1,                                                           
//             INDIN=&W476..W476S5                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47691S  EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SORTMSG  DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDGRND..CONSTANT(W476PD91),DISP=SHR                        
//SORTIN   DD  DSN=&INDIN..W47664(+0),DISP=SHR                                  
//SORTOUT  DD  DSN=&&W47664,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47691   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W47691,W47691,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W47691D1 DD  DSN=&&W47664,DISP=(OLD,DELETE,DELETE)                            
//************ FAKTURAINFO  FRÅN DDI                                            
//*                                                                             
