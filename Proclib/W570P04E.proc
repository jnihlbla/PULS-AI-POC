//*                                                                             
//*  TO CREATE EXCEL FILE FOR GIT CHINA USA KOREA DUBAI                         
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W570M2                                       
//*                                                                             
//*  RESTART:      W5704E    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W570P04E PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W570..W570M2,                                             
//             INDUT=&W570..W570M2,                                             
//             INDREG=&W011                                                     
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W5704E   EXEC PGM=V16459,PARM='W5704E/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR            -- DATKORT            
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR         -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//W5704ED1 DD  DSN=&INDIN..W57046B(+0),DISP=SHR                                 
//************ GIT FILE FROM W57046 - R30                                       
//*                                                                             
//************ BACK-FIL BACKAR SALDO TILL MIDNATT                               
//*                                                                             
//W5704ED2 DD  DSN=&INDREG..W01172(+0),DISP=SHR                                 
//************ ARTIKELUPPGIFTER FÖR XDC-NON-VCC DC'S                            
//TPFIL1   DD  DSN=&&TPFIL1,DISP=(NEW,PASS,DELETE),                             
//************ TEMPFIL FÖR SORTERADE ARTIKEL                                    
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL2   DD  DSN=&&TPFIL2,DISP=(NEW,PASS,DELETE),                             
//************ TEMPFIL FÖR SORTERADE                                            
//             DATACLAS=PSEN                                                    
//*                                                                             
//W5704ED3 DD  DSN=&INDUT..W57047B(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//************ EXCEL FILE WITH GIT FOR XDC-NON-VCC DC'S AND USA                 
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
