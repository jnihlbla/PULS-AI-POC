//*                                                                             
//*  SKRIVER FELFIL TILL TRATTEN           OBS! JOBBET KAN OMSTARTA             
//*  INPUT FRÅN WLFILC DVS PGM W11210                      SIG SJÄLV            
//*                                                                             
//*  FREKVENS:     DAG    RTN W200D1                                            
//*                                                                             
//*  ÅTERSTART:    W11218    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W112P018 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=1,                                                           
//             INDUT=&W112..W200D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11218   EXEC PGM=DFSRRC00,                                                   
//             PARM=('BMP,W11218,W11218,,,N00,,,,,&CPU,,,&IMS')                 
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//W11218D1 DD  DSN=&INDUT..W11201(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ FEL/VARNINGAR_TILL UT-TRATTEN                                    
//             SPACE=(120,(100,500),RLSE),AVGREC=U,                             
//             MGMTCLAS=&NOBACKUP                                               
//*                                                                             
//W11218D2 DD  DSN=&INDUT..W11218(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ HJÄLP-FIL FÖR OMSTART (NORMALT TOM)                              
//             SPACE=(10,(1),RLSE),AVGREC=U,                                    
//             MGMTCLAS=DEL2                                                    
