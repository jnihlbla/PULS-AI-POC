//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  MQ FILE TRANSFER. (SEND FILE)                                              
//*                                                                             
//*  FILE CAN BE A FB/VB FILE WITH LENGTH NOT GREATER THAN 9999                 
//*                                                                             
//*  FREQUENCE:    N/A                                                          
//*                                                                             
//*  RESTART  :    WZ1123    NORMAL                                             
//*                                                                             
//*  ARGUMENTS:    DSIN     - FILE TO BE SENT                                   
//*                                                                             
//*  SYSIN    :    FIRST LINE (MANDATORY)                                       
//*                  ¤ADDISPABS - KEY TO FETCH REQUIRED PARAMETERS              
//*                                                                             
//*                    EX: ¤ADDISPABS CARPARTS.PULS.MQSEND                      
//*                                                                             
//*                FOLLOWED BY ADDITIONAL DATA AS REQUIRED.                     
//*                PARAMETERS ACCEPTED - ¤MQMPROP                               
//*                                                                             
//*                ¤MQMPROP - USED TO SPECIFY THE MQ HEADER/PROPERTY            
//*                           NAME AND ITS VALUE THAT SHOULD BE ADDED           
//*                           TO THE MESSAGE.                                   
//*                                                                             
//*                           FORMAT:                                           
//*                           ¤MQMPROP <MQ_HDR_NAME>=<MQ_HDR_VALUE>             
//*                                                                             
//*                           POSSIBLE TO SPECIFY THE FOLLOWING AS PART         
//*                           OF <MQ_HDR_VALUE> WHICH WILL BE                   
//*                           SUBSTITUTED AT RUN TIME.                          
//*                           %YYYYMMDD, %YYMMDD, %HHMMSS                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ11P023 PROC STPLIB=&INDRTE..LOAD,                                           
//             DSIN=NULLFILE                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ1123   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,WZ1123,WZ1123,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//WDR5     INCLUDE MEMBER=WDR5                                                  
//FILDD1   DD  DSN=&DSIN,DISP=SHR                                               
//*                                                                             
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//SYSIN    DD  DUMMY                                                            
//*                                                                             
