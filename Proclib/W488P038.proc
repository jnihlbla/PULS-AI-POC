//* --------------------  PROCEDUR  W488P038 --------------------               
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  COMPARE PDP STOCK AGAINST CENTRAL REGISTER                                 
//*                                                                             
//*  FREQUENCE:    DAILY    RTN W488V1                                          
//*                                                                             
//*  RESTART:      W48838    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W488P038 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W488..W488V1,                                             
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W48838   EXEC PGM=V16459,PARM='W48838/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),DEST=LOCAL,HOLD=YES                             
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W48838D1 DD  DSN=&INDIN..W48837(+0),DISP=SHR                                  
//         DD  DSN=&INDIN..W48830,DISP=SHR                                      
//************ MERGED FILE PDP CENTRAL DB                                       
//*                                                                             
//A4LF OUTPUT FORMDEF=SLSR6C,PAGEDEF=SLSR6C                                     
//*                                                                             
//W48838D2 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF)                     
//************ W48838D2  ERROR-LIST TUNING PDP CENTRAL REGISTER                 
//*                                                                             
