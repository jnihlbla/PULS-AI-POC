//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SW TEXT IN FILES                                                           
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W510D4                                         
//*                                                                             
//*  RESTART:      W51094    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W510P094 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W510..W510D4,                                             
//             INDUT=&W510..W510D4                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W510PD02),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51072A(+0),DISP=SHR                                 
//************ INFILE W51072A                                                   
//*                                                                             
//SORTOUT  DD  DSN=&&W51072A,DISP=(NEW,PASS,DELETE),                            
//************ SORTERAD INFIL W51072A                                           
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51094   EXEC PGM=W51094                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SORTMSG  DD  SYSOUT=*                                                         
//W51094D1 DD  DSN=&&W51072A,DISP=(OLD,DELETE,DELETE)                           
//************ SORTED INFILE W51072                                             
//*                                                                             
//W51094D2 DD  DSN=&INDIN..W51073B(+0),DISP=SHR                                 
//************ SORTED INFILE W51073                                             
//*                                                                             
//W51094D3 DD  DSN=&&W51072,DISP=(NEW,PASS,DELETE),                             
//************ OUTFILE W51072                                                   
//             DATACLAS=PSEB                                                    
//*                                                                             
//W51094D4 DD  DSN=&INDUT..W51073(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ OUTFILE W51073                                                   
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT3    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W510PD02),DISP=SHR                         
//SORTIN   DD  DSN=&&W51072,DISP=(OLD,DELETE,DELETE)                            
//************ OUTFILE W51072                                                   
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W51072(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ OUTFILE W51072                                                   
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
