//*                                                                             
//*  BATCH TO CREATE LOAD FILE FOR LEAKAGE/SURPLUS                              
//*                                                                             
//*  FREQUENCE:    WEEKLY    RTN W371V7                                         
//*                                                                             
//*  RESTART:      W37184    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W371P084 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W371..W371V7,                                             
//             INDUT=&W371..W371V7                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W37184   EXEC PGM=W37184                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W37184D1 DD  DSN=&INDIN..W37141(+0),DISP=SHR                                  
//************ WEEKLY POINT TRANSACTION FILE                                    
//*                                                                             
//W37184D2 DD  DSN=&INDUT..W37175(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ LOAD FILE FOR LEAKAGE/SURPLUS                                    
//             SPACE=(117,(50,5),RLSE),AVGREC=K,                                
//             MGMTCLAS=&BACKUPC                                                
