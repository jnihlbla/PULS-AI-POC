//W418P003 PROC INDIN=&W803..W418D1,                                            
//             INDUT=&W418..W418D1,                                             
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                    -- DISPLAY           
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W418PD03),DISP=SHR                         
//*                                                                             
//SORTIN   DD  DSN=&INDIN..W80301,DISP=SHR                                      
//************ BUYBACK              PT R14                                      
//*                                                                             
//SORTOUT  DD  DSN=&&W41803,DISP=(NEW,PASS,DELETE),                             
//************ KREDITNOTA-POSTER SORTERADE                                      
//             SPACE=(283,(500,50),RLSE),AVGREC=K                               
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W41803   EXEC PGM=V16459,PARM='W41803/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W41803D1 DD  DSN=&&W41803,DISP=(OLD,DELETE,DELETE)                            
//************ INFIL                                                            
//*                                                                             
//W41803D2 DD  DSN=&INDUT..W41803(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL                                                            
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
