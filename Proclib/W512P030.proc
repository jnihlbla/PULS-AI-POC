//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  TO CREATE EXCEL FILE FOR GIT                                               
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W512M3                                       
//*                                                                             
//*  RESTART:      W51230    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W512P030 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W512..W512M3,                                             
//             INDUT=&W512..W512M3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51230   EXEC PGM=V16459,PARM='W51230/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR            -- DATKORT            
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR         -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//W51230D1 DD  DSN=&INDIN..W51229(+0),DISP=SHR                                  
//************ GIT FILE                                                         
//*                                                                             
//TPFIL1   DD  DSN=&&TPFIL1,DISP=(NEW,PASS,DELETE),                             
//************ TEMPFIL FÖR SORTERADE ARTIKEL                                    
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL2   DD  DSN=&&TPFIL2,DISP=(NEW,PASS,DELETE),                             
//************ TEMPFIL FÖR SORTERADE ARTIKELSALDO-POSTER                        
//             DATACLAS=PSEN                                                    
//*                                                                             
//W51230D2 DD  DSN=&INDUT..W51230(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ EXCEL FILE WITH GIT                                              
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
//*                                                                             
//W51230D3 DD  DSN=&INDUT..W51230A(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//************ DETAILED REPORT WITH GIT                                         
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
//*                                                                             
