//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATE EXTRACT FILE FROM HERCULES TO PULS                                  
//*                                                                             
//*  FREQUENCE:    SEVERAL TIMES A DAY     RTN W233S1                           
//*                                                                             
//*  RESTART:      W23327    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W233P027 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W233..W233V1,                                             
//             INDUT=&W233..W233V1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W23327   EXEC PGM=W23327                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//W23327D1 DD  DSN=&INDIN..W23327,DISP=SHR                                      
//************ INPUT FILE FROM HERCULES SYSTEM                                  
//*                                                                             
//W23327D2 DD  DSN=&INDUT..W23327A(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//************ OUTPUT FILE WITH HERCULES INFO                                   
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
//W23327D3 DD  DSN=&INDUT..W23327B(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//************ OUTPUT FILE WITH HERCULES INFO                                   
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
