//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W222P052 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W222..W200V1,                                             
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W22252   EXEC PGM=V16459,PARM='W22252/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W22252D1 DD  DSN=&INDIN..W22253(+0),DISP=SHR                                  
//************ INFIL FRÅN W222P050 (W200D1)                                     
//*                                                                             
//A4LF OUTPUT FORMDEF=SLSR6C,PAGEDEF=SLSR6C                                     
//*                                                                             
//W22252D2 DD  SYSOUT=(E,,3803),DEST=&DEST1,OUTPUT=(*.A4LF),                    
//************   LISTA W22252-001                                               
//             DCB=(RECFM=FBA,LRECL=121,BLKSIZE=121)                            
//*                                                                             
