//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W418P010 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W418..W418D1,                                             
//             INDUT=&W418..W418D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W41810   EXEC PGM=DFSRRC00,REGION=7M,                                         
//             PARM=('&DBB,DSNMTV01,W41810,,00')                                
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//DDOTV02  DD  DSN=&&W41810BT,DISP=(NEW,PASS,DELETE),                           
//             SPACE=(TRK,(1,1),RLSE),                                          
//             DCB=(RECFM=VB,LRECL=4092)                                        
//DDITV02  DD  DSN=&INDRTE..CONSTANT(W41810I2),DISP=SHR                         
//*                                                                             
//W41810D1 DD  DSN=&INDIN..W41808(+0),DISP=SHR                                  
//************ INFIL                                                            
//*                                                                             
//W41810D2 DD  DSN=&INDUT..W41810(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ GODKÄNDA POSTER                                                  
//             SPACE=(376,(2,2),RLSE),AVGREC=K,                                 
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W41810D3 DD  DSN=&INDUT..W41811(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ BEKRÄFTELSEPOSTER                                                
//             SPACE=(29,(500,500),RLSE),AVGREC=U,                              
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W41810D4 DD  DSN=&INDUT..W41813(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ GODKÄNDA BUYBACK-POSTER                                          
//             SPACE=(376,(2,2),RLSE),AVGREC=K,                                 
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W41810D5 DD  DSN=&INDUT..W41814(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ FELPOSTER TILL VIPS                                              
//             SPACE=(124,(2,1),RLSE),AVGREC=K,                                 
//             MGMTCLAS=&NOBACKUP                                               
//*                                                                             
//WDA2     INCLUDE MEMBER=WDA2                                                  
//WDB2     INCLUDE MEMBER=WDB2                                                  
//WDB3     INCLUDE MEMBER=WDB3                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDK7     INCLUDE MEMBER=WDK7                                                  
//WDL5     INCLUDE MEMBER=WDL5                                                  
//WDR1     INCLUDE MEMBER=WDR1                                                  
