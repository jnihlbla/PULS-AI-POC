//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W271P021 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W011..&RTEGRP.,                                          
//             INDUT=SAKNAS                                                     
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTARDC),DISP=SHR                         
//SORTIN   DD  DSN=DUMMY                                                        
//*                                                                             
//SORTOUT  DD  DSN=&&W27147,DISP=(NEW,PASS,DELETE),                             
//************ ARTIKLAR FRÅN WDK7, SAMTLIGA LAGER                               
//         DATACLAS=PSEB                                                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W27121   EXEC PGM=V16459,PARM='W27121/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W27121D1 DD  DSN=&&W27147,DISP=(OLD,DELETE,DELETE)                            
//************ ARTIKLAR FRÅN WDK7, SAMTLIGA LAGER                               
//*                                                                             
//W27121D2 DD  DSN=&INDIN1..W01160(+0),DISP=SHR                                 
//************ GRUNDFIL WDK6                                                    
//*                                                                             
//W27121D3 DD  DSN=&INDUT..W27121(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ AKTIVA ARTIKLAR SAMTLIGA SDC                                     
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
