//W850P007 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W850..WVSOP                                               
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W85007   EXEC PGM=V16459,PARM='W85007/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
