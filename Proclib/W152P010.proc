//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  ÖVERSÄTTNING AV KATALOGDATA                                                
//*  FIL MED ÖVERSATT TEXT I UNICODE-FORMAT KONVERTERAS TILL                    
//*  RESPEKTIVE EBCDIC-KOD BEROENDE PÅ AKTUELLT SPRÅK I FILEN                   
//*                                                                             
//*  FREKVENS:     BESTÄLLES     RTN W152B1                                     
//*                                                                             
//*  ÅTERSTART:    W15210    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W152P010 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W152..W152B1,                                             
//             INDUT=&W152..W152B1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W15210   EXEC PGM=W15210                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//SYSIN    DD  DUMMY    FRÅN JCL KOMMER HÄR INFILENS NAMN                       
//*                                                                             
//W15210D1 DD  DSN=&INDIN..W15205(+0),DISP=SHR                                  
//************ ÖVERSATT TEXT I UNICODE-FORMAT                                   
//*                                                                             
//W15210D2 DD  DSN=&INDUT..W15210(+1),DISP=(NEW,CATLG,DELETE),  -LIM(9)         
//************ TEXT KONV. TILL OLIKA EBCDIC-KODER BEROENDE PÅ SPRÅK             
//             SPACE=(80,(3,9),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//W15210D3 DD  DSN=&INDUT..W15211(+1),DISP=(NEW,CATLG,DELETE),  -LIM(9)         
//************ FELINFO OM TRUNKERADE TTXT OCH BEN TILL SPS                      
//             SPACE=(80,(5,9),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
