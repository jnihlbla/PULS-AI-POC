//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  READ W48323 CONTAINING INFO ABOUT TRANSPORTS AND EXTRACT                   
//*  DATA ABOUT PSN NUMBERS AND RELATED INFO.                                   
//*                                                                             
//*  FREQUENCE:    WEEKLY    RTN W483V2                                         
//*                                                                             
//*  RESTART:      W48324    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W483P024 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W483..W483V2,                                             
//             INDUT=&W483..W483V2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W48324   EXEC PGM=V16459,PARM='W48324/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W48324D1 DD  DSN=&INDIN..W48323(+0),DISP=SHR                                  
//************ EXTRACT FROM WDE6                                                
//*                                                                             
//W48324D2 DD  DSN=&INDUT..W48324(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ TRANSPORTATION REPORT DATA (PSN)                                 
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//*                                                                             
