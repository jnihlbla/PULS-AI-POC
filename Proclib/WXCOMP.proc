//*                                                                             
//*             ********************************                                
//*             *   XICS -  V 5.0  JULY 1984   *                                
//*             *                              *                                
//*             *    COMPOSITION PROCEDURE     *                                
//*             ********************************                                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXCOMP  PROC DSIN=NULLFILE,DSIN2=NULLFILE,                                    
//             DSMETA=NULLFILE,                                                 
//             DSIX1=NULLFILE,DSIX2=NULLFILE,                                   
//             DSIX3=NULLFILE,DSIX4=NULLFILE,                                   
//             DSIX5=NULLFILE,DSIX6=NULLFILE,                                   
//             DSIX7=NULLFILE,DSIX8=NULLFILE,                                   
//             DSIX9=NULLFILE,DSIXA=NULLFILE,                                   
//             DSIXB=NULLFILE,DSIXC=NULLFILE                                    
//*                                                                             
//COMPOSE  EXEC PGM=COMPUSET,                                                   
//             COND=(12,LT)                                                     
//STEPLIB   DD DSN=VPUBV1.XICS5.LOAD,DISP=SHR                                   
//**        DD DSN=SYS3.F1STV1.FORTVS.SUBRTNES,DISP=SHR                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//CSSIN     DD DSN=&DSIN,DISP=SHR                          INPT FILE 1          
//CSS04     DD DSN=&DSIN2,DISP=SHR                         INPT FILE 2          
//CSSOUT    DD DSN=&DSMETA,DISP=(NEW,PASS,DELETE),         META OUTPUT          
//             DCB=(RECFM=VB,LRECL=2200,BLKSIZE=6233),                          
//             MGMTCLAS=&DEL2BKPC,SPACE=(6233,(9000,1000),RLSE)                 
//FT03F001  DD DSN=&INDGRND..XICSLIB(VRSJLCO1),               CON FIG           
//             DISP=SHR                                                         
//FT05F001  DD DSN=&INDGRND..XICSLIB(XICSCTL2),DISP=SHR                         
//FT06F001  DD SYSOUT=*                                    ERROR/LOG            
//VSRN01    DD DSN=VPUBV1V.XICS.VOLVOM6.WIDTHS,DISP=SHR    WIDTHS FILE          
//VSRN02    DD DSN=VPUBV1V.XICS.DICTNRY,DISP=SHR           HYPHEN DICT          
//FT07F001  DD DSN=&DSIX1,DISP=(NEW,PASS,DELETE),              INDEX 1          
//             DCB=(RECFM=VB,LRECL=640,BLKSIZE=12466),                          
//             MGMTCLAS=&DEL2BKPC,SPACE=(12466,(100,100))                       
//FT08F001  DD DSN=&DSIX2,DISP=(NEW,PASS,DELETE),              INDEX 2          
//             DCB=(RECFM=VB,LRECL=640,BLKSIZE=12466),                          
//             MGMTCLAS=&DEL2BKPC,SPACE=(12466,(100,100))                       
//FT14F001  DD DSN=&DSIX3,DISP=(NEW,PASS,DELETE),              INDEX 3          
//             DCB=(RECFM=VB,LRECL=640,BLKSIZE=12466),                          
//             MGMTCLAS=&DEL2BKPC,SPACE=(12466,(100,100))                       
//FT15F001  DD DSN=&DSIX4,DISP=(NEW,PASS,DELETE),              INDEX 4          
//             DCB=(RECFM=VB,LRECL=640,BLKSIZE=12466),                          
//             MGMTCLAS=&DEL2BKPC,SPACE=(12466,(100,100))                       
//FT16F001  DD DSN=&DSIX5,DISP=(NEW,PASS,DELETE),              INDEX 5          
//             DCB=(RECFM=VB,LRECL=640,BLKSIZE=12466),                          
//             MGMTCLAS=&DEL2BKPC,SPACE=(12466,(100,100))                       
//FT17F001  DD DSN=&DSIX6,DISP=(NEW,PASS,DELETE),              INDEX 6          
//             DCB=(RECFM=VB,LRECL=640,BLKSIZE=12466),                          
//             MGMTCLAS=&DEL2BKPC,SPACE=(12466,(100,100))                       
//FT18F001  DD DSN=&DSIX7,DISP=(NEW,PASS,DELETE),              INDEX 7          
//             DCB=(RECFM=VB,LRECL=640,BLKSIZE=12466),                          
//             MGMTCLAS=&DEL2BKPC,SPACE=(12466,(100,100))                       
//FT19F001  DD DSN=&DSIX8,DISP=(NEW,PASS,DELETE),              INDEX 8          
//             DCB=(RECFM=VB,LRECL=640,BLKSIZE=12466),                          
//             MGMTCLAS=&DEL2BKPC,SPACE=(12466,(100,100))                       
//FT20F001  DD DSN=&DSIX9,DISP=(NEW,PASS,DELETE),              INDEX 9          
//             DCB=(RECFM=VB,LRECL=640,BLKSIZE=12466),                          
//             MGMTCLAS=&DEL2BKPC,SPACE=(12466,(100,100))                       
//FT21F001  DD DSN=&DSIXA,                                                      
//             DISP=(NEW,PASS,DELETE),                        INDEX 10          
//             DCB=(RECFM=VB,LRECL=640,BLKSIZE=12466),                          
//             MGMTCLAS=&DEL2BKPC,SPACE=(12466,(100,100))                       
//FT22F001  DD DSN=&DSIXB,                                                      
//             DISP=(NEW,PASS,DELETE),                        INDEX 11          
//             DCB=(RECFM=VB,LRECL=640,BLKSIZE=12466),                          
//             MGMTCLAS=&DEL2BKPC,SPACE=(12466,(100,100))                       
//FT23F001  DD DSN=&DSIXC,                                                      
//             DISP=(NEW,PASS,DELETE),                        INDEX 12          
//             DCB=(RECFM=VB,LRECL=640,BLKSIZE=12466),                          
//             MGMTCLAS=&DEL2BKPC,SPACE=(12466,(100,100))                       
//FT11F001  DD DCB=(RECFM=F,BLKSIZE=6144),                     TEMP 1           
//             SPACE=(6144,(10000,6000))                                        
//FT12F001  DD DCB=(RECFM=F,BLKSIZE=6144),                     TEMP 2           
//             SPACE=(6144,(10000,6000))                                        
//FT13F001  DD DCB=(RECFM=F,BLKSIZE=6144),                     TEMP 3           
//             SPACE=(6144,(10000,6000))                                        
//CSS03     DD SYSOUT=*,DCB=(RECFM=UA,BLKSIZE=150)             GALLEY           
//*                                                                             
//CATLG   EXEC PGM=IEFBR14                                                      
//CB1XXX01 DD  DSN=&DSMETA,DISP=(OLD,CATLG,DELETE)                              
//CB1XXX02 DD  DSN=&DSIX1,DISP=(OLD,CATLG,DELETE)                               
//CB1XXX03 DD  DSN=&DSIX2,DISP=(OLD,CATLG,DELETE)                               
//CB1XXX04 DD  DSN=&DSIX3,DISP=(OLD,CATLG,DELETE)                               
//CB1XXX05 DD  DSN=&DSIX4,DISP=(OLD,CATLG,DELETE)                               
//CB1XXX06 DD  DSN=&DSIX5,DISP=(OLD,CATLG,DELETE)                               
//CB1XXX07 DD  DSN=&DSIX6,DISP=(OLD,CATLG,DELETE)                               
//CB1XXX08 DD  DSN=&DSIX7,DISP=(OLD,CATLG,DELETE)                               
//CB1XXX09 DD  DSN=&DSIX8,DISP=(OLD,CATLG,DELETE)                               
//CB1XXX10 DD  DSN=&DSIX9,DISP=(OLD,CATLG,DELETE)                               
//CB1XXX11 DD  DSN=&DSIXA,DISP=(OLD,CATLG,DELETE)                               
//CB1XXX12 DD  DSN=&DSIXB,DISP=(OLD,CATLG,DELETE)                               
//CB1XXX13 DD  DSN=&DSIXC,DISP=(OLD,CATLG,DELETE)                               
