//*                                                                             
//*  KURANSGRUPPERINGEN  SKAPA ARTIKELSALDOTRANSAR                              
//*                                                                             
//*  FREKVENS:   MÅNADSSLUT W512M2                                              
//*                                                                             
//*  ÅTERSTART:    W51264    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W512P064 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W512..W512M2,                                             
//             INDUT=&W512..W512M2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51264   EXEC PGM=V16459,PARM='W51264/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DUMMY                                                            
//W51264D1 DD  DSN=&INDIN..W51261(+0),DISP=SHR                                  
//*                                                                             
//TPFIL2   DD  DSN=&&TEMP2,DISP=(NEW,DELETE,DELETE),                            
//             DATACLAS=PSEN                                                    
//TPFIL3   DD  DSN=&&TEMP3,DISP=(NEW,DELETE,DELETE),                            
//             DATACLAS=PSEN                                                    
//*                                                                             
//W51264D2 DD  DSN=&INDUT..W51264(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ PRIS- OCH SALDO-INFO EN TRANS PER ARTIKEL                        
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
//W51264D3 DD  DSN=&INDUT..W51264A(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
//W51264D4 DD  DSN=&INDUT..W51264B(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
