//*  LISTA MED MANUELLT SATTA SÄSONGER SOM KOMMER ATT                           
//*  UPPHÖRA INOM TVÅ VECKOR                                                    
//*                                                                             
//*  FREKVENS:     VECKA   RTN W271V7                                           
//*                                                                             
//*  ÅTERSTART:              NORMAL                                             
//*                W27174    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W271P074 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W271..W271V7,                                             
//             INDUT=&W271..W271V7                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTARDC),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W27173(+0),DISP=SHR                                  
//************ SÄSONGER SOM KOMMER ATT UPPHÖRA INOM TVÅ VECKOR                  
//*                                                                             
//SORTOUT  DD  DSN=&&W27174,DISP=(NEW,PASS,DELETE),                             
//************ SORTERAD UTFIL                                                   
//         DATACLAS=PSEN                                                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W27174   EXEC PGM=W27174                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//************ A4 LANDSCAPE, SINGLE SIDE, RASTER  (FOLDED PAPER)                
//W27174D1 DD  DSN=&&W27174,DISP=(OLD,DELETE,DELETE)                            
//************ SORTERAD UTFIL                                                   
//*                                                                             
//W27174D2 DD  DSN=&INDUT..W27174(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ W27174  SÄSONGER SOM KOMMER ATT UPPHÖRA INOM TVÅ VECKOR          
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
