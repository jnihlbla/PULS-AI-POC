//W271P098 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=2,                                                           
//             INDIN=&W271..W271V6,                                             
//             INDUT=&W271..W271V6                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W27198   EXEC PGM=DFSRRC00,                                                   
//             PARM=('BMP,W27198,W27198,,,N00,,,,,&CPU,,,&IMS')                 
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W27198D1 DD  DSN=&INDIN..W27197(+0),DISP=SHR                                  
//************ TISTOREF                                                         
//W27198D2 DD  DSN=&&W27198,DISP=(NEW,PASS,DELETE)                              
//************ VILKA POSTER SOM UPPDATERATS                                     
//*                                                                             
//W27198S  EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                      -- DISPLAY         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W271PD98),DISP=SHR                         
//SORTIN   DD  DSN=&&W27198,DISP=(OLD,DELETE,DELETE)                            
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W27198(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ SORTERADE PÅ ARTIKELNUMMER                                       
