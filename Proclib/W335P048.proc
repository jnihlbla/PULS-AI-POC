//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  MATCHAR GÅRDAGENS W33588 OCH DAGENS W33588                                 
//*                                                                             
//*  FREKVENS:     VECKA       RTN W335D5 W335D7 W335D8                         
//*                                                                             
//*  ÅTERSTART:              NORMAL                                             
//*                W33548    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W335P048 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W335,                                                     
//             INDIN1=&W335.W335D5,                                             
//             INDUT=&W335..W335D5,                                             
//             INDUT1=&W335..W335D5                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33548   EXEC PGM=V16459,PARM='W33548/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(500,500))                                           
//W33548D1 DD  DSN=&INDIN..W33588(+0),DISP=SHR                                  
//************ PRISFIL TOTAL GÅRDAGENS                                          
//*                                                                             
//W33548D2 DD  DSN=&INDIN1..W33560(+0),DISP=SHR                                 
//************ PRISLFIL TOTAL DAGENS                                            
//*                                                                             
//W33548D3 DD  DSN=&INDUT..W33548(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ REGISTER UT                                                      
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//W33548D4 DD  DSN=&INDUT1..W33560(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ REGISTER UT                                                      
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
