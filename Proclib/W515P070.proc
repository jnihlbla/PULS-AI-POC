//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W515P070 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W515..W515D3,                                             
//             INDUT=&W515..W515D3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W515PD02),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51572A(+0),DISP=SHR                                 
//************ INFILE W51572A                                                   
//*                                                                             
//SORTOUT  DD  DSN=&&W51572A,DISP=(NEW,PASS,DELETE),                            
//************ SORTERAD INFIL W51572A                                           
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51570   EXEC PGM=W51570                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SORTMSG  DD  SYSOUT=*                                                         
//W51570D1 DD  DSN=&&W51572A,DISP=(OLD,DELETE,DELETE)                           
//************ SORTED INFILE W51572                                             
//*                                                                             
//W51570D2 DD  DSN=&INDIN..W51573B(+0),DISP=SHR                                 
//************ SORTED INFILE W51573                                             
//*                                                                             
//W51570D3 DD  DSN=&&W51572,DISP=(NEW,PASS,DELETE),                             
//************ OUTFILE W51572                                                   
//             DATACLAS=PSEB                                                    
//*                                                                             
//W51570D4 DD  DSN=&INDUT..W51573(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ OUTFILE W51573                                                   
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT3    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W515PD02),DISP=SHR                         
//SORTIN   DD  DSN=&&W51572,DISP=(OLD,DELETE,DELETE)                            
//************ OUTFILE W51572                                                   
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W51572(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ OUTFILE W51572                                                   
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
