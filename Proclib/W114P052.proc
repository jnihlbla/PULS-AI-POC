//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  ANNULLATIONS TRANSAR TILL PV INKÖP  (SIPLUS)                               
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W114D5                                         
//*                                                                             
//*  RESTART:      W11452      NORMAL                                           
//*                READS       WDK6 WDD2 WDP3                                   
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W114P052 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W217..W114D5,                                            
//             INDIN2=&W111..W114D5,                                            
//             INDIN3=&W092..W114D5,                                            
//             INDUT=&WUT..W114D5,                                              
//             INDUT2=&W114..W114D5                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11452   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W11452,W11452,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDD2     INCLUDE MEMBER=WDD2                                                  
//WDP3     INCLUDE MEMBER=WDP3                                                  
//W11452D1 DD  DSN=&INDIN1..W21707,DISP=SHR                                     
//         DD  DSN=&INDIN2..W11146,DISP=SHR                                     
//         DD  DSN=&INDIN3..W092ZR,DISP=SHR                                     
//************ FILER FRÅN W217P002, W111P020, W092P108                          
//*                                                                             
//W11452D2 DD  DSN=&INDUT..W11452(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ ANNULLATIONS TRANSAR TILL PV INKÖP = SIPLUS                      
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W11452D3 DD  DSN=&INDUT2..W11453(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)        
//************ MAIL DATA   TILL INKÖPARE NAP  ANNULLATION                       
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W11452D4 DD  DSN=&INDUT2..W11457(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)        
//************ MAIL ADRESS TILL INKÖPARE NAP  ANNULLATION                       
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
