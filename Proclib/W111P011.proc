//*  KOPIERAR FILEN W111.W111V1.W11111 TILL WUT.W111V1.V11111                   
//*  SOM SKALL SKICKAS TILL VTP                                                 
//*                                                                             
//*  FREKVENS:     VECKA    RTN W111V1                                          
//*                                                                             
//*  ÅTERSTART:    W11110    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W111P011 PROC INDIN=&W111..W111V1,                                            
//             INDUT=&WUT..W111V1                                               
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//ICEGENER EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDIN..W11111(+0),DISP=SHR                                  
//*************ARTIKLAR MED FLABORT-UTG = 0, EGNA FÖRETAGET (PV)                
//SYSUT2   DD  DSN=&INDUT..W11111(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ ARTIKLAR MED FLABORT-UTG = 0, EGNA FÖRETAGET (PV)                
//************ SKICKAS TILL ANDRA BOLAGET (LV)                                  
//             SPACE=(6,(100,33),RLSE),AVGREC=K,                                
//             MGMTCLAS=&NOBACKUP                                               
//*                                                                             
