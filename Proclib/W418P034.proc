//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SORTERAR OCH SUMMERAR INPUT FRÅN BILL-IT. SKAPAR KREDIT-                   
//*  INFO TILL VIPS, EKONOMI OCH PGM W4183300.                                  
//*                                                                             
//*  FREKVENS:     FLERA GGR PER DAG     RTN W418S2                             
//*                                                                             
//*  ÅTERSTART:    W41834      NORMAL                                           
//*                LÄSER        WDK6 WDK7 WDA2 WDL5                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W418P034 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W418..W418S2,                                             
//             INDUT=&W418..W418S2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W418PD34),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W41832(+0),DISP=SHR                                  
//************ INFIL FRÅN W4183200                                              
//*                                                                             
//SORTOUT  DD  DSN=&&W41832,DISP=(NEW,PASS,DELETE),                             
//************ SORTAD FIL                                                       
//         SPACE=(204,(5,2),RLSE),AVGREC=K                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W41834   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W41834,W41834,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDK7     INCLUDE MEMBER=WDK7                                                  
//WDA2     INCLUDE MEMBER=WDA2                                                  
//WDL5     INCLUDE MEMBER=WDL5                                                  
//WDB2     INCLUDE MEMBER=WDB2                                                  
//*                                                                             
//W41834D1 DD  DSN=&&W41832,DISP=(OLD,DELETE,DELETE)                            
//************ INFIL (W41832 OMSORTERAD)                                        
//*                                                                             
//W41834D2 DD  DSN=&INDUT..W418AJ(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ BILLIT-RADER SOM SKALL VIDARE MOT LEVERANTÖR.DIRLEV              
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
//W41834D3 DD  DSN=&INDUT..W418AK(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ BILLIT-RADER MED KREDIT-INFO TILL VIPS                           
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
//W41834D4 DD  DSN=&INDUT..W418AL(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ KREDIT-POSTER FRÅN BILL-IT FÖR UPPDATERUNG I W4183300            
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//W41834D6 DD  DSN=&INDUT..W418AO(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ TILL 514 KONTERING LAB-TRANSAR 720-POSTER                        
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
