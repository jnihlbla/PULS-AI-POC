//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  STARTAS FRÅN BILD 4538 VIA SOP, SKAPAR EN FIL MED TULLINFO                 
//*  MED UPGIFTER FRÅN WDM7 OCH WDM8                                            
//*                                                                             
//*  FREKVENS:     FLERA GGR PER DAG     RTN W476SA                             
//*                                                                             
//*  ÅTERSTART:    W47680      NORMAL                                           
//*                LÄSER        WDM7 WDM8 WDB5                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W476P080 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W476..W476SA                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47680   EXEC PGM=DFSRRC00,REGION=6M,                                         
//             PARM=('&DBB,W47680,W47680,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                    -- ABEND         
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDM7     INCLUDE MEMBER=WDM7                                                  
//WDM8     INCLUDE MEMBER=WDM8                                                  
//WDB5     INCLUDE MEMBER=WDB5                                                  
//WDE6     INCLUDE MEMBER=WDE6                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDE2     INCLUDE MEMBER=WDE2                                                  
//WDR1     INCLUDE MEMBER=WDR1                                                  
//WDB2     INCLUDE MEMBER=WDB2                                                  
//WDR2     INCLUDE MEMBER=WDR2                                                  
//W47680D1 DD  DDNAME=SYSIN                                                     
//************ INDATA FRÅN BILD 4538 (OVERRIDE I JCL)                           
//*                                                                             
//W47680D2 DD  DSN=&INDUT..W47680(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ FIL MED FAKTINFO TILL TULLEN                                     
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
