//WG01RECO PROC DB=,DBRC=Y                                                      
//RECOV   EXEC PGM=DFSRRC00,                                                    
//             PARM='UDR,DFSURDB0,&DB,,,,,,,,,,,&DBRC'                          
//STEPLIB  DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDGRND..DBDLIB,DISP=SHR                                    
//         DD  DSN=&INDGRND..PSBLIB,DISP=SHR                                    
//SYSOUT   DD  SYSOUT=*                                                         
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//DFSUDUMP DD  DUMMY                                                            
//DFSUCUM  DD  DUMMY                                                            
//DFSULOG  DD  DUMMY                                                            
//*                                                                             
//ABEND   EXEC PGM=ABEND,COND=(4,GE,RECOV),PARM='1234567890123456'              
