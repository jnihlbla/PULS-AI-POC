//W553P072 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W212..W553D3,                                             
//             INDUT=&W553..W553D3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W55372   EXEC PGM=V16459,PARM='W55372/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W55372D1 DD  DSN=&INDIN..W21214,DISP=SHR                                      
//************ PRISPOSTER FRÅN INKÖP                                            
//*                                                                             
//W55372D2 DD  DSN=&INDUT..W55372(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED SORTERADE SAP-TRANSAR                                  
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W55372D3 DD  DSN=&INDUT..W55372F(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//************ UTFIL MED FELMEDDELANDE                                          
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
