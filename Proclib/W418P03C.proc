//W418P03C PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=1,                                                           
//             INDUT=&W418..W418S3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W4183C   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W4183C,W4183C,W4183CT,,N00,,,,,&CPU,,,&IMS')                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W4183CD1 DD  DSN=&INDUT..W418C1(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ UPPDATERINGSPOSTER TILL TP8LRET PGM W4183D00                     
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
//W4183CD2 DD  DSN=&INDUT..W418C2(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ EKONOMIFIL MED FAKTURA INFO TILL W510D2                          
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W4183CD3 DD  DSN=&INDUT..W418C3(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ VIPS-POSTER FAKTURERADE RADER HANDLING FEE                       
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
