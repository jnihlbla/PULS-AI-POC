//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LÄSER WLSATA (WDJ1) OCH SKRIVER SORTERADE ARTIKEL-                         
//*  SATSER PÅ FILEN W47848.                                                    
//*                                                                             
//*  FREKVENS:     PLANERINGSPERIOD    RTN W400P1                               
//*                                                                             
//*  ÅTERSTART:    W47848   NORMAL                                              
//*                SORT48   KÖR OM HELA PROCEDUREN                              
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W478P048 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W478..W400P1                                              
//W47848   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W47848,W47848,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY,DCB=(RECFM=VB,BLKSIZE=1408,BUFNO=1)                        
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDJ1     INCLUDE MEMBER=WDJ1                                                  
//W47848D1 DD  DSN=&&W47847,DISP=(NEW,PASS,DELETE),                             
//************ OSORTERADE POSTER FRÅN WDJ1                                      
//             SPACE=(6224,(100,10),RLSE)                                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT48   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W478PD48),DISP=SHR                         
//SORTIN   DD  DSN=&&W47847,DISP=(OLD,DELETE,DELETE)                            
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W47848(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ SORTERADE ARTIKEL-SATSER                                         
//             MGMTCLAS=&BACKUPC,SPACE=(6224,(100,10),RLSE)                     
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
