//********************************************************************          
//*                                                                             
//*  SORTERAR INFILERNA W23651 OCH W23653, SKRIVER LISTA                        
//*                                                                             
//*  FREKVENS:     DAG    RTN W236D1                                            
//*                                                                             
//*  ÅTERSTART:    SORT1     NORMAL                                             
//*                SORT2     NORMAL                                             
//*                W23651    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W236P054 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W236..W236D1,                                             
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W236PD54),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W23651(+0),DISP=SHR                                  
//************ LISTPOSTER, FÖRTIDIG INLEVERANS                                  
//*                                                                             
//SORTOUT  DD  DSN=&&W23651,DISP=(NEW,PASS,DELETE),                             
//************ W23651, (IDANSK, IDLEVNR, IDARTNR)                               
//             SPACE=(31,(100,500),RLSE),AVGREC=U                               
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT2    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W236PD54),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W23653,DISP=SHR                                      
//************ LISTPOSTER, INLEVERANS UTAN AVROP                                
//************ OBS: ALLA GEN TAS IN EFTERSOM J052 SOM SKAPAR FILEN              
//************ KAN KÖRAS FLERA GÅNGER                                           
//*                                                                             
//SORTOUT  DD  DSN=&&W23653,DISP=(NEW,PASS,DELETE),                             
//************ W23653 (IDANSK, IDLEVNR, IDARTNR)                                
//             SPACE=(24,(500,1000),RLSE),AVGREC=U                              
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W23654   EXEC PGM=V16459,PARM='W23654/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W23654D1 DD  DSN=&&W23651,DISP=(OLD,DELETE,DELETE)                            
//************ W23651 (IDANSK, IDLEVNR, IDARTNR)                                
//*                                                                             
//W23654D2 DD  DSN=&&W23653,DISP=(OLD,DELETE,DELETE)                            
//************ W23653 (IDANSK, IDLEVNR, IDARTNR)                                
//*                                                                             
//A4LF OUTPUT FORMDEF=SLSR6C,PAGEDEF=SLSR6C                                     
//*                                                                             
//W23654D3 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF)                     
//************ W23654-001  LISTA, FÖRTIDIG INLEV, INLEV UTAN AVROP              
//*                                                                             
