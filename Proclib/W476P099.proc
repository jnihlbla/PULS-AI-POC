//*                                                                   *         
//*      SKAPAR DELIVERY NOTE, GREECE                                 *         
//*                                                                   *         
//*      PERIODICITET: DAG                                            *         
//*                                                                   *         
//*      ÅTERSTART:    NORMAL                                         *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W476P099 PROC INDIN=&W476..W476D9,                                            
//             INDUT=&W476..W476D9,                                             
//             STPLIB=&INDRTE..LOAD                                             
//**           STPLIB=&INDRTE..LOAD,DEST2=&CPRINT                               
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT    EXEC PGM=SORT                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W476PD99),DISP=SHR                         
//**       SORT PER= DC,FAKT,ORDERKLASS,SHIP,ORD,ART                            
//SYSOUT   DD  SYSOUT=*                                                         
//SORTIN   DD  DSN=&INDIN..W4765G,DISP=SHR                                      
//***************  FAKTUROR FRÅN BILL-IT                            ***         
//*                                                                             
//SORTOUT  DD  DSN=&&W4765G,DISP=(NEW,PASS,DELETE),                             
//**************   SORTERADE FAKTURA-TRANSAR                        ***         
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//**************   TAR BORT DEN FÖRRA EXCEL-FILEN TILL GREKLAND                 
//*               SAS8 KLARAR INTE GENERATIONSFILER                             
//DEL53  EXEC  PGM=IDCAMS                                                       
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W47653GR),DISP=SHR                         
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47699   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W47699,W47699,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY,DCB=(RECFM=VB,BLKSIZE=1408,BUFNO=1)                        
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                      (POSTSUM)          
//WDG2     INCLUDE MEMBER=WDG2                                                  
//OUT1      OUTPUT FORMDEF=162BVD,PAGEDEF=162BVD                                
//W47699D1 DD  DSN=&&W4765G,DISP=(OLD,DELETE,DELETE)                            
//*                                                                             
//W47699D2 DD  DSN=&INDUT..W47653GR,DISP=(NEW,CATLG,DELETE),                    
//**************  EXCEL-FIL FÖR GREECE DELIVERY NOTE                            
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
