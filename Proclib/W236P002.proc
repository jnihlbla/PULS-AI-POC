//*      LEVERANSBEVAKNINGSSYSTEM, GER UPPLYSNING OM FÖR SENA         *         
//*      OCH FÖR TIDIGA LEVERANSER.                                   *         
//*                                                                   *         
//*      PERIODICITET: PLANERINGSPERIOD                               *         
//*                                                                   *         
//*      ÅTERSTART:    NORMAL                                         *         
//*                                                                   *         
//*       W23604 LÄSER WDK6,WDD9,WDF1,WDF5, OCH WDD3                  *         
//*                                                                   *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W236P002 PROC INDUT=&W236..W200P1,INDIN=&W236..W200P1,                        
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W23604  EXEC PGM=DFSRRC00,                                                    
//             PARM='&DBB,W23604,W23604,,00'                                    
//STEPLIB  DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY,DCB=(RECFM=VBS,LRECL=1400,BLKSIZE=1408,BUFNO=1)            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*       UTSKRIFT AV RÄKNEVERK (POSTSUM)                   
//W23604D1 DD  DSN=&INDIN..W23601(+0),DISP=SHR                                  
//************** TRANSAR FÖR IDARTNR MED AVROP INOM PERIODEN        ***         
//*                                                                             
//W23604D2 DD  DSN=&INDUT..W23603(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************** TRANSAR TILL LEVERANTÖRSBEDÖMNINGSLISTA W23504-001 ***         
//             SPACE=(6208,(100,50),RLSE),                                      
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//W23604D3 DD  DSN=&INDUT..W23605(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************** TRANSAR TILL LEVERANSFÖRSENINGSLISTA W23606-001    ***         
//             SPACE=(6233,(100,50),RLSE),                                      
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDD9     INCLUDE MEMBER=WDD9                                                  
//WDF1     INCLUDE MEMBER=WDF1                                                  
//WDF5     INCLUDE MEMBER=WDF5                                                  
//WDD3     INCLUDE MEMBER=WDD3                                                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
