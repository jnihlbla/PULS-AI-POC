//W27151DE DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF)                     
//************ W27151-222  REFILL - PASSIVA ARTIKLAR MED LAGER                  
//************             NDC JAPAN                                            
//*                                                                             
