//************ W27151-221  REFILL - PASSIVA ARTIKLAR MED LAGER                  
//************             NDC BUYER 80 - 99                                    
//*                                                                             
//W27151DD DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF)                     
//************ W27151-122  REFILL - AKTIVA ARTIKLAR MED ÖVERLAGER               
//************             NDC JAPAN                                            
