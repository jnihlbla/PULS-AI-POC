//             DISP=(MOD,DELETE,CATLG),                                         
//             SPACE=(4000,(4000,4000),,,ROUND),                                
//             MGMTCLAS=&DEL2BKPC,DATACLAS=MVOL                                 
//SYSCOPY     DD       DSN=&INDRTE..DUMP.&S01&DB2T.(+1),                        
//             DISP=(,CATLG,DELETE),                                            
//             SPACE=(TRK,(9000,3000),RLSE),                                    
//             MGMTCLAS=NOBACKUP,DATACLAS=MVOL                                  
//SYSIN DD DSN=&INDRTE..REOR.&S01&DB2T.1,DISP=SHR                               
//      DD DSN=&INDRTE..REOR.DAEX&DAT2(0),DISP=SHR                              
//      DD DSN=&INDRTE..REOR.&S01&DB2T.2,DISP=SHR                               
//*                                                                             
//ABEND   EXEC PGM=ABEND,COND=(4,GE,REOR),PARM='1234567890123456'               
