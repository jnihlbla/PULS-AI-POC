//*  CHINESE VOLUME PLANNING FILE FOR WHOLE SALES ORDER                         
//*  LIMITATION                                                                 
//*                                                                             
//*  FREQUENCE:    DAILY     RTN WXTRD2                                         
//*                                                                             
//*  RESTART:      WXTR9B    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTRP09B PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WXTR..WXTRD2,                                             
//             INDUT=&WXTR..WXTRD2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTR9B   EXEC PGM=V16459,PARM='WXTR9B/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//WXTR9BD1 DD  DSN=&INDIN..WXTR9A(+0),DISP=SHR                                  
//************ INPUT FILE                                                       
//*                                                                             
//WXTR9BD2 DD  DSN=&INDUT..WXTR9B(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//********** WXTR9B-001 REPORT FILE                                             
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
