//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W611P078 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W612..W611V1,                                             
//             INDUT2=&W611..W611V1,                                            
//             INDUT3=&WUT..W611V1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61178   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W61178,W61178,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                      -- DISPLAY         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IGZSRTCD DD  DUMMY                                                            
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR               -- DATKORT         
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR        -- DATKORT         
//DATUT    DD  SYSOUT=*                                      -- DATKORT         
//V16247D3 DD  SYSOUT=*                                      -- POSTSUM         
//WDL2     INCLUDE MEMBER=WDL2                                                  
//W61178D1 DD  DSN=&&W61178,DISP=(NEW,PASS,DELETE),                             
//************ PERIOD INFO                                                      
//             SPACE=(6177,(1000,500),RLSE)                                     
//*                                                                             
//W61178D2 DD  DSN=&&W6117H,DISP=(NEW,PASS,DELETE),                             
//************ PERIOD INFO - INTERNAL INBOUND                                   
//             SPACE=(20,(100,50),RLSE)                                         
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W611PD78),DISP=SHR                         
//SORTIN   DD  DSN=&&W61178,DISP=(OLD,DELETE,DELETE)                            
//*                                                                             
//SORTOUT  DD  DSN=&INDUT2..W61178(+1),                        -LIM(99)         
//             DISP=(NEW,CATLG,DELETE),                                         
//************ SORTERAD PERIOD INFO                                             
//             SPACE=(6177,(1000,500),RLSE),                                    
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//ICEGENER EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&&W6117H,DISP=(OLD,DELETE,DELETE)                            
//************ INTERNAL INBOUND                                                 
//         DD  DSN=&INDIN..W6121G,DISP=SHR                                      
//************ EXTERNAL INBOUND FOR US/CN (FROM W612V8-RTN)                     
//*                                                                             
//SYSUT2   DD  DSN=&INDUT3..W6117H(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)        
//             SPACE=(20,(100,50),RLSE),MGMTCLAS=&BACKUPC                       
//************ TOTAL FILE TO VIR                                                
//*                                                                             
