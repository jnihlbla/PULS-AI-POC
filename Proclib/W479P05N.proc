//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  KOMPLETTERAR DAGLIG FAKTURAHISTORIK MED AVERAGE COST                       
//*                                                                             
//*  FREKVENS:     DAG         RTN W479D2                                       
//*                                                                             
//*  ÅTERSTART:    W4795N    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W479P05N PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W479..W479D2,                                             
//             INDIN2=&W011,                                                    
//             INDUT=&W479..W479D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTDCAR),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN2..SDC.W01184(+0),DISP=SHR                             
//         DD  DSN=&INDIN2..NDC.W01184(+0),DISP=SHR                             
//SORTOUT  DD  DSN=&&W01184,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//************  SORTAD PÅ DC/ART                                                
//*                                                                             
//W4795N   EXEC PGM=V16459,PARM='W4795N/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W4795ND1 DD  DSN=&INDIN..W4795M(+0),DISP=SHR                                  
//************ DAGLIG FAKTURAHISTORIK                                           
//*                                                                             
//W4795ND2 DD  DSN=&&W01184,DISP=(OLD,DELETE,DELETE)                            
//************ ARTIKELINFORMATION (AVERAGE COST PRICE, TACK)                    
//*                                                                             
//W4795ND3 DD  DSN=&&W4795N,DISP=(NEW,PASS,DELETE),                             
//************ DAGLIG FAKTURAHISTORIK KOMPLETTERAD MED AVG COST                 
//             DATACLAS=PSEN                                                    
//SORT5N   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W479PD5N),DISP=SHR                         
//SORTIN   DD  DSN=&&W4795N,DISP=(OLD,DELETE,DELETE)                            
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W4795N(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&NOBACKUP                                               
//************  DAGLIG FAKTURAHISTORIK KOMPLETTERAD MED AVERAGE COST            
//************  SORTAD PÅ DC, PRC, ORDKL OCH DISTRIKT                           
//GENER1   EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDUT..W4795N(+1),DISP=(OLD,PASS,DELETE)                    
//************ KOPIA FÖR VECKOKÖRNING AV FAKTURERADE RADER                      
//*                                                                             
//SYSUT2   DD DSN=&INDUT..W4795NV(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************                                                                  
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//GENER2   EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDUT..W4795N(+1),DISP=(OLD,PASS,DELETE)                    
//************ KOPIA FÖR MÅNADSKÖRNING AV FAKTURERADE RADER                     
//*                                                                             
//SYSUT2   DD DSN=&INDUT..W4795NM(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************                                                                  
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
