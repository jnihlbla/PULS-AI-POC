//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W513P071 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W513..W513D2,                                             
//             INDUT=&W513..W513D2,                                             
//             INDUT1=&WXTR..W513D2                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51371   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W51371,W51371,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY,DCB=(RECFM=VB,BLKSIZE=1408,BUFNO=1)                        
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DUMMY                                                            
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDK6     INCLUDE MEMBER=WDK6                                                  
//W51371D1 DD  DSN=&INDUT..W51316(+1),DISP=(NEW,CATLG,DELETE), -LIM(10)         
//************ URVALSFIL W51316 - CDC                                           
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
//W51371D2 DD  DSN=&INDIN..W5137D(+0),DISP=SHR                                  
//************ ÅR FÖR SKAPANDE AV URVALSFIL                                     
//W51371D3 DD  DSN=&INDUT..W51371(+1),DISP=(NEW,CATLG,DELETE), -LIM(03)         
//************ URVALSFIL W51371 - CDC                                           
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//COPY     EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDUT..W51371(+1),DISP=SHR                                  
//************  FIL FRÅN TIDIGARE STEG                                          
//*                                                                             
//SYSUT2   DD  DSN=&INDUT1..SELREG(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ KOPIA AV W51371 TILL EXTERAL FILE                                
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
