//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  TO FIND UPDATED GATE FOR THE PART NUMBERS                                  
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W611D7                                         
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                W6118C      NORMAL                                           
//*                READS        WDT2                                            
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W611P08C PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN2=&W011..&RTEGRP.,                                          
//             INDUT=&W611..W611D7                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W611PD8C),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN2..W01160(+0),DISP=SHR                                 
//************ UNLOAD OF WDK6                                                   
//*                                                                             
//SORTOUT  DD  DSN=&&TEMP,DISP=(NEW,PASS,DELETE),                               
//************ SORTED FILE ON BEFT                                              
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W6118C   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W6118C,W6118C,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDT2     INCLUDE MEMBER=WDT2                                                  
//W6118CD1 DD  DSN=&&TEMP,DISP=SHR                                              
//************ PART NUMBERS WITH NEW GATE FROM WDT2                             
//W6118CD2 DD  DSN=&INDUT..W6118C(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ PART NUMBERS WITH NEW GATE FROM WDT2                             
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//W6118CD3 DD  DSN=&INDUT..W6118I(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ PART NUMBERS WITH NEW GATE FROM WDT2                             
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
