//W330P048 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W330..W330B1,                                             
//             INDUT=&W330..W330B1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT47   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W330PD47),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W33031(+0),DISP=SHR                                  
//************ URVALSFILEN                                                      
//*                                                                             
//SORTOUT  DD  DSN=&&W33031S,DISP=(NEW,PASS,DELETE),                            
//************ URVALSFIL SORTERAD I IDUSER TIREGDAT TIREGTID                    
//             SPACE=(6233,(5000,1000),RLSE)                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT2    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W330PD48),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W33047(+0),DISP=SHR                                  
//************ A1 OCH A2 RESULTAT                                               
//*                                                                             
//SORTOUT  DD  DSN=&&W33047S,DISP=(NEW,PASS,DELETE),                            
//************ A1 OCH A2 RESULTAT I IDUSER TIREGDAT, TID ,IDART                 
//             SPACE=(6110,(9000,5000),RLSE)                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33048   EXEC PGM=W33048                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DSN=&INDRTE..CONSTANT(W330PD5X),DISP=SHR                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W33048D1 DD  DSN=&&W33031S,DISP=(OLD,DELETE,DELETE)                           
//*                                                                             
//W33048D2 DD  DSN=&&W33047S,DISP=(OLD,DELETE,DELETE)                           
//*                                                                             
//W33048D3 DD  DSN=&INDUT..W33049(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ A1-RESULTAT + URVAL                                              
//             MGMTCLAS=DEL2,                                                   
//             VOL=(,,,3),SPACE=(23476,(1500,2000),RLSE)                        
//*                                                                             
//W33048D4 DD  DSN=&INDUT..W33051(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ A2-RESULTAT + URVAL                                              
//             MGMTCLAS=DEL2,                                                   
//             VOL=(,,,3),SPACE=(23476,(1500,2000),RLSE)                        
//*                                                                             
