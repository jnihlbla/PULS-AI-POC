//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W476P072 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN='W476.W476S8',                                             
//             INDUT='W476.W476S8'                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47672S  EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W476PD72),DISP=SHR                         
//*   PER  (FAKT,KOLLI,ART)                                                     
//SORTIN   DD  DSN=&INDIN..W47670(+0),DISP=SHR                                  
//SORTOUT  DD  DSN=&&W47671,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47672   EXEC PGM=V16459,PARM='W47672/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SYSOUT   DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//W47672D1 DD  DSN=&&W47671,DISP=(OLD,DELETE,DELETE)                            
//************ INFIL                                                            
//*                                                                             
//W47672D2 DD  DSN=&INDUT..W476L1(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED LISTA PÅ FÖRSTA FAKTURAN                               
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W47672D3 DD  DSN=&INDUT..W476L2(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED LISTA PÅ ANDRA FAKTURAN                                
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W47672D4 DD  DSN=&INDUT..W476L3(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED LISTA PÅ TREDJE FAKTURAN                               
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W47672D5 DD  DSN=&INDUT..W476L4(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED LISTA PÅ FJÄRDE FAKTURAN                               
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W47672D6 DD  DSN=&INDUT..W476L5(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED LISTA PÅ FEMTE  FAKTURAN                               
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W47672D7 DD  DSN=&INDUT..W476L6(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED LISTA PÅ SJÄTTE FAKTURAN                               
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W47672D8 DD  DSN=&INDUT..W476L7(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED LISTA PÅ SJUNDE FAKTURAN                               
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W47672D9 DD  DSN=&INDUT..W476L8(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED LISTA PÅ ÅTTONDE FAKTURAN                              
//**           SPACE=(121,(10,13),RLSE),AVGREC=K,                               
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
