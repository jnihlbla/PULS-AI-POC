//********************************************************************          
//***          BESTÄLLNINGSKÖRNING                                 ***          
//***          FIX-PROCEDURE                                       ***          
//***          UNDERHÅLLS AV STÖD 30650 (RICHARD)                  ***          
//***                                                              ***          
//********************************************************************          
//WDSFIX   PROC DSIN=DUMMY,DSOUT=DUMMY,SPACE='1,1',                             
//             LABEL='RETPD=1',MCL=,                                            
//             RECFM=,LRECL=,BLKSIZE=,                                          
//             STPLIB=&INDRTE..LOAD                                             
//GO      EXEC PGM=DSFIX                                                        
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=C,HOLD=YES                                                
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IN       DD  DSN=&DSIN,DISP=(OLD,PASS)                                        
//UT       DD  DSN=&DSOUT,DISP=(NEW,CATLG,DELETE),                              
//             DCB=(RECFM=&RECFM,LRECL=&LRECL,BLKSIZE=&BLKSIZE),                
//             MGMTCLAS=&MCL,LABEL=&LABEL,                                      
//             SPACE=(TRK,(&SPACE),RLSE)                                        
