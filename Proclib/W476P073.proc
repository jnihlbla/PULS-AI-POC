//W476P073 PROC STPLIB=&INDRTE..LOAD,                                           
//             DSIN=NULLFILE                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47673  EXEC PGM=V16459,PARM='W47673/8/'                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W47673D1 DD  DSN=&DSIN,DISP=SHR                                               
//************ INFIL                                                            
//*                                                                             
//CMDFILE  DD  DSN=&&CMD1,DISP=(,PASS)                                          
//*                                                                             
//MEMOFILE DD  DSN=&&MEMOA,DISP=(,PASS)                                         
//*                                                                             
//SEND   EXEC  WMEMOSND,                                                        
//             DSIN='&&MEMOA'                                                   
//APIFILE  DD  DSN=&&CMD1,DISP=(OLD,DELETE)                                     
//SEND     DD  DISP=(OLD,DELETE)                                                
//*                                                                             
