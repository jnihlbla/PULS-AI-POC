//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  DAILY OUTPUT OF INVOICE LINES FOR HANDLING FEE CODE                        
//*  72, 98 AND RETURN-OF-RETURN.                                               
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W418D4                                         
//*                                                                             
//*  RESTART:      W4183B    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W418P03B PROC STPLIB=&INDRTE..LOAD,                                           
//*                                                                             
//             INDIN=&W418..W418D4,                                             
//             INDUT=&W418..W418D4                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W4183B   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W4183B,W4183B,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W4183BD1 DD  DSN=&INDIN..W418AT,DISP=SHR                                      
//************ HANLINF FEE LINES CODE 72 AND 98                                 
//*                                                                             
//         DD  DSN=&INDIN..W418AV(+0),DISP=SHR                                  
//************ HANDLING FEE LINES FOR RETURN-OF-RETURN                          
//*                                                                             
//W4183BD2 DD  DSN=&INDUT..W418AW(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ DATE FOR CLEAN UP PROGRAM IN TP8LRET/PGM W418LRQ1                
//************ OVERRIDE I JCL TILL: W418.REOR.DAEXDAT7(+1)                      
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W4183BD3 DD  DSN=&INDUT..W418AX(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ LOAD DATA FOR TABLE TP8LRET                                      
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
//W4183BD4 DD  DSN=&INDUT..W418AY(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ LOAD DATA FOR TABLE TP8LRET                                      
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
