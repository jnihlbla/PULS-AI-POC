//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  EXECUTES W42855 PGM WHICH GENERATES PERIODIC MANAGEMENT REPORT             
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W428R1                                         
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                          NORMAL                                             
//*                W42855    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W428P055 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W428..W428R1,                                             
//             INDUT=&W428..W428R1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT01   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W428PD52),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W4285A,DISP=SHR                                      
//************ W4285A FILE                                                      
//*                                                                             
//SORTOUT  DD  DSN=&&W4285AT,DISP=(NEW,PASS,DELETE),                            
//************ W4285A SORTED FILE                                               
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT02   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W428PD55),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W4285B(+0),DISP=SHR                                  
//************ W4285B FILE                                                      
//*                                                                             
//SORTOUT  DD  DSN=&&W4285BT,DISP=(NEW,PASS,DELETE),                            
//************ W4285B SORTED FILE                                               
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W42855   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W42855,W42855,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR             -- DATKORT           
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR         -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDB6     INCLUDE MEMBER=WDB6                                                  
//W42855D1 DD  DSN=&&W4285AT,DISP=(OLD,DELETE,DELETE)                           
//************ W4285A SORTED FILE                                               
//*                                                                             
//W42855D2 DD  DSN=&&W4285BT,DISP=(OLD,DELETE,DELETE)                           
//************ W4285B SORTED FILE                                               
//*                                                                             
//W42855D3 DD  DSN=&INDUT..W428551(+1),DISP=(NEW,CATLG,DELETE), -LIM(5)         
//************ REPORT FILE                                                      
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
