//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  EXTRACT R30/R31/310 FROM WDL6                                              
//*                                                                             
//*  FREQUENCE:    MONTHLY   RTN W512M2                                         
//*                                                                             
//*  RESTART:      W51262    NORMAL                                             
//*                READS     WDL6                                               
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W512P062 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W512..W512M2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51262   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W51262,W51262,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDL6     INCLUDE MEMBER=WDL6                                                  
//WDK7     INCLUDE MEMBER=WDK7                                                  
//WDB6     INCLUDE MEMBER=WDB6                                                  
//WDF1     INCLUDE MEMBER=WDF1                                                  
//W51262D1 DD  DSN=&INDUT..W51262(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ R30 FROM WDL6 VCC                                                
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//W51262D2 DD  DSN=&INDUT..W51280(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ R30 FROM WDL6 FOR NON VCC DC'S FROM 1441                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//W51262D3 DD  DSN=&INDUT..W51280A(+1),                        -LIM(1)          
//************ 310 FROM WDL6 FOR NON VCC DC'S FROM 1441                         
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//W51262D4 DD  DSN=&INDUT..W51280B(+1),                        -LIM(1)          
//************ R31 FROM WDL6 FOR NON VCC DC'S FROM 1441                         
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//W51262D5 DD  DSN=&INDUT..W51280BA(+1),                       -LIM(1)          
//************ R30 310 R31 FROM WDL6 FOR NON VCC DC'S NOT 1441                  
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W51262D6 DD  DSN=&INDUT..W51280BC(+1),                        -LIM(1)         
//************ R30 310 R31 FROM WDL6 FOR US DC'S NOT 1441                       
//             DISP=(NEW,CATLG,DELETE),                                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
