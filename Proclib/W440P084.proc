//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W44084D1 DD  DSN=&INDIN..W4408A(+0),DISP=SHR                                  
//************ INFIL TOTALT RO SORTERAD PÅ ARTNR                                
//*                                                                             
//TEMPFIL1 DD  DSN=&&TEMP1,DISP=(NEW,DELETE,DELETE),                            
//             DATACLAS=PSEN                                                    
//*                                                                             
//W44084D2 DD  DSN=&INDIN2..W01160(+0),DISP=SHR                                 
//************ LAGERBANDET                                                      
//*                                                                             
//TEMPFIL2 DD  DSN=&&TEMP2,DISP=(NEW,DELETE,DELETE),                            
