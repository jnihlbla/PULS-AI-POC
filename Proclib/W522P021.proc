//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES VAT-FILE TO DIFFERENT COUNTRIES                                    
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W522M1                                       
//*                                                                             
//*  RESTART:      W52221      NORMAL  (BMP)                                    
//*                                                                             
//*  READS:        WDG2                                                         
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W522P021 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=1,                                                           
//             INDIN=&W522..W522M1,                                             
//             INDUT=&W522..W522M1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W52221   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W52221,W52221,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//*                                                                             
//W52221D1 DD  DSN=&INDIN..W52202(+0),DISP=SHR                                  
//************ INFIL                                                            
//*                                                                             
//W52221D2 DD  DSN=&INDUT..W52221(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED VATINFO TILL ONDEMAND                                  
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W52221D3 DD  DSN=&INDUT..W52223(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED VATINFO SOM SKA SPARAS                                 
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W52221D4 DD  DSN=&INDUT..W52225(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED VATINFO SOM SKA SKICKAS MED D&P                        
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
