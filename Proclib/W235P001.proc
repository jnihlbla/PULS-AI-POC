//*                                                                   *         
//*      UPPDATERING AV LEVERANTÖRSBEDÖMNINGSREGISTER.                *         
//*                                                                   *         
//*      PERIODICITET: PLANERINGSPERIOD                               *         
//*                                                                   *         
//*      ÅTERSTART:    NORMAL                                         *         
//*                                                                   *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W235P001 PROC INDIN=&W235..W200P1,INDUT=&W235..W200P1,                        
//             INDIN2=&W236..W200P1,                                            
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W23502  EXEC PGM=W23502                                                       
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SORTMSG  DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*       UTSKRIFT AV RÄKNEVERK (POSTSUM)                   
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//W23502D1 DD  DSN=&INDIN..W23501(+0),DISP=SHR                                  
//************** LEV.BEDÖMNINGSREGISTER IN                          ***         
//*                                                                             
//W23502D2 DD  DSN=&INDIN2..W23603(+0),DISP=SHR                                 
//************** TRANSAR FRÅN W236P002                              ***         
//*                                                                             
//W23502D3 DD  DSN=&INDUT..W23501(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************** LEV.BEDÖMNINGSREGISTER UT                          ***         
//             SPACE=(6216,(50,10),RLSE),                                       
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
