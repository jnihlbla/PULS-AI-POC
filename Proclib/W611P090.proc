//************ SB FIL AV W6D1                                                   
//*                                                                             
//W61190D3 DD  DSN=&&W61190A,DISP=(NEW,PASS,DELETE),                            
//************ CD-ARTIKLAR                                                      
//             DATACLAS=PSEN                                                    
//*                                                                             
//W61190D4 DD  DSN=&&W61190B,DISP=(NEW,PASS,DELETE),                            
//************ SORTAD                                                           
