//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  REPORT FILE WITH FC ALARM FOR SLOW MOVING REFILL                           
//*  PARTS                                                                      
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W271D9                                         
//*                                                                             
//*  RESTART:      W2713910  NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W271P139 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W271..W271D9,                                             
//             INDUT=&W271..W271D9                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* EXTRACT ALL REFILL PARTS                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT01   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W271PD39),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W27139C(+0),DISP=SHR                                 
//************ SLOW MOVING PARTS FC ALARM                                       
//*                                                                             
//SORTOUT  DD  DSN=&&W27139C,DISP=(NEW,PASS,DELETE),                            
//********     SLOW MOVING REFILL PARTS FC ALARM                                
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W27139   EXEC PGM=W27139                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W27139D1 DD  DSN=&&W27139C,DISP=(OLD,DELETE,DELETE)                           
//************ SLOW MOVING PARTS FILE WITH NEW FC ALARM                         
//*                                                                             
//W27139D2 DD  DSN=&INDUT..W271393(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//************ REPORT FILE - W27139-003                                         
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
