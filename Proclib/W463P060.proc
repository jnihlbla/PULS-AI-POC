//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  DIRECT BUSINESS. RECEIVES FILES FROM VCOM, SENT FROM                       
//*  IMS ADVANSYS.                                                              
//*                                                                             
//*  FREQUENCE:    SEVERAL TIMES A DAY     RTN W463X5                           
//*                                                                             
//*  RESTART:      W46360    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W463P060 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W463..W463X5DE,                                           
//             INDUT=&W463..W463X5                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W46360   EXEC PGM=W46360                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W46360D1 DD  DSN=&INDIN..W46360(+0),DISP=SHR                                  
//************ BILLING TRANSACTION, RECEIVED FROM VCOM                          
//*                                                                             
//W46360D2 DD  DSN=&INDUT..W46361(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ BILLING TRANSACTIONS TO CONTROL ROUTINE                          
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
