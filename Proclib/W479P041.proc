//*  TO CREATE REPORTS WITH ORDER STATUS AS 'E'                                 
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W479D4                                         
//*                                                                             
//*  RESTART:      W47941    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W479P041 PROC STPLIB=&INDRTE..LOAD, -- TA EV BORT KOMMA                       
//*                                                                             
//             INDIN=&W479..W479D4                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W479PD41),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W479401(0),DISP=SHR                                  
//************ LISTFIL                                                          
//*                                                                             
//SORTOUT  DD  DSN=&&W47940,DISP=(NEW,PASS,DELETE),                             
//************ SORTERAD W61247                                                  
//         SPACE=(63,(1,3),RLSE),AVGREC=K                                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47941   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W47941,W47941,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W47941D1 DD  DSN=&&W47940,DISP=(OLD,DELETE,DELETE)                            
//************ INPUT FILE FROM W4794000                                         
//*                                                                             
