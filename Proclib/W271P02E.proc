//*                                                                             
//*  UPPDATERAR W01160 MED SENASTE TISTOREF                                     
//*                                                                             
//*  FREQUENCE:    WEEKLY    RTN W271V6                                         
//*                                                                             
//*  RESTART:      W2712E    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W271P02E PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W271..W271V6,                                             
//             INDIN2=&W011..&RTEGRP.,                                          
//             INDUT=&W271..W271V6                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W2712E   EXEC PGM=V16459,PARM='W2712E/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W2712ED1 DD  DSN=&INDIN..W27198(+0),DISP=SHR                                  
//************ FIL MED TISTOREF SOM UPPDATERATS I W271V6                        
//*                                                                             
//W2712ED2 DD  DSN=&INDIN2..W01160(+0),DISP=SHR                                 
//************ W01160                                                           
//*                                                                             
//W2712ED3 DD  DSN=&INDUT..W2712E(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ UPPDATERAD W01160 MED SENASTE TISTOREF                           
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
