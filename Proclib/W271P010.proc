//************ ARTIKLAR FÖR UPPDATERING PÅ WDK7 WDL7 WDK6                       
//             SPACE=(20,(10,1),RLSE),AVGREC=K,                                 
//             MGMTCLAS=&BACKUPC                                                
//W27110D4 DD  DSN=&INDUT..W271F1(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ ARTIKLAR FÖR UPPDATERING PÅ WDK7 DELAY DATUM                     
//             MGMTCLAS=BACKUPC,DATACLAS=PSEN                                   
