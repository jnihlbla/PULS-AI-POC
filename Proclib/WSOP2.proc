//WSOP    PROC COMMAND=SYSIN,STPLIB=&INDRTE..LOAD,                              
//             SOPREG=&INDRTE..SOP,                                             
//             PDSLIB=&INDRTE..JCL,                                             
//             PDSTEMP=&INDRTE.TMP.JCL                                          
//*                                                                             
//W98022  EXEC PGM=V164D0                                                       
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//IN       DD  DUMMY                                                            
//UT       DD  DSN=&&INPUT,DISP=(NEW,PASS,DELETE),                              
//             RECFM=FB,LRECL=80,BLKSIZE=800                                    
//*                                                                             
//W9802X  EXEC PGM=W98022,                                                      
//             PARM='&COMMAND./'                                                
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//SYSUDUMP DD  SYSOUT=*                                     -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//W98022D1 DD  DDNAME=SYSIN                                                     
//SOPDD1   DD  DSN=&SOPREG,DISP=SHR            -- SOP DATA BASE                 
//PDSDD1   DD  DSN=&PDSTEMP,DISP=SHR           -- TEMP PDS JOB LIB              
//PDSDD2   DD  DSN=&PDSLIB,DISP=SHR            -- PDS JOB LIB                   
//SYSIN    DD  DSN=&&INPUT,DISP=(OLD,DELETE)                                    
