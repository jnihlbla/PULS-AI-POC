//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  DISTRIBUTES FILE WITH ACCOUNT/COST-CTR/ORDERNO/CUSTOMER/VAT                
//*      TO PULS                                                                
//*  FREQUENCE:    DAY       RTN WF10D2                                         
//*                                                                             
//*  RESTART:      WF1014    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WF10P014 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=1,                                                           
//             INDIN=&WF10..WF10D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WF1014   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,WF1014,WF1014,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//************ ACCOUNT FILE                                                     
//WF1014D1 DD  DSN=&INDIN..WF1014(+0),DISP=SHR                                  
//*                                                                             
//************ COST-CTR FILE                                                    
//WF1014D2 DD  DSN=&INDIN..WF1015(+0),DISP=SHR                                  
//*                                                                             
//************ ORDERNO FILE                                                     
//WF1014D3 DD  DSN=&INDIN..WF1016(+0),DISP=SHR                                  
//*                                                                             
//************ CUSTOMER FILE                                                    
//WF1014D4 DD  DSN=&INDIN..WF1018(+0),DISP=SHR                                  
//*                                                                             
//************ VAT CODES FILE                                                   
//WF1014D5 DD  DSN=&INDIN..WF1017(+0),DISP=SHR                                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
