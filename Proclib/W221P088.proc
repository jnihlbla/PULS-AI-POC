//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  FÖR DE LEVERANTÖRER SOM SKALL HA LEVPLANER DENNA GÅNG:                     
//*  UPPDATERAR PÅ XXBL ARTIKLAR MED BESTREST > 0   (ROT 2217J)                 
//*                                                                             
//*  FREKVENS:     DAG    RTN W221D5                                            
//*                                                                             
//*  ÅTERSTART:    SORT1     NORMAL                                             
//*                SORT2     NORMAL                                             
//*                W22188    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W221P088 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W221..W221D5,                                             
//             INDIN2=&W221..W221D5.D4,                                         
//             INDIN3=&W221..W221D5.V2,                                         
//             CPU=1                                                            
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W221PD86),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN2..W22186(+0),DISP=SHR                                 
//************ LEVNR FRÅN DAG  W221D4                                           
//*                                                                             
//         DD  DSN=&INDIN3..W22186(+0),DISP=SHR                                 
//************ LEVNR FRÅN VEC  W221V2 (OM VECKO-KÖRNING)                        
//*                                                                             
//SORTOUT  DD  DSN=&&W22186,DISP=(NEW,PASS,DELETE),                             
//************ SORTERADE LEVNR                                                  
//         SPACE=(3,(200,600),RLSE),AVGREC=U                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT2    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W221PD87),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W22187(+0),DISP=SHR                                  
//************ ART MED BESTREST > 0                                             
//*                                                                             
//SORTOUT  DD  DSN=&&W22187,DISP=(NEW,PASS,DELETE),                             
//************ SORTERADE LEVNR, ARTNR MED BESTREST > 0                          
//         SPACE=(8,(5,15),RLSE),AVGREC=K                                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W22188   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W22188,W22188,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W22188D1 DD  DSN=&&W22186,DISP=(OLD,DELETE,DELETE)                            
//************ LEVNR SOM SKALL HA LEVPLAN                                       
//*                                                                             
//W22188D2 DD  DSN=&&W22187,DISP=(OLD,DELETE,DELETE)                            
//************ ART MED BESTREST > 0                                             
//*                                                                             
