//*      HOPSAMLING TRANSAR FRÅN KRINGSYSTEM                          *         
//*                                                                   *         
//*      PERIODICITET: PLANERINGSPERIOD                               *         
//*                                                                   *         
//*      ÅTERSTART:    NORMAL                                         *         
//*                                                                   *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W231P007 PROC INDIN=&W231..W231P1,INDREG=&W231,                               
//             INDUT=&W231..W231P1,                                             
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W23132  EXEC PGM=SORT                                                         
//SORTIN   DD  DSN=&INDIN..W23191,DISP=SHR                                      
//************** TRANSAR FRÅN ORDERSYSTEMEN                         ***         
//*                                                                             
//         DD  DSN=&INDIN..W23111(+0),DISP=SHR                                  
//************** TRANSAR FRÅN INLEVERANSSYSTEMET                    ***         
//*                                                                             
//         DD  DSN=&INDIN..W23133(+0),DISP=SHR                                  
//************** INVENTERINGAR UNDER PERIODEN                       ***         
//*                                                                             
//SORTOUT  DD  DSN=&&W23137,DISP=(NEW,PASS,DELETE),                             
//************** STATISTIKPOST, LAGERFÖRÄNDRING                     ***         
//             SPACE=(6224,(2130,300),RLSE),                                    
//             VOL=(,,,2)                                                       
//*                                                                             
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W23132),DISP=SHR                           
//SORTMSG  DD  SYSOUT=*                                                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W23134  EXEC PGM=W23134                                                       
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*       UTSKRIFT AV RÄKNEVERK (POSTSUM)                   
//W23134D1 DD  DSN=&&W23137,DISP=(OLD,DELETE,DELETE)                            
//*                                                                             
//W23134D2 DD  DSN=&INDREG..W23135(+0),DISP=SHR                                 
//************** REGISTER, STAT. LAGERFÖRÄNDRING                    ***         
//*                                                                             
//W23134D3 DD  DSN=&INDREG..W23135(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************** REGISTER, STAT. LAGERFÖRÄNDRING                    ***         
//             SPACE=(6048,(3600,400),RLSE),                                    
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//W23134D4 DD  DSN=&INDUT..W23136(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//**************   TRANS, LAGERRÖRELSE I PERIOD                     ***         
//             SPACE=(6144,(2700,400),RLSE),                                    
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
