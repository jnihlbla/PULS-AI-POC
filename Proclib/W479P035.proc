//*                                                                             
//*  MANAGEMENT ACCUMULATED NIL PICKS AND DEVIATIONS WEEKLY FOLLOW UP           
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W479M1                                         
//*                                                                             
//*  RESTART:      W47935    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W479P035 PROC STPLIB=&INDRTE..LOAD, -- TA EV BORT KOMMA                       
//*                                                                             
//             INDIN=&W479..W479M1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W479PD35),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W47936(+0),DISP=SHR                                  
//*                                                                             
//SORTOUT  DD  DSN=&&W47936,DISP=(NEW,PASS,DELETE),                             
//************ SORTED ON KDMFUP/DC                                              
//         SPACE=(58,(500,33),RLSE),AVGREC=K                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47935   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W47935,W47931,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W47935D1 DD  DSN=&&W47936,DISP=(OLD,DELETE,DELETE)                            
//************ INPUT TO W47935                                                  
//*                                                                             
//*OUTPUT GÅR DIREKT TILL D&P I WEB.                                            
