//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES D&P LIST FOR ADJUSTMENT REPORT                                     
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W560D1                                         
//*                                                                             
//*  RESTART:      W56072    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W560P072 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W513..W560D1,                                             
//             INDUT=&W560..W560D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W560PD72),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W5134P,DISP=SHR                                      
//************ ALL GENS OF W5134P FROM W510D2                                   
//*                                                                             
//SORTOUT  DD  DSN=&&W5134P,DISP=(NEW,PASS,DELETE),                             
//************ SORTED W5134P                                                    
//         DATACLAS=PSEN                                                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56072   EXEC PGM=V16459,PARM='W56072/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//W56072D1 DD  DSN=&&W5134P,DISP=(OLD,DELETE,DELETE)                            
//************ SORTED FILE                                                      
//*                                                                             
//W56072D2 DD  DSN=&INDUT..W56072(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//************ D&P LIST ADJ-DAILY FOR ADJUSTMENT REPORT                         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
