//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  READS DISCREPANCY FILE DEPENDING ON INPUT VIA SOP FROM                     
//*  MPP W40703.                                                                
//*                                                                             
//*  FREQUENCE:    DAILY    RTN W428V1                                          
//*                                                                             
//*  RESTART:      W42860      NORMAL                                           
//*                READS  WDA2                                                  
//*                       WDD3                                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W428P060 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W428..W428S1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W42860   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W42860,W42860,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDD3     INCLUDE MEMBER=WDD3                                                  
//WDA2     INCLUDE MEMBER=WDA2                                                  
//W42860D1 DD  DSN=&INDUT..W42861(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ INVENTORY RECORDS TO BE PRINTED IN E+ PGM       W428P061         
//             SPACE=(64,(2,1),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&DEL2BKPC                                               
//W42860D2 DD  DSN=&INDUT..W42863(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ PACKING RECORDS TO BE PRINTED IN E+ PGM         W428P062         
//             SPACE=(81,(2,1),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&DEL2BKPC                                               
