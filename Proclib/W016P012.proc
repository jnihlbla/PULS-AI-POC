//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W016P012 PROC STPLIB=&INDRTE..LOAD,INDABE=&INDRTE,                            
//             VCOMPARM=SAKNAS,INDVCOM=&INDGRND                                 
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W01612   EXEC PGM=W01612                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//SYSPRINT DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDABE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//W01612D1 DD  DUMMY                                                            
//***          VCOM-ID ANGES I JCL SOM ORDER-INFO FRÅM SOP                      
//W01612D2 DD  DSN=&INDVCOM..VCOMPARM(&VCOMPARM),DISP=SHR                       
//***          STYWINFO TILL W01612 (VCOM-MOTTAGNING)                           
//W016XXD1 DD  DUMMY                                                            
//***          FIL FRÅN VCOM                                                    
//***          DSN,DISP,SPACE,DCB(RECFM,LRECL),MGMTCLAS                         
//***          ANGES I JCL:EN                                                   
//W01612D3 DD  DUMMY                                                            
//***          FIL MED INFORMATION FRÅN VCOM VID KDCALL = 003                   
