//*  SKAPAR MÅNATLIG TULLISTA FÖR HOLLÄNDSKA IMP:ER                             
//*                                                                             
//*  FREKVENS:     MÅNAD    RTN W475M1                                          
//*                                                                             
//*  ÅTERSTART:              NORMAL                                             
//*                W47543    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W475P043 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W475..W475M1,                                             
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W475PD43),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W47587,DISP=SHR                                      
//************ HOLLÄNDSK TULLFIL                                                
//*                                                                             
//SORTOUT  DD  DSN=&&W47587,DISP=(NEW,PASS,DELETE),                             
//************ TULLFIL SORTERAD PÅ STATNR                                       
//         SPACE=(6233,(50,10),RLSE),AVGREC=K                                   
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47543   EXEC PGM=V16459,PARM='W47543/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//*                                                                             
//OUT1  OUTPUT CLASS=A,FORMS=3803,FORMDEF=SLSR6C,PAGEDEF=SLSR6C                 
//*                                                                             
//W47543D1 DD  DSN=&&W47587,DISP=(OLD,DELETE,DELETE)                            
//************ TEMP TULLFIL SORTERAD PÅ STATNR                                  
//*                                                                             
//W47543D2 DD  SYSOUT=(,),OUTPUT=(*.OUT1),DEST=&DEST1                           
//************ W47543-001    LISTA PER STATNR                                   
//************ W47543-001NL  LISTA PER STATNR                                   
//*                                                                             
