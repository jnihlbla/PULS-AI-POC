//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  EXECUTES PROGRAM WHICH GENERATES THE PERIODICAL                            
//*  DEALER RETURN FOLLOW UP REPORT: W42852-001                                 
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W428R1                                         
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                W42852    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W428P052 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W428..W428R1,                                             
//             INDUT=&W428..W428R1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W428PD52),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W4285A,DISP=SHR                                      
//SORTOUT  DD  DSN=&&W42852,DISP=(NEW,PASS,DELETE),                             
//************ FILE SORTED ON KDMFUP, IDDC AND KDANMORS                         
//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W42852   EXEC PGM=W42852                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//W42852D1 DD  DSN=&&W42852,DISP=(OLD,DELETE,DELETE)                            
//************ SORTED FILE FROM THE ABOVE STEP                                  
//*                                                                             
//W42852D2 DD  DSN=&INDUT..W428521(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ OUTPUT PERIODICAL DEALER FOLLOW UP FILE                          
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
