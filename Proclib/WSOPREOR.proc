//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  GÖR UNLOAD OCH RELOAD PÅ EN SOPDATABAS                                     
//*                                                                             
//*  FREKVENS:     SUBMITTAS FRÅN FUNKTION SOPREORG                             
//*                                                                             
//*  ÅTERSTART:    W98050    NORMAL                                             
//*                DFUP   NORMAL                                                
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WSOPREOR PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W980..W980B1,                                             
//             SOPREG=&INDRTE..SOP                                              
//*                                                                             
//BI       EXEC PGM=WGDGDEF,PARM=('&INDUT.',W98050,3)                           
//STEPLIB  DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                                         
//WGDGDED1 DD  DSN=&&TEMP1                                                      
//WGDGDED2 DD  DSN=&&TEMP2                                                      
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* LISTA SOPDATABASEN                                                          
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W98050   EXEC PGM=W9805000                                                    
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W98050D1 DD  DSN=&SOPREG,DISP=SHR                                             
//************ SOPDATABAS                                                       
//*                                                                             
//W98050D2 DD  DSN=&INDUT..W98050(+1),DISP=(NEW,PASS,DELETE),                   
//************ LISTAD SOPDATABAS                                                
//             MGMTCLAS=&BACKUPC,                                               
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//CATLG   EXEC PGM=IEFBR14                                                      
//CB3XXX01 DD DSN=&INDUT..W98050(+1),DISP=(OLD,CATLG,DELETE)                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* LÄGG TILL RANDOMNYCKEL                                                      
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W98052   EXEC PGM=W98052                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W98052D1 DD  DSN=&INDUT..W98050(+1),DISP=SHR                                  
//************ SOP-UNLOADFIL                                                    
//*                                                                             
//W98052D2 DD  DSN=&&TEMP,DISP=(NEW,PASS,DELETE),                               
//************ UNLOADFIL MED RANDOMNYCKEL TILL VARJE DATA-NYCKEL                
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* SORTERA OM NYCKLARNA                                                        
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W980PD52),DISP=SHR                         
//SORTIN   DD  DSN=&&TEMP,DISP=(OLD,PASS,DELETE)                                
//************ GF                                                               
//*                                                                             
//SORTOUT  DD  DSN=&&TEMP2,DISP=(NEW,PASS,DELETE),                              
//************ SORTERAD UNLOADFIL                                               
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* LADDA SOPDATABSEN                                                           
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W98054   EXEC PGM=W98054                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W98054D1 DD  DSN=&&TEMP2,DISP=(OLD,PASS,DELETE)                               
//************ LISTAD SOPDATABAS                                                
//*                                                                             
//SOPDD1 DD  DSN=&SOPREG,DISP=SHR                                               
//************ SOPDATABAS                                                       
//*                                                                             
