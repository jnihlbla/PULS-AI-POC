//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W221P062 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W221..W221D2,                                             
//             INDUT=&W221..W221D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W221PD62),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W22160(+0),DISP=SHR                                  
//************ FIL MED ARTIKLAR                                                 
//*                                                                             
//SORTOUT  DD  DSN=&&W22160,DISP=(NEW,PASS,DELETE),                             
//************ SORTERAD FIL                                                     
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W22162   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W22162,W22162,,00')                                  
//STEPLIB  DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(0),DISP=SHR               -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDF1     INCLUDE MEMBER=WDF1                                                  
//WDL2     INCLUDE MEMBER=WDL2                                                  
//WDD9     INCLUDE MEMBER=WDD9                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDF5     INCLUDE MEMBER=WDF5                                                  
//*                                                                             
//W22162D1 DD  DSN=&&W22160,DISP=(OLD,DELETE,DELETE)                            
//*                                                                             
//W22162D2 DD  DSN=&INDUT..W22162(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ UTFIL TILL INTERBRIDGEN (VOLVO DATA)                             
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
