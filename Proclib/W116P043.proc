//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  MATCH SUPERSESSION FILE WITH PARTS MASTER FILES TO                         
//*  GET STOCK BALANCE IN EU                                                    
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W116D3                                         
//*                                                                             
//*  RESTART:                                                                   
//*                W11643    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W116P043 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W116..W116D3,                                             
//             INDIN2=&W011..&RTEGRP.,                                          
//             INDIN3=&W011..LDC,                                               
//             INDIN4=&W011..SDC,                                               
//             INDUT=&W116..W116D3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W011PD60),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W11641(+0),DISP=SHR                                  
//************ SORT INPUT SUPERSESSION FILE                                     
//*                                                                             
//SORTOUT  DD  DSN=&&W11641X,DISP=(NEW,PASS,DELETE),                            
//************ TEMP FILE                                                        
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT2    EXEC PGM=SORT,REGION=8M                                              
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W011PD60),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN2..W01160(+0),DISP=SHR                                 
//************ SORT PARTS FILE FOR CDC                                          
//*                                                                             
//SORTOUT  DD  DSN=&&W01160A,DISP=(NEW,PASS,DELETE),                            
//************ TEMP FILE                                                        
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT3    EXEC PGM=SORT,REGION=8M                                              
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W116PD43),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN3..W01184(+0),DISP=SHR                                 
//         DD  DSN=&INDIN4..W01184(+0),DISP=SHR                                 
//************ SORT PART FILE FOR XDC                                           
//*                                                                             
//SORTOUT  DD  DSN=&&W01184A,DISP=(NEW,PASS,DELETE),                            
//************ TEMP FILE                                                        
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11643   EXEC PGM=V16459,PARM='W11643/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//W11643D1 DD  DSN=&&W11641X,DISP=(OLD,DELETE,DELETE)                           
//************ TEMP SUPERSESSION FILE                                           
//*                                                                             
//W11643D2 DD  DSN=&&W01160A,DISP=(OLD,DELETE,DELETE)                           
//************ TEMP PART MASTER FILE                                            
//*                                                                             
//W11643D3 DD  DSN=&&W01184A,DISP=(OLD,DELETE,DELETE)                           
//************ TEMP PARTS FILE XDCS                                             
//*                                                                             
//W11643D4 DD  DSN=&INDUT..W11641A(+1),DISP=(NEW,CATLG,DELETE),                 
//************ SUPERSESSION FILE WITH STOCK BALANCE                             
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
