//             INDUT=&W479..W479V2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W479PD5R),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W47952(+0),DISP=SHR                                  
//************ ORDER I ARBETE                                                   
//*                                                                             
//SORTOUT  DD  DSN=&&W47952,DISP=(NEW,PASS,DELETE),                             
