//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W330PD12),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W33018(+0),DISP=SHR                                  
//************ INFIL W33018                                                     
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W33018(+1),DISP=(NEW,CATLG,DELETE),                  
//************ SORTAD W33018 S&T                                                
