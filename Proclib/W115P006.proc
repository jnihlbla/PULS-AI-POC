//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*  STEP1: SB/DL1                                                              
//*  STEP2: EPLUS                                                               
//*                                                                             
//*  FREKVENS:     FLERA GGR PER DAG    RTN W115S1                              
//*                ANROPAS FRÅN         JOB W115JPV6                            
//*                                                                             
//*  ÅTERSTART:    W11505   NORMAL                                              
//*                                                                             
//*                W11506   NORMAL                                              
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W115P006 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W115..W115S1,                                             
//             DEST1=&CPRINT,SYSOUT='(A,,3803)'                                 
//* +-----------------------------------------------------------------+         
//* !                                                                 !         
//* ! DENNA PROCEDUR KÖRS FÖR JOBB SOM SKALL PRINTAS PÅ VOLVO-DATA    !         
//* !                 ANNARS KÖRS W115P005                            !         
//* !                                                                 !         
//* !OBSERVERA ATT OM LISTAN INTE KOMMER UT PÅ PRINTERN, KAN DET VARA !         
//* !ATT LINES-LIMIT FÖR DEN SKRIVAREN ÄR ÖVERSKRIDEN.                !         
//* !LISTAN LIGGER DÅ PÅ PRINTERKÖN MED KLASS ÄNDRAD TILL '8'         !         
//* !                                                                 !         
//* +-----------------------------------------------------------------+         
//GENER1  EXEC PGM=V16459,PARM='ICEGENER/3/'                                    
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DDNAME=KORTIN                                                    
//SYSUT2   DD  DSN=&&SYSIN,DISP=(NEW,PASS,DELETE),                              
//************** SYSIN-KORT                                                     
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800),                             
//             SPACE=(800,(1))                                                  
//*                                                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11505   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W11505,W11505,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY,DCB=(RECFM=VB,BLKSIZE=1408,BUFNO=1)                        
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM1K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM2K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                      -- DISPLAY         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                      -- POSTSUM         
//WDD2     INCLUDE MEMBER=WDD2                                                  
//WDD3     INCLUDE MEMBER=WDD3                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDG2     INCLUDE MEMBER=WDG2                                                  
//WDD7     INCLUDE MEMBER=WDD7                                                  
//W11505D1 DD  DSN=&&SYSIN,DISP=(OLD,PASS,DELETE)                               
//************ SYSIN-KORT                                                       
//*                                                                             
//W11505D2 DD  DSN=&INDUT..W11505(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ TEMP. SEKV-FIL TILL EPLUS-PGM                                    
//             SPACE=(214,(200,20),RLSE),AVGREC=K,                              
//             MGMTCLAS=DEL2                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11506   EXEC PGM=V16459,PARM='W11506/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(500,200))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DUMMY                                                            
//W11506D1 DD  DSN=&&SYSIN,DISP=(OLD,DELETE,DELETE)                             
//************ SYSIN-KORT                                                       
//*                                                                             
//W11506D2 DD  DSN=&INDUT..W11505(+1),DISP=SHR                                  
//************ INFIL FRÅN W11505-STEGET                                         
//*                                                                             
//A4LF OUTPUT FORMDEF=SLSR6C,PAGEDEF=SLSR6C                                     
//*                                                                             
//W11506D3 DD  SYSOUT=&SYSOUT,DEST=&DEST1,OUTPUT=(*.A4LF)                       
//************ W11506-001  BASIC STOCK LIST                                     
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *           
