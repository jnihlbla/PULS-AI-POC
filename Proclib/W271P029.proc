//             INDUT=&W271..W271B2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W271PD29),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W27128(+0),DISP=SHR                                  
//************ ARTIKELFIL                                                       
//*                                                                             
//SORTOUT  DD  DSN=&&W27128,DISP=(NEW,PASS,DELETE),                             
