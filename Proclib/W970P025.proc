//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W970P025 PROC MEMBER=TEMPNAME,                                                
//             INDIN=&W970..W970B9,INDEX=W,                                     
//             USERID=VDUMMY,GROUP=ISPF                                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W970PD25),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W97024(+0),DISP=SHR                                  
//************ FIL MED ALLA LV-USER                                             
//         DD  DSN=&INDIN..W97025(+0),DISP=SHR                                  
//************ FIL MED ALLA PV-USER                                             
//*                                                                             
//SORTOUT  DD  DSN=&&W97024S,DISP=(NEW,PASS,DELETE),                            
//************ SORTERAD FIL MED USERS                                           
//         SPACE=(30,(80,40),RLSE),AVGREC=K                                     
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//TSO    EXEC  PGM=IKJEFT01,DYNAMNBR=35                                         
//*                                                                             
//ISPPLIB  DD  DSN=&INDEX..&GROUP..PANELS,DISP=SHR        * APPL   MENU         
//         DD  DSN=SYS2.F1TS00.PANELS,DISP=SHR          * VOLVO  MENU           
//         DD  DSN=SYS1.ISP.SISPPENU,DISP=SHR                                   
//*                                                                             
//ISPMLIB  DD  DSN=&INDEX..&GROUP..MSGS,DISP=SHR          * APPL   MSGS         
//         DD  DSN=SYS2.F1TS00.MSGS,DISP=SHR            * VOLVO  MSGS           
//         DD  DSN=SYS1.ISP.SISPMENU,DISP=SHR                                   
//*                                                                             
//ISPSLIB  DD  DSN=&INDEX..&GROUP..SKELS,DISP=SHR         * APPL   SKEL         
//         DD  DSN=SYS2.F1TS00.SKELS,DISP=SHR           * VOLVO  SKEL           
//         DD  DSN=SYS1.ISP.SISPSLIB,DISP=SHR                                   
//*                                                                             
//ISPTLIB  DD  DSN=&INDEX..&GROUP..TABLES,DISP=SHR        * APPL   TABL         
//         DD  DSN=SYS2.F1TS00.TABLES,DISP=SHR          * VOLVO  TABL           
//         DD  DSN=SYS1.ISP.SISPTENU,DISP=SHR                                   
//*                                                                             
//ISPLLIB  DD  DSN=&INDEX..&GROUP..LOAD,DISP=SHR          * APPL   LOAD         
//         DD  DSN=SYS2.F1TS00.LOAD,DISP=SHR            * VOLVO  LOAD           
//         DD  DSN=SYS1.TSO.LOAD,DISP=SHR                                       
//         DD  DSN=SYS1.ISP.SISPLOAD,DISP=SHR                                   
//*                                                                             
//ISPTABL  DD  DSN=&INDEX..&GROUP..TABLES,DISP=SHR                              
//*                                                                             
//ISPPROF  DD  DSN=&&USERID,                            * PROFILE DS            
//             DISP=(NEW,DELETE,DELETE),                                        
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=6160),                            
//             SPACE=(6160,(5,,5))                                              
//*                                                                             
//MVSIUSER DD  DSN=SYS1.MVSI.USER,DISP=SHR                                      
//MVSIAPPL DD  DSN=SYS1.MVSI.APPL,DISP=SHR                                      
//*                                                                             
//SYSHELP  DD  DUMMY                                                            
//*                                                                             
//SYSPROC  DD  DSN=&INDEX..&GROUP..CLIST,DISP=SHR                               
//         DD  DSN=SYS2.F1TS00.CLIST,DISP=SHR                                   
//         DD  DSN=SYS1.ISP.SISPCLIB,DISP=SHR                                   
//*                                                                             
//SYSEXEC  DD  DSN=&INDEX..&GROUP..EXEC,DISP=SHR                                
//         DD  DSN=SYS2.F1TS00.EXEC,DISP=SHR                                    
//         DD  DSN=SYS1.ISP.SISPEXEC,DISP=SHR                                   
//*                                                                             
//ISPLST1  DD  DISP=NEW,SPACE=(CYL,(1,1)),            * LIST WORK-DS1           
//             DCB=(LRECL=121,BLKSIZE=1210,RECFM=FBA)                           
//ISPLST2  DD  DISP=NEW,SPACE=(CYL,(1,1)),            * LIST WORK-DS2           
//             DCB=(LRECL=121,BLKSIZE=1210,RECFM=FBA)                           
//SYSEDIT  DD  DSN=&EDIT,SPACE=(CYL,(2,2))            * EDIT WORK-DS            
//*                                                                             
//SYSPRINT DD  SYSOUT=*                               * STD. PRINT              
//SYSOUT   DD  SYSOUT=*                               * STD. OUTPUT             
//SYSTSPRT DD  SYSOUT=*                               * TSO  PRINT              
//*                                                                             
//SYSTSIN  DD  DDNAME=SYSIN                                                     
//*                                                                             
//DUMMY1   DD  DUMMY,DSN=&USERID                                                
//*                                                                             
//SYSIN    DD  DSN=&INDRTE..CONSTANT(&MEMBER),DISP=SHR                          
//*                                                                             
//W97025D1 DD  DSN=&&W97024S,DISP=(OLD,DELETE,DELETE)                           
//************ SORTERAD FIL MED REGLER FÖR LV-FOLK                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ABEND   EXEC PGM=ABEND,COND=(4,GE,TSO),PARM='1234567890123456'                
//*                                                                             
