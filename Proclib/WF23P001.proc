//*                                                                             
//*  DISTRIBUTES FILE WITH DOCUMENT DATA TO D-A-P                               
//*                                                                             
//*  FREQUENCE:    SEVERAL TIMES A DAY     RTN WF23S1                           
//*                                                                             
//*  RESTART:      WF2301    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WF23P001 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WF20..WF23S1,                                             
//             INDUT=&WF23..WF23S1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WF2301   EXEC PGM=WF2301                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WF2301D1 DD  DSN=&INDIN..WF2031,DISP=SHR                                      
//************ DOCUMENT DATA FILE                                               
//*                                                                             
//WF2301D2 DD  DSN=&INDUT..WF2301(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ DOCUMENT DATA FILE - TO SEND TO D&P                              
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
