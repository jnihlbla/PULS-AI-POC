//*                                                                             
//*  DELETAR VORRADER SOM VARIT KLARA TILLRÄCKLIGT LÄNGE                        
//*                                                                             
//*  FREKVENS:     VECKA     RTN W440V3                                         
//*                                                                             
//*  ÅTERSTART:              NORMAL                                             
//*                W4405C    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W440P05C PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W440..W440V3,                                             
//             INDUT=&W440..W440V3,                                             
//             CPU=1                                                            
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W440PD5C),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W4405C(+0),DISP=SHR                                  
//************ KANDIDATER TILL RENSNING                                         
//*                                                                             
//SORTOUT  DD  DSN=&&W4405C,DISP=(NEW,PASS,DELETE),                             
//************ SORTADE ORDERID - ARTNR (ARTNR = 0 FÖRST)                        
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W4405C   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W4405C,W4405C,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                    -- ABEND         
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//W4405CD1 DD  DSN=&&W4405C,DISP=(OLD,DELETE,DELETE)                            
//************ SORTADE ORDERID - ARTNR (ARTNR = 0 FÖRST)                        
//*                                                                             
//W4405CD2 DD  DSN=&INDUT..W4405O(+1),DISP=(NEW,CATLG,DELETE),  -LIM(99)        
//************ RENSPOSTER ÄLDRE ÄN 6 MÅNADER                                    
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
//*                                                                             
