//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W55155   EXEC PGM=V16459,PARM='W55155/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(8192,(2000,2000))                                         
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DUMMY                                                            
//W55155D1 DD  DSN=&INDIN1..W55154(+0),DISP=SHR                                 
//************ PRISFIL FRÅN W551P054                                            
//*                                                                             
//W55155D2 DD  DSN=&&KALK,DISP=(OLD,DELETE,DELETE)                              
//************ KALKYLPÅLÄGG SORTERADE PÅ ARTIKELNUMMER                          
//*                                                                             
//W55155D3 DD  DSN=&INDUT..W55155(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ PRISFILEN KOMPLETTERAD MED KALKYLPÅLÄGG                          
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
