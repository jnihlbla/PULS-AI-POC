//             INDUT=&W551..W551B1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W551PD55),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN1..W55105(+0),DISP=SHR                                 
//         DD  DSN=&INDIN1..W55114(+0),DISP=SHR                                 
//************ KALKYLPÅLÄGG                                                     
//*                                                                             
//SORTOUT  DD  DSN=&&KALK,DISP=(NEW,PASS,DELETE),                               
