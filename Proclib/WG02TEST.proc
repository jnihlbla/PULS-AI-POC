//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//WG02LOAD PROC SYSTEM=&DB2SYS,                                                 
//             UID=,UTPROC=,                                                    
//             JOBNAME=,DSIN=NULLFILE,                                          
//             TTLOAD=SAKNAS,                                                   
//             DISCARD=NULLFILE,                                                
//             DCRECFM=FB,                                                      
//             DCLRECL=80,                                                      
//             DCBLKSI=6160                                                     
//*                                                                             
//LOAD    EXEC PGM=DSNUTILB,                                                    
//             PARM=(&SYSTEM,&UID,&UTPROC)                                      
//SYSPRINT DD  SYSOUT=*                                                         
//UTPRINT  DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=*                                                         
//SYSDISC  DD  DSN=&DISCARD,DISP=(NEW,CATLG,DELETE),                            
//*            DISCARDED RECORDS BECAUSE OF VIOLATIONS OF SOME KIND             
//             DCB=(RECFM=&DCRECFM,LRECL=&DCLRECL,BLKSIZE=&DCBLKSI),            
//             SPACE=(CYL,(5,5),RLSE),                                          
//             MGMTCLAS=NOBACKUP                                                
//SYSERR   DD  DSN=&&SYSERR,DISP=(NEW,DELETE),                                  
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=6160),                            
//             SPACE=(CYL,(1,1),RLSE)                                           
//SYSMAP   DD  DSN=&&SYSMAP,DISP=(NEW,DELETE),                                  
//             DCB=(RECFM=FB,LRECL=16,BLKSIZE=5120),                            
//             SPACE=(CYL,(1,1),RLSE)                                           
//SORTWK01 DD  DSN=&&SORTWK01,                                                  
//             DISP=(NEW,DELETE),                                               
//             SPACE=(CYL,(20,20),RLSE)                                         
//SORTWK02 DD  DSN=&&SORTWK02,                                                  
//             DISP=(NEW,DELETE),                                               
//             SPACE=(CYL,(20,20),RLSE)                                         
//SORTWK03 DD  DSN=&&SORTWK03,                                                  
//             DISP=(NEW,DELETE),                                               
//             SPACE=(CYL,(20,20),RLSE)                                         
//SORTWK04 DD  DSN=&&SORTWK04,                                                  
//             DISP=(NEW,DELETE),                                               
//             SPACE=(CYL,(20,20),RLSE)                                         
//SORTOUT  DD  DISP=(NEW,DELETE),                                               
//             SPACE=(CYL,(20,20),RLSE)                                         
//SYSREC   DD  DSN=&DSIN,                                                       
//             DISP=SHR                                                         
//SYSUT1   DD  DISP=(MOD,DELETE,DELETE),                                        
//             SPACE=(CYL,(50,20),RLSE)                                         
//SYSIN    DD  DSN=&INDGRND..DDL(&TTLOAD),DISP=SHR                              
//*                                                                             
//ABEND   EXEC PGM=ABEND,COND=(4,GE,LOAD),PARM='1234567890123456'               
