//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  MATCHAR DAGLIGT ARTIKEL-XTRAKT MED FIL FRÅN BUFFERT REGISTRET              
//*  KOMPLETTERAR MED PLATS, PB, LS, OCH VOLYM                                  
//*                                                                             
//*  FREKVENS:     DAG    RTN W488D1                                            
//*                                                                             
//*  ÅTERSTART:    W48851    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W488P051 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W488..W488D1,                                             
//             INDIN2=&W910,                                                    
//             INDUT=&W488..W488D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W48851   EXEC PGM=V16459,PARM='W48851/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DUMMY                                                            
//W48851D1 DD  DSN=&INDIN..W48850(+0),DISP=SHR                                  
//************ FIL FRÅN BUFFERT REGISTRET                                       
//*                                                                             
//W48851D2 DD  DSN=&INDIN2..W91042(+0),DISP=SHR                                 
//************ DAGLIGT ARTIKEL-XTRAKT CDC+NDC+SDC                               
//*                                                                             
//W48851D3 DD  DSN=&INDUT..W48852A(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)         
//************ FIL MED UPPGIFTER FRÅN LB OCH BUFFERT REGISTRET                  
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
