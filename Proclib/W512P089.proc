//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SALES REPORT FOR NON VCC                                                   
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W512M3                                       
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                W51289    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W512P089 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W570..W512M3,                                             
//             INDIN1=&W515..W512M3,                                            
//             INDUT=&W512..W512M3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W512PD89),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W57066B,DISP=SHR                                     
//         DD  DSN=&INDIN1..W51566B,DISP=SHR                                    
//************ BOOKING EVENTS FILE FOR PREVIOUS MONTH                           
//*                                                                             
//SORTOUT  DD  DSN=&&W51266,DISP=(NEW,PASS,DELETE),                             
//************ SORTED ON THE EVENTS AND TRADING PARTNER                         
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51289   EXEC PGM=W51289                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//W51289D1 DD  DSN=&&W51266,DISP=(OLD,DELETE,DELETE)                            
//************ SORTED ON THE EVENTS AND TRADING PARTNER                         
//*                                                                             
//W51289D2 DD  DSN=&INDUT..W51289(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//************ SALES REPORT                                                     
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
