//SYSUDUMP DD  SYSOUT=*                                                         
//*                                                                             
//SORTWK01 DD  DSN=&&SORTWK01,                                                  
//             DISP=(NEW,DELETE),                                               
//             SPACE=(4000,(20000,5000),,,ROUND)                                
//SORTWK02 DD  DSN=&&SORTWK02,                                                  
//             DISP=(NEW,DELETE),                                               
//             SPACE=(4000,(20000,5000),,,ROUND)                                
//SORTWK03 DD  DSN=&&SORTWK03,                                                  
