//W510P120 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W805..W510B1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51020   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W51020,W51020,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
