//W330P052 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W330..W330B1,                                             
//             INDUT=&W330..W330B1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W33052   EXEC PGM=V16459,PARM='W33052/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(36000,5000))                                        
//W33052D1 DD  DSN=&INDIN..W33051(+0),DISP=SHR                                  
//************ SUMMERADE RESULTAT AV URVAL FÖR LISTA A2                         
//*                                                                             
//W33052D2 DD  DSN=&INDUT..W33052(+1),DISP=(NEW,CATLG,DELETE),  -LIM(5)         
//************ FIL FÖR LISTA A2                                                 
//**           DCB=(RECFM=FBA,LRECL=122,BLKSIZE=23424),                         
//             MGMTCLAS=NOBACKUP,                                               
//             VOL=(,,,2),SPACE=(23424,(1200,500),RLSE)                         
//*                                                                             
