//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                   *         
//*      KREDITERING PV                                               *         
//*      GENERERING AV POSTER FÖR KREDITNOTOR OCH RETURTILLSTÅND      *         
//*                                                                   *         
//*      PERIODICITET: DAG                                            *         
//*                                                                   *         
//*      ÅTERSTART:    NORMAL                                         *         
//*                    W41840 LÄSER      WDD3 WDK6 WDB3 OCH WDG2      *         
//*                                                                   *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W418P040 PROC INDUT=&W418..W418D2,                                            
//             INDIN=&W418..W418D2,                                             
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W41838  EXEC PGM=SORT                                                         
//SORTIN   DD  DSN=&INDIN..W41835(+0),DISP=SHR                                  
//**************   LISTPOSTER                                       ***         
//*                                                                             
//SORTOUT  DD  DSN=&&W41835,DISP=(NEW,PASS,DELETE),                             
//**************   SORTERADE LISTPOSTER                             ***         
//             DATACLAS=PSEN                                                    
//*                                                                             
//*                                                                             
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W418PD38),DISP=SHR                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W41840  EXEC PGM=DFSRRC00,                                                    
//             PARM='&DBB,W41840,W41840,,00'                                    
//STEPLIB  DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY,DCB=(RECFM=VBS,LRECL=1400,BLKSIZE=1408,BUFNO=1)            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                      -- POSTSUM         
//W41840D1 DD  DSN=&&W41835,DISP=(OLD,PASS,DELETE)                              
//*                                                                             
//W41840D2 DD  DSN=&INDUT..W41849(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//**************      RETURTILLSTÅNDSPOSTER CDC + SDC               ***         
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W41840D3 DD  DSN=&INDUT..W41850(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//**************      KREDITNOTSPOSTER CDC + SDC                    ***         
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//W41840D4 DD  DSN=&INDUT..W41854(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************** FIL FÖR MÅNATLIG HOPSAMLING FÖR INTRASTAT (VTAB)               
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&NOBACKUP                                               
//*                                                                             
//W41840D5 DD  DSN=&INDUT..W41848(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************** FIL FÖR MÅNATLIG HOPSAMLING FÖR INTRASTAT (VTAB)               
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&NOBACKUP                                               
//*                                                                             
//WDD3     INCLUDE MEMBER=WDD3                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDK7     INCLUDE MEMBER=WDK7                                                  
//WDB3     INCLUDE MEMBER=WDB3                                                  
//WDG2     INCLUDE MEMBER=WDG2                                                  
//WDB1     INCLUDE MEMBER=WDB1                                                  
//WDB2     INCLUDE MEMBER=WDB2                                                  
//WDB6     INCLUDE MEMBER=WDB6                                                  
