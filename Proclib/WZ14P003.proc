//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  RESTART DISTRIBUTIONS. TAKE RESTART KEYS AS INPUT FROM SYSIN.              
//*  USED IN DISTRIBUTION AND PRINT JOBS.                                       
//*                                                                             
//*  FREQUENCE:    SEVERAL TIMES A DAY     RTN WZ14S9                           
//*                                                                             
//*  RESTART:      WZ1403    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ14P003 PROC STPLIB=&INDRTE..LOAD,                                           
//             SOPREG=&INDRTE..SOP                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ1403   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,WZ1403,WZ1403,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WZ1403D1 DD  DDNAME=SYSIN                                                     
//***********  RESTART KEYS PROVIDED VIA JCL AND DD *                           
//*                                                                             
//WSOPDD1  DD  DSN=&SOPREG,DISP=SHR            -- SOP DATA BASE                 
//*                                                                             
