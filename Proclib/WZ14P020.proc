//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SCRATCH OLD SENT MAILS IN D&P MAILBOX                                      
//*                                                                             
//*  FREQUENCE:    DAILY     RTN WZ14D1                                         
//*                                                                             
//*  RESTART:      WZ1420    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ14P020 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&WZ14..WZ14D1,                                             
//             MAILTAB=W0HELP1                                                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ1420   EXEC PGM=WZ1420,PARM='&MAILTAB',REGION=120M                          
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  DUMMY  SYSOUT=(D,,DUMP),HOLD=YES        -- ABEND                 
//*                                                                             
//SYSTCPD  DD  DSN=F1TI00.TCPIP.DATA(TCPDATA),DISP=SHR                          
//JAVAOUT  DD  PATH='/dev/null',                                                
//*------------ JAVA DIAGNOSICS, INFORMATION MESSAGES                           
//             PATHOPTS=(OWRONLY,OCREAT,OTRUNC),PATHMODE=SIRWXU                 
//JAVAERR  DD  PATH='/dev/null',                                                
//*------------ JAVA DIAGNOSTICS, ERROR MESSAGES                                
//             PATHOPTS=(OWRONLY,OCREAT,OTRUNC),PATHMODE=SIRWXU                 
//*                                                                             
//WZ1420D0 DD  DDNAME=SYSIN                                                     
//*------------ INPUT CONTROL COMMANDS                                          
//*                                                                             
//WZ1420D1 DD  DSN=&INDUT..WZ1420(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//             DATACLAS=PSEN,MGMTCLAS=BACKUPC                                   
//WZ1420D2 DD  DUMMY                                                            
//WZ1420D3 DD  DUMMY                                                            
//WZ1420D4 DD  DUMMY                                                            
//WZ1420D5 DD  DUMMY                                                            
//WZ1420D6 DD  DUMMY                                                            
//WZ1420D7 DD  DUMMY                                                            
//WZ1420D8 DD  DUMMY                                                            
//WZ1420D9 DD  DUMMY                                                            
//WZ1420DA DD  DUMMY                                                            
//*                                                                             
