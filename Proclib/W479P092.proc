//W479P092 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W479..W479D1,                                             
//             INDUT=&W479..W479D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47992   EXEC PGM=W47992                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W47992D1 DD  DSN=&INDIN..W47997(+0),DISP=SHR                                  
//************ WDQ2 NEDLÄST                                                     
//*                                                                             
//W47992D2 DD  DSN=&&W47992,DISP=(NEW,PASS,DELETE),                             
//************ CDC-INFO FRÅN NEDLÄST WDQ2                                       
//*            SPACE=(23432,(2000,500),RLSE)                                    
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ABEND    EXEC PGM=ABEND,PARM='1234567890123456',                              
//             COND=(8,GT,W47992)                                               
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W479PD92),DISP=SHR                         
//SORTIN   DD  DSN=&&W47992,DISP=(OLD,DELETE,DELETE)                            
//************ CDC-INFO FRÅN NEDLÄST WDQ2                                       
//************ SORTERAS PÅ IDORDER, IDDC                                        
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W47992(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ CDC-INFO FRÅN NEDLÄST WDQ2                                       
//*            MGMTCLAS=&DEL2BKPC,SPACE=(23432,(4000,1500),RLSE)                
