//*                                                                             
//*  SKAPAR BYTES UPPFÖLJNINGSLISTOR FÖR RAPPORTSTATUS 3                        
//*                                                                             
//*  FREKVENS:     DAGRUTIN  RTN W371D3                                         
//*                                                                             
//*  ÅTERSTART:    W37153    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W371P053 PROC INDIN=&W371..W371D3,                                            
//             DEST1=&CPRINT,                                                   
//             INDUT=&W371..W371D3,                                             
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W37153   EXEC PGM=V16459,PARM='W37153/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//EZTVFM   DD  SPACE=(8192,(10000,4000))                                        
//*                                                                             
//W37153D1 DD  DSN=&INDIN..W3714C(+0),DISP=SHR                                  
//************ BYTES RAPPORTER MED STATUS 4                                     
//*                                                                             
//TPFIL1   DD  DSN=&&TEMP1,DISP=(NEW,DELETE,DELETE),                            
//************ TEMPORÄR ÅRSFIL SORTERAD PÅ ARTIKELNR                            
//             SPACE=(10,(50,10),RLSE),AVGREC=K                                 
//*                                                                             
//W37153D2 DD  SYSOUT=(A,,STD),DEST=&DEST1,                                     
//************ BYTES UPPFÖLJNING FÖR STATUS 4 OCH DC 11                         
//             DCB=(RECFM=FBA,LRECL=121,BLKSIZE=121)                            
//*                                                                             
//W37153D3 DD  DSN=&INDUT..W37153(+1),DISP=(NEW,CATLG,DELETE), -LIM(7)          
//************ BYTES UPPFÖLJNING FÖR STATUS 4 OCH DC 91                         
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
