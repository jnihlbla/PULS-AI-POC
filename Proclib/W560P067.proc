//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR ÅRSINVENTARIUM, LISTORNA UA2507 OCH UA2509 (LISTOR PÅ FIL)          
//*                                                                             
//*  FREKVENS:     ÅRSRUTIN  RTN W560Y2 (KÖRS SIST I NOV. OCH DEC)              
//*                                                                             
//*  ÅTERSTART:    W56067    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W560P067 PROC INDIN=&W560..W560Y2,                                            
//             INDUT1=&W560..W560Y2,                                            
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56067   EXEC PGM=V16459,PARM='W56067/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(8192,(10000,4000))                                        
//SORTMSG  DD  SYSOUT=*                                                         
//*                                                                             
//W56067D1 DD  DSN=&INDIN..W56061(-2),DISP=SHR                                  
//************ FÖREGÅENDE ÅRS PRISREGISTER                                      
//*                                                                             
//W56067D2 DD  DSN=&INDIN..W56065(+0),DISP=SHR                                  
//************ FIL MED INLEVERANSHISTORIK (WDL6)                                
//*                                                                             
//TPFIL1   DD  DSN=&&TEMP1,DISP=(NEW,DELETE,DELETE),                            
//************ TEMPORÄR ÅRSFIL SORTERAD PÅ ARTIKELNR                            
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL2   DD  DSN=&&TEMP2,DISP=(NEW,DELETE,DELETE),                            
//************ TEMPORÄR WDL6 FIL                                                
//             DATACLAS=PSEN                                                    
//*                                                                             
//W56067D3 DD  DSN=&&TEMP67A,DISP=(NEW,PASS,DELETE),                            
//************** LISTA W56067-041 LIFO IN TRANSIT, DETAIL DC 41                 
//             DATACLAS=PSEN                                                    
//*                                                                             
//W56067D5 DD  DSN=&&TEMP67C,DISP=(NEW,PASS,DELETE),                            
//************** LISTA W56067-043 LIFO IN TRANSIT, DETAIL DC 43                 
//             DATACLAS=PSEN                                                    
//*                                                                             
//W56067D6 DD  DSN=&&TEMP67D,DISP=(NEW,PASS,DELETE),                            
//************** LISTA W56067-001 LIFO IN TRANSIT, TOTAL                        
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                   *         
//*    KOPIERAR LISTORNA PÅ FIL ÅT LAB FÖR ATT                        *         
//*    VCOM EJ KLARAR ATT HANTERA FILER MED FBA (SKALL VARA FB)       *         
//*                                                                   *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W560GEN EXEC PGM=ICEGENER                                                     
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&&TEMP67A,DISP=(OLD,DELETE,DELETE)                           
//         DD  DSN=&&TEMP67C,DISP=(OLD,DELETE,DELETE)                           
//         DD  DSN=&&TEMP67D,DISP=(OLD,DELETE,DELETE)                           
//************** LIST LIFO IN TRANSIT, DETAIL AND SUMMARY          ***          
//*                                                                             
//SYSUT2   DD  DSN=&INDUT1..W56067(+1),                        -LIM(03)         
//             DISP=(NEW,CATLG,DELETE),                                         
//*********** LISTFILE W56067-001, -041, -043                                   
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
