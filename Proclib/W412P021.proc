//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  ON DAILY BASIS SCAN THE SYSTEM FOR ORDERS WITH                             
//*  REPAIR-DATE, DISTRICT 778, DC 11, TODAY'S RFS DATE                         
//*  AND THAT ARE IN 'P' STATUS.                                                
//*                                                                             
//*  FREQUENCY:    DAILY          RTN W412D8                                    
//*                                                                             
//*    RESTART:    W41221   NORMAL                                              
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W412P021 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W412..W412D8,                                             
//             INDUT=&W412..W412D8                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W412PD21),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W41220(+0),DISP=SHR                                  
//************ STATUS "P" ORDERS                                                
//*                                                                             
//SORTOUT  DD  DSN=&&W41221,DISP=(NEW,PASS,DELETE),                             
//************ SORTED STATUS "P" ORDERS IN IDKUNDNR                             
//         SPACE=(80,(2,6),RLSE),AVGREC=K                                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W41221   EXEC PGM=W41221                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//W41221D1 DD  DSN=&&W41221,DISP=(OLD,DELETE,DELETE)                            
//************ STATUS "P" ORDERS                                                
//*                                                                             
//W41221D2 DD  DSN=&INDUT..W41221(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=&BACKUPC                                                
//************ STATUS "P" ORDERS                                                
