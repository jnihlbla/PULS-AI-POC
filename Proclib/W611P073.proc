//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(1600,1200))                                         
//SORTMSG  DD  SYSOUT=*                                                         
//W61173D1 DD  DSN=&INDIN2..W91042(+0),DISP=SHR                                 
//************ VLB                                                              
//*                                                                             
//W61173D2 DD  DSN=&INDIN..W61173(+0),DISP=SHR                                  
//************ FÖRRA VECKANS LÄGE                                               
//*                                                                             
//W61173D3 DD  DSN=&INDUT..W61173(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ DENNA VECKANS LÄGE                                               
//             SPACE=(28,(50,33),RLSE),AVGREC=K,                                
//             MGMTCLAS=&BACKUPC                                                
//W61173D4 DD  SYSOUT=(A,,3803),OUTPUT=*.STDCP                                  
