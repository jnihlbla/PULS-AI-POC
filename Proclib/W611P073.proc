//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61173   EXEC PGM=V16459,PARM='W61173/8/'                                     
//STDCP    OUTPUT DEST=&DEST1,FORMDEF=SLSR6C,PAGEDEF=SLSR6C                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
