//*                                                                             
//*  SELEKTERAR ORDER SOM KAN RENSAS FRÅN WDQ1 & WDQ2 +                         
//*                   I STATUS "E".                                             
//*                                                                             
//*  FREKVENS:     VECKA    RTN W479V3                                          
//*                                                                             
//*  ÅTERSTART:    W47911   NORMAL                                              
//*                LÄSER    WDQ2 WDA5                                           
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W479P011 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W479..W479V3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47911   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W47911,W47911,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY,DCB=(RECFM=VB,BLKSIZE=1408,BUFNO=1)                        
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM8K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(OSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDA5     INCLUDE MEMBER=WDA5                                                  
//WDQ2     INCLUDE MEMBER=WDQ2                                                  
//W47911D1 DD  DSN=&INDUT..W47911(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ ORDER SOM KAN RENSAS,              W479P012                      
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
//W47911D2 DD  DSN=&INDUT..W47916(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ ORDER I STATUS "E"                 W479P017                      
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
//W47911D3 DD  DSN=&INDUT..W4791A(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
