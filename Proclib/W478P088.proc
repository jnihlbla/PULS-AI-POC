//W478P088 PROC INDIN=&W478..W478V2,INDUT=&W478..W478V2,                        
//             INDIN1=&W011..LDC,                                               
//             INDIN2=&W011..SDC,                                               
//             INDIN3=&W011..NDC,                                               
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//SORT    EXEC PGM=SORT                                                         
//SYSOUT   DD  SYSOUT=*                                                         
//SORTIN DD  DSN=&INDIN1..W01184(+0),DISP=SHR                                   
//       DD  DSN=&INDIN2..W01184(+0),DISP=SHR                                   
//       DD  DSN=&INDIN3..W01184(+0),DISP=SHR                                   
//************** SDC-LAGERBANDEN                                                
//*                                                                             
//SORTOUT  DD  DSN=&&W01184S,DISP=(NEW,PASS,DELETE),                            
//             DATACLAS=PSEN                                                    
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTARDC),DISP=SHR                         
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *           
//W47888  EXEC PGM=W47888                                                       
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                      (DISPLAY)          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=*                                    (VID ABEND)          
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                      (POSTSUM)          
//*                                                                             
//W47888D1 DD  DSN=&INDIN..W47884(+0),DISP=SHR                                  
//*                                                                             
//W47888D2 DD  DSN=&&W01184S,DISP=(OLD,DELETE,DELETE)                           
//************** IHOPSORTERADE SDC-LAGERBAND (LDC,NDC )                         
//*                                                                             
//W47888D3 DD  DSN=&INDUT..W47888(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************** EFR DIFF                                           ***         
//*                                                                             
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W47888D4 DD  DSN=&INDUT..W47888A(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)        
//************** EFR DIFF                                           ***         
//*                                                                             
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
