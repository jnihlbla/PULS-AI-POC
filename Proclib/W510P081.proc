//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  TO CREATE EXCEL FILE FOR DAILY MOVEMENTS DATA FOR JAPAN                    
//*  DC 61 & 62                                                                 
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W510D4                                       
//*                                                                             
//*  RESTART:      W51081    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W510P081 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W510..W510D4,                                             
//             INDUT=&W510..W510D4                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51081   EXEC PGM=V16459,PARM='W51081/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR            -- DATKORT            
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR         -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//W51081D1 DD  DSN=&INDIN..W5107QA(+0),DISP=SHR                                 
//************ RECORDS WITH ALL DC EXCLUDED DC 91 AND RELATED                   
//*                                                                             
//W51081D2 DD  DSN=&INDIN..W5107RA(+0),DISP=SHR                                 
//************ RECORDS WITH ALL DC EXCLUDED DC 91 AND RELATED                   
//*                                                                             
//W51081D3 DD  DSN=&INDIN..W5107S(+0),DISP=SHR                                  
//************ RECORD WITH UNIQUE INVOICE FOR DC 61                             
//*                                                                             
//W51081D4 DD  DSN=&INDIN..W5107T(+0),DISP=SHR                                  
//************ RECORD WITH UNIQUE INVOICE FOR DC 62                             
//*                                                                             
//W51081D5 DD  DSN=&INDUT..W5107U(+1),                        -LIM(1)           
//             DISP=(NEW,CATLG,DELETE),                                         
//************ MATCHED FILE WITH W5107S AND W5107Q DC 61 SEND TO DAP            
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W51081D6 DD  DSN=&INDUT..W5107V(+1),                        -LIM(1)           
//             DISP=(NEW,CATLG,DELETE),                                         
//************  MATCHED FILE WITH W5107S AND W5107R DC 62 SEND TO DAP           
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W51081D7 DD  DSN=&INDUT..W5107W(+1),                        -LIM(1)           
//             DISP=(NEW,CATLG,DELETE),                                         
//************ MATCHED FILE WITH W5107T AND W5107Q DC 61 SEND TO DAP            
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W51081D8 DD  DSN=&INDUT..W5107X(+1),                        -LIM(1)           
//             DISP=(NEW,CATLG,DELETE),                                         
//************  MATCHED FILE WITH W5107T AND W5107R DC 62 SEND TO DAP           
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
