//*  SKAPAR FIL LISPOSTER TILL DISTR. AND PRINT FÖR UPPFÖLJNING                 
//*  AV DISCREPANCY DEVIATIONS VIA WZ01-MODULEN.                                
//*                                                                             
//*  FREKVENS:     VECKA   RTN W428V1                                           
//*                                                                             
//*  ÅTERSTART:    W42819    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W428P019 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=1,                                                           
//             INDIN=&W428..W428V1,                                             
//             INDUT=&W428..W428V1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W428PD19),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W42818(+0),DISP=SHR                                  
//************ LEDTIDSFIL RETURER FRÅN W428V1 - W42818                          
//*                                                                             
//SORTOUT  DD  DSN=&&W42818,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//************ SORTERAD FIL                                                     
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT2    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W428PD19),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W42819(+0),DISP=SHR                                  
//************ LEDTIDSFILRETURER FRÅN W428V1 - W42818                           
//*                                                                             
//SORTOUT  DD  DSN=&&W42819,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//************ SORTERAD FIL                                                     
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W42819   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W42819,W42819,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W42819D1 DD  DSN=&&W42818,DISP=(OLD,DELETE,DELETE)                            
//************ INFIL WEEKLY FOLLOW UP DISCR. DEVIATIONS                         
//*                                                                             
//W42819D2 DD  DSN=&&W42819,DISP=(OLD,DELETE,DELETE)                            
//************ INFIL WEEKLY FOLLOW UP DISCR. DEVIATIONS                         
//*                                                                             
//W42819D3 DD  DSN=&INDUT..W42823(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)          
//************ UPPFÖLJNINGSFIL, LEVERANSANMÄRKNINGAR, NDC:ER                    
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
