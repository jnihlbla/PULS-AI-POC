//XICSCOMP PROC COMPANY=VPUBV1,      LIBRARY NAME LEVEL 1                       
//*                                                                             
//*             ********************************                                
//*             *   XICS -  V 5.0  JULY 1984   *                                
//*             *                              *                                
//*             *     COMPOSITION PROCEDURE    *                                
//*             *                              *                                
//*             *  ANVÄNDES OCH UNDERHÅLLES AV *                                
//*             *        JIMMY LUNDBECK        *                                
//*             ********************************                                
//*                                                                             
//        LOAD=XICS5,              LOAD LIBRARY NAME LEVEL 2                    
//        LIB=LOAD,                  LOAD LIBRARY NAME LEVEL 3                  
//        PROG=COMPUSET,             PROGRAM NAME                               
//        VSAM=VPUBV1V,              VSAM NAME LEVEL 1                          
//        VPROJ=XICS,                VSAM NAME LEVEL 2                          
//        SYSTEM=XICS50,             SYSTEM LIBRARY NAME LEVEL 2                
//        CONTROL=SYSTEM,            SYSTEM LIBRARY NAME LEVEL 3                
//        GROUP=VPUBV1,              USER LIBRARY NAME LEVEL 1                  
//        PROJ=PROD,                 USER LIBRARY NAME LEVEL 2                  
//        USER=LIB,                  USER LIBRARY NAME LEVEL 3                  
//        DICT=DICTNRY,              HYPHENATION DICT NAME LEVEL 3              
//        WIDS=VOLVOM6,              WIDTHS NAME LEVEL 3                        
//        CNF=VLVCHANS,              CONFIG MEMBER NAME IN SYSTEM LIB           
//        INDATA1=XICSDATA,          INPUT DATA FILE 1 IN USER LIBRARY          
//        INDATA2=XICSDATA,          INPUT DATA FILE 2 IN USER LIBRARY          
//        OCLASS='*',                OUTPUT CLASS FOR ERROR LOG FILE            
//        GALOUT='*',                OUTPUT CLASS FOR GALLEY PRINT FILE         
//        RUN=1,                     RUN NUMBER FOR INDEX FILES                 
//        P=                                                                    
//*                                                                             
//*                                                                             
//*    *************                                                            
//*    *  COMPOSE  *                                                            
//*    *************                                                            
//*                                                                             
//COMPOSE EXEC PGM=&PROG,                                                       
//             PARM='&P',                                                       
//             COND=(4,LT)                                                      
//STEPLIB   DD DSN=&COMPANY..&LOAD..&LIB,DISP=SHR                               
//CSSIN     DD DSN=&GROUP..&PROJ..&USER(&INDATA1),         INPT FILE 1          
//             LABEL=(,,,IN),DISP=SHR                                           
//CSS04     DD DSN=&GROUP..&PROJ..&USER(&INDATA2),         INPT FILE 2          
//             LABEL=(,,,IN),DISP=SHR                                           
//CSSOUT    DD DSN=&&META&RUN,DISP=(,PASS),                META OUTPUT          
//             DCB=(RECFM=VB,LRECL=2200,BLKSIZE=3200),                          
//             SPACE=(3200,(2000,2000),RLSE)                                    
//FT03F001  DD DSN=&COMPANY..&SYSTEM..&CONTROL(&CNF),      CONFIG FILE          
//             LABEL=(,,,IN),DISP=SHR                                           
//FT05F001  DD DSN=&COMPANY..&SYSTEM..&CONTROL(XICSCTL2),                       
//             LABEL=(,,,IN),DISP=SHR                                           
//FT06F001  DD SYSOUT=&OCLASS                              ERROR/LOG            
//VSRN01    DD DSN=&VSAM..&VPROJ..&WIDS..WIDTHS,DISP=SHR   WIDTHS FILE          
//VSRN02    DD DSN=&VSAM..&VPROJ..&DICT,DISP=SHR           HYPHEN DICT          
//FT07F001  DD DSN=&&INDEX1&RUN,DISP=(NEW,PASS),           INDEX 1              
//             DCB=(RECFM=VBS,LRECL=640,BLKSIZE=3224),                          
//             SPACE=(3224,(100,100))                                           
//FT08F001  DD DSN=&&INDEX2&RUN,DISP=(NEW,PASS),           INDEX 2              
//             DCB=(RECFM=VBS,LRECL=640,BLKSIZE=3224),                          
//             SPACE=(3224,(100,100))                                           
//FT14F001  DD DSN=&&INDEX3&RUN,DISP=(NEW,PASS),               INDEX 3          
//             DCB=(RECFM=VBS,LRECL=640,BLKSIZE=3224),                          
//             SPACE=(3224,(100,100))                                           
//FT15F001  DD DSN=&&INDEX4&RUN,DISP=(NEW,PASS),               INDEX 4          
//             DCB=(RECFM=VBS,LRECL=640,BLKSIZE=3224),                          
//             SPACE=(3224,(100,100))                                           
//FT16F001  DD DSN=&&INDEX5&RUN,DISP=(NEW,PASS),               INDEX 5          
//             DCB=(RECFM=VBS,LRECL=640,BLKSIZE=3224),                          
//             SPACE=(3224,(100,100))                                           
//FT17F001  DD DSN=&&INDEX6&RUN,DISP=(NEW,PASS),               INDEX 6          
//             DCB=(RECFM=VBS,LRECL=640,BLKSIZE=3224),                          
//             SPACE=(3224,(100,100))                                           
//FT18F001  DD DSN=&&INDEX7&RUN,DISP=(NEW,PASS),               INDEX 7          
//             DCB=(RECFM=VBS,LRECL=640,BLKSIZE=3224),                          
//             SPACE=(3224,(100,100))                                           
//FT19F001  DD DSN=&&INDEX8&RUN,DISP=(NEW,PASS),               INDEX 8          
//             DCB=(RECFM=VBS,LRECL=640,BLKSIZE=3224),                          
//             SPACE=(3224,(100,100))                                           
//FT20F001  DD DSN=&&INDEX9&RUN,DISP=(NEW,PASS),               INDEX 9          
//             DCB=(RECFM=VBS,LRECL=640,BLKSIZE=3224),                          
//             SPACE=(3224,(100,100))                                           
//FT21F001  DD DSN=&&INDEXA&RUN,DISP=(NEW,PASS),               INDEX 10         
//             DCB=(RECFM=VBS,LRECL=640,BLKSIZE=3224),                          
//             SPACE=(3224,(100,100))                                           
//FT22F001  DD DSN=&&INDEXB&RUN,DISP=(NEW,PASS),               INDEX 11         
//             DCB=(RECFM=VBS,LRECL=640,BLKSIZE=3224),                          
//             SPACE=(3224,(100,100))                                           
//FT23F001  DD DSN=&&INDEXC&RUN,DISP=(NEW,PASS),               INDEX 12         
//             DCB=(RECFM=VBS,LRECL=640,BLKSIZE=3224),                          
//             SPACE=(3224,(100,100))                                           
//FT11F001  DD DCB=(RECFM=F,BLKSIZE=6144),                     TEMP 1           
//             SPACE=(CYL,(1,1))                                                
//FT12F001  DD DCB=(RECFM=F,BLKSIZE=6144),                     TEMP 2           
//             SPACE=(CYL,(1,1))                                                
//FT13F001  DD DCB=(RECFM=F,BLKSIZE=6144),                     TEMP 3           
//             SPACE=(CYL,(1,1))                                                
//CSS03     DD SYSOUT=&GALOUT,DCB=(RECFM=UA,BLKSIZE=150)   GALLEY               
