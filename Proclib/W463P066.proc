//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SPLITS BILLING AND PRICE RECORDS.                                          
//*  ADD MQ HEADERS FOR EACH MARKET.                                            
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W463D6                                         
//*                                                                             
//*  RESTART:      W46366    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W463P066 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W463..W463D6,                                             
//             INDUT=&W463..W463D6                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*SORT BILLING TRANSACTION RECORDS                                             
//*                                                                             
//*SORT PARAMETERS AS BELOW (SAME AS W463PD61 EXCEPT COUNTRY INFO)              
//*51,3- COUNTRY INFO                                                           
//*1,7 - SERIAL NUMBER                                                          
//*8,6 - DATE                                                                   
//*14,8- TIME                                                                   
//*22,3- FELKOD(DESCENDING)                                                     
//*25,6- SEQUENCE NUMBER                                                        
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W463PD66),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W46367(+0),DISP=SHR                                  
//SORTOUT  DD  DSN=&&W46367,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W46366   EXEC PGM=W46366                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W46366D1 DD  DSN=&&W46367,DISP=(OLD,DELETE,DELETE)                            
//*                                                                             
//W46366D2 DD  DSN=&INDUT..W4636MQ(+1),DISP=(NEW,CATLG,DELETE),                 
//************ RECORDS FOR ALL MARKETS -VIPS                                    
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
//*                                                                             
//W46366D3 DD  DSN=&INDUT..W463PMQ(+1),DISP=(NEW,CATLG,DELETE),                 
//************ RECORDS FOR ALL MARKETS -PRICE                                   
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
