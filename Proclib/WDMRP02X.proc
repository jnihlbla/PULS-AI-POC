//*  UPPDATERING AV DATAMANAGER MED MODUL-INFORMATION.                          
//*  KOPIERA FÖRRA VECKANS FILER MED MODUL-DATA FÖR ATT SENARE                  
//*  KUNNA ANVÄNDA DEM FÖR MATCHNING MOT DENNA VECKAS FIL                       
//*                                                                             
//*  FREKVENS:     VECKA    RTN WDMRV6                                          
//*                                                                             
//*  ÅTERSTART:    NORMAL                                                       
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WDMRP02X PROC INDIN=&WDMR..WDMRV6,                                            
//             INDUT=&WDMR..WDMRV6                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WDMR2XC  EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDIN..WDMR22(+0),DISP=SHR                                  
//************ FÖRRA VECKANS COBOL-MODUL-FIL                                    
//*                                                                             
//SYSUT2   DD  DSN=&INDUT..WDMROC(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ KOPIA AV FÖRRA VECKANS FIL ("OLD COBOL")                         
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
//WDMR2XE  EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDIN..WDMR23(+0),DISP=SHR                                  
//************ FÖRRA VECKANS EPLUS-MODUL-FIL                                    
//*                                                                             
//SYSUT2   DD  DSN=&INDUT..WDMROE(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ KOPIA AV FÖRRA VECKANS FIL ("OLD EPLUS")                         
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
