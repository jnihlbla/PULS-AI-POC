//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  DIREKTLEVERANSUPPFÖLJNING TILL LEVERANTÖR                                  
//*  SKAPAR MAIL-FILE ALLA LEVERANTÖR                                           
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W463D1                                         
//*                                                                             
//*  RESTART:      W4639B    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W463P09B PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W463..W463D1,                                             
//             INDUT=&W463..W463D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W4639B   EXEC PGM=V16459,PARM='W4639B/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),DEST=LOCAL,HOLD=YES                             
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W4639BD1 DD  DSN=&INDIN..W4639A(+0),DISP=SHR                                  
//************ ALL SUPPLIER FILE                                                
//*                                                                             
//W4639BD2 DD  DSN=&INDUT..W4639B(+1),DISP=(NEW,CATLG,DELETE), -LIM(10)         
//************ MAIL-FILE FÖR SENDNING TO ALL SUPPLIER                           
//************ FILEN SKICKAS SOM MAIL VIA DAP                                   
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
