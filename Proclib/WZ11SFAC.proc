//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  FUNCTION  : Send a csv file to smartfacts.                       *         
//*              This executes a java program that will first convert *         
//*              the csv file to json.                                *         
//*              Wrap the json array with records object as required  *         
//*              by smartfacts.                                       *         
//*              For every set of 500 records, one API call is made.  *         
//*                                                                   *         
//*  RESTART   : Restart normal. However, check sysout and set        *         
//*              STARTREC correctly. Otherwise we risk sending        *         
//*              records again.                                       *         
//*                                                                   *         
//*  PARAMETERS:                                                      *         
//*                                                                   *         
//*    DSIN    :                                                      *         
//*              ** MANDATORY **                                      *         
//*              The name of a csv file.                              *         
//*                                                                   *         
//*    SYSIN   :                                                      *         
//*              ** MANDATORY **                                      *         
//*              Three parameters need to be passed. Details below    *         
//*              Example :                                            *         
//*                 //SYSIN DD *                                      *         
//*                 table_name=test_table                             *         
//*                 delimiter=;                                       *         
//*                 start_record=0                                    *         
//*                                                                   *         
//*    table_name                                                     *         
//*              ** MANDATORY **                                      *         
//*              Smartfacts Table name.                               *         
//*                                                                   *         
//*    delimiter                                                      *         
//*              Optional. Default is ;                               *         
//*              Possible to override this with comma or tab          *         
//*              Its one character (Ex: ; or , or ¤)                  *         
//*              However, if your file is tab delimited (x'05') use   *         
//*              \t instead.                                          *         
//*                                                                   *         
//*    start_record                                                   *         
//*              Optional. Default is 0 indicating start of file.     *         
//*              In case of restart after an abend, check the job     *         
//*              output to see how many records have sucessfully      *         
//*              processed. Add +1 and then pass that value during    *         
//*              restart.                                             *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WZ11SFAC PROC DSIN=NULLFILE,LOGLVL='',MAXRC=0,                                
//           STDENV=&INDRTE..CONSTANT(JZOSENV)                                  
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ICONVARG  EXEC PGM=EDCICONV,REGION=7M,                                        
//             PARM=('FROMCODE(IBM-278),TOCODE(IBM-1047)')                      
//STEPLIB   DD DSN=SYS1.CEE.SCEERUN,DISP=SHR                                    
//SYSUT1   DD  DSN=&INDRTE..CONSTANT(WZ11SFAC),DISP=SHR                         
//         DD  DDNAME=SYSIN                                                     
//SYSUT2   DD  DSN=&&ARGSDD,DISP=(NEW,PASS,DELETE)                              
//SYSPRINT  DD SYSOUT=*                                                         
//SYSIN     DD DUMMY                                                            
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//JAVA    EXEC WJVMP086,LOGLVL=&LOGLVL,MAXRC=&MAXRC                             
//MAINARGS DD  DSN=&&ARGSDD,DISP=(OLD,DELETE)                                   
//STDENV   DD  DSN=&STDENV,DISP=SHR                                             
//INPUT    DD  DSN=&DSIN,DISP=SHR                                               
