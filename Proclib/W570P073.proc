//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR DETALJ-LISTA ÖVER DAGENS REDOVISNINGAR TILL SAP                     
//*  LISTAN LÄGGS SEDAN PÅ ON-DEMAND                                            
//*                                                                             
//*  FREKVENS:     DAG     RTN W570D3                                           
//*                                                                             
//*  ÅTERSTART:    W57073  NORMAL                                               
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W570P073 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W570..W570D3,                                             
//             INDUT=&W570..W570D3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W510PD74),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W57075(+0),DISP=SHR                                  
//************ FIL MED DAGENS ALLA KONTERINGAR ÅT SAP                           
//*                                                                             
//SORTOUT  DD  DSN=&&W57075,DISP=(NEW,PASS,DELETE),                             
//************ SORTERAD KONTERINGS-FIL                                          
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W57073   EXEC PGM=W57073                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//W57073D1 DD  DSN=&&W57075,DISP=(OLD,DELETE,DELETE)                            
//************ FIL MED DAGENS ALLA KONTERINGAR ÅT SAP, SORTERADE                
//*                                                                             
//W57073D2 DD  DSN=&INDUT..W5707O(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ W57073-001  LISTA GRUNDBOKFÖRINGSTRANSAR TILL SAP/R3             
//             DATACLAS=PSEB                                                    
//W57073D3 DD  DSN=&INDUT..W5707P(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ W57073-002  LISTA GRUNDBOKFÖRINGSTRANSAR TILL SAP/R3             
//             DATACLAS=PSEB                                                    
//W57073D4 DD  DSN=&INDUT..W5707Q(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ W57073-003  LISTA GRUNDBOKFÖRINGSTRANSAR TILL SAP/R3             
//             DATACLAS=PSEB                                                    
//W57073D5 DD  DSN=&INDUT..W5707R(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ W57073-004  LISTA GRUNDBOKFÖRINGSTRANSAR TILL SAP/R3             
//             DATACLAS=PSEB                                                    
//W57073D6 DD  DSN=&INDUT..W5707S(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ LINE DATA FILE TO SEND TO SNOWFLAKE                              
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
