//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  TAR IN EN OKS/EFR-FILEN OCH SORTAR DENNA PÅ DISTR & DC                     
//*                                                                             
//*  FREKVENS:     DAG      RTN WXTRD1                                          
//*                                                                             
//*  ÅTERSTART:              NORMAL                                             
//*                WXTR05    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTRP005 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WXTR..WXTRD1,                                             
//             INDREG=&WXTR,                                                    
//             INDUT=&WXTR..WXTRD1,                                             
//             DEST=LOCAL                                                       
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//WXTR05   EXEC PGM=V16459,PARM='WXTR05/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//WXTR05D1 DD  DSN=&INDIN..WXTR18(+0),DISP=SHR                                  
//*                                                                             
//WXTR05D2 DD  DSN=&INDREG..WXTRAA(+0),DISP=SHR                  -LIM 3         
//************ COUNTRY TABELL                                                   
//*                                                                             
//WXTR05D3 DD  DSN=&INDUT..WXTR05(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ EFRFIL PER SDC/DISTR                                             
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&NOBACKUP                                               
//*                                                                             
//WXTR05D4 DD  DSN=&&TEMP1,DISP=(NEW,PASS,DELETE),                              
//             DATACLAS=PSEN                                                    
//WXTR05D6 DD  DSN=&&TEMP2,DISP=(NEW,PASS,DELETE),                              
//             DATACLAS=PSEN                                                    
//************ EFRLISTA TILL SAR                                                
//*                                                                             
//WXTR05D5 DD  SYSOUT=(A,,STD),DEST=&DEST                                       
//*                                                                             
