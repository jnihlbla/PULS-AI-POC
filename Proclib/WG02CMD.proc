//WG02CMD  PROC DBSYS=&DB2SYS,CMD=SAKNAS                                        
//*                                                                             
//CARDGEN EXEC PGM=V12340,                                                      
//             PARM=(' DSN SYS(&DBSYS)** &CMD** END')                           
//V12340D1 DD  DUMMY,DCB=BLKSIZE=80                                             
//V12340D2 DD  DSN=&&CARDS,DISP=(NEW,PASS,DELETE),                              
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=240),                             
