//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W373P054 PROC INDIN=&W371..W371P2,                                            
//             DEST1=LOCAL,                                                     
//             INDUT=&W371..W371P2,                                             
//             DEST4=&QUS05257,                                                 
//             DEST6=&RUS05692,                                                 
//             DEST7=&QJP20109,                                                 
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W371PD54),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W3714D,DISP=SHR                                      
//************ LAGERBAND FRÅN NDC:ERNA                                          
//*                                                                             
//SORTOUT  DD  DSN=&&W373SORT,DISP=(NEW,PASS,DELETE),                           
//************ SORTAT LAGERBAND FRÅN NDC:ERNA                                   
//         SPACE=(10,(100,50),RLSE),AVGREC=K                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//W37354   EXEC PGM=W37354                                                      
//STEPLIB   DD DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//          DD DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT    DD SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT     DD DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN     DD DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT     DD SYSOUT=*                                                         
//V16247D3 DD  SYSOUT=*                                      -- POSTSUM         
//*                                                                             
//W37354D1  DD DSN=&&W373SORT,DISP=(OLD,DELETE,DELETE)                          
//***********                                                                   
//*                                                                             
//*                                                                             
//W37354D2 DD  SYSOUT=(A,,STD),DEST=&DEST1,                                     
//************ BYTES UPPFÖLJNING FÖR STATUS 4 OCH DC 11                         
//             DCB=(RECFM=FBA,LRECL=121,BLKSIZE=121)                            
//*                                                                             
//W37354D3 DD  DSN=&INDUT..W37354(+1),DISP=(NEW,CATLG,DELETE), -LIM(7)          
//************ BYTES UPPFÖLJNING FÖR STATUS 4 OCH DC 91                         
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//W37354D4 DD  SYSOUT=(A,,STD),DEST=&DEST4,                                     
//************ BYTES UPPFÖLJNING FÖR STATUS 4 OCH DC 41                         
//             DCB=(RECFM=FBA,LRECL=121,BLKSIZE=121)                            
//*                                                                             
//W37354D5 DD  SYSOUT=(A,,STD),DEST=&DEST6,                                     
//************ BYTES UPPFÖLJNING FÖR STATUS 4 OCH DC 43                         
//             DCB=(RECFM=FBA,LRECL=121,BLKSIZE=121)                            
//*                                                                             
//W37354D6 DD  SYSOUT=(A,,STD),DEST=&DEST7,                                     
//************ BYTES UPPFÖLJNING FÖR STATUS 4 OCH DC 61                         
//             DCB=(RECFM=FBA,LRECL=121,BLKSIZE=121)                            
//*                                                                             
//W37354D7 DD  DSN=&INDUT..W37354.WEBDC(+1),                   -LIM(7)          
//************ BYTES UPPFÖLJNING FÖR STATUS 4 OCH WEB DC'S                      
//             DISP=(NEW,CATLG,DELETE),                                         
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
