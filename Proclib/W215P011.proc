//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LOAD WDJ4                                                                  
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W215D1                                         
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                W21511    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W215P011 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W215..W215D1                                              
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W215PD11),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W21505(+0),DISP=SHR                                  
//************ W21505 FOR SORT                                                  
//*                                                                             
//SORTOUT  DD  DSN=&&W21505,DISP=(NEW,PASS,DELETE),                             
//************ W21501 SORTED                                                    
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W21511   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W21511,W21511,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//W21511D1 DD  DSN=&&W21505,DISP=(OLD,DELETE,DELETE)                            
//************ W21501 SORTED                                                    
//*                                                                             
