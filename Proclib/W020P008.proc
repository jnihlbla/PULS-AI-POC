//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W020P008 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDLDC=&W011..LDC,                                               
//             INDSDC=&W011..SDC,                                               
//             INDNDC=&W011..NDC,                                               
//             INDIN=&W020..W020V1,                                             
//             INDUT=&W020..W020V1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* EXTRACT DC'S NDC-NA FROM NDC FILE                                           
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT01   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W020PD11),DISP=SHR                         
//SORTIN   DD  DSN=&INDNDC..W01184(+0),DISP=SHR                                 
//************ LAGERBAND FRÅN NDC:ERNA                                          
//*                                                                             
//SORTOUT  DD  DSN=&&W011NDC,DISP=(NEW,PASS,DELETE),                            
//********     LAGERBAND FRÅN NDC:ERNA                                          
//********     DC41, DC42, DC43 AND DC51                                        
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT02  EXEC PGM=SORT                                                         
//SORTIN   DD  DSN=&INDLDC..W01184(+0),DISP=SHR                                 
//         DD  DSN=&INDSDC..W01184(+0),DISP=SHR                                 
//         DD  DSN=&&W011NDC,DISP=(OLD,DELETE,DELETE)                           
//SORTOUT  DD  DSN=&&W01184,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEB                                                    
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTDCAR),DISP=SHR                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W02008   EXEC PGM=V16459,PARM='W02008/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(500,500))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//IGZSRTCD DD  DUMMY                                                            
//W02008D1 DD  DSN=&&W01184,DISP=(OLD,DELETE,DELETE)                            
//************ DAGLAGERBAND - SDC/LDC SORTERAD                                  
//*                                                                             
//W02008D2 DD  DSN=&INDIN..W02030(+0),DISP=SHR                                  
//************ FIL SOM SKALL KOMPLETTERAS MED CLEARINGORSAK                     
//*                                                                             
//W02008D3 DD  DSN=&INDUT..W02031(+1),DISP=(NEW,CATLG,DELETE),  -LIM(6)         
//************ SRSINFO KOMPLETTERAD MED CLEARINGORSAK                           
//             SPACE=(26,(125,41),RLSE),AVGREC=K,                               
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
