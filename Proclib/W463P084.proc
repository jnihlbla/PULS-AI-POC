//W463P084 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W463..W463S8,                                             
//             INDUT=&W463..W463S8                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W46384  EXEC PGM=W46384                                                       
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
