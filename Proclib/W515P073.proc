//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR DETALJ-LISTA ÖVER DAGENS REDOVISNINGAR TILL SAP                     
//*  LISTAN LÄGGS SEDAN PÅ ON-DEMAND                                            
//*                                                                             
//*  FREKVENS:     DAG     RTN W515D3                                           
//*                                                                             
//*  ÅTERSTART:    W51573  NORMAL                                               
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W515P073 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W515..W515D3,                                             
//             INDUT=&W515..W515D3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W510PD74),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51575(+0),DISP=SHR                                  
//************ FIL MED DAGENS ALLA KONTERINGAR ÅT SAP                           
//*                                                                             
//SORTOUT  DD  DSN=&&W51575,DISP=(NEW,PASS,DELETE),                             
//************ SORTERAD KONTERINGS-FIL                                          
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51573   EXEC PGM=W51573                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//W51573D1 DD  DSN=&&W51575,DISP=(OLD,DELETE,DELETE)                            
//************ FIL MED DAGENS ALLA KONTERINGAR ÅT SAP, SORTERADE                
//*                                                                             
//W51573D2 DD  DSN=&INDUT..W5157O(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ W51573-001  LISTA GRUNDBOKFÖRINGSTRANSAR TILL SAP/R3             
//             DATACLAS=PSEB                                                    
//W51573D3 DD  DSN=&INDUT..W5157P(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ W51573-002  LISTA GRUNDBOKFÖRINGSTRANSAR TILL SAP/R3             
//             DATACLAS=PSEB                                                    
//W51573D4 DD  DSN=&INDUT..W5157Q(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ W51573-003  LISTA GRUNDBOKFÖRINGSTRANSAR TILL SAP/R3             
//             DATACLAS=PSEB                                                    
//W51573D5 DD  DSN=&INDUT..W5157R(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ W51573-004  LISTA GRUNDBOKFÖRINGSTRANSAR TILL SAP/R3             
//             DATACLAS=PSEB                                                    
//W51573D6 DD  DSN=&INDUT..W5157S(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ LINE DATA FILE TO SEND TO SNOWFLAKE                              
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
