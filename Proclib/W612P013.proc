//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SORTERAR W61211 OCH W61212, MATCHAR DESSA OCH SKRIVER W61213.              
//*                                                                             
//*  FREKVENS:     REDOVISNINGSPERIOD     RTN W612R3                            
//*                                                                             
//*  ÅTERSTART:    W61213    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W612P013 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W612..W612R3,                                             
//             INDUT=&W612..W612R3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61213   EXEC PGM=V16459,PARM='W61213/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(CYL,(10,10))                                              
//SORTMSG  DD  SYSOUT=*                                                         
//W61213D1 DD  DSN=&INDIN..W61211(+0),DISP=SHR                                  
//************ INFIL MED LAGERPLATSINFO IFRÅN WDK7:                             
//*                                                                             
//TEMP1    DD  DSN=&&TEMP1,DISP=(NEW,PASS,DELETE),                              
//************ TEMPFIL MED SORTERAD DATA IFRÅN OVANSTÅENDE:                     
//             DATACLAS=PSEB                                                    
//*                                                                             
//W61213D3 DD  DSN=&INDIN..W61212(+0),DISP=SHR                                  
//************ INFIL MED LAGERPLATSINFO IFRÅN WDJ8 OCH 'RELOCATION              
//************ PARAMETRAR' IFRÅN WDR2:                                          
//*                                                                             
//TEMP2    DD  DSN=&&TEMP2,DISP=(NEW,PASS,DELETE),                              
//************ TEMPFIL MED SORTERAD DATA IFRÅN OVANSTÅENDE:                     
//             DATACLAS=PSEB                                                    
//*                                                                             
//W61213D5 DD  DSN=&INDUT..W61213(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ UTFIL MED ARTIKLAR IFRÅN OVAN FILER SOM UPPFYLLER                
//************ 'REALLOCATION RULES'                                             
//             DATACLAS=PSEB,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//*                                                                             
//SORTWK01 DD  DATACLAS=PSB                                                     
//SORTWK02 DD  DATACLAS=PSB                                                     
//SORTWK03 DD  DATACLAS=PSB                                                     
//SORTWK04 DD  DATACLAS=PSB                                                     
