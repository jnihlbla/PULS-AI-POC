//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SUGER UT INFORMATION FRÅN PSB-MEDLEMMAR FÖR ATT                            
//*  FÖDA DATAMANAGER.                                                          
//*                                                                             
//*  FREKVENS:     VECKA    RTN WDMRV3                                          
//*                                                                             
//*  ÅTERSTART:    WDMR62    NORMAL                                             
//*                OBSERVERA ATT INFILEN DELETAS OM NORMAL AVSLUTNING           
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WDMRP062 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WDMR..WDMRV3,                                             
//             INDUT=&WDMR..WDMRV3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WDMR62   EXEC PGM=WDMR62                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//WDMR62D1 DD  DSN=&INDIN..WDMR61(+0),DISP=SHR                                  
//************ ALLA MEDLEMMAR I W.PROD.PSB                                      
//*                                                                             
//WDMR62D2 DD  DSN=&INDUT..WDMR62(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ UTSUGEN INFO FRÅN PSB-MEDLEMMAR                                  
//             MGMTCLAS=&BACKUPC,SPACE=(23475,(20,5),RLSE)                      
//*                                                                             
//WDMR62D3 DD  DSN=&INDUT..WDMR63(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ UTSUGEN INFO FRÅN PSB-MEDLEMMAR OM TRANSAR                       
//             MGMTCLAS=&BACKUPC,SPACE=(23475,(20,5),RLSE)                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
