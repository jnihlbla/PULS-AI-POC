//*                                                                             
//*  SKICKAR ERSÄTTNINGSMEDDELANDEN TILL VIPS.                                  
//*                                                                             
//*  FREKVENS:     DAG         RTN W116D2                                       
//*                                                                             
//*  ÅTERSTART:    W11634      NORMAL                                           
//*                LÄSER        WDK7 WDK6 WDD7                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W116P034 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W116..W116D2,                                             
//             INDREG=&W116,                                                    
//             INDUT=&W116..W116D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11634   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W11634,W11634,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDK7     INCLUDE MEMBER=WDK7                                                  
//WDK6     INCLUDE MEMBER=WDK6                                                  
//WDD7     INCLUDE MEMBER=WDD7                                                  
//WDL6     INCLUDE MEMBER=WDL6                                                  
//WDB6     INCLUDE MEMBER=WDB6                                                  
//W11634D1 DD  DSN=&INDIN..W11631(+0),DISP=SHR                                  
//************ ERSÄTTNINGAR                                                     
//*                                                                             
//W11634D2 DD  DSN=&INDREG..W11635(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ ERSÄTTNINGAR TILL KOMMANDE BEVAKNINGAR                           
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//W11634D3 DD  DSN=&INDUT..W11636(+1),DISP=(NEW,CATLG,DELETE),  -LIM(2)         
//************ ERSÄTTNINGSINFO TILL USA                                         
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//W11634D4 DD  DSN=&INDUT..W11637(+1),DISP=(NEW,CATLG,DELETE),  -LIM(2)         
//************ ERSÄTTNINGSINFO CANADA                                           
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//W11634D5 DD  DSN=&INDUT..W11638(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ ERSÄTTNINGSINFO INVENTERINGEN                                    
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&NOBACKUP                                               
//W11634D6 DD  DSN=&INDUT..W1163D(+1),DISP=(NEW,CATLG,DELETE), -LIM(2)          
//************ UPPDATERINGAR TILL BMP W1167D00, TIERSDAT-VIPS                   
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
