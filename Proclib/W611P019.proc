//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LÄSER WDR6 OCH SKRIVER LOGGADE R34-TRANSAR PÅ                              
//*  FIL, EN FÖR LISTUTSKRIFR OCH EN FÖR RENSNING AV WDR6                       
//*                                                                             
//*  FREKVENS:     VECKA    RTN W611V1                                          
//*                                                                             
//*  ÅTERSTART:    W61119      NORMAL                                           
//*                LÄSER  WDR6                                                  
//*                       WDB6                                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W611P019 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W611..W611V1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W61119   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W61119,W61119,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//         DD  DSN=&INDRTE..CONSTANT(OSAM),DISP=SHR                             
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDR6     INCLUDE MEMBER=WDR6                                                  
//WDB6     INCLUDE MEMBER=WDB6                                                  
//*                                                                             
//W61119D1 DD  DSN=&INDUT..W61119(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ LOGGADE R34-TRANSAR FÖR RENSNING AV WDR6                         
//             SPACE=(227,(100,300),RLSE),AVGREC=U,                             
//             MGMTCLAS=&DEL2BKPC                                               
//W61119D2 DD  DSN=&INDUT..W61121(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ LOGGADE R34-TRANSAR FÖR UTSKRIFT PÅ LISTA                        
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&DEL2BKPC                                               
//W61119D3 DD  DSN=&INDUT..W61123(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ LOGGADE R34-TRANSAR FÖR EKONOMISYSTEM W510                       
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//W61119D4 DD  DSN=&INDUT..W6119P(+1),DISP=(NEW,CATLG,DELETE),  -LIM(99)        
//************ LOGGADE R34-TRANSAR FÖR SCRAPPING FOLLOW UP                      
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
