//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  COPIES WXTR9C(+0) TO WXTR.PARTINFO.WCDCDAY(+1)                             
//*  COPIES WXTR9S(+0) TO WXTR.PARTINFO.WSDCDAY(+1)                             
//*  COPIES WXTR9N(+0) TO WXTR.PARTINFO.WNDCDAY(+1)                             
//*  COPIES WXTR9K(+0) TO WXTR.PARCINFO.WNDCDAY(+1)                             
//*                                                                             
//*  FREQUENCE:    DAILY   (RTN WXTRD2)                                         
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                          NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTRP092 PROC INDIN=&WXTR..WXTRD2,                                            
//             INDUT2=&WXTR..PARTINFO,                                          
//             INDUT3=&WXTR..PARTINFO,                                          
//             INDUT4=&WXTR..PARTINFO,                                          
//             INDUT5=&WXTR..PARCINFO                                           
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ICEGENE1 EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDIN..WXTR9C(+0),DISP=SHR                                  
//************ CDC-INFORMATION                                                  
//*                                                                             
//SYSUT2   DD  DSN=&INDUT2..WCDCDAY(+1),                        -LIM(1)         
//************ CDC-INFORMATION                                                  
//             DISP=(NEW,CATLG,DELETE),                                         
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ICEGENE2 EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDIN..WXTR9S(+0),DISP=SHR                                  
//************ SDC-INFORMATION                                                  
//*                                                                             
//SYSUT2   DD  DSN=&INDUT3..WSDCDAY(+1),                        -LIM(1)         
//************ SDC-INFORMATION                                                  
//             DISP=(NEW,CATLG,DELETE),                                         
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ICEGENE3 EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDIN..WXTR9N(+0),DISP=SHR                                  
//************ SDC-INFORMATION                                                  
//*                                                                             
//SYSUT2   DD  DSN=&INDUT4..WNDCDAY(+1),                        -LIM(1)         
//************ SDC-INFORMATION                                                  
//             DISP=(NEW,CATLG,DELETE),                                         
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ICEGENE4 EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDIN..WXTR9K(+0),DISP=SHR                                  
//************ CN-INFORMATION                                                   
//*                                                                             
//SYSUT2   DD  DSN=&INDUT5..WNDCDAY(+1),                        -LIM(1)         
//************ CN-INFORMATION                                                   
//             DISP=(NEW,CATLG,DELETE),                                         
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
