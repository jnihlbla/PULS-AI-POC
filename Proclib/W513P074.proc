//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W513P074 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W513..W513D2,                                             
//             INDUT=&W513..W513D2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WSRTDCAR),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51377(+0),DISP=SHR                                  
//************ SB-WDH1 SDC FRÅN W513P098                                        
//*                                                                             
//SORTOUT  DD  DSN=&&W51377,DISP=(NEW,PASS,DELETE),                             
//************ SORTERAD SB-WDH1 SDC                                             
//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT2    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W513PD74),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51371(+0),DISP=SHR                                  
//         DD  DSN=&INDIN..W5137B(+0),DISP=SHR                                  
//************ URVALSFILER ALLA DC                                              
//*                                                                             
//SORTOUT  DD  DSN=&&W51371,DISP=(NEW,PASS,DELETE),                             
//************ SORTERAD URVALSFIL PER DC OCH ARTIKELNR                          
//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51374  EXEC PGM=W51374                                                       
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR              -- DATKORT          
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR       -- DATKORT          
//DATUT    DD  SYSOUT=*                                     -- DATKORT          
//V16247D3 DD  SYSOUT=*                                    -- POSTSUM           
//*                                                                             
//W51374D1 DD  DSN=&&W51371,DISP=(OLD,DELETE,DELETE)                            
//************  IN, SORTERAD URVALSFIL FRÅN W513P07B O W51371                   
//*                                                                             
//W51374D2 DD  DSN=&&W51377,DISP=(OLD,DELETE,DELETE)                            
//************ IN, BEFINTLIGA URVAL PÅ WDH1 SORTERADE                           
//*                                                                             
//W51374D3 DD  DSN=&&W51374,DISP=(NEW,PASS,DELETE),                             
//************ UT, TEMPORÄR URVALSFIL SDC                            ***        
//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT3    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W513PD72),DISP=SHR                         
//SORTIN   DD  DSN=&&W51374,DISP=(OLD,DELETE,DELETE)                            
//************ TEMPFIL W51374                                                   
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W51374(+1),DISP=(NEW,CATLG,DELETE), -LIM(01)         
//************ SORTERAD URVALSFIL W51374                                        
//             DATACLAS=PSEN,MGMTCLAS=&BACKUPC                                  
