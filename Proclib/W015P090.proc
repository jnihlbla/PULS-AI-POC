//********************************************************************          
//***                                                              ***          
//***    DENNA PROCEDURE ÄGS AV WDB2. VID PROBLEM RING 92100       ***          
//***                                                              ***          
//***          TVÅ TYPER AV INPUTKORT FINNS.                       ***          
//***          ENA MEN EJ BÅDA KAN UTESLUTAS.                      ***          
//***          TYP1 : EX.  CHECK = X                               ***          
//***               TRANSACTION SOM BÖRJA MED ÖNSKAD X SELECTERAS  ***          
//***               X FÅR VARA 1 TILL 8 POS LÅNGT                  ***          
//***          TYP2 : EX.  W0001   W0002   L0007                   ***          
//***               0 - 40 KORT MED NODE-NAMN, 1 - 10 PER KORT     ***          
//***               8 POS PER NODE                                              
//***               ÖNSKADE NODER SELECTERAS.                                   
//********************************************************************          
//W015P090 PROC DSIN=F1IMV1.LOGSTATD(+0),                                       
//             DSOUT=NULLFILE,SPACE=30,10',=,                                   
//             MGMTCLAS=&BACKUPC,                                               
//             STPLIB=&INDRTE..LOAD                                             
//W01590  EXEC PGM=W01590                                                       
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//SYSOUT   DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=*                                                         
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//W01590D1 DD  DSN=&DSIN,DISP=OLD                                               
//W01590D2 DD  DSN=&DSOUT,DISP=(NEW,CATLG,DELETE),                              
//             SPACE=(TRK,(&SPACE),RLSE),                                       
//             DCB=(RECFM=FB,LRECL=24,BLKSIZE=23472),                           
//             MGMTCLAS=&MGMTCLAS                                               
//W01590D3 DD  DDNAME=SYSIN                                                     
