//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  WRITES PARTS WITH CHANGED KDERS                                            
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W271D8                                         
//*                                                                             
//*  RESTART:      W27208    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W272P008 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN2=&W271..W271D8,                                            
//             INDUT=&W271..W271D8                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W27208   EXEC PGM=V16459,PARM='W27208/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//W27208D1 DD  DSN=&INDIN2..W27108(-1),DISP=SHR                                 
//************ OLD                                                              
//*                                                                             
//W27208D2 DD  DSN=&INDIN2..W27108(+0),DISP=SHR                                 
//************ NEW                                                              
//*                                                                             
//W27208D3 DD  DSN=&INDUT..W27208(+1),DISP=(NEW,CATLG,DELETE), -LIM(9)          
//************ UTFIL TILL W27209                                                
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
