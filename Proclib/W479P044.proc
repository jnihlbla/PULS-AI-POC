//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  COPY W47955B FILES TO A NEW FILE TO SAVE THE W47955B GENS                  
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W479M3                                       
//*                                                                             
//*  RESTART:                NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W479P044 PROC INDIN=&W479..W479M3,                                            
//             INDUT=&W479..W479M3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ICEGENER EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&INDIN..W47955B,DISP=SHR                                     
//************ W47955B FILE FROM W479V2 RENAMED IN W479M3RS                     
//*                                                                             
//SYSUT2   DD  DSN=&INDUT..W47955C(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ W47955C                                                          
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
