//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SALDOAVSTÄMNING PER ARTIKEL                                                
//*                                                                             
//*  RESULTAT: SALDODIFFAR OCH KVANTDIFFAR PER DIFFANDE ARTIKEL                 
//*                                                                             
//*  FREKVENS:     DAG, VECKA ELLER VID BEHOV                                   
//*                                                                             
//*  ÅTERSTART:    W57075    NORMAL                                             
//*             OBS OBS OBS:                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W570P075 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W570..W500V1,                                             
//             INDIN1=&W570..W570D3,                                            
//             INDUT=&W570..W570D3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W57075   EXEC PGM=V16459,PARM='W57075/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD SYSOUT=(D,,DUMP),DEST=QSE09012,HOLD=YES                           
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(CYL,(100,100))                                            
//SORTMSG  DD  SYSOUT=*                                                         
//W57075D1 DD  DSN=&INDIN..W5105C(+0),DISP=SHR                                  
//************ LAGERSALDON FRÅN VECKANS BÖRJAN                                  
//*                                                                             
//W57075D2 DD  DSN=&INDIN1..W5105C(+0),DISP=SHR                                 
//************ LAGERSALDON VID AVSTÄMNINGSTILLFÄLLET                            
//*                                                                             
//W57075D3 DD  DSN=&INDIN1..W57070,DISP=SHR                                     
//************ SAP-LAGERBOKNINGAR HITTILLS UNDER VECKAN                         
//*                                                                             
//TPFIL1   DD  DSN=&&TEMP,DISP=(NEW,PASS,DELETE),                               
//************ TEMPORÄR FIL MED SORTERADE FAKT.RADER                            
//             DATACLAS=PSEB                                                    
//TPFIL2   DD  DSN=&&TEMP,DISP=(NEW,DELETE,DELETE),                             
//************ TEMPORÄR FIL MED SORTERADE FAKT.RADER                            
//             DATACLAS=PSEB                                                    
//TPFIL3   DD  DSN=&&TEMP,DISP=(NEW,DELETE,DELETE),                             
//************ TEMPORÄR FIL MED SORTERADE FAKT.RADER                            
//             DATACLAS=PSEB                                                    
//TPFIL4   DD  DSN=&&TEMP,DISP=(NEW,DELETE,DELETE),                             
//************ TEMPORÄR FIL MED SORTERADE FAKT.RADER                            
//             DATACLAS=PSEB                                                    
//W57075D5 DD  DSN=&&W57075A,DISP=(NEW,PASS,DELETE),                            
//             DATACLAS=PSEB                                                    
//************ W57075-001  LISTA ÖVER KÖRNINGENS KVANT-DIFFAR                   
//W57075D6 DD  DSN=&&W57075B,DISP=(NEW,PASS,DELETE),                            
//             DATACLAS=PSEB                                                    
//************ W57075-002  LISTA ÖVER KÖRNINGENS BELOPPS-DIFFAR                 
//W57075D7 DD  DSN=&&W57075D,DISP=(NEW,PASS,DELETE),                            
//             DATACLAS=PSEB                                                    
//************ W57075-004  LISTA ÖVER KÖRNINGENS IN O UTGÅENDE LAGV O BO        
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *           
//ICEGENER EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&&W57075A,DISP=(OLD,PASS,DELETE)                             
//         DD  DSN=&&W57075B,DISP=(OLD,PASS,DELETE)                             
//         DD  DSN=&&W57075D,DISP=(OLD,PASS,DELETE)                             
//*                                                                             
//SYSUT2   DD  DSN=&INDUT..W57077(+1),DISP=(NEW,CATLG,DELETE), -LIM(03)         
//************ W57075-00X ALLA LISTOR PÅ EN FIL, PRINTAS PÅ MEMOPRINTERN        
//             DATACLAS=PSEB                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *           
//ICEGEN2  EXEC PGM=V16459,PARM='ICEGENER/3/'                                   
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DUMMY                                                            
//SYSUT1   DD  DSN=&&W57075D,DISP=(OLD,PASS,DELETE)                             
//*                                                                             
//SYSUT2   DD  DSN=&INDUT..W57078(+1),DISP=(NEW,CATLG,DELETE), -LIM(03)         
//************ W57075-00X TOTALLISTAN PÅ EN FIL, FÖR MAIL TILL EKONOMI          
//             DATACLAS=PSEN                                                    
