//*                                                                             
//*  SKAPAR TULLISTOR FÖR DISTR 8032                                            
//*                                                                             
//*  FREKVENS:     MÅNAD     RTN W475M1                                         
//*                                                                             
//*  ÅTERSTART:    W47544    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W475P044 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN2=&W510..W475M1,                                            
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W475PD44),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN2..W51046,DISP=SHR                                     
//************ HOLLÄNDSK TULLSUMMERING FRÅN EKONOMI (AVVIKELSER)                
//*                                                                             
//SORTOUT  DD  DSN=&&W47588,DISP=(NEW,PASS,DELETE),                             
//************ TULLFIL SORTERAD PÅ FAKTURANUMMER + POSTTYP                      
//         SPACE=(6233,(50,10),RLSE),AVGREC=K                                   
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47544   EXEC PGM=V16459,PARM='W47544/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//*                                                                             
//OUT1  OUTPUT CLASS=A,FORMS=3803,FORMDEF=SLSR6C,PAGEDEF=SLSR6C                 
//*                                                                             
//W47544D1 DD  DSN=&&W47588,DISP=(OLD,DELETE,DELETE)                            
//************ SORTERAD TULLFIL                                                 
//*                                                                             
//W47544D2 DD  SYSOUT=(,),OUTPUT=(*.OUT1),DEST=&DEST1                           
//************ W47544-001    LISTA PER SRA-KOD                                  
//************ W47544-001NL  LISTA PER SRA-KOD                                  
//*                                                                             
//W47544D3 DD  SYSOUT=(,),OUTPUT=(*.OUT1),DEST=&DEST1                           
//************ W47544-002    LISTA MED ALLA 8032:S FAKTUROR                     
//************ W47544-002NL  LISTA MED ALLA 8032:S FAKTUROR                     
//*                                                                             
