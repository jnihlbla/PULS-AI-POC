//WXTRP004 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WXTR..WXTRD1,                                             
//             INDREG=&WXTR,                                                    
//             INDUT=&WXTR..WXTRD1,                                             
//             DEST=LOCAL                                                       
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTR04   EXEC PGM=V16459,PARM='WXTR04/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//WXTR04D1 DD  DSN=&INDIN..WXTR17(+0),DISP=SHR                                  
//*                                                                             
//WXTR04D2 DD  DSN=&INDREG..WXTRAA(+0),DISP=SHR                                 
//************ COUNTRY TABELL                                                   
//*                                                                             
//WXTR04D3 DD  DSN=&INDUT..WXTR04(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ EFRFIL PER DC/DISTR                                              
//             SPACE=(37,(25,5),RLSE),AVGREC=K,                                 
//             MGMTCLAS=&NOBACKUP                                               
//*                                                                             
//WXTR04D4 DD  DSN=&&TEMP1,DISP=(NEW,PASS,DELETE),                              
//             SPACE=(43,(25,5),RLSE),AVGREC=U                                  
//*                                                                             
//WXTR04D5 DD  SYSOUT=(A,,STD),DEST=&DEST                                       
//************ EFRLISTA TILL SAR                                                
//*                                                                             
