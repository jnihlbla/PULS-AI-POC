//             INDUT=&WDMR..WDMRV3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(WDMRPD66),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..WDMR64(+0),DISP=SHR                                  
//************ PSB-ER SOM SKA ÄNDRAS ELLER TAS BORT                             
//*                                                                             
//SORTOUT  DD  DSN=&&WDMR64S,DISP=(NEW,PASS,DELETE),                            
//************ SORTERAD PSB-FIL                                                 
