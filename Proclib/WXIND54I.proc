//*              *  XICS - VERSION 5.4  JULY 1989  *                            
//*              *        INDEX PROCESSOR          *                            
//*              ***********************************                            
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *           
//WXINDX   PROC DSIN=NULLFILE,DSUT=NULLFILE,FLDS=FLDS0,                         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *           
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *           
//*                                                                             
//*          **************************************                             
//*          *   XICS -  VERSION 5.4  AUGUST 1989 *                             
//*          *         INDEX PROCESSOR            *                             
//*          **************************************                             
//*                                                                             
//        LOAD=XICS54,               LOAD LIBRARY NAME LEVEL 2                  
//        LIB=LOAD,                  LOAD LIBRARY NAME LEVEL 3                  
//        GROUP=VPUBV1,              USER LIBRARY NAME LEVEL 1                  
//        VSAM=VPUBV1V,              VSAM NAME LEVEL 1                          
//        VPROJ=XICS54,              VSAM NAME LEVEL 2                          
//        PROG=INDRPR,               PROGRAM NAME                               
//        OCLASS='*',                OUTPUT CLASS FOR LOG                       
//        MDB=XICSMSG                MESSAGE DATA BASE                          
//*                                                                             
//*                                                                             
//TOMFIL  EXEC PGM=V16266,                                                      
//             PARM='DD'                                                        
//DD1       DD DSN=&DSUT,DISP=(NEW,PASS,DELETE),                                
//             DCB=(RECFM=VB,LRECL=84,BLKSIZE=1680),                            
//             MGMTCLAS=DEL2BKPC,                                               
//             SPACE=(CYL,(1,1),RLSE)                                           
//*    ***********************                                                  
//*    *   INDEX PROCESSOR   *                                                  
//*    ***********************                                                  
//*                                                                             
//INDEX   EXEC PGM=&PROG,                                                       
//             COND=(4,LT)                                                      
//STEPLIB   DD DSN=&GROUP..&LOAD..&LIB,DISP=SHR                                 
//CSSIN     DD DSN=&DSIN,DISP=(OLD,PASS)           INDEX INPUT                  
//CSSOUT    DD DSN=&DSUT,DISP=(,PASS),             INDEX OUTPUT                 
//             SPACE=(CYL,(1,1)),                                               
//             DCB=(RECFM=VB,LRECL=84,BLKSIZE=1680)                             
//FT04F001  DD DSN=&INDGRND..XICSLIB(&FLDS),DISP=SHR       OPTION               
//FT05F001  DD SYSOUT=&OCLASS                              LOG                  
//FT06F001  DD SYSOUT=&OCLASS                                                   
//VSRN06    DD DSN=&VSAM..&VPROJ..&MDB,DISP=SHR                                 
