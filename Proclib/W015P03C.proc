//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  RENSNING AV TRANSAR FRÅN WDRX (WLFILX)                                     
//*  SAMMA PROGRAM KAN RENSA TRANSAR FRÅN WDR3/WLFILC, WDR6/WLFILA              
//*  OCH WDR8/WLFILB.                                                           
//*  RIKTIGA VÄRDEN MÅSTE GES PÅ SYMBOLISKA PARAMETRARNA:                       
//*                                                                             
//*   DSIN = NAMN PÅ FIL MED NYCKLAR TILL DE TRANSAR SOM SKA RENSAS             
//*          (COPYTEXT W015WDRX)                                                
//*   BASNAMN = MEDLEM I CONSTANT INNEHÅLLANDE NAMNET PÅ AKTUELL                
//*          BAS. SE WDR3NAMN, WDR6NAMN ETC.                                    
//*   PSB =  UPPDATERINGS-PSB FÖR AKTUELL BAS (WDR3UP ETC)                      
//*                                                                             
//*                                                                             
//*  FREKVENS:     DAG         OLIKA RUTINER                                    
//*                                                                             
//*  ÅTERSTART:    W01533    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W015P033 PROC STPLIB=&INDRTE..LOAD,                                           
//             CPU=1,                                                           
//             DSIN=NULLFILE,BASNAMN=DUMMY,PSB=DUMMY                            
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W01533   EXEC PGM=DFSRRC00,                                                   
//             PARM=('BMP,W01533,&PSB,,,N00,,,,,&CPU,,,&IMS')                   
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//W01533D1 DD  DSN=&DSIN,DISP=SHR                                               
//************ LOGG-FIL MED TRANSAR ATT RENSA                                   
//*                                                                             
//W01533D2 DD  DSN=&INDRTE..CONSTANT(&BASNAMN),DISP=SHR                         
//************ NAMNET PÅ AKTUELL DATABAS                                        
//*                                                                             
