//W371P085 PROC INDREG=&W371,INDUT=&W371..W371S2,                               
//             INDIN=&W371..W371S2,                                             
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W37185   EXEC PGM=W37185                                                      
//STEPLIB   DD DSN=&STPLIB,DISP=SHR                                             
//SORTMSG   DD SYSOUT=*                                                         
//SYSOUT    DD SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3  DD SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//*                                                                             
//W37185D1  DD DSN=&INDREG..W37186(+0),DISP=SHR                                 
//*                                                                             
//W37185D2  DD DSN=&INDIN..W37184(+0),DISP=SHR                                  
//*                                                                             
//W37185D3  DD DSN=&INDREG..W37186(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//             SPACE=(6222,(10,5),RLSE),                                        
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//W37185D4  DD DSN=&INDUT..W37187(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
