//WREXX   PROC COMMAND=,MEMBER=SAKNAS,                                          
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//REXX    EXEC PGM=IRXJCL,PARM='&COMMAND'                                       
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//SYSEXEC  DD  DSN=&W..ISPF.EXEC,DISP=SHR                                       
//         DD  DSN=&W..ISPF.CLIST,DISP=SHR                                      
//         DD  DSN=SYS2.F1TS00.EXEC,DISP=SHR                                    
//         DD  DSN=SYS2.F1TS00.CLIST,DISP=SHR                                   
//SYSTSPRT DD  SYSOUT=*                                                         
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                                         
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SYSTSIN  DD  DDNAME=SYSIN                                                     
//SYSIN    DD  DSN=&INDRTE..CONSTANT(&MEMBER),DISP=SHR                          
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//ABEND   EXEC PGM=ABEND,COND=(4,GE,REXX),PARM='1234567890123456'               
