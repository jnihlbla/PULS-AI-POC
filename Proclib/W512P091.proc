//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES LIST OF MONTH'S DIRECT DELIVERY BOOKINGS                           
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W512M3                                       
//*                                                                             
//*  RESTART:      W51291    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W512P091 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W570..W512M3,                                            
//             INDIN2=&W515..W512M3,                                            
//             INDUT=&W512..W512M3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51291   EXEC PGM=V16459,PARM='W51291/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=F1ST00.CONSTANT(NORMAL),DISP=SHR                             
//DATUT    DD  SYSOUT=*                                                         
//W51291D1 DD  DSN=&INDIN1..W57069B(+0),DISP=SHR                                
//         DD  DSN=&INDIN2..W51569B(+0),DISP=SHR                                
//************ FILE OF MONTH'S DIRECT DELIVERY BOOKINGS                         
//*                                                                             
//TPFIL1   DD  DSN=&&TPFIL1,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//TPFIL2   DD  DSN=&&TPFIL2,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//W51291D2 DD  DSN=&INDUT..W51291A(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ REPORT OF MONNTH'S DIRECT DELIVERY BOOKINGS - SUMMARY            
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//W51291D3 DD  DSN=&INDUT..W51291B(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ REPORT OF MONTH'S DIRECT DELIVERY BOOKINGS - DETAIL              
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
