//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATE .CSV REPORT WHICH HAS RECORDS FROM T01DLIN_ARC                      
//*                                                                             
//*  FREQUENCE:    MONTHLY     RTN W512M2                                       
//*                                                                             
//*  RESTART:      W51294    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W512P094 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W512..W512M2,                                             
//             INDUT=&W512..W512M2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//************ SORT FILE ON IDLEGSEL*********************************           
//SORT01   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W512PD27),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51293D(+0),DISP=SHR                                 
//************ REMUNERATION                                                     
//*                                                                             
//SORTOUT  DD  DSN=&&W51293D,DISP=(NEW,PASS,DELETE),                            
//************ W51293D SORTED ON IDLEGSEL                                       
//             DATACLAS=PSEB                                                    
//*                                                                             
//*******************************************************************           
//SORT02   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W512PD27),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51294D(+0),DISP=SHR                                 
//************ REMUNERATION                                                     
//*                                                                             
//SORTOUT  DD  DSN=&&W51294D,DISP=(NEW,PASS,DELETE),                            
//************ W51294D SORTED ON IDLEGSEL                                       
//             DATACLAS=PSEB                                                    
//*                                                                             
//*******************************************************************           
//SORT03   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W512PD27),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51295D(+0),DISP=SHR                                 
//************ REMUNERATION                                                     
//*                                                                             
//SORTOUT  DD  DSN=&&W51295D,DISP=(NEW,PASS,DELETE),                            
//************ W51295D SORTED ON IDLEGSEL                                       
//             DATACLAS=PSEB                                                    
//*                                                                             
//*******************************************************************           
//SORT04   EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W512PD27),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W51296D(+0),DISP=SHR                                 
//************ REMUNERATION                                                     
//*                                                                             
//SORTOUT  DD  DSN=&&W51296D,DISP=(NEW,PASS,DELETE),                            
//************ W51296D SORTED ON IDLEGSEL                                       
//             DATACLAS=PSEB                                                    
//*                                                                             
//***************************************************                           
//W51294   EXEC PGM=V16459,PARM='W51294/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//W51294D1 DD  DSN=&&W51293D,DISP=SHR                                           
//************ VCCS RECORD FROM T01DLIN_ARC QTY AS PER DC                       
//*                                                                             
//W51294D2 DD  DSN=&&W51294D,DISP=SHR                                           
//************ NON-VCCS RECORD FROM T01DLIN_ARC QTY PER DC                      
//*                                                                             
//W51294D3 DD  DSN=&&W51295D,DISP=SHR                                           
//************ VCCS RECORD FROM T01DLIN_ARC QTY AS PER COMPANY                  
//*                                                                             
//W51294D4 DD  DSN=&&W51296D,DISP=SHR                                           
//************ NON-VCCS RECORD FROM T01DLIN_ARC QTY PER COMPANY                 
//*                                                                             
//W51294D5 DD  DSN=&INDUT..W51293A(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ REPORT WITH VCCS RECORD QTY PER DC                               
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
//W51294D6 DD  DSN=&INDUT..W51294A(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ REPORT WITH NON-VCCS RECORD QTY PER DC                           
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
//W51294D7 DD  DSN=&INDUT..W51295A(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ REPORT WITH VCCS RECORD QTY PER COMPANY                          
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
//W51294D8 DD  DSN=&INDUT..W51296A(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ REPORT WITH NON-VCCS RECORD QTY PER COMPANY                      
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
