//WWAITTST PROC ROUTINE=DUMMY,WAITFOR=DUMMY,                                    
//             MAXRC=4,INDEX=&W                                                 
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *           
//LISTGEN EXEC PGM=V12340,COND=(&MAXRC,LT),                                     
//             PARM=(' LISTCAT ENTRY(&INDEX..&ROUTINE..&WAITFOR) ')             
//V12340D1 DD  DUMMY,DCB=BLKSIZE=80                                             
//V12340D2 DD  DSN=&&LIST,DISP=(NEW,PASS,DELETE),                               
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=160),                             
//             SPACE=(TRK,1)                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *           
//LIST    EXEC PGM=IDCAMS,COND=(&MAXRC,LT)                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&&LIST,DISP=(OLD,DELETE,DELETE)                              
