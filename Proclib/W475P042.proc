//W475P042 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W475..W475M1,                                             
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47542   EXEC PGM=V16459,PARM='W47542/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//*                                                                             
//OUT1  OUTPUT CLASS=A,FORMS=3803,FORMDEF=SLSR6C,PAGEDEF=SLSR6C                 
//*                                                                             
//W47542D1 DD  DSN=&INDIN..W47587,DISP=SHR                                      
//************ HOLLÄNDSK TULLSUMMERING                                          
//*                                                                             
//W47542D2 DD  SYSOUT=(,),OUTPUT=(*.OUT1),DEST=&DEST1                           
//************ W47542-001    LISTA PER SRA-KOD                                  
//************ W47542-001NL  LISTA PER SRA-KOD                                  
//*                                                                             
//W47542D3 DD  SYSOUT=(,),OUTPUT=(*.OUT1),DEST=&DEST1                           
//************ W47542-002    LISTA MED ALLA HOLLÄNDSKA FAKTUROR                 
//************ W47542-002NL  LISTA MED ALLA HOLLÄNDSKA FAKTUROR                 
