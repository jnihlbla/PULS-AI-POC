//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  READS FILES FROM SAP. CREATES FILES FOR BILLIT AND                         
//*  SAP MANUAL UPDATES                                                         
//*                                                                             
//*  FREQUENCE:    DAILY     RTN WF10D4                                         
//*                                                                             
//*  RESTART:      WF1041    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WF10P041 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WF10..WF10D4,                                             
//             INDUT=&WF10..WF10D4                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WF1041   EXEC PGM=IKJEFT01,DYNAMNBR=20,PARM=' '                               
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=SYS1.F1D200.DSNLOAD,DISP=SHR                                 
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSTSPRT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                                         
//SYSTSIN  DD  DUMMY                                                            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WF1041D1 DD  DSN=&INDIN..WF1051(+0),DISP=SHR                                  
//************ FILE FROM SAP                                                    
//*                                                                             
//WF1041D2 DD  DSN=&INDUT..WF1052(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ UTFIL MED RÄTTNINGSINFO FRÅN SAP TILL RSREDO                     
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//WF1041D3 DD  DSN=&INDUT..WF1053(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ TO BILLIT                                                        
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//WF1041D4 DD  DSN=&INDUT..WF1054(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ ERROR FILE OF MISSING KDTRADP                                    
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEB                                  
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//         IF  (WF1041.RC GT 4) THEN                                            
//ABEND    EXEC PGM=ABEND,PARM='1234567890123456'                               
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                     -- ABEND           
//         ENDIF                                                                
