//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  CREATES .CSV FILE FOR RECEIVED GOODS  FOR US AND CN                        
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W561V1                                         
//*                                                                             
//*  RESTART:      W56142    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W561P042 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W561..W561V1,                                             
//             INDUT=&W561..W561V1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT1    EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W561PD42),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W56141(+0),DISP=SHR                                  
//************ W56141 INFILE FOR SORT                                           
//*                                                                             
//SORTOUT  DD  DSN=&&W56141,DISP=(NEW,PASS,DELETE),                             
//************ W56141 OUTFILE SORTED                                            
//             DATACLAS=PSEN                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56142   EXEC PGM=W56142                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W56142D1 DD  DSN=&&W56141,DISP=(OLD,DELETE,DELETE)                            
//************ W56141 OUTFILE SORTED                                            
//*                                                                             
//W56142D2 DD  DSN=&INDUT..W56142(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ RECEIVED GOODS REPORT FOR US AND CN TO D&P                       
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
