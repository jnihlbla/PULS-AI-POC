//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR MÅNATLIGA TULLISTOR FÖR ALL EXPORT FRÅN SDC21 (NL)                  
//*                                                                             
//*  FREKVENS:     MÅNAD    RTN W475M1                                          
//*                                                                             
//*  ÅTERSTART:    W47550    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W475P050 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W475..W475M1,                                             
//             INDIN2=&W510..W475M1,                                            
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W475PD50),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W4758T,DISP=SHR                                      
//************ HOLL TULLSUM ALL EXPORT FRÅN SDC21                               
//         DD  DSN=&INDIN2..W51046,DISP=SHR                                     
//************ HOLL TULLSUM FRÅN EKONOMI (AVVIKELSER)                           
//*                                                                             
//SORTOUT  DD  DSN=&&W4758T,DISP=(NEW,PASS,DELETE),                             
//************ TULLFIL SORTERAD PÅ FAKTURANUMMER + POSTTYP                      
//         SPACE=(6233,(50,10),RLSE),AVGREC=K                                   
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W47550   EXEC PGM=V16459,PARM='W47550/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//*                                                                             
//OUT1  OUTPUT CLASS=A,FORMS=3803,FORMDEF=SLSR6C,PAGEDEF=SLSR6C                 
//*                                                                             
//W47550D1 DD  DSN=&&W4758T,DISP=(OLD,DELETE,DELETE)                            
//************ SORTERAD TULLFIL                                                 
//*                                                                             
//W47550D2 DD  SYSOUT=(,),OUTPUT=(*.OUT1),DEST=&DEST1                           
//************ W47550-001    LISTA PER SRA-KOD                                  
//************ W47550-001NL  LISTA PER SRA-KOD                                  
//*                                                                             
//W47550D3 DD  SYSOUT=(,),OUTPUT=(*.OUT1),DEST=&DEST1                           
//************ W47550-002    LISTA MED ALLA SDC21-FAKTUROR                      
//************ W47550-002NL  LISTA MED ALLA SDC21-FAKTUROR                      
//*                                                                             
