//W233P001 PROC INDUT=&W233..W100V2,INDIN2=&W233..W100V2,                       
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W23310  EXEC PGM=W23310                                                       
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//*                                                                             
//W23310D1 DD  DSN=&INDIN2..W23305(+0),DISP=SHR                                 
//*                FRÅN W611P095                                                
//W23310D2 DD  DSN=&INDUT..W23311(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//**************                                                    ***         
//             SPACE=(93,(2,1),RLSE),AVGREC=K,                                  
//             MGMTCLAS=&NOBACKUP                                               
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//V16247D3 DD  SYSOUT=*       UTSKRIFT AV RÄKNEVERK (POSTSUM)                   
//SORTMSG  DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
