//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  INPUT FILE IS AN EXTRACT OF WDD9 DB USING DL1PR                            
//*  CREATE A TAB-SEPARATED EXTRACT OF WDD907 FILE                              
//*  TO SEND TO THE DATALAKE                                                    
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W236D5                                         
//*                                                                             
//*  RESTART:      W2361E    NORMAL                                             
//*                          NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W236P01E PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W236..W236D5                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W2361E   EXEC PGM=V16459,PARM='W2361E/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//INFIL01  DD  DSN=&INDIN..WDD907(+0),DISP=SHR                                  
//************                                                                  
//*                                                                             
//UTFIL01  DD  DSN=&&W2361EX,DISP=(NEW,PASS,DELETE),                            
//************ TAB-SEPARATED EXTRACT FILE OF WDD907                             
//             DATACLAS=PSEB                                                    
//*                                                                             
