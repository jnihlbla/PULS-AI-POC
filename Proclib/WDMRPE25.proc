//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WDMRPE25 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WDMR..WDMRV6,                                             
//             INDUT=&WDMR..WDMRV6                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WDMR25   EXEC PGM=WDMR25                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SORTMSG  DD  SYSOUT=*                                                         
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//WDMR25D1 DD  DSN=&INDIN..WDMR23(+0),DISP=SHR                                  
//************ NYA MODULDATA-FILEN                                              
//*                                                                             
//WDMR25D2 DD  DSN=&INDIN..WDMROE(+0),DISP=SHR                                  
//************ GAMLA MODULDATA-FILEN                                            
//*                                                                             
//WDMR25D3 DD  DSN=&INDUT..WDMR24(+1),DISP=(NEW,CATLG,DELETE),  -LIM(1)         
//************ MODULER SOM SKALL UPPDATERAS                                     
//             MGMTCLAS=&DEL2BKPC,DATACLAS=PSEN                                 
//*                                                                             
