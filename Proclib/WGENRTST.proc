//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  TEST OF LAST GENERATION NUMBER FOR A FILE                                  
//*  RETURN CODE IS SET TO 0 IF THE GENERATION IS = SPECIFIED NBR               
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W157P042 PROC DSIN=NULLFILE,GEN=1                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//T        EXEC PGM=IKJEFT01,DYNAMNBR=50,PARM='WGENRTST &DSIN &GEN'             
//SYSHELP  DD  DUMMY                                                            
//SYSEXEC  DD  DSN=&W..ISPF.EXEC,DISP=SHR                                       
//         DD  DSN=&INDGRND..EXEC,DISP=SHR                                      
//         DD  DSN=SYS2.F1TS00.EXEC,DISP=SHR                                    
//SYSPROC  DD  DSN=&W..ISPF.CLIST,DISP=SHR                                      
//         DD  DSN=&INDGRND..CLIST,DISP=SHR                                     
//**       DD  DSN=SYS2.F1TS00.CLIST,DISP=SHR                                   
//SYSTSPRT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                                         
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//SYSTSIN  DD  DUMMY                                                            
