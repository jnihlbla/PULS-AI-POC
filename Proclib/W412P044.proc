//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LÄSER WDQ4 FÖR LDC ORDRAR MED RFS OM 3 DAGAR                               
//*                                                                             
//*  FREKVENS:     DAG     RTN W412D7                                           
//*                                                                             
//*  ÅTERSTART:              NORMAL                                             
//*                W41244      NORMAL                                           
//*                LÄSER        WDQ4                                            
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W412P044 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W412..W412D7,                                             
//             INDUT=&W412..W412D7                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W412PD44),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W41243(+0),DISP=SHR                                  
//************ INFIL                                                            
//*                                                                             
//SORTOUT  DD  DSN=&&W41243,DISP=(NEW,PASS,DELETE),                             
//************ UTFIL                                                            
//             DATACLAS=PSEN                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W41244   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W41244,W41244,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(VSAM4K),DISP=SHR                           
//         DD  DSN=&INDRTE..CONSTANT(VSAM8K),DISP=SHR                           
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//WDQ4     INCLUDE MEMBER=WDQ4                                                  
//WDB6     INCLUDE MEMBER=WDB6                                                  
//*                                                                             
//W41244D1 DD  DSN=&&W41243,DISP=(OLD,DELETE,DELETE)                            
//************ INFIL                                                            
//*                                                                             
//W41244D2 DD  DSN=&INDUT..W41244(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ UTFIL CDC ORDERRADER TILL LDC KUNDER                             
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
//*                                                                             
//W41244D3 DD  DSN=&INDUT..W41241A(+1),DISP=(NEW,CATLG,DELETE), -LIM(3)         
//************ UTFIL LDC1A ORDERRADER TILL LDC KUNDER                           
//             MGMTCLAS=&NOBACKUP,DATACLAS=PSEN                                 
