//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  PROGRAM TO CREATE WXTR FILE IN EDITED FORMAT                               
//*  FOR AZURE DATALAKE                                                         
//*                                                                             
//*  FREQUENCE:    DAILY     RTN WXTRD3                                         
//*                                                                             
//*  RESTART:      WXTR24    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTRP024 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W011..LDC,                                               
//             INDIN2=&W011..SDC,                                               
//             INDIN3=&W011..NDC                                                
//*            INDUT1=&WXTR..LDC,                                               
//*            INDUT2=&WXTR..SDC,                                               
//*            INDUT3=&WXTR..NDC                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WXTR24   EXEC PGM=WXTR24                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//WXTR24D1 DD  DSN=&INDIN1..W01184(+0),DISP=SHR                                 
//         DD  DSN=&INDIN2..W01184(+0),DISP=SHR                                 
//         DD  DSN=&INDIN3..W01184(+0),DISP=SHR                                 
//************ W01184 FILE                                                      
//*                                                                             
//WXTR24D2 DD  DSN=&&W01184L,DISP=(NEW,PASS,DELETE),                            
//             DATACLAS=PSEB                                                    
//*                                                                             
//WXTR24D3 DD  DSN=&&W01184S,DISP=(NEW,PASS,DELETE),                            
//             DATACLAS=PSEB                                                    
//*                                                                             
//WXTR24D4 DD  DSN=&&W01184N,DISP=(NEW,PASS,DELETE),                            
//             DATACLAS=PSEB                                                    
//*                                                                             
