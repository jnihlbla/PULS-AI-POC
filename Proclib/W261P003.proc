//W261P003 PROC INDIN=&W261..W261P1,INDUT=&W261..W261P1,                        
//             MBR=W26134,PSB=W26134,                                           
//             STPLIB=&INDRTE..LOAD                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W26132  EXEC PGM=SORT                                                         
//SORTIN   DD  DSN=&INDIN..W26121(+0),DISP=SHR                                  
//*                ORDERINGÅNGSINFO (WDL8) FRÅN W261P002                        
//*                                                                             
//SORTOUT  DD  DSN=&&W26133,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W261PD32),DISP=SHR                         
