//WDMRP029 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&WDMR..WDMRV6,                                             
//             DEST1=&CPRINT                                                    
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//WDMR16   EXEC PGM=V16459,PARM='WDMR16/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(200,200))                                           
//WDMR16D1 DD  DSN=&INDIN..WDMR28(+0),DISP=SHR                                  
//************ DATA MANAGER SYSOUT                                              
//*                                                                             
//A4LF   OUTPUT FORMDEF=SLSR6C,PAGEDEF=SLSR6C                                   
//WDMR16D2 DD  SYSOUT=(A,,3803),DEST=&DEST1,OUTPUT=(*.A4LF),                    
//************ WDMR16-001  FELLISTA                                             
