//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SKAPAR RENSNINGPOSTER AV SALDOPOSTER ÄLDRE ÄN 15 ARBETSDAGAR               
//*  STARTAR W555Y1 NÄR RENSNINGSDATUM PASSERAR ÅRSSKIFTE                       
//*                                                                             
//*  SKAPAR SPAR-POSTER FÖR KOMMANDE LADDNING AV VALDA ARTIKLAR                 
//*                                                                             
//*  FREKVENS:     VECKA     RTN W555V1                                         
//*                                                                             
//*  ÅTERSTART:    W55502 NORMAL,   UTOM I SLUTET AV JANUARI DÅ                 
//*                RISK FINNS ATT W555Y1 SPARKAS IGÅNG AUTOMATISKT              
//*                FLERA GÅNGER.                                                
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W555P002 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDUT=&W555..W555V1,                                             
//             SOPREG=&INDRTE..SOP,                                             
//             PDSLIB=&INDRTE..JCL,                                             
//             PDSTEMP=&INDRTE.TMP.JCL                                          
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W55502   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W55502,W55502,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//DFSCTL   DD  DSN=F1IM00.IMS.CONSTANT(SBCOND),DISP=SHR                         
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//OSDAT    DD  DSN=&INDRTE..DATUM(+0),DISP=SHR                                  
//DATIN    DD  DSN=&INDRTE..CONSTANT(NORMAL),DISP=SHR                           
//DATUT    DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDL9     INCLUDE MEMBER=WDL9                                                  
//*                                                                             
//W55502D1 DD  DSN=&INDUT..W55501(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ VECKANS SPARPOSTER                                               
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&NOBACKUP                                               
//W55502D2 DD  DSN=&INDUT..W55502(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ RENSPOSTER                                                       
//             DATACLAS=PSEN,                                                   
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
//SOPDD1   DD  DSN=&SOPREG,DISP=SHR            -- SOP DATA BASE                 
//PDSDD1   DD  DSN=&PDSTEMP,DISP=SHR           -- TEMP PDS JOB LIB              
//PDSDD2   DD  DSN=&PDSLIB,DISP=SHR            -- PDS JOB LIB                   
