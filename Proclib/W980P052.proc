//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SORTERAR OM EN UNLOADFIL FRÅN SOP SÅ ATT NYCKLARNA                         
//*  KOMMER I EN SLUMPMÄSSIG ORDNING                                            
//*                                                                             
//*  FREKVENS:     FLERA GGR PER ÅR     RTN W980B1                              
//*                                                                             
//*  ÅTERSTART:    W98052    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W980P052 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W980..W980B1,                                             
//             INDUT=&W980..W980B1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//BI       EXEC PGM=WGDGDEF,PARM=('&INDUT.',W98052,3)                           
//STEPLIB  DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSOUT   DD  SYSOUT=*                                                         
//WGDGDED1 DD                                                                   
//WGDGDED2 DD                                                                   
//*                                                                             
//W98052   EXEC PGM=W98052                                                      
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//*        DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//*FSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W98052D1 DD  DSN=&INDIN..W98050(+0),DISP=SHR                                  
//************ SOP-UNLOADFIL                                                    
//*                                                                             
//W98052D2 DD  DSN=&&TEMP,DISP=(NEW,PASS,DELETE),                               
//************ UNLOADFIL MED RANDOMNYCKEL TILL VARJE DATA-NYCKEL                
//             SPACE=(23430,(200,20),RLSE)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W980PD52),DISP=SHR                         
//SORTIN   DD  DSN=&&TEMP,DISP=(OLD,PASS,DELETE)                                
//************ GF                                                               
//*                                                                             
//SORTOUT  DD  DSN=&INDUT..W98052(+1),DISP=(NEW,CATLG,DELETE),  -LIM(3)         
//************ SORTERAD UNLOADFIL                                               
//             MGMTCLAS=DEL2,SPACE=(23430,(200,20),RLSE)                        
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
