//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  SENDS PRICE ROW FROM 5206 TO 5111                                          
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W510D7                                         
//*                                                                             
//*  RESTART:      W51085    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W510P085 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W213..W510D7                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W51085   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W51085,W51085,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//W51085D1 DD  DSN=&INDIN..W21350,DISP=SHR                                      
//************ PARTS WITH SUPPLIER NUMBER FOR CDC                               
//         DD  DSN=&INDIN..W21352A,DISP=SHR                                     
//************ PARTS WITH SUPPLIER NUMBER FROM CN                               
//         DD  DSN=&INDIN..W21352B,DISP=SHR                                     
//************ PARTS WITH SUPPLIER NUMBER FROM US                               
//*                                                                             
