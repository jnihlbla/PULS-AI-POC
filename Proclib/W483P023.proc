//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  MATCH W48321 AND W48322                                                    
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W483V2                                         
//*                                                                             
//*  RESTART:      W48323    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W483P023 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W483..W483V2,                                             
//             INDUT=&W483..W483V2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W48323   EXEC PGM=V16459,PARM='W48323/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  SPACE=(4096,(100,100))                                           
//SORTMSG  DD  SYSOUT=*                                                         
//W48323D1 DD  DSN=&INDIN..W48321(+0),DISP=SHR                                  
//************ EXTRACT FROM WDE6                                                
//*                                                                             
//W48323D2 DD  DSN=&INDIN..W48322(+0),DISP=SHR                                  
//************ EXTRACT FROM WDB2 AND WDB1                                       
//TEMP1    DD  DSN=&&TEMP1,DISP=(NEW,DELETE,DELETE),                            
//             MGMTCLAS=BACKUPC,DATACLAS=PSEB                                   
//TEMP2    DD  DSN=&&TEMP2,DISP=(NEW,DELETE,DELETE),                            
//             MGMTCLAS=BACKUPC,DATACLAS=PSEB                                   
//*                                                                             
//*                                                                             
//W48323D3 DD  DSN=&INDUT..W48323(+1),DISP=(NEW,CATLG,DELETE), -LIM(99)         
//************ FINAL TRANSPORTATION REPORT                                      
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
//*                                                                             
