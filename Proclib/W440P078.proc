//W440P078 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDREG=&W440,                                                    
//             INDIN=&W440..W440V3,                                             
//             DEST1=&QSE09012,                                                 
//             INDUT=&W440..W440V3                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W440PD78),DISP=SHR                         
//SORTIN   DD  DSN=&INDREG..W44061(+0),DISP=SHR                                 
//************ FIL FRÅN W440P060 MED WDA5-INFO                                  
//*                                                                             
//SORTOUT  DD  DSN=&&W44061,DISP=(NEW,PASS,DELETE),                             
//************ SORTERAD TEMP-FIL MED WDA5-INFO                                  
//             DATACLAS=PSEB                                                    
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W44078   EXEC PGM=V16459,PARM='W44078/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//EZTVFM   DD  SPACE=(4096,(10000,1000))                                        
//SORTMSG  DD  SYSOUT=*                                                         
//W44078D1 DD  DSN=&INDIN..W44051(+0),DISP=SHR                                  
//************ FIL FRÅN W440P051 MED SORTERAD WDQ4-INFO                         
//WDQ4     DD  DSN=&&WDQ4,DISP=(NEW,PASS,DELETE),                               
//************ MELLANLAGRINGSFIL                                                
//             DATACLAS=PSEB                                                    
//*                                                                             
//W44078D2 DD  DSN=&&W44061,DISP=SHR                                            
//************ TEMP-FIL MED SORTERAD WDA5-INFO                                  
//WDA5     DD  DSN=&&WDA5,DISP=(NEW,PASS,DELETE),                               
//************ MELLANLAGRINGSFIL                                                
//             DATACLAS=PSEB                                                    
//*                                                                             
//W44078D3 DD  DSN=&INDIN..W44070(+0),DISP=SHR                                  
//************ FIL FRÅN W440P070 MED SORTERAD WDQ1-INFO                         
//WDQ1     DD  DSN=&&WDQ1,DISP=(NEW,PASS,DELETE),                               
//************ MELLANLAGRINGSFIL                                                
//             DATACLAS=PSEB                                                    
//*                                                                             
//W44078D4 DD  DSN=&INDIN..W44077(+0),DISP=SHR                                  
//************ FIL FRÅN W440P055 MED SORTERAD WDK7-INFO                         
//ARTSALDO DD  DSN=&&ARTSALDO,DISP=(NEW,PASS,DELETE),                           
//************ MELLANLAGRINGSFIL                                                
//             DATACLAS=PSEB                                                    
//RADSALDO DD  DSN=&&RADSALDO,DISP=(NEW,PASS,DELETE),                           
//************ MELLANLAGRINGSFIL                                                
//             DATACLAS=PSEB                                                    
//*                                                                             
//A4LF OUTPUT FORMDEF=SLSR6C,PAGEDEF=SLSR6C                                     
//*                                                                             
//W44078D5 DD  SYSOUT=(H,,3803),DEST=&DEST1,OUTPUT=(*.A4LF),                    
//************ W44078  LISTA MED DIFFAR                                         
