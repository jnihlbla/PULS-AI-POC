//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  LOADS WDB7                                                                 
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W432V2                                         
//*                                                                             
//*  RESTART:      W43220      BACKOUT (VIA SOP)                                
//*                UPDATES      WDB7                                            
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W432P020 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W432..W432V2                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SORT     EXEC PGM=SORT                                                        
//SYSOUT   DD  SYSOUT=*                                                         
//SYSIN    DD  DSN=&INDRTE..CONSTANT(W432PD20),DISP=SHR                         
//SORTIN   DD  DSN=&INDIN..W43220(+0),DISP=SHR                                  
//*                                                                             
//SORTOUT  DD  DSN=&&W43220,DISP=(NEW,PASS,DELETE),                             
//             DATACLAS=PSEN                                                    
//*                                                                             
//W43220   EXEC PGM=DFSRRC00,                                                   
//             PARM=('&DBB,W43220,W43220,,00')                                  
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//DFSRESLB DD  DSN=&INDRESL..RESLIB,DISP=SHR                                    
//IMS      DD  DSN=&INDRTE..PSBLIB,DISP=SHR                                     
//         DD  DSN=&INDRTE..DBDLIB,DISP=SHR                                     
//IMSACB   DD  DSN=&INDRTE..ACBLIB,DISP=SHR                                     
//IEFRDER  DD  DUMMY                                                            
//DFSURWF1 DD  DSN=&&DFSURWF1,DISP=(NEW,PASS,DELETE),                           
//             SPACE=(4096,(1260,180),RLSE),                                    
//             DCB=(BLKSIZE=27930,BUFNO=5)                                      
//DFSVSAMP DD  DSN=&INDRTE..CONSTANT(VSAM),DISP=SHR                             
//BMCPRINT DD  SYSOUT=*                                     -- DISPLAY          
//BMCMSG   DD  SYSOUT=*                                     -- DISPLAY          
//SYSOUT   DD  SYSOUT=*                                     -- DISPLAY          
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                                     
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                                        
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//WDB7     INCLUDE MEMBER=WDB7                                                  
//W43220D1 DD  DSN=&&W43220,DISP=SHR                                            
//************ LOAD RECORDS WDB7                                                
//*                                                                             
