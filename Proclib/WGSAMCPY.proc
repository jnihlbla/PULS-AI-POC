//*                                                                             
//WGSAMCPY PROC INDIN=RXXX,INDUT=RXXX,GSAM=,                                    
//             SPACE='(6233,(30,30),RLSE)'                                      
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//GENER   EXEC PGM=V16459,PARM='ICEGENER/4/',COND=(0,LT)                        
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUT1   DD  DSN=&INDIN..GSAM.&GSAM,DISP=SHR                                  
//************** EN ELLER FLERA GSAM-GENERATIONER                   ***         
//*                                                                             
//SYSUT2   DD  DSN=&INDUT..BMP.&GSAM.(+1),DISP=(NEW,CATLG,DELETE),              
//************** KOPIA                                              ***         
//             SPACE=&SPACE,MGMTCLAS=&BACKUPC                                   
//*                                                                             
//SYSIN    DD  DUMMY                                                            
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//SCRATCH EXEC PGM=IEFBR14,COND=(0,LT)                                          
//DD1      DD  DSN=&INDUT..GSAM.&GSAM,DISP=(OLD,DELETE,DELETE)                  
