//*                                                                             
//*  DAILY LISTS FOR PARTS WITHOUT AVG COST                                     
//*                                                                             
//*  FREQUENCE:    DAILY     RTN W560D1                                         
//*                                                                             
//*  RESTART:      W56090    NORMAL                                             
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W560P090 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN1=&W011..NDC,                                               
//             INDUT=&W560..W560D1                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W56090   EXEC PGM=V16459,PARM='W56090/8/'                                     
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//EZTVFM   DD  DATACLAS=PSEN                                                    
//SORTMSG  DD  SYSOUT=*                                                         
//W56090D1 DD  DSN=&INDIN1..W01184(+0),DISP=SHR                                 
//************ EXTRACT OF WDK7                                                  
//*                                                                             
//W56090D2 DD  DSN=&INDUT..W56090(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//********** W56090-001 REPORT FILE                                             
//             MGMTCLAS=&BACKUPC                                                
//*                                                                             
