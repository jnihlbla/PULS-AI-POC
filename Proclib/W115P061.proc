//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//*                                                                             
//*  TRIGGERED FROM 1155 SCREEN. UPDATES WDK6 WITH                              
//*  PARAMETERS PASSED FROM THE JCL                                             
//*                                                                             
//*  FREQUENCY:    ON DEMAND               RTN W115S4                           
//*                                                                             
//*  RESTART:      W11561    NORMAL  (BMP)                                      
//*                                                                             
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W115P061 PROC STPLIB=&INDRTE..LOAD,                                           
//             INDIN=&W115..W115S4,                                             
//             INDUT=&W115..W115S4                                              
//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *         
//W11561   EXEC PGM=DFSRRC00,                                                   
//  PARM=('BMP,W11561,W11561,,,N00,,,,,&CPU,,,&IMS')                            
//STEPLIB  DD  DSN=&STPLIB,DISP=SHR                                             
//         DD  DSN=&INDUSRL..USERLIB,DISP=SHR                                   
//         DD  DSN=&INDLIB2..LOAD,DISP=SHR                                      
//         DD  DSN=&INDLIB3..LOAD,DISP=SHR                                      
//         DD  DSN=&INDGRND..LOAD,DISP=SHR                                      
//SYSPRINT DD  SYSOUT=*                                                         
//SYSOUT   DD  SYSOUT=*                                                         
//CEEDUMP  DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//SYSUDUMP DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//IDIHIST  DD  DSN=&INDRTE..FADUMP,DISP=SHR                 -- ABEND            
//IDIREPRT DD  SYSOUT=(D,,DUMP),HOLD=YES                    -- ABEND            
//V16247D3 DD  SYSOUT=*                                     -- POSTSUM          
//*                                                                             
//W11561D1 DD  DUMMY                                                            
//************ PARAMETERS FROM 1155 (OVERRIDE IN JCL)                           
//*                                                                             
//W11561D2 DD  DSN=&INDIN..W01160(+0),DISP=SHR                                  
//************ PARTS INFO FROM WDK6                                             
//*                                                                             
//W11561D3 DD  DSN=&INDUT..W11561(+1),DISP=(NEW,CATLG,DELETE), -LIM(1)          
//************ PARTS UPDATED INFO                                               
//             MGMTCLAS=&BACKUPC,DATACLAS=PSEN                                  
//*                                                                             
