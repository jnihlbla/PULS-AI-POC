*                                                                               
         DBD   NAME=WDF5,RMNAME=(V12008,,50400),                       *        
               ACCESS=(HDAM,OSAM)                                               
         DATASET DD1=WDF5V,DEVICE=3390,SIZE=2048,SCAN=0                         
*                                                                               
         SEGM  NAME=WDF501,PARENT=0,BYTES=10,PTR=T                              
         FIELD NAME=(IDARTNR,SEQ,U),BYTES=5,START=1,TYPE=P                      
         LCHILD NAME=(WDF5A1,WDF5A),PTR=INDX                                    
         XDFLD NAME=WDF5ASEQ,                                          *        
               SRCH=(IDLEVNR,IDLEVART),SEGMENT=WDF502,                 *        
               SUBSEQ=(/CKARTNR,IDBENR)                                         
         LCHILD NAME=(WDF5B1,WDF5B),PTR=INDX                                    
         XDFLD NAME=WDF5BSEQ,                                          *        
               SRCH=IDLEVART,SEGMENT=WDF502,                           *        
               SUBSEQ=(/CKARTNR,IDLEVNR,IDBENR)                                 
*                                                                               
         SEGM  NAME=WDF502,PARENT=WDF501,BYTES=75,PTR=T                         
         FIELD NAME=(WDF5KEY,SEQ,U),BYTES=6,START=1,TYPE=X                      
         FIELD NAME=(IDLEVNR),BYTES=5,START=1,TYPE=X                            
         FIELD NAME=(IDBENR),BYTES=1,START=6,TYPE=P                             
         FIELD NAME=(BELEVART),BYTES=30,START=8,TYPE=X                          
         FIELD NAME=(IDLEVART),BYTES=30,START=38,TYPE=X                         
         FIELD NAME=(/CKARTNR),BYTES=5,START=1,TYPE=P                           
*                                                                               
         DBDGEN                                                                 
         FINISH                                                                 
         END                                                                    
