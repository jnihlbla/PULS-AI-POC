         LCHILD NAME=(WDD8B1,WDD8B),PTR=INDX                                    
         XDFLD NAME=WDD8BSEQ,SEGMENT=WDD811,                           *        
               SRCH=(IDDC),                                            *        
               SUBSEQ=(/CKARTNR,ADBUFFOM,ADBUFGAN,ADBUFPL,DABUFPAF),   *        
               DDATA=(KVBUFFF,KVBUFFOF,KVKOLIF,KVKOLIOF)                        
*                                                                               
