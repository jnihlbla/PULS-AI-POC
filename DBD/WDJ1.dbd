*        SATS REG                                                               
*                                                                               
         DBD   NAME=WDJ1,RMNAME=(V12008,,3870),                        *        
               ACCESS=(HDAM,OSAM)                                               
         DATASET DD1=WDJ1V,DEVICE=3390,SIZE=4096,SCAN=0                         
*                                                                               
         SEGM  NAME=WDJ101,PARENT=0,BYTES=230,PTR=T                             
         FIELD NAME=(IDARTNR,SEQ,U),BYTES=5,START=1,TYPE=P                      
         FIELD NAME=(FLFORPQ),BYTES=1,START=32,TYPE=X                           
         FIELD NAME=(IDLEVNR),BYTES=5,START=36,TYPE=X                           
         FIELD NAME=(IDTSPEC),BYTES=15,START=42,TYPE=X                          
         FIELD NAME=(IDUSER),BYTES=8,START=57,TYPE=X                            
         FIELD NAME=(TIREGDAT),BYTES=4,START=72,TYPE=P                          
         FIELD NAME=(TIUPPDAT),BYTES=4,START=76,TYPE=P                          
         LCHILD NAME=(WDJ1A1,WDJ1A),PTR=INDX                                    
         XDFLD NAME=WDJ1ASEQ,SEGMENT=WDJ101,                           *        
               SRCH=(IDARTNR),                                         *        
               DDATA=(IDLEVNR,TIREGDAT,TIUPPDAT),                      *        
               EXTRTN=WDJ1AEXT                                                  
*                                                                               
* EXIT FINNS NÄR FLFORPQ = J                                                    
*                                                                               
         LCHILD NAME=(WDJ1B1,WDJ1B),PTR=INDX                                    
         XDFLD NAME=WDJ1BSEQ,SEGMENT=WDJ101,                           *        
               SRCH=(IDTSPEC,IDARTNR)                                           
         LCHILD NAME=(WDJ1D1,WDJ1D),PTR=INDX                                    
         XDFLD NAME=WDJ1DSEQ,SEGMENT=WDJ101,                           *        
               SRCH=(IDUSER,IDARTNR)                                            
*                                                                               
         SEGM  NAME=WDJ111,PARENT=WDJ101,BYTES=120,PTR=T                        
         FIELD NAME=(WDJ111KY,SEQ,U),BYTES=4,START=1,TYPE=X                     
         FIELD NAME=(KDSTRRAD),BYTES=1,START=1,TYPE=X                           
         FIELD NAME=(IDRADNR),BYTES=3,START=2,TYPE=P                            
         FIELD NAME=(IDLEVNR),BYTES=5,START=5,TYPE=X                            
         FIELD NAME=(BELEVART),BYTES=30,START=10,TYPE=X                         
         FIELD NAME=(IDARTNR),BYTES=5,START=40,TYPE=P                           
         FIELD NAME=(TISTADAT),BYTES=4,START=102,TYPE=P                         
         FIELD NAME=(TISTODAT),BYTES=4,START=106,TYPE=P                         
         FIELD NAME=(/CKARTNR),BYTES=5,START=1,TYPE=P                           
         LCHILD NAME=(WDJ1C1,WDJ1C),PTR=INDX                                    
         XDFLD NAME=WDJ1CSEQ,SEGMENT=WDJ111,                           *        
               SRCH=(IDLEVNR,BELEVART,IDARTNR),                        *        
               SUBSEQ=(/CKARTNR,WDJ111KY)                                       
*                                                                               
         SEGM  NAME=WDJ122,PARENT=WDJ111,BYTES=141,PTR=T                        
         FIELD NAME=(IDSTRNOT,SEQ,U),BYTES=1,START=1,TYPE=X                     
*                                                                               
         DBDGEN                                                                 
         FINISH                                                                 
         END                                                                    
