*        KUNDREGISTER GODSMOTTAGARE                                             
*                                                                               
         DBD   NAME=WDB2,                                              *        
               ACCESS=(HISAM,VSAM)                                              
         DATASET DD1=WDB2K,DEVICE=3390,SIZE=4096                                
*                                                                               
         SEGM  NAME=WDB201,PARENT=0,BYTES=1272                                  
         FIELD NAME=(IDGMT,SEQ,U),BYTES=7,START=1,TYPE=X                        
         FIELD NAME=(IDDISTR),BYTES=3,START=1,TYPE=P                            
         FIELD NAME=(IDKUNDNR),BYTES=4,START=4,TYPE=P                           
         FIELD NAME=(IDDCBUL1),BYTES=2,START=411,TYPE=X                         
         FIELD NAME=(IDDCDAY1),BYTES=2,START=425,TYPE=X                         
         FIELD NAME=(IDFTG),BYTES=2,START=1015,TYPE=X                           
         FIELD NAME=(IDLEVNR),BYTES=5,START=1043,TYPE=X                         
         FIELD NAME=(IDPARTNR),BYTES=9,START=1048,TYPE=X                        
         FIELD NAME=(IDPARTNE),BYTES=9,START=1057,TYPE=X                        
         FIELD NAME=(FLLDCKND),BYTES=1,START=1209,TYPE=X                        
         LCHILD NAME=(WDB2A1,WDB2A),PTR=SYMB                                    
         XDFLD NAME=WDB2ASEQ,SEGMENT=WDB201,                           *        
               SRCH=(IDPARTNR,IDFTG,IDDISTR,IDKUNDNR)                           
*                                                                               
         LCHILD NAME=(WDB2B1,WDB2B),PTR=SYMB                                    
         XDFLD NAME=WDB2BSEQ,SEGMENT=WDB201,NULLVAL=BLANK,             *        
               SRCH=(IDLEVNR),SUBSEQ=(IDDISTR,IDKUNDNR)                         
*                                                                               
         LCHILD NAME=(WDB2C1,WDB2C),PTR=SYMB                                    
         XDFLD NAME=WDB2CSEQ,SEGMENT=WDB201,NULLVAL=BLANK,             *        
               SRCH=(IDDCBUL1),SUBSEQ=(IDDISTR,IDKUNDNR)                        
*                                                                               
         DBDGEN                                                                 
         FINISH                                                                 
         END                                                                    
