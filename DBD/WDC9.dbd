*        NYA ARTIKLAR KINA                                                      
*                                                                               
         DBD   NAME=WDC9,                                              *        
               ACCESS=(HISAM,VSAM)                                              
         DATASET DD1=WDC9K,DEVICE=3390,SIZE=4096                                
*                                                                               
         SEGM  NAME=WDC901,PARENT=0,BYTES=40                                    
         FIELD NAME=(WDC901KY,SEQ,U),BYTES=7,START=1,TYPE=X                     
         FIELD NAME=(IDDC),BYTES=2,START=1,TYPE=X                               
         FIELD NAME=(IDARTNR),BYTES=5,START=3,TYPE=P                            
         FIELD NAME=(IDANSK),BYTES=2,START=8,TYPE=P                             
         FIELD NAME=(KDANSKQ),BYTES=1,START=10,TYPE=X                           
         LCHILD NAME=(WDC9A1,WDC9A),PTR=SYMB                                    
         XDFLD NAME=WDC9ASEQ,SEGMENT=WDC901,                           *        
               SRCH=(KDANSKQ,IDANSK),                                  *        
               SUBSEQ=(IDARTNR,IDDC)                                            
*                                                                               
         DBDGEN                                                                 
         FINISH                                                                 
         END                                                                    
