*        IDROLL                                                                 
*                                                                               
         DBD   NAME=WDP4,RMNAME=(V12008,,180),                         *        
               ACCESS=(HDAM,OSAM)                                               
         DATASET DD1=WDP4V,DEVICE=3390,SIZE=4096,SCAN=0                         
*                                                                               
         SEGM  NAME=WDP401,PARENT=0,BYTES=15,PTR=T                              
         FIELD NAME=(IDROLL,SEQ,U),BYTES=5,START=1,TYPE=X                       
*                                                                               
         SEGM  NAME=WDP411,PARENT=WDP401,BYTES=28,PTR=T                         
         FIELD NAME=(IDDISTRT,SEQ,U),BYTES=3,START=1,TYPE=P                     
         FIELD NAME=(IDDISTRF),BYTES=3,START=4,TYPE=P                           
         FIELD NAME=(/CKIDROL),BYTES=5,START=1,TYPE=X                           
         LCHILD NAME=(WDP4A1,WDP4A),PTR=INDX                                    
         XDFLD NAME=WDP4ASEQ,SEGMENT=WDP411,                           *        
               SRCH=(IDDISTRT,IDDISTRF),                               *        
               SUBSEQ=(/CKIDROL)                                                
*                                                                               
         DBDGEN                                                                 
         FINISH                                                                 
         END                                                                    
