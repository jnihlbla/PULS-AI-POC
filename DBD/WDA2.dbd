*        LEVERANSANMÄRKNINGSREGISTER                                            
*                                                                               
         DBD   NAME=WDA2,RMNAME=(V12008,4,210000,25000),               *        
               ACCESS=(HDAM,OSAM)                                               
         DATASET DD1=WDA2V,DEVICE=3390,SIZE=8192,SCAN=0                         
*                                                                               
         SEGM  NAME=WDA201,PARENT=0,BYTES=145,PTR=T                             
         FIELD NAME=(IDLEVANM,SEQ,U),BYTES=14,START=1,TYPE=X                    
         FIELD NAME=(IDDISTR),BYTES=3,START=1,TYPE=P                            
         FIELD NAME=(IDKUNDNR),BYTES=4,START=4,TYPE=P                           
         FIELD NAME=(IDRAPPNR),BYTES=7,START=8,TYPE=X                           
         FIELD NAME=(IDFTG),BYTES=2,START=15,TYPE=X                             
         FIELD NAME=(IDPERSON),BYTES=2,START=17,TYPE=P                          
         FIELD NAME=(KDARBTYP),BYTES=8,START=27,TYPE=X                          
         FIELD NAME=(KDLEVANM),BYTES=1,START=35,TYPE=X                          
         FIELD NAME=(KVRADERO),BYTES=3,START=36,TYPE=P                          
         FIELD NAME=(KVRADERR),BYTES=3,START=39,TYPE=P                          
         FIELD NAME=(FILLERA),BYTES=16,START=70,TYPE=X                          
         FIELD NAME=(DARETANK),BYTES=8,START=70,TYPE=X                          
         FIELD NAME=(DARETILL),BYTES=8,START=78,TYPE=X                          
         FIELD NAME=(BEANST),BYTES=25,START=99,TYPE=X                           
         FIELD NAME=(IDUSERAD),BYTES=8,START=124,TYPE=X                         
         FIELD NAME=(KDLEVATT),BYTES=1,START=132,TYPE=X                         
         LCHILD NAME=(WDA2A1,WDA2A),PTR=INDX                                    
         XDFLD NAME=WDA2ASEQ,SEGMENT=WDA201,                           *        
               SRCH=(KDLEVANM,IDFTG),                                  *        
               SUBSEQ=(IDLEVANM),                                      *        
               DDATA=(IDUSERAD,KDLEVATT,BEANST)                                 
         LCHILD NAME=(WDA2C1,WDA2C),PTR=INDX                                    
         XDFLD NAME=WDA2CSEQ,SEGMENT=WDA201,                           *        
               SRCH=(IDFTG,KDLEVANM,KDARBTYP,IDPERSON,FILLERA),        *        
               SUBSEQ=(IDLEVANM),                                      *        
               DDATA=(KVRADERR,KVRADERO),                              *        
               EXTRTN=WDA2CEXT                                                  
*                                                                               
* EXIT FINNS NÄR KDLEVANM = 4, 5 ELLER 6                                        
*                                                                               
         LCHILD NAME=(WDA2G1,WDA2G),PTR=INDX                                    
         XDFLD NAME=WDA2GSEQ,SEGMENT=WDA201,                           *        
               SRCH=(IDFTG,KDARBTYP,IDPERSON),                         *        
               SUBSEQ=(DARETANK,DARETILL,IDLEVANM),                    *        
               DDATA=(KDLEVANM,KVRADERR,KVRADERO),                     *        
               EXTRTN=WDA2GEXT                                                  
*                                                                               
* EXIT FINNS NÄR KDLEVANM = 5 OCH 6                                             
*                                                                               
         SEGM  NAME=WDA211,PARENT=WDA201,BYTES=288,PTR=T                        
         FIELD NAME=(WDA211KY,SEQ,U),BYTES=8,START=1,TYPE=X                     
         FIELD NAME=(IDARTNR),BYTES=5,START=1,TYPE=P                            
         FIELD NAME=(IDRADNR),BYTES=3,START=6,TYPE=P                            
         FIELD NAME=(ADGANG),BYTES=2,START=9,TYPE=P                             
         FIELD NAME=(ADLAGOMR),BYTES=2,START=11,TYPE=P                          
         FIELD NAME=(ADPLATS),BYTES=3,START=13,TYPE=P                           
         FIELD NAME=(FLTEXT),BYTES=1,START=22,TYPE=X                            
         FIELD NAME=(IDANSTNR),BYTES=3,START=35,TYPE=P                          
         FIELD NAME=(IDDCRET),BYTES=2,START=40,TYPE=X                           
         FIELD NAME=(IDFTG),BYTES=2,START=50,TYPE=X                             
         FIELD NAME=(IDILIST),BYTES=5,START=52,TYPE=X                           
         FIELD NAME=(IDKNOTNR),BYTES=4,START=57,TYPE=P                          
         FIELD NAME=(IDKUNDRF),BYTES=10,START=80,TYPE=X                         
         FIELD NAME=(IDPERSON),BYTES=2,START=95,TYPE=P                          
         FIELD NAME=(KDANMORS),BYTES=2,START=107,TYPE=X                         
         FIELD NAME=(KDARBTYP),BYTES=8,START=109,TYPE=X                         
         FIELD NAME=(KDKREBEH),BYTES=3,START=130,TYPE=X                         
         FIELD NAME=(KVLEVANM),BYTES=4,START=146,TYPE=P                         
         FIELD NAME=(KVLEVANB),BYTES=4,START=150,TYPE=P                         
         FIELD NAME=(DALEVANM),BYTES=8,START=193,TYPE=X                         
         FIELD NAME=(TIUTSKR),BYTES=4,START=209,TYPE=P                          
         FIELD NAME=(TIUPPDAT),BYTES=4,START=218,TYPE=P                         
         FIELD NAME=(/CKLEVAN),BYTES=14,START=1,TYPE=X                          
         LCHILD NAME=(WDA2B1,WDA2B),PTR=INDX                                    
         XDFLD NAME=WDA2BSEQ,SEGMENT=WDA211,                           *        
               SRCH=(IDFTG,KDARBTYP,IDPERSON,DALEVANM),                *        
               SUBSEQ=(/CKLEVAN,IDARTNR,IDRADNR),                      *        
               DDATA=(KDANMORS,KVLEVANB,KDKREBEH,FLTEXT,IDKUNDRF),     *        
               EXTRTN=WDA2BEXT                                                  
*                                                                               
* EXIT FINNS NÄR KDKREBEH (1) = P, R ELLER Q                                    
*                                                                               
         LCHILD NAME=(WDA2D1,WDA2D),PTR=INDX                                    
         XDFLD NAME=WDA2DSEQ,SEGMENT=WDA211,                           *        
               SRCH=(IDFTG,IDARTNR),                                   *        
               SUBSEQ=(/CKLEVAN,IDRADNR),                              *        
               DDATA=(KDANMORS,KVLEVANB)                                        
         LCHILD NAME=(WDA2E1,WDA2E),PTR=INDX                                    
         XDFLD NAME=WDA2ESEQ,SEGMENT=WDA211,                           *        
               SRCH=(IDDCRET,IDILIST,ADLAGOMR,ADGANG,ADPLATS),         *        
               SUBSEQ=(/CKLEVAN,IDARTNR,IDRADNR),                      *        
               DDATA=(IDANSTNR,TIUTSKR,TIUPPDAT),                      *        
               EXTRTN=WDA2EEXT                                                  
*                                                                               
* EXIT FINNS NÄR IDILIST > 0                                                    
*                                                                               
         LCHILD NAME=(WDA2F1,WDA2F),PTR=INDX                                    
         XDFLD NAME=WDA2FSEQ,SEGMENT=WDA211,                           *        
               SRCH=(IDKNOTNR),                                        *        
               SUBSEQ=(/CKLEVAN,IDARTNR,IDRADNR),                      *        
               DDATA=(DALEVANM)                                                 
*                                                                               
         SEGM  NAME=WDA221,PARENT=WDA211,BYTES=1051,PTR=NT                      
         FIELD NAME=(KDSEGKEY,SEQ,U),BYTES=1,START=1,TYPE=X                     
*                                                                               
         SEGM  NAME=WDA222,PARENT=WDA211,BYTES=37,PTR=T                         
         FIELD NAME=(IDTRACK,SEQ,U),BYTES=25,START=1,TYPE=X                     
*                                                                               
         DBDGEN                                                                 
         FINISH                                                                 
         END                                                                    
