*        HISTORIK TRANSPORTER VTV-RA                                            
*                                                                               
         DBD   NAME=WDM9,RMNAME=(V12008,,18000),                       *        
               ACCESS=(HDAM,OSAM)                                               
         DATASET DD1=WDM9V,DEVICE=3390,SIZE=4096,SCAN=0                         
*                                                                               
         SEGM  NAME=WDM901,PARENT=0,BYTES=5,PTR=T                               
         FIELD NAME=(IDARTNR,SEQ,U),BYTES=5,START=1,TYPE=P                      
*                                                                               
         SEGM  NAME=WDM911,PARENT=WDM901,BYTES=60,PTR=T                         
         FIELD NAME=(DADATTI9,SEQ,U),BYTES=14,START=1,TYPE=X                    
         FIELD NAME=(ADTRDEST),BYTES=3,START=15,TYPE=X                          
         FIELD NAME=(IDTRPTNR),BYTES=3,START=18,TYPE=P                          
         FIELD NAME=(/CKARTNR),BYTES=5,START=1,TYPE=P                           
         LCHILD NAME=(WDM9A1,WDM9A),PTR=INDX                                    
         XDFLD NAME=WDM9ASEQ,SEGMENT=WDM911,                           *        
               SRCH=(ADTRDEST),                                        *        
               SUBSEQ=(DADATTI9,/CKARTNR)                                       
         LCHILD NAME=(WDM9B1,WDM9B),PTR=INDX                                    
         XDFLD NAME=WDM9BSEQ,SEGMENT=WDM911,                           *        
               SRCH=(IDTRPTNR),                                        *        
               SUBSEQ=(DADATTI9,/CKARTNR)                                       
*                                                                               
         DBDGEN                                                                 
         FINISH                                                                 
         END                                                                    
