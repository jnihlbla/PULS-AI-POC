MACRO PREF                                                                      
* *                                                                             
* *   W W D C 0 2                                                               
* *                                                                             
* *   THIS MACRO IS USED IN EPLUS CODE TO IDENTIFY THE DC-GROUP TO WHICH        
* *   AN IDDC VALUE BELONGS.THE CONSTANTS USED IN THIS MACRO ARE DEFINED        
* *   IN WWDC99 MACRO. THIS MACRO CAN BE USED REPETEADLY.                       
* *                                                                             
* *   I M P O R T A N T                                                         
* *                                                                             
* *   THIS MACRO MUST BE CHANGED ACCORDINGLY, WHILE CHANGING THE WWDC99         
* *   MACRO.                                                                    
* *                                                                             
                                                                                
S23-CHECK-&PREF.IDDC. PROC                                                      
   GOOD-DC = ' '                                                                
   CDC     = ' '                                                                
   SDC     = ' '                                                                
   NDC     = ' '                                                                
   NDC-US  = ' '                                                                
   NDC-NA  = ' '                                                                
   NDC-PACIFIC = ' '                                                            
   DDC     = ' '                                                                
   LDC     = ' '                                                                
   XDC-NON-VCC-OWNED = ' '                                                      
   IF &PREF.IDDC = CDC-SE, CDC-TR,                             +                
                   SDC-NL, SDC-ES, SDC-IT, SDC-AT,             +                
                   SDC-NL-ET,                                  +                
                   NDC-US-RU, NDC-US-LA, NDC-US-SE,            +                
                   NDC-US-CH, NDC-US-JA, NDC-US-DA,            +                
                   NDC-US-BAT,                                 +                
                   NDC-CA, NDC-BR, NDC-MX,                     +                
                   NDC-AU, NDC-TH, NDC-TH-93, NDC-TW, NDC-KR,  +                
                   NDC-MY, NDC-IN, NDC-JP-6A, NDC-JP-61,       +                
                   NDC-CN-71, NDC-CN-72, NDC-CN-73, NDC-CN-74, +                
                   NDC-RU-81, NDC-RU-82, NDC-ZA, NDC-TR, NDC-AE, +              
                   LDC-SE-1A, LDC-SE-1B, LDC-SE-1C, LDC-SE-1D, +                
                   LDC-SE-1E, LDC-SE-1F, LDC-SE-1G, LDC-SE-1K, +                
                   LDC-GB-2C, LDC-GB-2H,                       +                
                   LDC-DE-2I, LDC-DE-2J, LDC-DE-2L,            +                
                   LDC-NL-2M, LDC-XX-2N, LDC-CH-2O, LDC-GB-3A, +                
                   LDC-GB-3B, LDC-DE-3C, LDC-IT-3D, LDC-DE-3E, +                
                   LDC-IT-3F, LDC-DE-3G, LDC-CH-3H,            +                
                   LDC-NO-3J, LDC-DE-3K, LDC-BE-3L, LDC-DE-3M, +                
                   LDC-NL-3N, LDC-FI-3O, LDC-FR-3P, LDC-NL-3R, +                
                   LDC-PL-3S, LDC-DE-3T,                       +                
                   LDC-XX-4A, LDC-XX-4B, LDC-XX-4C, LDC-XX-4D, +                
                   LDC-CN-7A, LDC-CN-7B, LDC-CN-7C, LDC-CN-7D, +                
                   LDC-CN-7E, LDC-CN-7F, LDC-CN-7G, LDC-CN-7H                   
                                                                                
       GOOD-DC = &PREF.IDDC                                                     
   END-IF                                                                       
   IF &PREF.IDDC = CDC-SE, CDC-TR                                               
        CDC = &PREF.IDDC                                                        
   END-IF                                                                       
   IF &PREF.IDDC = SDC-NL, SDC-ES, SDC-IT, SDC-AT, SDC-NL-ET                    
        SDC = &PREF.IDDC                                                        
   END-IF                                                                       
   IF &PREF.IDDC = NDC-US-RU, NDC-US-LA, NDC-US-SE,            +                
                   NDC-US-CH, NDC-US-JA, NDC-US-DA,            +                
                   NDC-US-BAT,                                 +                
                   NDC-CA, NDC-BR, NDC-MX,                     +                
                   NDC-AU, NDC-TH, NDC-TH-93, NDC-TW, NDC-KR,  +                
                   NDC-MY, NDC-IN, NDC-JP-6A, NDC-JP-61,       +                
                   NDC-CN-71, NDC-CN-72, NDC-CN-73, NDC-CN-74, +                
                   NDC-RU-81, NDC-RU-82, NDC-ZA, NDC-TR, NDC-AE                 
        NDC = &PREF.IDDC                                                        
   END-IF                                                                       
   IF &PREF.IDDC = NDC-US-RU, NDC-US-LA, NDC-US-SE,            +                
                   NDC-US-CH, NDC-US-JA, NDC-US-DA,            +                
                   NDC-US-BAT, NDC-CA                                           
        NDC-NA = &PREF.IDDC                                                     
   END-IF                                                                       
   IF &PREF.IDDC = NDC-BR, NDC-MX                                               
        NDC-NS = &PREF.IDDC                                                     
   END-IF                                                                       
   IF &PREF.IDDC = NDC-US-RU, NDC-US-LA, NDC-US-SE,            +                
                   NDC-US-CH, NDC-US-JA, NDC-US-DA,            +                
                   NDC-US-BAT                                                   
        NDC-US = &PREF.IDDC                                                     
   END-IF                                                                       
   IF &PREF.IDDC = NDC-AU, NDC-IN, NDC-TH, NDC-TH-93, NDC-TW,  +                
                   NDC-KR, NDC-MY, NDC-JP-6A, NDC-JP-61                         
        NDC-PACIFIC = &PREF.IDDC                                                
   END-IF                                                                       
   IF &PREF.IDDC = NDC-CN-71, NDC-CN-72, NDC-CN-73, NDC-CN-74                   
        NDC-CN = &PREF.IDDC                                                     
   END-IF                                                                       
   IF &PREF.IDDC = NDC-JP-6A, NDC-JP-61                                         
        NDC-JP = &PREF.IDDC                                                     
   END-IF                                                                       
   IF &PREF.IDDC = NDC-RU-81, NDC-RU-82, NDC-ZA, NDC-TR, NDC-AE                 
        NDC-NX = &PREF.IDDC                                                     
   END-IF                                                                       
   IF &PREF.IDDC = DDC-SE, DDC-NO, DDC-FI, DDC-GB, DDC-BE, DDC-DE +             
                   DDC-FR, DDC-KR, DDC-PL, DDC-AU                               
        DDC = &PREF.IDDC                                                        
   END-IF                                                                       
   IF &PREF.IDDC = NDC-BR, NDC-MX,                              +               
                   NDC-TH, NDC-TH-93,                           +               
                   NDC-TW, NDC-KR, NDC-MY, NDC-IN,              +               
                   NDC-CN-71, NDC-CN-72, NDC-CN-73, NDC-CN-74,  +               
                   NDC-RU-81, NDC-RU-82, NDC-ZA, NDC-TR, NDC-AE                 
        XDC-NON-VCC-OWNED = &PREF.IDDC                                          
   END-IF                                                                       
   IF &PREF.IDDC = LDC-SE-1A, LDC-SE-1B, LDC-SE-1C, LDC-SE-1D +                 
                   LDC-SE-1E, LDC-SE-1F, LDC-SE-1G, LDC-SE-1K +                 
                   LDC-GB-2C, LDC-GB-2H,                      +                 
                   LDC-DE-2I, LDC-DE-2J, LDC-DE-2L,           +                 
                   LDC-NL-2M, LDC-XX-2N, LDC-CH-2O, LDC-GB-3A +                 
                   LDC-GB-3B, LDC-DE-3C, LDC-IT-3D, LDC-DE-3E +                 
                   LDC-IT-3F, LDC-DE-3G, LDC-CH-3H,           +                 
                   LDC-NO-3J, LDC-DE-3K, LDC-BE-3L, LDC-DE-3M +                 
                   LDC-NL-3N, LDC-FI-3O, LDC-FR-3P, LDC-NL-3R +                 
                   LDC-PL-3S, LDC-DE-3T,                      +                 
                   LDC-XX-4A, LDC-XX-4B, LDC-XX-4C, LDC-XX-4D                   
        LDC = &PREF.IDDC                                                        
   END-IF                                                                       
   IF &PREF.IDDC = LDC-SE-1A, LDC-SE-1B, LDC-SE-1C, LDC-SE-1D +                 
                   LDC-SE-1E, LDC-SE-1F, LDC-SE-1G, LDC-SE-1K                   
        LDC-SE = &PREF.IDDC                                                     
   END-IF                                                                       
   IF &PREF.IDDC = LDC-CN-7A, LDC-CN-7B, LDC-CN-7C, LDC-CN-7D +                 
                   LDC-CN-7E, LDC-CN-7F, LDC-CN-7G, LDC-CN-7H                   
        LDC-CN = &PREF.IDDC                                                     
   END-IF                                                                       
   IF &PREF.IDDC = LDC-SE-1A, LDC-SE-1B, LDC-SE-1C, LDC-SE-1D, +                
                   LDC-SE-1E, LDC-SE-1F, LDC-SE-1G, LDC-SE-1K, +                
                   LDC-GB-2C, LDC-GB-2H,                       +                
                   LDC-DE-2I, LDC-DE-2J, LDC-DE-2L,            +                
                   LDC-NL-2M, LDC-XX-2N, LDC-CH-2O, LDC-GB-3A, +                
                   LDC-GB-3B, LDC-DE-3C, LDC-IT-3D, LDC-DE-3E, +                
                   LDC-IT-3F, LDC-DE-3G, LDC-CH-3H,            +                
                   LDC-NO-3J, LDC-DE-3K, LDC-BE-3L, LDC-DE-3M, +                
                   LDC-NL-3N, LDC-FI-3O, LDC-FR-3P, LDC-NL-3R, +                
                   LDC-PL-3S, LDC-DE-3T                                         
        LDC-EU = &PREF.IDDC                                                     
   END-IF                                                                       
END-PROC                                                                        
MEND                                                                            
* *   W W D C 0 2    E N D S                                                    
