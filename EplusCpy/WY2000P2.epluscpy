MACRO                                                                           
WY2000P2. PROC                                                                  
                                                                                
*---  ADJUST TWO DATE FIELDS IN YY-WW-D FORMAT (5 DIGITS),                      
*---  SO DATES BETWEEN 1950-2049 COME IN ASCENDING SEQUENCE.                    
*---  VALUE ZERO IS CONSIDERED A NON-DATE AND NOT ADJUSTED.                     
                                                                                
     IF TMP1-YYWWD NOT ZERO AND +                                               
        TMP1-YYWWD < 99999                                                      
       IF TMP1-YYWWD < 50000                                                    
         TMP1-YYWWD = TMP1-YYWWD + 50000                                        
       ELSE                                                                     
         TMP1-YYWWD = TMP1-YYWWD - 50000                                        
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP2-YYWWD NOT ZERO AND +                                               
        TMP2-YYWWD < 99999                                                      
       IF TMP2-YYWWD < 50000                                                    
         TMP2-YYWWD = TMP2-YYWWD + 50000                                        
       ELSE                                                                     
         TMP2-YYWWD = TMP2-YYWWD - 50000                                        
       END-IF                                                                   
     END-IF                                                                     
                                                                                
END-PROC                                                                        
