MACRO PREF                                                                      
WWPRSL01.  PROC                                                                 
*                            *************************************              
*                            *** ANVÄNDS VID TEST I W46119 FÖR   *              
*                            *** UTRÄKNING AV BUYBACKKOD         *              
*                            ************************************               
*                                                                               
   IF &PREF.KDPRODSL = 11 14 18 21 24 28                                        
     PRODSLAG-BUYBACK1 = 'J'                                                    
   ELSE                                                                         
     PRODSLAG-BUYBACK1 = 'N'                                                    
   END-IF                                                                       
   IF &PREF.KDPRODSL = 31 34 38 61 64 68                                        
     PRODSLAG-BUYBACK2 = 'J'                                                    
   ELSE                                                                         
     PRODSLAG-BUYBACK2 = 'N'                                                    
   END-IF                                                                       
   IF &PREF.KDPRODSL = 15 35 25 65                                              
     PRODSLAG-BUYBACK3 = 'J'                                                    
   ELSE                                                                         
     PRODSLAG-BUYBACK3 = 'N'                                                    
   END-IF                                                                       
*                                                                               
END-PROC                                                                        
