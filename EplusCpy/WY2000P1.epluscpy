MACRO                                                                           
WY2000P1. PROC                                                                  
*                                                                               
*---  ADJUST TWO DATE FIELDS IN YY-MM-DD FORMAT (6/7 DIGITS),                   
*---  SO DATES BETWEEN 1950-2049 COME IN ASCENDING SEQUENCE.                    
*---  VALUE ZERO IS CONSIDERED A NON-DATE AND NOT ADJUSTED.                     
                                                                                
     IF TMP1-YYMMDD NOT ZERO AND +                                              
        TMP1-YYMMDD < 999999                                                    
       IF TMP1-YYMMDD < 500000                                                  
         TMP1-YYMMDD = TMP1-YYMMDD + 500000                                     
       ELSE                                                                     
         TMP1-YYMMDD = TMP1-YYMMDD - 500000                                     
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP2-YYMMDD NOT ZERO AND +                                              
        TMP2-YYMMDD < 999999                                                    
       IF TMP2-YYMMDD < 500000                                                  
         TMP2-YYMMDD = TMP2-YYMMDD + 500000                                     
       ELSE                                                                     
         TMP2-YYMMDD = TMP2-YYMMDD - 500000                                     
       END-IF                                                                   
     END-IF                                                                     
                                                                                
END-PROC                                                                        
