MACRO                                                                           
WY2000PB. PROC                                                                  
*                                                                               
*---  ADJUST TWO DATE FIELDS IN YY-MM-DD-HH-MM FORMAT (10/11 DIGITS),           
*---  SO DATES BETWEEN 1950-2049 COME IN ASCENDING SEQUENCE.                    
*---  VALUE ZERO IS CONSIDERED A NON-DATE AND NOT ADJUSTED.                     
                                                                                
     IF TMP1-YYMMDDHHMM NOT ZERO AND +                                          
        TMP1-YYMMDDHHMM < 9999999999                                            
       IF TMP1-YYMMDDHHMM < 5000000000                                          
         TMP1-YYMMDDHHMM = TMP1-YYMMDDHHMM + 5000000000                         
       ELSE                                                                     
         TMP1-YYMMDDHHMM = TMP1-YYMMDDHHMM - 5000000000                         
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP2-YYMMDDHHMM NOT ZERO AND +                                          
        TMP2-YYMMDDHHMM < 9999999999                                            
       IF TMP2-YYMMDDHHMM < 5000000000                                          
         TMP2-YYMMDDHHMM = TMP2-YYMMDDHHMM + 5000000000                         
       ELSE                                                                     
         TMP2-YYMMDDHHMM = TMP2-YYMMDDHHMM - 5000000000                         
       END-IF                                                                   
     END-IF                                                                     
                                                                                
END-PROC                                                                        
