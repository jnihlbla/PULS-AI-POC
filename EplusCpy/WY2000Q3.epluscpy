MACRO                                                                           
WY2000Q3. PROC                                                                  
                                                                                
*---  ADJUST FOUR DATE FIELDS IN YY-WW FORMAT (4/5 DIGITS),                     
*---  SO DATES BETWEEN 1950-2049 COME IN ASCENDING SEQUENCE.                    
*---  VALUE ZERO IS CONSIDERED A NON-DATE AND NOT ADJUSTED.                     
                                                                                
     IF TMP1-YYWW NOT ZERO AND +                                                
        TMP1-YYWW < 9999                                                        
       IF TMP1-YYWW < 5000                                                      
         TMP1-YYWW = TMP1-YYWW + 5000                                           
       ELSE                                                                     
         TMP1-YYWW = TMP1-YYWW - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP2-YYWW NOT ZERO AND +                                                
        TMP2-YYWW < 9999                                                        
       IF TMP2-YYWW < 5000                                                      
         TMP2-YYWW = TMP2-YYWW + 5000                                           
       ELSE                                                                     
         TMP2-YYWW = TMP2-YYWW - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP3-YYWW NOT ZERO AND +                                                
        TMP3-YYWW < 9999                                                        
       IF TMP3-YYWW < 5000                                                      
         TMP3-YYWW = TMP3-YYWW + 5000                                           
       ELSE                                                                     
         TMP3-YYWW = TMP3-YYWW - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP4-YYWW NOT ZERO AND +                                                
        TMP4-YYWW < 9999                                                        
       IF TMP4-YYWW < 5000                                                      
         TMP4-YYWW = TMP4-YYWW + 5000                                           
       ELSE                                                                     
         TMP4-YYWW = TMP4-YYWW - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP5-YYWW NOT ZERO AND +                                                
        TMP5-YYWW < 9999                                                        
       IF TMP5-YYWW < 5000                                                      
         TMP5-YYWW = TMP5-YYWW + 5000                                           
       ELSE                                                                     
         TMP5-YYWW = TMP5-YYWW - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP6-YYWW NOT ZERO AND +                                                
        TMP6-YYWW < 9999                                                        
       IF TMP6-YYWW < 5000                                                      
         TMP6-YYWW = TMP6-YYWW + 5000                                           
       ELSE                                                                     
         TMP6-YYWW = TMP6-YYWW - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP7-YYWW NOT ZERO AND +                                                
        TMP7-YYWW < 9999                                                        
       IF TMP7-YYWW < 5000                                                      
         TMP7-YYWW = TMP7-YYWW + 5000                                           
       ELSE                                                                     
         TMP7-YYWW = TMP7-YYWW - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
END-PROC                                                                        
