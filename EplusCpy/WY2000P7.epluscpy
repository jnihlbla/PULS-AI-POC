MACRO                                                                           
WY2000P7. PROC                                                                  
                                                                                
*---  ADJUST TWO DATE FIELDS IN YY-RP FORMAT                                    
*---  (1/12TH YEAR ACCOUNTING PERIOD - 4/5 DIGITS)                              
*---  SO DATES BETWEEN 1950-2049 COME IN ASCENDING SEQUENCE.                    
*---  VALUE ZERO IS CONSIDERED A NON-DATE AND NOT ADJUSTED.                     
                                                                                
     IF TMP1-YYRP NOT ZERO AND +                                                
        TMP1-YYRP < 9999                                                        
       IF TMP1-YYRP < 5000                                                      
         TMP1-YYRP = TMP1-YYRP + 5000                                           
       ELSE                                                                     
         TMP1-YYRP = TMP1-YYRP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP2-YYRP NOT ZERO AND +                                                
        TMP2-YYRP < 9999                                                        
       IF TMP2-YYRP < 5000                                                      
         TMP2-YYRP = TMP2-YYRP + 5000                                           
       ELSE                                                                     
         TMP2-YYRP = TMP2-YYRP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
END-PROC                                                                        
