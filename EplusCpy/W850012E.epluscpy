MACRO PREF                                                                      
*     SENASTE UPPDATERING         75111      12.09.34.8                         
*****************************************************************               
*                                                               *               
*  V.S.O.P OUTPUT FILE, D85012                                  *               
*                                                               *               
*        THE FILE IS CREATED IN D85009.                         *               
*                                                               *               
*        RECORD LENGTH 245                                      *               
*                                                               *               
*        KDLEVEL, ADVSOP2, KVEQUIP AND KVFRAME ARE CALCULATED   *               
*        IN D85009, AND ALWAYS CONTAIN A NUMERICAL VALUE.      *                
*                                                               *               
*        KVPRESEN, KVVSOPM, KVVSOPA, KVVRM, KVVRA, KVREALM      *               
*        AND KVREALA ARE CALCULATED IN D85008, AND ALWAYS       *               
*        CONTAIN A NUMERICAL VALUE.                             *               
*        RECTYP, DISTNO1, DISTNO2, PARTNO, VOLUME AND KDERROR   *               
*        ALWAYS CONTAIN A NUMERICAL VALUE.                    *                 
*        THE OTHER NUMERICAL FIELDS NOT MENTIONED ABOVE, CAN    *               
*        HAVE THE VALUE 'SPACES' WHICH MEANS DATA MISSING.      *               
*****************************************************************               
*                                                                               
   &PREF.W850012                                     1   245 A                  
     &PREF.RECTYP                                    1     2 P  0               
*                           ** RECORD TYPE = 012                                
     &PREF.DISTNO1                                   3     3 P  0               
*                           ** MAIN DISTRICT NO INCL CHECK DIGIT                
     &PREF.DISTNO2                                   6     3 P  0               
*                           ** DISTRICT NO INCL CHECK DIGIT                     
     &PREF.PARTNO                                    9    13 N  0               
*                           ** PARTNO INCL. CHECK DIGIT                         
     &PREF.BENAME                                   22    25 A                  
*                           ** DESCRIPTION                                      
     &PREF.PRICEX                                   47     6 A                  
       &PREF.PRICE                                  47     6 N  2               
*                           ** PRICE PER ITEM                                   
     &PREF.KDVSOPX                                  53     3 A                  
       &PREF.KDVSOP                                 53     3 P                  
*                           ** V.S.O.P CODE                                     
       &PREF.KDVSOP1                                53     1 P  0               
       &PREF.KDVSOP1X                               53     1 A                  
*                           ** 0-1 = BINSTORE                                   
*                           ** 2   = PALLETS                                    
*                           ** 3-9 = OTHERS                                     
       &PREF.KDVSOP2                                54     1 P  0               
       &PREF.KDVSOP2X                               54     1 A                  
*                           ** VALUE 0-3                                        
       &PREF.KDVSOP3                                55     1 P  0               
       &PREF.KDVSOP3X                               55     1 A                  
*                           ** IF KDVSOP1 = 0,1 (BINSTORE)                      
*                           **   1   = BOX NO 1                                 
*                           **   2-3 = BOX NO 2                                 
*                           **   4   = 1/5 BIN                                  
*                           **   5   = 2/5 BIN                                  
*                           **   6   = 3/5 BIN                                  
*                           **   7   = 4/5 BIN                                  
*                           **   8   =   1 BIN                                  
*                           **   9   =   2 BINS                                 
*                           ** IF KDVSOP1 = 2 (PALLETS)                         
*                           **   2   =   2 FRAMES                               
*                           **   3   =   3 FRAMES                               
*                           **   4   =   4 FRAMES                               
*                           **   5   =   5 FRAMES                               
*                           **   6   =   6 FRAMES                               
*                           **   7   =   7 FRAMES                               
*                           **   8   =   8 FRAMES                               
*                           **   9   =   9 FRAMES                               
*                                                                               
     &PREF.PRODGRPX                                 56     2 A                  
       &PREF.PRODGRP                                56     2 N  0               
*                           ** PRODUCT GROUP, VALUE 1-9                         
*                           ** EXCEPTION,IF KDERROR = 4,VALUE 0                 
     &PREF.FUNCGRPX                                 58     3 A                  
       &PREF.FUNCGRP                                58     3 P  0               
*                           ** FUNCTION GROUP                                   
     &PREF.KDMGX                                    61     1 A                  
       &PREF.KDMG                                   61     1 N  0               
*                           ** MARKETING GRADE                                  
     &PREF.VVCX                                     62     1 A                  
       &PREF.VVC                                    62     1 P  0               
*                           ** VOLUME VALUE CLASS, VALUE 1-9                    
     &PREF.VOLUMEX                                  63     5 A                  
       &PREF.VOLUME                                 63     5 P  1               
*                           ** VOLUME PER ITEM, CM3                             
     &PREF.WEIGHTX                                  68     4 A                  
       &PREF.WEIGHT                                 68     4 P  0               
*                           ** WEIGHT PER ITEM, GRAM                            
     &PREF.KDREPX                                   72     1 A                  
       &PREF.KDREP                                  72     1 P  0               
*                           ** REPLACEMENT, NO = 1, YES = 2                     
     &PREF.KVPICKX                                  73     3 A                  
       &PREF.KVPICK                                 73     3 P  0               
*                           ** PICKING FREQUENCY PER YEAR                       
     &PREF.ADLOCAL                                  76    10 A                  
*                           ** LOCAL LOCATION                                   
     &PREF.ADVSOPX                                  86     2 A                  
       &PREF.ADVSOP                                 86     2 P  0               
*                           ** V.S.O.P LOCATION :                               
*                           **    10 = BIN STORE                                
*                           **    20 = PALLET RACKS                             
*                           **    30 = FLOOR STACKING                           
*                           **    40 = SPECIAL RACKS                            
*                           ** EXCEPTION,IF KDERROR = 4,VALUE 0                 
     &PREF.KDALDER                                  88     1 P 0                
*                           ** AGE CODE                                         
     &PREF.KVQPACK                                  89     3 P 0                
*                                                                               
*                           ** QUANTITY PACKAGE, VOLVO PARTS                    
     &PREF.KVPACKST                                 92     3 P 0                
*                                                                               
*                           ** QUANTITY PACKAGE, IMPORTER                       
     &PREF.KVHANDX                                  95     4 A                  
       &PREF.KVHAND                                 95     4 P  1               
*                           ** STOCK ON HAND, PIECES                            
     &PREF.KVORDEWX                                 99     4 A                  
       &PREF.KVORDER                                99     4 P  1               
*                           ** STOCK ON ORDER, PIECES                           
     &PREF.KVFCASTX                                 103    5 A                  
       &PREF.KVFCAST                                103    5 P  3               
*                           ** FORECAST, PIECES                                 
     &PREF.KVVRA                                   108     5 P  0               
*                           ** AVERAGE VR STOCK LEVEL, PIECES                   
     &PREF.KVVRM                                   113     5 P  0               
*                           ** MAXIMUM VR STOCK LEVEL, PIECES                   
*                           ** ALWAYS > 0                                       
*                           ** ALWAYS > 0                                       
       &PREF.TILEAD                                 118    3 P                  
*                           ** LEAD TIME                                        
       &PREF.KVTEOR                                 121    4 P                  
*                           ** THEORETICAL PURCHASE QUANTITY                    
       &PREF.INF1                                   125   13 A                  
       &PREF.INF2                                   138   20 A                  
*                           ** OPTIONAL INFO, IMPORTERS                         
       &PREF.VINF1                                  158   11 A                  
*                           ** OPTIONAL INFO, VOLVO PARTS                       
       &PREF.FSGIAR                                 169    4 P 0                
*                           ** SALES, YEAR TO DATE                              
       &PREF.FSGFAR                                 173    4 P 0                
*                           ** SALES LAST YEAR                                  
       &PREF.VINF2                                  177    3 A                  
*                           ** OPTIONAL INFO, VOLVO PARTS                       
       &PREF.VSOPC                                  180    2 P 2                
       &PREF.VRC                                    182    2 P 2                
       &PREF.REALC                                  184    2 P 2                
       &PREF.PRESC                                  186    2 P 2                
*                           ** STOCK CONSTANTS FOR ADJUSTMENT OF                
*                           ** VSOP, VR, REAL , PRESENT STOCK LEVEL             
     &PREF.KDERROR                                  188    1 P  0               
*                           ** ERROR CODE:                                      
*                           **   0 = NO ERRORS                                  
*                           **   1 = ERROR LIST 1                               
*                           **   2 = ERROR LIST 2                               
*                           **   3 = ERROR LIST 3                               
*                           **   4 = ERROR LIST 4                               
*                                                                               
*    RESULT OF 'MAX STOCK CALCULATION' PROGRAM, D85008.                         
*                                                                               
     &PREF.KVPRESEN                                 189    5 P  0               
*                           ** PRESENT STOCK LEVEL, PIECES                      
     &PREF.KVVSOPM                                  194    5 P  0               
*                           ** MAXIMUM VSOP STOCK LEVEL, PIECES                 
*                           ** ALWAYS > 0                                       
     &PREF.KVVSOPA                                  199    5 P  0               
*                           ** AVERAGE VSOP STOCK LEVEL, PIECES                 
*                           ** ALWAYS > 0                                       
     &PREF.KVREALM                                 204     5 P  0               
*                           ** MAXIMUM REAL STOCK LEVEL, PIECES                 
*                           ** ALWAYS > 0                                       
     &PREF.KVREALA                                 209     5 P  0               
*                           ** AVERAGE REAL STOCK LEVEL, PIECES                 
*                           ** ALWAYS > 0                                       
*                                                                               
*    RESULT OF 'STORING DECISION' PROGRAM, D85009.                              
*                                                                               
*                           ** XLEVEL=1,DUE TO PRESENT STOCK LEVEL              
*                           ** XLEVEL=2,DUE TO VSOP    STOCK LEVEL              
*                           ** XLEVEL=3,DUE TO VR      STOCK LEVEL              
*                           ** XLEVEL=4,DUE TO REAL    STOCK LEVEL              
       &PREF.KDLEVEL1                              214     1 P  0               
*                           ** IF XLEVEL = 1, ALLWAYS = 0                       
*                           ** IF XLEVEL = 2,3 OR 4:                            
*                           ** 1 = MAXIMUM STOCK LEVEL                          
*                           ** 2 = AVERAGE STOCK LEVEL                          
       &PREF.ADVSOP21                              215     2 P  0               
*                           ** V.S.O.P LOCATION :                               
*                           **    00 = NO STORING DECISION DONE,                
*                           **         BECAUSE                                  
*                           **         PRESENT STOCK LEVEL = 0                  
*                           **    01 = BOX NO 1                                 
*                           **    02 = BOX NO 2                                 
*                           **    10 = BIN AREA                                 
*                           **    20 = PALLET RACKS                             
*                           **    30 = FLOOR STACKING                           
*                           **    40 = SPECIAL AREA                             
       &PREF.KVEQUIP1                              217     3 P  0               
*                           ** NO OF EQUIPMENT:                                 
*                           ** ADVSOP2=00, = 0                                  
*                           ** ADVSOP2=01 OR 02, NO OF BOXES                    
*                           ** ADVSOP2=10, NO OF 1/5 SHELVES                    
*                           ** ADVSOP2=20 OR 30, NO OF FRAMES                   
*                           ** ADVSOP2=40, = 0                                  
       &PREF.KVFRAME1                              220     2 P  0               
*                           ** NO OF FRAMES DUE TO WEIGHT.                      
*                           ** ONLY IF ADVSOP2=20,30 OTHERWISE =0               
       &PREF.KDLEVEL2                              222     1 P  0               
       &PREF.ADVSOP22                              223     2 P  0               
       &PREF.KVEQUIP2                              225     3 P  0               
       &PREF.KVFRAME2                              228     2 P  0               
       &PREF.KDLEVEL3                              230     1 P  0               
       &PREF.ADVSOP23                              231     2 P  0               
       &PREF.KVEQUIP3                              233     3 P  0               
       &PREF.KVFRAME3                              236     2 P  0               
       &PREF.KDLEVEL4                              238     1 P  0               
       &PREF.ADVSOP24                              239     2 P  0               
       &PREF.KVEQUIP4                              241     3 P  0               
       &PREF.KVFRAME4                              244     2 P  0               
*** END COPY W850012E                LENGTH =      245                          
