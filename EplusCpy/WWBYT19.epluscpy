MACRO PREF                                                                      
WWBYT19. PROC                                                                   
*                            *************************************              
*                            *************************************              
*                            *** ANVÄNDS FÖR ATT SKILJA          *              
*                            *** BYTESRADIO FRÅN ÖVRIGA          *              
*                            *** BYTESENHETER:                   *              
*                            ***    ARTIKELNR FÖR RENOVERADE     *              
*                            ***    ENHETER.                     *              
*                            *************************************              
** FÄLTDEFINITION                                                               
   DEFINE BYT19-BYTES                W  1    A  VALUE  'N'                      
   DEFINE BYT19-RADIO                W  1    A  VALUE  'N'                      
                                                                                
*  VÄRDETILLDELNING                                                             
                                                                                
   BYT19-BYTES                  = 'N'                                           
   BYT19-RADIO                  = 'N'                                           
                                                                                
   IF &PREF.IDARTNR =  5001000 THRU 5003999                         +           
                       8111000 THRU 8113999                         +           
                       8251000 THRU 8253999                         +           
                       8601000 THRU 8603999                         +           
                       9031000 THRU 9031999                         +           
                     31240000 THRU 31243999                         +           
                     36000000 THRU 36003999                         +           
                     36010000 THRU 36013999                         +           
                     36020000 THRU 36023999                         +           
                     36050000 THRU 36053999                         +           
                     36081000 THRU 36083999.                                    
                                                                                
      BYT19-BYTES               = 'J'                                           
   ELSE                                                                         
     IF &PREF.IDARTNR = 8103000 THRU 8103999                        +           
                        9953000 THRU 9953999                        +           
                        36100000 THRU 36100999.                                 
        BYT19-RADIO             = 'J'                                           
     END-IF                                                                     
   END-IF                                                                       
                                                                                
END-PROC                                                                        
