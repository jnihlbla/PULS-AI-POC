MACRO PREF                                                                      
  &PREF.FIL-W6G301                                        1   227 A             
*                                 TRANSAR TILL BATCH FR≈N                       
*                                 INLEVERANS ONLINESYSTEM                       
*                                 FYSISK NYCKEL: W6G301KY                       
*                                 (IDPGM + TIREGDAT + TIKLOCK +                 
*                                  IDSEKVNR + IDCPYTXT)                         
*                                 S÷KBEGREPP: IDPGM, TIREGDAT,                  
*                                 TIKLOCK, IDSEKVNR, IDCPYTXT                   
    &PREF.FIL-IDPGM &PREF.FIL-W6G301                            8 A             
*                                 PROGRAM IDENTITET                             
*                                 PROGRAM INTENTITY                             
    &PREF.FIL-TIREGDAT &PREF.FIL-W6G301                  +8     4 P  0          
*                                 REGISTRERINGSDATUM (≈≈MMDD)                   
*                                 REGISTRATION DATE (YYMMDD)                    
    &PREF.FIL-TIKLOCK &PREF.FIL-W6G301                  +12     5 P  0          
*                                 KLOCKSLAG (TTMMSSTH)                          
*                                 TIME OF DAY (HHMMSSTH)                        
    &PREF.FIL-IDSEKVNR &PREF.FIL-W6G301                 +17     2 P  0          
*                                 GENERELLT SEKVENSNUMMER                       
*                                 GENERAL SEQUENCE NUMBER                       
    &PREF.FIL-IDCPYTXT &PREF.FIL-W6G301                 +19     8 A             
*                                 COPYTEXT IDENTITET                            
*                                 IDENTITY OF A COPYTEXT                        
      &PREF.FIL-CT-IDSYSTEM &PREF.FIL-W6G301            +19     4 A             
*                                 SKAPANDE SYSTEMNUMMER                         
*                                 GENERATING SYSTEM NUMBER                      
      &PREF.FIL-CT-IDPTYP &PREF.FIL-W6G301              +23     3 A             
*                                 POSTTYP                                       
*                                 RECORD TYPE                                   
      &PREF.FIL-CT-IDVTYP &PREF.FIL-W6G301              +26     1 A             
*                                 POSTTYPSVERSION                               
*                                 RECORD TYPE VERSION                           
    &PREF.FIL-W6G301-DATA &PREF.FIL-W6G301              +27   200 A             
*** END COPY  W6G301                 LENGTH =           227                     
