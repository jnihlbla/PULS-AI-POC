MACRO                                                                           
WY2000Q6. PROC                                                                  
                                                                                
*---  ADJUST TWO DATE FIELDS IN YY-PP FORMAT                                    
*---  (1/12TH YEAR PROGRAM PERIOD - 4/5 DIGITS)                                 
*---  SO DATES BETWEEN 1950-2049 COME IN ASCENDING SEQUENCE.                    
*---  VALUE ZERO IS CONSIDERED A NON-DATE AND NOT ADJUSTED.                     
                                                                                
     IF TMP1-YYPP NOT ZERO AND +                                                
        TMP1-YYPP < 9999                                                        
       IF TMP1-YYPP < 5000                                                      
         TMP1-YYPP = TMP1-YYPP + 5000                                           
       ELSE                                                                     
         TMP1-YYPP = TMP1-YYPP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP2-YYPP NOT ZERO AND +                                                
        TMP2-YYPP < 9999                                                        
       IF TMP2-YYPP < 5000                                                      
         TMP2-YYPP = TMP2-YYPP + 5000                                           
       ELSE                                                                     
         TMP2-YYPP = TMP2-YYPP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP3-YYPP NOT ZERO AND +                                                
        TMP3-YYPP < 9999                                                        
       IF TMP3-YYPP < 5000                                                      
         TMP3-YYPP = TMP3-YYPP + 5000                                           
       ELSE                                                                     
         TMP3-YYPP = TMP3-YYPP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP4-YYPP NOT ZERO AND +                                                
        TMP4-YYPP < 9999                                                        
       IF TMP4-YYPP < 5000                                                      
         TMP4-YYPP = TMP4-YYPP + 5000                                           
       ELSE                                                                     
         TMP4-YYPP = TMP4-YYPP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP5-YYPP NOT ZERO AND +                                                
        TMP5-YYPP < 9999                                                        
       IF TMP5-YYPP < 5000                                                      
         TMP5-YYPP = TMP5-YYPP + 5000                                           
       ELSE                                                                     
         TMP5-YYPP = TMP5-YYPP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP6-YYPP NOT ZERO AND +                                                
        TMP6-YYPP < 9999                                                        
       IF TMP6-YYPP < 5000                                                      
         TMP6-YYPP = TMP6-YYPP + 5000                                           
       ELSE                                                                     
         TMP6-YYPP = TMP6-YYPP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP7-YYPP NOT ZERO AND +                                                
        TMP7-YYPP < 9999                                                        
       IF TMP7-YYPP < 5000                                                      
         TMP7-YYPP = TMP7-YYPP + 5000                                           
       ELSE                                                                     
         TMP7-YYPP = TMP7-YYPP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
END-PROC                                                                        
