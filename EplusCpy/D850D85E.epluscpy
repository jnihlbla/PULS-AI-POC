MACRO PREF                                                                      
*****************************************************************               
*                                                               *               
*  IMPORTER FILE, IS CREATED BY THE IMPORTER.                   *               
*                                                               *               
*  THE LAYOUT OF THE IMPORTER FILE IS DECIDED BY VOLVO WDB2.    *               
*                                                               *               
*  RECORD LENGTH 140                                            *               
*  BLOCK CONTAINS 40 (OR LESS) RECORDS                          *               
*  DENSITY = 800 OR 1600 BPI   9 TRACKS                         *               
*                                                               *               
*  RESTRICTIONS:                                                *               
*                                                               *               
*    RECORD TYPE, MUST BE D85.                                  *               
*    PART NO, MUST BE NUMERICAL.                                *               
*    DESCRIPTION, CAN HAVE ANY VALUE.                           *               
*    LOCAL LOCATION, CAN HAVE ANY VALUE.                        *               
*    THE OTHER FIELDS MUST BE EMPTY (= SPACES) OR NUMERICAL,    *               
*    IF NUMERICAL THE VALUE MUST LAY WITHIN THE LIMITS DECIDED  *               
*    BY VOLVO WDB2.                                             *               
*    IF NUMERICAL THE VALUE MUST BE POSITIVE.                   *               
*                                                               *               
*    THE RECORDS SHALL BE SORTED IN ASCENDING PART NO SEQUENCE  *               
*                                                               *               
*    TWO RECORDS CANNOT HAVE THE SAME PART NO                   *               
*                                                               *               
*****************************************************************               
*                                                                               
   &PREF.RECORD                                      1   140 A                  
     &PREF.RECTYP                                    1     3 A                  
*                           ** RECORD TYPE = D85                                
     &PREF.PARTNO1                                   4     9 N  0               
*                           ** PARTNO INCL. CHECK DIGIT                         
     &PREF.FILLER01                                  4     9 A                  
       &PREF.PARTNO2                                 4     8 N 0                
*                           ** PARTNO WITHOUT CHECK DIGIT                       
       &PREF.FILLER02                               12     1 A                  
     &PREF.BENAME                                   13    20 A                  
*                           ** DESCRICPTION                                     
     &PREF.PRICEX                                   33     7 A                  
       &PREF.PRICE                                  33     7 N  2               
*                           ** PRICE PER ITEM                                   
     &PREF.KDVSOP                                   40     3 A                  
*                           ** V.S.O.P CODE                                     
       &PREF.KDVSOP1                                40     1 N  0               
*                           ** VALUE 0-9                                        
       &PREF.KDVSOP2                                41     1 N  0               
*                           ** VALUE 0-3                                        
       &PREF.KDVSOP3                                42     1 N  0               
*                           ** IF KDVSOP1 = 0,1  VALUE 1-9                      
*                           ** IF KDVSOP1 = 2    VALUE 2-9                      
*                           ** IF KDVSOP1 > 2    VALUE 0-9                      
     &PREF.PRODGRPX                                 43     1 A                  
       &PREF.PRODGRP                                43     1 N  0               
*                           ** PRODUCT GROUP, VALUE 1-9                         
     &PREF.FUNCGRPX                                 44     5 A                  
       &PREF.FUNCGRP                                44     5 N  0               
*                           ** FUNCTION GROUP                                   
     &PREF.VVCX                                     49     1 A                  
       &PREF.VVC                                    49     1 N  0               
*                           ** VOLUME VALUE CLASS, VALUE 1-9                    
     &PREF.VOLUMEX                                  50     9 A                  
       &PREF.VOLUME                                 50     9 N  1               
*                           ** VOLUME PER ITEM, CM3                             
     &PREF.WEIGHTX                                  59     7 A                  
       &PREF.WEIGHT                                 59     7 N  0               
*                           ** WEIGHT PER ITEM, GRAM                            
     &PREF.KDREPX                                   66     1 A                  
       &PREF.KDREP                                  66     1 N  0               
*                           ** REPLACEMENT, NO = 1, YES = 2                     
     &PREF.KVPICKX                                  67     5 A                  
       &PREF.KVPICK                                 67     5 N  0               
*                           ** PICKING FREQUENCY PER YEAR                       
     &PREF.ADLOCAL                                  72    10 A                  
*                           ** LOCAL LOCATION                                   
     &PREF.ADVSOPX                                  82     2 A                  
       &PREF.ADVSOP                                 82     2 N  0               
*                           ** V.S.O.P LOCATION, VALUE 10,20,30,40              
     &PREF.KVHANDX                                  84     7 A                  
       &PREF.KVHAND                                 84     7 N  1               
*                           ** STOCK ON HAND, PIECES                            
     &PREF.KVORDEWX                                 91     7 A                  
       &PREF.KVORDER                                91     7 N  1               
*                           ** STOCK ON ORDER, PIECES                           
     &PREF.KVFCASTX                                 98     9 A                  
       &PREF.KVFCAST                                98     9 N  3               
*                           ** FORECAST, PIECES                                 
     &PREF.REBUFFX                                 107     3 A                  
       &PREF.REBUFF                                107     3 N  1               
*                           ** BUFFER FACTOR                                    
     &PREF.KVMADX                                  110     9 A                  
       &PREF.KVMAD                                 110     9 N  3               
*                           ** MEAN ABS. FORECAST ERROR, PIECES                 
     &PREF.KDBLOCKX                                119     1 A                  
       &PREF.KDBLOCK                               119     1 N  0               
*                           ** BLOCKING CODE                                    
     &PREF.KDMGX                                   120     1 A                  
       &PREF.KDMG                                  120     1 N  0               
*                           ** MARKETING GRADE                                  
     &PREF.FILLER03                                121    20 A                  
*** END COPY D850D85E                LENGTH =      140                          
