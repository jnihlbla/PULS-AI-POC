MACRO P                                                                         
 &P.W4832301                                            1   251 A               
*                                 FOR REPORTING PURPOSE                         
     &P.IDPRODNR                                        1     4 P 0             
*                                 PRODUCTION NUMBER                             
     &P.IDKOLLI                                         5     3 P 0             
*                                 CASE NUMBER                                   
     &P.IDDC                                            8     2 A               
*                                 WAREHOUSE IDENTIFIER                          
     &P.IDDISTR                                        10     3 P 0             
*                                 DISTRICT NUMBER                               
     &P.IDKUNDNR                                       13     4 P 0             
*                                 CUSTOMER NO                                   
     &P.KDFAKTYP                                       17     1 A               
*                                 INVOICE TYPE                                  
     &P.IDFAKT                                         18     4 P 0             
*                                 INVOICE NO.                                   
     &P.TIFAKT                                         22     4 P 0             
*                                 INVOICING DATE   (YYMMDD)                     
     &P.TIFAKTID                                       26     4 P 0             
     &P.KDORDKL                                        30     1 P 0             
*                                 ORDER CLASS                                   
     &P.KDFRAKT                                        31     2 P 0             
*                                 FREIGHT CODE                                  
     &P.FLDIRLEV                                       33     1 A               
*                                 DIRECT DELIVERY ?                             
     &P.IDLEVNR                                        34     5 A               
*                                 SUPPLIER NUMBER (VENDOR NUMBER)               
     &P.KDVIA                                          39     2 A               
*                                 CODE FOR DELIVERY VIA                         
     &P.DASUPREF                                       41     8 N               
*                                 SHIPPING DATE DIRECT SUPPLIER                 
     &P.TISUPTID                                       49     3 P 0             
*                                 SHIPPING TIME DIRECT SUPPLIER                 
     &P.TIUTSKR                                        52     4 P 0             
*                                 PRINTING DATE  (YYMMDD)                       
     &P.TIUTSTID                                       56     4 P 0             
*                                 TIME OF PRINTING (HHMMSS)                     
     &P.TILASTN                                        60     4 P 0             
*                                 LOADING DATE           (YYMMDD)               
     &P.TILASTID                                       64     4 P 0             
     &P.IDTRPTNR                                       68     2 P 0             
*                                 TRANSPORT IDENTITY                            
     &P.IDLBBET                                        70    12 A               
*                                 TRAILER NUMBER                                
     &P.IDSHIPM                                        82     7 N               
*                                 SHIPMENT NO                                   
     &P.IDLASTN                                        89     4 P 0             
*                                 LOADING NO.                                   
     &P.DIKOLLIL                                       93     3 P 0             
*                                 CASE LENGTH                                   
     &P.DIKOLLIB                                       96     2 P 0             
*                                 CASE WIDTH                                    
     &P.DIKOLLIH                                       98     2 P 0             
*                                 CASE HEIGHT                                   
     &P.KDKOLLI                                       100     8 A               
*                                 KOLLI CODE                                    
     &P.KDFARLIG-KOLLI                                108     1 P 0             
*                                 CODE FOR DANG GOODS IN A CASE                 
     &P.KVFLAMP-KOLLI                                 109     2 P 1             
*                                 FLASH POINT FOR A CASE                        
     &P.FG-PSN                                        111    11 A      +        
                   OCCURS 10                                           +        
                   INDEX      &P.FG-PSNIX                                       
*                                 OCCURS 10 TIMES                               
      &P.IDPSN &P.FG-PSN                                      3 N               
*                                 PROPER SHIPPING NAME                          
      &P.VKART-FG &P.FG-PSN                            +3     4 P 0             
*                                 NET WEIGHT EXPLOSIVES                         
      &P.VLFG &P.FG-PSN                                +7     4 P 3             
*                                 VOLUME DANGEROUS GOODS                        
     &P.SUEQFG                                        221     4 P 4             
*                                 EQ VALUE DANGEROUS GODS                       
     &P.KVFALRAD                                      225     3 P 0             
*                                 NUMBER OF LINES DANGEROUS GOODS               
     &P.KVORDRAD                                      228     3 P 0             
*                                 NUMBER OF ORDER LINES                         
     &P.SUORDV-KOLLI                                  231     6 P 2             
*                                 ORDER VALUE PER CASE                          
     &P.VKORDNTO-KOLLI                                237     4 P 1             
*                                 ORDER WEIGHT NET PER CASE                     
     &P.VKORDBTO-KOLLI                                241     4 P 1             
*                                 ORDER WEIGHT GROSS PER CASE                   
     &P.VLORDBTO-KOLLI                                245     4 P 3             
*                                 ORDER VOL GR/CASE                             
     &P.FLLDCKND                                      249     1 A               
*                                 FL LDC CUSTOMER                               
     &P.IDLANDX2                                      250     2 A               
*** END COPY                             LENGTH =           251                 
