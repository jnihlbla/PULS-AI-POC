MACRO PREF                                                                      
   &PREF.DATUMKORT                                   W    80 A                  
*                          DATUMKORT FÖR RS NATTBATCH                           
*                          ID = WDATUM                                          
     &PREF.DATUM &PREF.DATUMKORT                           5 A                  
*                          VÄRDE:  'DATE9'          KOL: 01-05                  
     &PREF.FAELT2 &PREF.DATUMKORT                   +5     6 A                  
*                          IDDEL = 'WDATUM'         KOL: 06-11                  
     &PREF.D-AAR &PREF.DATUMKORT                   +11     2 N                  
*                          ÅR  (DAGENS DATUM)       KOL: 12-13                  
     &PREF.D-MAANAD &PREF.DATUMKORT                +13     2 N                  
*                          MÅNAD  (DAGENS DATUM)    KOL: 14-15                  
     &PREF.D-DAG &PREF.DATUMKORT                   +15     2 N                  
*                          DAG  (DAGENS DATUM)      KOL: 16-17                  
     &PREF.D-VECKA &PREF.DATUMKORT                 +17     2 N                  
*                          VECKONR (DAGENS DATUM)   KOL: 18-19                  
     &PREF.D-DAGNR &PREF.DATUMKORT                 +19     1 N                  
*                          DAG I VECKAN (DAGENS DATUM) KOL: 20                  
     &PREF.D-PERIOD &PREF.DATUMKORT                +20     1 N                  
*                          PERIODNR (DAGENS DATUM)     KOL: 21                  
     &PREF.FILLER01 &PREF.DATUMKORT                +21     2 N                  
*                          64-DEL                   KOL: 22-23                  
     &PREF.K-AAR &PREF.DATUMKORT                   +23     1 N                  
*                          KÖRNINGS-ÅR                 KOL: 24                  
     &PREF.K-VECKA &PREF.DATUMKORT                 +24     2 N                  
*                          KÖRNINGS-VECKONR         KOL: 25-26                  
     &PREF.K-PERIOD &PREF.DATUMKORT                +26     1 N                  
*                          KÖRNINGS-PERIODNR           KOL: 27                  
     &PREF.K-STATVECKA &PREF.DATUMKORT             +27     1 N                  
*                          KÖRNINGS-STATISTIKVECKA     KOL: 28                  
     &PREF.K-NYPER &PREF.DATUMKORT                 +28     1 N                  
*                          PERIODSTART? (1 = JA)       KOL: 29                  
     &PREF.K-PERSLUT &PREF.DATUMKORT               +29     1 N                  
*                          PERIODSLUT? (1 = JA)        KOL: 30                  
     &PREF.K-VECKASLUT &PREF.DATUMKORT             +30     1 N                  
*                          VECKOSLUT?  (1 = JA)        KOL: 31                  
     &PREF.FILLER02 &PREF.DATUMKORT                +31    30 A                  
*                                                                               
     &PREF.K-VECKOSTART &PREF.DATUMKORT            +61     1 A                  
*                          VECKOSTART?    1 = JA       KOL: 62                  
*                                       ÖVR = NEJ                               
     &PREF.K-MANADSLUT &PREF.DATUMKORT             +62     1 A                  
*                          MÅNADSLUT?     1 = JA       KOL: 63                  
*                                       ÖVR = NEJ                               
     &PREF.K-PERSLUT-BOKF &PREF.DATUMKORT          +63     1 A                  
*                          BOKFÖRINGS-    1 = JA                                
*                          PERIODSLUT?  ÖVR = NEJ      KOL: 64                  
     &PREF.FILLER03 &PREF.DATUMKORT                +64    11 A                  
*                                                                               
     &PREF.D-IOCSDAT &PREF.DATUMKORT               +75     5 N                  
*                          DAGENS DAGNR                KOL: 76-80               
*** END COPY WDATKORT                LENGTH =       80                          
