MACRO PREF                                                                      
WWBYT03. PROC                                                                   
*                            *************************************              
*                            *** ANVÄNDS VID FÖLJANDE TESTER FÖR *              
*                            *** BYTESENHETER:                   *              
*                            ***  - OBJEKT        =              *              
*                            ***    ARTIKELNR FÖR OBJEKTEN.      *              
*                            ***    (SOM SKALL RENOVERAS)        *              
*                            *************************************              
** FÄLTDEFINITION                                                               
   DEFINE BYT03-OBJEKT               W  1    A  VALUE  'N'                      
                                                                                
*  VÄRDETILLDELNING                                                             
                                                                                
   BYT03-OBJEKT                 = 'N'                                           
                                                                                
   IF &PREF.IDARTNR = 5007000 THRU 5009999                          +           
                      8104000 THRU 8104999                          +           
                      8117000 THRU 8119999                          +           
                      8257000 THRU 8259999                          +           
                      8607000 THRU 8609999                          +           
                      9037000 THRU 9037999                          +           
                      9954000 THRU 9954999                          +           
                     31246000 THRU 31249999                         +           
                     36006000 THRU 36009999                         +           
                     36016000 THRU 36019999                         +           
                     36026000 THRU 36029999                         +           
                     36087000 THRU 36089999                         +           
                     36101000 THRU 36101999.                                    
     BYT03-OBJEKT               = 'J'                                           
   END-IF                                                                       
                                                                                
END-PROC                                                                        
