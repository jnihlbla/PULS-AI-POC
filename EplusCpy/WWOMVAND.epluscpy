MACRO P                                                                         
*                            *************************************              
*                            *** FACTORS FOR CONVERSION OF                      
*                            *** - WEIGHT                                       
*                            *** - VOLUME                                       
*                            *** - LENGTH                                       
*                            ***                                                
*                            *** EXAMPLES:                                      
*                            *** YOU HAVE KILOGRAMS AND WANT                    
*                            *** POUNDS:                                        
*                            *** POUNDS =    KILOGRAMS * CONV-KG-TO-LB          
*                            ***                                                
*                            *** YOU HAVE POUNDS AND WANT                       
*                            *** KILOGRAMS:                                     
*                            *** KILOGRAMS = POUNDS * CONV-LB-TO-KG             
*                            *************************************              
*           ****   VOLUME    ****                                               
*                                                                               
     &P.CONV-M3-TO-FT3    W 3   P  3  VALUE 35.315                              
*                  CUBIC METERS TO CUBIC FEET                                   
*                                                                               
     &P.CONV-M3-TO-YD3    W 3   P  4  VALUE 1.3080                              
*                  CUBIC METERS TO CUBIC YARDS                                  
*                                                                               
     &P.CONV-LIT-TO-GAL   W 3  P  5  VALUE 0.26417                              
*                  LITERS TO GALLONS                                            
*                                                                               
     &P.CONV-FT3-TO-M3    W 4   P  7  VALUE 0.0283168                           
*                  CUBIC FEET TO CUBIC METERS                                   
*                                                                               
     &P.CONV-YD3-TO-M3    W 3   P  5  VALUE 0.76455                             
*                  CUBIC YARDS TO CUBIC METERS                                  
*                                                                               
     &P.CONV-GAL-TO-LIT   W 3  P  4  VALUE 3.7854                               
*                  GALLONS TO LITERS                                            
*                                                                               
*           ****   WEIGHT    ****                                               
*                                                                               
     &P.CONV-KG-TO-LB     W 3   P  4  VALUE 2.2046                              
*                  KILOGRAMS TO POUNDS                                          
*                                                                               
     &P.CONV-KG-TO-OZ     W 3   P  3  VALUE 35.274                              
*                  KILOGRAMS TO OUNCES                                          
*                                                                               
     &P.CONV-GR-TO-LB     W 4   P  7  VALUE 0.0022046                           
*                  GRAMS TO POUNDS                                              
*                                                                               
     &P.CONV-GR-TO-OZ     W 4   P  7  VALUE 0.0352740                           
*                  GRAMS TO OUNCES                                              
*                                                                               
     &P.CONV-LB-TO-KG     W 3   P  5  VALUE 0.45359                             
*                  POUNDS TO KILOGRAMS                                          
*                                                                               
     &P.CONV-LB-TO-GR     W 3   P  2  VALUE 453.59                              
*                  POUNDS TO GRAMS                                              
*                                                                               
     &P.CONV-OZ-TO-KG     W 4   P  7  VALUE 0.0283495                           
*                  OUNCES TO KILOGRAMS                                          
*                                                                               
     &P.CONV-OZ-TO-GR     W 3   P  3  VALUE 28.350                              
*                  OUNCES TO GRAMS                                              
*                                                                               
*           ****   LENGTH    ****                                               
*                                                                               
     &P.CONV-CM-TO-IN     W 3   P  5  VALUE 0.39370                             
*                  CENTIMETERS TO INCHES                                        
*                                                                               
     &P.CONV-M-TO-IN      W 3   P  3  VALUE 39.370                              
*                  METERS TO INCHES                                             
*                                                                               
     &P.CONV-M-TO-YD      W 3   P  4  VALUE 1.0936                              
*                  METERS TO YARDS                                              
*                                                                               
     &P.CONV-IN-TO-CM     W 3   P  4  VALUE 2.5400                              
*                  INCHES TO CENTIMETERS                                        
*                                                                               
     &P.CONV-IN-TO-M      W 3   P  5  VALUE 0.02540                             
*                  INCHES TO METERS                                             
*                                                                               
     &P.CONV-YD-TO-M      W 3   P  5  VALUE 0.91440                             
*                  YARDS TO METERS                                              
*                                                                               
*** END COPY WWOMVAND                                                           
