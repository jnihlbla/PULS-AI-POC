MACRO PREF                                                                      
*                            *******************************************        
*                            *** ANVÄNDS VID TEST AV:                           
*                            ***   STYRNING VAT-LISTOR SDC26 (AUSTRIA)          
*                            ***                                                
*                            ***  OBS! ANVÄNDS BARA SOM EPLUS-COPYTEXT          
*                            ***                                                
*                            *******************************************        
** FÄLTDEFINITION                                                               
   DEFINE DIST15-DC26-VAT-ALLA       W  1    A  VALUE  'N'                      
   DEFINE DIST15-DC26-REFILL         W  1    A  VALUE  'N'                      
   DEFINE DIST15-DC26-RETUR          W  1    A  VALUE  'N'                      
   DEFINE DIST15-DC26-NATIONAL       W  1    A  VALUE  'N'                      
   DEFINE DIST15-DC26-EXPORT         W  1    A  VALUE  'N'                      
                                                                                
*  VÄRDETILLDELNING                                                             
                                                                                
   DIST15-DC26-VAT-ALLA         = 'N'                                           
   DIST15-DC26-REFILL           = 'N'                                           
   DIST15-DC26-RETUR            = 'N'                                           
   DIST15-DC26-NATIONAL         = 'N'                                           
   DIST15-DC26-EXPORT           = 'N'                                           
                                                                                
                                                                                
   IF &PREF.IDDISTR = 2374 2378 8082 8083                                       
     DIST15-DC26-VAT-ALLA       = 'J'                                           
   END-IF                                                                       
                                                                                
   IF &PREF.IDDISTR = 2378                                                      
     DIST15-DC26-NATIONAL       = 'J'                                           
   END-IF                                                                       
                                                                                
   IF &PREF.IDDISTR = 2374                                                      
     DIST15-DC26-EXPORT         = 'J'                                           
   END-IF                                                                       
                                                                                
   IF &PREF.IDDISTR = 8082                                                      
     DIST15-DC26-REFILL         = 'J'                                           
   END-IF                                                                       
                                                                                
   IF &PREF.IDDISTR = 8083                                                      
     DIST15-DC26-RETUR          = 'J'                                           
   END-IF                                                                       
                                                                                
