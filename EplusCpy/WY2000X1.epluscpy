MACRO                                                                           
WY2000P1. PROC                                                                  
                                                                                
*---  ADJUST SEVEN DATE FIELDS IN YY-MM-DD FORMAT (6/7 DIGITS),                 
*---  SO DATES BETWEEN 1950-2049 COME IN ASCENDING SEQUENCE.                    
*---  VALUE ZERO IS CONSIDERED A NON-DATE AND NOT ADJUSTED.                     
*---  NOTE: USED BY VIOS EPLUS-SKELS                                            
                                                                                
     IF TMP1-YYMMDD NOT ZERO                                                    
       IF TMP1-YYMMDD < 500000                                                  
         TMP1-YYMMDD = TMP1-YYMMDD + 500000                                     
       ELSE                                                                     
         TMP1-YYMMDD = TMP1-YYMMDD - 500000                                     
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP2-YYMMDD NOT ZERO                                                    
       IF TMP2-YYMMDD < 500000                                                  
         TMP2-YYMMDD = TMP2-YYMMDD + 500000                                     
       ELSE                                                                     
         TMP2-YYMMDD = TMP2-YYMMDD - 500000                                     
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP3-YYMMDD NOT ZERO                                                    
       IF TMP3-YYMMDD < 500000                                                  
         TMP3-YYMMDD = TMP3-YYMMDD + 500000                                     
       ELSE                                                                     
         TMP3-YYMMDD = TMP3-YYMMDD - 500000                                     
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP4-YYMMDD NOT ZERO                                                    
       IF TMP4-YYMMDD < 500000                                                  
         TMP4-YYMMDD = TMP4-YYMMDD + 500000                                     
       ELSE                                                                     
         TMP4-YYMMDD = TMP4-YYMMDD - 500000                                     
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP5-YYMMDD NOT ZERO                                                    
       IF TMP5-YYMMDD < 500000                                                  
         TMP5-YYMMDD = TMP5-YYMMDD + 500000                                     
       ELSE                                                                     
         TMP5-YYMMDD = TMP5-YYMMDD - 500000                                     
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP6-YYMMDD NOT ZERO                                                    
       IF TMP6-YYMMDD < 500000                                                  
         TMP6-YYMMDD = TMP6-YYMMDD + 500000                                     
       ELSE                                                                     
         TMP6-YYMMDD = TMP6-YYMMDD - 500000                                     
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP7-YYMMDD NOT ZERO                                                    
       IF TMP7-YYMMDD < 500000                                                  
         TMP7-YYMMDD = TMP7-YYMMDD + 500000                                     
       ELSE                                                                     
         TMP7-YYMMDD = TMP7-YYMMDD - 500000                                     
       END-IF                                                                   
     END-IF                                                                     
                                                                                
END-PROC                                                                        
