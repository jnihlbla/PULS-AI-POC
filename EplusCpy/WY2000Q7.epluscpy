MACRO                                                                           
WY2000Q7. PROC                                                                  
                                                                                
*---  ADJUST TWO DATE FIELDS IN YY-RP FORMAT                                    
*---  (1/12TH YEAR ACCOUNTING PERIOD - 4/5 DIGITS)                              
*---  SO DATES BETWEEN 1950-2049 COME IN ASCENDING SEQUENCE.                    
*---  VALUE ZERO IS CONSIDERED A NON-DATE AND NOT ADJUSTED.                     
                                                                                
     IF TMP1-YYRP NOT ZERO AND +                                                
        TMP1-YYRP < 9999                                                        
       IF TMP1-YYRP < 5000                                                      
         TMP1-YYRP = TMP1-YYRP + 5000                                           
       ELSE                                                                     
         TMP1-YYRP = TMP1-YYRP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP2-YYRP NOT ZERO AND +                                                
        TMP2-YYRP < 9999                                                        
       IF TMP2-YYRP < 5000                                                      
         TMP2-YYRP = TMP2-YYRP + 5000                                           
       ELSE                                                                     
         TMP2-YYRP = TMP2-YYRP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP3-YYRP NOT ZERO AND +                                                
        TMP3-YYRP < 9999                                                        
       IF TMP3-YYRP < 5000                                                      
         TMP3-YYRP = TMP3-YYRP + 5000                                           
       ELSE                                                                     
         TMP3-YYRP = TMP3-YYRP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP4-YYRP NOT ZERO AND +                                                
        TMP4-YYRP < 9999                                                        
       IF TMP4-YYRP < 5000                                                      
         TMP4-YYRP = TMP4-YYRP + 5000                                           
       ELSE                                                                     
         TMP4-YYRP = TMP4-YYRP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP5-YYRP NOT ZERO AND +                                                
        TMP5-YYRP < 9999                                                        
       IF TMP5-YYRP < 5000                                                      
         TMP5-YYRP = TMP5-YYRP + 5000                                           
       ELSE                                                                     
         TMP5-YYRP = TMP5-YYRP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP6-YYRP NOT ZERO AND +                                                
        TMP6-YYRP < 9999                                                        
       IF TMP6-YYRP < 5000                                                      
         TMP6-YYRP = TMP6-YYRP + 5000                                           
       ELSE                                                                     
         TMP6-YYRP = TMP6-YYRP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     IF TMP7-YYRP NOT ZERO AND +                                                
        TMP7-YYRP < 9999                                                        
       IF TMP7-YYRP < 5000                                                      
         TMP7-YYRP = TMP7-YYRP + 5000                                           
       ELSE                                                                     
         TMP7-YYRP = TMP7-YYRP - 5000                                           
       END-IF                                                                   
     END-IF                                                                     
                                                                                
END-PROC                                                                        
