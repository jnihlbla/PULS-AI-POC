/CONTROL DATABASE=F1DPV1                                                00050003
/DEFINE  I      BIN                                                     00070000
/DEFINE  J      BIN                                                     00080000
/SELECT  SUBSTR(JOB,1,1) = 'W'                                          00090001
/ DO I = 1 TO NRID BY 1                                                 00110001
/      OUTPUT  JOB    COL(1)                                            00122001
/      OUTPUT  DD     COL(9)                                            00122101
/      OUTPUT  RID    COL(17)                                           00123001
/      OUTPUT  RDESC  COL(29)                                           00124001
/   NEXT RID                                                            00125001
/ END                                                                   00130001
