#                                                                               
# Environment for database rvip (dp_rvipt) in VG49 (tvip)                       
# Possible databases are: pvip, ivip, dvip or rvip                              
#                                                                               
VIP_TYPE=tvip                                                                   
SOEROOT=/soe/$VIP_TYPE                                                          
VIP_ROOT=opt/$VIP_TYPE                                                          
VIP_UNIX=/$VIP_ROOT/vip/source/rvip/vips/unixscr                                
export USER=v028439                                                             
. $SOEROOT/etc/set_vip_basic_env -db dp_rvipt                                   
. $VIP_UNIX/set_vip_env                                                         
echo "VIP environment - VG49/tvip - rvip/dp_rvipt"                              
# VIP_IMPORT_DEBUG=TRUE; export VIP_IMPORT_DEBUG                                
date                                                                            
echo "****** Below displayed, OMNIMARK environment status. ******"              
env | grep OMNI                                                                 
