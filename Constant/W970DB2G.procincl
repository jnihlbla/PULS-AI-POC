SELECT                                                                          
     CAST(GRANTEE    AS CHAR(8))  AS USER,                                      
     CAST(GRANTOR    AS CHAR(8))  AS OWNER,                                     
     CAST(STNAME     AS CHAR(30)) AS TABLE,                                     
     MAX(SELECTAUTH) AS READ,                                                   
     MAX(INSERTAUTH) AS INS,                                                    
     MAX(UPDATEAUTH) AS UPD,                                                    
     MAX(DELETEAUTH) AS DEL                                                     
   FROM SYSIBM.SYSTABAUTH                                                       
   WHERE GRANTOR LIKE 'W%'                                                      
     AND GRANTEETYPE ^= 'P'                                                     
   GROUP BY GRANTEE, GRANTOR, STNAME                                            
   ORDER BY STNAME, GRANTEE                                                     
   ;                                                                            
