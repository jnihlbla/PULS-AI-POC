 INREC IFTHEN=(WHEN=INIT,OVERLAY=(55:SEQNUM,8,ZD)),                             
       IFTHEN=(WHEN=(55,8,ZD,GT,1),OVERLAY=(55:C'99999999'))                    
 SORT FIELDS=(55,8,CH,A,5,5,ZD,A,                                               
                        11,7,ZD,A,                                              
                        19,1,CH,A,                                              
                        21,7,ZD,A,                                              
                        29,8,ZD,A,                                              
                        38,8,ZD,A)                                              
 OUTREC BUILD=(1,54)                                                            
