#                                                                               
# Environment for database dp_vip                                               
#           (the one and only) in VG48  (PVIP)                                  
#                                                                               
VIP_TYPE=pvip                                                                   
SOEROOT=/soe/$VIP_TYPE                                                          
VIP_ROOT=opt/$VIP_TYPE                                                          
VIP_UNIX=/$VIP_ROOT/vip/source/vips/unixscr                                     
. $SOEROOT/etc/set_vip_basic_env -db dp_vip                                     
. $VIP_UNIX/set_vip_env                                                         
echo "VIP environment - VG48/pvip - dp_vip"                                     
# VIP_IMPORT_DEBUG=TRUE; export VIP_IMPORT_DEBUG                                
date                                                                            
echo "****** Below displayed, OMNIMARK environment status. ******"              
env | grep OMNI                                                                 
