#                                                                               
# Environment for database dp_evipt                                             
#           (the one and only) in VG48  (TVIP)                                  
#                                                                               
VIP_TYPE=tnvip                                                                  
SOEROOT=/soe/$VIP_TYPE                                                          
VIP_ROOT=opt/$VIP_TYPE                                                          
VIP_UNIX=/$VIP_ROOT/vip/source/evip/vips/unixscr                                
. $SOEROOT/etc/set_vip_basic_env -db dp_evipt                                   
. $VIP_UNIX/set_vip_env                                                         
echo "VIP environment - VG48/tvip - dp_evipt"                                   
# VIP_IMPORT_DEBUG=TRUE; export VIP_IMPORT_DEBUG                                
date                                                                            
echo "****** Below displayed, OMNIMARK environment status. ******"              
env | grep OMNI                                                                 
