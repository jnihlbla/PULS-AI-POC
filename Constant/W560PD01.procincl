 SORT FIELDS=COPY,EQUALS                                                        
 INCLUDE COND=(6,2,CH,EQ,C'41',OR,                                              
               6,2,CH,EQ,C'43',OR,                                              
               6,2,CH,EQ,C'44',OR,                                              
               6,2,CH,EQ,C'45',OR,                                              
               6,2,CH,EQ,C'46',OR,                                              
               6,2,CH,EQ,C'47',OR,                                              
               6,2,CH,EQ,C'92')                                                 
 SUM  FIELDS=(NONE)                                                             
 END                                                                            
