Ä                                                                               
Ä -Script for removing old .csv files from the w402/data directory              
Ä -The script finds and deletes all .csv files not created today.               
Ä                                                                               
echo Å(date '+%b.%e') > /tmp/w402d                                              
chmod 777 /tmp/w402d                                                            
chmod 777 /tmp/w402l                                                            
cut -c 55- < /tmp/w402l ! sed 's/^/rm /' > /tmp/w402_rm                         
chmod 777 /tmp/w402_rm                                                          
/tmp/w402_rm                                                                    
