*                                                                               
*     DEFINE TYPESETTER AS XEROX 9700                                           
*                                                                               
FTYP 2,                                                                         
*                                                                               
*     DEFINE ALLOWABLE POINT SIZES  (NB. MAX OF 10 ALLOWED)                     
*                                                                               
SIZE   6, 8, 9, 10, 11, 12, 14, 16, 18, 24,                                     
*                                                                               
*     DEFINE FORMATS FOR 9700 CONTROL RECORDS - MUST MATCH 9700 JSL             
*                                                                               
DJDE   E'¤¤¤', 1,  4, 0,,      PREFIX,OFFSET,SKIP,PCC FLG(0,1=SK1,2=SP0)        
RAUX   X'1111111111111111', 1,                                                  
ROFF   X'1212121212121212', 1,                                                  
RSTK   X'1313131313131313', 1,                                                  
ALIN   2592,3600,56,46,         DOT ALIGNMENT FOR EUROPEAN A4 PAGES             
*      VARIABLE LENGTH TAPE OUTPUT , MAX BLKSIZE                                
OBFM   2,8200,                  OFFLINE ONLY - IGNORE IF RUNNING ONLINE         
*                                                                               
*     DEFINE CHARACTERS REQUIRING SPECIAL TRANSLATION                           
*     (1) DECIMAL VALUE OF HEXADECIMAL INPUT CODE                               
*     (2) DECIMAL VALUE OF XEROX CHARACTER TO BE OUTPUT IF NO SHIFT             
*     (3) DECIMAL VALUE OF XEROX CHARACTER TO BE OUTPUT IF SHIFT 1              
*     (4) DECIMAL VALUE OF XEROX CHARACTER TO BE OUTPUT IF SHIFT 2              
*     (5) LOGICAL CHARACTER TYPE (SEE SYSTEM GUIDE -PAGE 31)                    
*                                                                               
*     DEFINES BROKEN VERTICAL BAR AS SHIFT 2 CHARACTER                          
*     XLAT  106,0,124,124,16                                                    
*     DEFINE EXCLAMATION AS SHIFT 2 CHARACTER                                   
XLAT 79,0,21,21,16                                                              
