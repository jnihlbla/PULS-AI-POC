FILE W44041D1                                                                   
%W440011                                                                        
  IN-IDDISTR     1  3  P   HEADING 'DIST'                                       
  IN-IDKUNDNR    4  4  P   HEADING 'CUST'                                       
  IN-IDKUNDRF    8  5  N   HEADING 'ORD.NO'                                     
  IN-IDARTNR    18  5  P   HEADING 'PART.NO'                                    
  IN-IDDC       23  2  A   HEADING 'DC'                                         
  IN-KDFRAKT    25  2  P   HEADING 'FC'                                         
  IN-KDORDKL    27  1  P   HEADING 'C'                                          
  IN-KDRAPRIO   29  2  P   HEADING 'PRIO'                                       
  IN-KVART      31  4  P   HEADING 'QTY'                                        
  IN-PRARTNTO   35  5  P 2                                                      
  IN-TIRODAT    40  4  P   HEADING 'BO.DATE'                                    
  IN-TITPO      44  4  P   HEADING 'TPO.DATE'                                   
  IN-TILEVBSK   48  3  P   HEADING 'PL.DATE'                                    
