%WWDIS106 'IN-' WORK ''                                                         
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
  JOB INPUT(W44041D1) NAME AKT02                                                
*                                                                               
    PERFORM S75-TEST-DIS106                                                     
    PERFORM SKRIV-RAPPORT                                                       
*                                                                               
%WWDIS106 'IN-' PROC ''                                                         
*                                                                               
NEWPAGE                                                                         
*                                                                               
SKRIV-RAPPORT.   PROC                                                           
                                                                                
  IF IN-IDDISTR LT 100                                                          
    NETKOST = +0                                                                
  ELSE                                                                          
    NETKOST = IN-KVART * IN-PRARTNTO                                            
  END-IF                                                                        
                                                                                
  IF IN-IDDISTR = DIS106-ROINFO-ITAL                                            
     PRINT W44041D2                                                             
     PRINT W44041X2                                                             
     IF IN-IDARTNR NE TEST-IDARTNR-I                                            
        SUM-ARTNR-I = SUM-ARTNR-I + 1                                           
     END-IF                                                                     
     SUM-RADER-I    = SUM-RADER-I   + 1                                         
     SUM-NETKOST-I  = SUM-NETKOST-I + NETKOST                                   
     TEST-IDARTNR-I = IN-IDARTNR                                                
  END-IF                                                                        
                                                                                
  IF IN-IDDISTR = DIS106-ROINFO-ENGLAND                                         
     PRINT W44041D3                                                             
     PRINT W44041X3                                                             
     IF IN-IDARTNR NE TEST-IDARTNR-GB                                           
        SUM-ARTNR-GB = SUM-ARTNR-GB + 1                                         
     END-IF                                                                     
     SUM-RADER-GB     = SUM-RADER-GB    + 1                                     
     SUM-NETKOST-GB   = SUM-NETKOST-GB + NETKOST                                
     TEST-IDARTNR-GB = IN-IDARTNR                                               
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
  IF IN-IDDISTR = DIS106-ROINFO-ISRAEL                                          
     PRINT W44041D4                                                             
     PRINT W44041X4                                                             
     IF IN-IDARTNR NE TEST-IDARTNR-IL                                           
        SUM-ARTNR-IL = SUM-ARTNR-IL + 1                                         
     END-IF                                                                     
     SUM-RADER-IL    = SUM-RADER-IL   + 1                                       
     SUM-NETKOST-IL  = SUM-NETKOST-IL + NETKOST                                 
     TEST-IDARTNR-IL = IN-IDARTNR                                               
  END-IF                                                                        
                                                                                
  IF IN-IDDISTR = DIS106-ROINFO-AUSTRIA                                         
     PRINT W44041D5                                                             
     PRINT W44041X5                                                             
     IF IN-IDARTNR NE TEST-IDARTNR-AUS                                          
        SUM-ARTNR-AUS = SUM-ARTNR-AUS + 1                                       
     END-IF                                                                     
     SUM-RADER-AUS    = SUM-RADER-AUS   + 1                                     
     SUM-NETKOST-AUS  = SUM-NETKOST-AUS + NETKOST                               
     TEST-IDARTNR-AUS = IN-IDARTNR                                              
  END-IF                                                                        
                                                                                
  IF IN-IDDISTR = DIS106-ROINFO-FIN                                             
     PRINT W44041D6                                                             
     PRINT W44041X6                                                             
     IF IN-IDARTNR NE TEST-IDARTNR-SF                                           
        SUM-ARTNR-SF = SUM-ARTNR-SF + 1                                         
     END-IF                                                                     
     SUM-RADER-SF    = SUM-RADER-SF   + 1                                       
     SUM-NETKOST-SF  = SUM-NETKOST-SF + NETKOST                                 
     TEST-IDARTNR-SF = IN-IDARTNR                                               
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
  IF IN-IDDISTR = DIS106-ROINFO-JAPAN                                           
     PRINT W44041D8                                                             
     PRINT W44041X8                                                             
     IF IN-IDARTNR NE TEST-IDARTNR-JPN                                          
        SUM-ARTNR-JPN = SUM-ARTNR-JPN + 1                                       
     END-IF                                                                     
     SUM-RADER-JPN    = SUM-RADER-JPN   + 1                                     
     SUM-NETKOST-JPN  = SUM-NETKOST-JPN + NETKOST                               
     TEST-IDARTNR-JPN = IN-IDARTNR                                              
  END-IF                                                                        
                                                                                
  IF IN-IDDISTR =  DIS106-ROINFO-TOTALLISTA                                     
    PRINT W44041D9                                                              
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
  IF IN-IDDISTR =  DIS106-ROINFO-HOLLAND                                        
     PRINT W44041DB                                                             
     PRINT W44041XB                                                             
     IF IN-IDARTNR NE TEST-IDARTNR-NL                                           
        SUM-ARTNR-NL = SUM-ARTNR-NL + 1                                         
     END-IF                                                                     
     SUM-RADER-NL    = SUM-RADER-NL   + 1                                       
     SUM-NETKOST-NL  = SUM-NETKOST-NL + NETKOST                                 
     TEST-IDARTNR-NL = IN-IDARTNR                                               
  END-IF                                                                        
                                                                                
  IF IN-IDDISTR =   DIS106-ROINFO-TYSKL                                         
     PRINT W44041DC                                                             
     PRINT W44041XC                                                             
     IF IN-IDARTNR NE TEST-IDARTNR-D                                            
        SUM-ARTNR-D = SUM-ARTNR-D + 1                                           
     END-IF                                                                     
     SUM-RADER-D    = SUM-RADER-D   + 1                                         
     SUM-NETKOST-D  = SUM-NETKOST-D + NETKOST                                   
     TEST-IDARTNR-D = IN-IDARTNR                                                
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
  IF IN-IDDISTR =   DIS106-ROINFO-FRANK                                         
     PRINT W44041DD                                                             
     PRINT W44041XD                                                             
     IF IN-IDARTNR NE TEST-IDARTNR-F                                            
        SUM-ARTNR-F = SUM-ARTNR-F + 1                                           
     END-IF                                                                     
     SUM-RADER-F    = SUM-RADER-F   + 1                                         
     SUM-NETKOST-F  = SUM-NETKOST-F + NETKOST                                   
     TEST-IDARTNR-F = IN-IDARTNR                                                
  END-IF                                                                        
                                                                                
  IF IN-IDDISTR =   DIS106-ROINFO-NORGE                                         
     PRINT W44041DE                                                             
     PRINT W44041XE                                                             
     IF IN-IDARTNR NE TEST-IDARTNR-N                                            
        SUM-ARTNR-N = SUM-ARTNR-N + 1                                           
     END-IF                                                                     
     SUM-RADER-N    = SUM-RADER-N   + 1                                         
     SUM-NETKOST-N  = SUM-NETKOST-N + NETKOST                                   
     TEST-IDARTNR-N = IN-IDARTNR                                                
  END-IF                                                                        
                                                                                
  IF IN-IDDISTR =    DIS106-ROINFO-SPANIEN                                      
     PRINT W44041DF                                                             
     PRINT W44041XF                                                             
     IF IN-IDARTNR NE TEST-IDARTNR-E                                            
        SUM-ARTNR-E = SUM-ARTNR-E + 1                                           
     END-IF                                                                     
     SUM-RADER-E    = SUM-RADER-E   + 1                                         
     SUM-NETKOST-E  = SUM-NETKOST-E + NETKOST                                   
     TEST-IDARTNR-E = IN-IDARTNR                                                
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
  IF IN-IDDISTR =    DIS106-ROINFO-SCHWEIZ                                      
     PRINT W44041DG                                                             
     PRINT W44041XG                                                             
     IF IN-IDARTNR NE TEST-IDARTNR-CH                                           
        SUM-ARTNR-CH = SUM-ARTNR-CH + 1                                         
     END-IF                                                                     
     SUM-RADER-CH    = SUM-RADER-CH   + 1                                       
     SUM-NETKOST-CH  = SUM-NETKOST-CH + NETKOST                                 
     TEST-IDARTNR-CH = IN-IDARTNR                                               
  END-IF                                                                        
                                                                                
  IF IN-IDDISTR =    DIS106-ROINFO-BRASIL                                       
     PRINT W44041DH                                                             
     PRINT W44041XH                                                             
     IF IN-IDARTNR NE TEST-IDARTNR-BRA                                          
        SUM-ARTNR-BRA = SUM-ARTNR-BRA + 1                                       
     END-IF                                                                     
     SUM-RADER-BRA    = SUM-RADER-BRA   + 1                                     
     SUM-NETKOST-BRA  = SUM-NETKOST-BRA + NETKOST                               
     TEST-IDARTNR-BRA = IN-IDARTNR                                              
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
  IF IN-IDARTNR NE TEST-IDARTNR                                                 
     SUM-ARTNR = SUM-ARTNR + 1                                                  
  END-IF                                                                        
                                                                                
  SUM-RADER    = SUM-RADER   + 1                                                
  SUM-NETKOST  = SUM-NETKOST + NETKOST                                          
  TEST-IDARTNR = IN-IDARTNR                                                     
                                                                                
  IF IN-IDDISTR NE TEST-IDDISTR                                                 
     IF IN-IDDISTR = DIS106-ROINFO-AUSTRIA                                      
        SUM-ARTNR-AUS   = +1                                                    
        SUM-RADER-AUS   = +1                                                    
        SUM-NETKOST-AUS = NETKOST                                               
     END-IF                                                                     
                                                                                
     IF IN-IDDISTR = DIS106-ROINFO-BRASIL                                       
        SUM-ARTNR-BRA   = +1                                                    
        SUM-RADER-BRA   = +1                                                    
        SUM-NETKOST-BRA = NETKOST                                               
     END-IF                                                                     
*                                                                               
NEWPAGE                                                                         
*                                                                               
     IF IN-IDDISTR = DIS106-ROINFO-SCHWEIZ                                      
        SUM-ARTNR-CH   = +1                                                     
        SUM-RADER-CH   = +1                                                     
        SUM-NETKOST-CH = NETKOST                                                
     END-IF                                                                     
                                                                                
     IF IN-IDDISTR = DIS106-ROINFO-ENGLAND                                      
        SUM-ARTNR-GB = +1                                                       
        SUM-RADER-GB = +1                                                       
        SUM-NETKOST-GB = NETKOST                                                
     END-IF                                                                     
                                                                                
     IF IN-IDDISTR = DIS106-ROINFO-TYSKL                                        
        SUM-ARTNR-D   = +1                                                      
        SUM-RADER-D   = +1                                                      
        SUM-NETKOST-D = NETKOST                                                 
     END-IF                                                                     
                                                                                
     IF IN-IDDISTR = DIS106-ROINFO-SPANIEN                                      
        SUM-ARTNR-E   = +1                                                      
        SUM-RADER-E   = +1                                                      
        SUM-NETKOST-E = NETKOST                                                 
     END-IF                                                                     
*                                                                               
NEWPAGE                                                                         
*                                                                               
     IF IN-IDDISTR =  DIS106-ROINFO-FRANK                                       
        SUM-ARTNR-F   = +1                                                      
        SUM-RADER-F   = +1                                                      
        SUM-NETKOST-F = NETKOST                                                 
     END-IF                                                                     
                                                                                
     IF IN-IDDISTR =  DIS106-ROINFO-ITAL                                        
        SUM-ARTNR-I   = +1                                                      
        SUM-RADER-I   = +1                                                      
        SUM-NETKOST-I = NETKOST                                                 
     END-IF                                                                     
                                                                                
     IF IN-IDDISTR =  DIS106-ROINFO-ISRAEL                                      
        SUM-ARTNR-IL   = +1                                                     
        SUM-RADER-IL   = +1                                                     
        SUM-NETKOST-IL = NETKOST                                                
     END-IF                                                                     
                                                                                
     IF IN-IDDISTR =  DIS106-ROINFO-JAPAN                                       
        SUM-ARTNR-JPN   = +1                                                    
        SUM-RADER-JPN   = +1                                                    
        SUM-NETKOST-JPN = NETKOST                                               
     END-IF                                                                     
*                                                                               
NEWPAGE                                                                         
*                                                                               
     IF IN-IDDISTR =  DIS106-ROINFO-NORGE                                       
        SUM-ARTNR-N   = +1                                                      
        SUM-RADER-N   = +1                                                      
        SUM-NETKOST-N = NETKOST                                                 
     END-IF                                                                     
                                                                                
     IF IN-IDDISTR =  DIS106-ROINFO-FIN                                         
        SUM-ARTNR-SF   = +1                                                     
        SUM-RADER-SF   = +1                                                     
        SUM-NETKOST-SF = NETKOST                                                
     END-IF                                                                     
                                                                                
     SUM-ARTNR    = +1                                                          
     SUM-RADER    = +1                                                          
     SUM-NETKOST  = NETKOST                                                     
     TEST-IDDISTR = IN-IDDISTR                                                  
                                                                                
  END-IF                                                                        
*                                                                               
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
  REPORT W44041D2   +                                                           
        LINESIZE 120 PAGESIZE 37 SPACE 1 NOSPREAD PRINTER W44041D2              
    CONTROL  (FINAL NOPRINT) +                                                  
             (IN-IDDISTR RENUM NOPRINT)                                         
    TITLE 1 'W44041-004                   BO-REPORT              '              
    LINE  1 IN-IDDISTR IN-IDKUNDNR IN-IDARTNR +                                 
            IN-KVART   IN-BEART    IN-IDDC     +                                
            IN-KDORDKL IN-KDFRAKT  IN-IDKUNDRF +                                
            IN-TIRODAT IN-TILEVBSK IN-REROFORD IN-TITPO NETKOST +               
            IN-KDRAPRIO                                                         
    LINE  2 TELEVBSK-EXT                                                        
    LINE  3 TELEVBSK-EXT2                                                       
BEFORE-BREAK.  PROC                                                             
   IF LEVEL = 1                                                                 
      DISPLAY '               '                                                 
      DISPLAY '               '                                                 
      DISPLAY '               ' 'PART NOS         ' SUM-ARTNR-I                 
      DISPLAY '               ' 'LINES            ' SUM-RADER-I                 
      DISPLAY '               ' 'TOT FOB NET '      SUM-NETKOST-I               
