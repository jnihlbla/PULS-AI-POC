                                                                                
**********************************************************************          
*                                                                    *          
* PROGRAM ...... : W56064                                            *          
*                                                                    *          
* SKRIVET AV ... : KARL JOHAN HANSSON                                *          
*                                                                    *          
* DATUM ........ : 981207                                            *          
*                                                                    *          
* FUNKTION: MATCHAR NY OCH GAMMAL LAGERSALDOFIL OCH SKAPAR LIST-     *          
*           TRANSAR FÖR LAB-ÅRSINVENTARIUM.                          *          
*           FRÅN GAMMAL SALDOFIL HÄMTAS AVERAGE COST OCH SALDON.     *          
*           OM ARTIKEL SAKNAS PÅ GAM. FIL,SÄTTS GAMMALT BELOPP = NYTT*          
*           SUMMA AVERAGE COST PER ARTIKEL BERÄKNAS FÖR DC 41 - 43   *          
*           BÅDE GAMMAL SUMMA OCH NY SUMMA.                          *          
*           DESSA SUMMOR GER TVÅ SNITTKOSTNADER, EN GAMMAL OCH EN    *          
*           NY GENOM ATT DIVIDERA SUMMORNA MED GAMMAL RESP. NY       *          
*           LAGERTOTAL.                                              *          
*                                                                    *          
* INDATA  : W560.W560Y1.W56062 GAMMALT LAGEREXTRAKT FRÅN FÖREG ÅR    *          
*         : W560.W560Y1.W56062 NYTT   LAGEREXTRAKT FRÅN DENNA KÖRNING*          
*                                                                    *          
* UTDATA. : W560.W560Y1.W56064 LISTTRANSAR FÖR LAB: END YEAR REPORT  *          
*                                                                    *          
**********************************************************************          
                                                                                
******* GAMMAL SALDOFIL, HÄR HÄMTAS AVERAGE COST OCH SALDON.                    
FILE W56064D1                                                                   
%W56062 'IO-'                                                                   
                                                                                
******* NY SALDOFIL, HÄR HÄMTAS ALLA ÖVRIGA VÄRDEN TILL LISTORNA                
FILE W56064D2                                                                   
%W56062 'IN-'                                                                   
                                                                                
******* TEMPFIL FÖR SORTERING OCH SUMMERING AV BLIVANDE LISTTRANSAR             
FILE TPFIL1  FB (65 0)                                                          
    T1-IDLEVNR        1     5 A                                                 
    T1-KDPSLLOC       6     2 N                                                 
    T1-BEART          8    25 A                                                 
    T1-TOT-STOCK-BEG 33     4 P  0                                              
    T1-TOT-STOCK-END 37     4 P  0                                              
    T1-PRARTAVG-OLD  41     5 P  2                                              
    T1-SUARTAVG-OLD  46     5 P  2                                              
    T1-PRARTAVG-NEW  51     5 P  2                                              
    T1-SUARTAVG-NEW  56     5 P  2                                              
    T1-IDARTNR       61     5 P  0                                              
                                                                                
FILE W56064D3 FB (61 0)                                                         
%W56064 'UT-'                                                                   
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
 W-TOT-STOCK-BEG    W   4 P  0                                                  
                                                                                
*----------------------------------------------------------------------*        
* MATCHA LAGERBANDEN OCH TAG FRAM UPPGIFTER FÖR LIFO-RAPPORTERNA                
*----------------------------------------------------------------------*        
                                                                                
JOB INPUT (W56064D1 KEY (IO-IDARTNR IO-IDDC)   +                                
           W56064D2 KEY (IN-IDARTNR IN-IDDC))                                   
                                                                                
IF MATCHED                                                                      
  T1-IDARTNR         = IN-IDARTNR                                               
  T1-KDPSLLOC        = IN-KDPSLLOC                                              
  T1-IDLEVNR         = IN-IDLEVNR                                               
  T1-TOT-STOCK-END   = IN-KVLS + IN-KVEFRS                                      
  T1-TOT-STOCK-BEG   = IO-KVLS + IO-KVEFRS                                      
  T1-PRARTAVG-NEW    = IN-PRAVCOST                                              
  T1-SUARTAVG-NEW    = IN-PRAVCOST * T1-TOT-STOCK-END                           
  T1-PRARTAVG-OLD    = IO-PRAVCOST                                              
  T1-SUARTAVG-OLD    = IO-PRAVCOST * T1-TOT-STOCK-BEG                           
  PUT TPFIL1                                                                    
ELSE                                                                            
  IF W56064D2                                                                   
    T1-IDARTNR       = IN-IDARTNR                                               
    T1-KDPSLLOC      = IN-KDPSLLOC                                              
    T1-IDLEVNR       = IN-IDLEVNR                                               
    T1-TOT-STOCK-END = IN-KVLS + IN-KVEFRS                                      
    T1-TOT-STOCK-BEG = 0                                                        
    T1-PRARTAVG-NEW  = IN-PRAVCOST                                              
    T1-SUARTAVG-NEW  = IN-PRAVCOST * T1-TOT-STOCK-END                           
    T1-PRARTAVG-OLD  = IN-PRAVCOST                                              
    T1-SUARTAVG-OLD  = IN-PRAVCOST * T1-TOT-STOCK-BEG                           
    PUT TPFIL1                                                                  
  END-IF                                                                        
END-IF                                                                          
                                                                                
SORT TPFIL1 TO TPFIL1 USING (T1-IDARTNR) SIZE 150000                            
                                                                                
                                                                                
JOB INPUT TPFIL1 START A-INIT FINISH Z-FINIT                                    
                                                                                
 IF UT-IDARTNR EQ T1-IDARTNR                                                    
   UT-TOT-STOCK      = UT-TOT-STOCK + T1-TOT-STOCK-END                          
   W-TOT-STOCK-BEG   = W-TOT-STOCK-BEG + T1-TOT-STOCK-BEG                       
   UT-SUARTAVG-OLD   = UT-SUARTAVG-OLD + T1-SUARTAVG-OLD                        
   UT-SUARTAVG-NEW   = UT-SUARTAVG-NEW + T1-SUARTAVG-NEW                        
 ELSE                                                                           
   IF UT-TOT-STOCK NE 0                                                         
     PERFORM SKAPA-LISTTRANS                                                    
   END-IF                                                                       
   UT-IDARTNR        = T1-IDARTNR                                               
   UT-KDPSLLOC       = T1-KDPSLLOC                                              
   UT-IDLEVNR        = T1-IDLEVNR                                               
   UT-TOT-STOCK      = T1-TOT-STOCK-END                                         
   W-TOT-STOCK-BEG   = T1-TOT-STOCK-BEG                                         
   UT-SUARTAVG-OLD   = T1-SUARTAVG-OLD                                          
   UT-SUARTAVG-NEW   = T1-SUARTAVG-NEW                                          
 END-IF                                                                         
                                                                                
A-INIT. PROC                                                                    
   UT-IDARTNR         = 0                                                       
   UT-KDPSLLOC        = 0                                                       
   UT-IDLEVNR         = ' '                                                     
   UT-TOT-STOCK       = 0                                                       
   W-TOT-STOCK-BEG    = 0                                                       
   UT-PRARTAVG-NEW    = 0                                                       
   UT-SUARTAVG-NEW    = 0                                                       
   UT-PRARTAVG-OLD    = 0                                                       
   UT-SUARTAVG-OLD    = 0                                                       
   UT-BEART           = ' '                                                     
END-PROC                                                                        
                                                                                
Z-FINIT. PROC                                                                   
   IF UT-TOT-STOCK NE 0                                                         
     PERFORM SKAPA-LISTTRANS                                                    
   END-IF                                                                       
END-PROC                                                                        
                                                                                
SKAPA-LISTTRANS. PROC                                                           
   UT-PRARTAVG-NEW ROUNDED = UT-SUARTAVG-NEW / UT-TOT-STOCK                     
                                                                                
   IF UT-SUARTAVG-OLD EQ 0 OR W-TOT-STOCK-BEG EQ 0                              
     UT-PRARTAVG-OLD = UT-PRARTAVG-NEW                                          
     UT-SUARTAVG-OLD = UT-PRARTAVG-NEW * UT-TOT-STOCK                           
   ELSE                                                                         
     UT-PRARTAVG-OLD ROUNDED = UT-SUARTAVG-OLD / W-TOT-STOCK-BEG                
     UT-SUARTAVG-OLD = UT-PRARTAVG-OLD * UT-TOT-STOCK                           
   END-IF                                                                       
   MOVE SPACE TO UT-BEART                                                       
   PUT W56064D3                                                                 
END-PROC                                                                        
