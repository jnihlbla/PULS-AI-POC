*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5129600                                              *        
*                                                                      *        
*  FUNCTION   :  CREATE KITS OBS REPORT                                *        
*                                                                      *        
*  AUTHOR     :  SARASWATHY S                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W51296D1                                                                   
*                                                                               
%W51299  'IN1-'                                                                 
*                                                                               
NEWPAGE                                                                         
FILE W51296D2                                                                   
*                                                                               
%W51295  'IN2-'                                                                 
*                                                                               
NEWPAGE                                                                         
FILE W51296D3                                                                   
*                                                                               
%W51295  'IN3-'                                                                 
*                                                                               
FILE TPFILE1  FB(10 0)                                                          
%W51299  'T1-'                                                                  
*                                                                               
FILE TPFILE2  FB(16 0)                                                          
%W51295  'T2-'                                                                  
*                                                                               
NEWPAGE                                                                         
FILE TPFILE3  FB(16 0)                                                          
%W51295  'T3-'                                                                  
*                                                                               
FILE TPFILE4  FB(16 0)                                                          
%W51295  'T4-'                                                                  
*                                                                               
NEWPAGE                                                                         
FILE W51296D4 FB(16 0)                                                          
*                                                                               
%W51295  'UT1-'                                                                 
*                                                                               
NEWPAGE                                                                         
FILE W51296D5 FB(16 0)                                                          
*                                                                               
%W51295  'UT2-'                                                                 
*                                                                               
****WORKING STORAGE SECTION                                                     
W-SULEVANT          W   5   P 0 VALUE 0                                         
*----------------------------------------------------------------------*        
* STEP 1. SORTS W51295B FILE ON PARTNO                                          
*----------------------------------------------------------------------*        
SORT W51296D2 TO TPFILE2  USING (IN2-IDARTNR) SIZE 900000                       
*                                                                               
*----------------------------------------------------------------------*        
* STEP 2. SORTS W51293B FILE ON PARTNO                                          
*----------------------------------------------------------------------*        
SORT W51296D3 TO TPFILE3  USING (IN3-IDARTNR) SIZE 900000                       
*                                                                               
*----------------------------------------------------------------------*        
* STEP 3. REMOVE DUPLICATE PART NOS AND SUM THE QTY OF THEM                     
*----------------------------------------------------------------------*        
JOB INPUT (W51296D1 KEY (IN1-IDARTNR))                                          
    W-SULEVANT         = W-SULEVANT    + IN1-SULEVANT                           
    IF LAST-DUP W51296D1 OR NOT DUPLICATE W51296D1                              
       T1-IDARTNR     = IN1-IDARTNR                                             
       T1-SULEVANT    = W-SULEVANT                                              
       PUT TPFILE1                                                              
       W-SULEVANT     = 0                                                       
    END-IF                                                                      
*----------------------------------------------------------------------*        
* STEP 4. MATCH W51299 AND W51293B                                              
*----------------------------------------------------------------------*        
JOB INPUT (TPFILE1 KEY (T1-IDARTNR) TPFILE2 KEY (T2-IDARTNR))                   
IF MATCHED                                                                      
  IF T2-IDDC = '11'                                                             
    T4-IDARTNR  = T1-IDARTNR                                                    
    T4-SULEVANT = T1-SULEVANT + T2-SULEVANT                                     
    T4-IDDC     = T2-IDDC                                                       
    T4-IDLEGSEL = T2-IDLEGSEL                                                   
    IF T4-SULEVANT NE 0                                                         
      PUT TPFILE4                                                               
    END-IF                                                                      
  ELSE                                                                          
    T4-IDARTNR  = T1-IDARTNR                                                    
    T4-SULEVANT = T2-SULEVANT                                                   
    T4-IDDC     = T2-IDDC                                                       
    T4-IDLEGSEL = T2-IDLEGSEL                                                   
    IF T4-SULEVANT NE 0                                                         
      PUT TPFILE4                                                               
    END-IF                                                                      
  END-IF                                                                        
ELSE                                                                            
  IF TPFILE1                                                                    
    T4-IDARTNR  = T1-IDARTNR                                                    
    T4-SULEVANT = T1-SULEVANT                                                   
    T4-IDDC     = '11'                                                          
    T4-IDLEGSEL = 'VCCS'                                                        
    IF T4-SULEVANT NE 0                                                         
      PUT TPFILE4                                                               
    END-IF                                                                      
  ELSE                                                                          
    IF TPFILE2                                                                  
       T4-IDARTNR  = T2-IDARTNR                                                 
       T4-SULEVANT = T2-SULEVANT                                                
       T4-IDDC     = T2-IDDC                                                    
       T4-IDLEGSEL = T2-IDLEGSEL                                                
       IF T4-SULEVANT NE 0                                                      
         PUT TPFILE4                                                            
       END-IF                                                                   
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
*                                                                               
*----------------------------------------------------------------------*        
* STEP 5. SORTS TPFILE4 FILE ON IDDC AND PART NO                                
*----------------------------------------------------------------------*        
SORT TPFILE4 TO W51296D4 USING (T4-IDDC T4-IDARTNR) SIZE 900000                 
*                                                                               
*----------------------------------------------------------------------*        
* STEP 6. MATCH W51299 AND W51295B                                              
*----------------------------------------------------------------------*        
JOB INPUT (TPFILE1 KEY (T1-IDARTNR) TPFILE3 KEY (T3-IDARTNR))                   
IF MATCHED                                                                      
    UT2-IDARTNR  = T1-IDARTNR                                                   
    UT2-SULEVANT = T1-SULEVANT + T3-SULEVANT                                    
    UT2-IDDC     = '  '                                                         
    UT2-IDLEGSEL = T3-IDLEGSEL                                                  
    IF UT2-SULEVANT NE 0                                                        
      PUT W51296D5                                                              
    END-IF                                                                      
ELSE                                                                            
  IF TPFILE1                                                                    
    UT2-IDARTNR  = T1-IDARTNR                                                   
    UT2-SULEVANT = T1-SULEVANT                                                  
    UT2-IDDC     = '  '                                                         
    UT2-IDLEGSEL = 'VCCS'                                                       
    IF UT2-SULEVANT NE 0                                                        
      PUT W51296D5                                                              
    END-IF                                                                      
  ELSE                                                                          
    IF TPFILE3                                                                  
       UT2-IDARTNR  = T3-IDARTNR                                                
       UT2-SULEVANT = T3-SULEVANT                                               
       UT2-IDDC     = '  '                                                      
       UT2-IDLEGSEL = T3-IDLEGSEL                                               
       IF UT2-SULEVANT NE 0                                                     
         PUT W51296D5                                                           
       END-IF                                                                   
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
*                                                                               
