       TULL-SUEFTA-LOC = 0                                                      
       TULL-SUOEVR-LOC = 0                                                      
     ELSE                                                                       
       TULL-SUEEC     = 0                                                       
       TULL-SUEEC-LOC = 0                                                       
       IF LB-CLAG-KDSRA = 3 OR +                                                
          LB-CLAG-KDSRA = 4                                                     
