     TULL-IDFAKT       = W-IDVERGL-N                                            
     TULL-IDDISTR      = 8073                                                   
     TULL-IDKUNDNR     = 0                                                      
     TULL-IDLANDX2     = 'SE'                                                   
     TULL-IDPRODNR     = 0                                                      
     TULL-KDFAKTYP     = ' '                                                    
     TULL-TIFAKT       = W-TIREGDAT                                             
     TULL-KDFRAKT      = 0                                                      
     TULL-SUORDV-FAKT  = 0                                                      
     TULL-SUORDV-FAKT-LOC = 0                                                   
     TULL-VKORDBTO-FAKT = 0                                                     
     TULL-IDSTATNR     = AKT-IDSTATNR                                           
     TULL-KDARTURS     = LB-CLAG-KDARTURS                                       
     TULL-KDSRA        = LB-CLAG-KDSRA                                          
     TULL-KVLEVART     = EKHT-KVANTAL                                           
     TULL-VKLEV        = ( EKHT-KVANTAL * LB-CLAG-VKART ) / 1000                
     TULL-SUFAKT       = EKHT-KVANTAL * EKHT-PRARTSTD                           
     TULL-SUFAKT-LOC   = EKHT-KVANTAL * EKHT-PRARTSTD                           
                                                                                
     IF LB-CLAG-KDSRA = 1 OR +                                                  
