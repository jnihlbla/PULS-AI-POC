***********************************************************************         
                                                                                
                                                                                
OVER-RETUR-SDC-CDC. PROC                                                        
                                                                                
****** POSTER TILL W475 TULLINFO                                                
                                                                                
  IF EKHT-IDDC-SEND = SDC-NL                                                    
     UT1-IDPTYP    = 'SD2'                                                      
     UT1-IDFAKT    = W-IDVERGL-N                                                
     UT1-IDDISTR   = 8033                                                       
     UT1-IDKUNDNR  = 0                                                          
     UT1-IDLANDX2  = 'SE'                                                       
     UT1-IDPRODNR  = 0                                                          
     UT1-KDFAKTYP  = ' '                                                        
     UT1-TIFAKT    = W-TIREGDAT                                                 
     UT1-KDFRAKT   = 0                                                          
     UT1-SUORDV-FAKT = 0                                                        
     UT1-IDSTATNR    = AKT-IDSTATNR                                             
     UT1-KDARTURS  = LB-CLAG-KDARTURS                                           
     UT1-KDSRA     = LB-CLAG-KDSRA                                              
     UT1-KVLEVART  = EKHT-KVANTAL                                               
     UT1-VKLEV     = ( EKHT-KVANTAL * LB-CLAG-VKART ) / 1000                    
     UT1-SUFAKT    = EKHT-KVANTAL * EKHT-PRARTSTD                               
                                                                                
     IF LB-CLAG-KDSRA = 1 OR +                                                  
        LB-CLAG-KDSRA = 2                                                       
       UT1-SUEEC = EKHT-KVANTAL * EKHT-PRARTSTD                                 
       UT1-SUEFTA = 0                                                           
       UT1-SUOEVR = 0                                                           
     ELSE                                                                       
       UT1-SUEEC   = 0                                                          
       IF LB-CLAG-KDSRA = 3 OR +                                                
          LB-CLAG-KDSRA = 4                                                     
         UT1-SUEFTA = EKHT-KVANTAL * EKHT-PRARTSTD                              
         UT1-SUOEVR = 0                                                         
       ELSE                                                                     
         UT1-SUEFTA = 0                                                         
         IF LB-CLAG-KDSRA = 0 OR +                                              
            LB-CLAG-KDSRA GT 4                                                  
            UT1-SUOEVR = EKHT-KVANTAL * EKHT-PRARTSTD                           
         ELSE                                                                   
            UT1-SUOEVR = 0                                                      
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     UT1-IDARTNR   = EKHT-IDARTNR                                               
                                                                                
     PUT W51044D3                                                               
