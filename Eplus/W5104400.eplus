       TULL-SUEFTA    = 0                                                       
       TULL-SUOEVR    = 0                                                       
       TULL-SUEEC-LOC = EKHT-KVANTAL * EKHT-PRARTSTD                            
       TULL-SUEFTA-LOC = 0                                                      
       TULL-SUOEVR-LOC = 0                                                      
     ELSE                                                                       
       TULL-SUEEC     = 0                                                       
       TULL-SUEEC-LOC = 0                                                       
       IF LB-CLAG-KDSRA = 3 OR +                                                
          LB-CLAG-KDSRA = 4                                                     
         TULL-SUEFTA  = EKHT-KVANTAL * EKHT-PRARTSTD                            
         TULL-SUOEVR  = 0                                                       
         TULL-SUEFTA-LOC = EKHT-KVANTAL * EKHT-PRARTSTD                         
         TULL-SUOEVR-LOC = 0                                                    
       ELSE                                                                     
         TULL-SUEFTA     = 0                                                    
         TULL-SUEFTA-LOC = 0                                                    
         IF LB-CLAG-KDSRA = 0 OR +                                              
            LB-CLAG-KDSRA GT 4                                                  
            TULL-SUOEVR  = EKHT-KVANTAL * EKHT-PRARTSTD                         
            TULL-SUOEVR-LOC = EKHT-KVANTAL * EKHT-PRARTSTD                      
         ELSE                                                                   
            TULL-SUOEVR  = 0                                                    
            TULL-SUOEVR-LOC = 0                                                 
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     TULL-IDARTNR  = EKHT-IDARTNR                                               
                                                                                
     PUT W51044D5                                                               
  END-IF                                                                        
