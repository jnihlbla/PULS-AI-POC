         TULL-SUOEVR  = 0                                                       
         TULL-SUEFTA-LOC = EKHT-KVANTAL * EKHT-PRARTSTD                         
         TULL-SUOEVR-LOC = 0                                                    
       ELSE                                                                     
         TULL-SUEFTA     = 0                                                    
         TULL-SUEFTA-LOC = 0                                                    
         IF LB-CLAG-KDSRA = 0 OR +                                              
            LB-CLAG-KDSRA GT 4                                                  
