                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5104400                                              *        
*                                                                      *        
*  FUNKTION   :  SKAPAR POSTER TILL W475-SYSTEMEN.                     *        
*                INFORMATION DAGLIGEN.                                 *        
*                                                                      *        
*                INFIL LB W01160 MATCHAS MED                           *        
*                INFIL HÄNDELSEFIL PEDAL W51067, OCH SKAPAR            *        
*                UTFIL W51044 TILL W51048 TULLFIL                      *        
*                UTFIL W51045 TILL W51048 MOMSFIL                      *        
*                UTFIL W51046 TILL W475 TULLINFO  HOLLAND              *        
*                                                                      *        
*  FÖRFATTARE :  KARL JOHAN HANSSON   AUG  2003                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W51044D1                                                                   
*                                                                               
%W51060  'IN-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE W51044D2                                                                   
*                                                                               
%W01160  'LB-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE TPFIL1   FB(265 0)                                                         
* SORTERAD HÄNDELSEFIL PEDAL (SORTORDNING ARTIKELNUMMER)                        
%W51060                                                                         
                                                                                
NEWPAGE                                                                         
FILE W51044D3 FB(79 0)                                                          
*                                                                               
%W475894  'UT1-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W51044D5 FB(127 0)                                                         
*  TULLINFO                                                                     
%W4758TU  'TULL-'                                                               
                                                                                
NEWPAGE                                                                         
FILE W51044D6 FB(72 0)                                                          
* MOMSINFO                                                                      
%W475896  'MOMS-'                                                               
                                                                                
NEWPAGE                                                                         
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
NEWPAGE                                                                         
*-----------------------------------------------------------------*             
* ARBETSFÄLT                                                                    
*-----------------------------------------------------------------*             
                                                                                
W-DAREGDAT   W             8  N                                                 
W-TIREGDAT   W-DAREGDAT +2 6  N                                                 
                                                                                
W-IDVERGL-A  W           10  A                                                  
W-IDVERGL-7N W-IDVERGL-A  7  N                                                  
W-IDVERGL-6N W-IDVERGL-A  6  N                                                  
W-IDVERGL-5N W-IDVERGL-A  5  N                                                  
W-IDVERGL-4N W-IDVERGL-A  4  N                                                  
W-IDVERGL-3N W-IDVERGL-A  3  N                                                  
W-IDVERGL-2N W-IDVERGL-A  2  N                                                  
W-IDVERGL-1N W-IDVERGL-A  1  N                                                  
                                                                                
W-IDVERGL-N  W            7  N                                                  
                                                                                
DEFAU-IDSTATNR  W         9  N  VALUE 87089998                                  
AKT-IDSTATNR    W         9  N                                                  
                                                                                
NEWPAGE                                                                         
*-----------------------------------------------------------------*             
* STEG 1  SORTERAR TEMPFILEN PÅ ARTIKELNR                                       
*-----------------------------------------------------------------*             
                                                                                
SORT W51044D1 TO TPFIL1 USING (IN-EKHT-IDARTNR) SIZE 300000                     
                                                                                
                                                                                
*-----------------------------------------------------------------*             
* STEG 2  MATCHAR OCH SKAPAR POSTER TILL W475-SYSTEMET                          
*-----------------------------------------------------------------*             
                                                                                
JOB INPUT(W51044D2 KEY (LB-CLAG-IDARTNR) TPFIL1 KEY (EKHT-IDARTNR))             
                                                                                
 IF MATCHED                                                                     
     IF LB-CLAG-IDSTATNR(3) = 0                                                 
       AKT-IDSTATNR      = DEFAU-IDSTATNR                                       
     ELSE                                                                       
       AKT-IDSTATNR      = LB-CLAG-IDSTATNR(3)                                  
     END-IF                                                                     
                                                                                
     W-DAREGDAT          = EKHT-DAREGDAT                                        
                                                                                
     PERFORM HÖGERJUSTERA-IDVERGL                                               
                                                                                
     IF EKHT-KDEKHHT = '502'                                                    
       CASE EKHT-KDEKSHT                                                        
         WHEN '501'                                                             
                    PERFORM LOST-KOLLI-RETUR-SDC-CDC                            
         WHEN '502'                                                             
                    PERFORM OVER-RETUR-SDC-CDC                                  
         WHEN '503'                                                             
                    PERFORM UNDER-RETUR-SDC-CDC                                 
       END-CASE                                                                 
     END-IF                                                                     
                                                                                
     IF EKHT-KDEKHHT = '503'                                                    
       CASE EKHT-KDEKSHT                                                        
         WHEN '501'                                                             
                    PERFORM LOST-KOLLI-REFILL                                   
         WHEN '502'                                                             
                    PERFORM OVER-REFILL                                         
         WHEN '503'                                                             
                    PERFORM UNDER-REFILL                                        
         WHEN '504'                                                             
                    PERFORM FOUND-LOST-KOLLI-REFILL                             
       END-CASE                                                                 
     END-IF                                                                     
 END-IF                                                                         
NEWPAGE                                                                         
                                                                                
HÖGERJUSTERA-IDVERGL. PROC                                                      
   W-IDVERGL-A              = EKHT-IDVERGL                                      
   IF W-IDVERGL-7N NUMERIC                                                      
           W-IDVERGL-N      = W-IDVERGL-7N                                      
   ELSE                                                                         
    IF W-IDVERGL-6N NUMERIC                                                     
           W-IDVERGL-N      = W-IDVERGL-6N                                      
    ELSE                                                                        
     IF W-IDVERGL-5N NUMERIC                                                    
           W-IDVERGL-N      = W-IDVERGL-5N                                      
     ELSE                                                                       
      IF W-IDVERGL-4N NUMERIC                                                   
           W-IDVERGL-N      = W-IDVERGL-4N                                      
      ELSE                                                                      
       IF W-IDVERGL-3N NUMERIC                                                  
           W-IDVERGL-N      = W-IDVERGL-3N                                      
       ELSE                                                                     
        IF W-IDVERGL-2N NUMERIC                                                 
           W-IDVERGL-N      = W-IDVERGL-2N                                      
        ELSE                                                                    
         IF W-IDVERGL-1N NUMERIC                                                
           W-IDVERGL-N      = W-IDVERGL-1N                                      
         ELSE                                                                   
           W-IDVERGL-N      = +0                                                
         END-IF                                                                 
        END-IF                                                                  
       END-IF                                                                   
      END-IF                                                                    
       END-IF                                                                   
     END-IF                                                                     
   END-IF                                                                       
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
************************************************************************        
******************  RETUR HÄNDELSER  SDC TILL CDC  *********************        
************************************************************************        
**** SEKTION DÄR MAN TAR HAND OM HÄNDELSETRANS RETUR SDC --> CDC.   ****        
**** VARIANT FÖR FÖRLORAT KOLLI.                                    ****        
****                                                                ****        
****             HÄNDELSETYP 150                                    ****        
****                                                                ****        
************************************************************************        
                                                                                
LOST-KOLLI-RETUR-SDC-CDC. PROC                                                  
                                                                                
******* HÄR SKAPAS POSTER TILL W475 TULLINFO                                    
                                                                                
  IF EKHT-IDDC-SEND = SDC-NL                                                    
     UT1-IDPTYP          = 'SD2'                                                
     UT1-IDFAKT          = W-IDVERGL-N                                          
     UT1-IDDISTR         = 8033                                                 
     UT1-IDKUNDNR        = 0                                                    
     UT1-IDLANDX2        = 'SE'                                                 
     UT1-IDPRODNR        = 0                                                    
     UT1-KDFAKTYP        = ' '                                                  
     UT1-TIFAKT          = W-TIREGDAT                                           
     UT1-KDFRAKT         = 0                                                    
     UT1-SUORDV-FAKT     = 0                                                    
     UT1-IDSTATNR        = AKT-IDSTATNR                                         
     UT1-KDARTURS        = LB-CLAG-KDARTURS                                     
     UT1-KDSRA           = LB-CLAG-KDSRA                                        
     UT1-KVLEVART        = EKHT-KVANTAL * -1                                    
     UT1-VKLEV           = (EKHT-KVANTAL * LB-CLAG-VKART) * -1     +            
                            / 1000                                              
     UT1-SUFAKT          = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
                                                                                
     IF LB-CLAG-KDSRA = 1 OR +                                                  
        LB-CLAG-KDSRA = 2                                                       
       UT1-SUEEC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                          
       UT1-SUEFTA = 0                                                           
       UT1-SUOEVR = 0                                                           
     ELSE                                                                       
       UT1-SUEEC   = 0                                                          
       IF LB-CLAG-KDSRA = 3 OR +                                                
          LB-CLAG-KDSRA = 4                                                     
         UT1-SUEFTA = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                       
         UT1-SUOEVR = 0                                                         
       ELSE                                                                     
         UT1-SUEFTA = 0                                                         
         IF LB-CLAG-KDSRA = 0 OR +                                              
            LB-CLAG-KDSRA GT 4                                                  
            UT1-SUOEVR = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                    
         ELSE                                                                   
            UT1-SUOEVR = 0                                                      
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     UT1-IDARTNR   = EKHT-IDARTNR                                               
                                                                                
     PUT W51044D3                                                               
  END-IF                                                                        
  IF EKHT-IDDC-SEND = LDC-GB-3A                                                 
     TULL-IDPTYP         = 'GB2'                                                
     TULL-IDDC           = EKHT-IDDC-SEND                                       
     TULL-IDFAKT         = W-IDVERGL-N                                          
     TULL-IDDISTR        = 8053                                                 
     TULL-IDKUNDNR       = 0                                                    
     TULL-IDLANDX2       = 'SE'                                                 
     TULL-IDPRODNR       = 0                                                    
     TULL-IDKUNDRF       = ' '                                                  
     TULL-KDFAKTYP       = ' '                                                  
     TULL-TIFAKT         = W-TIREGDAT                                           
     TULL-KDFRAKT        = 0                                                    
     TULL-SUORDV-FAKT    = 0                                                    
     TULL-SUORDV-FAKT-LOC = 0                                                   
     TULL-VKORDBTO-FAKT  = 0                                                    
     TULL-IDSTATNR       = AKT-IDSTATNR                                         
     TULL-KDARTURS       = LB-CLAG-KDARTURS                                     
     TULL-KDSRA          = LB-CLAG-KDSRA                                        
     TULL-KDSORT         = LB-CLAG-KDSORT                                       
     TULL-KVLEVART       = EKHT-KVANTAL * -1                                    
     TULL-VKLEV          = (EKHT-KVANTAL * LB-CLAG-VKART) * -1   +              
                             / 1000                                             
     TULL-SUFAKT         = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
     TULL-SUFAKT-LOC     = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
                                                                                
     IF LB-CLAG-KDSRA = 1 OR +                                                  
        LB-CLAG-KDSRA = 2                                                       
       TULL-SUEEC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                         
       TULL-SUEFTA = 0                                                          
       TULL-SUOEVR = 0                                                          
       TULL-SUEEC-LOC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                     
       TULL-SUEFTA-LOC = 0                                                      
       TULL-SUOEVR-LOC = 0                                                      
     ELSE                                                                       
       TULL-SUEEC       = 0                                                     
       TULL-SUEEC-LOC   = 0                                                     
       IF LB-CLAG-KDSRA = 3 OR +                                                
          LB-CLAG-KDSRA = 4                                                     
         TULL-SUEFTA    = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                   
         TULL-SUOEVR    = 0                                                     
         TULL-SUEFTA-LOC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
         TULL-SUOEVR-LOC = 0                                                    
       ELSE                                                                     
         TULL-SUEFTA       = 0                                                  
         TULL-SUEFTA-LOC   = 0                                                  
         IF LB-CLAG-KDSRA  = 0 OR +                                             
            LB-CLAG-KDSRA GT 4                                                  
            TULL-SUOEVR    = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                
            TULL-SUOEVR-LOC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1               
         ELSE                                                                   
            TULL-SUOEVR    = 0                                                  
            TULL-SUOEVR-LOC = 0                                                 
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
     TULL-IDARTNR    = EKHT-IDARTNR                                             
                                                                                
     PUT W51044D5                                                               
  END-IF                                                                        
  IF EKHT-IDDC-SEND = SDC-ES                                                    
     TULL-IDPTYP         = 'ES2'                                                
     TULL-IDDC           = EKHT-IDDC-SEND                                       
     TULL-IDFAKT         = W-IDVERGL-N                                          
     TULL-IDDISTR        = 8063                                                 
     TULL-IDKUNDNR       = 0                                                    
     TULL-IDLANDX2       = 'SE'                                                 
     TULL-IDPRODNR       = 0                                                    
     TULL-IDKUNDRF       = ' '                                                  
     TULL-KDFAKTYP       = ' '                                                  
     TULL-TIFAKT         = W-TIREGDAT                                           
     TULL-KDFRAKT        = 0                                                    
     TULL-SUORDV-FAKT    = 0                                                    
     TULL-SUORDV-FAKT-LOC = 0                                                   
     TULL-VKORDBTO-FAKT  = 0                                                    
     TULL-IDSTATNR       = DEFAU-IDSTATNR                                       
     TULL-KDARTURS       = LB-CLAG-KDARTURS                                     
     TULL-KDSRA          = LB-CLAG-KDSRA                                        
     TULL-KDSORT         = LB-CLAG-KDSORT                                       
     TULL-KVLEVART       = EKHT-KVANTAL * -1                                    
     TULL-VKLEV          = (EKHT-KVANTAL * LB-CLAG-VKART) * -1   +              
                             / 1000                                             
     TULL-SUFAKT         = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
     TULL-SUFAKT-LOC     = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
                                                                                
     IF LB-CLAG-KDSRA = 1 OR +                                                  
        LB-CLAG-KDSRA = 2                                                       
       TULL-SUEEC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                         
       TULL-SUEFTA = 0                                                          
       TULL-SUOEVR = 0                                                          
       TULL-SUEEC-LOC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                     
       TULL-SUEFTA-LOC = 0                                                      
       TULL-SUOEVR-LOC = 0                                                      
     ELSE                                                                       
       TULL-SUEEC       = 0                                                     
       TULL-SUEEC-LOC   = 0                                                     
       IF LB-CLAG-KDSRA = 3 OR +                                                
          LB-CLAG-KDSRA = 4                                                     
         TULL-SUEFTA    = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                   
         TULL-SUOEVR    = 0                                                     
         TULL-SUEFTA-LOC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
         TULL-SUOEVR-LOC = 0                                                    
       ELSE                                                                     
         TULL-SUEFTA       = 0                                                  
         TULL-SUEFTA-LOC   = 0                                                  
         IF LB-CLAG-KDSRA  = 0 OR +                                             
            LB-CLAG-KDSRA GT 4                                                  
            TULL-SUOEVR    = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                
            TULL-SUOEVR-LOC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1               
         ELSE                                                                   
            TULL-SUOEVR    = 0                                                  
            TULL-SUOEVR-LOC = 0                                                 
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     TULL-IDARTNR    = EKHT-IDARTNR                                             
                                                                                
     PUT W51044D5                                                               
  END-IF                                                                        
  IF EKHT-IDDC-SEND = SDC-IT                                                    
     TULL-IDPTYP         = 'IT2'                                                
     TULL-IDDC           = EKHT-IDDC-SEND                                       
     TULL-IDFAKT         = W-IDVERGL-N                                          
     TULL-IDDISTR        = 8073                                                 
     TULL-IDKUNDNR       = 0                                                    
     TULL-IDLANDX2       = 'SE'                                                 
     TULL-IDPRODNR       = 0                                                    
     TULL-IDKUNDRF       = ' '                                                  
     TULL-KDFAKTYP       = ' '                                                  
     TULL-TIFAKT         = W-TIREGDAT                                           
     TULL-KDFRAKT        = 0                                                    
     TULL-SUORDV-FAKT    = 0                                                    
     TULL-SUORDV-FAKT-LOC = 0                                                   
     TULL-VKORDBTO-FAKT  = 0                                                    
     TULL-IDSTATNR       = AKT-IDSTATNR                                         
     TULL-KDARTURS       = LB-CLAG-KDARTURS                                     
     TULL-KDSRA          = LB-CLAG-KDSRA                                        
     TULL-KDSORT         = LB-CLAG-KDSORT                                       
     TULL-KVLEVART       = EKHT-KVANTAL * -1                                    
     TULL-VKLEV          = (EKHT-KVANTAL * LB-CLAG-VKART) * -1   +              
                             / 1000                                             
     TULL-SUFAKT         = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
     TULL-SUFAKT-LOC     = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
                                                                                
     IF LB-CLAG-KDSRA = 1 OR +                                                  
        LB-CLAG-KDSRA = 2                                                       
       TULL-SUEEC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                         
       TULL-SUEFTA = 0                                                          
       TULL-SUOEVR = 0                                                          
       TULL-SUEEC-LOC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                     
       TULL-SUEFTA-LOC = 0                                                      
       TULL-SUOEVR-LOC = 0                                                      
     ELSE                                                                       
       TULL-SUEEC     = 0                                                       
       TULL-SUEEC-LOC = 0                                                       
       IF LB-CLAG-KDSRA = 3 OR +                                                
          LB-CLAG-KDSRA = 4                                                     
         TULL-SUEFTA  = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                     
         TULL-SUOEVR  = 0                                                       
         TULL-SUEFTA-LOC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
         TULL-SUOEVR-LOC = 0                                                    
       ELSE                                                                     
         TULL-SUEFTA     = 0                                                    
         TULL-SUEFTA-LOC = 0                                                    
         IF LB-CLAG-KDSRA = 0 OR +                                              
            LB-CLAG-KDSRA GT 4                                                  
            TULL-SUOEVR  = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
            TULL-SUOEVR-LOC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1               
         ELSE                                                                   
            TULL-SUOEVR  = 0                                                    
            TULL-SUOEVR-LOC = 0                                                 
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     TULL-IDARTNR  = EKHT-IDARTNR                                               
                                                                                
     PUT W51044D5                                                               
  END-IF                                                                        
  IF EKHT-IDDC-SEND = SDC-AT                                                    
     TULL-IDPTYP         = 'AT2'                                                
     TULL-IDDC           = EKHT-IDDC-SEND                                       
     TULL-IDFAKT         = W-IDVERGL-N                                          
     TULL-IDDISTR        = 8083                                                 
     TULL-IDKUNDNR       = 0                                                    
     TULL-IDLANDX2       = 'SE'                                                 
     TULL-IDPRODNR       = 0                                                    
     TULL-IDKUNDRF       = ' '                                                  
     TULL-KDFAKTYP       = ' '                                                  
     TULL-TIFAKT         = W-TIREGDAT                                           
     TULL-KDFRAKT        = 0                                                    
     TULL-SUORDV-FAKT    = 0                                                    
     TULL-SUORDV-FAKT-LOC = 0                                                   
     TULL-VKORDBTO-FAKT  = 0                                                    
     TULL-IDSTATNR       = AKT-IDSTATNR                                         
     TULL-KDARTURS       = LB-CLAG-KDARTURS                                     
     TULL-KDSRA          = LB-CLAG-KDSRA                                        
     TULL-KDSORT         = LB-CLAG-KDSORT                                       
     TULL-KVLEVART       = EKHT-KVANTAL * -1                                    
     TULL-VKLEV          = (EKHT-KVANTAL * LB-CLAG-VKART) * -1   +              
                             / 1000                                             
     TULL-SUFAKT         = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
     TULL-SUFAKT-LOC     = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
                                                                                
     IF LB-CLAG-KDSRA = 1 OR +                                                  
        LB-CLAG-KDSRA = 2                                                       
       TULL-SUEEC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                         
       TULL-SUEFTA = 0                                                          
       TULL-SUOEVR = 0                                                          
       TULL-SUEEC-LOC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                     
       TULL-SUEFTA-LOC = 0                                                      
       TULL-SUOEVR-LOC = 0                                                      
     ELSE                                                                       
       TULL-SUEEC     = 0                                                       
       TULL-SUEEC-LOC = 0                                                       
       IF LB-CLAG-KDSRA = 3 OR +                                                
          LB-CLAG-KDSRA = 4                                                     
         TULL-SUEFTA  = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                     
         TULL-SUOEVR  = 0                                                       
         TULL-SUEFTA-LOC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
         TULL-SUOEVR-LOC = 0                                                    
       ELSE                                                                     
         TULL-SUEFTA     = 0                                                    
         TULL-SUEFTA-LOC = 0                                                    
         IF LB-CLAG-KDSRA = 0 OR +                                              
            LB-CLAG-KDSRA GT 4                                                  
            TULL-SUOEVR  = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1                  
            TULL-SUOEVR-LOC = (EKHT-KVANTAL * EKHT-PRARTSTD) * -1               
         ELSE                                                                   
            TULL-SUOEVR  = 0                                                    
            TULL-SUOEVR-LOC = 0                                                 
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
                                                                                
     TULL-IDARTNR  = EKHT-IDARTNR                                               
                                                                                
     PUT W51044D5                                                               
  END-IF                                                                        
NEWPAGE                                                                         
                                                                                
****** HÄR SKAPAS POSTER TILL MOMSLISTA                                         
****** HOLLAND STORBRITANNIEN SPANIEN ITALIEN ÖSTERRIKE                         
                                                                                
   IF EKHT-IDDC-SEND = SDC-NL                                                   
       MOMS-IDPTYP          = 'HOL'                                             
       MOMS-SORTNR          = 1                                                 
       MOMS-IDVAT           = 'SE556074308901'                                  
       MOMS-IDDISTR         = 8033                                              
       MOMS-IDKUNDNR        = 0                                                 
       MOMS-IDFAKT          = W-IDVERGL-N                                       
       MOMS-TIFAKT          = W-TIREGDAT                                        
       MOMS-KDVALISO        = 'EUR'                                             
       MOMS-SUFKTBEL        = EKHT-PRARTSTD * EKHT-KVANTAL * -1                 
       MOMS-PRMOMS          = 0                                                 
       MOMS-SUFKTBEL-VAT-LOC = EKHT-PRARTSTD * EKHT-KVANTAL * -1                
       MOMS-SUVAT-FAKT-LOC  = 0                                                 
                                                                                
       PUT W51044D6                                                             
   END-IF                                                                       
   IF EKHT-IDDC-SEND = LDC-GB-3A                                                
       MOMS-IDPTYP          = 'GBR'                                             
       MOMS-SORTNR          = 1                                                 
       MOMS-IDVAT           = 'SE556074308901'                                  
       MOMS-IDDISTR         = 8053                                              
       MOMS-IDKUNDNR        = 0                                                 
       MOMS-IDFAKT          = W-IDVERGL-N                                       
       MOMS-TIFAKT          = W-TIREGDAT                                        
       MOMS-KDVALISO        = 'GBP'                                             
       MOMS-SUFKTBEL        = EKHT-PRARTSTD * EKHT-KVANTAL * -1                 
       MOMS-PRMOMS          = 0                                                 
       MOMS-SUFKTBEL-VAT-LOC = EKHT-PRARTSTD * EKHT-KVANTAL * -1                
       MOMS-SUVAT-FAKT-LOC  = 0                                                 
                                                                                
       PUT W51044D6                                                             
   END-IF                                                                       
   IF EKHT-IDDC-SEND = SDC-ES                                                   
       MOMS-IDPTYP          = 'ESP'                                             
       MOMS-SORTNR          = 1                                                 
       MOMS-IDVAT           = 'SE556074308901'                                  
       MOMS-IDDISTR         = 8063                                              
       MOMS-IDKUNDNR        = 0                                                 
       MOMS-IDFAKT          = W-IDVERGL-N                                       
       MOMS-TIFAKT          = W-TIREGDAT                                        
       MOMS-KDVALISO        = 'EUR'                                             
