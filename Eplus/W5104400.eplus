         UT1-SUEFTA        = 0                                                  
         UT1-SUOEVR        = 0                                                  
       ELSE                                                                     
         UT1-SUEEC = 0                                                          
         IF LB-CLAG-KDSRA = 3 OR +                                              
            LB-CLAG-KDSRA = 4                                                   
           UT1-SUEFTA = EKHT-KVANTAL * EKHT-PRARTSTD                            
           UT1-SUOEVR = 0                                                       
         ELSE                                                                   
