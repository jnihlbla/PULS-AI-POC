NEWPAGE                                                                         
FILE W3715MD1                                                                   
*                                                                               
%W01184  'IN1-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE TPFILE1 FB(483 0)                                                          
*                                                                               
%W01184  'TP1-'                                                                 
*                                                                               
NEWPAGE                                                                         
FILE TPFILE5 FB(483 0)                                                          
*                                                                               
%W01184  'TP5-'                                                                 
*                                                                               
NEWPAGE                                                                         
FILE W3715MD2                                                                   
*                                                                               
%W01174  'IN2-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE TPFILE2 FB(285 0)                                                          
*                                                                               
%W01174  'TP2-'                                                                 
*                                                                               
NEWPAGE                                                                         
FILE W3715MD3                                                                   
*                                                                               
%W01160  'IN3-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE TPFILE3 FB(950 0)                                                          
*                                                                               
%W01160  'TP3-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W3715MD4                                                                   
*                                                                               
%W48881  'IN4-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE TPFILE4 FB(41 0)                                                           
*                                                                               
%W48881  'TP4-'                                                                 
*                                                                               
NEWPAGE                                                                         
FILE TPFILE6 FB(41 0)                                                           
*                                                                               
%W48881  'TP6-'                                                                 
NEWPAGE                                                                         
FILE TPFILE FB (69 0)                                                           
TP-IDARTNR     1  9 N 0                                                         
TP-REKSIFFR   10  1 N                                                           
TP-ADLAGOMR   11  4 N 0                                                         
TP-ADGANG     15  4 N 0                                                         
TP-ADPLATS    19  6 N 0                                                         
TP-KVLS       25  4 P 0                                                         
TP-KVAKS-SDC  29  8 N 0                                                         
TP-KVAKS-PAV  37  8 N 0                                                         
TP-BEART-ENG  45 25 A                                                           
                                                                                
FILE TPFILE7 FB (69 0)                                                          
TP7-IDARTNR     1  9 N 0                                                        
TP7-REKSIFFR   10  1 N                                                          
TP7-ADLAGOMR   11  4 N 0                                                        
TP7-ADGANG     15  4 N 0                                                        
TP7-ADPLATS    19  6 N 0                                                        
TP7-KVLS       25  4 P 0                                                        
TP7-KVAKS-SDC  29  8 N 0                                                        
TP7-KVAKS-PAV  37  8 N 0                                                        
TP7-BEART-ENG  45 25 A                                                          
NEWPAGE                                                                         
FILE W3715MD5 PRINTER VB (205 0)                                                
*                                                                               
UT-ADLAGOMR    W  4 N 0  MASK 'ZZZ9'                                            
UT-ADGANG      W  4 N 0  MASK 'ZZZ9'                                            
UT-ADPLATS     W  6 N 0  MASK 'ZZZZZ9'                                          
UT-KVLS        W  4 P 0  MASK 'ZZZZZZ9-'                                        
UT-KVAKS-SDC   W  8 N 0  MASK 'ZZZZZZZ9'                                        
UT-KVAKS-PAV   W  8 N 0  MASK 'ZZZZZZZ9'                                        
UT-IDARTNR     W  9 N 0  MASK 'ZZZZZZZZ9'                                       
UT-DASH        W  1 A    VALUE '-'                                              
UT-REKSIFFR    W  1 N                                                           
UT-BEART-ENG   W 25 A                                                           
UT-ADBUFFOMR   W  4 N 0  MASK 'ZZZ9'                                            
UT-ADBUFFGANG  W  4 N 0  MASK 'ZZZ9'                                            
UT-ADBUFFPL    W  6 N 0  MASK 'ZZZZZ9'                                          
UT-KVBUFF-F    W  8 N 0  MASK 'ZZZZZZZ9'                                        
UT-KVKOLLI-F   W  6 N 0  MASK 'ZZZZZ9'                                          
                                                                                
NEWPAGE                                                                         
%WDATKORT                                                                       
%WWDC99                                                                         
                                                                                
NEWPAGE                                                                         
W-PGMNAMN   W  6  A  VALUE 'W3715M'                                             
W-WDATUM    W  6  A  VALUE 'WDATUM'                                             
W-DATUM                W  6   N                                                 
W-AAR     W-DATUM         2   N                                                 
W-MM      W-DATUM    +2   2   N                                                 
W-DD      W-DATUM    +4   2   N                                                 
*                                                                               
JA              W   1  A   VALUE 'J'                                            
NEJ             W   1  A   VALUE 'N'                                            
SW-FIRST        S   1  A   VALUE 'J'                                            
*                                                                               
W-SEM1      W  1  A  VALUE ';'                                                  
                                                                                
NEWPAGE                                                                         
****************************************                                        
* STEP 1. JOB READS W3715MD1 FOR IDDC=91                                        
****************************************                                        
JOB INPUT W3715MD1                                                              
  IF IN1-SLAG-IDDC = SDC-NL-ET                                                  
   IF IN1-SLAG-ADLAGOMR = 61 THRU 87                                            
     PUT TPFILE1 FROM W3715MD1                                                  
   END-IF                                                                       
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
****************************************                                        
* STEP 2. JOB READS W3715MD4 FOR IDDC=91                                        
****************************************                                        
JOB INPUT W3715MD4                                                              
  IF IN4-IDDC = SDC-NL-ET                                                       
   IF IN4-ADBUFFOMR = 63 THRU 86                                                
     PUT TPFILE4 FROM W3715MD4                                                  
   END-IF                                                                       
  END-IF                                                                        
****************************************                                        
* STEP 3. SORT TPFILE1 WITH IDARTNR                                             
****************************************                                        
SORT TPFILE1 TO TPFILE5 USING TP1-SLAG-IDARTNR                                  
                                                                                
****************************************                                        
* STEP 4. SORT TPFILE4 WITH IDARTNR                                             
****************************************                                        
SORT TPFILE4 TO TPFILE6 USING TP4-IDARTNR                                       
                                                                                
NEWPAGE                                                                         
****************************************                                        
* STEP 5. SORT W01174 WITH IDARTNR                                              
****************************************                                        
SORT W3715MD2 TO TPFILE2 USING IN2-IDARTNR                                      
                                                                                
NEWPAGE                                                                         
****************************************                                        
* STEP 6. SORT W01160 WITH IDARTNR                                              
****************************************                                        
SORT W3715MD3 TO TPFILE3 USING IN3-CLAG-IDARTNR                                 
                                                                                
NEWPAGE                                                                         
****************************************                                        
* STEP 7. JOB COMPARE 3 FILES                                                   
****************************************                                        
JOB INPUT (TPFILE5 KEY (TP5-SLAG-IDARTNR)                        +              
           TPFILE2 KEY (TP2-IDARTNR)                             +              
           TPFILE3 KEY (TP3-CLAG-IDARTNR))                                      
  IF MATCHED                                                                    
     TP-IDARTNR    = TP5-SLAG-IDARTNR                                           
     TP-REKSIFFR   = TP3-CLAG-REKSIFFR                                          
     TP-ADLAGOMR   = TP5-SLAG-ADLAGOMR                                          
     TP-ADGANG     = TP5-SLAG-ADGANG                                            
     TP-ADPLATS    = TP5-SLAG-ADPLATS                                           
     TP-KVLS       = TP5-SLAG-KVLS                                              
     TP-KVAKS-SDC  = TP5-SLAG-KVAKS-SDC                                         
     TP-KVAKS-PAV  = TP5-SLAG-KVAKS-PAV                                         
     TP-BEART-ENG  = TP2-BEART(4)                                               
     PUT TPFILE                                                                 
  END-IF                                                                        
NEWPAGE                                                                         
****************************************                                        
* STEP 6. SORT TPFILE WITH IDARTNR                                              
****************************************                                        
SORT TPFILE   TO TPFILE7 USING TP-IDARTNR                                       
NEWPAGE                                                                         
****************************************                                        
* STEP 7. JOB COMPARE 2 FILES                                                   
****************************************                                        
JOB INPUT (TPFILE7 KEY (TP7-IDARTNR)                        +                   
           TPFILE6 KEY (TP6-IDARTNR)) START INIT-PROC                           
  IF MATCHED                                                                    
     UT-ADLAGOMR   = TP7-ADLAGOMR                                               
     UT-ADGANG     = TP7-ADGANG                                                 
     UT-ADPLATS    = TP7-ADPLATS                                                
     UT-KVLS       = TP7-KVLS                                                   
     UT-KVAKS-SDC  = TP7-KVAKS-SDC                                              
     UT-KVAKS-PAV  = TP7-KVAKS-PAV                                              
     UT-IDARTNR    = TP7-IDARTNR                                                
     UT-REKSIFFR   = TP7-REKSIFFR                                               
     UT-BEART-ENG  = TP7-BEART-ENG                                              
     UT-ADBUFFOMR  = TP6-ADBUFFOMR                                              
     UT-ADBUFFGANG = TP6-ADBUFFGANG                                             
     UT-ADBUFFPL   = TP6-ADBUFFPL                                               
     UT-KVBUFF-F   = TP6-KVBUFF-F                                               
     UT-KVKOLLI-F  = TP6-KVKOLLI-F                                              
     PRINT REPORT1                                                              
  END-IF                                                                        
INIT-PROC. PROC                                                                 
   CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                            
                                                                                
   W-AAR = D-AAR                                                                
   W-MM  = D-MAANAD                                                             
   W-DD  = D-DAG                                                                
END-PROC                                                                        
*-------------------------------------                                          
NEWPAGE                                                                         
*-------------------------------------                                          
  REPORT    REPORT1          +                                                  
            PRINTER W3715MD5 +                                                  
            PAGESIZE 30000   +                                                  
            LINESIZE 199     +                                                  
            SPACE 0          +                                                  
            SKIP  0          +                                                  
            TITLESKIP 3      +                                                  
            NODATE           +                                                  
            NOPAGE           +                                                  
            NOHEADING        +                                                  
            NOADJUST         +                                                  
            NOSPREAD                                                            
  SEQUENCE                   +                                                  
            UT-ADGANG           +                                               
            UT-ADPLATS          +                                               
            UT-ADLAGOMR         +                                               
            UT-IDARTNR                                                          
*                                                                               
  LINE     UT-ADLAGOMR      +                                                   
           W-SEM1           +                                                   
           UT-ADGANG        +                                                   
           W-SEM1           +                                                   
           UT-ADPLATS       +                                                   
           W-SEM1           +                                                   
           UT-IDARTNR       +                                                   
           UT-DASH          +                                                   
           UT-REKSIFFR      +                                                   
           W-SEM1           +                                                   
           UT-BEART-ENG     +                                                   
           W-SEM1           +                                                   
           UT-KVLS          +                                                   
           W-SEM1           +                                                   
           UT-KVAKS-SDC     +                                                   
           W-SEM1           +                                                   
           UT-KVAKS-PAV     +                                                   
           W-SEM1           +                                                   
           UT-ADBUFFOMR     +                                                   
           W-SEM1           +                                                   
           UT-ADBUFFGANG    +                                                   
           W-SEM1           +                                                   
           UT-ADBUFFPL      +                                                   
           W-SEM1           +                                                   
           UT-KVBUFF-F      +                                                   
           W-SEM1           +                                                   
           UT-KVKOLLI-F     +                                                   
           W-SEM1                                                               
*                                                                               
BEFORE-LINE. PROC                                                               
 IF SW-FIRST = JA                                                               
    DISPLAY '¤DAPW3715M-091'                                                    
    DISPLAY '¤DAPW3715M'                                                        
    DISPLAY 'VOLVO CAR PARTS; W3715M-091; BUFFERLOCATIES MET PICK +             
             LOCATIES; DATE:' W-DATUM                                           
    DISPLAY 'AREA FIX; AISLE FIX; ADDRESS FIX; PART NO;      +                  
             DESCRIPTION; STOCK BALANCE; AK-SDC BALANCE;     +                  
             AK-GIT BALANCE; AREA BUF; AISLE BUF; ADDRESS BUF;  +               
             QTY BUF; CASES;'                                                   
    SW-FIRST = NEJ                                                              
  END-IF                                                                        
END-PROC                                                                        
*                                                                               
