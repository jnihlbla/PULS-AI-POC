                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2317000                                              *        
*                                                                      *        
*  FUNKTION   :  SKAPAR FIL REFILL UPPFÖLJNING                         *        
*                                                                      *        
*  FÖRFATTARE :  BODIL LINDAHL                                         *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W23170D1                                                                   
*                                                                               
%W27120   'IN-'                                                                 
IN-KDPRISKL 12 1 A                                                              
IN-KDFREKKL 13 1 A                                                              
                                                                                
NEWPAGE                                                                         
FILE W23170D3                                                                   
*                                                                               
%W01184                                                                         
                                                                                
NEWPAGE                                                                         
FILE W23170D4                                                                   
*                                                                               
%W01186                                                                         
                                                                                
NEWPAGE                                                                         
FILE SDC VIRTUAL RETAIN FB (14 0)                                               
SDC-IDARTNR     1  5 P                                                          
SDC-IDDC        6  2 A                                                          
SDC-PRARTSTD    8  5 P 2                                                        
SDC-KDFREKKL   13  1 A                                                          
SDC-KDPRISKL   14  1 A                                                          
                                                                                
NEWPAGE                                                                         
FILE ARTFIL VIRTUAL RETAIN FB (736 0)                                           
*                                                                               
%W231701A     'ART-'                                                            
                                                                                
NEWPAGE                                                                         
FILE W23170D5 FB(736 0)                                                         
*                                                                               
%W231701A     'UT-'                                                             
                                                                                
NEWPAGE                                                                         
                                                                                
INDX        W    2   N   VALUE 0                                                
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
* STEG 2. MATCHAR NEDLÄST WDK7 WDL7 SKAPAR TEMPFIL                              
JOB INPUT(W23170D3 KEY (SLAG-IDDC SLAG-IDARTNR) +                               
          W23170D4 KEY (DC-IDDC DC-IDARTNR))                                    
                                                                                
 IF MATCHED                                                                     
    ART-IDARTNR               = DC-IDARTNR                                      
    ART-IDDC                  = SLAG-IDDC                                       
    ART-IDDC-REF              = SLAG-IDDC-REF                                   
    ART-IDREFTAB              = SLAG-IDREFTAB                                   
    ART-KDREFSTA              = SLAG-KDREFSTA                                   
    ART-KVAKS-SDC             = SLAG-KVAKS-SDC                                  
    ART-KVAKS-PAV             = SLAG-KVAKS-PAV                                  
    ART-KVLS                  = SLAG-KVLS                                       
    ART-KVOKS                 = SLAG-KVOKS-DAG + SLAG-KVOKS-BULK                
    ART-KVPB-REF              = SLAG-KVPB-REF                                   
    ART-KVREFBER              = SLAG-KVREFBER                                   
    ART-KVREFOVL              = SLAG-KVREFOVL                                   
    ART-KVREFPKT              = SLAG-KVREFPKT                                   
    PERFORM SKAPA-ARTFIL                                                        
    PUT ARTFIL                                                                  
 ELSE                                                                           
* OM ARTIKEL SAKNAS PÅ WDK7                                                     
    IF W23170D4                                                                 
       ART-KDREFSTA           = ' '                                             
       ART-IDREFTAB           = ' '                                             
       ART-IDARTNR            = DC-IDARTNR                                      
       ART-IDDC-REF           = '11'                                            
       ART-IDDC               = DC-IDDC                                         
       ART-KVAKS-SDC          = 0                                               
       ART-KVAKS-PAV          = 0                                               
       ART-KVLS               = 0                                               
       ART-KVOKS              = 0                                               
       ART-KVPB-REF           = 0                                               
       ART-KVREFBER           = 0                                               
       ART-KVREFOVL           = 0                                               
       ART-KVREFPKT           = 0                                               
       PERFORM SKAPA-ARTFIL                                                     
       PUT ARTFIL                                                               
    ELSE                                                                        
* OM ARTIKEL SAKNAS PÅ WDL7                                                     
       IF W23170D3                                                              
          ART-IDARTNR               = SLAG-IDARTNR                              
          ART-IDDC                  = SLAG-IDDC                                 
          ART-IDDC-REF              = SLAG-IDDC-REF                             
          ART-KDREFSTA              = SLAG-KDREFSTA                             
          ART-IDREFTAB              = SLAG-IDREFTAB                             
          ART-KVAKS-SDC             = SLAG-KVAKS-SDC                            
          ART-KVAKS-PAV             = SLAG-KVAKS-PAV                            
          ART-KVLS                  = SLAG-KVLS                                 
          ART-KVOKS                 = SLAG-KVOKS-DAG + SLAG-KVOKS-BULK          
          ART-KVPB-REF              = SLAG-KVPB-REF                             
          ART-KVREFBER              = SLAG-KVREFBER                             
          ART-KVREFOVL              = SLAG-KVREFOVL                             
          ART-KVREFPKT              = SLAG-KVREFPKT                             
          PERFORM NOLLSTALL-KVOI                                                
          PUT ARTFIL                                                            
       END-IF                                                                   
    END-IF                                                                      
 END-IF                                                                         
                                                                                
SKAPA-ARTFIL. PROC                                                              
                                                                                
 INDX                       = 1                                                 
 DO WHILE INDX             LT 54                                                
    ART-KVOI-RULL(INDX)     = DC-KVOI-RULL(INDX)                                
    ART-KVOT-RULL(INDX)     = DC-KVOT-RULL(INDX)                                
    ART-KVOT-CDC-RULL(INDX) = DC-KVOT-CDC-RULL(INDX)                            
    INDX                    = INDX + 1                                          
 END-DO                                                                         
                                                                                
 INDX                       = 1                                                 
 DO WHILE INDX             LT 6                                                 
    ART-TIVV(INDX)           = DC-TIVV(INDX)                                    
    ART-KVOT-INNEV(INDX)     = DC-KVOT-INNEV(INDX)            +                 
                             + DC-KVOT-PP-INNEV(INDX)                           
    ART-KVOT-CDC-INNEV(INDX) = DC-KVOT-CDC-INNEV(INDX)                          
    INDX                    = INDX + 1                                          
 END-DO                                                                         
                                                                                
END-PROC                                                                        
                                                                                
NOLLSTALL-KVOI. PROC                                                            
                                                                                
 INDX                       = 1                                                 
 DO WHILE INDX             LT 54                                                
    ART-KVOI-RULL(INDX)     = 0                                                 
    ART-KVOT-RULL(INDX)     = 0                                                 
    ART-KVOT-CDC-RULL(INDX) = 0                                                 
    INDX                    = INDX + 1                                          
 END-DO                                                                         
                                                                                
 INDX                       = 1                                                 
 DO WHILE INDX             LT 6                                                 
    ART-TIVV(INDX)           = 0                                                
    ART-KVOT-INNEV(INDX)     = 0                                                
    ART-KVOT-CDC-INNEV(INDX) = 0                                                
    INDX                    = INDX + 1                                          
 END-DO                                                                         
                                                                                
END-PROC                                                                        
* STEG 3. SKAPAR TEMPFIL FRÅN W27120 MED AKTUELLT SDC                           
JOB INPUT(W23170D1)                                                             
                                                                                
     SDC-IDDC     = IN-IDDC                                                     
     SDC-IDARTNR  = IN-IDARTNR                                                  
     SDC-PRARTSTD = IN-PRARTSTD                                                 
     SDC-KDFREKKL = IN-KDFREKKL                                                 
     SDC-KDPRISKL = IN-KDPRISKL                                                 
     PUT SDC                                                                    
* STEG 4. MATCHAR ARTFIL (NEDLÄST WDK7/WDL7) MED                                
*         MED SDCFIL (URVAL FRÅN W27120 AKTUELLT SDC)                           
                                                                                
JOB INPUT(SDC KEY (SDC-IDDC SDC-IDARTNR) +                                      
          ARTFIL KEY (ART-IDDC ART-IDARTNR))                                    
                                                                                
 IF MATCHED                                                                     
    UT-KDFREKKL = SDC-KDFREKKL                                                  
    UT-KDPRISKL = SDC-KDPRISKL                                                  
    UT-PRARTSTD = SDC-PRARTSTD                                                  
    PERFORM SKAPA-UTFIL                                                         
    PUT W23170D5                                                                
 ELSE                                                                           
* OM ARTIKEL SAKNAS PÅ W27120                                                   
    IF ARTFIL                                                                   
       UT-KDFREKKL = ' '                                                        
       UT-KDPRISKL = ' '                                                        
       UT-PRARTSTD = 0                                                          
       PERFORM SKAPA-UTFIL                                                      
       PUT W23170D5                                                             
    END-IF                                                                      
 END-IF                                                                         
                                                                                
SKAPA-UTFIL. PROC                                                               
                                                                                
 UT-IDDC                  = ART-IDDC                                            
 UT-IDDC-REF              = ART-IDDC-REF                                        
 UT-IDARTNR               = ART-IDARTNR                                         
 UT-IDREFTAB              = ART-IDREFTAB                                        
 UT-KDREFSTA              = ART-KDREFSTA                                        
 UT-KVAKS-SDC             = ART-KVAKS-SDC                                       
 UT-KVAKS-PAV             = ART-KVAKS-PAV                                       
 UT-KVLS                  = ART-KVLS                                            
 UT-KVOKS                 = ART-KVOKS                                           
 UT-KVPB-REF              = ART-KVPB-REF                                        
 UT-KVREFBER              = ART-KVREFBER                                        
 UT-KVREFOVL              = ART-KVREFOVL                                        
 UT-KVREFPKT              = ART-KVREFPKT                                        
                                                                                
 INDX                       = 1                                                 
 DO WHILE INDX             LT 54                                                
    UT-KVOI-RULL(INDX)      = ART-KVOI-RULL(INDX)                               
    UT-KVOT-RULL(INDX)      = ART-KVOT-RULL(INDX)                               
    UT-KVOT-CDC-RULL(INDX)  = ART-KVOT-CDC-RULL(INDX)                           
    INDX                    = INDX + 1                                          
 END-DO                                                                         
                                                                                
 INDX                       = 1                                                 
 DO WHILE INDX             LT 6                                                 
    UT-TIVV(INDX)           = ART-TIVV(INDX)                                    
    UT-KVOT-INNEV(INDX)     = ART-KVOT-INNEV(INDX)                              
    UT-KVOT-CDC-INNEV(INDX) = ART-KVOT-CDC-INNEV(INDX)                          
    INDX                    = INDX + 1                                          
 END-DO                                                                         
                                                                                
END-PROC                                                                        
                                                                                
