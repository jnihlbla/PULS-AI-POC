%W61145  'IN1-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W61147D2                                                                   
*                                                                               
%W01160    'IN2-'                                                               
                                                                                
NEWPAGE                                                                         
FILE W61147D3  PRINTER FB (121 0)                                               
                                                                                
NEWPAGE                                                                         
WS-IDARTNR      W            5       P  MASK 'ZZZZZZZZZ' VALUE 0                
WS-NEWKVQPACK-3 W            4       P  MASK 'ZZZZZZ9'   VALUE 0                
WS-OLDKVQPACK-3 W            4       P  MASK 'ZZZZZZ9'   VALUE 0                
WS-OMR          W            2       P  MASK 'ZZ9'       VALUE 0                
WS-GANG         W            2       P  MASK 'ZZZ'       VALUE 0                
WS-PLATS        W            3       P  MASK 'ZZZZZ'     VALUE 0                
WS-KVLS-CD      W            7       N  MASK '------9'   VALUE 0                
*                                                                               
* STEG 1. MATCHAR INFIL FRÅN W6114500 OCH LAGERBANDET                           
*         OCH SKRIVER UT NY OCH GAMMAL HEMTAGNINGSKVANT                         
*                                                                               
JOB INPUT (W61147D2 KEY (IN2-CLAG-IDARTNR) +                                    
           W61147D1 KEY (IN1-IDARTNR))                                          
IF MATCHED                                                                      
  WS-IDARTNR      = IN1-IDARTNR                                                 
  WS-NEWKVQPACK-3 = IN1-KVQPACK-3                                               
  WS-OLDKVQPACK-3 = IN2-CLAG-KVQPACK-3                                          
  WS-OMR          = IN1-ADLAGOMR-CD                                             
  WS-GANG         = IN1-ADGANG-CD                                               
  WS-PLATS        = IN1-ADPLATS-CD                                              
  WS-KVLS-CD      = IN1-KVLS-CD                                                 
  PRINT W61147-001                                                              
END-IF                                                                          
                                                                                
                                                                                
NEWPAGE                                                                         
REPORT W61147-001 PRINTER W61147D3 LINESIZE 120 DTLCTL EVERY +                  
       NOADJUST NOHEADING TITLESKIP 2 PAGESIZE 41 SPACE 2                       
                                                                                
SEQUENCE WS-OMR WS-IDARTNR                                                      
CONTROL FINAL NOPRINT WS-OMR NEWPAGE NOPRINT                                    
                                                                                
TITLE 1  '                  +                                                   
                                 VCCS W61147-001 LO:' WS-OMR                    
TITLE 2  '                         +                                            
          HEMTAGNINGSKVANTER STÄMMER EJ ÖVERENS MED CD-SALDO'                   
TITLE 3  COL 4  'ARTIKELNUMMER'           +                                     
         COL 22 'NY HEMTAGNINGSKVANT'     +                                     
         COL 46 'GAMMAL HEMTAGNINGSKVANT' +                                     
         COL 74 'LAGEROMRÅDE - CD'        +                                     
         COL 95 'LAGERSALDO - CD'                                               
                                                                                
LINE  1  COL 4  WS-IDARTNR      +                                               
         COL 22 WS-NEWKVQPACK-3 +                                               
         COL 46 WS-OLDKVQPACK-3 +                                               
         COL 74 WS-OMR          +                                               
         COL 78 WS-GANG         +                                               
