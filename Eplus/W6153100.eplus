                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6153100                                              *        
*                                                                      *        
*  FUNKTION   :  LÄSER WDE4-EXTRAKT-FIL FÖR ATT TA FRAM PLOCKSTATISTIK *        
*                                                                      *        
*  FÖRFATTARE :  JOHAN LINDKVIST                                       *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
*--------------------------*                                                    
* IN/UT FILER              *                                                    
*--------------------------*                                                    
FILE W61531D1                                                                   
*                                                                               
%WXTRA0  'IN-'                                                                  
                                                                                
FILE W61531D2 FB(17 0)                                                          
*                                                                               
%W61531  'UT-'                                                                  
                                                                                
*************************************                                           
NEWPAGE                                                                         
*                                                                               
* STEG 1. LÄSER FIL                                                             
*                                                                               
JOB INPUT (W61531D1)                                                            
                                                                                
                                                                                
  IF IN-IDDC = '11'                                                             
    IF IN-ADLAGOMR = 25 26 80                                                   
     GOTO JOB                                                                   
    ELSE                                                                        
      UT-IDARTNR   = IN-IDARTNR                                                 
      UT-IDDC      = IN-IDDC                                                    
      UT-ADLAGOMR  = IN-ADLAGOMR                                                
      UT-TIPACKN   = IN-TIPACKN                                                 
      UT-KVLEVART  = IN-KVLEVART                                                
      PUT W61531D2                                                              
    END-IF                                                                      
  END-IF                                                                        
