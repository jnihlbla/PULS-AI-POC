                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5129200                                             *         
*                                                                      *        
*  FUNKTION   :  CREATE SALES REPORT FOR NON VCCS                      *        
*                                                                      *        
*  FÖRFATTARE :  MAMATHA SHETTY                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W51292D1                                                                   
IN1-IDFINDOC          3   7  A                                                  
IN1-DAFINDOC          10  8  A                                                  
IN1-IDARTNR-FINANCE-8 18 8 N                                                    
IN1-IDARTNR-FINANCE-7 18 7 N                                                    
IN1-IDARTNR-FINANCE-6 18 6 N                                                    
IN1-IDARTNR-FINANCE-5 18 5 N                                                    
IN1-IDARTNR-FINANCE-4 18 4 N                                                    
IN1-IDARTNR-FINANCE-3 18 3 N                                                    
IN1-IDARTNR-FINANCE-2 18 2 N                                                    
IN1-IDARTNR-FINANCE-1 18 1 N                                                    
IN1-IDARTNR-FINANCE1  18 1 A                                                    
IN1-IDARTNR-FINANCE2  19 1 A                                                    
IN1-IDARTNR-FINANCE3  20 1 A                                                    
IN1-IDARTNR-FINANCE4  21 1 A                                                    
IN1-IDARTNR-FINANCE5  22 1 A                                                    
IN1-IDARTNR-FINANCE6  23 1 A                                                    
IN1-IDARTNR-FINANCE7  24 1 A                                                    
IN1-IDARTNR-FINANCE8  25 1 A                                                    
IN1-BEART             68  25  A                                                 
IN1-KVLEVART          94  6  N                                                  
IN1-VKARTNTO          100 8  A                                                  
IN1-IDSTATNR          109 8  A                                                  
IN1-IDLEGSEL          117 4  A                                                  
IN1-IDREF             121  15  A                                                
                                                                                
                                                                                
FILE TPFIL1 VB (100 0)                                                          
TP1-IDFINDOC           1   7  A                                                 
TP1-DAFINDOC           8   8  A                                                 
TP1-IDARTNR-FINANCE   16 5 P 0                                                  
TP1-BEART             21  25  A                                                 
TP1-KVLEVART          46  6  N                                                  
TP1-VKARTNTO          52  8  A                                                  
TP1-IDSTATNR          60  8  A                                                  
TP1-IDLEGSEL          69  4  A                                                  
TP1-IDREF             73  15  A                                                 
                                                                                
*                                                                               
FILE W51292D2                                                                   
%W01160  'IN2-'                                                                 
*                                                                               
FILE TPFIL2 VB (205 0)                                                          
TP2-IDFINDOC           +1    7  A                                               
TP2-DAFINDOC           +9    8  A                                               
TP2-IDARTNR-FINANCE    +18 9 N                                                  
TP2-BEART              +28  25  A                                               
TP2-KVLEVART           +54   6  N                                               
TP2-VKARTNTO           +61   8  A                                               
TP2-IDSTATNR           +70   8  A                                               
TP2-KDPRODSL           +79   3  A                                               
TP2-IDFKNGRP           +83   5  A                                               
TP2-VLARTNTO-N         +89   8  N                                               
TP2-VLARTNTO-D         +98   1  N                                               
TP2-IDLEGSEL           +100  4  A                                               
TP2-IDREF              +104 15  A                                               
TP2-SEM            W   1 A  VALUE ';'                                           
*                                                                               
FILE TPFIL3 VB (205 0)                                                          
TP3-IDFINDOC           +1    7  A                                               
TP3-DAFINDOC           +9    8  A                                               
TP3-IDARTNR-FINANCE    +18 9 N                                                  
TP3-BEART              +28  25  A                                               
TP3-KVLEVART           +54   6  N                                               
TP3-VKARTNTO           +61   8  A                                               
TP3-IDSTATNR           +70   8  A                                               
TP3-KDPRODSL           +79   3  A                                               
TP3-IDFKNGRP           +83   5  A                                               
TP3-VLARTNTO-N         +89   8  N                                               
TP3-VLARTNTO-D         +98   1  N                                               
TP3-IDLEGSEL           +100  4  A                                               
TP3-IDREF              +104 15  A                                               
TP3-SEM            W   1 A  VALUE ';'                                           
*                                                                               
*                                                                               
NEWPAGE                                                                         
FILE W51292D3 PRINTER VB (205 0)                                                
                                                                                
*----------------------------------------------------------------------*        
UT-A                      W 205 A                                               
UT-IDFINDOC          UT-A  +1    7  A                                           
UT-DAFINDOC          UT-A  +9    8  A                                           
UT-IDARTNR-FINANCE UT-A +18 9 N                                                 
UT-BEART             UT-A  +28  25  A                                           
UT-KVLEVART          UT-A  +54   6  N                                           
UT-VKARTNTO          UT-A  +61   8  A                                           
UT-IDSTATNR          UT-A  +70   8  A                                           
UT-KDPRODSL          UT-A  +79   3  A                                           
UT-IDFKNGRP          UT-A  +83   5  A                                           
UT-VLARTNTO-N        UT-A  +89   8  N                                           
UT-VLARTNTO-D        UT-A  +98   1  N                                           
UT-IDLEGSEL          UT-A  +100  4  A                                           
UT-IDREF             UT-A  +104 15  A                                           
UT-SEM                  W   1 A  VALUE ';'                                      
*                                                                               
W-VLARTNTO-FMT                  W  9  N 1                                       
W-VLART-N       W-VLARTNTO-FMT     8  N                                         
W-VLART-D       W-VLARTNTO-FMT +8  1  N                                         
*                                                                               
*                                                                               
NEWPAGE                                                                         
*----------------------------------------------------------------------*        
*WORKING STORAGE                                                                
*----------------------------------------------------------------------*        
FIRST-LINE           S  1 A  VALUE 'J'                                          
UT-SEM1              W   1 A  VALUE '.'                                         
W-PREV-IDLEGSEL      W   4  A                                                   
W-IDARTNR-FINANCE    W  9 N VALUE 0                                             
W-IDFINDOC           W  7 A VALUE ' '                                           
W-KVLEVART           W  6 N VALUE 0                                             
W-IDLEGSEL           W  4 A                                                     
WS-KVLEVART          W  6 N                                                     
FIRST-LINE3          S  1 A VALUE 'J'                                           
*----------------------------------------------------------------------*        
* STEP1 : TO CONVERT PART NO FETCHED FROM ARCHIVE TABLE FROM  ALPHA             
*         TO PACKED                                                             
*----------------------------------------------------------------------*        
JOB INPUT W51292D1                                                              
 TP1-IDFINDOC = IN1-IDFINDOC                                                    
 TP1-DAFINDOC = IN1-DAFINDOC                                                    
 IF IN1-IDARTNR-FINANCE2 = ' '                                                  
   W-IDARTNR-FINANCE = IN1-IDARTNR-FINANCE-1                                    
 ELSE                                                                           
   IF IN1-IDARTNR-FINANCE3 = ' '                                                
    W-IDARTNR-FINANCE = IN1-IDARTNR-FINANCE-2                                   
   ELSE                                                                         
     IF IN1-IDARTNR-FINANCE4 = ' '                                              
      W-IDARTNR-FINANCE = IN1-IDARTNR-FINANCE-3                                 
     ELSE                                                                       
      IF IN1-IDARTNR-FINANCE5 = ' '                                             
       W-IDARTNR-FINANCE = IN1-IDARTNR-FINANCE-4                                
      ELSE                                                                      
       IF IN1-IDARTNR-FINANCE6 = ' '                                            
        W-IDARTNR-FINANCE = IN1-IDARTNR-FINANCE-5                               
       ELSE                                                                     
        IF IN1-IDARTNR-FINANCE7 = ' '                                           
         W-IDARTNR-FINANCE = IN1-IDARTNR-FINANCE-6                              
        ELSE                                                                    
         IF IN1-IDARTNR-FINANCE8 = ' '                                          
          W-IDARTNR-FINANCE = IN1-IDARTNR-FINANCE-7                             
         ELSE                                                                   
          W-IDARTNR-FINANCE = IN1-IDARTNR-FINANCE-8                             
         END-IF                                                                 
        END-IF                                                                  
       END-IF                                                                   
      END-IF                                                                    
     END-IF                                                                     
   END-IF                                                                       
 END-IF                                                                         
 TP1-IDARTNR-FINANCE = W-IDARTNR-FINANCE                                        
 TP1-BEART  =  IN1-BEART                                                        
 TP1-KVLEVART = IN1-KVLEVART                                                    
 TP1-VKARTNTO = IN1-VKARTNTO                                                    
 TP1-IDSTATNR = IN1-IDSTATNR                                                    
 TP1-IDLEGSEL = IN1-IDLEGSEL                                                    
 TP1-IDREF  =  IN1-IDREF                                                        
 PUT TPFIL1                                                                     
*                                                                               
*----------------------------------------------------------------------*        
*STEP2 : MATCH W51292D2 AND TPFIL1 BASED ON  PART NUMBER  AND SELECT            
*        PRODUCT GRP,FUNCTION GRP,COMMODITY CODE FROM W51292D2 FILE             
*----------------------------------------------------------------------*        
SORT TPFIL1 TO TPFIL1 USING (TP1-IDARTNR-FINANCE) SIZE 9000000                  
SORT W51292D2 TO W51292D2 USING (IN2-CLAG-IDARTNR) SIZE 9000000                 
*                                                                               
JOB INPUT (W51292D2 KEY(IN2-CLAG-IDARTNR)+                                      
           TPFIL1 KEY(TP1-IDARTNR-FINANCE))                                     
IF MATCHED                                                                      
   TP2-IDFINDOC         = TP1-IDFINDOC                                          
   TP2-DAFINDOC         = TP1-DAFINDOC                                          
   TP2-IDARTNR-FINANCE = TP1-IDARTNR-FINANCE                                    
   TP2-BEART            = TP1-BEART                                             
   TP2-KVLEVART         = TP1-KVLEVART                                          
   TP2-VKARTNTO         = TP1-VKARTNTO                                          
   TP2-IDSTATNR         = TP1-IDSTATNR                                          
   TP2-KDPRODSL         = IN2-CLAG-KDPRODSL                                     
   TP2-IDFKNGRP         = IN2-CLAG-IDFKNGRP                                     
   W-VLARTNTO-FMT       = IN2-CLAG-VLARTNTO                                     
   TP2-VLARTNTO-N       = W-VLART-N                                             
   TP2-VLARTNTO-D       = W-VLART-D                                             
   TP2-IDLEGSEL         = TP1-IDLEGSEL                                          
   TP2-IDREF            = TP1-IDREF                                             
   PUT TPFIL2                                                                   
  END-IF                                                                        
*----------------------------------------------------------------------*        
*STEP3 : REMOVE DUPLICATE PART NOS AND SUM THE QTY OF THEM                      
*----------------------------------------------------------------------*        
JOB INPUT (TPFIL2 KEY(TP2-IDFINDOC  TP2-IDARTNR-FINANCE))                       
   W-KVLEVART            = W-KVLEVART + TP2-KVLEVART                            
   IF LAST-DUP TPFIL2  OR NOT DUPLICATE TPFIL2                                  
   TP3-IDFINDOC            = TP2-IDFINDOC                                       
   TP3-DAFINDOC            = TP2-DAFINDOC                                       
   TP3-IDARTNR-FINANCE     = TP2-IDARTNR-FINANCE                                
   TP3-BEART               = TP2-BEART                                          
   TP3-KVLEVART            = W-KVLEVART                                         
   TP3-VKARTNTO            = TP2-VKARTNTO                                       
   TP3-IDSTATNR            = TP2-IDSTATNR                                       
   TP3-KDPRODSL            = TP2-KDPRODSL                                       
   TP3-IDFKNGRP            = TP2-IDFKNGRP                                       
   W-VLARTNTO-FMT          = W-VLARTNTO-FMT                                     
   TP3-VLARTNTO-N          = TP2-VLARTNTO-N                                     
   TP3-VLARTNTO-D          = TP2-VLARTNTO-D                                     
   TP3-IDLEGSEL            = TP2-IDLEGSEL                                       
   TP3-IDREF               = TP2-IDREF                                          
   PUT TPFIL3                                                                   
   W-KVLEVART =   0                                                             
   END-IF                                                                       
*                                                                               
*----------------------------------------------------------------------*        
*STEP4 : TO SORT TEMP FILE3 BASED ON LEGAL SELLER                               
*----------------------------------------------------------------------*        
SORT TPFIL3 TO TPFIL3 USING (TP3-IDLEGSEL)                                      
*                                                                               
JOB INPUT  TPFIL3                                                               
   UT-IDFINDOC             = TP3-IDFINDOC                                       
   UT-DAFINDOC             = TP3-DAFINDOC                                       
   UT-IDARTNR-FINANCE = TP3-IDARTNR-FINANCE                                     
   UT-BEART                = TP3-BEART                                          
   UT-KVLEVART             = TP3-KVLEVART                                       
   UT-VKARTNTO             = TP3-VKARTNTO                                       
   UT-IDSTATNR             = TP3-IDSTATNR                                       
   UT-KDPRODSL             = TP3-KDPRODSL                                       
   UT-IDFKNGRP             = TP3-IDFKNGRP                                       
   W-VLARTNTO-FMT          = W-VLARTNTO-FMT                                     
   UT-VLARTNTO-N           = TP3-VLARTNTO-N                                     
   UT-VLARTNTO-D           = TP3-VLARTNTO-D                                     
   W-IDLEGSEL              = TP3-IDLEGSEL                                       
   UT-IDLEGSEL             = W-IDLEGSEL                                         
   UT-IDREF                = TP3-IDREF                                          
    PRINT REPORT01                                                              
   A-INIT. PROC                                                                 
     W-PREV-IDLEGSEL = '    '                                                   
   END-PROC                                                                     
                                                                                
*                                                                               
 NEWPAGE                                                                        
    REPORT   REPORT01             +                                             
             PRINTER W51292D3     +                                             
             PAGESIZE 32000       +                                             
             LINESIZE 200         +                                             
             SPACE 0              +                                             
             NOHEADING            +                                             
             NOSPREAD             +                                             
             NOADJUST             +                                             
             NOPAGE               +                                             
             NODATE                                                             
                                                                                
                                                                                
    LINE     UT-IDFINDOC          +                                             
             UT-SEM               +                                             
             UT-DAFINDOC          +                                             
             UT-SEM               +                                             
             UT-IDARTNR-FINANCE +                                               
             UT-SEM               +                                             
             UT-BEART             +                                             
             UT-SEM               +                                             
             UT-KVLEVART          +                                             
             UT-SEM               +                                             
             UT-VKARTNTO          +                                             
             UT-SEM               +                                             
             UT-VLARTNTO-N        +                                             
             UT-SEM1             +                                              
             UT-VLARTNTO-D        +                                             
             UT-SEM               +                                             
             UT-IDSTATNR          +                                             
             UT-SEM +                                                           
             UT-KDPRODSL          +                                             
             UT-SEM               +                                             
             UT-IDFKNGRP          +                                             
             UT-SEM                                                             
*                                                                               
BEFORE-LINE. PROC                                                               
  IF W-IDLEGSEL NE W-PREV-IDLEGSEL                                              
   DISPLAY '¤DAPW51292-001'                                                     
   DISPLAY '¤DAP' W-IDLEGSEL                                                    
   DISPLAY 'INVOICE NO;INVOICE DATE;PART NO;PART DESC;'  +                      
           'QUANTITY;PART WEIGHT;PART VOLUME;STATISTIC NO;'     +               
           'PRODUCT GROUP;FUNCTION GROUP'                                       
     W-PREV-IDLEGSEL = W-IDLEGSEL                                               
  END-IF                                                                        
END-PROC                                                                        
*                                                                               
