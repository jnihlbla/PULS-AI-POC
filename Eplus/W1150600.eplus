*----------------------------------------------------------------------*        
FILE W11506D1                                                                   
*                                                                               
%W1150501    'SYS-'                                                             
*                                                                               
 W-SEQUENCE-ETT  SYS-001-SEQUENCE-GRP       10  A                               
 W-SEQUENCE-TVÅ  SYS-001-SEQUENCE-GRP  +10  10  A                               
 W-SEQUENCE-TRE  SYS-001-SEQUENCE-GRP  +20  10  A                               
 W-SEQUENCE-FYR  SYS-001-SEQUENCE-GRP  +30  10  A                               
**************************************************************                  
FILE W11506D2                                                                   
*                                                                               
%W1150601    'IN-'                                                              
*                                                                               
 W-SEQUENCE-1   IN-SEQUENCE-GRP        10   A                                   
 W-SEQUENCE-2   IN-SEQUENCE-GRP  +10   10   A                                   
 W-SEQUENCE-3   IN-SEQUENCE-GRP  +20   10   A                                   
 W-SEQUENCE-4   IN-SEQUENCE-GRP  +30   10   A                                   
*                                                                               
 W-IDDISTR      IN-IDDISTR              3   P                                   
 W-IDFKNGRP     IN-IDFKNGRP             3   P                                   
*                                                                               
   W-ARTNR      IN-IDARTNR              5   P                                   
   W-STRECK     IN-STRECK               1   A                                   
   W-REKSIFFR   IN-REKSIFFR             1   A                                   
*                                                                               
 W-KDPRODSL     IN-KDPRODSL             2   P                                   
*                                                                               
 W-PRIS-AKTUELL-ART IN-PRIS-AKTUELL-ART 5   P MASK 'ZZZZZZ9.99'                 
 W-SUM-AKTUELL-ART  IN-SUM-AKTUELL-ART  6   P MASK 'ZZZZZZZZ9.99'               
 W-KDBPSR       IN-KDBPSR               1   P                                   
 W-TISTOMREG    IN-TISTOMREG            4   P                                   
 W-KVBASLMD     IN-KVBASLMD             4   P                                   
 W-KVBASLKIT    IN-KVBASLKIT            4   P                                   
 W-KVBASLM          IN-KVBASLM          4   P                                   
 W-TIFINLV          IN-TIFINLV          3   P                                   
 W-IDARTNR-MOTSV    IN-IDARTNR-MOTSV    5   P                                   
 W-M-STRECK         IN-M-STRECK         1   A                                   
 W-REKS-MOTSV       IN-REKS-MOTSV       1   N                                   
 W-PRARTBTO-EXP-CP  IN-PRARTBTO-EXP-CP  5   P MASK 'ZZZZZZ9.99'                 
*********************************************************                       
*----------ARBETS-FÄLT----------------------------------                        
 WS-STRECK                               W  110  A                              
 WS-KDPRODSL-NUM                         W   3   N                              
 WS-KDPRODSL                             W   3   A                              
 RAK-PRIS-ARTIKEL-FINNS                  W   1   P 0 VALUE 0                    
 RAK-PRIS-ARTIKEL-SAKNAS                 W   1   P 0 VALUE 0                    
FILE W11506D3  PRINTER                                                          
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
*-------------*                                                                 
* JOB         *                                                                 
*-------------*                                                                 
*                                                                               
JOB INPUT(W11506D2) START A-LAS-SYSKORT                                         
*                                                                               
        IF (W11506D2)                                                           
           IF   IN-PRIS-AKTUELL-ART > +0                                        
             RAK-PRIS-ARTIKEL-FINNS = 1                                         
             RAK-PRIS-ARTIKEL-SAKNAS = 0                                        
           ELSE                                                                 
             RAK-PRIS-ARTIKEL-SAKNAS = 1                                        
             RAK-PRIS-ARTIKEL-FINNS =  0                                        
           END-IF                                                               
        END-IF                                                                  
                                                                                
        PRINT RAPPORT01                                                         
*                                                                               
                                                                                
A-LAS-SYSKORT. PROC                                                             
*                                                                               
  MOVE '-' TO WS-STRECK FILL '-'                                                
  GET W11506D1                                                                  
    IF SYS-001-KDPRODSL = 0                                                     
      WS-KDPRODSL = 'ALL'                                                       
    ELSE                                                                        
      MOVE SYS-001-KDPRODSL TO WS-KDPRODSL                                      
    END-IF                                                                      
*                                                                               
    DISPLAY W11506D3 NEWPAGE +                                                  
    '********************************************************+                  
     ************************************************'                          
    DISPLAY W11506D3   +                                                        
    '*                                                       +                  
     Ÿ                                              *'                          
    DISPLAY W11506D3   +                                                        
    '*                              B A S I C   S T O C K   +                   
     L I S T                                         *'                         
    DISPLAY W11506D3   +                                                        
    '*                                                       +                  
     Ÿ                                              *'                          
    DISPLAY W11506D3   +                                                        
    '********************************************************+                  
     ************************************************'                          
    DISPLAY W11506D3 SKIP 1  +                                                  
    ' FOLLOWING DATA CONFIRMS YOUR SELECTIONS +                                 
      FROM PICTURE  0 7 9 1 '                                                   
    DISPLAY W11506D3 SKIP 2  +                                                  
    ' DATE : ' SYSDATE       ' TIME(SWEDISH) : ' SYSTIME                        
    IF SYS-001-KDBASLM = '46AUS'                                                
      DISPLAY W11506D3 COL 22 +                                                 
      'PLEASE DISTRIBUTE TO: -------> !   GREG HOKIN              +             
       Ÿ           !'                                                           
      DISPLAY W11506D3 COL 22 +                                                 
      '                               !   VOLVO AUSTRALIA PTY LTD,+             
       Ÿ           !'                                                           
      DISPLAY W11506D3 COL 22 +                                                 
      '                               !   P O BOX 480,            +             
       Ÿ           !'                                                           
      DISPLAY W11506D3 COL 22 +                                                 
      '                               !   CAMPBELL TOWN NSW 2560  +             
       Ÿ           !'                                                           
      DISPLAY W11506D3 SKIP 1  +                                                
    '                        MARKET . . . . . . . ' SYS-001-KDBASLM             
    ELSE                                                                        
      DISPLAY W11506D3 SKIP 4  +                                                
    '                        MARKET . . . . . . . ' SYS-001-KDBASLM             
    END-IF                                                                      
    DISPLAY W11506D3 SKIP 1  +                                                  
    '                        PROJECT. . . . . . . ' SYS-001-IDPROJ              
    DISPLAY W11506D3 SKIP 1  +                                                  
    '                        SELECTED PROD.GRP. . ' WS-KDPRODSL                 
    DISPLAY W11506D3 SKIP 1  +                                                  
    '                        FUNCGRP. . . .(MIN): ' +                           
     SYS-001-IDFKNGRP-1        ' (MAX): ' SYS-001-IDFKNGRP-2                    
    DISPLAY W11506D3 SKIP 1  +                                                  
    '                        DISTRICT . . . . . . ' SYS-001-IDDISTR             
    DISPLAY W11506D3 SKIP 1  +                                                  
    '                        SR. . . . . . (MIN): ' SYS-001-KDBPSR-1 +          
    '    (MAX): ' SYS-001-KDBPSR-2                                              
    DISPLAY W11506D3 SKIP 1  +                                                  
    '                        LANG.CODE. . . . . . ' SYS-001-IDSKYLT             
    DISPLAY W11506D3 SKIP 1  +                                                  
    '                        MARK.QTY . . . . . . ' SYS-001-MARK-QTY            
    DISPLAY W11506D3 SKIP 1  +                                                  
    '                        MARK.NOT . . . . . . ' SYS-001-MARK-NOT            
    DISPLAY W11506D3 SKIP 1  +                                                  
    '                        DEALCODE . . . . . . ' SYS-001-KDDEALER            
*--LAST-DATE                                                                    
    IF W-SEQUENCE-ETT = 'TISTOMREG '                                            
       W-SEQUENCE-ETT = 'LAST-DATE '                                            
    END-IF                                                                      
    IF W-SEQUENCE-TVÅ = 'TISTOMREG '                                            
       W-SEQUENCE-TVÅ = 'LAST-DATE '                                            
    END-IF                                                                      
    IF W-SEQUENCE-TRE = 'TISTOMREG '                                            
       W-SEQUENCE-TRE = 'LAST-DATE '                                            
    END-IF                                                                      
    IF W-SEQUENCE-FYR = 'TISTOMREG '                                            
       W-SEQUENCE-FYR = 'LAST-DATE '                                            
    END-IF                                                                      
*--PARTNO                                                                       
    IF W-SEQUENCE-ETT = 'IDARTNR   '                                            
       W-SEQUENCE-ETT = 'PARTNO    '                                            
    END-IF                                                                      
    IF W-SEQUENCE-TVÅ = 'IDARTNR   '                                            
       W-SEQUENCE-TVÅ = 'PARTNO    '                                            
    END-IF                                                                      
    IF W-SEQUENCE-TRE = 'IDARTNR   '                                            
       W-SEQUENCE-TRE = 'PARTNO    '                                            
    END-IF                                                                      
    IF W-SEQUENCE-FYR = 'IDARTNR   '                                            
       W-SEQUENCE-FYR = 'PARTNO    '                                            
    END-IF                                                                      
*--FUNC.GRP                                                                     
    IF W-SEQUENCE-ETT = 'IDFKNGRP  '                                            
       W-SEQUENCE-ETT = 'FUNC.GRP  '                                            
    END-IF                                                                      
    IF W-SEQUENCE-TVÅ = 'IDFKNGRP  '                                            
       W-SEQUENCE-TVÅ = 'FUNC.GRP  '                                            
    END-IF                                                                      
    IF W-SEQUENCE-TRE = 'IDFKNGRP  '                                            
       W-SEQUENCE-TRE = 'FUNC.GRP  '                                            
    END-IF                                                                      
    IF W-SEQUENCE-FYR = 'IDFKNGRP  '                                            
       W-SEQUENCE-FYR = 'FUNC.GRP  '                                            
    END-IF                                                                      
*--PROD.SL                                                                      
    IF W-SEQUENCE-ETT = 'KDPRODSL  '                                            
       W-SEQUENCE-ETT = 'PROD.GRP  '                                            
    END-IF                                                                      
    IF W-SEQUENCE-TVÅ = 'KDPRODSL  '                                            
       W-SEQUENCE-TVÅ = 'PROD.GRP  '                                            
    END-IF                                                                      
    IF W-SEQUENCE-TRE = 'KDPRODSL  '                                            
       W-SEQUENCE-TRE = 'PROD.GRP  '                                            
    END-IF                                                                      
    IF W-SEQUENCE-FYR = 'KDPRODSL  '                                            
       W-SEQUENCE-FYR = 'PROD.GRP  '                                            
    END-IF                                                                      
*--                                                                             
    DISPLAY W11506D3 SKIP 1  +                                                  
    '                        SORTING SEQUENCE  1: '   W-SEQUENCE-ETT            
    DISPLAY W11506D3 SKIP 1  +                                                  
    '                                          2: '   W-SEQUENCE-TVÅ            
    DISPLAY W11506D3 SKIP 1  +                                                  
    '                                          3: '   W-SEQUENCE-TRE            
    DISPLAY W11506D3 SKIP 1  +                                                  
    '                                          4: '   W-SEQUENCE-FYR            
END-PROC                                                                        
                                                                                
*-------------*                                                                 
* REPORT      *                                                                 
*-------------*                                                                 
*                                                                               
  REPORT RAPPORT01 PRINTER W11506D3 LINESIZE 121  +                             
                   NODATE                         +                             
                   NOADJUST                       +                             
                   NOHEADING                                                    
                                                                                
    SEQUENCE        W-IDDISTR    +                                              
                    W-SEQUENCE-1 +                                              
                    W-SEQUENCE-2 +                                              
                    W-SEQUENCE-3 +                                              
                    W-SEQUENCE-4                                                
                                                                                
    CONTROL         FINAL      NOPRINT    +                                     
                    W-IDDISTR  NEWPAGE    +                                     
                               NOPRINT                                          
                    SUM          IN-SUM-AKTUELL-ART +                           
                                 RAK-PRIS-ARTIKEL-FINNS +                       
                                 RAK-PRIS-ARTIKEL-SAKNAS                        
    TITLE 1  ' '                                                                
                                                                                
    TITLE 2 COL 2 'W11506-001 VOLVO CAR AFTERSALES'   +                         
            COL 34 'TOTAL PARTS RANGE'                +                         
            COL 52 '/ PROJECT'   COL 62  IN-IDPROJ      +                       
            COL 67 '/ MARKET'    COL 76  IN-KDBASLM +                           
            COL 83 '/ DISTRICT'  COL 94   W-IDDISTR     +                       
            COL 99 '/'  COL 101 'DATE: '  COL 107 SYSDATE                       
                                                                                
    TITLE 4 COL 02 'FUNC '        +                                             
            COL 08 'PROD'         +                                             
            COL 14 'PART.NO '     +                                             
            COL 25 'DESCRIPTION'  +                                             
            COL 52 'SR'           +                                             
            COL 57 'LAST '        +                                             
            COL 70 'QTY '         +                                             
            COL 80 'QTY '         +                                             
            COL 90 'QTY'          +                                             
            COL 97 'INTROD'       +                                             
            COL 109 'DEALER'                                                    
                                                                                
    TITLE 5 COL 02 'GRP. '        +                                             
            COL 08 'GRP.'         +                                             
            COL 57 'DATE'         +                                             
            COL 70 'DKT'          +                                             
            COL 80 'IMP'          +                                             
            COL 90 'MKT'          +                                             
            COL 97 'WEEK'         +                                             
            COL 109 'CODE'                                                      
                                                                                
    TITLE 6 COL 14 'FOB.GROSS'    +                                             
            COL 44 'VARIANT-NOTE' +                                             
            COL 89 'COMPARE'      +                                             
            COL 99 '  COMPARE'                                                  
                                                                                
    TITLE 7 COL 44 'REMARKS'      +                                             
            COL 89 'PART.NO'      +                                             
            COL 99 'FOB.GROSS'                                                  
                                                                                
    LINE 1  COL 1   W-IDFKNGRP    +                                             
            COL 8   W-KDPRODSL    +                                             
            COL 12  W-ARTNR       +                                             
            COL 21  W-STRECK      +                                             
            COL 22  W-REKSIFFR    +                                             
            COL 25 IN-BEART       +                                             
            COL 52  W-KDBPSR      +                                             
            COL 56  W-TISTOMREG   +                                             
            COL 66  W-KVBASLKIT   +                                             
            COL 76  W-KVBASLMD    +                                             
            COL 86  W-KVBASLM     +                                             
            COL 97  W-TIFINLV     +                                             
            COL 109 IN-KDDEALER                                                 
                                                                                
                                                                                
    LINE 2  COL 11  W-PRIS-AKTUELL-ART     +                                    
            COL 44 IN-TEARTNOT                                                  
                                                                                
    LINE 3  COL  3 'SUM : '                +                                    
            COL  9 W-SUM-AKTUELL-ART       +                                    
            COL 44 IN-TEARTNOT-BASL        +                                    
            COL 85 W-IDARTNR-MOTSV         +                                    
            COL 94 W-M-STRECK              +                                    
            COL 95 W-REKS-MOTSV            +                                    
            COL 98 W-PRARTBTO-EXP-CP                                            
***********        COL 130 RAK-PRIS-ARTIKEL-FINNS                               
***********        COL 133 RAK-PRIS-ARTIKEL-SAKNAS                              
    LINE 4  COL 1   WS-STRECK                                                   
                                                                                
    BEFORE-BREAK                                                                
    PROC                                                                        
    IF LEVEL = 1                                                                
                                                                                
    ELSE                                                                        
        DISPLAY NEWPAGE COL 1    ' '                                            
        DISPLAY SKIP 1 COL 50 '*** SUM  PARTS  WITH  A PRICE : ' +              
                                      RAK-PRIS-ARTIKEL-FINNS                    
        DISPLAY SKIP 1 COL 50 '*** SUM PARTS WITHOUT A PRICE : ' +              
                                      RAK-PRIS-ARTIKEL-SAKNAS                   
        DISPLAY SKIP 1 COL  1   ' '                                             
        DISPLAY SKIP 1 COL 50 '*** TOT SUM GROSS SALES PRICE : ' +              
                                         IN-SUM-AKTUELL-ART                     
    END-IF                                                                      
    END-PROC                                                                    
