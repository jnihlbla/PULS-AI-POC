        END-DO                                                                  
     ELSE                                                                       
                                                                                
*** SKAPAR FÖRSÄTTSBLAD OM URVAL TILL A2-LISTA KOMMER FRÅN BILD                 
*** 3203                                                                        
                                                                                
                                                                                
        IF W-IDGTYP = 0                                                         
           MOVE '*** URVALET SAKNAR RESULTAT ***' TO         +                  
                W-A2-RESULTAT-SAKNAS                                            
        ELSE                                                                    
           MOVE '                               ' TO         +                  
                W-A2-RESULTAT-SAKNAS                                            
        END-IF                                                                  
                                                                                
        MOVE 'ARTIKEL       ' TO W-A2-URVALTYP                                  
        W-IDUSER          = URVAL03-IDUSER                                      
        W-REGDAT          = URVAL03-DAREGDAT                                    
        W-REGTID          = URVAL03-TIREGTID                                    
        W-IDFSGURV        = URVAL03-IDFSGURV                                    
                                                                                
        W-A2-IDPTYP = URVAL03-IDPTYP                                            
                                                                                
                                                                                
        W-IDKONCNR01      = URVAL03-IDKONCNR(1)                                 
        W-IDKONCNR02      = URVAL03-IDKONCNR(2)                                 
        W-IDKONCNR02      = URVAL03-IDKONCNR(2)                                 
        W-IDKONCNR03      = URVAL03-IDKONCNR(3)                                 
        W-IDKONCNR04      = URVAL03-IDKONCNR(4)                                 
        W-IDKONCNR05      = URVAL03-IDKONCNR(5)                                 
        W-IDKONCNR06      = URVAL03-IDKONCNR(6)                                 
        W-IDKONCNR07      = URVAL03-IDKONCNR(7)                                 
        W-IDKONCNR08      = URVAL03-IDKONCNR(8)                                 
                                                                                
        W-MARKNADS-GRP    = URVAL03-MARKNADS-GRP(1)                             
        W-KDMARK-BUDG01-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG01-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP    = URVAL03-MARKNADS-GRP(2)                             
        W-KDMARK-BUDG02-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG02-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP    = URVAL03-MARKNADS-GRP(3)                             
        W-KDMARK-BUDG03-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG03-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP    = URVAL03-MARKNADS-GRP(4)                             
        W-KDMARK-BUDG04-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG04-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP    = URVAL03-MARKNADS-GRP(5)                             
        W-KDMARK-BUDG05-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG05-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP    = URVAL03-MARKNADS-GRP(6)                             
        W-KDMARK-BUDG06-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG06-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP    = URVAL03-MARKNADS-GRP(7)                             
        W-KDMARK-BUDG07-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG07-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP    = URVAL03-MARKNADS-GRP(8)                             
        W-KDMARK-BUDG08-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG08-T = W-KDMARK-BUDG-TOM                                   
                                                                                
        W-DISTRIKT-GRP    = URVAL03-DISTRIKT-GRP(1)                             
        W-IDDISTR01-F     = W-IDDISTR-FOM                                       
        W-IDDISTR01-T     = W-IDDISTR-TOM                                       
        W-DISTRIKT-GRP    = URVAL03-DISTRIKT-GRP(2)                             
        W-IDDISTR02-F     = W-IDDISTR-FOM                                       
        W-IDDISTR02-T     = W-IDDISTR-TOM                                       
        W-DISTRIKT-GRP    = URVAL03-DISTRIKT-GRP(3)                             
        W-IDDISTR03-F     = W-IDDISTR-FOM                                       
        W-IDDISTR03-T     = W-IDDISTR-TOM                                       
        W-DISTRIKT-GRP    = URVAL03-DISTRIKT-GRP(4)                             
        W-IDDISTR04-F     = W-IDDISTR-FOM                                       
        W-IDDISTR04-T     = W-IDDISTR-TOM                                       
                                                                                
                                                                                
        W-SOEK-IX = 1                                                           
        DO WHILE URVAL03-IDARTNR(W-SOEK-IX) NE W-TOMT-IDARTNR                   
           W-SOEK-IX      = W-SOEK-IX + 1                                       
        END-DO                                                                  
        MOVE W-SOEK-IX TO W-MAX-ARTNR-IX                                        
                                                                                
        W-ARTNR-IX = 1                                                          
        DO WHILE W-ARTNR-IX < W-MAX-ARTNR-IX                                    
           W-IDARTNR01    = URVAL03-IDARTNR(W-ARTNR-IX)                         
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR02    = URVAL03-IDARTNR(W-ARTNR-IX)                         
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR03    = URVAL03-IDARTNR(W-ARTNR-IX)                         
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR04    = URVAL03-IDARTNR(W-ARTNR-IX)                         
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR05    = URVAL03-IDARTNR(W-ARTNR-IX)                         
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR06    = URVAL03-IDARTNR(W-ARTNR-IX)                         
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR07    = URVAL03-IDARTNR(W-ARTNR-IX)                         
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR08    = URVAL03-IDARTNR(W-ARTNR-IX)                         
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR09    = URVAL03-IDARTNR(W-ARTNR-IX)                         
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR10    = URVAL03-IDARTNR(W-ARTNR-IX)                         
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           PRINT RAPPORT03                                                      
        END-DO                                                                  
     END-IF                                                                     
  ELSE                                                                          
                                                                                
*** SKAPAR RESULTATSIDOR                                                        
                                                                                
                                                                                
     MOVE SPACE           TO W-A2-OMRADE                                        
     W-REGDAT             = RES-DAREGDAT                                        
     W-REGTID             = RES-TIREGTID                                        
     W-A2-IDARTNR         = RES-IDARTNR                                         
     W-BRYT-IDARTNR       = RES-IDARTNR                                         
     W-A2-BEART-SVE       = RES-BEART-SVE                                       
     W-A2-KDPRODSL        = RES-KDPRODSL                                        
     W-A2-BEPRODSL        = RES-BEPRODSL                                        
     W-A2-IDKONCNR-U      = RES-IDKONCNR                                        
     W-A2-IDDISTR-U       = RES-IDDISTR                                         
                                                                                
     IF W-URVAL-IDGTYP = 1                                                      
        MOVE 'DISTRIKT'        TO W-A2-OMRTYP                                   
        W-A2-IDDISTR-U4        = W-A2-IDDISTR-U                                 
        MOVE W-A2-IDDISTR-U4   TO W-A2-OMRADE                                   
     END-IF                                                                     
     IF W-URVAL-IDGTYP = 2                                                      
        MOVE 'KONCERN '        TO W-A2-OMRTYP                                   
        MOVE W-A2-IDKONCNR-U   TO W-A2-OMRADE                                   
     END-IF                                                                     
     IF W-URVAL-IDGTYP = 3                                                      
        MOVE 'MARKNAD '        TO W-A2-OMRTYP                                   
        W-A2-OMRADE            = RES-BEMARK-BUDG                                
     END-IF                                                                     
     IF W-URVAL-IDGTYP = 4                                                      
        MOVE  SPACE            TO W-A2-OMRADE                                   
        MOVE SPACE             TO W-A2-OMRTYP                                   
     END-IF                                                                     
                                                                                
     W-A2-SUARTFSG-PER     = (RES-SUARTFSG-PER + 500) / 1000                    
     W-A2-SUARTFSG-AAR     = (RES-SUARTFSG-AAR + 500) / 1000                    
     W-A2-SUARTFSG-RAAR    = (RES-SUARTFSG-RAAR + 500) / 1000                   
     W-A2-REFSG-AAR        = RES-REFSG-AAR                                      
     W-A2-REFSG-RAAR       = RES-REFSG-RAAR                                     
     W-A2-SULEVANT-PER     = RES-SULEVANT-PER                                   
     W-A2-SULEVANT-RAAR    = RES-SULEVANT-RAAR                                  
     W-A2-RELEVANT-RAAR    = RES-RELEVANT-RAAR                                  
     W-A2-SUTOTBV-PER      = (RES-SUTOTBV-PER  + 500) / 1000                    
     W-A2-SUTOTBV-RAAR     = (RES-SUTOTBV-RAAR + 500) / 1000                    
     W-A2-RETOTBV-RAAR-TB  = RES-RETOTBV-RAAR-TB                                
     W-A2-RETOTBV-PER      = RES-RETOTBV-PER                                    
     W-A2-RETOTBV-AAR      = RES-RETOTBV-AAR                                    
     W-A2-RETOTBV-RAAR     = RES-RETOTBV-RAAR                                   
     W-A2-RETOTBV-RAAR-TG  = RES-RETOTBV-RAAR-TG                                
                                                                                
*                                                                               
     PRINT RAPPORT-A2                                                           
  END-IF                                                                        
                                                                                
                                                                                
INIT-PROC. PROC                                                                 
                                                                                
W-SOEK-IX             = 0                                                       
W-ARTNR-IX            = 0                                                       
W-MAX-ARTNR-IX        = 0                                                       
W-TOMT-IDARTNR        = 0                                                       
