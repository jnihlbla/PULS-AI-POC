            COL 072 W-A2-KDPRODSL                            +                  
            COL 078 W-A2-BEPRODSL                            +                  
            COL 108 'TID'                                    +                  
            COL 114 W-REGTID                                                    
                                                             +                  
    TITLE 6 COL 021 'AF5'                                    +                  
            COL 028 'AF4'                                    +                  
            COL 035 'AF2'                                    +                  
            COL 040 'AF4'                                    +                  
            COL 046 'AF2'                                    +                  
            COL 056 'AF5'                                    +                  
            COL 065 'AF2'                                    +                  
            COL 070 'AF2'                                    +                  
            COL 079 'AF5'                                    +                  
            COL 086 'AF2'                                    +                  
            COL 091 'AF2'                                    +                  
            COL 098 'AF5'                                    +                  
            COL 104 'AF4'                                    +                  
            COL 110 'AF2'                                    +                  
            COL 117 'AF2'                                                       
                                                                                
    TITLE 7 COL 040 'AF3'                                    +                  
            COL 046 'AF1'                                    +                  
            COL 070 'AF1'                                    +                  
            COL 080 'TB'                                     +                  
            COL 087 'TB'                                     +                  
            COL 091 'AF1'                                    +                  
            COL 117 'AF1'                                                       
                                                                                
    TITLE 8 COL 004 W-A2-OMRTYP                              +                  
            COL 021 'TKR'                                    +                  
            COL 028 'TKR'                                    +                  
            COL 035 'TKR'                                    +                  
            COL 041 'KR'                                     +                  
            COL 047 'KR'                                     +                  
            COL 057 'ST'                                     +                  
            COL 066 'ST'                                     +                  
            COL 071 'ST'                                     +                  
            COL 079 'TKR'                                    +                  
            COL 086 'TKR'                                    +                  
            COL 092 'TB'                                     +                  
            COL 099 'TG'                                     +                  
            COL 105 'TG'                                     +                  
            COL 111 'TG'                                     +                  
            COL 118 'TG'                                                        
                                                                                
*&                                                                              
    LINE 1   COL 004 W-A2-OMRADE                             +                  
             COL 017 W-A2-SUARTFSG-PER                       +                  
             COL 024 W-A2-SUARTFSG-AAR                       +                  
             COL 031 W-A2-SUARTFSG-RAAR                      +                  
             COL 039 W-A2-REFSG-AAR                          +                  
             COL 045 W-A2-REFSG-RAAR                         +                  
             COL 050 W-A2-SULEVANT-PER                       +                  
             COL 059 W-A2-SULEVANT-RAAR                      +                  
             COL 069 W-A2-RELEVANT-RAAR                      +                  
             COL 075 W-A2-SUTOTBV-PER                        +                  
             COL 082 W-A2-SUTOTBV-RAAR                       +                  
             COL 090 W-A2-RETOTBV-RAAR-TB                    +                  
             COL 097 W-A2-RETOTBV-PER                        +                  
             COL 103 W-A2-RETOTBV-AAR                        +                  
             COL 109 W-A2-RETOTBV-RAAR                       +                  
             COL 116 W-A2-RETOTBV-RAAR-TG                                       
                                                                                
                                                                                
AFTER-LINE. PROC                                                                
* EN RÄKNARE FÖR ATT KUNNA BRYTA VID TIO SKRIVNA RADER                          
*----------------------------------------------------                           
   IF W-TIO-RADER = 10                                                          
         DISPLAY ' '                                                            
         W-TIO-RADER = 1                                                        
   ELSE                                                                         
      W-TIO-RADER = W-TIO-RADER + 1                                             
   END-IF                                                                       
END-PROC                                                                        
                                                                                
                                                                                
*** RÄKNA UT TÄCKNINGSBIDRAG MM TILL ARTIKELSUMMA-RAD                           
BEFORE-BREAK. PROC                                                              
*--------------------------------------------------------                       
    IF LEVEL = 1                                                                
                                                                                
*1                                                                              
*      *****AF2 TB                                                              
                                                                                
       ARTSUM-SUTOTBV-RAAR =                                 +                  
       RES-SUARTFSG-RAAR - RES-SUARTSJK-RAAR                                    
                                                                                
*2                                                                              
*      *****AF5 TB                                                              
                                                                                
       ARTSUM-SUTOTBV-PER =                                  +                  
       RES-SUARTFSG-PER - RES-SUARTSJK-PER                                      
                                                                                
*3                                                                              
*      *****AF2/AF1 TB                                                          
                                                                                
       RES-TEMP =                                            +                  
       RES-SUARTFSG-FRAAR - RES-SUARTSJK-FRAAR                                  
       IF RES-TEMP      NE 0                                                    
          ARTSUM-RETOTBV-RAAR-TB =                            +                 
          100 * (((RES-SUARTFSG-RAAR - RES-SUARTSJK-RAAR) -   +                 
          (RES-SUARTFSG-FRAAR - RES-SUARTSJK-FRAAR)) /        +                 
          (RES-SUARTFSG-FRAAR - RES-SUARTSJK-FRAAR))                            
       ELSE                                                                     
          MOVE ZEROES TO ARTSUM-RETOTBV-RAAR-TB                                 
       END-IF                                                                   
       RES-TEMP =  0                                                            
                                                                                
*4                                                                              
*      *****AF1 TG                                                              
                                                                                
       IF RES-SUARTFSG-FRAAR NE 0                                               
          ARTSUM-RETOTBV-FRAAR =                             +                  
          100 * ((RES-SUARTFSG-FRAAR - RES-SUARTSJK-FRAAR) / +                  
          RES-SUARTFSG-FRAAR)                                                   
       ELSE                                                                     
          MOVE ZEROES TO ARTSUM-RETOTBV-FRAAR                                   
       END-IF                                                                   
                                                                                
*5                                                                              
*      *****AF2 TG                                                              
                                                                                
       IF RES-SUARTFSG-RAAR NE 0                                                
          ARTSUM-RETOTBV-RAAR =                              +                  
          100 * ((RES-SUARTFSG-RAAR - RES-SUARTSJK-RAAR) /   +                  
          RES-SUARTFSG-RAAR)                                                    
       ELSE                                                                     
          MOVE ZEROES TO ARTSUM-RETOTBV-RAAR                                    
       END-IF                                                                   
                                                                                
*6                                                                              
*      *****AF4 TG                                                              
                                                                                
       IF RES-SUARTFSG-AAR NE 0                                                 
          ARTSUM-RETOTBV-AAR =                               +                  
          100 * ((RES-SUARTFSG-AAR - RES-SUARTSJK-AAR) /     +                  
          RES-SUARTFSG-AAR)                                                     
       ELSE                                                                     
          MOVE ZEROES TO ARTSUM-RETOTBV-AAR                                     
       END-IF                                                                   
                                                                                
*7                                                                              
*      *****AF5 TG                                                              
                                                                                
       IF RES-SUARTFSG-PER NE 0                                                 
          ARTSUM-RETOTBV-PER =                               +                  
          100 * ((RES-SUARTFSG-PER - RES-SUARTSJK-PER) /     +                  
          RES-SUARTFSG-PER)                                                     
       ELSE                                                                     
          MOVE ZEROES TO ARTSUM-RETOTBV-PER                                     
       END-IF                                                                   
                                                                                
*8                                                                              
*      *****AF2/AF1 TG                                                          
                                                                                
       ARTSUM-RETOTBV-RAAR-TG =                              +                  
       ARTSUM-RETOTBV-RAAR - ARTSUM-RETOTBV-FRAAR                               
                                                                                
*9                                                                              
*      *****AVV SEK AF4/AF3                                                     
                                                                                
       IF RES-SUARTFSG-FAAR NE 0                                                
          ARTSUM-REFSG-AAR =                                 +                  
          100 * ((RES-SUARTFSG-AAR - RES-SUARTFSG-FAAR) /    +                  
          RES-SUARTFSG-FAAR)                                                    
       ELSE                                                                     
          MOVE ZEROES TO ARTSUM-REFSG-AAR                                       
       END-IF                                                                   
                                                                                
                                                                                
*10                                                                             
*      *****AVV SEK AF4/AF3                                                     
                                                                                
       IF RES-SUARTFSG-FRAAR NE 0                                               
          ARTSUM-REFSG-RAAR =                                +                  
          100 * ((RES-SUARTFSG-RAAR - RES-SUARTFSG-FRAAR) /  +                  
          RES-SUARTFSG-FRAAR)                                                   
       ELSE                                                                     
          MOVE ZEROES TO ARTSUM-REFSG-RAAR                                      
       END-IF                                                                   
                                                                                
*11                                                                             
*      *****AVV STYCK AF4/AF3                                                   
                                                                                
       IF RES-SULEVANT-FRAAR NE 0                                               
          ARTSUM-RELEVANT-RAAR =                             +                  
          100 * ((RES-SULEVANT-RAAR - RES-SULEVANT-FRAAR) /  +                  
          RES-SULEVANT-FRAAR)                                                   
       ELSE                                                                     
          MOVE ZEROES TO ARTSUM-RELEVANT-RAAR                                   
       END-IF                                                                   
                                                                                
*** AVRUNDNING AV UTRÄKNINGAR                                                   
                                                                                
       IF ARTSUM-SUTOTBV-RAAR > 0                                               
          ARTSUM-SUTOTBV-RAAR =                              +                  
          ARTSUM-SUTOTBV-RAAR + 0.05                                            
       ELSE                                                                     
         IF ARTSUM-SUTOTBV-RAAR < 0                                             
            ARTSUM-SUTOTBV-RAAR =                            +                  
            ARTSUM-SUTOTBV-RAAR - 0.05                                          
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF ARTSUM-SUTOTBV-PER > 0                                                
          ARTSUM-SUTOTBV-PER =                               +                  
          ARTSUM-SUTOTBV-PER + 0.05                                             
       ELSE                                                                     
         IF ARTSUM-SUTOTBV-PER < 0                                              
            ARTSUM-SUTOTBV-PER =                             +                  
            ARTSUM-SUTOTBV-PER - 0.05                                           
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF ARTSUM-RETOTBV-RAAR-TB > 0                                            
          ARTSUM-RETOTBV-RAAR-TB =                           +                  
          ARTSUM-RETOTBV-RAAR-TB + 0.05                                         
       ELSE                                                                     
         IF ARTSUM-RETOTBV-RAAR-TB < 0                                          
            ARTSUM-RETOTBV-RAAR-TB =                         +                  
            ARTSUM-RETOTBV-RAAR-TB - 0.05                                       
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF ARTSUM-RETOTBV-PER > 0                                                
          ARTSUM-RETOTBV-PER =                               +                  
          ARTSUM-RETOTBV-PER + 0.05                                             
       ELSE                                                                     
         IF ARTSUM-RETOTBV-PER < 0                                              
            ARTSUM-RETOTBV-PER =                             +                  
            ARTSUM-RETOTBV-PER - 0.05                                           
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF ARTSUM-RETOTBV-AAR > 0                                                
          ARTSUM-RETOTBV-AAR =                               +                  
          ARTSUM-RETOTBV-AAR + 0.05                                             
       ELSE                                                                     
         IF ARTSUM-RETOTBV-AAR < 0                                              
            ARTSUM-RETOTBV-AAR =                             +                  
            ARTSUM-RETOTBV-AAR - 0.05                                           
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF ARTSUM-RETOTBV-RAAR > 0                                               
          ARTSUM-RETOTBV-RAAR =                              +                  
          ARTSUM-RETOTBV-RAAR + 0.05                                            
       ELSE                                                                     
         IF ARTSUM-RETOTBV-RAAR < 0                                             
            ARTSUM-RETOTBV-RAAR =                            +                  
            ARTSUM-RETOTBV-RAAR - 0.05                                          
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF ARTSUM-RETOTBV-FRAAR > 0                                              
          ARTSUM-RETOTBV-FRAAR =                             +                  
          ARTSUM-RETOTBV-FRAAR + 0.05                                           
       ELSE                                                                     
         IF ARTSUM-RETOTBV-FRAAR < 0                                            
            ARTSUM-RETOTBV-FRAAR =                           +                  
            ARTSUM-RETOTBV-FRAAR - 0.05                                         
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF ARTSUM-RETOTBV-RAAR-TG > 0                                            
          ARTSUM-RETOTBV-RAAR-TG =                           +                  
          ARTSUM-RETOTBV-RAAR-TG + 0.05                                         
       ELSE                                                                     
         IF ARTSUM-RETOTBV-RAAR-TG < 0                                          
            ARTSUM-RETOTBV-RAAR-TG =                         +                  
            ARTSUM-RETOTBV-RAAR-TG - 0.05                                       
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF ARTSUM-REFSG-AAR > 0                                                  
          ARTSUM-REFSG-AAR =                                 +                  
          ARTSUM-REFSG-AAR + 0.05                                               
       ELSE                                                                     
         IF ARTSUM-REFSG-AAR < 0                                                
            ARTSUM-REFSG-AAR =                               +                  
            ARTSUM-REFSG-AAR - 0.05                                             
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF ARTSUM-REFSG-RAAR > 0                                                 
          ARTSUM-REFSG-RAAR =                                +                  
          ARTSUM-REFSG-RAAR + 0.05                                              
       ELSE                                                                     
         IF ARTSUM-REFSG-RAAR < 0                                               
            ARTSUM-REFSG-RAAR =                              +                  
            ARTSUM-REFSG-RAAR - 0.05                                            
         END-IF                                                                 
       END-IF                                                                   
       IF ARTSUM-RELEVANT-RAAR > 0                                              
          ARTSUM-RELEVANT-RAAR =                             +                  
          ARTSUM-RELEVANT-RAAR + 0.05                                           
       ELSE                                                                     
         IF ARTSUM-RELEVANT-RAAR < 0                                            
            ARTSUM-RELEVANT-RAAR =                           +                  
            ARTSUM-RELEVANT-RAAR - 0.05                                         
         END-IF                                                                 
       END-IF                                                                   
                                                                                
***     SAMLA UTRÄKNADE SUMMOR PÅ ARTIKELNIVÅ TILL                              
***     UTRÄKNINGAR PÅ URVALSNIVÅ                                               
                                                                                
        ARTSPAR-SULEVANT-PER  =                              +                  
        ARTSPAR-SULEVANT-PER  + RES-SULEVANT-PER                                
                                                                                
        ARTSPAR-SULEVANT-RAAR =                              +                  
        ARTSPAR-SULEVANT-RAAR + RES-SULEVANT-RAAR                               
                                                                                
        ARTSPAR-SULEVANT-FRAAR =                             +                  
        ARTSPAR-SULEVANT-FRAAR + RES-SULEVANT-FRAAR                             
                                                                                
        ARTSPAR-SUARTFSG-PER =                               +                  
        ARTSPAR-SUARTFSG-PER + RES-SUARTFSG-PER                                 
                                                                                
        ARTSPAR-SUARTFSG-AAR =                               +                  
        ARTSPAR-SUARTFSG-AAR + RES-SUARTFSG-AAR                                 
                                                                                
        ARTSPAR-SUARTFSG-FAAR =                              +                  
        ARTSPAR-SUARTFSG-FAAR + RES-SUARTFSG-FAAR                               
                                                                                
        ARTSPAR-SUARTFSG-RAAR =                              +                  
        ARTSPAR-SUARTFSG-RAAR + RES-SUARTFSG-RAAR                               
                                                                                
        ARTSPAR-SUARTFSG-FRAAR =                             +                  
        ARTSPAR-SUARTFSG-FRAAR + RES-SUARTFSG-FRAAR                             
                                                                                
        ARTSPAR-SUARTSJK-PER =                               +                  
        ARTSPAR-SUARTSJK-PER + RES-SUARTSJK-PER                                 
                                                                                
        ARTSPAR-SUARTSJK-AAR =                               +                  
        ARTSPAR-SUARTSJK-AAR + RES-SUARTSJK-AAR                                 
                                                                                
        ARTSPAR-SUARTSJK-RAAR =                              +                  
        ARTSPAR-SUARTSJK-RAAR + RES-SUARTSJK-RAAR                               
                                                                                
        ARTSPAR-SUARTSJK-FAAR =                              +                  
        ARTSPAR-SUARTSJK-FAAR + RES-SUARTSJK-FAAR                               
                                                                                
        ARTSPAR-SUARTSJK-FRAAR =                             +                  
        ARTSPAR-SUARTSJK-FRAAR + RES-SUARTSJK-FRAAR                             
                                                                                
                                                                                
*       FLYTTA TILL LISTA, VÄRDEN STÖRRE ÄN 99.9  OCH                           
*       VÄRDEN MINDRE ÄN -99.9 GÖRS OM TILL 99.9 RESP                           
*       -99.9.                                                                  
                                                                                
                                                                                
        W-A2-ARTSUM-SUARTFSG-PER = (RES-SUARTFSG-PER + 500)  +                  
                                    / 1000                                      
        W-A2-ARTSUM-SUARTFSG-AAR = (RES-SUARTFSG-AAR + 500)  +                  
                                    / 1000                                      
        W-A2-ARTSUM-SUARTFSG-RAAR = (RES-SUARTFSG-RAAR + 500) +                 
                                     / 1000                                     
                                                                                
       IF ARTSUM-REFSG-AAR > 99.9                                               
          W-A2-ARTSUM-REFSG-AAR = 99.9                                          
       ELSE                                                                     
         IF ARTSUM-REFSG-AAR < -99.9                                            
            W-A2-ARTSUM-REFSG-AAR = -99.9                                       
         ELSE                                                                   
            W-A2-ARTSUM-REFSG-AAR = ARTSUM-REFSG-AAR                            
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF ARTSUM-REFSG-RAAR > 99.9                                              
          W-A2-ARTSUM-REFSG-RAAR = 99.9                                         
       ELSE                                                                     
         IF ARTSUM-REFSG-RAAR < -99.9                                           
            W-A2-ARTSUM-REFSG-RAAR = -99.9                                      
         ELSE                                                                   
            W-A2-ARTSUM-REFSG-RAAR = ARTSUM-REFSG-RAAR                          
         END-IF                                                                 
       END-IF                                                                   
                                                                                
        W-A2-ARTSUM-SULEVANT-PER    = RES-SULEVANT-PER                          
        W-A2-ARTSUM-SULEVANT-RAAR   = RES-SULEVANT-RAAR                         
                                                                                
        IF ARTSUM-RELEVANT-RAAR > 99.9                                          
           W-A2-ARTSUM-RELEVANT-RAAR = 99.9                                     
        ELSE                                                                    
          IF ARTSUM-RELEVANT-RAAR < -99.9                                       
             W-A2-ARTSUM-RELEVANT-RAAR = -99.9                                  
          ELSE                                                                  
             W-A2-ARTSUM-RELEVANT-RAAR = ARTSUM-RELEVANT-RAAR                   
          END-IF                                                                
        END-IF                                                                  
                                                                                
        W-A2-ARTSUM-SUTOTBV-PER  = (ARTSUM-SUTOTBV-PER + 500) +                 
                                    / 1000                                      
        W-A2-ARTSUM-SUTOTBV-RAAR = (ARTSUM-SUTOTBV-RAAR + 500) +                
                                    / 1000                                      
                                                                                
        IF ARTSUM-RETOTBV-RAAR-TB > 99.9                                        
           W-A2-ARTSUM-RETOTBV-RAAR-TB = 99.9                                   
        ELSE                                                                    
          IF ARTSUM-RETOTBV-RAAR-TB < -99.9                                     
             W-A2-ARTSUM-RETOTBV-RAAR-TB = -99.9                                
          ELSE                                                                  
             W-A2-ARTSUM-RETOTBV-RAAR-TB =                   +                  
             ARTSUM-RETOTBV-RAAR-TB                                             
          END-IF                                                                
        END-IF                                                                  
                                                                                
        IF ARTSUM-RETOTBV-PER > 99.9                                            
           W-A2-ARTSUM-RETOTBV-PER = 99.9                                       
        ELSE                                                                    
          IF ARTSUM-RETOTBV-PER < -99.9                                         
             W-A2-ARTSUM-RETOTBV-PER = -99.9                                    
          ELSE                                                                  
             W-A2-ARTSUM-RETOTBV-PER = ARTSUM-RETOTBV-PER                       
          END-IF                                                                
        END-IF                                                                  
                                                                                
                                                                                
        IF ARTSUM-RETOTBV-AAR > 99.9                                            
           W-A2-ARTSUM-RETOTBV-AAR = 99.9                                       
        ELSE                                                                    
          IF ARTSUM-RETOTBV-AAR < -99.9                                         
             W-A2-ARTSUM-RETOTBV-AAR = -99.9                                    
          ELSE                                                                  
             W-A2-ARTSUM-RETOTBV-AAR = ARTSUM-RETOTBV-AAR                       
          END-IF                                                                
        END-IF                                                                  
                                                                                
        IF ARTSUM-RETOTBV-RAAR > 99.9                                           
           W-A2-ARTSUM-RETOTBV-RAAR = 99.9                                      
        ELSE                                                                    
          IF ARTSUM-RETOTBV-RAAR < -99.9                                        
             W-A2-ARTSUM-RETOTBV-RAAR = -99.9                                   
          ELSE                                                                  
             W-A2-ARTSUM-RETOTBV-RAAR = ARTSUM-RETOTBV-RAAR                     
          END-IF                                                                
        END-IF                                                                  
                                                                                
        IF ARTSUM-RETOTBV-RAAR-TG > 99.9                                        
           W-A2-ARTSUM-RETOTBV-RAAR-TG = 99.9                                   
        ELSE                                                                    
          IF ARTSUM-RETOTBV-RAAR-TG < -99.9                                     
             W-A2-ARTSUM-RETOTBV-RAAR-TG = -99.9                                
          ELSE                                                                  
             W-A2-ARTSUM-RETOTBV-RAAR-TG =                   +                  
             ARTSUM-RETOTBV-RAAR-TG                                             
          END-IF                                                                
        END-IF                                                                  
                                                                                
        DISPLAY '   '                                                           
        DISPLAY '   '                                                           
        DISPLAY  COL 004 'ARTIKEL-TOTAL'                     +                  
                 COL 017 W-A2-ARTSUM-SUARTFSG-PER            +                  
                 COL 024 W-A2-ARTSUM-SUARTFSG-AAR            +                  
                 COL 031 W-A2-ARTSUM-SUARTFSG-RAAR           +                  
                 COL 039 W-A2-ARTSUM-REFSG-AAR               +                  
                 COL 045 W-A2-ARTSUM-REFSG-RAAR              +                  
                 COL 050 W-A2-ARTSUM-SULEVANT-PER            +                  
                 COL 059 W-A2-ARTSUM-SULEVANT-RAAR           +                  
                 COL 069 W-A2-ARTSUM-RELEVANT-RAAR           +                  
                 COL 075 W-A2-ARTSUM-SUTOTBV-PER             +                  
                 COL 082 W-A2-ARTSUM-SUTOTBV-RAAR            +                  
                 COL 090 W-A2-ARTSUM-RETOTBV-RAAR-TB         +                  
                 COL 097 W-A2-ARTSUM-RETOTBV-PER             +                  
                 COL 103 W-A2-ARTSUM-RETOTBV-AAR             +                  
                 COL 109 W-A2-ARTSUM-RETOTBV-RAAR            +                  
                 COL 116 W-A2-ARTSUM-RETOTBV-RAAR-TG                            
                                                                                
                                                                                
        W-TIO-RADER = 1                                                         
    END-IF                                                                      
    IF LEVEL = 2                                                                
                                                                                
***   UTRÄKNINGAR PÅ URVALSNIVÅ                                                 
                                                                                
*1                                                                              
***    AF2 TB                                                                   
                                                                                
       URVSUM-SUTOTBV-RAAR =                                 +                  
       ARTSPAR-SUARTFSG-RAAR - ARTSPAR-SUARTSJK-RAAR                            
                                                                                
*2                                                                              
***    AF5 TB                                                                   
                                                                                
       URVSUM-SUTOTBV-PER =                                  +                  
       ARTSPAR-SUARTFSG-PER - ARTSPAR-SUARTSJK-PER                              
                                                                                
*3                                                                              
***    AF2/AF1 TB                                                               
                                                                                
       ARTSPAR-TEMP =                                        +                  
       ARTSPAR-SUARTFSG-FRAAR - ARTSPAR-SUARTSJK-FRAAR                          
       IF ARTSPAR-TEMP  NE 0                                                    
          URVSUM-RETOTBV-RAAR-TB =  100 *                    +                  
          (((ARTSPAR-SUARTFSG-RAAR - ARTSPAR-SUARTSJK-RAAR) - +                 
          (ARTSPAR-SUARTFSG-FRAAR - ARTSPAR-SUARTSJK-FRAAR)) / +                
          (ARTSPAR-SUARTFSG-FRAAR - ARTSPAR-SUARTSJK-FRAAR))                    
       ELSE                                                                     
          MOVE ZEROES TO URVSUM-RETOTBV-RAAR-TB                                 
       END-IF                                                                   
       ARTSPAR-TEMP = 0                                                         
                                                                                
*4                                                                              
***    AF1 TG                                                                   
                                                                                
       IF ARTSPAR-SUARTFSG-FRAAR NE 0                                           
                                                                                
          URVSUM-RETOTBV-FRAAR = 100 *                         +                
          ((ARTSPAR-SUARTFSG-FRAAR - ARTSPAR-SUARTSJK-FRAAR) / +                
          ARTSPAR-SUARTFSG-FRAAR)                                               
       ELSE                                                                     
          MOVE ZEROES TO URVSUM-RETOTBV-FRAAR                                   
       END-IF                                                                   
                                                                                
*5                                                                              
***    AF2 TG                                                                   
                                                                                
       IF ARTSPAR-SUARTFSG-RAAR NE 0                                            
          URVSUM-RETOTBV-RAAR = 100 *                        +                  
          ((ARTSPAR-SUARTFSG-RAAR - ARTSPAR-SUARTSJK-RAAR) / +                  
          ARTSPAR-SUARTFSG-RAAR)                                                
       ELSE                                                                     
          MOVE ZEROES TO URVSUM-RETOTBV-RAAR                                    
       END-IF                                                                   
                                                                                
*6                                                                              
***    AF4 TG                                                                   
                                                                                
       IF ARTSPAR-SUARTFSG-AAR NE 0                                             
          URVSUM-RETOTBV-AAR = 100 *                         +                  
          ((ARTSPAR-SUARTFSG-AAR - ARTSPAR-SUARTSJK-AAR) /   +                  
          ARTSPAR-SUARTFSG-AAR)                                                 
       ELSE                                                                     
          MOVE ZEROES TO URVSUM-RETOTBV-AAR                                     
       END-IF                                                                   
                                                                                
*7                                                                              
***    AF5 TG                                                                   
                                                                                
       IF ARTSPAR-SUARTFSG-PER NE 0                                             
          URVSUM-RETOTBV-PER = 100 *                         +                  
          ((ARTSPAR-SUARTFSG-PER - ARTSPAR-SUARTSJK-PER) /   +                  
          ARTSPAR-SUARTFSG-PER)                                                 
       ELSE                                                                     
          MOVE ZEROES TO URVSUM-RETOTBV-PER                                     
       END-IF                                                                   
                                                                                
*8                                                                              
***    AF2/AF1 TG                                                               
                                                                                
       URVSUM-RETOTBV-RAAR-TG =                              +                  
       URVSUM-RETOTBV-RAAR - URVSUM-RETOTBV-FRAAR                               
                                                                                
*9                                                                              
***    AVV SEK AF4/AF3                                                          
                                                                                
       IF ARTSPAR-SUARTFSG-FAAR NE 0                                            
          URVSUM-REFSG-AAR = 100 *                           +                  
          ((ARTSPAR-SUARTFSG-AAR - ARTSPAR-SUARTFSG-FAAR) /  +                  
          ARTSPAR-SUARTFSG-FAAR)                                                
       ELSE                                                                     
          MOVE ZEROES TO URVSUM-REFSG-AAR                                       
       END-IF                                                                   
                                                                                
                                                                                
*10                                                                             
***    AVV SEK AF2/AF1                                                          
                                                                                
       IF ARTSPAR-SUARTFSG-FRAAR NE 0                                           
          URVSUM-REFSG-RAAR = 100 *                          +                  
          ((ARTSPAR-SUARTFSG-RAAR - ARTSPAR-SUARTSJK-FRAAR) / +                 
          ARTSPAR-SUARTFSG-FRAAR)                                               
       ELSE                                                                     
          MOVE ZEROES TO URVSUM-REFSG-RAAR                                      
       END-IF                                                                   
                                                                                
*11                                                                             
***    AVV STYCK AF2/AF1                                                        
                                                                                
       IF ARTSPAR-SULEVANT-FRAAR NE 0                                           
          URVSUM-RELEVANT-RAAR = 100 *                       +                  
          ((ARTSPAR-SULEVANT-RAAR - ARTSPAR-SULEVANT-FRAAR) / +                 
          ARTSPAR-SULEVANT-FRAAR)                                               
       ELSE                                                                     
          MOVE ZEROES TO URVSUM-RELEVANT-RAAR                                   
       END-IF                                                                   
                                                                                
*** AVRUNDNING                                                                  
                                                                                
                                                                                
       IF URVSUM-SUTOTBV-RAAR > 0                                               
          URVSUM-SUTOTBV-RAAR =                              +                  
          URVSUM-SUTOTBV-RAAR + 0.05                                            
       ELSE                                                                     
         IF URVSUM-SUTOTBV-RAAR < 0                                             
            URVSUM-SUTOTBV-RAAR =                            +                  
            URVSUM-SUTOTBV-RAAR - 0.05                                          
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF URVSUM-SUTOTBV-PER > 0                                                
          URVSUM-SUTOTBV-PER =                               +                  
          URVSUM-SUTOTBV-PER + 0.05                                             
       ELSE                                                                     
         IF URVSUM-SUTOTBV-PER < 0                                              
            URVSUM-SUTOTBV-PER =                             +                  
            URVSUM-SUTOTBV-PER - 0.05                                           
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF URVSUM-RETOTBV-RAAR-TB > 0                                            
          URVSUM-RETOTBV-RAAR-TB =                           +                  
          URVSUM-RETOTBV-RAAR-TB + 0.05                                         
       ELSE                                                                     
         IF URVSUM-RETOTBV-RAAR-TB < 0                                          
            URVSUM-RETOTBV-RAAR-TB =                         +                  
            URVSUM-RETOTBV-RAAR-TB - 0.05                                       
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF URVSUM-RETOTBV-PER > 0                                                
          URVSUM-RETOTBV-PER =                               +                  
          URVSUM-RETOTBV-PER + 0.05                                             
       ELSE                                                                     
         IF URVSUM-RETOTBV-PER < 0                                              
            URVSUM-RETOTBV-PER =                             +                  
            URVSUM-RETOTBV-PER - 0.05                                           
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF URVSUM-RETOTBV-AAR > 0                                                
          URVSUM-RETOTBV-AAR =                               +                  
          URVSUM-RETOTBV-AAR + 0.05                                             
       ELSE                                                                     
         IF URVSUM-RETOTBV-AAR < 0                                              
            URVSUM-RETOTBV-AAR =                             +                  
            URVSUM-RETOTBV-AAR - 0.05                                           
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF URVSUM-RETOTBV-RAAR > 0                                               
          URVSUM-RETOTBV-RAAR =                              +                  
          URVSUM-RETOTBV-RAAR + 0.05                                            
       ELSE                                                                     
         IF URVSUM-RETOTBV-RAAR < 0                                             
            URVSUM-RETOTBV-RAAR =                            +                  
            URVSUM-RETOTBV-RAAR - 0.05                                          
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF URVSUM-RETOTBV-FRAAR > 0                                              
          URVSUM-RETOTBV-FRAAR =                             +                  
          URVSUM-RETOTBV-FRAAR + 0.05                                           
       ELSE                                                                     
         IF URVSUM-RETOTBV-FRAAR < 0                                            
            URVSUM-RETOTBV-FRAAR =                           +                  
            URVSUM-RETOTBV-FRAAR - 0.05                                         
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF URVSUM-RETOTBV-RAAR-TG > 0                                            
          URVSUM-RETOTBV-RAAR-TG =                           +                  
          URVSUM-RETOTBV-RAAR-TG + 0.05                                         
       ELSE                                                                     
         IF URVSUM-RETOTBV-RAAR-TG < 0                                          
            URVSUM-RETOTBV-RAAR-TG =                         +                  
            URVSUM-RETOTBV-RAAR-TG - 0.05                                       
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF URVSUM-REFSG-AAR > 0                                                  
          URVSUM-REFSG-AAR =                                 +                  
          URVSUM-REFSG-AAR + 0.05                                               
       ELSE                                                                     
         IF URVSUM-REFSG-AAR < 0                                                
            URVSUM-REFSG-AAR =                               +                  
            URVSUM-REFSG-AAR - 0.05                                             
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF URVSUM-REFSG-RAAR > 0                                                 
          URVSUM-REFSG-RAAR =                                +                  
          URVSUM-REFSG-RAAR + 0.05                                              
       ELSE                                                                     
         IF URVSUM-REFSG-RAAR < 0                                               
            URVSUM-REFSG-RAAR =                              +                  
            URVSUM-REFSG-RAAR - 0.05                                            
         END-IF                                                                 
       END-IF                                                                   
       IF URVSUM-RELEVANT-RAAR > 0                                              
          URVSUM-RELEVANT-RAAR =                             +                  
          URVSUM-RELEVANT-RAAR + 0.05                                           
       ELSE                                                                     
         IF URVSUM-RELEVANT-RAAR < 0                                            
            URVSUM-RELEVANT-RAAR =                           +                  
            URVSUM-RELEVANT-RAAR - 0.05                                         
         END-IF                                                                 
       END-IF                                                                   
                                                                                
*       FLYTTA TILL LISTA, VÄRDEN STÖRRE ÄN 99.9  OCH                           
*       VÄRDEN MINDRE ÄN -99.9 GÖRS OM TILL 99.9 RESP                           
*       -99.9.                                                                  
                                                                                
                                                                                
       W-A2-URVSUM-SUARTFSG-PER = (RES-SUARTFSG-PER + 500)   +                  
                                   / 1000                                       
       W-A2-URVSUM-SUARTFSG-AAR = (RES-SUARTFSG-AAR + 500)   +                  
                                   / 1000                                       
       W-A2-URVSUM-SUARTFSG-RAAR = (RES-SUARTFSG-RAAR + 500) +                  
                                    / 1000                                      
                                                                                
       IF URVSUM-REFSG-AAR > 99.9                                               
          W-A2-URVSUM-REFSG-AAR = 99.9                                          
       ELSE                                                                     
         IF URVSUM-REFSG-AAR < -99.9                                            
            W-A2-URVSUM-REFSG-AAR = -99.9                                       
         ELSE                                                                   
            W-A2-URVSUM-REFSG-AAR = URVSUM-REFSG-AAR                            
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF URVSUM-REFSG-RAAR > 99.9                                              
          W-A2-URVSUM-REFSG-RAAR = 99.9                                         
       ELSE                                                                     
         IF URVSUM-REFSG-RAAR < -99.9                                           
            W-A2-URVSUM-REFSG-RAAR = -99.9                                      
         ELSE                                                                   
            W-A2-URVSUM-REFSG-RAAR = URVSUM-REFSG-RAAR                          
         END-IF                                                                 
       END-IF                                                                   
                                                                                
        W-A2-URVSUM-SULEVANT-PER    = RES-SULEVANT-PER                          
        W-A2-URVSUM-SULEVANT-RAAR   = RES-SULEVANT-RAAR                         
                                                                                
        IF URVSUM-RELEVANT-RAAR > 99.9                                          
           W-A2-URVSUM-RELEVANT-RAAR = 99.9                                     
        ELSE                                                                    
          IF URVSUM-RELEVANT-RAAR < -99.9                                       
             W-A2-URVSUM-RELEVANT-RAAR = -99.9                                  
          ELSE                                                                  
             W-A2-URVSUM-RELEVANT-RAAR = URVSUM-RELEVANT-RAAR                   
          END-IF                                                                
        END-IF                                                                  
                                                                                
        W-A2-URVSUM-SUTOTBV-PER = (URVSUM-SUTOTBV-PER + 500) +                  
                                   / 1000                                       
        W-A2-URVSUM-SUTOTBV-RAAR = (URVSUM-SUTOTBV-RAAR + 500) +                
                                   / 1000                                       
                                                                                
        IF URVSUM-RETOTBV-RAAR-TB > 99.9                                        
           W-A2-URVSUM-RETOTBV-RAAR-TB = 99.9                                   
        ELSE                                                                    
          IF URVSUM-RETOTBV-RAAR-TB < -99.9                                     
             W-A2-URVSUM-RETOTBV-RAAR-TB = -99.9                                
          ELSE                                                                  
             W-A2-URVSUM-RETOTBV-RAAR-TB =                   +                  
             URVSUM-RETOTBV-RAAR-TB                                             
          END-IF                                                                
        END-IF                                                                  
                                                                                
        IF URVSUM-RETOTBV-PER > 99.9                                            
           W-A2-URVSUM-RETOTBV-PER = 99.9                                       
        ELSE                                                                    
          IF URVSUM-RETOTBV-PER < -99.9                                         
             W-A2-URVSUM-RETOTBV-PER = -99.9                                    
          ELSE                                                                  
             W-A2-URVSUM-RETOTBV-PER = URVSUM-RETOTBV-PER                       
          END-IF                                                                
        END-IF                                                                  
                                                                                
                                                                                
        IF URVSUM-RETOTBV-AAR > 99.9                                            
           W-A2-URVSUM-RETOTBV-AAR = 99.9                                       
        ELSE                                                                    
          IF URVSUM-RETOTBV-AAR < -99.9                                         
             W-A2-URVSUM-RETOTBV-AAR = -99.9                                    
          ELSE                                                                  
             W-A2-URVSUM-RETOTBV-AAR = URVSUM-RETOTBV-AAR                       
          END-IF                                                                
        END-IF                                                                  
                                                                                
        IF URVSUM-RETOTBV-RAAR > 99.9                                           
           W-A2-URVSUM-RETOTBV-RAAR = 99.9                                      
        ELSE                                                                    
          IF URVSUM-RETOTBV-RAAR < -99.9                                        
             W-A2-URVSUM-RETOTBV-RAAR = -99.9                                   
          ELSE                                                                  
             W-A2-URVSUM-RETOTBV-RAAR = URVSUM-RETOTBV-RAAR                     
          END-IF                                                                
        END-IF                                                                  
                                                                                
        IF URVSUM-RETOTBV-RAAR-TG > 99.9                                        
           W-A2-URVSUM-RETOTBV-RAAR-TG = 99.9                                   
        ELSE                                                                    
          IF URVSUM-RETOTBV-RAAR-TG < -99.9                                     
             W-A2-URVSUM-RETOTBV-RAAR-TG = -99.9                                
          ELSE                                                                  
             W-A2-URVSUM-RETOTBV-RAAR-TG =                   +                  
                        URVSUM-RETOTBV-RAAR-TG                                  
          END-IF                                                                
        END-IF                                                                  
                                                                                
        DISPLAY '   '                                                           
        DISPLAY '   '                                                           
        DISPLAY '   '                                                           
        DISPLAY  COL 004 'URVAL-TOTAL'                       +                  
                 COL 017 W-A2-URVSUM-SUARTFSG-PER            +                  
                 COL 024 W-A2-URVSUM-SUARTFSG-AAR            +                  
                 COL 031 W-A2-URVSUM-SUARTFSG-RAAR           +                  
                 COL 039 W-A2-URVSUM-REFSG-AAR               +                  
                 COL 045 W-A2-URVSUM-REFSG-RAAR              +                  
                 COL 050 W-A2-URVSUM-SULEVANT-PER            +                  
                 COL 059 W-A2-URVSUM-SULEVANT-RAAR           +                  
                 COL 069 W-A2-URVSUM-RELEVANT-RAAR           +                  
                 COL 075 W-A2-URVSUM-SUTOTBV-PER             +                  
                 COL 082 W-A2-URVSUM-SUTOTBV-RAAR            +                  
                 COL 090 W-A2-URVSUM-RETOTBV-RAAR-TB         +                  
                 COL 097 W-A2-URVSUM-RETOTBV-PER             +                  
                 COL 103 W-A2-URVSUM-RETOTBV-AAR             +                  
                 COL 109 W-A2-URVSUM-RETOTBV-RAAR            +                  
                 COL 116 W-A2-URVSUM-RETOTBV-RAAR-TG                            
                                                                                
        ARTSPAR-SULEVANT-PER      = 0                                           
        ARTSPAR-SULEVANT-RAAR     = 0                                           
        ARTSPAR-SULEVANT-FRAAR    = 0                                           
        ARTSPAR-SUARTFSG-PER      = 0                                           
        ARTSPAR-SUARTFSG-AAR      = 0                                           
        ARTSPAR-SUARTFSG-FAAR     = 0                                           
        ARTSPAR-SUARTFSG-RAAR     = 0                                           
        ARTSPAR-SUARTFSG-FRAAR    = 0                                           
        ARTSPAR-SUARTSJK-PER      = 0                                           
        ARTSPAR-SUARTSJK-AAR      = 0                                           
        ARTSPAR-SUARTSJK-RAAR     = 0                                           
        ARTSPAR-SUARTSJK-FAAR     = 0                                           
        ARTSPAR-SUARTSJK-FRAAR    = 0                                           
        URVSUM-REFSG-AAR          = 0                                           
        URVSUM-REFSG-RAAR         = 0                                           
        URVSUM-RELEVANT-RAAR      = 0                                           
        URVSUM-SUTOTBV-PER        = 0                                           
        URVSUM-SUTOTBV-RAAR       = 0                                           
        URVSUM-RETOTBV-RAAR-TB    = 0                                           
        URVSUM-RETOTBV-PER        = 0                                           
        URVSUM-RETOTBV-AAR        = 0                                           
        URVSUM-RETOTBV-RAAR       = 0                                           
        URVSUM-RETOTBV-RAAR-TG    = 0                                           
    END-IF                                                                      
END-PROC                                                                        
