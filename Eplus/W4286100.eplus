NEWPAGE                                                                         
FILE W42861D1                                                                   
                                                                                
*-------------*                                                                 
* COPYTEXT    *                                                                 
*-------------*                                                                 
                                                                                
%W42861A  '61A-'                                                                
%W42861B  '61B-'                                                                
                                                                                
NEWPAGE                                                                         
                                                                                
FILE W42861D2  PRINTER FB(121 121)                                              
                                                                                
NEWPAGE                                                                         
*-------------*                                                                 
* ARBETSAREOR *                                                                 
*-------------*                                                                 
                                                                                
W-IDARTNR           W                    5 P   MASK 'ZZZZZZZZ9'                 
W-BEART             W                   25 A                                    
W-IDDC              W                    2 A                                    
W-IDDISTR           W                    3 P   MASK BWZ                         
W-IDKUNDNR          W                    4 P   MASK BWZ                         
W-KDANMORS          W                    2 A                                    
W-TIAAMMDDF         W                    4 P   MASK 'Z999999'                   
W-TIAAMMDDT         W                    4 P   MASK 'Z999999'                   
                                                                                
KDANMORS            W                    2 A                                    
IDDISTR             W                    3 P   MASK 'ZZZZ9'                     
IDKUNDNR            W                    4 P   MASK 'ZZZZZZ9'                   
KVLEVANM            W                    4 P 0 MASK 'ZZZZZZ9'                   
PRARTBTO            W                    5 P 2 MASK 'ZZZZZZ9.99'                
IDRAPPNR            W                    7 N   MASK (A 'ZZZZZZ9')               
TILEVANM            W                    4 P   MASK 'Z999999'                   
TIRETANK            W                    4 P   MASK 'Z999999'                   
TIINLINL            W                    4 P   MASK 'Z999999'                   
IDKNOTNR            W                    4 P   MASK BWZ                         
TIKNOTA             W                    4 P   MASK 'Z999999'                   
IDFAKT              W                    4 P   MASK BWZ                         
TIFAKT              W                    4 P   MASK 'Z999999'                   
FLDIRLEV            W                    1 A                                    
                                                                                
NEWPAGE                                                                         
                                                                                
PROGRAM-NAMN        W    8    A    VALUE 'W4286100'                             
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*-------------*                                                                 
* JOB         *                                                                 
*-------------*                                                                 
                                                                                
JOB INPUT (W42861D1)                                                            
                                                                                
  IF 61A-SORT-IDPTYP = '61A'                                                    
                                                                                
    W-IDARTNR          = 61A-IDARTNR                                            
    W-BEART            = 61A-BEART                                              
    W-IDDC             = 61A-IDDC                                               
    W-IDDISTR          = 61A-IDDISTR                                            
    W-IDKUNDNR         = 61A-IDKUNDNR                                           
    W-KDANMORS         = 61A-SORT-KDANMORS                                      
    W-TIAAMMDDF        = 61A-TIAAMMDD-FOM                                       
    W-TIAAMMDDT        = 61A-TIAAMMDD-TOM                                       
                                                                                
  ELSE                                                                          
                                                                                
    KDANMORS           = 61B-SORT-KDANMORS                                      
    IDDISTR            = 61B-IDDISTR                                            
    IDKUNDNR           = 61B-IDKUNDNR                                           
    KVLEVANM           = 61B-KVLEVANM                                           
    PRARTBTO           = 61B-PRARTBTO                                           
    IDRAPPNR           = 61B-IDRAPPNR                                           
    TILEVANM           = 61B-SORT-TILEVANM                                      
    TIRETANK           = 61B-SORT-TIRETANK                                      
    TIINLINL           = 61B-TIINLINL                                           
    IDKNOTNR           = 61B-IDKNOTNR                                           
    TIKNOTA            = 61B-SORT-TIKNOTA                                       
    IDFAKT             = 61B-IDFAKT                                             
    TIFAKT             = 61B-TIFAKT                                             
    FLDIRLEV           = 61B-FLDIRLEV                                           
                                                                                
    PRINT RAPPORT01                                                             
                                                                                
  END-IF                                                                        
                                                                                
NEWPAGE                                                                         
*--------------------------*                                                    
* REPORT                   *                                                    
*--------------------------*                                                    
                                                                                
