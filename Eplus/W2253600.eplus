                                                                                
*---------------------------------------------------------------*               
*    PROGRAMNAMN: W2253600                                      *               
*                                                               *               
*    UTFÄRDARE: ANN JORDEBO               DATUM: DEC  90        *               
*    KORT BESKRIVNING: SORTERAR OCH SPLITTAR UPP INFIL I FEM    *               
*                      TEMP.FILER BEROENDE PÅ BEGÄRD SORTE-     *               
*                      RINGSORDNING.                            *               
*                      SKRIVER LISTOR, EN FÖR URVALET OCH EN    *               
*                      FÖR SJÄLVA INFORMATIONEN.                *               
*                                                               *               
*---------------------------------------------------------------*               
NEWPAGE                                                                         
*----------------- FILBESKRIVNING INPUT ------------------------*               
FILE W22536D1                                                                   
*                                                                               
%W22532EE 'INFIL-'                                                              
*----------------- FILBESKRIVNING TEMPFILER --------------------*               
FILE SORTFIL   FB(585 9360)                                                     
*                                                                               
%W22532EE 'SORT-'                                                               
                                                                                
FILE TPFIL     FB(585 9360)                                                     
*                                                                               
%W22532EE 'IN1-'                                                                
                                                                                
FILE TPFIL1    FB(585 9360)                                                     
*                                                                               
%W22532EE 'SORT1-'                                                              
                                                                                
FILE TPFIL2    FB(585 9360)                                                     
*                                                                               
%W22532EE 'SORT2-'                                                              
                                                                                
FILE TPFIL3    FB(585 9360)                                                     
*                                                                               
%W22532EE 'SORT3-'                                                              
                                                                                
FILE TPFIL4    FB(585 9360)                                                     
*                                                                               
%W22532EE 'SORT4-'                                                              
                                                                                
FILE TPFIL5    FB(585 9360)                                                     
*                                                                               
%W22532EE 'SORT5-'                                                              
                                                                                
FILE TPFIL6    FB(585 9360)                                                     
*                                                                               
%W22532EE 'IN-'                                                                 
                                                                                
*----------------- BESKRIVNING LISTA ---------------------------*               
FILE W22536D2 PRINTER FB(121 121)                                               
*                                                                               
*----------------- WORK-AREOR ----------------------------------*               
%W225320E 'WS-'                                                                 
WS-URVALSNR           W   2   N   MASK 'Z9'.                                    
WS-BLANK              W   5   A   VALUE ' '                                     
SPAR-IDUSER           W   8   A                                                 
SPAR-TIREGDAT         W   7   N   VALUE 0                                       
SPAR-TIREGTID         W   7   N   VALUE 0                                       
FORST                 W   1   N                                                 
                                                                                
%WY2000W1                                                                       
NEWPAGE                                                                         
*----------------- PROGRAM-START -------------------------------*               
                                                                                
****** TILLÄGG AV URVALSNUMMER **********************************               
                                                                                
SORT W22536D1 TO SORTFIL                                      +                 
     USING (INFIL-IDUSER INFIL-URV-KDSORT1 INFIL-TIREGDAT     +                 
            INFIL-TIREGTID)                                   +                 
     BEFORE SORT-INIT                                                           
*                                                                               
SORT-INIT. PROC                                                                 
TMP1-YYMMDD = INFIL-TIREGDAT                                                    
PERFORM WY2000P1                                                                
INFIL-TIREGDAT = TMP1-YYMMDD                                                    
SELECT                                                                          
END-PROC                                                                        
*                                                                               
%WY2000P1                                                                       
*                                                                               
JOB INPUT NULL                                                                  
                                                                                
     GET SORTFIL                                                                
     DO WHILE NOT EOF SORTFIL                                                   
       SPAR-IDUSER = SORT-IDUSER                                                
       SPAR-TIREGDAT = SORT-TIREGDAT                                            
       SPAR-TIREGTID = SORT-TIREGTID                                            
       DO WHILE NOT EOF SORTFIL                                                 
          WS-URVALSNR = 1                                                       
          SPAR-IDUSER = SORT-IDUSER                                             
          DO WHILE NOT EOF SORTFIL AND SPAR-IDUSER = SORT-IDUSER                
            SPAR-TIREGDAT = SORT-TIREGDAT                                       
            SPAR-TIREGTID = SORT-TIREGTID                                       
            DO WHILE NOT EOF SORTFIL               AND          +               
                     SPAR-TIREGDAT = SORT-TIREGDAT AND          +               
                     SPAR-TIREGTID = SORT-TIREGTID                              
              SORT-URV-IDURVNR = WS-URVALSNR                                    
              IN1-W22532 = SORT-W22532                                          
              PUT TPFIL                                                         
              GET SORTFIL                                                       
            END-DO                                                              
            WS-URVALSNR = WS-URVALSNR + 1                                       
          END-DO                                                                
        END-DO                                                                  
     END-DO                                                                     
STOP                                                                            
****** SPLITT OCH SORTERING AV INFILEN TILL FEM TEMPFILER *******               
                                                                                
SORT TPFIL TO TPFIL1                                          +                 
     USING (IN1-IDUSER IN1-TIREGDAT IN1-TIREGTID IN1-IDARTNR  +                 
            IN1-KDTPOTYP IN1-TITPO)                           +                 
     BEFORE SORT1-PROC                                                          
                                                                                
SORT1-PROC. PROC                                                                
     IF IN1-URV-KDSORT1 = 1                                                     
        SELECT                                                                  
     END-IF                                                                     
END-PROC                                                                        
                                                                                
SORT TPFIL TO TPFIL2                                        +                   
     USING (IN1-IDUSER IN1-TIREGDAT IN1-TIREGTID IN1-IDANSK +                   
            IN1-IDLEVNR IN1-IDARTNR IN1-KDTPOTYP IN1-TITPO) +                   
     BEFORE SORT2-PROC                                                          
                                                                                
SORT2-PROC. PROC                                                                
     IF IN1-URV-KDSORT1 = 2                                                     
        SELECT                                                                  
     END-IF                                                                     
END-PROC                                                                        
                                                                                
SORT TPFIL TO TPFIL3                                         +                  
     USING (IN1-IDUSER IN1-TIREGDAT IN1-TIREGTID IN1-IDLEVNR +                  
            IN1-IDDISTR IN1-KDBASLM IN1-TITPO IN1-KDTPOTYP)  +                  
     BEFORE SORT3-PROC                                                          
                                                                                
SORT3-PROC. PROC                                                                
     IF IN1-URV-KDSORT1 = 3                                                     
        SELECT                                                                  
     END-IF                                                                     
END-PROC                                                                        
                                                                                
SORT TPFIL TO TPFIL4                                         +                  
     USING (IN1-IDUSER IN1-TIREGDAT IN1-TIREGTID IN1-IDDISTR +                  
            IN1-KDBASLM IN1-IDARTNR IN1-TITPO IN1-KDTPOTYP)  +                  
     BEFORE SORT4-PROC                                                          
                                                                                
SORT4-PROC. PROC                                                                
     IF IN1-URV-KDSORT1 = 4                                                     
        SELECT                                                                  
     END-IF                                                                     
END-PROC                                                                        
                                                                                
SORT TPFIL TO TPFIL5                                         +                  
     USING (IN1-IDUSER IN1-TIREGDAT IN1-TIREGTID IN1-IDDISTR +                  
            IN1-KDBASLM IN1-TITPO IN1-IDARTNR IN1-KDTPOTYP)  +                  
     BEFORE SORT5-PROC                                                          
                                                                                
SORT5-PROC. PROC                                                                
     IF IN1-URV-KDSORT1 = 5                                                     
        SELECT                                                                  
     END-IF                                                                     
END-PROC                                                                        
                                                                                
****** IHOPLÄSNING AV TEMPFILERNA TILL EN TEMPFIL ***************               
                                                                                
JOB INPUT TPFIL1                                                                
                                                                                
  IN-W22532 = SORT1-W22532                                                      
  PUT TPFIL6                                                                    
                                                                                
                                                                                
JOB INPUT TPFIL2                                                                
                                                                                
  IN-W22532 = SORT2-W22532                                                      
  PUT TPFIL6                                                                    
                                                                                
                                                                                
JOB INPUT TPFIL3                                                                
                                                                                
  IN-W22532 = SORT3-W22532                                                      
  PUT TPFIL6                                                                    
                                                                                
                                                                                
JOB INPUT TPFIL4                                                                
                                                                                
  IN-W22532 = SORT4-W22532                                                      
  PUT TPFIL6                                                                    
                                                                                
                                                                                
JOB INPUT TPFIL5                                                                
                                                                                
  IN-W22532 = SORT5-W22532                                                      
  PUT TPFIL6                                                                    
                                                                                
****** UTSKRIFT AV TEMPFILEN ************************************               
                                                                                
                                                                                
JOB INPUT NULL                                                                  
                                                                                
* WS-URVALSNR = 1                                                               
  FORST = 1                                                                     
  GET TPFIL6                                                                    
  DO WHILE NOT EOF TPFIL6                                                       
    SPAR-IDUSER = IN-IDUSER                                                     
    SPAR-TIREGTID = IN-TIREGTID                                                 
    FORST = 1                                                                   
    DO WHILE NOT EOF TPFIL6            AND +                                    
             IN-IDUSER   = SPAR-IDUSER AND +                                    
             IN-TIREGTID = SPAR-TIREGTID                                        
      IF FORST = 1                                                              
        WS-W22532 = IN-W22532                                                   
        PRINT RAPPORT01                                                         
        TMP1-YYMMDD = WS-TIREGDAT                                               
        PERFORM WY2000P1                                                        
        WS-TIREGDAT = TMP1-YYMMDD                                               
        PRINT RAPPORT02                                                         
        FORST = 2                                                               
      ELSE                                                                      
        WS-W22532 = IN-W22532                                                   
        TMP1-YYMMDD = WS-TIREGDAT                                               
        PERFORM WY2000P1                                                        
        WS-TIREGDAT = TMP1-YYMMDD                                               
        PRINT RAPPORT02                                                         
      END-IF                                                                    
      GET TPFIL6                                                                
    END-DO                                                                      
  END-DO                                                                        
  STOP                                                                          
                                                                                
%WY2000P1                                                                       
*                                                                               
REPORT RAPPORT01        +                                                       
       PRINTER W22536D2 +                                                       
       LINESIZE 120     +                                                       
       NOPAGE           +                                                       
       NOADJUST         +                                                       
       NOHEADING                                                                
                                                                                
  CONTROL WS-IDUSER NOPRINT WS-TIREGTID NEWPAGE NOPRINT                         
  TITLE 1 COL 055 'URVAL'                                                       
  TITLE 2 COL 005 'VOLVO PARTS AB    W22536-001    URVAL: '    +                
                   WS-URV-IDURVNR                              +                
          COL 050 'LISTA TPO-INFORMATION'                      +                
          COL 080 'USERID '                                    +                
          COL 087  WS-IDUSER                                                    
  TITLE 5 COL 005 'ANSK.NR FOM ' WS-URV-IDANSK-FOM             +                
          COL 025 'TOM ' WS-URV-IDANSK-TOM                     +                
          COL 050 'SORT.ALT ' WS-URV-KDSORT1                                    
  TITLE 7 COL 005 'LEV.NR      ' WS-URV-IDLEVNR                +                
          COL 040 'PROD.SLAG ' WS-URV-KDPRODSL                                  
  TITLE 9 COL 005 'DISTR FOM  '  WS-URV-IDDISTR-FOM            +                
          COL 025 'TOM ' WS-URV-IDDISTR-TOM                    +                
          COL 040 'MARKN FOM ' WS-URV-KDBASLM-FOM              +                
          COL 060 'TOM ' WS-URV-KDBASLM-TOM                                     
  TITLE 11 COL 005 'TPO TYP FOM ' WS-URV-KDTPOTYP-FOM          +                
           COL 025 'TOM ' WS-URV-KDTPOTYP-TOM                  +                
           COL 040 'TID FOM   ' WS-URV-TITPO-FOM               +                
           COL 060 'TOM ' WS-URV-TITPO-TOM                                      
  LINE 1 WS-URV-IDARTNR(1) WS-URV-IDARTNR(2) WS-URV-IDARTNR(3) +                
         WS-URV-IDARTNR(4) WS-URV-IDARTNR(5) WS-URV-IDARTNR(6) +                
         WS-URV-IDARTNR(7) WS-URV-IDARTNR(8) WS-URV-IDARTNR(9)                  
  LINE 2 WS-URV-IDARTNR(10) WS-URV-IDARTNR(11) WS-URV-IDARTNR(12) +             
         WS-URV-IDARTNR(13) WS-URV-IDARTNR(14) WS-URV-IDARTNR(15) +             
         WS-URV-IDARTNR(16) WS-URV-IDARTNR(17) WS-URV-IDARTNR(18)               
  LINE 3 WS-URV-IDARTNR(19) WS-URV-IDARTNR(20) WS-URV-IDARTNR(21) +             
         WS-URV-IDARTNR(22) WS-URV-IDARTNR(23) WS-URV-IDARTNR(24) +             
         WS-URV-IDARTNR(25) WS-URV-IDARTNR(26) WS-URV-IDARTNR(27)               
  LINE 4 WS-URV-IDARTNR(28) WS-URV-IDARTNR(29) WS-URV-IDARTNR(30) +             
         WS-URV-IDARTNR(31) WS-URV-IDARTNR(32) WS-URV-IDARTNR(33) +             
         WS-URV-IDARTNR(34) WS-URV-IDARTNR(35) WS-URV-IDARTNR(36)               
  LINE 5 WS-URV-IDARTNR(37) WS-URV-IDARTNR(38) WS-URV-IDARTNR(39) +             
         WS-URV-IDARTNR(40) WS-URV-IDARTNR(41) WS-URV-IDARTNR(42) +             
         WS-URV-IDARTNR(43) WS-URV-IDARTNR(44) WS-URV-IDARTNR(45)               
  LINE 6 WS-URV-IDARTNR(46) WS-URV-IDARTNR(47) WS-URV-IDARTNR(48) +             
         WS-URV-IDARTNR(49) WS-URV-IDARTNR(50) WS-URV-IDARTNR(51) +             
         WS-URV-IDARTNR(52) WS-URV-IDARTNR(53) WS-URV-IDARTNR(54)               
  LINE 7 WS-URV-IDARTNR(55) WS-URV-IDARTNR(56) WS-URV-IDARTNR(57) +             
         WS-URV-IDARTNR(58) WS-URV-IDARTNR(59) WS-URV-IDARTNR(60) +             
         WS-URV-IDARTNR(61) WS-URV-IDARTNR(62) WS-URV-IDARTNR(63)               
  LINE 8 WS-URV-IDARTNR(64) WS-URV-IDARTNR(65) WS-URV-IDARTNR(66) +             
         WS-URV-IDARTNR(67) WS-URV-IDARTNR(68) WS-URV-IDARTNR(69) +             
         WS-URV-IDARTNR(70) WS-URV-IDARTNR(71) WS-URV-IDARTNR(72)               
  LINE 9 WS-URV-IDARTNR(73) WS-URV-IDARTNR(74) WS-URV-IDARTNR(75) +             
         WS-URV-IDARTNR(76) WS-URV-IDARTNR(77) WS-URV-IDARTNR(78) +             
         WS-URV-IDARTNR(79) WS-URV-IDARTNR(80) WS-URV-IDARTNR(81)               
 LINE 10 WS-URV-IDARTNR(82) WS-URV-IDARTNR(83) WS-URV-IDARTNR(84) +             
         WS-URV-IDARTNR(85) WS-URV-IDARTNR(86) WS-URV-IDARTNR(87) +             
         WS-URV-IDARTNR(88) WS-URV-IDARTNR(89) WS-URV-IDARTNR(90)               
 LINE 11 WS-URV-IDARTNR(91) WS-URV-IDARTNR(92) WS-URV-IDARTNR(93) +             
         WS-URV-IDARTNR(94) WS-URV-IDARTNR(95) WS-URV-IDARTNR(96) +             
         WS-URV-IDARTNR(97) WS-URV-IDARTNR(98) WS-URV-IDARTNR(99)               
 LINE 12 WS-URV-IDARTNR(100)                                                    
                                                                                
REPORT RAPPORT02 +                                                              
       PRINTER W22536D2 +                                                       
       PAGESIZE 40      +                                                       
       LINESIZE 120     +                                                       
       NOADJUST         +                                                       
       SUMCTL NONE                                                              
                                                                                
  CONTROL WS-IDUSER WS-TIREGDAT WS-TIREGTID NEWPAGE RENUM      +                
          WS-IDANSK                                                             
  TITLE 1 COL 055 'URVAL'                                                       
  TITLE 2 COL 005 'VOLVO PARTS AB    W22536-001    URVAL: '    +                
                   WS-URV-IDURVNR                              +                
          COL 050 'LISTA TPO-INFORMATION'                      +                
          COL 080 'USERID '                                    +                
          COL 087  WS-IDUSER                                   +                
          COL 095 'DATUM '  WS-TIREGDAT                                         
  TITLE 3 COL 095 'TID   '  WS-TIREGTID                                         
                                                                                
  HEADING WS-IDANSK 'ANSK'                                                      
  HEADING WS-IDLEVNR 'LEV.NR'                                                   
  HEADING WS-IDARTNR 'ART.NR'                                                   
  HEADING WS-KDTPOTYP 'TPO-TYP'                                                 
  HEADING WS-KVART 'TPO ANT'                                                    
  HEADING WS-TITPO 'TPO DAT'                                                    
  HEADING WS-IDDISTR 'DISTR'                                                    
  HEADING WS-KDBASLM 'MARKN'                                                    
  HEADING WS-IDORDER 'ORDER NR'                                                 
  LINE 1 WS-IDANSK                                            +                 
         WS-IDLEVNR                                           +                 
         WS-IDARTNR                                           +                 
         WS-KDTPOTYP                                          +                 
         WS-KVART                                             +                 
         WS-TITPO                                             +                 
         WS-IDDISTR                                           +                 
         WS-KDBASLM                                           +                 
         WS-IDORDER                                                             
                                                                                
                                                                                
