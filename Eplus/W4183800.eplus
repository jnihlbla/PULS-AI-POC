                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W418   ANNULLATION - OKÄND ARTIKEL                    *        
*                                                                      *        
*  FUNKTION   :  SKAPAR LISTA W41838-001 ANNULLATION - OKÄND ARTIKEL   *        
*                             W41838-002                                        
*                             W41838-003                                        
*                EN FÖR RESP. USA, CANADA OCH RESTEN                            
*                                                                      *        
*  FÖRFATTARE :  CAMELIA OLGRENER                                      *        
*                                                                      *        
*  INFIL      :  W418.W418D2.W4183H(+0)                                *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W41838D1 FB(53 27984)                                                      
                                                                                
%W4183H   'IN-'                                                                 
                                                                                
NEWPAGE                                                                         
                                                                                
FILE W41838D2 PRINTER FB(121 121)                                               
FILE W41838D3 PRINTER FB(121 121)                                               
FILE W41838D4 PRINTER FB(121 121)                                               
                                                                                
NEWPAGE                                                                         
                                                                                
%WDATKORT                                                                       
NEWPAGE                                                                         
                                                                                
  W-PAGE          W 10 A VALUE '  PAGE  '                                       
                                                                                
  W-PGMNAMN       W 6  A  VALUE 'W41838'                                        
  W-WDATUM        W 6  A  VALUE 'WDATUM'                                        
  W-IDDISTR       W 4  N  MASK '---9'      HEADING('DISTR')                     
  W-IDKUNDNR      W 6  N  MASK '-----9'    HEADING('CUST')                      
  W-IDRAPPNR      W 7  N  MASK '------9'   HEADING(' D/R NO')                   
  W-KVBEART       W 6  N  MASK '-----9'    HEADING('DISC.REP.QTY ')             
  W-TIREGDAT      W 6  N  MASK BWZ         HEADING('CAN.DATE ')                 
                                                                                
  W-DATUM          W  6   N                                                     
  W-AAR  W-DATUM   +4 2   N                                                     
  W-MM   W-DATUM      2   N                                                     
  W-DD   W-DATUM   +2 2   N                                                     
                                                                                
  W-AAVV           W  4   A                                                     
  W-AA   W-AAVV       2   N                                                     
  W-VV   W-AAVV    +2 2   N                                                     
                                                                                
  WS-IDDISTR                W  4   N                                            
  WS-IDLAND  WS-IDDISTR        2   N                                            
  WS-IDNR    WS-IDDISTR     +2 2   N                                            
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
JOB INPUT W41838D1 START INIT-PROC                                              
                                                                                
    W-IDDISTR         = IN-IDDISTR                                              
    WS-IDDISTR        = IN-IDDISTR                                              
    W-IDKUNDNR        = IN-IDKUNDNR                                             
    W-IDRAPPNR        = IN-IDRAPPNR                                             
    W-KVBEART         = IN-KVBEART                                              
    W-TIREGDAT        = IN-TIREGDAT                                             
                                                                                
    IF WS-IDLAND  = 75                                                          
      PRINT RAPPORT01                                                           
    ELSE                                                                        
      IF WS-IDLAND  = 76                                                        
        PRINT RAPPORT02                                                         
      ELSE                                                                      
        PRINT RAPPORT03                                                         
      END-IF                                                                    
    END-IF                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
INIT-PROC. PROC                                                                 
    CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                           
    W-AAR  = D-AAR                                                              
    W-MM   = D-MAANAD                                                           
    W-DD   = D-DAG                                                              
    W-AA   = D-AAR                                                              
    W-VV   = D-VECKA                                                            
END-PROC                                                                        
NEWPAGE                                                                         
                                                                                
******************                                                              
*  RAPPORT                                                                      
******************                                                              
                                                                                
REPORT RAPPORT01 PRINTER W41838D2 +                                             
     SKIP 1 LINESIZE 120 NODATE NOSPREAD NOADJUST                               
                                                                                
SEQUENCE W-IDDISTR W-IDKUNDNR W-IDRAPPNR                                        
CONTROL FINAL NOPRINT                                                           
                                                                                
TITLE 1 'VCC           W41838-001  CANCELLATION - '  +                          
        'UNKNOWN PART                             '  +                          
         W-DATUM                                     +                          
COL 108     W-PAGE                                                              
                                                                                
LINE W-IDDISTR W-IDKUNDNR W-IDRAPPNR  +                                         
            COL 30 W-KVBEART          +                                         
            COL 45 W-TIREGDAT                                                   
                                                                                
                                                                                
REPORT RAPPORT02 PRINTER W41838D3 +                                             
     SKIP 1 LINESIZE 120 NODATE NOSPREAD NOADJUST                               
                                                                                
SEQUENCE W-IDDISTR W-IDKUNDNR W-IDRAPPNR                                        
CONTROL FINAL NOPRINT                                                           
                                                                                
TITLE 1 'VCC           W41838-002  CANCELLATION - '  +                          
        'UNKNOWN PART                             '  +                          
         W-DATUM                                     +                          
COL 108     W-PAGE                                                              
                                                                                
LINE W-IDDISTR W-IDKUNDNR W-IDRAPPNR  +                                         
            COL 30 W-KVBEART          +                                         
            COL 45 W-TIREGDAT                                                   
                                                                                
                                                                                
REPORT RAPPORT03 PRINTER W41838D4 +                                             
     SKIP 1 LINESIZE 120 NODATE NOSPREAD NOADJUST                               
                                                                                
SEQUENCE W-IDDISTR W-IDKUNDNR W-IDRAPPNR                                        
CONTROL FINAL NOPRINT                                                           
                                                                                
TITLE 1 'VCC           W41838-003  CANCELLATION - '  +                          
        'UNKNOWN PART                             '  +                          
         W-DATUM                                     +                          
COL 108     W-PAGE                                                              
                                                                                
LINE W-IDDISTR W-IDKUNDNR W-IDRAPPNR  +                                         
            COL 30 W-KVBEART          +                                         
            COL 45 W-TIREGDAT                                                   
                                                                                
