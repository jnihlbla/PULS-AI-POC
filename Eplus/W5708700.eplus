                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5708700                                              *        
*                                                                      *        
*  FUNKTION   :  THIS PROGRAM MATCHES PARTS AGAINST THE W01184 FILE TO *        
*                GET THE STOCK BALANCE AND THE AVERAGE COST            *        
*                                                                      *        
*  FÖRFATTARE :  ARCHANA BHAT                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W57087D1                                                                   
*                                                                               
%W57086  'IN-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE W57087D2                                                                   
*                                                                               
%W01184  'K7-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE TPFIL1 FB(483 0)                                                           
*                                                                               
%W01184  'T1-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE TPFIL2 FB(483 0)                                                           
*                                                                               
%W57086  'T2-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE W57087D3 FB(33 0)                                                          
*                                                                               
%W57087  'UT-'                                                                  
                                                                                
NEWPAGE                                                                         
* STEG 1. SORT ON  IDDC  AND IDARTNR                                            
*                                                                               
SORT W57087D2 TO +                                                              
     TPFIL1 USING (K7-SLAG-IDDC ,  K7-SLAG-IDARTNR)                             
                                                                                
NEWPAGE                                                                         
* STEG 1. SORT ON  IDDC  AND IDARTNR                                            
*                                                                               
SORT W57087D1 TO +                                                              
     TPFIL2 USING (IN-IDDC , IN-IDARTNR)                                        
                                                                                
NEWPAGE                                                                         
* STEG 2. MATCH FILES                                                           
*                                                                               
JOB INPUT (TPFIL2   KEY(T2-IDDC  , T2-IDARTNR) +                                
           TPFIL1   KEY(T1-SLAG-IDDC  , T1-SLAG-IDARTNR))                       
                                                                                
IF MATCHED                                                                      
   UT-IDARTNR       =  T2-IDARTNR                                               
   UT-IDDC          =  T2-IDDC                                                  
   UT-IDLEVNR       =  T2-IDLEVNR                                               
   UT-PERIOD        =  T2-PERIOD                                                
   UT-KDPRODSL      =  T2-KDPRODSL                                              
   UT-KVEFRS        =  T1-SLAG-KVEFRS                                           
   UT-KVLS          =  T1-SLAG-KVLS                                             
   UT-PRAVCOST      =  T1-SLAG-PRAVCOST                                         
                                                                                
   PUT W57087D3                                                                 
END-IF                                                                          
