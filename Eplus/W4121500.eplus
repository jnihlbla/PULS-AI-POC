                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4121500                                              *        
*                                                                      *        
*  FUNKTION   :  UTIFRÅN VECKANS ALLA KLASS-0 RADER SKRIVER FIL TILL   *        
*                VIOS FÖR VOR UPPFÖLJNING.                             *        
*                                                                      *        
*  FÖRFATTARE :  LASSI OLGRENER                                        *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W41215D1                                                                   
*                                                                               
   IN-IDARTNR   7  5  P 0                                                       
                                                                                
NEWPAGE                                                                         
FILE W41215D2                                                                   
*                                                                               
  VOR-IDARTNR   7  5  P 0                                                       
                                                                                
NEWPAGE                                                                         
FILE W41215D3                                                                   
*                                                                               
%W011100  'LB-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W41215D4 FB(40 0)                                                          
*                                                                               
%W41215  'UT-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE SORTFIL FB(19 0)                                                           
*                                                                               
   SRT-TIAAVV    1  3  P 0                                                      
   SRT-IDDISTR   4  3  P 0                                                      
   SRT-IDARTNR   7  5  P 0                                                      
   SRT-KVBEART  12  4  P 0                                                      
   SRT-KDVORATG 16  1  A                                                        
   SRT-KVRADER  17  3  P 0                                                      
                                                                                
NEWPAGE                                                                         
FILE TEMP01 FB(17 0)                                                            
*                                                                               
   T1-IDDISTR    1  3  P 0                                                      
   T1-IDARTNR    4  5  P 0                                                      
   T1-KVRADER    9  3  P 0                                                      
   T1-VARDE      12 6  P 2                                                      
                                                                                
NEWPAGE                                                                         
FILE TEMP02 FB(12 0)                                                            
*                                                                               
   T2-IDDISTR    1  3  P 0                                                      
   T2-RADER-TOT  4  3  P 0                                                      
   T2-VARDE-TOT  7  6  P 2                                                      
                                                                                
NEWPAGE                                                                         
FILE TEMP03 FB(12 0)                                                            
*                                                                               
   T3-IDDISTR    1  3  P 0                                                      
   T3-RADER-VOR  4  3  P 0                                                      
   T3-VARDE-VOR  7  6  P 2                                                      
                                                                                
NEWPAGE                                                                         
FILE MATCH01 FB(17 0)                                                           
*                                                                               
   M1-IDDISTR    1  3  P 0                                                      
   M1-IDARTNR    4  5  P 0                                                      
   M1-KVRADER    9  3  P 0                                                      
   M1-VARDE      12 6  P 2                                                      
                                                                                
NEWPAGE                                                                         
*--------------*                                                                
* WORKAREA     *                                                                
*--------------*                                                                
                                                                                
  W-RADER              W   3 P 0   VALUE 0                                      
  W-VARDE              W   6 P 2   VALUE 0                                      
  SPAR-TIAAVV          W   3 P 0   VALUE 0                                      
  SPAR-IDDISTR         W   3 P 0   VALUE 0                                      
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. SORTERAR Q4+E4+VORKÖ                                                  
*                                                                               
SORT W41215D1 TO +                                                              
     SORTFIL USING (IN-IDARTNR)                                                 
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 2. MATCHAR Q4+E4+VORKÖ MED LAGERBAND                                     
*                                                                               
JOB INPUT (W41215D3 KEY(LB-IDARTNR)  +                                          
           SORTFIL  KEY(SRT-IDARTNR))                                           
                                                                                
  IF MATCHED                                                                    
    IF RECORD-COUNT(SORTFIL) = 1                                                
      SPAR-TIAAVV  = SRT-TIAAVV                                                 
    END-IF                                                                      
    M1-IDDISTR     = SRT-IDDISTR                                                
    M1-IDARTNR     = SRT-IDARTNR                                                
    M1-KVRADER     = SRT-KVRADER                                                
    M1-VARDE       = SRT-KVBEART * LB-PRARTSTD                                  
    PUT MATCH01                                                                 
  ELSE                                                                          
    IF SORTFIL                                                                  
      DISPLAY 'ART. SAKNAS PÅ LAGERB.' SRT-IDARTNR                              
      RETURN-CODE = 16                                                          
      STOP EXECUTE                                                              
    END-IF                                                                      
  END-IF                                                                        
NEWPAGE                                                                         
*                                                                               
* STEG 3. SORTERAR Q4+E4+VORKÖ                                                  
*                                                                               
SORT MATCH01 TO +                                                               
     TEMP01 USING (M1-IDDISTR, M1-IDARTNR)                                      
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 4. SUM RADER OCH VÄRDE/DISTR                                             
*                                                                               
JOB INPUT (TEMP01) +                                                            
                 FINISH Z-FINIT                                                 
                                                                                
  IF RECORD-COUNT = 1                                                           
    SPAR-IDDISTR = T1-IDDISTR                                                   
    W-RADER      = 0                                                            
    W-VARDE      = 0                                                            
  END-IF                                                                        
  IF T1-IDDISTR NE SPAR-IDDISTR                                                 
    T2-IDDISTR   = SPAR-IDDISTR                                                 
    T2-RADER-TOT = W-RADER                                                      
    T2-VARDE-TOT = W-VARDE                                                      
    PUT TEMP02                                                                  
    SPAR-IDDISTR = T1-IDDISTR                                                   
    W-RADER      = T1-KVRADER                                                   
    W-VARDE      = T1-VARDE                                                     
  ELSE                                                                          
    W-RADER = W-RADER + T1-KVRADER                                              
    W-VARDE = W-VARDE + T1-VARDE                                                
  END-IF                                                                        
                                                                                
Z-FINIT. PROC                                                                   
    T2-IDDISTR   = SPAR-IDDISTR                                                 
    T2-RADER-TOT = W-RADER                                                      
    T2-VARDE-TOT = W-VARDE                                                      
    PUT TEMP02                                                                  
END-PROC                                                                        
NEWPAGE                                                                         
*                                                                               
* STEG 5. SORTERAR VORKÖ-TOT                                                    
*                                                                               
SORT W41215D2 TO +                                                              
     SORTFIL USING (VOR-IDARTNR)                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 6. MATCHAR VORKÖ-TOT MED LAGERBAND                                       
*                                                                               
JOB INPUT (W41215D3 KEY(LB-IDARTNR)  +                                          
           SORTFIL  KEY(SRT-IDARTNR))                                           
                                                                                
  IF MATCHED                                                                    
    M1-IDDISTR   = SRT-IDDISTR                                                  
    M1-IDARTNR   = SRT-IDARTNR                                                  
    M1-KVRADER   = SRT-KVRADER                                                  
    M1-VARDE     = SRT-KVBEART * LB-PRARTSTD                                    
      PUT MATCH01                                                               
  ELSE                                                                          
    IF SORTFIL                                                                  
      DISPLAY 'ART. SAKNAS PÅ LAGERB.' SRT-IDARTNR                              
      RETURN-CODE = 16                                                          
      STOP EXECUTE                                                              
    END-IF                                                                      
  END-IF                                                                        
NEWPAGE                                                                         
*                                                                               
* STEG 7. SORTERAR VORKÖ-TOT                                                    
*                                                                               
SORT MATCH01 TO +                                                               
     TEMP01 USING (M1-IDDISTR, M1-IDARTNR)                                      
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 8. SUM RADER OCH VÄRDE/DISTR                                             
*                                                                               
JOB INPUT (TEMP01) +                                                            
                 FINISH Z-FINIT                                                 
                                                                                
  IF RECORD-COUNT = 1                                                           
    SPAR-IDDISTR = T1-IDDISTR                                                   
    W-RADER      = 0                                                            
    W-VARDE      = 0                                                            
  END-IF                                                                        
  IF T1-IDDISTR NE SPAR-IDDISTR                                                 
    T3-IDDISTR   = SPAR-IDDISTR                                                 
    T3-RADER-VOR = W-RADER                                                      
    T3-VARDE-VOR = W-VARDE                                                      
    PUT TEMP03                                                                  
    SPAR-IDDISTR = T1-IDDISTR                                                   
    W-RADER      = T1-KVRADER                                                   
    W-VARDE      = T1-VARDE                                                     
  ELSE                                                                          
    W-RADER = W-RADER + T1-KVRADER                                              
    W-VARDE = W-VARDE + T1-VARDE                                                
  END-IF                                                                        
                                                                                
Z-FINIT. PROC                                                                   
    T3-IDDISTR   = SPAR-IDDISTR                                                 
    T3-RADER-VOR = W-RADER                                                      
    T3-VARDE-VOR = W-VARDE                                                      
    PUT TEMP03                                                                  
END-PROC                                                                        
NEWPAGE                                                                         
*                                                                               
* STEG 9. SKAPAR 'VIOS'-FILEN                                                   
*                                                                               
JOB INPUT (TEMP02 KEY(T2-IDDISTR) +                                             
           TEMP03 KEY(T3-IDDISTR))                                              
IF MATCHED                                                                      
  UT-TIAAVV    = SPAR-TIAAVV                                                    
  UT-IDDISTR   = T2-IDDISTR                                                     
  UT-KVRADER-TOT = T2-RADER-TOT                                                 
  UT-SUORDV-TOT = T2-VARDE-TOT                                                  
  UT-KVRADER-VOR = T3-RADER-VOR                                                 
  UT-SUORDV-VOR = T3-VARDE-VOR                                                  
  PUT W41215D4                                                                  
ELSE                                                                            
  IF TEMP02                                                                     
    UT-TIAAVV    = SPAR-TIAAVV                                                  
    UT-IDDISTR   = T2-IDDISTR                                                   
    UT-KVRADER-TOT = T2-RADER-TOT                                               
    UT-SUORDV-TOT = T2-VARDE-TOT                                                
    UT-KVRADER-VOR = 0                                                          
    UT-SUORDV-VOR = 0                                                           
    PUT W41215D4                                                                
  ELSE                                                                          
    UT-TIAAVV    = SPAR-TIAAVV                                                  
    UT-IDDISTR   = T3-IDDISTR                                                   
    UT-KVRADER-TOT = 0                                                          
    UT-SUORDV-TOT = 0                                                           
    UT-KVRADER-VOR = T3-RADER-VOR                                               
    UT-SUORDV-VOR = T3-VARDE-VOR                                                
    PUT W41215D4                                                                
  END-IF                                                                        
END-IF                                                                          
