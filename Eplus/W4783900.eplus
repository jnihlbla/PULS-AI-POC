FILE W47839D1                                                                   
%W479055                                                                        
*                                                                               
FILE W47839D2 FB (121 121) PRINTER                                              
*                                                                               
FILE W47839D3 FB (121 121) PRINTER                                              
*                                                                               
T-IDDISTR      W 5 N    MASK 'ZZZZ9'                                            
T-IDKUNDNR     W 7 N    MASK 'ZZZZZZ9'                                          
T-IDORDNR      W 5 N    MASK 'ZZZZ9'                                            
T-IDARTNR      W 8 N    MASK 'ZZZZZZZ9'                                         
PRTILL         W 1 A                                                            
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
JOB INPUT(W47839D1) NAME AKT01                                                  
*                                                                               
 IF IDDISTR = 778                                                               
      T-IDDISTR  = IDDISTR                                                      
      T-IDKUNDNR = IDKUNDNR                                                     
      T-IDORDNR  = IDORDNR5                                                     
      T-IDARTNR  = IDARTNR                                                      
      IF FLPRTILL = 'J'                                                         
        PRTILL = ' '                                                            
      ELSE                                                                      
        PRTILL = '*'                                                            
      END-IF                                                                    
    IF KDORDKL = 0                                                              
      PRINT W47839D2                                                            
    ELSE                                                                        
      IF KDORDKL = 2                                                            
        PRINT W47839D3                                                          
      END-IF                                                                    
    END-IF                                                                      
 END-IF                                                                         
*                                                                               
  REPORT W47839D2  +                                                            
        LINESIZE 120 PRINTER W47839D2                                           
    SEQUENCE T-IDDISTR T-IDKUNDNR T-IDORDNR T-IDARTNR                           
    TITLE 1 'W47839-001                         LISTA VOR SVERIGE'              
    HEADING T-IDDISTR   'DISTRIKT'                                              
    HEADING T-IDKUNDNR  'KUND'                                                  
    HEADING T-IDORDNR   'ORD.NR'                                                
    HEADING T-IDARTNR   'ART.NR'                                                
    HEADING KVLEVART    'ANTAL'                                                 
    HEADING PRTILL      'EJ PRISTILLÄGG'                                        
    LINE    T-IDDISTR T-IDKUNDNR T-IDORDNR T-IDARTNR KVLEVART PRTILL            
*                                                                               
  REPORT W47839D3  +                                                            
        LINESIZE 120 PRINTER W47839D3                                           
    SEQUENCE T-IDDISTR T-IDKUNDNR T-IDORDNR T-IDARTNR                           
    TITLE 1 'W47839-002                     LISTA KLASS 2 SVERIGE'              
    HEADING T-IDDISTR   'DISTRIKT'                                              
    HEADING T-IDKUNDNR  'KUND'                                                  
    HEADING T-IDORDNR   'ORD.NR'                                                
    HEADING T-IDARTNR   'ART.NR'                                                
    HEADING KVLEVART    'ANTAL'                                                 
    HEADING PRTILL      'EJ PRISTILLÄGG'                                        
    LINE T-IDDISTR T-IDKUNDNR T-IDORDNR T-IDARTNR KVLEVART PRTILL               
