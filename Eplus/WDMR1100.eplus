                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  WDMR1100                                              *        
*                                                                      *        
*  FUNKTION   :  SKAPA STYRFIL FÖR PROCEDURER                          *        
*                                                                      *        
*  FÖRFATTARE :  ODD OLSEN                                             *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE WDMR11D1                                                                   
*                                                                               
  NEW-PROC            1 80 A                                                    
                                                                                
NEWPAGE                                                                         
FILE WDMR11D2                                                                   
*                                                                               
  OLD-PROC            1 80 A                                                    
                                                                                
NEWPAGE                                                                         
FILE SORTFIL  FB(81 23409)                                                      
*                                                                               
  TMP-STYR            1  1 A                                                    
  TMP-PROC            2 80 A                                                    
                                                                                
*    -- CHECKED BY WY2000                                                       
  TMP-SORT            2 13 A                                                    
                                                                                
NEWPAGE                                                                         
FILE STYRFIL  FB(81 23409)                                                      
*                                                                               
  ST-STYR             1  1 A                                                    
  ST-PROC             2 80 A                                                    
  ST-PROC-NAME        2 13 A                                                    
                                                                                
NEWPAGE                                                                         
FILE WDMR11D5 FB(81 23409)                                                      
*                                                                               
  UT-STYR             1  1 A                                                    
  UT-PROC             2 80 A                                                    
                                                                                
NEWPAGE                                                                         
*                                                                               
* ARBETSAREOR                                                                   
*                                                                               
  CANCEL              W  1 A   VALUE 'A'                                        
  NEW                 W  1 A   VALUE 'B'                                        
  OLD                 W  1 A   VALUE 'Z'                                        
  NU-TYP              W  1 A   VALUE ' '                                        
  SPAR-PROC-NAME      W 13 A                                                    
                                                                                
NEWPAGE                                                                         
*                                                                               
* MATCHNING AV PROCEDUR FILER                                                   
*                                                                               
JOB INPUT (WDMR11D1 KEY(NEW-PROC) +                                             
           WDMR11D2 KEY(OLD-PROC))                                              
  IF MATCHED                                                                    
                                                                                
    TMP-STYR = OLD                                                              
    TMP-PROC = NEW-PROC                                                         
    PUT SORTFIL                                                                 
    GOTO JOB                                                                    
  END-IF                                                                        
                                                                                
  IF WDMR11D1                                                                   
                                                                                
    TMP-STYR = NEW                                                              
    TMP-PROC = NEW-PROC                                                         
    PUT SORTFIL                                                                 
    GOTO JOB                                                                    
  END-IF                                                                        
                                                                                
  IF WDMR11D2                                                                   
                                                                                
    TMP-STYR = CANCEL                                                           
    TMP-PROC = OLD-PROC                                                         
    PUT SORTFIL                                                                 
    GOTO JOB                                                                    
  END-IF                                                                        
                                                                                
  GOTO JOB                                                                      
                                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
* SORTERING AV PROCEDURFILER                                                    
*                                                                               
SORT SORTFIL  TO +                                                              
     STYRFIL  USING (TMP-SORT, TMP-STYR)                                        
NEWPAGE                                                                         
*                                                                               
* PLOCKA UT POSTER FÖR UPPDATERING                                              
*                                                                               
JOB INPUT (STYRFIL)                                                             
                                                                                
  IF ST-PROC-NAME ^= SPAR-PROC-NAME                                             
                                                                                
    IF NU-TYP = CANCEL                                                          
      UT-STYR = 'D'                                                             
      UT-PROC = SPAR-PROC-NAME                                                  
      PUT WDMR11D5                                                              
      UT-STYR = ' '                                                             
    END-IF                                                                      
                                                                                
    SPAR-PROC-NAME = ST-PROC-NAME                                               
                                                                                
    IF ST-STYR = CANCEL                                                         
      NU-TYP = CANCEL                                                           
    END-IF                                                                      
                                                                                
    IF ST-STYR = OLD                                                            
      NU-TYP = OLD                                                              
    END-IF                                                                      
                                                                                
    IF ST-STYR = NEW                                                            
      NU-TYP = NEW                                                              
      UT-PROC = ST-PROC                                                         
      PUT WDMR11D5                                                              
    END-IF                                                                      
                                                                                
  ELSE                                                                          
    IF NU-TYP = CANCEL                                                          
      IF ST-STYR ^= CANCEL                                                      
        NU-TYP = NEW                                                            
      END-IF                                                                    
    END-IF                                                                      
    IF NU-TYP = NEW                                                             
      UT-PROC = ST-PROC                                                         
      PUT WDMR11D5                                                              
    END-IF                                                                      
  END-IF                                                                        
                                                                                
  GOTO JOB                                                                      
