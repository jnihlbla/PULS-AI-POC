                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  WDMR1400                                              *        
*                                                                      *        
*  FUNKTION   :  DATASET SOM SKALL UPPDATERAS I DATA MANAGER                    
*                                                                      *        
*  FÖRFATTARE :  ODD OLSEN                                             *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE WDMR14D1                                                                   
*                                                                               
  NEW-DSN             1 80 A                                                    
                                                                                
NEWPAGE                                                                         
FILE WDMR14D2                                                                   
*                                                                               
  OLD-DSN             1 80 A                                                    
                                                                                
NEWPAGE                                                                         
FILE SORTFIL  FB(81 23409)                                                      
*                                                                               
  TMP-STYR            1  1 A                                                    
  TMP-DSN             2 80 A                                                    
                                                                                
*    -- CHECKED BY WY2000                                                       
  TMP-SORT            2 41 A                                                    
                                                                                
NEWPAGE                                                                         
FILE STYRFIL  FB(81 23409)                                                      
*                                                                               
  ST-STYR             1  1 A                                                    
  ST-DSN              2 80 A                                                    
  ST-DSN-NAME         2 41 A                                                    
                                                                                
NEWPAGE                                                                         
FILE WDMR14D5 FB(81 23409)                                                      
*                                                                               
  UT-STYR             1  1 A                                                    
  UT-DSN              2 80 A                                                    
                                                                                
NEWPAGE                                                                         
*                                                                               
* ARBETSAREOR                                                                   
*                                                                               
  CANCEL              W  1 A   VALUE 'A'                                        
  NEW                 W  1 A   VALUE 'B'                                        
  OLD                 W  1 A   VALUE 'Z'                                        
  NU-TYP              W  1 A   VALUE ' '                                        
  SPAR-DSN-NAME       W 41 A                                                    
                                                                                
NEWPAGE                                                                         
*                                                                               
* MATCHNING AV PROCEDUR FILER                                                   
*                                                                               
JOB INPUT (WDMR14D1 KEY(NEW-DSN) +                                              
           WDMR14D2 KEY(OLD-DSN))                                               
  IF MATCHED                                                                    
                                                                                
    TMP-STYR = OLD                                                              
    TMP-DSN = NEW-DSN                                                           
    PUT SORTFIL                                                                 
    GOTO JOB                                                                    
  END-IF                                                                        
                                                                                
  IF WDMR14D1                                                                   
                                                                                
    TMP-STYR = NEW                                                              
    TMP-DSN = NEW-DSN                                                           
    PUT SORTFIL                                                                 
    GOTO JOB                                                                    
  END-IF                                                                        
                                                                                
  IF WDMR14D2                                                                   
                                                                                
    TMP-STYR = CANCEL                                                           
    TMP-DSN = OLD-DSN                                                           
    PUT SORTFIL                                                                 
    GOTO JOB                                                                    
  END-IF                                                                        
                                                                                
  GOTO JOB                                                                      
                                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
* SORTERING AV PROCEDURFILER                                                    
*                                                                               
SORT SORTFIL  TO +                                                              
     STYRFIL  USING (TMP-SORT, TMP-STYR)                                        
NEWPAGE                                                                         
*                                                                               
* PLOCKA UT POSTER FÖR UPPDATERING                                              
*                                                                               
JOB INPUT (STYRFIL)                                                             
                                                                                
  IF ST-DSN-NAME ^= SPAR-DSN-NAME                                               
                                                                                
    IF NU-TYP = CANCEL                                                          
      UT-STYR = 'D'                                                             
      UT-DSN = SPAR-DSN-NAME                                                    
      PUT WDMR14D5                                                              
      UT-STYR = ' '                                                             
    END-IF                                                                      
                                                                                
    SPAR-DSN-NAME = ST-DSN-NAME                                                 
                                                                                
    IF ST-STYR = CANCEL                                                         
      NU-TYP = CANCEL                                                           
    END-IF                                                                      
                                                                                
    IF ST-STYR = OLD                                                            
      NU-TYP = OLD                                                              
    END-IF                                                                      
                                                                                
    IF ST-STYR = NEW                                                            
      NU-TYP = NEW                                                              
      UT-DSN = ST-DSN                                                           
      PUT WDMR14D5                                                              
    END-IF                                                                      
                                                                                
  ELSE                                                                          
    IF NU-TYP = CANCEL                                                          
      IF ST-STYR ^= CANCEL                                                      
        NU-TYP = NEW                                                            
      END-IF                                                                    
    END-IF                                                                      
    IF NU-TYP = NEW                                                             
      UT-DSN = ST-DSN                                                           
      PUT WDMR14D5                                                              
    END-IF                                                                      
  END-IF                                                                        
                                                                                
  GOTO JOB                                                                      
