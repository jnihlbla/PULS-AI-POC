                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4283700                                              *        
*                                                                      *        
*  FUNCTION   :  PROGRAM TO READ WDA2 FILE AND CREATE TWO OUTPUT FILES *        
*                WHICH WILL BE USED IN THE W4283800 PROGRAM TO GENERAT *        
*                THE 'DEALER RETURN DAILY FOLLOW UP' REPORT            *        
*                                                                      *        
*     DATE        NAME                     INSTALLATION TRACKER        *        
*     111102      SHILPA MADHURI           E-TRACKER 10143271          *        
*                                                                      *        
*     120410      SUSANNE OLSSON           E-TR. 10143271  RÄTTA FEL   *        
*     121101      SUSANNE OLSSON           E-TR. 10181786  WEB AU(7838)*        
*                                                          FOLLOW-UP   *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W42837D1                                                                   
W42837-IDPTYP 1 3    A                                                          
WDA201-DATA   4 145  A                                                          
WDA211-DATA   4 288  A                                                          
WDA221-DATA   4 1051 A                                                          
*                                                                               
FILE TEMPFIL1 FB (13 0)                                                         
%W42838   'T2-'                                                                 
*                                                                               
FILE W42837D2 FB (65 0)                                                         
%W42837   'W42837-'                                                             
*                                                                               
FILE W42837D3 FB (13 0)                                                         
%W42838   'W42838-'                                                             
*                                                                               
************************************************                                
*    ARBETSAREOR                               *                                
************************************************                                
*                                                                               
%WDA201                                                                         
*                                                                               
%WDA211                                                                         
*COPYTEXTER FÖR CALL                                                            
*  CHECK IDDC VALUES                                                            
%WWDC99                                                                         
*                                                                               
%WDATAREA                                                                       
*                                                                               
%W418OKOD  'OKOD-'                                                              
*                                                                               
*WWDC02                                                                         
*                                                                               
NEWPAGE                                                                         
*    --- TO CHECK IF "WEB DC"                                                   
%WL10WBDC                                                                       
*                                                                               
%WORKAREA                                                                       
*                                                                               
*---------------- LÄNKAREA FÖR DATUMKORT                                        
%WDATKORT     'DAT-'                                                            
WDATKONV        W  8   A   VALUE 'WDATKONV'                                     
WORKDAY         W  8   A   VALUE 'WORKDAY '                                     
W418OKOD        W  8   A   VALUE 'W418OKOD'                                     
PROGRAM-NAMN    W  6   A   VALUE 'W42837'                                       
DATUMKORT-ID    W  6   A   VALUE 'WDATUM'                                       
*                                                                               
JA              W  1   A   VALUE 'J'                                            
NEJ             W  1   A   VALUE 'N'                                            
YES             W  1   A   VALUE 'Y'                                            
HELP-IDDC       W  2   A                                                        
WS-IDDC-RET     W  2   A                                                        
WS-IDDISTR      W  4   N   0                                                    
WS-IDKUNDNR     W  6   N   0                                                    
WS-IDRAPPNR     W  7   N   0                                                    
WS-TOT-KVDAGAR  W  4   N   0                                                    
W-TIAAVV-ALFA   W  4   A                                                        
W-TIAAVV-NUM    W  4   N                                                        
WS-LEV-BINDATE  W  6   N                                                        
WS-DATEDIFF     W  6   N                                                        
WS-DATUM        W  6   N                                                        
WS-AAR          WS-DATUM   2         N                                          
WS-MAANAD       WS-DATUM  +2  2      N                                          
WS-DAG          WS-DATUM  +4  2      N                                          
TEMP-IDDC       W  2   A        VALUE  '  '                                     
TEMP-IDFTG      W  2   N   0                                                    
TEMP-SURADER    W  9   N   0                                                    
TEMP-KDANMTYP   W  1   N   0                                                    
WS-SURADER      W  9   N   0                                                    
*                                                                               
W-KONV-AAAAMMDD W  8   N                                                        
W-KONV-AAMMDD   W-KONV-AAAAMMDD +2  6  N                                        
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEP 1A READ FILE AND SELECT THE RECORDS WITH COMPANY CODE 57 AND 60          
*      1B SELECT ONLY LDC AND CHINA DC RECORDS WITH DISCREPENCY REASON          
*         CODES EQUAL TO RETURN PERMIT STATUS                                   
*      1C CHECK IF RETURN DATE IS GREATER THAN ZERO                             
*------------------------------------------------------------                   
*                                                                               
JOB INPUT W42837D1 START A-INIT                                                 
*                                                                               
IF W42837-IDPTYP = '201'                                                        
   ANM-WDA201 = WDA201-DATA                                                     
ELSE                                                                            
 IF W42837-IDPTYP = '211'                                                       
     LEV-WDA211 = WDA211-DATA                                                   
       HELP-IDDC      = LEV-IDDC-RET                                            
       PERFORM S23-CHECK-HELP-IDDC                                              
       PERFORM X-CHECK-IF-WEB-REPORT                                            
   IF WBDC-FLWEBDC = 'J'                                                        
          OKOD-KDANMORS  = LEV-KDANMORS                                         
          CALL W418OKOD USING OKOD-W418OKOD                                     
    IF OKOD-FL-RETILL = JA OR OKOD-FL-INTERNUPPACKNING = JA                     
           DAT-KDDATFORM                            = 'AAMMDD'                  
     IF ANM-DARETANK > +0                                                       
            W42837-DARETANK                       = ANM-DARETANK                
*STEP2: CHECK BINNING DATE FOR TODAYS DATE                                      
       IF LEV-TIINLINL > +0                                                     
         DAT-I-TIDATUM                          = LEV-TIINLINL                  
         CALL WDATKONV USING (DAT-KDDATFORM     +                               
                            DAT-I-TIDATUM      +                                
                            DAT-O-TIDATUM      +                                
                            DAT-KDSVAR)                                         
         IF DAT-KDSVAR = ' '                                                    
           WS-LEV-BINDATE                       = DAT-TIAAMMDD                  
         ELSE                                                                   
           STOP EXECUTE                                                         
         END-IF                                                                 
         WS-DATEDIFF    = WS-DATUM - WS-LEV-BINDATE                             
         IF WS-DATEDIFF     =   0                                               
             W42837-TIINLINL = WS-LEV-BINDATE                                   
             W42837-IDFTG    = ANM-IDFTG                                        
             W42837-IDDC-RET = LEV-IDDC-RET                                     
             W42837-IDDISTR  = ANM-IDDISTR                                      
             W42837-IDKUNDNR = ANM-IDKUNDNR                                     
             W42837-IDRAPPNR = ANM-IDRAPPNR                                     
             W42837-KDANMORS = LEV-KDANMORS                                     
                                                                                
           IF LEV-KVRETINL > 0                                                  
             W42837-KVRETINL = 1                                                
           ELSE                                                                 
             W42837-KVRETINL = 0                                                
           END-IF                                                               
           IF LEV-KVAVV-KVANT > 0                                               
             W42837-KVAVV-KVANT = 1                                             
           ELSE                                                                 
             W42837-KVAVV-KVANT = 0                                             
           END-IF                                                               
           IF LEV-KVRETINL-SKR > 0                                              
             W42837-KVRETINL-SKR = 1                                            
           ELSE                                                                 
             W42837-KVRETINL-SKR = 0                                            
           END-IF                                                               
           IF LEV-KVAVV-KVAL > 0                                                
             W42837-KVAVV-KVAL = 1                                              
           ELSE                                                                 
             W42837-KVAVV-KVAL = 0                                              
           END-IF                                                               
*---     ELSE                                                                   
*---       DISPLAY 'DATES NOT SAME' WS-DATUM WS-LEV-BINDATE                     
         END-IF                                                                 
       END-IF                                                                   
*STEP2: CALCULATE THE TIME FROM RETURING TO BINNING                             
        IF LEV-TIINLINL > +0 AND +                                              
          ANM-DARETANK > +0                                                     
          WORK-KDCALL = 001                                                     
          WORK-IDDC   = LEV-IDDC-RET                                            
          W-KONV-AAAAMMDD  = ANM-DARETANK                                       
          WORK-TIAAMMDD-FOM = W-KONV-AAMMDD                                     
*         W-KONV-AAAAMMDD  = LEV-TIINLINL                                       
          WORK-TIAAMMDD-TOM = WS-LEV-BINDATE                                    
          CALL WORKDAY  USING (WORK-KDCALL     +                                
                              WORK-DATE-AREA  +                                 
                              WORK-KDSVAR)                                      
          IF WORK-KDSVAR = ' '                                                  
            W42837-KVDAGAR-INL = WORK-KVWORKD                                   
            IF  WS-DATEDIFF     =   0                                           
            PUT W42837D2                                                        
            END-IF                                                              
          END-IF                                                                
        END-IF                                                                  
                                                                                
                                                                                
*STEP3: CHECK FOR NOT BINNED LINES. IF THE LINES ARE NOT TREATED THEN           
*       THE BINNING DATE IS ZERO.                                               
            IF LEV-TIINLINL = 0                                                 
              IF LEV-KDKREBEH      = 'Y' OR  +                                  
                 LEV-KDKREBEH      = 'J' OR  +                                  
                 LEV-KDKREBEH      = 'C'                                        
                   T2-SURADER = WS-SURADER + 1                                  
                   T2-IDFTG   = LEV-IDFTG                                       
                   T2-IDDC-RET = LEV-IDDC-RET                                   
                   PUT TEMPFIL1                                                 
              END-IF                                                            
            END-IF                                                              
*--  ELSE                                                                       
*--      DISPLAY 'ANM-DARETANK NOT > 0=' ANM-DARETANK                           
     END-IF                                                                     
    END-IF                                                                      
   END-IF                                                                       
 END-IF                                                                         
END-IF                                                                          
                                                                                
NEWPAGE                                                                         
*--------------------------------------------------------*                      
* A-INIT  HÄMTAR DAGENS DATUM, INNEVARANDE ÅR-MÅN-DAG    *                      
*--------------------------------------------------------*                      
*                                                                               
 A-INIT.  PROC                                                                  
*                                                                               
 CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DAT-DATUMKORT)                   
*                                                                               
 WS-AAR    = DAT-D-AAR                                                          
 WS-MAANAD = DAT-D-MAANAD                                                       
 WS-DAG    = DAT-D-DAG                                                          
                                                                                
 DISPLAY ' INNEVARANDE DATUM ' WS-DATUM                                         
 END-PROC                                                                       
                                                                                
                                                                                
*    --- S23-CHECK-HELP-IDDC (MACRO PROCEDUR)                                   
%WWDC02 'HELP-'                                                                 
*                                                                               
NEWPAGE                                                                         
X-CHECK-IF-WEB-REPORT. PROC                                                     
   WBDC-IDDC = HELP-IDDC                                                        
   CALL WL10WBDC USING WBDC-AREA                                                
END-PROC                                                                        
                                                                                
*                                                                               
*STEP4 :SORT THE FILE ON COMPANY CODE, RETURN DC, DIST ID, CUST ID,             
*       DISC REPORT NO, DISC REPORT CODE                                        
                                                                                
SORT W42837D2 TO W42837D2 USING +                                               
        (W42837-IDFTG, W42837-IDDC-RET, W42837-KDANMORS)                        
                                                                                
*STEP5 :SORT THE FILE ON COMPANY CODE AND RETURN DC                             
                                                                                
SORT TEMPFIL1 TO TEMPFIL1 USING +                                               
        (T2-IDFTG, T2-IDDC-RET)                                                 
                                                                                
*STEP6 :ADD THE NON BINNED LINES FOR DC AND THE FINAL FILE WILL HAVE            
*       ONE ROW FOR EACH DC.                                                    
NEWPAGE                                                                         
*                                                                               
JOB INPUT NULL                                                                  
  GET TEMPFIL1                                                                  
DO WHILE NOT EOF TEMPFIL1                                                       
   IF T2-IDDC-RET      = TEMP-IDDC                                              
        TEMP-IDDC      = T2-IDDC-RET                                            
        TEMP-SURADER   = TEMP-SURADER + T2-SURADER                              
        TEMP-IDFTG     = T2-IDFTG                                               
        GET TEMPFIL1                                                            
   ELSE                                                                         
      IF TEMP-IDDC     = '  '                                                   
        TEMP-IDDC      = T2-IDDC-RET                                            
        TEMP-SURADER   = T2-SURADER                                             
        TEMP-IDFTG     = T2-IDFTG                                               
        GET TEMPFIL1                                                            
      ELSE                                                                      
        W42838-IDDC-RET = TEMP-IDDC                                             
        W42838-SURADER  = TEMP-SURADER                                          
        W42838-IDFTG    = TEMP-IDFTG                                            
        PUT W42837D3                                                            
        TEMP-IDDC       = T2-IDDC-RET                                           
        TEMP-SURADER    = T2-SURADER                                            
        TEMP-IDFTG      = T2-IDFTG                                              
        GET TEMPFIL1                                                            
      END-IF                                                                    
   END-IF                                                                       
   IF EOF TEMPFIL1                                                              
        W42838-IDDC-RET = TEMP-IDDC                                             
        W42838-SURADER  = TEMP-SURADER                                          
        W42838-IDFTG    = TEMP-IDFTG                                            
        PUT W42837D3                                                            
   END-IF                                                                       
 END-DO                                                                         
 STOP                                                                           
