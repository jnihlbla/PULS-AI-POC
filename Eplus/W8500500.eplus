FILE W85005D1 FB (189 6048)                                                     
%W850010E                                                                       
NEWPAGE                                                                         
FILE MITTFIL VIRTUAL FB (209 6061)                                              
%W85001AE  'ME-'                                                                
NEWPAGE                                                                         
FILE SLUTFIL VIRTUAL FB (209 6061)                                              
%W85001AE 'SL-'                                                                 
NEWPAGE                                                                         
FILE W85005D2 FB (189 6048)                                                     
%W850010E  'UT1-'                                                               
NEWPAGE                                                                         
FILE W85005D3 FB (128 6144)                                                     
%W850011E  'UT-'                                                                
UT-KDALDER  87 1 P 0                                                            
UT-KVQPACK  88 3 P 0                                                            
UT-KVPACKST 91 3 P 0                                                            
*                                                                               
NEWPAGE                                                                         
**********ARBETSFÄLT*******************************                             
*W-FÄLT TILL BERÄKNING AV VR STOCK LEVEL                                        
W-OML      W 4 P 0                                                              
W-HALVA    W 4 P 0                                                              
W-QMAX     W 4 P 0                                                              
W-LEDPROG  W 4 P 0                                                              
W-QBULK    W 2 P 0                                                              
* W-FÄLT TILL KONTROLL AV INPUTFILEN                                            
ACC1   W 5 N 0                                                                  
ACC2   W 5 N 0                                                                  
ACC3   W 5 N 0                                                                  
ACC4   W 5 N 0                                                                  
ACC5   W 5 N 0                                                                  
ACC6   W 5 N 0                                                                  
ACC7   W 5 N 0                                                                  
ACC8   W 5 N 0                                                                  
ACC9   W 5 N 0                                                                  
ACC10  W 5 N 0                                                                  
ACC11  W 5 N 0                                                                  
ACC12  W 5 N 0                                                                  
ACC13  W 5 N 0                                                                  
ACC14  W 5 N 0                                                                  
ACC15  W 5 N 0                                                                  
ACC16  W 5 N 0                                                                  
SLÄNG  W 1 N                                                                    
W-PARTNO2 W 13 A                                                                
*W-FÄLT TILL MAXISTOCK CALCULATION PROGRAM                                      
W-KVVRAA      W 5 A                                                             
W-KVVRA       W 5 P                                                             
W-KVVRMA      W 5 A                                                             
W-KVVRM       W 5 P                                                             
W-PARTNO  W 13 N                                                                
W-PARTNO1 W-PARTNO 12 N                                                         
W-KDCHSIF W-PARTNO +12 1 N                                                      
KORR      W 7 P 2                                                               
KORR1     W 3 P 2                                                               
A1        W 3 P 0                                                               
A2        W 3 P 0                                                               
PRPIEC1   W 9 N 0                                                               
PRVO1     W 13 N 0                                                              
PRVA1     W 12 N 3                                                              
VSPIEC1   W 9 N 0                                                               
VSVO1     W 13 N 0                                                              
VSVA1     W 12 N 3                                                              
VSPIEC2   W 9 N 0                                                               
VSVO2     W 13 N 0                                                              
VSVA2     W 12 N 3                                                              
VRPIEC1   W 9 N 0                                                               
VRVO1     W 13 N 0                                                              
VRVA1     W 12 N 3                                                              
VRPIEC2   W 9 N 0                                                               
VRVO2     W 13 N 0                                                              
VRVA2     W 12 N 3                                                              
REPIEC1   W 9 N 0                                                               
REVO1     W 13 N 0                                                              
REVA1     W 12 N 3                                                              
REPIEC2   W 9 N 0                                                               
REVO2     W 13 N 0                                                              
REVA2     W 12 N 3                                                              
PRPIEC    W 4 N 0                                                               
PRVO      W 4 N 0                                                               
PRVA      W 6 N 3                                                               
VSPIEC    W 4 N 0                                                               
VSPIECA   W 4 N 0                                                               
VSVO      W 4 N 0                                                               
VSVOA     W 4 N 0                                                               
VSVA      W 6 N 3                                                               
VSVAA     W 6 N 3                                                               
VRPIEC    W 4 N 0                                                               
VRPIECA   W 4 N 0                                                               
VRVO      W 4 N 0                                                               
VRVOA     W 4 N 0                                                               
VRVA      W 6 N 3                                                               
VRVAA     W 6 N 3                                                               
REPIEC    W 4 N 0                                                               
REPIECA   W 4 N 0                                                               
REVO      W 4 N 0                                                               
REVOA     W 4 N 0                                                               
REVA      W 6 N 3                                                               
REVAA     W 6 N 3                                                               
                                                                                
*   --  CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT W85005D1                                                              
* DESSA SATSER MÖJLIGGÖR UTSKRIFT AV FÄLT SOM KAN VARA BLANKA                   
IF KDREPA  SPACE                                                                
  KDREP = 0                                                                     
END-IF                                                                          
IF TILEDA  SPACE                                                                
  TILED = 0                                                                     
END-IF                                                                          
IF KVSLA  SPACE                                                                 
  KVSL = 0                                                                      
END-IF                                                                          
IF KVBPA  SPACE                                                                 
  KVBP = 0                                                                      
END-IF                                                                          
IF KVTEORA  SPACE                                                               
  KVTEOR = 0                                                                    
END-IF                                                                          
IF KVHANDA  SPACE                                                               
  KVHAND = 0                                                                    
END-IF                                                                          
IF KVQPACKA  SPACE                                                              
  KVQPACK = 0                                                                   
END-IF                                                                          
IF KVPACKSTA  SPACE                                                             
  KVPACKST = 0                                                                  
END-IF                                                                          
IF KVFCASTA  SPACE                                                              
  KVFCAST = 0                                                                   
END-IF                                                                          
IF FSGIAR NOT NUMERIC                                                           
  FSGIAR = 0                                                                    
END-IF                                                                          
IF FSGFAR NOT NUMERIC                                                           
  FSGFAR = 0                                                                    
END-IF                                                                          
*************************************************                               
* LÅGFREKVENTA ARTIKLAR                                                         
*************************************************                               
IF FLLAGFRE = 'J'                                                               
  PERFORM LÅGFREKVENT                                                           
ELSE                                                                            
*************************************************                               
* HÖGFREKVENTA ARTIKLAR                                                         
*************************************************                               
  PERFORM HÖGFREKVENT                                                           
END-IF                                                                          
KVOMS = W-OML                                                                   
**************************************************                              
* LAGERSALDOT LÄGGS I VR STOCK LEVEL OM ARTIKELNS PROGNOS ÄR NOLL               
**************************************************                              
IF KVFCAST = 0                                                                  
  W-KVVRM = KVHAND                                                              
  W-KVVRA = KVHAND                                                              
END-IF                                                                          
*************************************************                               
* ERSÄTTNINGAR LAGERSALDOT LÄGGS I VR STOCK LEVEL                               
*************************************************                               
IF KDREP = 1 THRU 6                                                             
  W-KVVRM = KVHAND                                                              
  W-KVVRA = KVHAND                                                              
END-IF                                                                          
ME-W850010 = W850010                                                            
ME-KVVRA = W-KVVRA                                                              
ME-KVVRM = W-KVVRM                                                              
ME-FLLAGFRE = FLLAGFRE                                                          
PUT MITTFIL                                                                     
*************************************************                               
* FIX FÖR ATT FÅ MED VR STOCK LEVEL FÖR LEVANDE                                 
* ARTIKLAR                                                                      
*************************************************                               
KVVSOPA = W-KVVRA                                                               
KVVSOPM = W-KVVRM                                                               
PUT W85005D2 FROM W85005D1                                                      
*****************************************************                           
* PROCEDURER                                                                    
*****************************************************                           
LÅGFREKVENT. PROC                                                               
  IF KVQPACK = 0 AND KVPACKST = 0                                               
    PERFORM LAG1                                                                
  ELSE                                                                          
    IF KVPACKST >= KVQPACK                                                      
      W-QMAX = KVPACKST                                                         
      PERFORM LAG2                                                              
    ELSE                                                                        
      W-QMAX = KVQPACK                                                          
      PERFORM LAG2                                                              
    END-IF                                                                      
  END-IF                                                                        
END-PROC                                                                        
LAG1. PROC                                                                      
    W-KVVRM = KVBP + 0.5                                                        
    W-LEDPROG =((KVFCAST / 4) * TILED) + 0.5                                    
    W-KVVRA = W-KVVRM - W-LEDPROG                                               
    W-OML = (W-KVVRM - W-KVVRA) * 2                                             
END-PROC                                                                        
LAG2. PROC                                                                      
  W-QBULK = (KVTEOR / W-QMAX)                                                   
  IF W-QBULK = 0                                                                
    W-QBULK = 1                                                                 
  END-IF                                                                        
  W-OML = W-QBULK * W-QMAX                                                      
  W-KVVRM = KVBP + W-OML - 0.5                                                  
  W-HALVA = W-OML / 2 + 0.5                                                     
  W-KVVRA = W-KVVRM - W-HALVA                                                   
END-PROC                                                                        
HÖGFREKVENT. PROC                                                               
  IF KVQPACK > 0 OR KVPACKST > 0                                                
    IF KVPACKST >= KVQPACK                                                      
      W-QMAX = KVPACKST                                                         
    ELSE                                                                        
      W-QMAX = KVQPACK                                                          
    END-IF                                                                      
    W-QBULK = (KVTEOR / W-QMAX) + 0.5                                           
    IF W-QBULK = 0                                                              
      W-QBULK = 1                                                               
    END-IF                                                                      
    W-OML = W-QBULK * W-QMAX                                                    
    W-KVVRM = W-OML + KVSL + 0.5                                                
    W-HALVA = W-OML / 2 + 0.5                                                   
    W-KVVRA = W-KVVRM - W-HALVA                                                 
  ELSE                                                                          
    W-OML = KVTEOR                                                              
    W-KVVRM = W-OML + KVSL + 0.5                                                
    W-HALVA = W-OML / 2 + 0.5                                                   
    W-KVVRA = W-KVVRM - W-HALVA                                                 
  END-IF                                                                        
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT MITTFIL FINISH SKRIV                                                  
***********************************************                                 
* HÄR SKER EN KONTROLL AV INPUTFILEN                                            
***********************************************                                 
SLÄNG = 0                                                                       
IF ME-IDFELKOD NQ 0                                                             
  ACC1 = ACC1 + 1                                                               
  SLÄNG = 1                                                                     
END-IF                                                                          
IF ME-RECTYP NQ 010 AND SLÄNG NQ 1                                              
  ACC2 = ACC2 + 1                                                               
  ME-RECTYP = 010                                                               
END-IF                                                                          
IF ME-PARTNO1 NOT NUMERIC OR ME-PARTNO1 < 0                                     
  IF SLÄNG NQ 1                                                                 
    ACC3 = ACC3 + 1                                                             
    SLÄNG = 1                                                                   
  END-IF                                                                        
END-IF                                                                          
IF ME-PRICE NOT NUMERIC OR ME-PRICE < 0                                         
  IF SLÄNG NQ 1                                                                 
    ACC4 = ACC4 + 1                                                             
    ME-PRICE = 0                                                                
  END-IF                                                                        
END-IF                                                                          
IF ME-PRODGRP NOT NUMERIC OR ME-PRODGRP < 0                                     
  IF SLÄNG NQ 1                                                                 
    ACC5 = ACC5 + 1                                                             
    ME-PRODGRP = 0                                                              
  END-IF                                                                        
END-IF                                                                          
IF ME-FUNCGRP NOT NUMERIC OR ME-FUNCGRP < 0                                     
  IF SLÄNG NQ 1                                                                 
    ACC6 = ACC6 + 1                                                             
    ME-FUNCGRP = 0                                                              
  END-IF                                                                        
END-IF                                                                          
IF ME-VVC NOT NUMERIC OR ME-VVC < 0                                             
  IF SLÄNG NQ 1                                                                 
    ACC7 = ACC7 + 1                                                             
    MOVE SPACE TO ME-VVCA                                                       
  END-IF                                                                        
END-IF                                                                          
IF ME-VOLUME NOT NUMERIC OR ME-VOLUME < 0                                       
  IF SLÄNG NQ 1                                                                 
    ACC8 = ACC8 + 1                                                             
    SLÄNG = 1                                                                   
  END-IF                                                                        
END-IF                                                                          
IF ME-WEIGHT NOT NUMERIC OR ME-WEIGHT < 0                                       
  IF SLÄNG NQ 1                                                                 
    ACC9 = ACC9 + 1                                                             
    ME-WEIGHT = 0                                                               
  END-IF                                                                        
END-IF                                                                          
IF ME-KVPICK NOT NUMERIC OR ME-KVPICK < 0                                       
  IF SLÄNG NQ 1                                                                 
    ACC10 = ACC10 + 1                                                           
    ME-KVPICK = 0                                                               
  END-IF                                                                        
END-IF                                                                          
IF ME-KVHAND NOT NUMERIC OR ME-KVHAND < 0                                       
  IF SLÄNG NQ 1                                                                 
    ACC11 = ACC11 + 1                                                           
    ME-KVHAND = 0                                                               
  END-IF                                                                        
END-IF                                                                          
IF ME-KVORDER NOT NUMERIC OR ME-KVORDER < 0                                     
  IF SLÄNG NQ 1                                                                 
    ACC12 = ACC12 + 1                                                           
    ME-KVORDER = 0                                                              
  END-IF                                                                        
END-IF                                                                          
IF ME-KVFCAST NOT NUMERIC OR ME-KVFCAST < 0                                     
  IF SLÄNG NQ 1                                                                 
    ACC13 = ACC13 + 1                                                           
    ME-KVFCAST = 0                                                              
  END-IF                                                                        
END-IF                                                                          
IF ME-KDMG NOT NUMERIC OR ME-KDMG < 0                                           
  IF SLÄNG NQ 1                                                                 
    ACC14 = ACC14 + 1                                                           
    ME-KDMG = 0                                                                 
  END-IF                                                                        
END-IF                                                                          
IF RECORD-COUNT = 1                                                             
  W-PARTNO2 = ME-PARTNO                                                         
ELSE                                                                            
  IF ME-PARTNO = W-PARTNO2 AND SLÄNG NQ 1                                       
    ACC15 = ACC15 + 1                                                           
    SLÄNG = 1                                                                   
  ELSE                                                                          
    W-PARTNO2 = ME-PARTNO                                                       
  END-IF                                                                        
END-IF                                                                          
IF ME-KVHAND = 0 AND ME-KVORDER = 0                                             
  IF ME-KVFCAST = 0 AND SLÄNG NQ 1                                              
    ACC16 = ACC16 + 1                                                           
    SLÄNG = 1                                                                   
  END-IF                                                                        
END-IF                                                                          
IF SLÄNG NQ 1                                                                   
  PUT SLUTFIL FROM MITTFIL                                                      
END-IF                                                                          
**************************************************                              
* PÅ SLUTFILEN LÄGGS ENDAST ARTNR MED KORREKTA DATA                             
**************************************************                              
SKRIV. PROC                                                                     
  DISPLAY NEWPAGE COL 3, 'V.S.O.P', COL 50, 'INPUT FILE CONTROL LIST' +         
                  , COL 95, SYSDATE                                             
  DISPLAY SKIP 2 'LIVING AND DEAD PARTS ON INPUT FILE', COL 70, ACC1            
  DISPLAY SKIP 1 'PARTS WITH WRONG RECORD TYPE', COL 55, ACC2                   
  DISPLAY SKIP 1 'PARTS WITH PARTNO NOT NUMERIC OR < 0', COL 55, ACC3           
  DISPLAY SKIP 1 'PARTS WITH PRICE NOT NUMERIC OR < 0', COL 70, ACC4            
  DISPLAY SKIP 1 'PARTS WITH PRODUCT GROUP NOT NUMERIC OR < 0', COL 70 +        
                 ACC5                                                           
  DISPLAY SKIP 1 'PARTS WITH FUNCTION GROUP NOT NUMERIC OR < 0', +              
                 COL 70, ACC6                                                   
  DISPLAY SKIP 1 'PARTS WITH VVC NOT NUMERIC OR < 0', COL 70, ACC7              
  DISPLAY SKIP 1 'PARTS WITH VOLUME NOT NUMERIC OR < 0', COL 70, ACC8           
  DISPLAY SKIP 1 'PARTS WITH WEIGHT NOT NUMERIC OR < 0', COL 70, ACC9           
  DISPLAY SKIP 1 'PARTS WITH PICKING FREQUENCY NOT NUMERIC OR < 0' +            
                 COL 70, ACC10                                                  
  DISPLAY SKIP 1 'PARTS WITH STOCK ON HAND NOT NUMERIC OR < 0', COL 55 +        
                 ACC11                                                          
  DISPLAY SKIP 1 'PARTS WITH STOCK ON ORDER NOT NUMERIC OR < 0', +              
                 COL 55, ACC12                                                  
  DISPLAY SKIP 1 'PARTS WITH FORECAST NOT NUMERIC OR < 0', COL 55, ACC13        
  DISPLAY SKIP 1 'PARTS WITH MG NOT NUMERIC OR < 0', COL 70, ACC14              
  DISPLAY SKIP 1 'PARTS WITH EQUAL PARTNO', COL 55, ACC15                       
  DISPLAY SKIP 1 'DEAD PARTS ON INPUT FILE', COL 55, ACC16                      
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT SLUTFIL FINISH RÄKNARE                                                
*                                                                               
IF SL-PARTNO NOT NUMERIC                                                        
  SL-PARTNO1 = 0                                                                
  SL-KDCHSIF = 0                                                                
END-IF                                                                          
IF SL-KDALDERA NOT NUMERIC                                                      
  SL-KDALDER = 0                                                                
END-IF                                                                          
UT-KVPRESEN = SL-KVHAND                                                         
IF SL-TILED NOT SPACE AND SL-TILED > 0                                          
  IF SL-KVFCAST NQ 0                                                            
    KORR = (SL-KVOMS / (SL-KVFCAST / 4)) / SL-TILED                             
    KORR1 = SL-PINT / SL-TILED                                                  
  ELSE                                                                          
    KORR = 1                                                                    
  END-IF                                                                        
END-IF                                                                          
IF KORR <= KORR1 AND KORR > 0                                                   
  IF SL-KVFCAST NQ 0                                                            
    KORR = KORR1                                                                
  END-IF                                                                        
END-IF                                                                          
IF KORR = 0 OR KORR >= 1                                                        
  IF SL-KVFCAST NQ 0                                                            
    KORR = 1                                                                    
  END-IF                                                                        
END-IF                                                                          
IF SL-KVFCAST = 0                                                               
  KORR = 1                                                                      
END-IF                                                                          
UT-KVREALM = (SL-KVORDER * KORR) + SL-KVHAND                                    
UT-KVREALA = (SL-KVORDER * (KORR / 2)) + SL-KVHAND                              
IF UT-KVREALM >= SL-KVVRM                                                       
  UT-KVVSOPM = UT-KVREALM                                                       
  A1 = A1 + 1                                                                   
ELSE                                                                            
IF UT-KVREALM < SL-KVVRM                                                        
  UT-KVVSOPM = SL-KVVRM                                                         
  A2 = A2 + 1                                                                   
END-IF                                                                          
END-IF                                                                          
IF UT-KVREALA >= SL-KVVRA                                                       
  UT-KVVSOPA = UT-KVREALA                                                       
ELSE                                                                            
  UT-KVVSOPA = SL-KVVRA                                                         
END-IF                                                                          
UT-KVPRESEN = UT-KVPRESEN * SL-PRESENTC                                         
UT-KVVRM = SL-KVVRM * SL-VRC                                                    
UT-KVVRA = SL-KVVRA * SL-VRC                                                    
UT-KVREALM = UT-KVREALM * SL-REALC                                              
UT-KVREALA = UT-KVREALA * SL-REALC                                              
UT-KVVSOPM = UT-KVVSOPM * SL-VSOPC                                              
UT-KVVSOPA = UT-KVVSOPA * SL-VSOPC                                              
IF UT-KVVSOPM < 1                                                               
  UT-KVVSOPM = 1                                                                
END-IF                                                                          
IF UT-KVVSOPA < 1                                                               
  UT-KVVSOPA = 1                                                                
END-IF                                                                          
*****************PRESENT STOCK LEVEL**********************                      
PRPIEC1 = PRPIEC1 + UT-KVPRESEN                                                 
PRVO1 = PRVO1 + (UT-KVPRESEN * SL-VOLUME)                                       
PRVA1 = PRVA1 + (UT-KVPRESEN * SL-PRICE)                                        
*****************VSOP STOCK LEVEL*************************                      
VSPIEC1 = VSPIEC1 + UT-KVVSOPM                                                  
VSVO1 = (UT-KVVSOPM * SL-VOLUME) + VSVO1                                        
VSVA1 = (UT-KVVSOPM * SL-PRICE) + VSVA1                                         
VSPIEC2 = VSPIEC2 + UT-KVVSOPA                                                  
VSVO2 = (UT-KVVSOPA * SL-VOLUME) + VSVO2                                        
VSVA2 = (UT-KVVSOPA * SL-PRICE) + VSVA2                                         
*****************VR STOCK LEVEL***************************                      
VRPIEC1 = VRPIEC1 + SL-KVVRM                                                    
VRVO1 = (SL-KVVRM * SL-VOLUME) + VRVO1                                          
VRVA1 = (SL-KVVRM * SL-PRICE) + VRVA1                                           
VRPIEC2 = VRPIEC2 + SL-KVVRA                                                    
VRVO2 = (SL-KVVRA * SL-VOLUME) + VRVO2                                          
VRVA2 = (SL-KVVRA * SL-PRICE) + VRVA2                                           
*****************REAL STOCK LEVEL**************************                     
REPIEC1 = REPIEC1 + UT-KVREALM                                                  
REVO1 = (UT-KVREALM * SL-VOLUME) + REVO1                                        
REVA1 = (UT-KVREALM * SL-PRICE) + REVA1                                         
REPIEC2 = REPIEC2 + UT-KVREALA                                                  
REVO2 = (UT-KVREALA * SL-VOLUME) + REVO2                                        
REVA2 = (UT-KVREALA * SL-PRICE) + REVA2                                         
*****************************************************                           
* ÖVERFLYTTNING FRÅN SLUTFIL TILL W85005D3                                      
*****************************************************                           
W-PARTNO1 = SL-PARTNO1                                                          
W-KDCHSIF = SL-KDCHSIF                                                          
UT-PARTNO = W-PARTNO                                                            
UT-DISTNO1 = SL-DISTNO1                                                         
UT-DISTNO2 = SL-DISTNO2                                                         
UT-BENAME = SL-BENAME                                                           
UT-PRICE = SL-PRICE                                                             
UT-KDVSOP1A = SL-KDVSOP1A                                                       
UT-KDVSOP2A = SL-KDVSOP2A                                                       
UT-KDVSOP3A = SL-KDVSOP3A                                                       
UT-PRODGRP = SL-PRODGRP                                                         
UT-FUNCGRP = SL-FUNCGRP                                                         
UT-KDMG = SL-KDMG                                                               
UT-VVCA = SL-VVCA                                                               
UT-VOLUME = SL-VOLUME                                                           
UT-WEIGHT = SL-WEIGHT                                                           
UT-KDREP = SL-KDREP                                                             
UT-KVPICK = SL-KVPICK                                                           
UT-ADLOCAL = SL-ADLOCAL                                                         
UT-ADVSOPA = SL-ADVSOPA                                                         
UT-KVHAND = SL-KVHAND                                                           
UT-KVORDER = SL-KVORDER                                                         
UT-KVFCAST = SL-KVFCAST                                                         
UT-KDALDER = SL-KDALDER                                                         
UT-KVQPACK = SL-KVQPACK                                                         
UT-KVPACKST = SL-KVPACKST                                                       
UT-IDFELKOD = SL-IDFELKOD                                                       
UT-KVVRM = SL-KVVRM                                                             
UT-KVVRA = SL-KVVRA                                                             
UT-RECTYP = 011                                                                 
PUT W85005D3                                                                    
*****************************************************                           
* HÄR KORRIGERAS OCH PRINTAS DE OLIKA LAGERNIVÅERNA                             
*****************************************************                           
RÄKNARE. PROC                                                                   
* PRESENT STOCK LEVEL                                                           
  PRPIEC = PRPIEC1 / 1000 + 0.5                                                 
  PRVO = PRVO1 / 1000000 + 0.5                                                  
  PRVA = PRVA1 / 1000000                                                        
* VSOP STOCK LEVEL                                                              
  VSPIEC = VSPIEC1 / 1000 + 0.5                                                 
  VSVO = VSVO1 / 1000000 + 0.5                                                  
  VSVA = VSVA1 / 1000000                                                        
  VSPIECA = VSPIEC2 / 1000 + 0.5                                                
  VSVOA = VSVO2 / 1000000 + 0.5                                                 
  VSVAA = VSVA2 / 1000000                                                       
* VR STOCK LEVEL                                                                
  VRPIEC = VRPIEC1 / 1000 + 0.5                                                 
  VRVO = VRVO1 / 1000000 + 0.5                                                  
  VRVA = VRVA1 / 1000000                                                        
  VRPIECA = VRPIEC2 / 1000 + 0.5                                                
  VRVOA = VRVO2 / 1000000 + 0.5                                                 
  VRVAA = VRVA2 / 1000000                                                       
* REAL STOCK LEVEL                                                              
  REPIEC = REPIEC1 / 1000 + 0.5                                                 
  REVO = REVO1 / 1000000 + 0.5                                                  
  REVA = REVA1 / 1000000                                                        
  REPIECA = REPIEC2 / 1000 + 0.5                                                
  REVOA = REVO2 / 1000000 + 0.5                                                 
  REVAA = REVA2 / 1000000                                                       
****************************************************                            
* PRINTNING AV MAXISTOCK CALCULATION LEVEL                                      
****************************************************                            
  DISPLAY NEWPAGE COL 3, 'A1  ' A1                                              
  DISPLAY         COL 3, 'A2  ' A2                                              
  DISPLAY NEWPAGE COL 3, 'V.S.O.P', COL 50, 'MAXISTOCK CALCULATION +            
                  CONTROL LIST', COL 95, SYSDATE                                
  DISPLAY SKIP 2  COL 27, 'PRESENT', COL 48, 'VSOP', COL 74, 'VR', +            
                  COL 98, 'REAL'                                                
  DISPLAY         COL 27, 'STOCK LEVEL', COL 48, 'STOCK LEVEL', COL 74 +        
                  , 'STOCK LEVEL', COL 98, 'STOCK LEVEL'                        
  DISPLAY         COL 27, 'MAXIMUM   AVERAGE', COL 48, 'MAXIMUM   +             
                  AVERAGE', COL 74, 'MAXIMUM   AVERAGE', COL 98 +               
                  , 'MAXIMUM   AVERAGE'                                         
  DISPLAY SKIP 5 'NO OF PIECES, 1000', COL 31, PRPIEC , COL 44, VSPIEC +        
                 , COL 56, VSPIECA , COL 69, VRPIEC , COL 81, VRPIECA +         
                 , COL 94, REPIEC , COL 106, REPIECA                            
  DISPLAY SKIP 2 'STOCK VOLUME, M3', COL 31, PRVO , COL 44, VSVO , +            
                 COL 56, VSVOA , COL 69, VRVO , COL 81, VRVOA , COL 94 +        
                 , REVO , COL 106, REVOA                                        
  DISPLAY SKIP 2 'STOCK VALUE, 1000', COL 29, PRVA , COL 42, VSVA , +           
                 COL 54, VSVAA , COL 67, VRVA , COL 79, VRVAA , +               
                 COL 92, REVA , COL 104, REVAA                                  
END-PROC                                                                        
