TITEL-RUBRIK-1-S      W 41 A                                       +            
      VALUE 'ARTIKLAR FÖR UPPDATERING AV KONTROLLKOD  '                         
NEWPAGE                                                                         
*                                                                               
* ENGELSK TEXT                                                                  
*                                                                               
TITEL-RUBRIK-1-GB     W 41 A                                       +            
      VALUE 'PARTS FOR UPDATING OF THE INSPECTION CODE'                         
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
* STEG 1. SKRIVER LISTA                                                         
*                                                                               
JOB INPUT W42665D1                                                              
                                                                                
    IF SPAR-IDARTNR NE IN-IDARTNR                                               
      SPAR-IDARTNR   =   IN-IDARTNR                                             
      WS-IDARTNR     =   IN-IDARTNR                                             
      WS-ADKVAULG    =   IN-ADKVAULG                                            
      WS-BEART       =   IN-BEART                                               
      WS-IDBERED     =   IN-IDBERED                                             
      WS-IDFKNGRP    =   IN-IDFKNGRP                                            
      WS-IDLEVNR-OLD =   IN-IDLEVNR-OLD                                         
      WS-IDLEVNR-NEW =   IN-IDLEVNR-NEW                                         
      WS-KDERS       =   IN-KDERS                                               
      WS-KDFARLIG    =   IN-KDFARLIG                                            
      WS-BEFT        =   IN-BEFT                                                
      WS-KDKVAKTL    =   IN-KDKVAKTL                                            
      WS-KDVVKL      =   IN-KDVVKL                                              
      WS-KDYTBEH     =   IN-KDYTBEH                                             
      WS-TEXT        =   IN-TEXT                                                
      WS-PRARTSTD    =   IN-PRARTSTD                                            
      WS-TIFINLV     =   IN-TIFINLV                                             
      WS-AAVV        =   WS-TIAAVV                                              
      WS-TIKVASAK    =   IN-TIKVASAK                                            
      WS-IDANSK-TEST =   IN-IDANSK / 100                                        
      WS-IDANSK      =   IN-IDANSK                                              
                                                                                
      IF WS-IDFKNGRP = 1000 THRU 2999                                           
        PRINT LISTA-001                                                         
      ELSE                                                                      
        IF WS-IDFKNGRP = 3000 THRU 3999                                         
          PRINT LISTA-002                                                       
        ELSE                                                                    
          IF WS-IDFKNGRP = 8000 THRU 8699, 8800 THRU 8899                       
            PRINT LISTA-003                                                     
          ELSE                                                                  
            PRINT LISTA-004                                                     
          END-IF                                                                
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
REPORT LISTA-001 PRINTER W42665D2 LINESIZE 120                      +           
                  SPACE 1 NODATE NOADJUST DTLCTL FIRST                          
                                                                                
