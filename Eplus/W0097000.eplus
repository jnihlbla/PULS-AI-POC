FILE W00970D1                                                                   
%WDATAREA 'W-'                                                                  
*                                                                               
W-TIAAVV       W          4    N                                                
W-TIAVV    W-TIAAVV +1    3    N                                                
W-TIAA     W-TIAAVV       2    N                                                
W-TIVV     W-TIAAVV +2    2    N                                                
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
JOB INPUT NULL START SÄTT-RC                                                    
*                                                                               
 STOP                                                                           
*                                                                               
SÄTT-RC.  PROC                                                                  
*                                                                               
W-DAT-KDDATFORM = 'IDAG  '                                                      
CALL WDATKONV USING (W-DAT-KDDATFORM W-DAT-I-TIDATUM W-DAT-O-TIDATUM +          
                     W-DAT-KDSVAR)                                              
W-TIAA = W-DAT-TIAA-VECKA                                                       
W-TIVV = W-DAT-TIVV                                                             
*                                                                               
RETURN-CODE = W-TIAAVV                                                          
*                                                                               
END-PROC                                                                        
