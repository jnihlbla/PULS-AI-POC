                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  WDMW0800                                              *        
*                                                                      *        
*  FUNKTION   :  SORTERA OCH PLOCCKA BORT DUBLETTER                    *        
*                PROGRAM                                               *        
*                                                                      *        
*  FÖRFATTARE :  ODD OLSEN                                             *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE WDMR08D1                                                                   
*                                                                               
  IN-POST              1 95 A                                                   
  IN-PGM               1 22 A                                                   
                                                                                
NEWPAGE                                                                         
FILE TEMP FB(95 23465) VIRTUAL                                                  
*                                                                               
  TEMP-POST            1 95 A                                                   
  TEMP-PGM             1 22 A                                                   
                                                                                
NEWPAGE                                                                         
FILE WDMR08D2 FB(95 23465)                                                      
*                                                                               
  UT-POST              1 95 A                                                   
  UT-PGM               1 22 A                                                   
                                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
* ARBETSAREA                                                                    
*                                                                               
  SPAR-POST            W 95 A                                                   
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
* SORT                                                                          
*                                                                               
SORT WDMR08D1 TO +                                                              
     TEMP USING (IN-POST)                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
* BEARBETA                                                                      
*                                                                               
JOB INPUT(TEMP)                                                                 
                                                                                
    IF TEMP-POST ^= SPAR-POST                                                   
      PUT WDMR08D2 FROM TEMP                                                    
      SPAR-POST = TEMP-POST                                                     
    END-IF                                                                      
                                                                                
    GOTO JOB                                                                    
                                                                                
STOP                                                                            
