        W-MARKNADS-GRP = BILD02-MARKNADS-GRP(5)                                 
        W-KDMARK-BUDG05-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG05-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP = BILD02-MARKNADS-GRP(6)                                 
        W-KDMARK-BUDG06-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG06-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP = BILD02-MARKNADS-GRP(7)                                 
        W-KDMARK-BUDG07-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG07-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP = BILD02-MARKNADS-GRP(8)                                 
        W-KDMARK-BUDG08-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG08-T = W-KDMARK-BUDG-TOM                                   
                                                                                
        W-DISTRIKT-GRP = BILD02-DISTRIKT-GRP(1)                                 
        W-IDDISTR01-F = W-IDDISTR-FOM                                           
        W-IDDISTR01-T = W-IDDISTR-TOM                                           
        W-DISTRIKT-GRP = BILD02-DISTRIKT-GRP(2)                                 
        W-IDDISTR02-F = W-IDDISTR-FOM                                           
        W-IDDISTR02-T = W-IDDISTR-TOM                                           
        W-DISTRIKT-GRP = BILD02-DISTRIKT-GRP(3)                                 
        W-IDDISTR03-F = W-IDDISTR-FOM                                           
        W-IDDISTR03-T = W-IDDISTR-TOM                                           
        W-DISTRIKT-GRP = BILD02-DISTRIKT-GRP(4)                                 
        W-IDDISTR04-F = W-IDDISTR-FOM                                           
        W-IDDISTR04-T = W-IDDISTR-TOM                                           
        W-ANSKAFFAR-GRP = BILD02-ANSKAFFAR-GRP                                  
        W-IDANSK01-F = W-IDANSK-FOM                                             
        W-IDANSK01-T = W-IDANSK-TOM                                             
        W-ANSKAFFAR-GRP = BILD02-ANSKAFFAR-GRP(2)                               
        W-IDANSK02-F = W-IDANSK-FOM                                             
        W-IDANSK02-T = W-IDANSK-TOM                                             
        W-ANSKAFFAR-GRP = BILD02-ANSKAFFAR-GRP(3)                               
        W-IDANSK03-F = W-IDANSK-FOM                                             
        W-IDANSK03-T = W-IDANSK-TOM                                             
        W-ANSKAFFAR-GRP = BILD02-ANSKAFFAR-GRP(4)                               
        W-IDANSK04-F = W-IDANSK-FOM                                             
        W-IDANSK04-T = W-IDANSK-TOM                                             
        W-SOEK-IX = 1                                                           
        DO WHILE W-SOEK-IX < 100                                                
           PERFORM FLYTTA-FUNKTIONSGRUPPER                                      
           IF BILD02-IDPTYP = 'P1'                                              
             PRINT RAPPORT02                                                    
           ELSE                                                                 
             PRINT RAPPORT12                                                    
           END-IF                                                               
        END-DO                                                                  
     ELSE                                                                       
        SPAR-KDNIVA = 4                                                         
        W-REGDATUM = BILD03-DAREGDAT                                            
        W-REGTID = BILD03-TIREGTID                                              
                                                                                
        W-IDKONCNR01 = BILD03-IDKONCNR(1)                                       
        W-IDKONCNR02 = BILD03-IDKONCNR(2)                                       
        W-IDKONCNR03 = BILD03-IDKONCNR(3)                                       
        W-IDKONCNR04 = BILD03-IDKONCNR(4)                                       
        W-IDKONCNR05 = BILD03-IDKONCNR(5)                                       
        W-IDKONCNR06 = BILD03-IDKONCNR(6)                                       
        W-IDKONCNR07 = BILD03-IDKONCNR(7)                                       
        W-IDKONCNR08 = BILD03-IDKONCNR(8)                                       
                                                                                
        W-MARKNADS-GRP = BILD03-MARKNADS-GRP(1)                                 
        W-KDMARK-BUDG01-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG01-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP = BILD03-MARKNADS-GRP(2)                                 
        W-KDMARK-BUDG02-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG02-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP = BILD03-MARKNADS-GRP(3)                                 
        W-KDMARK-BUDG03-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG03-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP = BILD03-MARKNADS-GRP(4)                                 
        W-KDMARK-BUDG04-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG04-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP = BILD03-MARKNADS-GRP(5)                                 
        W-KDMARK-BUDG05-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG05-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP = BILD03-MARKNADS-GRP(6)                                 
        W-KDMARK-BUDG06-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG06-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP = BILD03-MARKNADS-GRP(7)                                 
        W-KDMARK-BUDG07-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG07-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP = BILD03-MARKNADS-GRP(8)                                 
        W-KDMARK-BUDG08-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG08-T = W-KDMARK-BUDG-TOM                                   
                                                                                
        W-DISTRIKT-GRP = BILD03-DISTRIKT-GRP(1)                                 
        W-IDDISTR01-F = W-IDDISTR-FOM                                           
        W-IDDISTR01-T = W-IDDISTR-TOM                                           
        W-DISTRIKT-GRP = BILD03-DISTRIKT-GRP(2)                                 
        W-IDDISTR02-F = W-IDDISTR-FOM                                           
        W-IDDISTR02-T = W-IDDISTR-TOM                                           
        W-DISTRIKT-GRP = BILD03-DISTRIKT-GRP(3)                                 
        W-IDDISTR03-F = W-IDDISTR-FOM                                           
        W-IDDISTR03-T = W-IDDISTR-TOM                                           
        W-DISTRIKT-GRP = BILD03-DISTRIKT-GRP(4)                                 
        W-IDDISTR04-F = W-IDDISTR-FOM                                           
        W-IDDISTR04-T = W-IDDISTR-TOM                                           
                                                                                
        W-SOEK-IX = 1                                                           
        DO WHILE W-SOEK-IX < 501                                                
           W-IDARTNR01 = BILD03-IDARTNR(W-SOEK-IX)                              
           W-SOEK-IX = W-SOEK-IX + 1                                            
           W-IDARTNR02 = BILD03-IDARTNR(W-SOEK-IX)                              
           W-SOEK-IX = W-SOEK-IX + 1                                            
           W-IDARTNR03 = BILD03-IDARTNR(W-SOEK-IX)                              
           W-SOEK-IX = W-SOEK-IX + 1                                            
           W-IDARTNR04 = BILD03-IDARTNR(W-SOEK-IX)                              
           W-SOEK-IX = W-SOEK-IX + 1                                            
           W-IDARTNR05 = BILD03-IDARTNR(W-SOEK-IX)                              
           W-SOEK-IX = W-SOEK-IX + 1                                            
           W-IDARTNR06 = BILD03-IDARTNR(W-SOEK-IX)                              
           W-SOEK-IX = W-SOEK-IX + 1                                            
           W-IDARTNR07 = BILD03-IDARTNR(W-SOEK-IX)                              
           W-SOEK-IX = W-SOEK-IX + 1                                            
           W-IDARTNR08 = BILD03-IDARTNR(W-SOEK-IX)                              
           W-SOEK-IX = W-SOEK-IX + 1                                            
           W-IDARTNR09 = BILD03-IDARTNR(W-SOEK-IX)                              
           W-SOEK-IX = W-SOEK-IX + 1                                            
           W-IDARTNR10 = BILD03-IDARTNR(W-SOEK-IX)                              
           W-SOEK-IX = W-SOEK-IX + 1                                            
           IF BILD03-IDPTYP = 'P1'                                              
             PRINT RAPPORT03                                                    
           ELSE                                                                 
             PRINT RAPPORT13                                                    
           END-IF                                                               
        END-DO                                                                  
     END-IF                                                                     
  ELSE                                                                          
     IF W-BRYTFLAGGA = W-KONCNR                                                 
        W-URVALSTYP = '          '                                              
        W-URVALSTYP-NUM = RES-IDKONCNR                                          
     ELSE                                                                       
        IF W-BRYTFLAGGA = W-MARKNAD                                             
           W-URVALSTYP = '          '                                           
           W-URVALSTYP = RES-BEMARK-BUDG                                        
           W-TEST-TOT  = RES-BEMARK-BUDG                                        
        ELSE                                                                    
           IF W-BRYTFLAGGA = W-IDDISTR                                          
              W-URVALSTYP = '          '                                        
              W-URVALSTYP-NUM = RES-IDDISTR                                     
           ELSE                                                                 
              W-URVALSTYP = '          '                                        
              W-URVALSTYP-NUM = RES-IDDISTR                                     
           END-IF                                                               
        END-IF                                                                  
     END-IF                                                                     
     W-REGDAT          = RES-DAREGDAT                                           
     W-REGTID          = RES-TIREGTID                                           
     IF BILD02-IDTRANS = '3202'                                                 
       IF BILD02-KDSVAR = 'J'                                                   
         W-BRYT-KDPRODSL = 0                                                    
         W-BEPRODSL = 'BLANDADE PS    '                                         
       ELSE                                                                     
         W-BRYT-KDPRODSL = RES-KDPRODSL                                         
         W-BEPRODSL = RES-BEPRODSL                                              
       END-IF                                                                   
     ELSE                                                                       
       W-BRYT-KDPRODSL = RES-KDPRODSL                                           
         W-BEPRODSL = RES-BEPRODSL                                              
     END-IF                                                                     
     W-BRYT-IDFKNGRP   = RES-IDFKNGRP                                           
     W-IDFKNGRP        = RES-IDFKNGRP                                           
     WS-IDFKNGRP       = RES-IDFKNGRP                                           
     W-SUARTFSG-PER    = (RES-SUARTFSG-PER  + 500) / 1000                       
     W-SUARTFSG-AAR    = (RES-SUARTFSG-AAR  + 500) / 1000                       
     W-SUARTFSG-RAAR   = (RES-SUARTFSG-RAAR + 500) / 1000                       
     SUM-REFSG-BUDG    = (RES-SUARTFSG-AAR -          +                         
                         RES-SUTOTFSG-BUDG) * 100  /  +                         
                         RES-SUTOTFSG-BUDG                                      
       IF SUM-REFSG-BUDG > 0                                                    
          SUM-REFSG-BUDG =                            +                         
          SUM-REFSG-BUDG + 0.5                                                  
       ELSE                                                                     
          IF SUM-REFSG-BUDG < 0                                                 
             SUM-REFSG-BUDG =                         +                         
             SUM-REFSG-BUDG - 0.5                                               
          END-IF                                                                
       END-IF                                                                   
       IF SUM-REFSG-BUDG > 9999                                                 
          W-REFSG-BUDG = 9999                                                   
       ELSE                                                                     
         IF SUM-REFSG-BUDG < -9999                                              
            W-REFSG-BUDG = -9999                                                
         ELSE                                                                   
            W-REFSG-BUDG = SUM-REFSG-BUDG                                       
         END-IF                                                                 
       END-IF                                                                   
*AVV SEK AF4/AF3                                                                
       IF RES-SUARTFSG-FAAR NE 0                                                
          SUM-5P1 =                                          +                  
          (100 * (RES-SUARTFSG-AAR - RES-SUARTFSG-FAAR)) /   +                  
                 RES-SUARTFSG-FAAR                                              
       ELSE                                                                     
           SUM-5P1 = 0                                                          
       END-IF                                                                   
       IF SUM-5P1 > 0                                                           
          SUM-5P1 =                                          +                  
          SUM-5P1 + 0.5                                                         
       ELSE                                                                     
          IF SUM-5P1 < 0                                                        
             SUM-5P1 =                                       +                  
             SUM-5P1 - 0.5                                                      
          END-IF                                                                
       END-IF                                                                   
       IF SUM-5P1 > 9999                                                        
          W-REFSG-AAR = 9999                                                    
       ELSE                                                                     
         IF SUM-5P1 < -9999                                                     
             W-REFSG-AAR = -9999                                                
         ELSE                                                                   
            W-REFSG-AAR = SUM-5P1                                               
         END-IF                                                                 
       END-IF                                                                   
*AVV SEK AF2/AF1                                                                
       IF RES-SUARTFSG-FRAAR NE 0                                               
          SUM-5P1 =                                          +                  
          (100 * (RES-SUARTFSG-RAAR - RES-SUARTFSG-FRAAR)) / +                  
                 RES-SUARTFSG-FRAAR                                             
       ELSE                                                                     
           SUM-5P1 = 0                                                          
       END-IF                                                                   
       IF SUM-5P1 > 0                                                           
          SUM-5P1 =                                        +                    
          SUM-5P1 + 0.5                                                         
       ELSE                                                                     
          IF SUM-5P1 < 0                                                        
             SUM-5P1 =                                     +                    
             SUM-5P1 - 0.5                                                      
          END-IF                                                                
       END-IF                                                                   
       IF SUM-5P1 > 9999                                                        
          W-REFSG-RAAR = 9999                                                   
       ELSE                                                                     
         IF SUM-5P1 < -9999                                                     
            W-REFSG-RAAR = -9999                                                
         ELSE                                                                   
            W-REFSG-RAAR = SUM-5P1                                              
         END-IF                                                                 
       END-IF                                                                   
*AVV STYCK AF2/AF1                                                              
       IF RES-SULEVANT-FRAAR NE 0                                               
          SUM-5P1 =                                          +                  
          (100 * (RES-SULEVANT-RAAR - RES-SULEVANT-FRAAR)) / +                  
                 RES-SULEVANT-FRAAR                                             
       ELSE                                                                     
          SUM-5P1 = 0                                                           
       END-IF                                                                   
       IF SUM-5P1 > 0                                                           
          SUM-5P1 =                                          +                  
          SUM-5P1 + 0.5                                                         
       ELSE                                                                     
          IF SUM-5P1 < 0                                                        
             SUM-5P1 =                                       +                  
             SUM-5P1 - 0.5                                                      
          END-IF                                                                
       END-IF                                                                   
       IF SUM-5P1 > 9999                                                        
          W-RELEVANT-RAAR = 9999                                                
       ELSE                                                                     
         IF SUM-5P1 < -9999                                                     
            W-RELEVANT-RAAR = -9999                                             
         ELSE                                                                   
            W-RELEVANT-RAAR = SUM-5P1                                           
         END-IF                                                                 
       END-IF                                                                   
*AF2/AF1 TB                                                                     
       W-DIFF = RES-SUARTFSG-FRAAR - RES-SUARTSJK-FRAAR                         
       IF W-DIFF NE 0                                                           
          SUM-5P1 =                                          +                  
          (100 * (( RES-SUARTFSG-RAAR - RES-SUARTSJK-RAAR )  +                  
          - W-DIFF))  / W-DIFF                                                  
       ELSE                                                                     
          SUM-5P1 = 0                                                           
       END-IF                                                                   
       IF SUM-5P1 > 0                                                           
          SUM-5P1 =                                          +                  
          SUM-5P1 + 0.5                                                         
       ELSE                                                                     
          IF SUM-5P1 < 0                                                        
             SUM-5P1 =                                       +                  
             SUM-5P1 - 0.5                                                      
          END-IF                                                                
       END-IF                                                                   
       IF SUM-5P1 > 9999                                                        
          W-RETOTBV-RAAR-TB = 9999                                              
       ELSE                                                                     
         IF SUM-5P1 < -9999                                                     
            W-RETOTBV-RAAR-TB = -9999                                           
         ELSE                                                                   
            W-RETOTBV-RAAR-TB = SUM-5P1                                         
         END-IF                                                                 
       END-IF                                                                   
     W-SULEVANT-PER    = RES-SULEVANT-PER                                       
     W-SULEVANT-RAAR   = RES-SULEVANT-RAAR                                      
     W-SUTOTBV-PER     = (RES-SUTOTBV-PER + 500) / 1000                         
     W-SUTOTBV-RAAR    = (RES-SUTOTBV-RAAR + 500) / 1000                        
     W-RETOTBV-PER     =  RES-RETOTBV-PER                                       
     W-RETOTBV-AAR     =  RES-RETOTBV-AAR                                       
     W-RETOTBV-RAAR    =  RES-RETOTBV-RAAR                                      
     W-RETOTBV-RAAR-TG = RES-RETOTBV-RAAR-TG                                    
                                                                                
     IF W-IDFKNGRP = 9999                                                       
        MOVE SPACE             TO RES-BEFKNGRP                                  
        MOVE ZERO              TO W-IDFKNGRP                                    
     END-IF                                                                     
     IF RES-IDPTYP = 'P1'                                                       
       PRINT RAPPORT-P1                                                         
     ELSE                                                                       
       IF W-TEST-TOT      = 'TOT'                                               
         PERFORM NOLLA-SUMMAFAELT                                               
       END-IF                                                                   
       PRINT RAPPORT-PVLV                                                       
     END-IF                                                                     
  END-IF                                                                        
INIT-PROC. PROC                                                                 
W-INGEN-BRYTNING      = '0'                                                     
W-BRYTFLAGGA          = '0'                                                     
W-KONCNR              = '1'                                                     
W-MARKNAD             = '2'                                                     
W-IDDISTR             = '3'                                                     
W-TG-VV               = 0                                                       
W-TG-FVV              = 0                                                       
W-TUSEN-TOT-SJK-VV    = 0                                                       
W-HUNDRA-TOT-SJK-VV   = 0                                                       
W-TIOTAL-TOT-SJK-VV   = 0                                                       
W-ENTAL-TOT-SJK-VV    = 0                                                       
W-TUSEN-TOT-SJK-FVV   = 0                                                       
W-HUNDRA-TOT-SJK-FVV  = 0                                                       
W-TIOTAL-TOT-SJK-FVV  = 0                                                       
W-ENTAL-TOT-SJK-FVV   = 0                                                       
END-PROC                                                                        
*                                                                               
FLYTTA-FUNKTIONSGRUPPER. PROC                                                   
    W-FUNKTIONS-GRP = BILD02-FUNKTIONS-GRP(W-SOEK-IX)                           
    W-IDFKNGRP01-F = W-IDFKNGRP-FOM                                             
    W-IDFKNGRP01-T = W-IDFKNGRP-TOM                                             
    W-SOEK-IX = W-SOEK-IX + 1                                                   
    W-FUNKTIONS-GRP = BILD02-FUNKTIONS-GRP(W-SOEK-IX)                           
    W-IDFKNGRP02-F = W-IDFKNGRP-FOM                                             
    W-IDFKNGRP02-T = W-IDFKNGRP-TOM                                             
    W-SOEK-IX = W-SOEK-IX + 1                                                   
    W-FUNKTIONS-GRP = BILD02-FUNKTIONS-GRP(W-SOEK-IX)                           
    W-IDFKNGRP03-F = W-IDFKNGRP-FOM                                             
    W-IDFKNGRP03-T = W-IDFKNGRP-TOM                                             
                                                                                
    W-SOEK-IX = W-SOEK-IX + 1                                                   
    IF W-SOEK-IX < 100                                                          
       W-FUNKTIONS-GRP = BILD02-FUNKTIONS-GRP(W-SOEK-IX)                        
       W-IDFKNGRP04-F = W-IDFKNGRP-FOM                                          
       W-IDFKNGRP04-T = W-IDFKNGRP-TOM                                          
       W-SOEK-IX = W-SOEK-IX + 1                                                
    END-IF                                                                      
END-PROC                                                                        
*                                                                               
NOLLA-SUMMAFAELT. PROC                                                          
* HÄR NOLLSTÄLLS ALLA SUMMERINGSFÄLT FÖR LVPV-LISTAN                            
* OM --- BEMARK = 'TOT' PGA ATT DESSA MARKN ÄR EJ ATT BETRAKTA SOM              
* VANLIGA MARKNADER UTAN DE ÄR KONSTRUERADE TOTALER, SOM EJ SKALL               
* RÄKNAS MED VID DEN AUTOMATISKA SUMMERINGEN.                                   
* DESSA TOTALER SKAPAS I PGM W33015.                                            
    RES-SUARTFSG-PER   = 0                                                      
    RES-SUARTFSG-AAR   = 0                                                      
    RES-SUARTFSG-FAAR  = 0                                                      
    RES-SUARTFSG-RAAR  = 0                                                      
    RES-SUARTFSG-FRAAR = 0                                                      
    RES-SULEVANT-PER   = 0                                                      
    RES-SULEVANT-AAR   = 0                                                      
    RES-SULEVANT-FAAR  = 0                                                      
    RES-SULEVANT-RAAR  = 0                                                      
    RES-SULEVANT-FRAAR = 0                                                      
    RES-SUARTSJK-PER   = 0                                                      
    RES-SUARTSJK-AAR   = 0                                                      
    RES-SUARTSJK-FAAR  = 0                                                      
    RES-SUARTSJK-RAAR  = 0                                                      
    RES-SUARTSJK-FRAAR = 0                                                      
    RES-SUTOTBV-PER    = 0                                                      
    RES-SUTOTBV-RAAR   = 0                                                      
    RES-SUTOTFSG-BUDG  = 0                                                      
END-PROC                                                                        
*                                                                               
*-------------*                                                                 
* REPORT P1   *                                                                 
*-------------*                                                                 
*                                                                               
  REPORT RAPPORT02        +                                                     
         PRINTER W33046D2 +                                                     
         LINESIZE 132     +                                                     
         PAGESIZE 109     +                                                     
         NOADJUST         +                                                     
         SUMCTL NONE      +                                                     
         NOHEADING                                                              
    CONTROL  FINAL NOPRINT                 +                                    
             BILD02-IDUSER NOPRINT RENUM   +                                    
             W-REGDATUM NOPRINT RENUM      +                                    
             W-REGTID   NOPRINT RENUM                                           
                                                                                
    TITLE 1  COL 040 WS-MEDDELANDE                                              
                                                                                
    TITLE 2  COL 002 'VOLVO PARTS AB'                   +                       
             COL 025 'URVAL '                           +                       
             COL 031 BILD02-IDFSGURV                    +                       
             COL 040 'ARTIKELSTATISTIK  FUNKTIONSGRUPP' +                       
             COL 080 'USERID '                          +                       
             COL 088 BILD02-IDUSER                      +                       
             COL 098 'DATUM'                            +                       
             COL 105 W-REGDATUM                                                 
                                                                                
                                                                                
    TITLE 4  COL 098 'TID'                         +                            
             COL 105 W-REGTID                                                   
                                                                                
    TITLE 6  COL 002 'START VECKA'                 +                            
             COL 022 W-VV-START                    +                            
             COL 074 'LISTTYP'                     +                            
             COL 084 BILD02-IDPTYP                                              
                                                                                
    TITLE 7  COL 002 'SLUT  VECKA'                 +                            
             COL 022 W-VV-SLUT                     +                            
             COL 074 'PRISTYP'                     +                            
                                                                                
    TITLE 8  COL 002 'VOLYMVÄRDESKLASS '           +                            
             COL 023 W-KDVVKL01                    +                            
             COL 032 W-KDVVKL02                    +                            
             COL 041 W-KDVVKL03                    +                            
             COL 050 W-KDVVKL04                    +                            
             COL 059 W-KDVVKL05                    +                            
             COL 074 'NIVÅ '                       +                            
             COL 083 BILD02-KDNIVA                                              
                                                                                
    TITLE 9  COL 002 'PRODUKTSLAG   '              +                            
             COL 020 W-KDPRODSL01                  +                            
             COL 025 W-KDPRODSL02                  +                            
             COL 030 W-KDPRODSL03                  +                            
             COL 035 W-KDPRODSL04                  +                            
             COL 040 W-KDPRODSL05                  +                            
             COL 045 W-KDPRODSL06                  +                            
             COL 050 W-KDPRODSL07                  +                            
             COL 059 'SAMMANSLAGNING PS J/N'       +                            
             COL 085 BILD02-KDSVAR                                              
                                                                                
    TITLE 10 COL 002 'KONCERN   '                  +                            
             COL 021 W-IDKONCNR01                  +                            
             COL 030 W-IDKONCNR02                  +                            
             COL 039 W-IDKONCNR03                  +                            
             COL 048 W-IDKONCNR04                  +                            
             COL 057 W-IDKONCNR05                  +                            
             COL 066 W-IDKONCNR06                  +                            
             COL 075 W-IDKONCNR07                  +                            
             COL 084 W-IDKONCNR08                                               
                                                                                
    TITLE 11 COL 002 'LEVERANTÖR '                 +                            
             COL 019 W-IDLEVNR01                   +                            
             COL 028 W-IDLEVNR02                   +                            
             COL 037 W-IDLEVNR03                   +                            
             COL 046 W-IDLEVNR04                   +                            
             COL 055 W-IDLEVNR05                   +                            
             COL 064 W-IDLEVNR06                   +                            
             COL 073 W-IDLEVNR07                   +                            
             COL 082 W-IDLEVNR08                                                
                                                                                
