AFTER-LINE. PROC                                                                
* EN RÄKNARE FÖR ATT KUNNA BRYTA VID TIO SKRIVNA RADER                          
*----------------------------------------------------                           
   IF W-TIO-RADER = 10                                                          
         DISPLAY ' '                                                            
         W-TIO-RADER = 1                                                        
   ELSE                                                                         
      W-TIO-RADER = W-TIO-RADER + 1                                             
   END-IF                                                                       
                                                                                
END-PROC                                                                        
BEFORE-BREAK. PROC                                                              
    IF LEVEL = 1                                                                
                                                                                
      W-SUM-SUARTFSG-PER    = (RES-SUARTFSG-PER   + 500) / 1000                 
      W-SUM-SUARTFSG-AAR    = (RES-SUARTFSG-AAR   + 500) / 1000                 
      W-SUM-SUARTFSG-RAAR   = (RES-SUARTFSG-RAAR  + 500) / 1000                 
      W-SUM-SUARTFSG-FAAR   = RES-SUARTFSG-FAAR                                 
      W-SUM-SUARTFSG-FRAAR  = RES-SUARTFSG-FRAAR                                
      W-SUM-SULEVANT-PER    = RES-SULEVANT-PER                                  
      W-SUM-SULEVANT-AAR    = RES-SULEVANT-AAR                                  
      W-SUM-SULEVANT-FAAR   = RES-SULEVANT-FAAR                                 
      W-SUM-SULEVANT-RAAR   = RES-SULEVANT-RAAR                                 
      W-SUM-SULEVANT-FRAAR  = RES-SULEVANT-FRAAR                                
      W-SUM-SUARTSJK-PER    = RES-SUARTSJK-PER                                  
      W-SUM-SUARTSJK-AAR    = RES-SUARTSJK-AAR                                  
      W-SUM-SUARTSJK-FAAR   = RES-SUARTSJK-FAAR                                 
      W-SUM-SUARTSJK-RAAR   = RES-SUARTSJK-RAAR                                 
      W-SUM-SUARTSJK-FRAAR  = RES-SUARTSJK-FRAAR                                
      W-SUM-SUTOTBV-PER     = (RES-SUTOTBV-PER + 500) / 1000                    
      W-SUM-SUTOTBV-RAAR    = (RES-SUTOTBV-RAAR  + 500) / 1000                  
      SUM-REFSG-BUDG    = (RES-SUARTFSG-AAR -           +                       
                         RES-SUTOTFSG-BUDG) * 100  /    +                       
                         RES-SUTOTFSG-BUDG                                      
       IF SUM-REFSG-BUDG > 0                                                    
          SUM-REFSG-BUDG =                              +                       
          SUM-REFSG-BUDG + 0.5                                                  
       ELSE                                                                     
          IF SUM-REFSG-BUDG < 0                                                 
             SUM-REFSG-BUDG =                           +                       
             SUM-REFSG-BUDG - 0.5                                               
          END-IF                                                                
       END-IF                                                                   
       IF SUM-REFSG-BUDG > 9999                                                 
          W-SUM-REFSG-BUDG = 9999                                               
       ELSE                                                                     
         IF SUM-REFSG-BUDG < -9999                                              
            W-SUM-REFSG-BUDG = -99999                                           
         ELSE                                                                   
            W-SUM-REFSG-BUDG = SUM-REFSG-BUDG                                   
         END-IF                                                                 
       END-IF                                                                   
*                                                                               
*AF2 TB                                                                         
      SUM-SUTOTBV-RAAR = RES-SUARTFSG-RAAR - RES-SUARTSJK-RAAR                  
      IF SUM-SUTOTBV-RAAR > 0                                                   
         SUM-SUTOTBV-RAAR =                             +                       
         SUM-SUTOTBV-RAAR + 0.05                                                
      ELSE                                                                      
         IF SUM-SUTOTBV-RAAR < 0                                                
            SUM-SUTOTBV-RAAR =                          +                       
            SUM-SUTOTBV-RAAR - 0.05                                             
         END-IF                                                                 
      END-IF                                                                    
*AF5 TB                                                                         
       SUM-SUTOTBV-PER =  RES-SUARTFSG-PER - RES-SUARTSJK-PER                   
       IF SUM-SUTOTBV-PER > 0                                                   
          SUM-SUTOTBV-PER =                           +                         
          SUM-SUTOTBV-PER + 0.05                                                
       ELSE                                                                     
          IF SUM-SUTOTBV-PER < 0                                                
             SUM-SUTOTBV-PER =                        +                         
             SUM-SUTOTBV-PER - 0.05                                             
          END-IF                                                                
       END-IF                                                                   
*AF1 TG                                                                         
       IF RES-SUARTFSG-FRAAR NE 0                                               
          SUM-RETOTBV-FRAAR =                                  +                
          (100 * (RES-SUARTFSG-FRAAR - RES-SUARTSJK-FRAAR)) /  +                
                 RES-SUARTFSG-FRAAR                                             
       ELSE                                                                     
          SUM-RETOTBV-FRAAR = 0                                                 
       END-IF                                                                   
       IF SUM-RETOTBV-FRAAR > 0                                                 
          SUM-RETOTBV-FRAAR =                              +                    
          SUM-RETOTBV-FRAAR + 0.05                                              
       ELSE                                                                     
          IF SUM-RETOTBV-FRAAR < 0                                              
             SUM-RETOTBV-FRAAR =                           +                    
             SUM-RETOTBV-FRAAR - 0.05                                           
          END-IF                                                                
       END-IF                                                                   
       IF SUM-RETOTBV-FRAAR > 99.9                                              
          SUM-RETOTBV-FRAAR = 99.9                                              
       ELSE                                                                     
         IF SUM-RETOTBV-FRAAR < -99.9                                           
            SUM-RETOTBV-FRAAR = -99.9                                           
         END-IF                                                                 
       END-IF                                                                   
*AF2 TG                                                                         
       IF RES-SUARTFSG-RAAR  NE 0                                               
          SUM-RETOTBV-RAAR  =                                 +                 
          (100 * (RES-SUARTFSG-RAAR  - RES-SUARTSJK-RAAR )) / +                 
                 RES-SUARTFSG-RAAR                                              
       ELSE                                                                     
          SUM-RETOTBV-RAAR  = 0                                                 
       END-IF                                                                   
       IF SUM-RETOTBV-RAAR > 0                                                  
          SUM-RETOTBV-RAAR =                               +                    
          SUM-RETOTBV-RAAR + 0.05                                               
       ELSE                                                                     
          IF SUM-RETOTBV-RAAR < 0                                               
             SUM-RETOTBV-RAAR =                            +                    
             SUM-RETOTBV-RAAR - 0.05                                            
          END-IF                                                                
       END-IF                                                                   
       IF SUM-RETOTBV-RAAR > 99.9                                               
          W-SUM-RETOTBV-RAAR = 99.9                                             
       ELSE                                                                     
         IF SUM-RETOTBV-RAAR < -99.9                                            
            W-SUM-RETOTBV-RAAR = -99.9                                          
         ELSE                                                                   
            W-SUM-RETOTBV-RAAR = SUM-RETOTBV-RAAR                               
         END-IF                                                                 
       END-IF                                                                   
*AF4 TG                                                                         
       IF RES-SUARTFSG-AAR   NE 0                                               
          SUM-RETOTBV-AAR   =                                 +                 
          (100 * (RES-SUARTFSG-AAR   - RES-SUARTSJK-AAR  )) / +                 
                 RES-SUARTFSG-AAR                                               
       ELSE                                                                     
          SUM-RETOTBV-AAR   = 0                                                 
       END-IF                                                                   
       IF SUM-RETOTBV-AAR > 0                                                   
          SUM-RETOTBV-AAR =                               +                     
          SUM-RETOTBV-AAR + 0.05                                                
       ELSE                                                                     
          IF SUM-RETOTBV-AAR < 0                                                
             SUM-RETOTBV-AAR =                            +                     
             SUM-RETOTBV-AAR - 0.05                                             
          END-IF                                                                
       END-IF                                                                   
       IF SUM-RETOTBV-AAR > 99.9                                                
          W-SUM-RETOTBV-AAR = 99.9                                              
       ELSE                                                                     
         IF SUM-RETOTBV-AAR < -99.9                                             
            W-SUM-RETOTBV-AAR = -99.9                                           
         ELSE                                                                   
            W-SUM-RETOTBV-AAR = SUM-RETOTBV-AAR                                 
         END-IF                                                                 
       END-IF                                                                   
*AF5 TG                                                                         
       IF RES-SUARTFSG-PER   NE 0                                               
          SUM-RETOTBV-PER   =                                 +                 
          (100 * (RES-SUARTFSG-PER   - RES-SUARTSJK-PER  )) / +                 
                 RES-SUARTFSG-PER                                               
       ELSE                                                                     
          SUM-RETOTBV-PER   = 0                                                 
       END-IF                                                                   
       IF SUM-RETOTBV-PER > 0                                                   
          SUM-RETOTBV-PER =                                +                    
          SUM-RETOTBV-PER + 0.05                                                
       ELSE                                                                     
          IF SUM-RETOTBV-PER < 0                                                
             SUM-RETOTBV-PER =                             +                    
             SUM-RETOTBV-PER - 0.05                                             
          END-IF                                                                
       END-IF                                                                   
       IF SUM-RETOTBV-PER > 99.9                                                
          W-SUM-RETOTBV-PER = 99.9                                              
       ELSE                                                                     
         IF SUM-RETOTBV-PER < -99.9                                             
            W-SUM-RETOTBV-PER = -99.9                                           
         ELSE                                                                   
            W-SUM-RETOTBV-PER = SUM-RETOTBV-PER                                 
         END-IF                                                                 
       END-IF                                                                   
*AF1/AF2 TG                                                                     
       SUM-RETOTBV-RAAR-TG = SUM-RETOTBV-RAAR -            +                    
                             SUM-RETOTBV-FRAAR                                  
       IF SUM-RETOTBV-RAAR-TG > 0                                               
          SUM-RETOTBV-RAAR-TG =                            +                    
          SUM-RETOTBV-RAAR-TG + 0.05                                            
       ELSE                                                                     
          IF SUM-RETOTBV-RAAR-TG < 0                                            
             SUM-RETOTBV-RAAR-TG =                         +                    
             SUM-RETOTBV-RAAR-TG - 0.05                                         
          END-IF                                                                
       END-IF                                                                   
       IF SUM-RETOTBV-RAAR-TG > 99.9                                            
          W-SUM-RETOTBV-RAAR-TG = 99.9                                          
       ELSE                                                                     
         IF SUM-RETOTBV-RAAR-TG < -99.9                                         
            W-SUM-RETOTBV-RAAR-TG = -99.9                                       
         ELSE                                                                   
            W-SUM-RETOTBV-RAAR-TG = SUM-RETOTBV-RAAR-TG                         
         END-IF                                                                 
       END-IF                                                                   
*AF2/AF1 TB                                                                     
       W-DIFF = RES-SUARTFSG-FRAAR - RES-SUARTSJK-FRAAR                         
       IF W-DIFF NE 0                                                           
          SUM-5P1 =                                        +                    
          (100 * (( RES-SUARTFSG-RAAR - RES-SUARTSJK-RAAR )  +                  
          - W-DIFF )) / W-DIFF                                                  
       ELSE                                                                     
          SUM-5P1 = 0                                                           
       END-IF                                                                   
       IF SUM-5P1 > 0                                                           
          SUM-5P1 =                                        +                    
          SUM-5P1 + 0.5                                                         
       ELSE                                                                     
          IF SUM-5P1 < 0                                                        
             SUM-5P1 =                                     +                    
             SUM-5P1 - 0.5                                                      
          END-IF                                                                
       END-IF                                                                   
       IF SUM-5P1 > 9999                                                        
          W-SUM-RETOTBV-RAAR-TB = 9999                                          
       ELSE                                                                     
         IF SUM-5P1 < -9999                                                     
            W-SUM-RETOTBV-RAAR-TB = -9999                                       
         ELSE                                                                   
            W-SUM-RETOTBV-RAAR-TB = SUM-5P1                                     
         END-IF                                                                 
       END-IF                                                                   
*AVV SEK AF4/AF3                                                                
       IF RES-SUARTFSG-FAAR NE 0                                                
          SUM-5P1 =                                          +                  
          (100 * (RES-SUARTFSG-AAR - RES-SUARTFSG-FAAR)) /   +                  
                 RES-SUARTFSG-FAAR                                              
       ELSE                                                                     
           SUM-5P1 = 0                                                          
       END-IF                                                                   
       IF SUM-5P1 > 0                                                           
          SUM-5P1 =                                        +                    
          SUM-5P1 + 0.5                                                         
       ELSE                                                                     
          IF SUM-5P1 < 0                                                        
             SUM-5P1 =                                     +                    
             SUM-5P1 - 0.5                                                      
          END-IF                                                                
       END-IF                                                                   
       IF SUM-5P1 > 9999                                                        
          W-SUM-REFSG-AAR = 9999                                                
       ELSE                                                                     
         IF SUM-5P1 < -9999                                                     
             W-SUM-REFSG-AAR = -9999                                            
         ELSE                                                                   
            W-SUM-REFSG-AAR = SUM-5P1                                           
         END-IF                                                                 
       END-IF                                                                   
*AVV SEK AF2/AF1                                                                
       IF RES-SUARTFSG-FRAAR NE 0                                               
          SUM-5P1 =                                          +                  
          (100 * (RES-SUARTFSG-RAAR - RES-SUARTFSG-FRAAR)) / +                  
                 RES-SUARTFSG-FRAAR                                             
       ELSE                                                                     
           SUM-5P1 = 0                                                          
       END-IF                                                                   
       IF SUM-5P1 > 0                                                           
          SUM-5P1 =                                        +                    
          SUM-5P1 + 0.5                                                         
       ELSE                                                                     
          IF SUM-5P1 < 0                                                        
             SUM-5P1 =                                     +                    
             SUM-5P1 - 0.5                                                      
          END-IF                                                                
       END-IF                                                                   
       IF SUM-5P1 > 9999                                                        
          W-SUM-REFSG-RAAR = 9999                                               
       ELSE                                                                     
         IF SUM-5P1 < -9999                                                     
            W-SUM-REFSG-RAAR = -9999                                            
         ELSE                                                                   
            W-SUM-REFSG-RAAR = SUM-5P1                                          
         END-IF                                                                 
       END-IF                                                                   
*AVV STYCK AF2/AF1                                                              
       IF RES-SULEVANT-FRAAR NE 0                                               
          SUM-5P1 =                                          +                  
          (100 * (RES-SULEVANT-RAAR - RES-SULEVANT-FRAAR)) / +                  
                 RES-SULEVANT-FRAAR                                             
       ELSE                                                                     
          SUM-5P1 = 0                                                           
       END-IF                                                                   
       IF SUM-5P1 > 0                                                           
          SUM-5P1 =                                        +                    
          SUM-5P1 + 0.5                                                         
       ELSE                                                                     
          IF SUM-5P1 < 0                                                        
             SUM-5P1 =                                     +                    
             SUM-5P1 - 0.5                                                      
          END-IF                                                                
       END-IF                                                                   
       IF SUM-5P1 > 9999                                                        
          W-SUM-RELEVANT-RAAR = 9999                                            
       ELSE                                                                     
         IF SUM-5P1 < -9999                                                     
            W-SUM-RELEVANT-RAAR = -9999                                         
         ELSE                                                                   
            W-SUM-RELEVANT-RAAR = SUM-5P1                                       
         END-IF                                                                 
       END-IF                                                                   
       IF WS-IDFKNGRP = 99999                                                   
          MOVE 'PRODSL'          TO WS-TOTAL                                    
       ELSE                                                                     
          IF WS-ANDRA = 0                                                       
             IF WS-TREDJE = 0                                                   
                IF WS-FJAERDE = 0                                               
                   MOVE 'NIVÅ 1'           TO WS-TOTAL                          
                ELSE                                                            
                   MOVE 'NIVÅ 4'           TO WS-TOTAL                          
                END-IF                                                          
             ELSE                                                               
                IF WS-FJAERDE = 0                                               
                   MOVE 'NIVÅ 3'           TO WS-TOTAL                          
                ELSE                                                            
                   MOVE 'NIVÅ 4'           TO WS-TOTAL                          
                END-IF                                                          
             END-IF                                                             
          ELSE                                                                  
             IF WS-TREDJE = 0                                                   
                IF WS-FJAERDE = 0                                               
                   MOVE 'NIVÅ 2'           TO WS-TOTAL                          
                ELSE                                                            
                   MOVE 'NIVÅ 4'           TO WS-TOTAL                          
                END-IF                                                          
             ELSE                                                               
                IF WS-FJAERDE = 0                                               
                   MOVE 'NIVÅ 3'           TO WS-TOTAL                          
                ELSE                                                            
                   MOVE 'NIVÅ 4'           TO WS-TOTAL                          
                END-IF                                                          
             END-IF                                                             
          END-IF                                                                
       END-IF                                                                   
       DISPLAY '  '                                                             
       DISPLAY '  '                                                             
       DISPLAY  COL 001 WS-TOTAL           +                                    
             COL 010 W-SUM-SUARTFSG-PER    +                                    
             COL 019 W-SUM-SUARTFSG-AAR    +                                    
             COL 029 W-SUM-SUARTFSG-RAAR   +                                    
             COL 038 W-SUM-REFSG-BUDG      +                                    
             COL 044 W-SUM-REFSG-AAR       +                                    
             COL 050 W-SUM-REFSG-RAAR      +                                    
             COL 054 W-SUM-SULEVANT-PER    +                                    
             COL 063 W-SUM-SULEVANT-RAAR   +                                    
             COL 071 W-SUM-RELEVANT-RAAR   +                                    
             COL 077 W-SUM-SUTOTBV-PER     +                                    
             COL 084 W-SUM-SUTOTBV-RAAR    +                                    
             COL 093 W-SUM-RETOTBV-RAAR-TB +                                    
             COL 099 W-SUM-RETOTBV-PER     +                                    
             COL 105 W-SUM-RETOTBV-AAR     +                                    
             COL 111 W-SUM-RETOTBV-RAAR    +                                    
             COL 116 W-SUM-RETOTBV-RAAR-TG                                      
    END-IF                                                                      
    W-TIO-RADER = 1                                                             
END-PROC                                                                        
