                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5128L00                                              *        
*                                                                      *        
*  FUNKTION   :  CREATES 310 AND R31 REPORTS                           *        
*                                                                      *        
*  FÖRFATTARE :  BARSHARANI BISHOYE                                    *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W5128LD1                                                                   
*                                                                               
%W5128J  'IN1-'                                                                 
                                                                                
FILE TPFIL1 FB(48 0)                                                            
%W5128J  'T1-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE W5128LD2                                                                   
%W01160  'IN2-'                                                                 
                                                                                
FILE TPFIL2 FB(56 0)                                                            
T2-IDPTYP    1  3 A                                                             
T2-IDARTNR   4  5 P 0                                                           
T2-IDDC      9  2 A                                                             
T2-IDLEVNR  11  5 A                                                             
T2-IDDISTR  16  3 P 0                                                           
T2-IDKUNDNR 19  4 P 0                                                           
T2-IDORDNR5 23  5 N                                                             
T2-IDFAKT   28  4 P 0                                                           
T2-IDLOPNRM 32  5 P 0                                                           
T2-KVAVIS   37  4 P 0                                                           
T2-PRARTSTD 41  5 P 2                                                           
T2-DAREGDAT 48  8 N                                                             
                                                                                
FILE TPFIL3 FB(56 0)                                                            
T3-IDPTYP    1  3 A                                                             
T3-IDARTNR   4  5 P 0                                                           
T3-IDDC      9  2 A                                                             
T3-IDLEVNR  11  5 A                                                             
T3-IDDISTR  16  3 P 0                                                           
T3-IDKUNDNR 19  4 P 0                                                           
T3-IDORDNR5 23  5 N                                                             
T3-IDFAKT   28  4 P 0                                                           
T3-IDLOPNRM 32  5 P 0                                                           
T3-KVAVIS   37  4 P 0                                                           
T3-PRARTSTD 41  5 P 2                                                           
T3-DAREGDAT 48  8 N                                                             
                                                                                
****** EXCEL UTFIL1                                                             
FILE W5128LD3 PRINTER VB(115 0)                                                 
                                                                                
****** EXCEL FILE STRUCTURE                                                     
UT1-IDPTYP     W  3  A                                                          
UT1-IDARTNR    W  9  N                                                          
UT1-IDDC       W  2  A                                                          
UT1-IDLEVNR    W  5  A                                                          
UT1-IDDISTR    W  5  N                                                          
UT1-IDKUNDNR   W  7  N                                                          
UT1-IDORDNR5   W  5  N                                                          
UT1-IDFAKT     W  7  N                                                          
UT1-IDLOPNRM   W  9  N                                                          
UT1-KVAVIS     W  7  N                                                          
UT1-STDPRICE   W 13  N 2 MASK ('ZZZZZZZZZ99.99-')                               
UT1-DAREGDAT   W  8  N                                                          
                                                                                
****** EXCEL UTFIL2                                                             
FILE W5128LD4 PRINTER VB(115 0)                                                 
                                                                                
****** EXCEL FILE STRUCTURE                                                     
UT2-IDPTYP     W  3  A                                                          
UT2-IDARTNR    W  9  N                                                          
UT2-IDDC       W  2  A                                                          
UT2-IDLEVNR    W  5  A                                                          
UT2-IDDISTR    W  5  N                                                          
UT2-IDKUNDNR   W  7  N                                                          
UT2-IDORDNR5   W  5  N                                                          
UT2-IDFAKT     W  7  N                                                          
UT2-IDLOPNRM   W  9  N                                                          
UT2-KVAVIS     W  7  N                                                          
UT2-STDPRICE   W 13  N 2 MASK ('ZZZZZZZZZ99.99-')                               
UT2-DAREGDAT   W  8  N                                                          
                                                                                
WS-SEMICOLON   W  1  A   VALUE ';'                                              
FIRST-LINE1    W  1  A   VALUE 'J'                                              
FIRST-LINE2    W  1  A   VALUE 'J'                                              
NEWPAGE                                                                         
**********************************************************                      
* STEP 1. SORTS W5128J ON IDARTNR                                               
**********************************************************                      
SORT W5128LD1 TO TPFIL1 USING (IN1-IDARTNR)                                     
                                                                                
NEWPAGE                                                                         
**********************************************************                      
* STEP 2. COMPARES W5128J AND W01160 TO GET THE STD PRICE                       
**********************************************************                      
                                                                                
JOB INPUT (W5128LD2 KEY(IN2-CLAG-IDARTNR)                     +                 
           TPFIL1   KEY(T1-IDARTNR))                                            
IF MATCHED                                                                      
       IF (T1-IDPTYP = '310' )                                                  
         T2-IDPTYP        = T1-IDPTYP                                           
         T2-IDARTNR       = T1-IDARTNR                                          
         T2-IDDC          = T1-IDDC                                             
         T2-IDLEVNR       = T1-IDLEVNR                                          
         T2-IDDISTR       = T1-IDDISTR                                          
         T2-IDKUNDNR      = T1-IDKUNDNR                                         
         T2-IDORDNR5      = T1-IDORDNR5                                         
         T2-IDFAKT        = T1-IDFAKT                                           
         T2-IDLOPNRM      = T1-IDLOPNRM                                         
         T2-KVAVIS        = T1-KVAVIS                                           
         T2-PRARTSTD      = IN2-CLAG-PRARTSTD                                   
         T2-DAREGDAT      = T1-DAREGDAT                                         
         PUT TPFIL2                                                             
       ELSE                                                                     
        IF (T1-IDPTYP = 'R31' )                                                 
          T3-IDPTYP       = T1-IDPTYP                                           
          T3-IDARTNR      = T1-IDARTNR                                          
          T3-IDDC         = T1-IDDC                                             
          T3-IDLEVNR      = T1-IDLEVNR                                          
          T3-IDDISTR      = T1-IDDISTR                                          
          T3-IDKUNDNR     = T1-IDKUNDNR                                         
          T3-IDORDNR5     = T1-IDORDNR5                                         
          T3-IDFAKT       = T1-IDFAKT                                           
          T3-IDLOPNRM     = T1-IDLOPNRM                                         
          T3-KVAVIS       = T1-KVAVIS                                           
          T3-PRARTSTD     = IN2-CLAG-PRARTSTD                                   
          T3-DAREGDAT     = T1-DAREGDAT                                         
          PUT TPFIL3                                                            
        END-IF                                                                  
       END-IF                                                                   
END-IF                                                                          
**********************************************************                      
* STEP 3. SORTS TPFIL2 ON IDARTNR AND IDDC                                      
**********************************************************                      
SORT TPFIL2   TO TPFIL2 USING (T2-IDARTNR T2-IDDC)                              
                                                                                
**********************************************************                      
* STEP 4. READS TPFIL2 (310 FROM WDL6)                                          
**********************************************************                      
JOB INPUT (TPFIL2   KEY(T2-IDARTNR T2-IDDC))                                    
                                                                                
       IF LAST-DUP TPFIL2  OR NOT DUPLICATE TPFIL2                              
         UT1-IDPTYP        = T2-IDPTYP                                          
         UT1-IDARTNR       = T2-IDARTNR                                         
         UT1-IDDC          = T2-IDDC                                            
         UT1-IDLEVNR       = T2-IDLEVNR                                         
         UT1-IDDISTR       = T2-IDDISTR                                         
         UT1-IDKUNDNR      = T2-IDKUNDNR                                        
         UT1-IDORDNR5      = T2-IDORDNR5                                        
         UT1-IDFAKT        = T2-IDFAKT                                          
         UT1-IDLOPNRM      = T2-IDLOPNRM                                        
         UT1-KVAVIS        = T2-KVAVIS                                          
         UT1-STDPRICE      = T2-PRARTSTD                                        
         UT1-DAREGDAT      = T2-DAREGDAT                                        
         PRINT REPORT01                                                         
       END-IF                                                                   
 NEWPAGE                                                                        
   REPORT   REPORT01             +                                              
            PRINTER W5128LD3     +                                              
            PAGESIZE 32000       +                                              
            LINESIZE 110         +                                              
            SPACE 0              +                                              
            NOHEADING            +                                              
            NOSPREAD             +                                              
            NOADJUST             +                                              
            NOPAGE               +                                              
            NODATE                                                              
                                                                                
   LINE     UT1-IDPTYP           +                                              
            WS-SEMICOLON         +                                              
            UT1-IDARTNR          +                                              
            WS-SEMICOLON         +                                              
            UT1-IDDC             +                                              
            WS-SEMICOLON         +                                              
            UT1-IDLEVNR          +                                              
            WS-SEMICOLON         +                                              
            UT1-IDDISTR          +                                              
            WS-SEMICOLON         +                                              
            UT1-IDKUNDNR         +                                              
            WS-SEMICOLON         +                                              
            UT1-IDORDNR5         +                                              
            WS-SEMICOLON         +                                              
            UT1-IDFAKT           +                                              
            WS-SEMICOLON         +                                              
            UT1-IDLOPNRM         +                                              
            WS-SEMICOLON         +                                              
            UT1-KVAVIS           +                                              
            WS-SEMICOLON         +                                              
            UT1-STDPRICE         +                                              
            WS-SEMICOLON         +                                              
            UT1-DAREGDAT         +                                              
            WS-SEMICOLON                                                        
*                                                                               
BEFORE-LINE. PROC                                                               
  IF FIRST-LINE1 = 'J'                                                          
    DISPLAY '¤DAPW5128L-001'                                                    
    DISPLAY '¤DAPW5128L'                                                        
    DISPLAY 'IDPTYP;PART NUMBER;DC;SUPPLIER;DISTRICT;CUST NO;'        +         
            'ORDER NO;INVOICE;RECEIVING REPORT NO;QUANTITY;STD PRICE;'+         
            'DATE;'                                                             
    FIRST-LINE1  = 'N'                                                          
  END-IF                                                                        
END-PROC                                                                        
                                                                                
**********************************************************                      
* STEP 5. SORTS TPFIL3 ON IDARTNR AND IDDC                                      
**********************************************************                      
SORT TPFIL3   TO TPFIL3 USING (T3-IDARTNR T3-IDDC)                              
                                                                                
**********************************************************                      
* STEP 6. READS TPFIL2 (R31 FROM WDL6)                                          
**********************************************************                      
JOB INPUT (TPFIL3   KEY(T3-IDARTNR T3-IDDC))                                    
                                                                                
       IF LAST-DUP TPFIL3  OR NOT DUPLICATE TPFIL3                              
         UT2-IDPTYP        = T3-IDPTYP                                          
         UT2-IDARTNR       = T3-IDARTNR                                         
         UT2-IDDC          = T3-IDDC                                            
         UT2-IDLEVNR       = T3-IDLEVNR                                         
         UT2-IDDISTR       = T3-IDDISTR                                         
         UT2-IDKUNDNR      = T3-IDKUNDNR                                        
         UT2-IDORDNR5      = T3-IDORDNR5                                        
         UT2-IDFAKT        = T3-IDFAKT                                          
         UT2-IDLOPNRM      = T3-IDLOPNRM                                        
         UT2-KVAVIS        = T3-KVAVIS                                          
         UT2-STDPRICE      = T3-PRARTSTD                                        
         UT2-DAREGDAT      = T3-DAREGDAT                                        
         PRINT REPORT02                                                         
       END-IF                                                                   
 NEWPAGE                                                                        
   REPORT   REPORT02             +                                              
            PRINTER W5128LD4     +                                              
            PAGESIZE 32000       +                                              
            LINESIZE 110         +                                              
            SPACE 0              +                                              
            NOHEADING            +                                              
            NOSPREAD             +                                              
            NOADJUST             +                                              
            NOPAGE               +                                              
            NODATE                                                              
                                                                                
   LINE     UT2-IDPTYP           +                                              
            WS-SEMICOLON         +                                              
            UT2-IDARTNR          +                                              
            WS-SEMICOLON         +                                              
            UT2-IDDC             +                                              
            WS-SEMICOLON         +                                              
            UT2-IDLEVNR          +                                              
            WS-SEMICOLON         +                                              
            UT2-IDDISTR          +                                              
            WS-SEMICOLON         +                                              
            UT2-IDKUNDNR         +                                              
            WS-SEMICOLON         +                                              
            UT2-IDORDNR5         +                                              
            WS-SEMICOLON         +                                              
            UT2-IDFAKT           +                                              
            WS-SEMICOLON         +                                              
            UT2-IDLOPNRM         +                                              
            WS-SEMICOLON         +                                              
            UT2-KVAVIS           +                                              
            WS-SEMICOLON         +                                              
            UT2-STDPRICE         +                                              
            WS-SEMICOLON         +                                              
            UT2-DAREGDAT         +                                              
            WS-SEMICOLON                                                        
*                                                                               
BEFORE-LINE. PROC                                                               
  IF FIRST-LINE2 = 'J'                                                          
    DISPLAY '¤DAPW5128L-002'                                                    
    DISPLAY '¤DAPW5128L'                                                        
    DISPLAY 'IDPTYP;PART NUMBER;DC;SUPPLIER;DISTRICT;CUST NO;'        +         
            'ORDER NO;INVOICE;RECEIVING REPORT NO;QUANTITY;STD PRICE;'+         
            'DATE;'                                                             
    FIRST-LINE2  = 'N'                                                          
  END-IF                                                                        
END-PROC                                                                        
                                                                                
