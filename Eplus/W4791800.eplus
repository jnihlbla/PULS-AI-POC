NEWPAGE                                                                         
FILE W47918D1                                                                   
*                                                                               
%W479015  'IN-'                                                                 
*                                                                               
FILE W47918D2 PRINTER FB(121 121)                                               
*                                                                               
FILE W47918D3 PRINTER FB(121 121)                                               
*                                                                               
FILE W47918D4 PRINTER FB(121 121)                                               
*                                                                               
FILE W47918D5 PRINTER FB(121 121)                                               
*                                                                               
FILE W47918D6 PRINTER FB(121 121)                                               
*                                                                               
FILE W47918D7 PRINTER FB(121 121)                                               
*                                                                               
FILE W47918D8 PRINTER FB(121 121)                                               
*                                                                               
FILE W47918D9 PRINTER FB(121 121)                                               
*                                                                               
DISTRICT  W 5 P                                                                 
REGDATE   W 7 P                                                                 
IDKUNDNR  W 4 P                                                                 
IDORDNR7  W 7 N MASK 'ZZZZZZ9'                                                  
KL        W 1 P MASK '9'                                                        
CAUSE     W 20 A                                                                
DC        W 2  A                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
                                                                                
%WY2000W1                                                                       
W-Y2K-REGDATE   W  6  N                                                         
                                                                                
NEWPAGE                                                                         
*                                                                               
JOB INPUT W47918D1                                                              
                                                                                
    DISTRICT = IN-IDDISTR                                                       
    REGDATE  = IN-TIREGDAT                                                      
    IDKUNDNR = IN-IDKUNDNR                                                      
    IDORDNR7 = IN-IDORDNR7                                                      
    KL       = IN-KDORDKL                                                       
    DC       = IN-IDDC                                                          
    CAUSE    = ' '                                                              
    TMP1-YYMMDD = REGDATE                                                       
    PERFORM WY2000P1                                                            
    W-Y2K-REGDATE = TMP1-YYMMDD                                                 
                                                                                
    IF IN-IDPTYP = '001'                                                        
       CAUSE = 'ORDER-LINE *** '                                                
    ELSE                                                                        
      IF IN-IDPTYP = '003'                                                      
         CAUSE = 'ORDER CONFIRMATION'                                           
      ELSE                                                                      
         IF IN-IDPTYP = '004'                                                   
            CAUSE = 'PRINT-LINE *   '                                           
         END-IF                                                                 
      END-IF                                                                    
    END-IF                                                                      
                                                                                
    PRINT LIST1                                                                 
                                                                                
    IF DC = SDC-NL                                                              
      PRINT LIST3                                                               
    ELSE                                                                        
*     IF DC = '22'                                                              
*       PRINT LIST4                                                             
*     ELSE                                                                      
        IF DC = SDC-ES                                                          
          PRINT LIST6                                                           
        ELSE                                                                    
          IF DC = SDC-IT                                                        
            PRINT LIST7                                                         
          ELSE                                                                  
            IF DC = SDC-AT                                                      
              PRINT LIST8                                                       
            ELSE                                                                
              PRINT LIST2                                                       
            END-IF                                                              
          END-IF                                                                
        END-IF                                                                  
*     END-IF                                                                    
    END-IF                                                                      
                                                                                
%WY2000P1                                                                       
                                                                                
REPORT LIST1 PRINTER W47918D2   NOADJUST LINESIZE 120                           
SEQUENCE DC DISTRICT IDKUNDNR W-Y2K-REGDATE IDORDNR7                            
TITLE 1 COL 10 'VOLVO CAR PARTS              W47918-001     +                   
         UNCOMPLETED ORDER (STATUS "E")'                                        
HEADING IN-IDKUNDNR    ('CUSTOMER')                                             
HEADING IN-IDORDNR7    ('ORDER')                                                
HEADING IN-IDSYSTEM    ('SYST.')                                                
HEADING IN-IDPTYP      ('TYPE')                                                 
HEADING IN-IDUSER      ('REG.RESP.')                                            
LINE DISTRICT IDKUNDNR REGDATE IDORDNR7 KL +                                    
     IN-IDSYSTEM IN-IDPTYP IN-IDUSER CAUSE DC                                   
                                                                                
