                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6131800                                              *        
*                                                                      *        
*  FUNKTION   :  RÄKNAR FRAM ANTALET SVS-FÖRPACKNINGAR/TYP AV FÖRPACKN.*        
*                                                                      *        
*  FÖRFATTARE :  RAHUL REDDY                                           *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W61318D1                                                                   
%W6131301  'DB-'                                                                
                                                                                
FILE W61318D2                                                                   
%W6131201  'IN-'                                                                
                                                                                
FILE W61318D3 FB(39 0)                                                          
%W6131801  'UT-'                                                                
                                                                                
FILE W61318D4 FB(39 0)                                                          
%W6131801  'D4-'                                                                
                                                                                
FILE W61318D5 PRINTER VB(43 0)                                                  
                                                                                
NEWPAGE                                                                         
                                                                                
JA              W 1 A VALUE 'J'                                                 
NEJ             W 1 A VALUE 'N'                                                 
*                                                                               
KDFORP                   W 4 A                                                  
WS-IDDC                  W 2 A                                                  
KVANT-ST                 W 7 N                                                  
KVANT-28                 W 7 N                                                  
KVANT-GR                 W 7 N                                                  
KVANT-MA                 W 7 N                                                  
WS-VECKA                 W 4 A                                                  
*                                                                               
WS-PREV-IDDC             W 2 A                                                  
WS-FLSKRIV               W 1 A                                                  
WS-KDFORP                W 4 A                                                  
WS-KVANTAL               W 7 N                                                  
WS-KVANTAL-ST            W 7 N                                                  
WS-KVANTAL-28            W 7 N                                                  
WS-KVANTAL-GR            W 7 N                                                  
WS-KVANTAL-MA            W 7 N                                                  
*                                                                               
%WDATAREA                                                                       
*                                                                               
WDATKONV                 W 8 A VALUE 'WDATKONV'                                 
*                                                                               
DAGENS-DATUM             W 6 N                                                  
                                                                                
DATUM                    W 8 A                                                  
D-AA         DATUM         2 N                                                  
D-1          DATUM +2      1 A                                                  
D-MM         DATUM +3      2 N                                                  
D-2          DATUM +5      1 A                                                  
D-DD         DATUM +6      2 N                                                  
*                                                                               
DATUM-FIX                W 6 N                                                  
D-AA-FIX  DATUM-FIX        2 N                                                  
D-MM-FIX  DATUM-FIX +2     2 N                                                  
D-DD-FIX  DATUM-FIX +4     2 N                                                  
*                                                                               
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. RÄKNAR FRAM ANTALET FÖRPACKNINGAR AV OLIKA TYPER SOM                  
*         UTFÖRTS PÅ SVS UNDER DEN GÅNGNA VECKAN.                               
*                                                                               
JOB INPUT (W61318D1 KEY(DB-BEFT) W61318D2 KEY(IN-BEFT))                         
                                                                                
IF MATCHED                                                                      
  D4-KDFORP     = '0000'                                                        
  D4-IDDC       = '00'                                                          
  D4-KVANTAL-ST = 0                                                             
  D4-KVANTAL-28 = 0                                                             
  D4-KVANTAL-GR = 0                                                             
  D4-KVANTAL-MA = 0                                                             
  WS-FLSKRIV = NEJ                                                              
  IF DB-FLFPOMR-SVS = JA                                                        
    IF DB-FLSATSIN = JA                                                         
      WS-KVANTAL = IN-KVINLART                                                  
    ELSE                                                                        
      IF IN-KVINLART < IN-KVAVIS-KIT                                            
        WS-KVANTAL = 0                                                          
      ELSE                                                                      
        WS-KVANTAL = IN-KVINLART - IN-KVAVIS-KIT                                
      END-IF                                                                    
    END-IF                                                                      
    IF DB-REFPCDC > 0                                                           
      WS-KVANTAL = WS-KVANTAL * ((100 - DB-REFPCDC) / 100)                      
    END-IF                                                                      
    IF DB-FLFPGRP-ST = JA                                                       
      IF IN-KDFORP NE '0000'                                                    
        D4-KVANTAL-ST = WS-KVANTAL                                              
        WS-FLSKRIV = JA                                                         
      END-IF                                                                    
    END-IF                                                                      
    IF DB-FLFPGRP-28 = JA                                                       
      IF IN-KDFORP NE '0000'                                                    
        D4-KVANTAL-28 = WS-KVANTAL                                              
        WS-FLSKRIV = JA                                                         
      END-IF                                                                    
    END-IF                                                                      
    IF DB-FLFPGRP-GR = JA                                                       
      IF IN-KDFORP NE '0000'                                                    
        D4-KVANTAL-GR = WS-KVANTAL                                              
        WS-FLSKRIV = JA                                                         
      END-IF                                                                    
    END-IF                                                                      
    IF DB-FLFPGRP-MA = JA                                                       
      IF IN-KDFORP NE '0000'                                                    
        D4-KVANTAL-MA = WS-KVANTAL                                              
        WS-FLSKRIV = JA                                                         
      END-IF                                                                    
    END-IF                                                                      
    IF WS-FLSKRIV = JA                                                          
      D4-KDFORP = IN-KDFORP                                                     
      D4-IDDC   = IN-IDDC                                                       
      PUT W61318D4                                                              
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
                                                                                
SORT W61318D4 TO W61318D4 USING (D4-IDDC, D4-KDFORP)                            
                                                                                
JOB INPUT W61318D4 FINISH Z-FINIT                                               
                                                                                
IF RECORD-COUNT = 1                                                             
  WS-PREV-IDDC  = D4-IDDC                                                       
  WS-KVANTAL-ST = D4-KVANTAL-ST                                                 
  WS-KVANTAL-28 = D4-KVANTAL-28                                                 
  WS-KVANTAL-GR = D4-KVANTAL-GR                                                 
  WS-KVANTAL-MA = D4-KVANTAL-MA                                                 
  UT-W6131801   = D4-W6131801                                                   
  PUT W61318D3                                                                  
ELSE                                                                            
  IF D4-IDDC = WS-PREV-IDDC                                                     
    WS-KVANTAL-ST = WS-KVANTAL-ST + D4-KVANTAL-ST                               
    WS-KVANTAL-28 = WS-KVANTAL-28 + D4-KVANTAL-28                               
    WS-KVANTAL-GR = WS-KVANTAL-GR + D4-KVANTAL-GR                               
    WS-KVANTAL-MA = WS-KVANTAL-MA + D4-KVANTAL-MA                               
    UT-W6131801   = D4-W6131801                                                 
    PUT W61318D3                                                                
  ELSE                                                                          
    UT-KDFORP     = '0000'                                                      
    UT-IDDC       = WS-PREV-IDDC                                                
    UT-KVANTAL-ST = WS-KVANTAL-ST                                               
    UT-KVANTAL-28 = WS-KVANTAL-28                                               
    UT-KVANTAL-GR = WS-KVANTAL-GR                                               
    UT-KVANTAL-MA = WS-KVANTAL-MA                                               
    PUT W61318D3                                                                
    WS-PREV-IDDC  = D4-IDDC                                                     
    WS-KVANTAL-ST = D4-KVANTAL-ST                                               
    WS-KVANTAL-28 = D4-KVANTAL-28                                               
    WS-KVANTAL-GR = D4-KVANTAL-GR                                               
    WS-KVANTAL-MA = D4-KVANTAL-MA                                               
    UT-W6131801   = D4-W6131801                                                 
    PUT W61318D3                                                                
  END-IF                                                                        
END-IF                                                                          
                                                                                
Z-FINIT. PROC                                                                   
  IF RECORD-COUNT >= 1                                                          
    UT-KDFORP     = '0000'                                                      
    UT-IDDC       = WS-PREV-IDDC                                                
    UT-KVANTAL-ST = WS-KVANTAL-ST                                               
    UT-KVANTAL-28 = WS-KVANTAL-28                                               
    UT-KVANTAL-GR = WS-KVANTAL-GR                                               
    UT-KVANTAL-MA = WS-KVANTAL-MA                                               
    PUT W61318D3                                                                
  END-IF                                                                        
END-PROC                                                                        
                                                                                
SORT W61318D3 TO W61318D4 USING (UT-IDDC, UT-KDFORP)                            
                                                                                
JOB INPUT W61318D4 START A-INIT FINISH Z-FINIT                                  
                                                                                
IF RECORD-COUNT = 1                                                             
  WS-PREV-IDDC  = '  '                                                          
  WS-KDFORP     = D4-KDFORP                                                     
  WS-IDDC       = D4-IDDC                                                       
  WS-KVANTAL-ST = D4-KVANTAL-ST                                                 
  WS-KVANTAL-28 = D4-KVANTAL-28                                                 
  WS-KVANTAL-GR = D4-KVANTAL-GR                                                 
  WS-KVANTAL-MA = D4-KVANTAL-MA                                                 
ELSE                                                                            
  IF (WS-KDFORP = D4-KDFORP AND WS-IDDC = D4-IDDC)                              
    WS-KVANTAL-ST = WS-KVANTAL-ST + D4-KVANTAL-ST                               
    WS-KVANTAL-28 = WS-KVANTAL-28 + D4-KVANTAL-28                               
    WS-KVANTAL-GR = WS-KVANTAL-GR + D4-KVANTAL-GR                               
    WS-KVANTAL-MA = WS-KVANTAL-MA + D4-KVANTAL-MA                               
  ELSE                                                                          
    IF WS-KDFORP = '0000'                                                       
      KDFORP     = '    '                                                       
    ELSE                                                                        
      KDFORP     = WS-KDFORP                                                    
    END-IF                                                                      
    KVANT-ST = WS-KVANTAL-ST                                                    
    KVANT-28 = WS-KVANTAL-28                                                    
    KVANT-GR = WS-KVANTAL-GR                                                    
    KVANT-MA = WS-KVANTAL-MA                                                    
    PRINT REPORT01                                                              
    WS-KDFORP     = D4-KDFORP                                                   
    WS-IDDC       = D4-IDDC                                                     
    WS-KVANTAL-ST = D4-KVANTAL-ST                                               
    WS-KVANTAL-28 = D4-KVANTAL-28                                               
    WS-KVANTAL-GR = D4-KVANTAL-GR                                               
    WS-KVANTAL-MA = D4-KVANTAL-MA                                               
  END-IF                                                                        
END-IF                                                                          
                                                                                
A-INIT. PROC                                                                    
  DATUM          = SYSDATE                                                      
  D-AA-FIX      = D-AA                                                          
  D-MM-FIX      = D-MM                                                          
  D-DD-FIX      = D-DD                                                          
  DAGENS-DATUM  = DATUM-FIX                                                     
                                                                                
  DAT-KDDATFORM = 'AAMMDD'                                                      
  DAT-I-TIDATUM = DAGENS-DATUM                                                  
                                                                                
  CALL WDATKONV USING (DAT-KDDATFORM, +                                         
                       DAT-I-TIDATUM, +                                         
                       DAT-O-TIDATUM, +                                         
                       DAT-KDSVAR)                                              
                                                                                
  IF DAT-KDSVAR = ' '                                                           
    WS-VECKA    = DAT-TIAAVV-GRP                                                
  ELSE                                                                          
    DISPLAY 'FEL FRÅN DATKONV'                                                  
    STOP EXECUTE                                                                
  END-IF                                                                        
                                                                                
END-PROC                                                                        
                                                                                
Z-FINIT. PROC                                                                   
  IF RECORD-COUNT >= 1                                                          
    IF WS-KDFORP = '0000'                                                       
      KDFORP     = '    '                                                       
    ELSE                                                                        
      KDFORP     = WS-KDFORP                                                    
    END-IF                                                                      
    KVANT-ST = WS-KVANTAL-ST                                                    
    KVANT-28 = WS-KVANTAL-28                                                    
    KVANT-GR = WS-KVANTAL-GR                                                    
    KVANT-MA = WS-KVANTAL-MA                                                    
    PRINT REPORT01                                                              
  END-IF                                                                        
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
REPORT REPORT01 PRINTER W61318D5 LINESIZE 38      +                             
                                 NOHEADING        +                             
                                 NOADJUST         +                             
                                 NODATE           +                             
                                 NOSPREAD         +                             
                                 SPACE 0                                        
LINE    1   WS-IDDC    +                                                        
            KDFORP     +                                                        
            KVANT-ST   +                                                        
            KVANT-28   +                                                        
            KVANT-GR   +                                                        
            KVANT-MA   +                                                        
            WS-VECKA                                                            
BEFORE-LINE. PROC                                                               
  IF WS-IDDC NE WS-PREV-IDDC                                                    
    DISPLAY '¤DAPW61318-001'                                                    
    DISPLAY '¤DAP' WS-IDDC                                                      
    WS-PREV-IDDC = WS-IDDC                                                      
  END-IF                                                                        
END-PROC                                                                        
