              END-IF                                                            
              IF RES-SUARTFSG-RAAR NE 0                                         
                 W-TG-AF2 = (100 * (RES-SUARTFSG-RAAR - +                       
                            RES-SUARTSJK-RAAR)) / RES-SUARTFSG-RAAR             
                IF W-TG-AF2 >= 0                                                
                  W-TG-AF2 = W-TG-AF2 + 0.05                                    
                ELSE                                                            
                  W-TG-AF2 = W-TG-AF2 - 0.05                                    
                END-IF                                                          
                W-TG-AF2-UT = W-TG-AF2                                          
              END-IF                                                            
              W-SUARTFSG-NODC = RES-SUARTFSG-RAAR                               
              W-SUARTSJK-NODC = RES-SUARTSJK-RAAR                               
              W-SULEVANT-RAAR = RES-SULEVANT-RAAR                               
              W-SULEVANT-FRAAR = RES-SULEVANT-FRAAR                             
              DISPLAY '                   '                                     
              DISPLAY COL 005 'URVAL-TOTAL'      +                              
                      COL 056 W-SUARTFSG-NODC    +                              
                      COL 070 W-SULEVANT-RAAR  +                                
                      COL 083 W-SULEVANT-FRAAR +                                
                      COL 096 W-DIFF-TOT-UT      +                              
                      COL 104 W-SUARTSJK-NODC    +                              
                      COL 116 W-TG-AF2-UT                                       
           END-IF                                                               
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
   END-IF                                                                       
END-PROC                                                                        
AFTER-BREAK. PROC                                                               
   W-TG-AF2 = 0                                                                 
   W-DIFF-TOT = 0                                                               
END-PROC                                                                        
