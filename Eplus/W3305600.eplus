*                                                                               
  REPORT RAPPORT-S1 SPACE 1 +                                                   
         PRINTER W33056D2 +                                                     
         LINESIZE 120        +                                                  
         NOADJUST            +                                                  
         TITLESKIP 1         +                                                  
         NOHEADING           +                                                  
         SUMCTL NONE                                                            
                                                                                
    SEQUENCE RES-IDUSER W-Y2K-DAREGDAT RES-TIREGTID +                           
             RES-KDPRODSL RES-IDFKNGRP RES-SUARTFSG-RAAR D                      
                                                                                
    CONTROL  FINAL NOPRINT +                                                    
             RES-IDUSER NOPRINT W-REGDATUM NOPRINT            +                 
             W-REGTID RENUM NOPRINT                           +                 
             W-BRYT-KDPRODSL NOPRINT                          +                 
             W-FKN-TUSEN NOPRINT                              +                 
             W-FKN-HUNDRA NOPRINT                             +                 
             W-FKN-TIOTAL NOPRINT                             +                 
             W-FKN-ENTAL NOPRINT NEWPAGE                      +                 
                                                                                
    SUM      RES-SUARTFSG-RAAR RES-SULEVANT-RAAR          +                     
             RES-SULEVANT-FRAAR RES-SUARTSJK-RAAR                               
                                                                                
    TITLE 1 COL 005 ' '                                                         
                                                                                
    TITLE 2 COL 004 'VOLVO PARTS AB'                +                           
            COL 024 'W33056-001'                    +                           
            COL 040 BILD04-IDPTYP                   +                           
            COL 047 'STORSÄLJARE (PS, FKNGRP,'      +                           
                    ' AF2)'                         +                           
            COL 080 'USERID '                       +                           
            COL 088 RES-IDUSER                      +                           
            COL 098 'DATUM'                         +                           
            COL 105 W-REGDATUM                                                  
                                                                                
    TITLE 3 COL 098 'TID'                           +                           
            COL 105 W-REGTID                                                    
                                                                                
    TITLE 4  COL 004 ' PS'                     +                                
             COL 011 'NR'                      +                                
             COL 016 'ARTIKEL'                 +                                
             COL 025 'ARTIKELBENÄMNING'        +                                
             COL 050 'FKN'                     +                                
             COL 066 'AF2'                     +                                
             COL 078 'AF2'                     +                                
             COL 091 'AF1'                     +                                
             COL 097 'AF2'                     +                                
             COL 106 'SJÄLVKOST'               +                                
             COL 118 'TG'                                                       
                                                                                
    TITLE 5  COL 016 '     NR'                 +                                
             COL 050 'GRP'                     +                                
             COL 066 ' KR'                     +                                
             COL 078 ' ST'                     +                                
             COL 091 ' ST'                     +                                
             COL 097 'AF1'                                                      
                                                                                
    TITLE 6  COL 097 ' ST'                                                      
                                                                                
    LINE 1   COL 004 RES-KDPRODSL              +                                
             COL 007 RES-IDRADNR               +                                
             COL 015 W-IDARTNR                 +                                
             COL 025 RES-BEART-SVE             +                                
             COL 049 W-FKN-GRP                 +                                
             COL 056 W-SUARTFSG-RAAR           +                                
             COL 070 W-RAD-SULEVANT-RAAR       +                                
             COL 083 W-RAD-SULEVANT-FRAAR      +                                
             COL 096 W-RELEVANT-RAAR           +                                
             COL 104 W-SUARTSJK-RAAR           +                                
             COL 116 W-RETOTBV-RAAR                                             
                                                                                
BEFORE-BREAK. PROC                                                              
   IF LEVEL = 1                                                                 
      IF RES-SULEVANT-FRAAR NE 0                                                
         W-DIFF-TOT = (100 * (RES-SULEVANT-RAAR -  +                            
                    RES-SULEVANT-FRAAR)) / RES-SULEVANT-FRAAR                   
         IF W-DIFF-TOT >= 0                                                     
           W-DIFF-TOT = W-DIFF-TOT + 0.05                                       
         ELSE                                                                   
           W-DIFF-TOT = W-DIFF-TOT - 0.05                                       
         END-IF                                                                 
         IF W-DIFF-TOT > +999.9                                                 
            W-DIFF-TOT-UT = +999.9                                              
         ELSE                                                                   
           IF W-DIFF-TOT < -999.9                                               
              W-DIFF-TOT-UT = -999.9                                            
           ELSE                                                                 
              W-DIFF-TOT-UT = W-DIFF-TOT                                        
           END-IF                                                               
         END-IF                                                                 
      ELSE                                                                      
         IF RES-SULEVANT-RAAR NE 0                                              
            W-DIFF-TOT-UT = 999.9                                               
         ELSE                                                                   
            W-DIFF-TOT-UT = 0                                                   
        END-IF                                                                  
      END-IF                                                                    
      IF RES-SUARTFSG-RAAR NE 0                                                 
         W-TG-AF2 = (100 * (RES-SUARTFSG-RAAR - +                               
                    RES-SUARTSJK-RAAR)) / RES-SUARTFSG-RAAR                     
         IF W-TG-AF2 >= 0                                                       
           W-TG-AF2 = W-TG-AF2 + 0.05                                           
         ELSE                                                                   
           W-TG-AF2 = W-TG-AF2 - 0.05                                           
