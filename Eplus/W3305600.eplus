JOB INPUT W33056D1 START INIT-PROC                                              
*                                                                               
*                                                                               
  IF BILD04-IDGTYP NE 5                                                         
                                                                                
        IF BILD04-IDGTYP = 0                                                    
           MOVE '*** URVALET SAKNAR RESULTAT ***' TO         +                  
                W-RESULTAT-SAKNAS                                               
        ELSE                                                                    
           MOVE '                               ' TO         +                  
                W-RESULTAT-SAKNAS                                               
        END-IF                                                                  
                                                                                
     W-REGDATUM = BILD04-DAREGDAT                                               
     W-REGTID = BILD04-TIREGTID                                                 
                                                                                
     W-IDKONCNR01 = BILD04-IDKONCNR(1)                                          
     W-IDKONCNR02 = BILD04-IDKONCNR(2)                                          
     W-IDKONCNR03 = BILD04-IDKONCNR(3)                                          
     W-IDKONCNR04 = BILD04-IDKONCNR(4)                                          
     W-IDKONCNR05 = BILD04-IDKONCNR(5)                                          
     W-IDKONCNR06 = BILD04-IDKONCNR(6)                                          
     W-IDKONCNR07 = BILD04-IDKONCNR(7)                                          
     W-IDKONCNR08 = BILD04-IDKONCNR(8)                                          
                                                                                
     W-IDLEVNR01 = BILD04-IDLEVNR(1)                                            
     W-IDLEVNR02 = BILD04-IDLEVNR(2)                                            
     W-IDLEVNR03 = BILD04-IDLEVNR(3)                                            
     W-IDLEVNR04 = BILD04-IDLEVNR(4)                                            
     W-IDLEVNR05 = BILD04-IDLEVNR(5)                                            
     W-IDLEVNR06 = BILD04-IDLEVNR(6)                                            
     W-IDLEVNR07 = BILD04-IDLEVNR(7)                                            
     W-IDLEVNR08 = BILD04-IDLEVNR(8)                                            
                                                                                
     PERFORM FLYTTA-KONCERN                                                     
                                                                                
     PERFORM FLYTTA-MARKNADSGRUPPER                                             
                                                                                
     PERFORM FLYTTA-DISTRIKTSGRUPPER                                            
                                                                                
     PERFORM FLYTTA-ANSKAFFARGRUPPER                                            
                                                                                
     W-IDFKNGRP-FOM = BILD04-IDFKNGRP-FOM                                       
     W-IDFKNGRP-TOM = BILD04-IDFKNGRP-TOM                                       
     PRINT RAPPORT04                                                            
  ELSE                                                                          
     W-REGDATUM = RES-DAREGDAT                                                  
     W-REGTID = RES-TIREGTID                                                    
     W-IDARTNR = RES-IDARTNR                                                    
     W-FKN-GRP = RES-IDFKNGRP                                                   
     W-BRYT-KDPRODSL = RES-KDPRODSL                                             
     W-SUARTFSG-RAAR = RES-SUARTFSG-RAAR                                        
     W-RAD-SULEVANT-RAAR = RES-SULEVANT-RAAR                                    
     W-RAD-SULEVANT-FRAAR = RES-SULEVANT-FRAAR                                  
     W-SUARTSJK-RAAR = RES-SUARTSJK-RAAR                                        
     W-SULEVANT-RAAR = RES-SULEVANT-RAAR                                        
     W-SULEVANT-FRAAR = RES-SULEVANT-FRAAR                                      
     W-RELEVANT-RAAR = RES-RELEVANT-RAAR                                        
     W-RETOTBV-RAAR = RES-RETOTBV-RAAR                                          
                                                                                
     W-Y2K-DAREGDAT = RES-DAREGDAT                                              
                                                                                
     IF RES-IDPTYP = 'S1 '                                                      
       PRINT RAPPORT-S1                                                         
     ELSE                                                                       
       PRINT RAPPORT-S1A                                                        
     END-IF                                                                     
  END-IF                                                                        
