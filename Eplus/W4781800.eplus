                                                                                
*----------------------------------------------------------------------*        
*      FUNKTION :    PROGRAMMET SKAPAR EN 'DAGLIG UPPFÖLJNINGS-                 
*                    LISTA TILL RA' SOM BESTÅR AV TRE DELAR                     
*                    . VAGNORDER KLASS 1, 2, 3, 4 OCH 5 SOM ÄR                  
*                      UTSKRIVNA MEN EJ PACKNINGSRAPPORTERADE                   
*                    . ORDERKLASS 0 SOM EJ ÄR LASTNINGSRAPPORTERADE             
*                    . ORDERKLASS 1 SOM EJ ÄR LASTNINGSRAPPORTERADE             
*                                                                               
*                    PROGRAMMET SKAPAR TVÅ OLIKA LISTOR, EN FÖR                 
*                    SVERIGEORDER, OCH EN FÖR CDC.                              
*                                                                               
*      INFIL    :    W478.W478D1.W47817 ÄR SORTERAD PÅ IDTTYP                   
*----------------------------------------------------------------------*        
                                                                                
FILE W47818D1                                                                   
*                                                                               
%W47817   'IN-'                                                                 
ARB-IDPRODNR IN-IDPRODNR 4 P   HEADING 'PROD.NR'                                
*                                                                               
FILE W47818D2 PRINTER                                                           
*                                                                               
FILE W47818D3 PRINTER                                                           
*                                                                               
SIDA             S 3 N    VALUE 1 MASK ('ZZ9')                                  
SIDA1            S 3 N    VALUE 1 MASK ('ZZ9')                                  
SIDA2            S 3 N    VALUE 1 MASK ('ZZ9')                                  
ARB-DATUM        W 3 N                                                          
VECKA ARB-DATUM    2 N                                                          
DAG   ARB-DATUM +2 1 N                                                          
KLASS        W 1 N        MASK ('9')                                            
ARB-IDDISTR  W 3 P        HEADING 'DISTR'                                       
ARB-IDKUNDNR W 4 P        HEADING 'KUNDNR'                                      
ARB-IDKUNDRF W 10 A       HEADING 'ORDERNR'                                     
ARB-TIBEGPAC W  6 N       HEADING 'BEG.PAC'                                     
ARB-VKORDNTO W  4 P 1     HEADING 'NETTOVIKT'                                   
ARB-VLORDNTO W  4 P 3     HEADING 'NETTOVOLYM'                                  
ARB-BEPERSON W  5 A       HEADING 'PK'                                          
ARB-BETELNR  W 10 A       HEADING ' '                                           
VAGN         W  6 A       HEADING 'VAGN-NR'                                     
VAGN1  VAGN     2 A                                                             
VAGN2  VAGN +2  1 A       VALUE   '-'                                           
VAGN3  VAGN +3  3 A                                                             
*                                                                               
* PARAMETRAR TILL DATUMKORT                                                     
%WDATKORT                                                                       
DATUMKORT-ID S  6 A       VALUE 'WDATUM'                                        
PROGRAM-NAMN S  8 A       VALUE 'W4781800'                                      
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
                                                                                
*    -- CHECKED BY WY2000                                                       
JOB INPUT(W47818D1) START INIT NAME AKT01                                       
*                                                                               
  VAGN1 = IN-KDORDLOT                                                           
  VAGN3 = IN-IDLOTNR                                                            
  IF IN-IDDC = CDC-SE AND IN-IDDISTR = 1 THRU 799                               
     PERFORM RAPP-1-2                                                           
  END-IF                                                                        
*                                                                               
  IF IN-IDDC = CDC-SE AND IN-IDDISTR NE 1 THRU 799                              
     PERFORM RAPP-3-4                                                           
  END-IF                                                                        
*                                                                               
  INIT.        PROC                                                             
  CALL DATKORT USING (PROGRAM-NAMN, DATUMKORT-ID, DATUMKORT)                    
  VECKA = D-VECKA                                                               
  DAG   = D-DAGNR                                                               
  END-PROC                                                                      
*                                                                               
  RAPP-1-2.    PROC                                                             
   ARB-BEPERSON  = IN-BEPERSON                                                  
   ARB-BETELNR   = IN-BETELNR                                                   
   ARB-VKORDNTO  = IN-VKORDNTO                                                  
   ARB-VLORDNTO  = IN-VLORDNTO                                                  
   ARB-TIBEGPAC  = IN-TIBEGPAC                                                  
   IF IN-IDTTYP = '001'                                                         
      IF IN-IDKUNDRF NOT SPACES                                                 
         ARB-IDDISTR  = IN-IDDISTR                                              
         ARB-IDKUNDNR = IN-IDKUNDNR                                             
         ARB-IDKUNDRF = IN-IDKUNDRF                                             
      ELSE                                                                      
         PRINT RAPPORT01                                                        
      END-IF                                                                    
      GOTO JOB                                                                  
   END-IF                                                                       
*                                                                               
   IF IN-IDTTYP = '002' '003'                                                   
      IF IN-IDTTYP = '002'                                                      
         KLASS = 0                                                              
      END-IF                                                                    
      IF IN-IDTTYP = '003'                                                      
         KLASS = 1                                                              
      END-IF                                                                    
      IF IN-IDKUNDRF NOT SPACES                                                 
         ARB-IDDISTR  = IN-IDDISTR                                              
         ARB-IDKUNDNR = IN-IDKUNDNR                                             
         ARB-IDKUNDRF = IN-IDKUNDRF                                             
      ELSE                                                                      
         IF IN-IDKOLLI = 0                                                      
            ARB-VKORDNTO = IN-VKORDNTO                                          
            ARB-VLORDNTO = IN-VLORDNTO                                          
            PRINT RAPPORT02                                                     
         ELSE                                                                   
            MOVE ZEROS  TO ARB-VKORDNTO                                         
            MOVE ZEROS  TO ARB-VLORDNTO                                         
            MOVE SPACES TO ARB-BEPERSON                                         
            MOVE SPACES TO ARB-BETELNR                                          
            PRINT RAPPORT02                                                     
         END-IF                                                                 
      END-IF                                                                    
      GOTO JOB                                                                  
   END-IF                                                                       
*                                                                               
  END-PROC                                                                      
*                                                                               
  RAPP-3-4.   PROC                                                              
   ARB-BEPERSON  = IN-BEPERSON                                                  
   ARB-BETELNR   = IN-BETELNR                                                   
   ARB-VKORDNTO  = IN-VKORDNTO                                                  
   ARB-VLORDNTO  = IN-VLORDNTO                                                  
   ARB-TIBEGPAC  = IN-TIBEGPAC                                                  
   IF IN-IDTTYP = '001'                                                         
      IF IN-IDKUNDRF NOT SPACES                                                 
         ARB-IDDISTR  = IN-IDDISTR                                              
         ARB-IDKUNDNR = IN-IDKUNDNR                                             
         ARB-IDKUNDRF = IN-IDKUNDRF                                             
      ELSE                                                                      
         PRINT RAPPORT03                                                        
      END-IF                                                                    
      GOTO JOB                                                                  
   END-IF                                                                       
*                                                                               
   IF IN-IDTTYP = '002' '003'                                                   
      IF IN-IDTTYP = '002'                                                      
         KLASS = 0                                                              
      END-IF                                                                    
      IF IN-IDTTYP = '003'                                                      
         KLASS = 1                                                              
      END-IF                                                                    
      IF IN-IDKUNDRF NOT SPACES                                                 
         ARB-IDDISTR  = IN-IDDISTR                                              
         ARB-IDKUNDNR = IN-IDKUNDNR                                             
         ARB-IDKUNDRF = IN-IDKUNDRF                                             
      ELSE                                                                      
         IF IN-IDKOLLI = 0                                                      
            ARB-VKORDNTO = IN-VKORDNTO                                          
            ARB-VLORDNTO = IN-VLORDNTO                                          
            PRINT RAPPORT04                                                     
         ELSE                                                                   
            MOVE ZEROS  TO ARB-VKORDNTO                                         
            MOVE ZEROS  TO ARB-VLORDNTO                                         
            MOVE SPACES TO ARB-BEPERSON                                         
            MOVE SPACES TO ARB-BETELNR                                          
            PRINT RAPPORT04                                                     
         END-IF                                                                 
      END-IF                                                                    
      GOTO JOB                                                                  
   END-IF                                                                       
  END-PROC                                                                      
*                                                                               
  REPORT RAPPORT01  +                                                           
         LINESIZE 121 SPACE 1 NODATE NOPAGE TITLESKIP 2 +                       
         PRINTER W47818D2                                                       
    TITLE 1 'DATUM' ARB-DATUM '     ' 'PARTS DISTRIBUTION ' +                   
            'W47818-001    ' +                                                  
            'DAGLIG UPPFÖLJNINGSLISTA SVERIGE' '     ' 'SIDA ' SIDA             
    TITLE 3 'FÖLJANDE ORDER KLASS 2 OCH 3' +                                    
            'ÄR UTSKRIVNA MEN EJ PACKNINGSRAPPORTERADE'                         
    HEADING IN-KDFRAKT  'FK'                                                    
    LINE     ARB-IDDISTR ARB-IDKUNDNR ARB-IDKUNDRF ARB-IDPRODNR +               
             IN-KDFRAKT ARB-VKORDNTO ARB-VLORDNTO VAGN +                        
             ARB-TIBEGPAC ARB-BEPERSON ARB-BETELNR                              
    ENDPAGE.   PROC                                                             
       SIDA = SIDA + 1                                                          
    END-PROC                                                                    
  REPORT RAPPORT02  +                                                           
         LINESIZE 121 SPACE 1 NODATE NOPAGE TITLESKIP 2 +                       
         DTLCTL NONE PRINTER W47818D2                                           
    CONTROL FINAL (NOPRINT)KLASS (NEWPAGE NOPRINT)                              
    TITLE 1 'DATUM' ARB-DATUM '     ' 'PARTS DISTRIBUTION ' +                   
            'W47818-001    ' +                                                  
            'DAGLIG UPPFÖLJNINGSLISTA SVERIGE' '     ' 'SIDA ' SIDA             
    TITLE 3 'FÖLJANDE ORDER KLASS' KLASS   +                                    
            'ÄR UTSKRIVNA MEN EJ PACKNINGSRAPPORTERADE'                         
    HEADING IN-KDFRAKT  'FK'                                                    
    LINE     ARB-IDDISTR ARB-IDKUNDNR IN-KDFRAKT ARB-IDKUNDRF +                 
             ARB-IDPRODNR ARB-TIBEGPAC ARB-VKORDNTO +                           
             ARB-VLORDNTO ARB-BEPERSON ARB-BETELNR                              
    ENDPAGE.   PROC                                                             
       SIDA = SIDA + 1                                                          
    END-PROC                                                                    
  REPORT RAPPORT03  +                                                           
         LINESIZE 121 SPACE 1 NODATE NOPAGE TITLESKIP 2 +                       
         PRINTER W47818D3                                                       
    TITLE 1 'DATUM' ARB-DATUM '     ' 'PARTS DISTRIBUTION ' +                   
            'W47818-002    ' +                                                  
            'DAGLIG UPPFÖLJNINGSLISTA EXPORT ' '     ' 'SIDA ' SIDA1            
    TITLE 3 'FÖLJANDE ORDER KLASS 2 OCH 3' +                                    
            'ÄR UTSKRIVNA MEN EJ PACKNINGSRAPPORTERADE'                         
    HEADING IN-KDFRAKT  'FK'                                                    
    LINE     ARB-IDDISTR ARB-IDKUNDNR ARB-IDKUNDRF ARB-IDPRODNR +               
             IN-KDFRAKT ARB-VKORDNTO ARB-VLORDNTO VAGN +                        
             ARB-TIBEGPAC ARB-BEPERSON ARB-BETELNR                              
    ENDPAGE.   PROC                                                             
       SIDA1 = SIDA1 + 1                                                        
    END-PROC                                                                    
  REPORT RAPPORT04  +                                                           
         LINESIZE 121 SPACE 1 NODATE NOPAGE TITLESKIP 2 +                       
         DTLCTL NONE PRINTER W47818D3                                           
    CONTROL FINAL (NOPRINT) KLASS (NEWPAGE NOPRINT)                             
    TITLE 1 'DATUM' ARB-DATUM '     ' 'PARTS DISTRIBUTION ' +                   
             'W47818-002    ' +                                                 
            'DAGLIG UPPFÖLJNINGSLISTA SVERIGE' '     ' 'SIDA ' SIDA1            
    TITLE 3 'FÖLJANDE ORDER KLASS' KLASS   +                                    
            'ÄR UTSKRIVNA MEN EJ PACKNINGSRAPPORTERADE'                         
    HEADING IN-KDFRAKT  'FK'                                                    
    LINE     ARB-IDDISTR ARB-IDKUNDNR IN-KDFRAKT ARB-IDKUNDRF +                 
             ARB-IDPRODNR ARB-TIBEGPAC ARB-VKORDNTO +                           
             ARB-VLORDNTO VAGN ARB-BEPERSON ARB-BETELNR                         
    ENDPAGE.   PROC                                                             
       SIDA1 = SIDA1 + 1                                                        
    END-PROC                                                                    
