                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4633700                                              *        
*                                                                      *        
*  FUNKTION   :  SKRIVER RAPPORT MED MJUKVARUORDER                     *        
*                FRÅN INTERNA DISTRIKT                                 *        
*                                                                      *        
*  FÖRFATTARE :  GERRY 980613                                          *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W46337D1                                                                   
*                                                                               
%W46337  'IN-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE W46337D2  PRINTER FB (121 121)                                             
                                                                                
NEWPAGE                                                                         
FILE TEMPFIL1 FB (59 0) VIRTUAL RETAIN                                          
*                                                                               
%W46337  'TEMP1-'                                                               
                                                                                
* ARBETSFÄLT                                                                    
  W-IDDISTR      W  4 N   MASK 'ZZZ9'                                           
  W-IDKUNDNR     W  6 N   MASK 'ZZZZZ9'                                         
  W-IDARTNR      W  8 N   MASK 'ZZZZZZZ9'                                       
  W-KVLEVART     W  6 N   MASK 'ZZZZZ9'                                         
  W-IDKLIENT     W 10 A                                                         
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
* STEG 1. ADDERAR ANTAL LEVERERADE PER DISTRIKT KUND OCH VADIS KLIENT           
JOB INPUT NULL                                               +                  
                                         NAME STEG01                            
  GET W46337D1                                                                  
  DO WHILE NOT EOF W46337D1                                                     
    W-IDDISTR      =  IN-IDDISTR                                                
    W-IDKUNDNR     =  IN-IDKUNDNR                                               
    W-IDARTNR      =  IN-IDARTNR                                                
    W-IDKLIENT     =  IN-IDKLIENT                                               
    TEMP1-IDDISTR  = W-IDDISTR                                                  
    TEMP1-IDKUNDNR = W-IDKUNDNR                                                 
    TEMP1-IDKLIENT = IN-IDKLIENT                                                
    TEMP1-BEART    = IN-BEART                                                   
    TEMP1-IDARTNR  = IN-IDARTNR                                                 
    W-KVLEVART     =  0                                                         
    DO WHILE NOT EOF W46337D1 AND IN-IDDISTR  = W-IDDISTR   +                   
                              AND IN-IDKUNDNR = W-IDKUNDNR  +                   
                              AND IN-IDARTNR  = W-IDARTNR   +                   
                              AND IN-IDKLIENT = W-IDKLIENT                      
      W-KVLEVART   =  W-KVLEVART + IN-KVLEVART                                  
      GET W46337D1                                                              
    END-DO                                                                      
    TEMP1-KVLEVART = W-KVLEVART                                                 
    PUT TEMPFIL1                                                                
  END-DO                                                                        
STOP                                                                            
*                                                                               
NEWPAGE                                                                         
*                                                                               
* STEG 2. LÄSER TEMPFIL OCH SKRIVER RAPPORT                                     
*                                                                               
JOB INPUT TEMPFIL1                                                              
  W-IDDISTR      = TEMP1-IDDISTR                                                
  W-IDKUNDNR     = TEMP1-IDKUNDNR                                               
  W-IDARTNR      = TEMP1-IDARTNR                                                
  W-KVLEVART     = TEMP1-KVLEVART                                               
                                                                                
  PRINT W46337-001                                                              
                                                                                
NEWPAGE                                                                         
REPORT W46337-001  PRINTER W46337D2 +                                           
                   LINESIZE 120     +                                           
                   SPACE 2          +                                           
                   NOADJUST         +                                           
                   NODATE                                                       
                                                                                
*EQUENCE W-IDDISTR                                                              
CONTROL FINAL NOPRINT                                                           
                                                                                
TITLE 01                                                            +           
COL   02 'VOLVO CARS, CUSTOMER SERVICE   W46337-001'                +           
COL   85 'DATUM ' SYSDATE-LONG                                                  
TITLE 03                                                            +           
COL   25 'SOFTWARE ORDER - INTERNA DISTRIKT   '                                 
HEADING  W-IDDISTR       ('DIST')                                               
HEADING  W-IDKUNDNR      ('  KUND ')                                            
HEADING  TEMP1-IDKLIENT  ('VADIS KLIENT')                                       
HEADING  W-IDARTNR       (' ARTIKEL')                                           
HEADING  TEMP1-BEART     ('BENÄMNING')                                          
HEADING  W-KVLEVART      ('  KVANT')                                            
LINE  1  COL 02          +                                                      
         W-IDDISTR       +                                                      
         W-IDKUNDNR      +                                                      
         TEMP1-IDKLIENT  +                                                      
         W-IDARTNR       +                                                      
         TEMP1-BEART     +                                                      
         W-KVLEVART                                                             
