                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  WF106400                                              *        
*                                                                      *        
*  FUNKTION   :  SW DOWNLOAD REPORT FOR RUSSIA                         *        
*                                                                      *        
*  FÖRFATTARE :  BARSHARANI BISHOYE                                    *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE WF1064D1                                                                   
*                                                                               
%WF1063                                                                         
NEWPAGE                                                                         
FILE WF1064D2 PRINTER VB(230 0)                                                 
                                                                                
UT1-DAEXDAT              W    8   A                                             
UT1-DAREFDAT             W    8   A                                             
UT1-IDPARTNR             W    9   A                                             
UT1-IDEXCUST-1           W   15   A                                             
UT1-IDEXCUST-2           W   15   A                                             
UT1-IDREF                W   15   A                                             
UT1-BEVOLREF             W   10   A                                             
UT1-IDARTNR-FINANCE      W   50   A                                             
UT1-BEART                W   25   A                                             
UT1-KVLEVART             W    7   N                                             
UT1-PRARTNTO             W    7   N  2 MASK  'ZZZZ9.99'   VALUE 0               
UT1-BELEVVIL             W   35   A                                             
UT1-IDLEVNR-ART          W    5   A                                             
UT1-SEM1                 W    1   A            VALUE ';'                        
*                                                                               
NEWPAGE                                                                         
*****************************************************                           
*WORKING STORAGE                                    *                           
*****************************************************                           
SW-FIRST                             S    1   A        VALUE 'J'                
JA                                   W    1   A        VALUE 'J'                
NEJ                                  W    1   A        VALUE 'N'                
******************************************************                          
  JOB INPUT  WF1064D1                                                           
  UT1-DAEXDAT            = UT-DAEXDAT                                           
  UT1-DAREFDAT           = UT-DAREFDAT                                          
  UT1-IDPARTNR           = UT-IDPARTNR                                          
  UT1-IDEXCUST-1         = UT-IDEXCUST-1                                        
  UT1-IDEXCUST-2         = UT-IDEXCUST-2                                        
  UT1-IDREF              = UT-IDREF                                             
  UT1-BEVOLREF           = UT-BEVOLREF                                          
  UT1-IDARTNR-FINANCE    = UT-IDARTNR-FINANCE                                   
  UT1-BEART              = UT-BEART                                             
  UT1-KVLEVART           = UT-KVLEVART                                          
  UT1-PRARTNTO           = UT-PRARTNTO                                          
  UT1-BELEVVIL           = UT-BELEVVIL                                          
  UT1-IDLEVNR-ART        = UT-IDLEVNR-ART                                       
  UT1-SEM1               = ';'                                                  
                                                                                
  PRINT RPT1                                                                    
*-----------------------------------------------------------------*             
*     REPORT  WF1064-001                                                        
*-----------------------------------------------------------------*             
  REPORT    RPT1                +                                               
            PRINTER   WF1064D2  +                                               
            LINESIZE  225       +                                               
            PAGESIZE  32000     +                                               
            NOHEADING           +                                               
            SPACE     0         +                                               
            SKIP      0         +                                               
            TITLESKIP 0         +                                               
            NOADJUST            +                                               
            NOSPREAD                                                            
*                                                                               
LINE 01                         +                                               
       UT1-DAEXDAT              +                                               
       UT1-SEM1                 +                                               
       UT1-DAREFDAT             +                                               
       UT1-SEM1                 +                                               
       UT1-IDPARTNR             +                                               
       UT1-SEM1                 +                                               
       UT1-IDEXCUST-1           +                                               
       UT1-SEM1                 +                                               
       UT1-IDEXCUST-2           +                                               
       UT1-SEM1                 +                                               
       UT1-IDREF                +                                               
       UT1-SEM1                 +                                               
       UT1-BEVOLREF             +                                               
       UT1-SEM1                 +                                               
       UT1-IDARTNR-FINANCE      +                                               
       UT1-SEM1                 +                                               
       UT1-BEART                +                                               
       UT1-SEM1                 +                                               
       UT1-KVLEVART             +                                               
       UT1-SEM1                 +                                               
       UT1-PRARTNTO             +                                               
       UT1-SEM1                 +                                               
       UT1-BELEVVIL             +                                               
       UT1-SEM1                 +                                               
       UT1-IDLEVNR-ART          +                                               
                                                                                
BEFORE-LINE. PROC                                                               
 IF SW-FIRST = JA                                                               
  DISPLAY '¤DAPWF1064-001'                                                      
  DISPLAY '¤DAPWF1064'                                                          
  DISPLAY 'INVOICE DATE;ORDER DATE;PARMA NO;DISTRICT;CUSTOMER;'     +           
          'ORDER NO;VOLVO REFERENCE;IDARTNR-FINANCE;DESCRIPTION;'   +           
          'QUANTITY;NET PRICE;DELIVERY TERMS;SUPPLIER'                          
    SW-FIRST = NEJ                                                              
 END-IF                                                                         
END-PROC                                                                        
