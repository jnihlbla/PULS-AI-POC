*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W9102200                                              *        
*                                                                      *        
*  FUNKTION   :  PROGRAMMET LÄSER FIL W01160                           *        
*                MATCHAR MOT W01103 OCH SKRIVER                        *        
*                TOTALFIL MED ERSÄTTNINGAR TILL PPMS                   *        
*                                                                      *        
*  FÖRFATTARE :  JOHAN NIHLBLAD                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W91022D1                                                                   
*                                                                               
%W01160  'IN1-'                                                                 
*                                                                               
NEWPAGE                                                                         
FILE W91022D2                                                                   
*                                                                               
%WSUPERS 'IN2-'                                                                 
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W91022D3 FB (33 0)                                                         
%W91012  'UT-'                                                                  
*                                                                               
NEWPAGE                                                                         
*                                                                               
%WWPRODSL  'IN1-CLAG-' WORK ''                                                  
*                                                                               
*******************************************                                     
* MATCHAR W01160 OCH W01103                                                     
*******************************************                                     
*                                                                               
JOB INPUT (W91022D1 KEY (IN1-CLAG-IDARTNR) +                                    
           W91022D2 KEY (IN2-IDARTNR))                                          
                                                                                
     IF MATCHED                                                                 
       PERFORM S25-CHECK-IN1-CLAG-KDPRODSL                                      
       IF IN1-CLAG-KDPRODSL = KDPRODSL-VOLVO-ALL                                
         IF IN1-CLAG-KDERS > 10                                                 
           UT-IDARTNR = IN2-IDARTNR                                             
           UT-IDKORTNR = IN2-IDKORTNR                                           
           UT-KDERS = IN1-CLAG-KDERS                                            
           IF IN2-FLTEXT = 'J'                                                  
             UT-BEERS = IN2-BEERS                                               
           ELSE                                                                 
             UT-BEERS = IN2-IDARTNR-TILLK                                       
           END-IF                                                               
           PERFORM S01-SKRIV-UTFIL                                              
         END-IF                                                                 
       END-IF                                                                   
     ELSE                                                                       
       IF W91022D1                                                              
         PERFORM S25-CHECK-IN1-CLAG-KDPRODSL                                    
         IF IN1-CLAG-KDPRODSL = KDPRODSL-VOLVO-ALL                              
           IF IN1-CLAG-KDERS > 10                                               
             UT-IDARTNR = IN1-CLAG-IDARTNR                                      
             UT-IDKORTNR = 1                                                    
             UT-KDERS = IN1-CLAG-KDERS                                          
             UT-BEERS = ' '                                                     
             PERFORM S01-SKRIV-UTFIL                                            
           END-IF                                                               
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
*                                                                               
NEWPAGE                                                                         
*                                                                               
  S01-SKRIV-UTFIL. PROC                                                         
     PUT W91022D3                                                               
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
%WWPRODSL 'IN1-CLAG-' PROC ''                                                   
