NEWPAGE                                                                         
                                                                                
FILE W51398D1 FB(38 27968)                                                      
                                                                                
%W5139700 'IN-'                                                                 
                                                                                
NEWPAGE                                                                         
                                                                                
FILE W51398D2 PRINTER FB  (121 0)                                               
                                                                                
NEWPAGE                                                                         
                                                                                
%WDATKORT                                                                       
                                                                                
W-PGMNAMN   W  6  A  VALUE 'W51398'                                             
W-WDATUM    W  6  A  VALUE 'WDATUM'                                             
                                                                                
W-DATUM                W  6   N                                                 
W-AAR     W-DATUM         2   N                                                 
W-MM      W-DATUM    +2   2   N                                                 
W-DD      W-DATUM    +4   2   N                                                 
                                                                                
W-IDARTNR   W  5  P  HEADING('PARTNO')                                          
W-IDDC      W  2  A  HEADING('DC')                                              
W-KDINVKAT  W  2  P  HEADING('INVCAT')                                          
W-TIM-INV   W  4  P  HEADING('INV.DATE')                                        
W-TEINVANM  W 25  A  HEADING('NOTE')                                            
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
                                                                                
JOB INPUT W51398D1 START INIT-PROC                                              
                                                                                
   W-IDARTNR  = IN-IDARTNR                                                      
   W-IDDC     = IN-IDDC                                                         
   W-KDINVKAT = IN-KDINVKAT                                                     
   W-TIM-INV  = IN-TIM-INV                                                      
   W-TEINVANM = IN-TEINVANM                                                     
                                                                                
   PRINT RAPPORT01                                                              
                                                                                
INIT-PROC. PROC                                                                 
   CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                            
                                                                                
   W-AAR = D-AAR                                                                
   W-MM  = D-MAANAD                                                             
   W-DD  = D-DAG                                                                
END-PROC                                                                        
                                                                                
                                                                                
REPORT RAPPORT01 PRINTER W51398D2 +                                             
      LINESIZE 120 NODATE NOADJUST NOPAGE                                       
                                                                                
    SEQUENCE W-IDARTNR                                                          
                                                                                
TITLE COL  1  'W51398-001'                         +                            
      COL  20 'VCCS'                               +                            
      COL  40 'INVENTORY NOTES          '          +                            
      COL  90 'DC: 11'                             +                            
      COL  100 'DATE:'                             +                            
      COL  106 W-DATUM                                                          
                                                                                
                                                                                
    LINE W-IDARTNR W-IDDC W-KDINVKAT W-TIM-INV W-TEINVANM                       
