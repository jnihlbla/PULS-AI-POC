                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4611900                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR W91042-FIL, W11604 OCH PRISFIL.               *        
*                SKAPAR UTFIL MED POSTER FRÅN W91042.                  *        
*                                                                      *        
*  FÖRFATTARE :  ELAINE CURTSSON                                       *        
*                                                                      *        
*  DATUM      :  APRIL 92                                              *        
*                                                                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
*--------------------------------------*                                        
*   BUYBACK CODE FILE                  *                                        
* -------------------------------------*                                        
                                                                                
FILE W46119D1                                                                   
*                                                                               
%W11604   'BBC-'                                                                
*                                                                               
*--------------------------------------*                                        
*  W91042 EXTRAKT FRÅN WDK6 OCH WDK7   *                                        
* -------------------------------------*                                        
FILE W46119D2                                                                   
*                                                                               
%W91042   'LB-'                                                                 
*                                                                               
*--------------------------------------*                                        
*  HSSRFIL FRÅN WGC1 (HÄMTAR PRIS-UPPG)*                                        
* -------------------------------------*                                        
FILE W46119D3                                                                   
*                                                                               
%W33504   'WGC1-'                                                               
*                                                                               
*--------------------------------------*                                        
*  UTFIL                               *                                        
* -------------------------------------*                                        
FILE W46119D4 FB (418 0)                                                        
*                                                                               
%W4611901 'UT-'                                                                 
*                                                                               
*--------------------------------------*                                        
*  ARBETSFÄLT                          *                                        
* -------------------------------------*                                        
*                                                                               
 W-KDBBCL              W  1 N                                                   
 JA                    W  1 A   VALUE 'J'                                       
 NEJ                   W  1 A   VALUE 'N'                                       
 IX1                   W  2 N   VALUE 0                                         
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
JOB INPUT (W46119D2 KEY(LB-IDARTNR) W46119D1 KEY(BBC-IDARTNR)  +                
           W46119D3 KEY(WGC1-IDARTNR))                                          
                                                                                
    IF MATCHED                                                                  
      PERFORM S01-SAETT-KDBBCL                                                  
      PERFORM B-FLYTTA-WGC1                                                     
      PERFORM S02-SKRIV-POST                                                    
    ELSE                                                                        
      IF MATCHED W46119D2 W46119D1                                              
        PERFORM S01-SAETT-KDBBCL                                                
        PERFORM C-NOLLA-WGC1                                                    
        PERFORM S02-SKRIV-POST                                                  
      ELSE                                                                      
        IF MATCHED W46119D2 W46119D3                                            
          W-KDBBCL = 0                                                          
          PERFORM B-FLYTTA-WGC1                                                 
          PERFORM S02-SKRIV-POST                                                
        ELSE                                                                    
          IF W46119D2                                                           
            W-KDBBCL = 0                                                        
            PERFORM C-NOLLA-WGC1                                                
            PERFORM S02-SKRIV-POST                                              
          END-IF                                                                
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
                                                                                
 B-FLYTTA-WGC1.  PROC                                                           
                                                                                
  UT-KDARTRAB-A      = WGC1-KDARTRAB-A                                          
  UT-KDARTRAB-B      = WGC1-KDARTRAB-B                                          
  UT-KDARTRAB-C      = WGC1-KDARTRAB-C                                          
  UT-KDARTRAB-D      = WGC1-KDARTRAB-D                                          
  UT-KDARTRAB-E      = WGC1-KDARTRAB-E                                          
  UT-KDARTRAB-F      = WGC1-KDARTRAB-F                                          
  UT-KDARTRAB-G      = WGC1-KDARTRAB-G                                          
  UT-PRARTBTO-MARK-A = WGC1-PRARTBTO-MARK-A                                     
  UT-PRARTBTO-MARK-B = WGC1-PRARTBTO-MARK-B                                     
  UT-PRARTBTO-MARK-C = WGC1-PRARTBTO-MARK-C                                     
  UT-PRARTBTO-MARK-D = WGC1-PRARTBTO-MARK-D                                     
  UT-PRARTBTO-MARK-E = WGC1-PRARTBTO-MARK-E                                     
  UT-PRARTBTO-MARK-F = WGC1-PRARTBTO-MARK-F                                     
  UT-PRARTBTO-MARK-G = WGC1-PRARTBTO-MARK-G                                     
                                                                                
 END-PROC                                                                       
                                                                                
 C-NOLLA-WGC1. PROC                                                             
                                                                                
  UT-KDARTRAB-A      = 0                                                        
  UT-KDARTRAB-B      = 0                                                        
  UT-KDARTRAB-C      = 0                                                        
  UT-KDARTRAB-D      = 0                                                        
  UT-KDARTRAB-E      = 0                                                        
  UT-KDARTRAB-F      = 0                                                        
  UT-KDARTRAB-G      = 0                                                        
  UT-PRARTBTO-MARK-A = 0                                                        
  UT-PRARTBTO-MARK-B = 0                                                        
  UT-PRARTBTO-MARK-C = 0                                                        
  UT-PRARTBTO-MARK-D = 0                                                        
  UT-PRARTBTO-MARK-E = 0                                                        
  UT-PRARTBTO-MARK-F = 0                                                        
  UT-PRARTBTO-MARK-G = 0                                                        
                                                                                
 END-PROC                                                                       
                                                                                
 S01-SAETT-KDBBCL.  PROC                                                        
                                                                                
    W-KDBBCL = BBC-KDBBCL                                                       
                                                                                
 END-PROC                                                                       
                                                                                
 S02-SKRIV-POST.  PROC                                                          
                                                                                
    PERFORM S03-RED-SKRIV-UTPOST                                                
    PUT W46119D4                                                                
                                                                                
 END-PROC                                                                       
                                                                                
 S03-RED-SKRIV-UTPOST.  PROC                                                    
                                                                                
    UT-IDARTNR      = LB-IDARTNR                                                
    UT-REKSIFFR     = LB-REKSIFFR                                               
    UT-KDSORT       = LB-KDSORT                                                 
    UT-VKART        = LB-VKART                                                  
    UT-VLARTNTO     = LB-VLARTNTO                                               
    UT-KDVSOP       = LB-KDVSOP                                                 
    UT-KDBPSR       = LB-KDBPSR                                                 
    UT-PRARTBTO-EXP = LB-PRARTBTO-EXP                                           
    UT-TIERSDAT     = LB-TIERSDAT                                               
    UT-TIFINLV      = LB-TIFINLV                                                
    UT-IDLEVNR      = LB-IDLEVNR                                                
    UT-IDLKTO       = LB-IDLKTO                                                 
    UT-FLLSRDEL     = LB-FLLSRDEL                                               
    UT-KDUART       = LB-KDUART                                                 
    UT-KDLTK        = LB-KDLTK                                                  
    UT-IDFKNGRP     = LB-IDFKNGRP                                               
    UT-KDPRODSL     = LB-KDPRODSL                                               
    UT-KVQPACK-1    = LB-KVQPACK-1                                              
    UT-KDAGE        = LB-KDAGE                                                  
    UT-KDARTURS     = LB-KDARTURS                                               
    UT-KDSRA        = LB-KDSRA                                                  
    UT-KDERS        = LB-KDERS                                                  
    IX1 = 1                                                                     
    DO WHILE IX1 < 7                                                            
       UT-IDSTATNR   (IX1) = LB-IDSTATNR (IX1)                                  
       IX1 = IX1 + 1                                                            
    END-DO                                                                      
    IX1 = 1                                                                     
    DO WHILE IX1 < 11                                                           
       UT-IDSKYLT   (IX1) = LB-IDSKYLT   (IX1)                                  
       UT-BEART     (IX1) = LB-BEART     (IX1)                                  
       IX1 = IX1 + 1                                                            
    END-DO                                                                      
    UT-KDBBCL       = W-KDBBCL                                                  
                                                                                
 END-PROC                                                                       
