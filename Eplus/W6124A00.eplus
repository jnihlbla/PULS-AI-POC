                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W612D6                                                *        
*                                                                      *        
*  FUNKTION   :  KOMPLETTERAR FILEN W61247 KOMPLETT UPPFÖLJNINGSFIL    *        
*                FÖR REFILLAVVIKELSER *                                         
* *                                                                             
*                                                                      *        
*  FÖRFATTARE :  G KJELLSON                                            *        
*                                                                      *        
*  INFILER    :  W612.W612D6.W61247 (REFILLAVVIKELSER)                 *        
*             :  W413.W41301        (KDPRCGRP)                         *        
*             :  W413.W41302        (IDPRC)                            *        
*                                                                      *        
*  UTFILER    :  W612.W612D6.W61246                                    *        
*                                                                      *        
*  ÄNDRING             DATUM    AVD                                    *        
*                                                                      *        
*                                                                      *        
*  --------------      ------   ------                                 *        
*  --------------      ------   ------                                 *        
*                                                                      *        
************************************************************************        
FILE W6124AD1.               * INFIL REFILLAVVIKELSER                           
%W6124A 'IN-'                                                                   
*                                                                               
FILE W6124AD2.               * INFIL IDPRC                                      
%WDQ301                                                                         
*                                                                               
FILE W6124AD3.               * INFIL KDPRCGRP                                   
%W41301   'GRP-'                                                                
*                                                                               
FILE W6124AD4 FB(119 28798). * UTFIL                                            
%W6124A   'UT-'                                                                 
*                                                                               
*                                                                               
FILE W6124ADA FB(119 28798).                                                    
%W6124A   'T1-'                                                                 
*                                                                               
FILE W6124ADB FB(119 28798).                                                    
%W6124A   'T2-'                                                                 
*                                                                               
FILE W6124ADC FB(119 28798).                                                    
%W6124A   'T3-'                                                                 
*                                                                               
*                                                                               
***                                                                             
SORT W6124AD1 TO W6124ADA USING (IN-IDORDER IN-IDDC-SEND +                      
                                 IN-IDPRODNR IN-IDPLKLST)                       
***                                                                             
*                                                                               
JOB INPUT (W6124AD2 KEY (ODEL-IDORDER ODEL-IDDC ODEL-IDPRODNR   +               
                         ODEL-IDPLKLST)                         +               
           W6124ADA KEY (T1-IDORDER T1-IDDC-SEND T1-IDPRODNR    +               
                         T1-IDPLKLST))                                          
                                                                                
  IF MATCHED                                                                    
                                                                                
    T1-IDPRC       = ODEL-IDPRC                                                 
    PUT W6124ADB FROM W6124ADA                                                  
                                                                                
  ELSE                                                                          
    IF W6124ADA                                                                 
      PUT W6124ADB FROM W6124ADA                                                
    END-IF                                                                      
  END-IF                                                                        
***                                                                             
SORT W6124ADB TO W6124ADC USING (T2-IDDC-SEND T2-IDPRC)                         
***                                                                             
*                                                                               
*                                                                               
JOB INPUT (W6124AD3 KEY (GRP-IDDC GRP-IDPRC) +                                  
           W6124ADC KEY (T3-IDDC-SEND T3-IDPRC))                                
                                                                                
  IF MATCHED                                                                    
                                                                                
    T3-KDPRCGRP    = GRP-KDPRCGRP                                               
*   FIX FÖR BUMPERS-RETURER                                                     
    IF T3-IDDC-SEND = '11' AND +                                                
       T3-ADLAGOMR  = 88   AND +                                                
       T3-IDDISTR   = 8032                                                      
       T3-IDDISTR   = 8037                                                      
    END-IF                                                                      
    PUT W6124AD4 FROM W6124ADC                                                  
                                                                                
  ELSE                                                                          
    IF W6124ADC                                                                 
*      FIX FÖR BUMPERS-RETURER                                                  
       IF T3-IDDC-SEND = '11' AND +                                             
          T3-ADLAGOMR  = 88   AND +                                             
          T3-IDDISTR   = 8032                                                   
          T3-IDDISTR   = 8037                                                   
       END-IF                                                                   
       PUT W6124AD4 FROM W6124ADC                                               
    END-IF                                                                      
  END-IF                                                                        
***                                                                             
