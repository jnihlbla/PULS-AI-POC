                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
* PROGRAM :   W56074                                                   *        
*                                                                      *        
* FÖRFATTARE: KARL JOHAN HANSSON NOV 2002                              *        
*                                                                      *        
* FUNKTION:   SKAPAR ÅRS-INVENTARIEFIL FÖR END-YEAR-REPORT ÅT LAB      *        
*             FILEN SUMMERAS PER ARTIKELNUMMER, EN SNITT-AVERAGE-      *        
*             COST FÖR DC 41, 42 OCH 43 TILLSAMMANS SAMT EN SUMMA-     *        
*             AVERAGE-COST TAS FRAM PER ARTIKELNUMMER                  *        
*                                                                      *        
*   INDATA  : W510.W560V1.W51052 LAB-ÅRSINVENTARIEFIL                  *        
*           : W011.PROD.W01172   LAGERBAND MED FUNKTIONSGRUPP          *        
*                                                                      *        
*   UTDATA. : W560.W560Y4.W56074 LISTTRANSAR FÖR LAB: END YEAR REPORT  *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
* INFIL W01172 ARTIKELREGEXTRAKT WDK6                                           
FILE W56074D1                                                                   
%W011100 'I1-'                                                                  
                                                                                
* ARTIKELEXTRAKT LAB FÖR DC 41 42 43 (OCH 51) FIL W51052                        
FILE W56074D2                                                                   
%W51052  'I2-'                                                                  
                                                                                
* LAB-LAGERBAND FÖR SORTERING (PER IDARTNR)                                     
FILE TPFIL1 FB(28 0)                                                            
%W51052  'T1-'                                                                  
                                                                                
* LAB-LAGERBAND FÖR SORTERING (PER IDARTNR)                                     
FILE TPFIL2 FB(22 0)                                                            
%W56074  'T2-'                                                                  
                                                                                
* ÅRSINVENTARIEFIL LAB                                                          
FILE W56074D3 FB (22 0)                                                         
%W56074 'UT-'                                                                   
                                                                                
*****************************************************************               
*                                                               *               
* STEG 1  SORTERA LAB-LAGERBANDET PÅ IDARTNR                    *               
*                                                               *               
*****************************************************************               
                                                                                
SORT W56074D2 TO TPFIL1 USING (I2-IDARTNR) BEFORE SORT-INIT +                   
                 SIZE 220000                                                    
                                                                                
 SORT-INIT. PROC                                                                
  IF I2-IDDC NE '51'                                                            
    SELECT                                                                      
  END-IF                                                                        
 END-PROC                                                                       
                                                                                
*****************************************************************               
*                                                               *               
* STEG 2  MATCHA DET SORTERADE LAB-LAGERBANDET MED ARTIKEL-     *               
*         EXTRAKTFIL W01172 (FÖR ATT SKAPA ÅRSINVENTARIEFIL)    *               
*                                                               *               
*****************************************************************               
                                                                                
JOB INPUT(W56074D1 KEY (I1-IDARTNR)                            +                
            TPFIL1 KEY (T1-IDARTNR))                                            
                                                                                
IF MATCHED                                                                      
  T2-IDARTNR     = I1-IDARTNR                                                   
  T2-IDFKNGRP    = I1-IDFKNGRP                                                  
  T2-TOT-STOCK   = T1-KVLS + T1-KVEFRS                                          
  T2-PRARTAVG    = T1-PRAVCOST                                                  
  T2-SUARTAVG    = T2-TOT-STOCK * T1-PRAVCOST                                   
  PUT TPFIL2                                                                    
END-IF                                                                          
                                                                                
*****************************************************************               
*                                                               *               
* STEG 3  SORTERA ÅRS-INVENTARIEFIL PÅ IDARTNR                  *               
*                                                               *               
*****************************************************************               
                                                                                
SORT TPFIL2 TO TPFIL2 USING (T2-IDARTNR) SIZE 220000                            
                                                                                
*****************************************************************               
*                                                               *               
* STEG 4  SUMMERA DENNA OCH SKAPA SLUTLIG ÅRS-INVENTARIEFIL     *               
*                                                               *               
*****************************************************************               
                                                                                
JOB INPUT TPFIL2 START A-INIT FINISH Z-FINIT                                    
                                                                                
 IF UT-IDARTNR EQ T2-IDARTNR                                                    
   UT-TOT-STOCK = UT-TOT-STOCK + T2-TOT-STOCK                                   
   UT-SUARTAVG  = UT-SUARTAVG  + T2-SUARTAVG                                    
 ELSE                                                                           
   IF UT-TOT-STOCK NE 0                                                         
     UT-PRARTAVG ROUNDED = UT-SUARTAVG / UT-TOT-STOCK                           
     PUT W56074D3                                                               
   END-IF                                                                       
   UT-IDARTNR        = T2-IDARTNR                                               
   UT-IDFKNGRP       = T2-IDFKNGRP                                              
   UT-TOT-STOCK      = T2-TOT-STOCK                                             
   UT-SUARTAVG       = T2-SUARTAVG                                              
 END-IF                                                                         
                                                                                
A-INIT. PROC                                                                    
 UT-IDARTNR         = 0                                                         
 UT-TOT-STOCK       = 0                                                         
END-PROC                                                                        
                                                                                
Z-FINIT. PROC                                                                   
 IF UT-TOT-STOCK NE 0                                                           
   UT-PRARTAVG ROUNDED = UT-SUARTAVG / UT-TOT-STOCK                             
   PUT W56074D3                                                                 
 END-IF                                                                         
END-PROC                                                                        
