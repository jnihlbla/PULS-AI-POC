                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W9105900                                              *        
*                                                                      *        
*  FUNKTION   :  PROGRAMMET LÄSER FIL W91051(+0) OCH                   *        
*                MATCHAR MOT W91051(-1) OCH SKRIVER                    *        
*                FIL MED FÖRÄNDRINGAR.                                 *        
*                                                                      *        
*  FÖRFATTARE :  BERT ANDERSSON                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
*--------------------------------------*                                        
*        FILE SECTION                  *                                        
* -------------------------------------*                                        
*                                                                               
FILE W91059D1                                                                   
%W91058  'NEW-'                                                                 
*                                                                               
FILE W91059D2                                                                   
%W91058  'OLD-'                                                                 
*                                                                               
*--------------------------------------*                                        
*  UTFIL                               *                                        
* -------------------------------------*                                        
FILE W91059D3 FB (108 0)                                                        
%W91058  'UT-'                                                                  
*                                                                               
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
  JA                        W   1 A   VALUE 'J'                                 
  NEJ                       W   1 A   VALUE 'N'                                 
  WS-IDDC                   W   2 A                                             
*                                                                               
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
*******************************************                                     
* MATCHAR W91051(+0) OCH W91051(-1)                                             
*******************************************                                     
*                                                                               
JOB INPUT (W91059D1 KEY(NEW-IDARTNR, NEW-IDSKYLT) +                             
           W91059D2 KEY(OLD-IDARTNR, OLD-IDSKYLT))                              
                                                                                
     IF MATCHED                                                                 
     ELSE                                                                       
                                                                                
       IF W91059D1                                                              
         IF NEW-IDARTNR NUMERIC                                                 
           IF NEW-IDARTNR > 000000000                                           
                                                                                
             UT-IDARTNR = NEW-IDARTNR                                           
             UT-IDSKYLT = NEW-IDSKYLT                                           
             UT-BEART   = NEW-BEART                                             
             PERFORM S01-SKRIV-UTFIL                                            
           END-IF                                                               
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
*                                                                               
NEWPAGE                                                                         
*                                                                               
  S01-SKRIV-UTFIL. PROC                                                         
                                                                                
     PUT W91059D3                                                               
  END-PROC                                                                      
                                                                                
