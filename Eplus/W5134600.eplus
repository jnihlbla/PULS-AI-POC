BEFORE-LINE. PROC                                                               
 IF FIRST-TIME-SW = 'J'                                                         
   DISPLAY 'DISTRUBUTION_CENTER;PART_NUMBER;PART_DESCRIPTION;' +                
      'ADVICED_NOT_BINNED_QUANTITY;NOT_INVOICED_QUANTITY;' +                    
