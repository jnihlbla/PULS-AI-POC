*--------------------------------------*                                        
*  W91042 EXTRAKT FRÅN WDD1 OCH WDK6   *                                        
* -------------------------------------*                                        
FILE W33536D1                                                                   
*                                                                               
%W91042   'LB-'                                                                 
*                                                                               
*--------------------------------------*                                        
*  UTFIL                               *                                        
* -------------------------------------*                                        
FILE W33536D4 FB (306 0)                                                        
*                                                                               
%W33537   'UT-'                                                                 
*                                                                               
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  ARBETSFÄLT                          *                                        
* -------------------------------------*                                        
*                                                                               
 IX1                   W  2 N   VALUE 0                                         
 IX2                   W  1 N   VALUE 0                                         
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*------------------------------------------------------------------*            
* STEG 5. MATCHAR W91042, TEMPFIL1 OCH TEMPFIL2                    *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT (W33536D1 KEY(LB-IDARTNR))                                            
                                                                                
    PERFORM S03-RED-SKRIV-UTPOST                                                
    PUT W33536D4                                                                
                                                                                
NEWPAGE                                                                         
 S03-RED-SKRIV-UTPOST.  PROC                                                    
                                                                                
    UT-IDARTNR      = LB-IDARTNR                                                
    UT-KDSORT       = LB-KDSORT                                                 
    UT-VKART        = LB-VKART                                                  
    UT-VLARTNTO     = LB-VLARTNTO                                               
    UT-KDVSOP       = LB-KDVSOP                                                 
    UT-KDBPSR       = LB-KDBPSR                                                 
    UT-TIERSDAT     = LB-TIERSDAT                                               
    UT-TIFINLV      = LB-TIFINLV                                                
                                                                                
    UT-IDLEVNR      = LB-IDLEVNR                                                
    UT-FLLSRDEL     = LB-FLLSRDEL                                               
    UT-KDUART       = LB-KDUART                                                 
    UT-IDFKNGRP     = LB-IDFKNGRP                                               
    UT-KDPRODSL     = LB-KDPRODSL                                               
    UT-KDPSLLOC     = LB-KDPSLLOC                                               
    UT-KVQPACK-1    = LB-KVQPACK-1                                              
                                                                                
*---- NYAFÄLT                                                                   
    UT-KDSRA        = LB-KDSRA                                                  
    UT-KDARTURS     = LB-KDARTURS                                               
    UT-PRARTSJK     = LB-PRARTSJK                                               
    UT-PRARTSTD     = LB-PRARTSTD                                               
    UT-FLIART       = LB-FLIART                                                 
    UT-IDPROJ       = LB-IDPROJ                                                 
                                                                                
    UT-IDANSK       = LB-IDANSK                                                 
    UT-KVPB         = LB-KVPB-SEP(1) + LB-KVPB-SEP(2)                           
    UT-KDVVKL       = LB-KDVVKL                                                 
    UT-KDTIPPR      = LB-KDTIPPR                                                
    UT-IDINK        = LB-IDINK                                                  
    UT-KDLTK        = LB-KDLTK                                                  
    UT-TIREGDAT     = LB-TIREGDAT                                               
                                                                                
    UT-IDARTNR-MOTSV  = LB-IDARTNR-MOTSV                                        
    UT-PRINK          = LB-PRINK                                                
    UT-IDRITN         = LB-IDRITN                                               
    UT-KDAGE          = LB-KDAGE                                                
    UT-PRHANTK   =   LB-PRDIRLON  + LB-PRDMTRL  +  LB-PROVRPAL                  
                                                                                
    IX1 = 1                                                                     
    DO WHILE IX1 < 3                                                            
       UT-IDAO   (IX1) = LB-IDAO (IX1)                                          
       IX1 = IX1 + 1                                                            
    END-DO                                                                      
*---- NYAFÄLT                                                                   
                                                                                
    IX1 = 1                                                                     
    DO WHILE IX1 < 7                                                            
       UT-IDSTATNR   (IX1) = LB-IDSTATNR   (IX1)                                
       IX1 = IX1 + 1                                                            
    END-DO                                                                      
    UT-KDERS      = LB-KDERS                                                    
    IX1 = 1                                                                     
    UT-IDSKYLT   (1) = LB-IDSKYLT   (4)                                         
    UT-BEART     (1) = LB-BEART     (4)                                         
                                                                                
    UT-IDSKYLT   (2) = LB-IDSKYLT   (8)                                         
    UT-BEART     (2) = LB-BEART     (8)                                         
    UT-TEORSAK       = LB-TEORSAK                                               
    UT-TEARTNOT      = LB-TEARTNOT                                              
*- BBCL ANVÄNDS EJ I AMC----                                                    
    UT-KDBBCL       = 0                                                         
*- BBCL ANVÄNDS EJ I AMC----                                                    
                                                                                
 END-PROC                                                                       
