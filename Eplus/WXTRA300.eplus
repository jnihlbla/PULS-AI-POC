*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE WXTRA3D1                                                                   
* DAGLIG EFR                                                                    
%W47993        'IN-'                                                            
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE WXTRA3D2 FB (143 0)                                                        
* DAGLIG EFR UT                                                                 
%WXTRA3        'UT-'                                                            
*                                                                               
NEWPAGE                                                                         
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
  JA                        W    1     A     VALUE 'J'                          
  NEJ                       W    1     A     VALUE 'N'                          
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT NULL                                                 +              
                                                 NAME   STEG01                  
    GET WXTRA3D1                                                                
                                                                                
    DO WHILE NOT EOF WXTRA3D1                                                   
                                                                                
      PERFORM A-FYLL-WXTRA3-POST                                                
                                                                                
      PUT WXTRA3D2                                                              
      GET WXTRA3D1                                                              
                                                                                
    END-DO                                                                      
                                                                                
  STOP                                                                          
*                                                                               
NEWPAGE                                                                         
