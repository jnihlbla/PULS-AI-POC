  ACK-OKS-B-Q4-C1           W    5     P 0   VALUE 0                            
  ACK-OKS-D-Q4-C1           W    5     P 0   VALUE 0                            
  ACK-OKS-V-Q4-C1           W    5     P 0   VALUE 0                            
  ACK-PREAVB-B-Q4-C1        W    5     P 0   VALUE 0                            
  ACK-PREAVB-D-Q4-C1        W    5     P 0   VALUE 0                            
  ACK-PREAVB-V-Q4-C1        W    5     P 0   VALUE 0                            
  ACK-PRERO-B-Q4-C1         W    5     P 0   VALUE 0                            
  ACK-PRERO-D-Q4-C1         W    5     P 0   VALUE 0                            
*                                                                               
  ACK-OKS-B-Q1-C1           W    5     P 0   VALUE 0                            
  ACK-OKS-D-Q1-C1           W    5     P 0   VALUE 0                            
  ACK-OKS-V-Q1-C1           W    5     P 0   VALUE 0                            
  ACK-PREAVB-B-Q1-C1        W    5     P 0   VALUE 0                            
  ACK-PREAVB-D-Q1-C1        W    5     P 0   VALUE 0                            
  ACK-PREAVB-V-Q1-C1        W    5     P 0   VALUE 0                            
  ACK-PRERO-B-Q1-C1         W    5     P 0   VALUE 0                            
  ACK-PRERO-D-Q1-C1         W    5     P 0   VALUE 0                            
*                                                                               
  ACK-OKS-R4-C1             W    5     P 0   VALUE 0                            
*                                                                               
  ACK-OKS-B-A5-C1           W    5     P 0   VALUE 0                            
  ACK-OKS-D-A5-C1           W    5     P 0   VALUE 0                            
*                                                                               
  ACK-PRERO-B-E4-C1         W    5     P 0   VALUE 0                            
  ACK-PRERO-D-E4-C1         W    5     P 0   VALUE 0                            
*                                                                               
  SUM-OKS-B-C1              W    3     P 0   VALUE 0                            
  SUM-OKS-D-C1              W    3     P 0   VALUE 0                            
  SUM-OKS-V-C1              W    3     P 0   VALUE 0                            
  SUM-PREAVB-B-C1           W    3     P 0   VALUE 0                            
  SUM-PREAVB-D-C1           W    3     P 0   VALUE 0                            
  SUM-PREAVB-V-C1           W    3     P 0   VALUE 0                            
  SUM-PRERO-B-C1            W    3     P 0   VALUE 0                            
  SUM-PRERO-D-C1            W    3     P 0   VALUE 0                            
*                                                                               
  PRINT-OKS-B               W    3     P 0   VALUE 0  MASK '----9'              
  PRINT-OKS-D               W    3     P 0   VALUE 0  MASK '----9'              
  PRINT-OKS-V               W    3     P 0   VALUE 0  MASK '----9'              
  PRINT-PREAVB-B            W    3     P 0   VALUE 0  MASK '----9'              
  PRINT-PREAVB-D            W    3     P 0   VALUE 0  MASK '----9'              
  PRINT-PREAVB-V            W    3     P 0   VALUE 0  MASK '----9'              
