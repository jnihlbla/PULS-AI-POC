*----------------------------------------------------------------------*        
*                                                                               
*                                                                               
  JA                        W    1     A     VALUE 'J'                          
  NEJ                       W    1     A     VALUE 'N'                          
*                                                                               
  SW-SALDO-DIFF-OKS-C1      W    1     A     VALUE 'N'                          
  SW-SALDO-DIFF-PREAVB-C1   W    1     A     VALUE 'N'                          
  SW-SALDO-DIFF-PRERO-C1    W    1     A     VALUE 'N'                          
*                                                                               
  ACK-OKS-B-K9              W    5     P 0   VALUE 0                            
  ACK-OKS-D-K9              W    5     P 0   VALUE 0                            
  ACK-OKS-V-K9              W    5     P 0   VALUE 0                            
  ACK-PREAVB-B-K9           W    5     P 0   VALUE 0                            
  ACK-PREAVB-D-K9           W    5     P 0   VALUE 0                            
  ACK-PREAVB-V-K9           W    5     P 0   VALUE 0                            
  ACK-PRERO-B-K9            W    5     P 0   VALUE 0                            
  ACK-PRERO-D-K9            W    5     P 0   VALUE 0                            
