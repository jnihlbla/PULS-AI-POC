*----------------------------------------------------------------------*        
*                            PROCEDURE DIVISION                        *        
*----------------------------------------------------------------------*        
*                                                                               
JOB INPUT NULL                                                   +              
                                              NAME   STEG01                     
                                                                                
  GET W44063D1                                                                  
  GET W44064D2                                                                  
  GET W44065D3                                                                  
  GET W44066D4                                                                  
  GET W44068D5                                                                  
  GET W44068D6                                                                  
                                                                                
  DO WHILE NOT EOF W44066D4                                                     
                                                                                
    PERFORM SUMMERA-WDK9-SALDO                                                  
                                                                                
    DO WHILE NOT EOF W44063D1 AND                                +              
      WDQ4-IDDC NE CDC-SE                                                       
      GET W44063D1                                                              
    END-DO                                                                      
                                                                                
    DO WHILE NOT EOF W44064D2 AND                                +              
      WDR4-IDDC NE CDC-SE                                                       
      GET W44064D2                                                              
    END-DO                                                                      
                                                                                
    DO WHILE NOT EOF W44065D3 AND                                +              
      WDA5-IDDC NE CDC-SE                                                       
      GET W44065D3                                                              
    END-DO                                                                      
                                                                                
    DO WHILE NOT EOF W44068D5 AND                                +              
      WDQ1-IDDC NE CDC-SE                                                       
      GET W44068D5                                                              
    END-DO                                                                      
                                                                                
    DO WHILE NOT EOF W44068D6 AND                                +              
      WDE4-IDDC NE CDC-SE                                                       
      GET W44068D6                                                              
    END-DO                                                                      
                                                                                
    DO WHILE NOT EOF W44063D1 AND                                +              
      WDQ4-IDARTNR LE WDK9-IDARTNR                                              
      IF WDQ4-IDARTNR = WDK9-IDARTNR                                            
        PERFORM SUMMERA-WDQ4-SALDO                                              
      END-IF                                                                    
      GET W44063D1                                                              
    END-DO                                                                      
                                                                                
    DO WHILE NOT EOF W44064D2 AND                                +              
      WDR4-IDARTNR LE WDK9-IDARTNR                                              
      IF WDR4-IDARTNR = WDK9-IDARTNR                                            
        PERFORM SUMMERA-WDR4-SALDO                                              
      END-IF                                                                    
      GET W44064D2                                                              
    END-DO                                                                      
                                                                                
    DO WHILE NOT EOF W44065D3 AND                                +              
      WDA5-IDARTNR LE WDK9-IDARTNR                                              
      IF WDA5-IDARTNR = WDK9-IDARTNR                                            
        PERFORM SUMMERA-WDA5-SALDO                                              
      END-IF                                                                    
      GET W44065D3                                                              
    END-DO                                                                      
                                                                                
    DO WHILE NOT EOF W44068D5 AND                                +              
      WDQ1-IDARTNR LE WDK9-IDARTNR                                              
      IF WDQ1-IDARTNR = WDK9-IDARTNR                                            
        PERFORM SUMMERA-WDQ1-SALDO                                              
      END-IF                                                                    
      GET W44068D5                                                              
    END-DO                                                                      
                                                                                
    DO WHILE NOT EOF W44068D6 AND                                +              
      WDE4-IDARTNR LE WDK9-IDARTNR                                              
      IF WDE4-IDARTNR = WDK9-IDARTNR                                            
        PERFORM SUMMERA-WDE4-SALDO                                              
      END-IF                                                                    
      GET W44068D6                                                              
    END-DO                                                                      
                                                                                
    PERFORM BERAKNA-SALDO-DIFFAR                                                
    PERFORM KONTROLLERA-OM-SALDO-DIFFAR                                         
    PERFORM PRINTA-RAPPORTER-SKRIV-FIL                                          
    PERFORM NOLLSTALL-ACKAR                                                     
                                                                                
    GET W44066D4                                                                
                                                                                
  END-DO                                                                        
                                                                                
  STOP                                                                          
*                                                                               
NEWPAGE                                                                         
*                                                                               
SUMMERA-WDK9-SALDO.  PROC                                                       
                                                                                
  ACK-OKS-V-K9    = ACK-OKS-V-K9    + WDK9-KVOKS-VOR                            
  ACK-PREAVB-V-K9 = ACK-PREAVB-V-K9 + WDK9-KVPREAVB-VOR                         
                                                                                
  ACK-OKS-D-K9    = ACK-OKS-D-K9    + WDK9-KVOKS-DAG                            
  ACK-PREAVB-D-K9 = ACK-PREAVB-D-K9 + WDK9-KVPREAVB-DAG                         
  ACK-PRERO-D-K9  = ACK-PRERO-D-K9  + WDK9-KVPRERO-DAG                          
                                                                                
  ACK-OKS-B-K9    = ACK-OKS-B-K9    + WDK9-KVOKS-BULK                           
  ACK-PREAVB-B-K9 = ACK-PREAVB-B-K9 + WDK9-KVPREAVB-BULK                        
  ACK-PRERO-B-K9  = ACK-PRERO-B-K9  + WDK9-KVPRERO-BULK                         
                                                                                
END-PROC                                                                        
NEWPAGE                                                                         
*                                                                               
SUMMERA-WDQ4-SALDO.  PROC                                                       
                                                                                
  IF WDQ4-IDDC = CDC-SE                                                         
    IF WDQ4-KDORDKL = 0                                                         
      ACK-OKS-V-Q4-C1    = ACK-OKS-V-Q4-C1    + WDQ4-KVBEART                    
      ACK-PREAVB-V-Q4-C1 = ACK-PREAVB-V-Q4-C1 + WDQ4-KVPREAVB                   
    ELSE                                                                        
      IF WDQ4-KDORDKL = 1                                                       
        ACK-OKS-D-Q4-C1    = ACK-OKS-D-Q4-C1    + WDQ4-KVBEART                  
        ACK-PREAVB-D-Q4-C1 = ACK-PREAVB-D-Q4-C1 + WDQ4-KVPREAVB                 
        ACK-PRERO-D-Q4-C1  = ACK-PRERO-D-Q4-C1  + WDQ4-KVPRERO                  
      ELSE                                                                      
        ACK-OKS-B-Q4-C1    = ACK-OKS-B-Q4-C1    + WDQ4-KVBEART                  
        ACK-PREAVB-B-Q4-C1 = ACK-PREAVB-B-Q4-C1 + WDQ4-KVPREAVB                 
        ACK-PRERO-B-Q4-C1  = ACK-PRERO-B-Q4-C1  + WDQ4-KVPRERO                  
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
SUMMERA-WDR4-SALDO.  PROC                                                       
                                                                                
  IF WDR4-IDDC = CDC-SE                                                         
     ACK-OKS-R4-C1 = ACK-OKS-R4-C1 + WDR4-KVPRERO                               
  END-IF                                                                        
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
SUMMERA-WDA5-SALDO.  PROC                                                       
                                                                                
  IF WDA5-IDDC = CDC-SE                                                         
     IF WDA5-KDORDKL = 1                                                        
        ACK-OKS-D-A5-C1 = ACK-OKS-D-A5-C1 + WDA5-KVART                          
     ELSE                                                                       
        ACK-OKS-B-A5-C1 = ACK-OKS-B-A5-C1 + WDA5-KVART                          
     END-IF                                                                     
  END-IF                                                                        
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
SUMMERA-WDQ1-SALDO.  PROC                                                       
                                                                                
  IF WDQ1-IDDC = CDC-SE                                                         
    IF WDQ1-KDORDKL = 0                                                         
      ACK-OKS-V-Q1-C1    = ACK-OKS-V-Q1-C1    + WDQ1-KVBEART-Q                  
      ACK-PREAVB-V-Q1-C1 = ACK-PREAVB-V-Q1-C1 + WDQ1-KVPREAVB                   
    ELSE                                                                        
      IF WDQ1-KDORDKL = 1                                                       
        ACK-OKS-D-Q1-C1    = ACK-OKS-D-Q1-C1    + WDQ1-KVBEART-Q                
        ACK-PREAVB-D-Q1-C1 = ACK-PREAVB-D-Q1-C1 + WDQ1-KVPREAVB                 
        ACK-PRERO-D-Q1-C1  = ACK-PRERO-D-Q1-C1  + WDQ1-KVPRERO                  
      ELSE                                                                      
        ACK-OKS-B-Q1-C1    = ACK-OKS-B-Q1-C1    + WDQ1-KVBEART-Q                
        ACK-PREAVB-B-Q1-C1 = ACK-PREAVB-B-Q1-C1 + WDQ1-KVPREAVB                 
        ACK-PRERO-B-Q1-C1  = ACK-PRERO-B-Q1-C1  + WDQ1-KVPRERO                  
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
SUMMERA-WDE4-SALDO.  PROC                                                       
                                                                                
  IF WDE4-IDDC = CDC-SE                                                         
    IF WDE4-KDORDKL = 1                                                         
      ACK-PRERO-D-E4-C1 = ACK-PRERO-D-E4-C1 + WDE4-KVPRERO                      
    ELSE                                                                        
      IF WDE4-KDORDKL = 2, 3, 4                                                 
        ACK-PRERO-B-E4-C1 = ACK-PRERO-B-E4-C1 + WDE4-KVPRERO                    
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
                                                                                
END-PROC                                                                        
NEWPAGE                                                                         
*                                                                               
BERAKNA-SALDO-DIFFAR.  PROC                                                     
                                                                                
  SUM-OKS-B-C1     =   (ACK-OKS-B-Q4-C1  +                       +              
                        ACK-OKS-B-A5-C1  +                       +              
                        ACK-OKS-B-Q1-C1) -                       +              
                        ACK-OKS-B-K9                                            
                                                                                
  SUM-OKS-D-C1     =   (ACK-OKS-D-Q4-C1  +                       +              
                        ACK-OKS-D-A5-C1  +                       +              
                        ACK-OKS-D-Q1-C1) -                       +              
                        ACK-OKS-D-K9                                            
                                                                                
  SUM-OKS-V-C1     =   (ACK-OKS-V-Q4-C1  +                       +              
                        ACK-OKS-R4-C1    +                       +              
                        ACK-OKS-V-Q1-C1) -                       +              
                        ACK-OKS-V-K9                                            
                                                                                
  SUM-PREAVB-B-C1  =   (ACK-PREAVB-B-Q4-C1  +                    +              
                        ACK-PREAVB-B-Q1-C1) -                    +              
                        ACK-PREAVB-B-K9                                         
                                                                                
  SUM-PREAVB-D-C1  =   (ACK-PREAVB-D-Q4-C1  +                    +              
                        ACK-PREAVB-D-Q1-C1) -                    +              
                        ACK-PREAVB-D-K9                                         
                                                                                
  SUM-PREAVB-V-C1  =   (ACK-PREAVB-V-Q4-C1  +                    +              
                        ACK-PREAVB-V-Q1-C1) -                    +              
                        ACK-PREAVB-V-K9                                         
                                                                                
  SUM-PRERO-B-C1   =   (ACK-PRERO-B-Q4-C1  +                     +              
                        ACK-PRERO-B-Q1-C1  +                     +              
                        ACK-PRERO-B-E4-C1) -                     +              
                        ACK-PRERO-B-K9                                          
                                                                                
  SUM-PRERO-D-C1   =   (ACK-PRERO-D-Q4-C1  +                     +              
                        ACK-PRERO-D-Q1-C1  +                     +              
                        ACK-PRERO-D-E4-C1) -                     +              
                        ACK-PRERO-D-K9                                          
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
KONTROLLERA-OM-SALDO-DIFFAR.  PROC                                              
                                                                                
  IF SUM-OKS-B-C1     NE 0 OR                                    +              
     SUM-OKS-D-C1     NE 0 OR                                    +              
     SUM-OKS-V-C1     NE 0                                                      
    SW-SALDO-DIFF-OKS-C1 = JA                                                   
  END-IF                                                                        
  IF SUM-PREAVB-B-C1  NE 0 OR                                    +              
     SUM-PREAVB-D-C1  NE 0 OR                                    +              
     SUM-PREAVB-V-C1  NE 0                                                      
    SW-SALDO-DIFF-PREAVB-C1 = JA                                                
  END-IF                                                                        
  IF SUM-PRERO-B-C1   NE 0 OR                                    +              
     SUM-PRERO-D-C1   NE 0                                                      
    SW-SALDO-DIFF-PRERO-C1 = JA                                                 
  END-IF                                                                        
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
PRINTA-RAPPORTER-SKRIV-FIL.  PROC                                               
                                                                                
  IF SW-SALDO-DIFF-OKS-C1 = JA                                                  
    PERFORM FYLL-DETALJRAD-MED-OKS-C1-DIFFAR                                    
    PERFORM SKRIV-UTFIL-MED-OKS-C1-DIFFAR                                       
    PRINT RAPPORT01                                                             
    SW-SALDO-DIFF-OKS-C1 = NEJ                                                  
  END-IF                                                                        
  IF SW-SALDO-DIFF-PREAVB-C1 = JA                                               
    PERFORM FYLL-DETALJRAD-MED-PREAVB-C1-DIFFAR                                 
    PERFORM SKRIV-UTFIL-MED-PREAVB-C1-DIFFAR                                    
    PRINT RAPPORT02                                                             
    SW-SALDO-DIFF-PREAVB-C1 = NEJ                                               
  END-IF                                                                        
                                                                                
  IF SW-SALDO-DIFF-PRERO-C1 = JA                                                
    PERFORM FYLL-DETALJRAD-MED-PRERO-C1-DIFFAR                                  
    PERFORM SKRIV-UTFIL-MED-PRERO-C1-DIFFAR                                     
    PRINT RAPPORT03                                                             
    SW-SALDO-DIFF-PRERO-C1 = NEJ                                                
  END-IF                                                                        
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
FYLL-DETALJRAD-MED-OKS-C1-DIFFAR.  PROC                                         
                                                                                
  PRINT-IDARTNR      = WDK9-IDARTNR                                             
  PRINT-OKS-B        = SUM-OKS-B-C1                                             
  PRINT-OKS-D        = SUM-OKS-D-C1                                             
  PRINT-OKS-V        = SUM-OKS-V-C1                                             
  PRINT-OKS-B-K9     = ACK-OKS-B-K9                                             
  PRINT-OKS-D-K9     = ACK-OKS-D-K9                                             
  PRINT-OKS-V-K9     = ACK-OKS-V-K9                                             
                                                                                
END-PROC                                                                        
                                                                                
FYLL-DETALJRAD-MED-PREAVB-C1-DIFFAR.  PROC                                      
                                                                                
  PRINT-IDARTNR      = WDK9-IDARTNR                                             
  PRINT-PREAVB-B     = SUM-PREAVB-B-C1                                          
  PRINT-PREAVB-D     = SUM-PREAVB-D-C1                                          
  PRINT-PREAVB-V     = SUM-PREAVB-V-C1                                          
  PRINT-PREAVB-B-K9  = ACK-PREAVB-B-K9                                          
  PRINT-PREAVB-D-K9  = ACK-PREAVB-D-K9                                          
  PRINT-PREAVB-V-K9  = ACK-PREAVB-V-K9                                          
                                                                                
END-PROC                                                                        
                                                                                
FYLL-DETALJRAD-MED-PRERO-C1-DIFFAR.  PROC                                       
                                                                                
  PRINT-IDARTNR      = WDK9-IDARTNR                                             
  PRINT-PRERO-B      = SUM-PRERO-B-C1                                           
  PRINT-PRERO-D      = SUM-PRERO-D-C1                                           
  PRINT-PRERO-B-K9   = ACK-PRERO-B-K9                                           
  PRINT-PRERO-D-K9   = ACK-PRERO-D-K9                                           
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
NEWPAGE                                                                         
SKRIV-UTFIL-MED-OKS-C1-DIFFAR.  PROC                                            
                                                                                
  UT-IDDB            = '901   '                                                 
  UT-IDDC            = CDC-SE                                                   
  UT-IDARTNR         = WDK9-IDARTNR                                             
  UT-TIBEHOV         = 0                                                        
  IF SUM-OKS-B-C1    NE 0                                                       
      UT-KVANTAL     = SUM-OKS-B-C1                                             
      IF SUM-OKS-B-C1 LE 0                                                      
          UT-KDMETOD = 'SUB'                                                    
       ELSE                                                                     
          UT-KDMETOD = 'ADD'                                                    
      END-IF                                                                    
      UT-IDSALDO     = 'KVOKS-BULK   '                                          
      PUT W44067D0                                                              
  END-IF                                                                        
                                                                                
  IF SUM-OKS-D-C1    NE 0                                                       
      UT-KVANTAL     = SUM-OKS-D-C1                                             
      IF SUM-OKS-D-C1 LE 0                                                      
          UT-KDMETOD = 'SUB'                                                    
       ELSE                                                                     
          UT-KDMETOD = 'ADD'                                                    
      END-IF                                                                    
