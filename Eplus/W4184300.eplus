NEWPAGE                                                                         
FILE W41843D1                                                                   
*                                                                               
%W41843  'IN-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE W41843D2  PRINTER FB (121 0)                                               
                                                                                
NEWPAGE                                                                         
FILE W41843D3  PRINTER FB (121 0)                                               
                                                                                
NEWPAGE                                                                         
FILE W41843D4  PRINTER FB (121 0)                                               
                                                                                
NEWPAGE                                                                         
                                                                                
  W-IDLEVNR       W 5  A                                                        
  W-IDDISTR       W 4  N  MASK '---9'                                           
  W-IDKUNDNR      W 6  N  MASK '-----9'                                         
  W-IDRAPPNR      W 7  N  MASK '------9'                                        
  W-IDARTNR       W 9  N  MASK '--------9'                                      
  W-KVLEVANM      W 6  N  MASK '-----9'                                         
  W-IDORDNR5      W 5  N  MASK '----9'                                          
  W-IDKNOTNR      W 7  N  MASK '------9'                                        
  W-IDKOLLI       W 5  N  MASK '----9'                                          
  W-IDPRODNR      W 4  P 0  MASK 'ZZZZZZ9'                                      
  W-PRARTBTO      W 5  P 2  MASK 'ZZZZZZ9.99'                                   
  W-PRLANDCO      W 5  P 2  MASK 'ZZZZZZ9.99'                                   
  W-PRMOMS        W 5  P 2  MASK 'ZZZZZZ9.99'                                   
                                                                                
                                                                                
                                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. LÄSER INFIL W41843 FRÅN PGM W41830                                    
*                                                                               
JOB INPUT W41843D1                                                              
                                                                                
    W-IDDISTR         = IN-IDDISTR                                              
    W-IDKUNDNR        = IN-IDKUNDNR                                             
    W-IDRAPPNR        = IN-IDRAPPNR                                             
    W-IDARTNR         = IN-IDARTNR                                              
    W-KVLEVANM        = IN-KVLEVANM                                             
    W-IDORDNR5        = IN-IDORDNR5                                             
    W-IDKOLLI         = IN-IDKOLLI                                              
    W-PRARTBTO        = IN-PRARTBTO                                             
    W-IDLEVNR         = IN-IDLEVNR                                              
    W-IDKNOTNR        = IN-IDKNOTNR                                             
    W-PRLANDCO        = IN-PRLANDCO + IN-PREMBHNT                               
    W-PRMOMS          = IN-PRMOMS                                               
    W-IDPRODNR        = IN-IDPRODNR                                             
                                                                                
    IF IN-KDANMORS = '00', '20', '40', '42', '43', '80', '83', '25'             
      PRINT W41843-001                                                          
    ELSE                                                                        
      IF IN-KDANMORS = '11', '21', '26'                                         
        PRINT W41843-002                                                        
      ELSE                                                                      
        PRINT W41843-003                                                        
      END-IF                                                                    
    END-IF                                                                      
                                                                                
                                                                                
NEWPAGE                                                                         
REPORT W41843-001  PRINTER W41843D2 LINESIZE 120 DTLCTL FIRST +                 
       NOADJUST NOHEADING TITLESKIP 1                                           
                                                                                
SEQUENCE W-IDLEVNR IN-KDVALISO                                                  
CONTROL  FINAL NOPRINT      +                                                   
         W-IDLEVNR NOPRINT  +                                                   
         IN-KDVALISO                                                            
SUM      W-PRARTBTO                                                             
                                                                                
TITLE 1  COL 46 'VOLVO CAR PARTS  W41843-001'                                   
TITLE 3  COL 37 'FAKTURERING MOT LEVERANTÖR FÖR DIREKTLEVERANS'                 
                                                                                
TITLE 6  COL  3 'LEVNR'         +                                               
         COL  9 'VALUTA'        +                                               
         COL 18 'RADPRIS'       +                                               
         COL 26 'ARTIKELNR'     +                                               
         COL 37 'ANTAL'         +                                               
         COL 43 'KOD'           +                                               
         COL 47 'DIST'          +                                               
         COL 52 'KUNDNR'        +                                               
         COL 60 'PRODNR'        +                                               
         COL 67 'DC'            +                                               
         COL 70 'ORDER'         +                                               
         COL 76 'KOLLI'         +                                               
         COL 83 'KNOTNR'        +                                               
         COL 91 'LAND.COST'     +                                               
         COL 107 'MOMS'         +                                               
         COL 113 'RAPP-NR'      +                                               
                                                                                
                                                                                
LINE  1  COL  2 W-IDLEVNR    +                                                  
         COL  9 IN-KDVALISO  +                                                  
         COL 12 W-PRARTBTO   +                                                  
         COL 25 W-IDARTNR    +                                                  
