            ELSE                                                                
              IF SPAR-KDSORT = 7                                                
                LST-TITEL-61        = 'RENAULT '                                
              ELSE                                                              
                IF SPAR-KDSORT = 8                                              
                  LST-TITEL-61        = 'WITHOUT PRE-PACK'                      
                ELSE                                                            
                  IF SPAR-KDSORT = 9                                            
                    LST-TITEL-61        = 'PRE-PACKING '                        
                  END-IF                                                        
                END-IF                                                          
              END-IF                                                            
            END-IF                                                              
          END-IF                                                                
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
  LST-AK-ANTAL-61     = W-AK-ANTAL                                              
  LST-AK-VARDE-61     = W-AK-VARDE                                              
  LST-AK-VARDE-RO-61  = W-AK-VARDE-RO                                           
  LST-R32-ANTAL-61    = W-R32-ANTAL                                             
  LST-R32-VARDE-61    = W-R32-VARDE                                             
  PRINT W61174-003                                                              
END-PROC                                                                        
