H-PRINTA-LISTA-DC67. PROC                                                       
  IF SPAR-KDSORT = 1                                                            
    LST-TITEL-67        = 'KIT   '                                              
  ELSE                                                                          
    IF SPAR-KDSORT = 2                                                          
