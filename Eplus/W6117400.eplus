  LST-AK-VARDE-RO-62  = W-AK-VARDE-RO                                           
  LST-R32-ANTAL-62    = W-R32-ANTAL                                             
  LST-R32-VARDE-62    = W-R32-VARDE                                             
  PRINT W61174-004                                                              
END-PROC                                                                        
                                                                                
G-PRINTA-LISTA-DC51. PROC                                                       
  IF SPAR-KDSORT = 1                                                            
    LST-TITEL-51        = 'KIT   '                                              
  ELSE                                                                          
    IF SPAR-KDSORT = 2                                                          
