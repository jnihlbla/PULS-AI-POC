TITLE 01    '************'                                                      
TITLE 02    'CHANGES IN EMB Q0,Q1,Q2,KVANT,P-TYPE,P-CODE SINCE LAST RUN'        
*                                                                               
LINE      W-ADLAGOMR    +                                                       
            PARTNO      +                                                       
            NEW-Q0EMB   +                                                       
            NEW-Q1EMB   +                                                       
            NEW-Q2EMB   +                                                       
            NEW-KVANT   +                                                       
            NEW-PTYPE   +                                                       
            NEW-PCODE   +                                                       
            OLD-Q0EMB   +                                                       
            OLD-Q1EMB   +                                                       
            OLD-Q2EMB   +                                                       
            OLD-KVANT   +                                                       
            OLD-PTYPE   +                                                       
            OLD-PCODE                                                           
*-------------------------------------------------*                             
REPORT      RPT03         +                                                     
            LINESIZE 120  +                                                     
            SPACE 1  PRINTER W61173D6                                           
*                                                                               
SEQUENCE    PARTNO                                                              
*                                                                               
TITLE 01    '************'                                                      
TITLE 02    'CHANGES IN EMB Q0,Q1,Q2,KVANT,P-TYPE,P-CODE SINCE LAST RUN'        
*                                                                               
LINE        PARTNO      +                                                       
            NEW-Q0EMB   +                                                       
            NEW-Q1EMB   +                                                       
            NEW-Q2EMB   +                                                       
            NEW-KVANT   +                                                       
            NEW-PTYPE   +                                                       
            NEW-PCODE   +                                                       
            OLD-Q0EMB   +                                                       
            OLD-Q1EMB   +                                                       
            OLD-Q2EMB   +                                                       
            OLD-KVANT   +                                                       
            OLD-PTYPE   +                                                       
            OLD-PCODE                                                           
*-------------------------------------------------*                             
REPORT      RPT04         +                                                     
            LINESIZE 120  +                                                     
            SPACE 1  PRINTER W61173D7                                           
*                                                                               
SEQUENCE    FBGRP PARTNO                                                        
*                                                                               
CONTROL     FINAL NOPRINT FBGRP NOPRINT NEWPAGE                                 
*                                                                               
TITLE 01    '************'                                                      
TITLE 02    'CHANGES IN EMB Q0,Q1,Q2,KVANT,P-TYPE,P-CODE SINCE LAST RUN'        
*                                                                               
LINE        FBGRP       +                                                       
            PARTNO      +                                                       
            NEW-Q0EMB   +                                                       
            NEW-Q1EMB   +                                                       
            NEW-Q2EMB   +                                                       
            NEW-KVANT   +                                                       
            NEW-PTYPE   +                                                       
            NEW-PCODE   +                                                       
            OLD-Q0EMB   +                                                       
            OLD-Q1EMB   +                                                       
            OLD-Q2EMB   +                                                       
            OLD-KVANT   +                                                       
            OLD-PTYPE   +                                                       
            OLD-PCODE                                                           
                                                                                
