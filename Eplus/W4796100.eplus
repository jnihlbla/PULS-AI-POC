E-FILL06       E-RUBRIK3 +28  1   A  VALUE ';'                                  
E-SUMKOLLI     E-RUBRIK3 +29  6   N                                             
E-FILL07       E-RUBRIK3 +35  1   A  VALUE ';'                                  
E-SUMORDER     E-RUBRIK3 +36  6   N                                             
E-FILL08       E-RUBRIK3 +42  1   A  VALUE ';'                                  
E-SUMVIKT      E-RUBRIK3 +43  8   N                                             
E-FILL09       E-RUBRIK3 +51  1   A  VALUE ','                                  
E-SUMVIKT-DEC  E-RUBRIK3 +52  1   N                                             
E-FILL10       E-RUBRIK3 +53  1   A  VALUE ';'                                  
                                                                                
E-RUBRIK4      W  59  A                                                         
E-FIL1         E-RUBRIK4      6   A  VALUE ' '                                  
E-FIL2         E-RUBRIK4 +7   1   A  VALUE ';'                                  
E-FIL3         E-RUBRIK4 +8   3   A  VALUE ' '                                  
E-FIL4         E-RUBRIK4 +11  1   A  VALUE ';'                                  
E-TOTSTYCK     E-RUBRIK4 +12  8   N                                             
E-FIL5         E-RUBRIK4 +20  1   A  VALUE ';'                                  
E-TOTRAD       E-RUBRIK4 +21  7   N                                             
E-FIL6         E-RUBRIK4 +28  1   A  VALUE ';'                                  
E-TOTKOLLI     E-RUBRIK4 +29  6   N                                             
E-FIL7         E-RUBRIK4 +35  1   A  VALUE ';'                                  
E-TOTORDER     E-RUBRIK4 +36  6   N                                             
E-FIL8         E-RUBRIK4 +42  1   A  VALUE ';'                                  
E-TOTVIKT      E-RUBRIK4 +43  8   N                                             
E-FIL9         E-RUBRIK4 +51  1   A  VALUE ','                                  
E-TOTVIKT-DEC  E-RUBRIK4 +52  1   N                                             
E-FIL10        E-RUBRIK4 +53  1   A  VALUE ';'                                  
                                                                                
E-RUBRIK5     W  59  A                                                          
E-FI01        E-RUBRIK5      7   A  VALUE ' '                                   
E-FI02        E-RUBRIK5 +8   1   A  VALUE ';'                                   
E-FI03        E-RUBRIK5 +9   7   A  VALUE ' '                                   
E-FI04        E-RUBRIK5 +16  1   A  VALUE ';'                                   
E-FI05        E-RUBRIK5 +17  7   A  VALUE ' '                                   
E-FI06        E-RUBRIK5 +23  1   A  VALUE ';'                                   
E-FI07        E-RUBRIK5 +24  7   A  VALUE ' '                                   
E-FI08        E-RUBRIK5 +31  1   A  VALUE ';'                                   
E-FI09        E-RUBRIK5 +32  7   A  VALUE ' '                                   
E-FI010       E-RUBRIK5 +39  1   A  VALUE ';'                                   
E-FI011       E-RUBRIK5 +40  7   A  VALUE ' '                                   
E-FI012       E-RUBRIK5 +47  1   A  VALUE ';'                                   
E-FI013       E-RUBRIK5 +48  7   A  VALUE ' '                                   
E-FI014       E-RUBRIK5 +55  1   A  VALUE ';'                                   
E-FI015       E-RUBRIK5 +56  2   A  VALUE ' '                                   
E-FI016       E-RUBRIK5 +58  1   A  VALUE ';'                                   
                                                                                
W-SUMRAD          W  7  N                                                       
W-SUMSTYCK        W  8  N                                                       
W-SUMORDER        W  6  N                                                       
W-SUMKOLLI        W  6  N                                                       
