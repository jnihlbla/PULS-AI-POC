E-ORDER       E-RUBRIK2 +50  8   A  VALUE '   ORDER'                            
E-FILL6       E-RUBRIK2 +58  1   A  VALUE ';'                                   
E-VIKTRUB     E-RUBRIK2 +59  11  A  VALUE 'CASE WEIGHT'                         
E-FILL7       E-RUBRIK2 +70  1   A  VALUE ';'                                   
                                                                                
E-RUBRIK3      W  59  A                                                         
E-ATERFOR      E-RUBRIK3      6   N  MASK 'ZZZZZ9'                              
E-FILL02       E-RUBRIK3 +7   1   A  VALUE ';'                                  
E-FILL03       E-RUBRIK3 +8   3   A  VALUE ' '                                  
E-FILL04       E-RUBRIK3 +11  1   A  VALUE ';'                                  
