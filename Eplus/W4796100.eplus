W-TOTSTYCK        W  8  N                                                       
W-TOTORDER        W  6  N                                                       
W-TOTKOLLI        W  6  N                                                       
W-VIKT-KOLLI                       W  8  N  1                                   
W-VIKT-KOLLI-HEL W-VIKT-KOLLI         7  N                                      
W-VIKT-KOLLI-DEC W-VIKT-KOLLI     +7  1  N                                      
W-VIKT-KOLLI-TOT                   W  8  N                                      
W-VIKT-KOLLI-DEC-TOT               W  1  N                                      
W-VIKT-KOLLI-N W  6  N 1                                                        
*-------------------------------------------------*                             
* JOB INFIL01                                     *                             
*-------------------------------------------------*                             
NEWPAGE                                                                         
JOB INPUT W47961D1 START INIT                                                   
IF IN-FLDIRLEV NE 'J' 'Y'                                                       
  IF IN-IDDISTR  =   778                                                        
**  IF IN-IDDC-LEV =  '11'                                                      
    IF IN-IDDC-LEV =  '1A'                                                      
                                                                                
      T1-MARKET    =  'DANZAS   '                                               
      T1-KDORDKL   =  IN-KDORDKL                                                
      T1-IDKUNDNR  =  IN-IDKUNDNR                                               
      T1-IDORDNR5  =  IN-IDORDNR5                                               
      T1-IDKOLLI   =  IN-IDKOLLI                                                
      T1-STYCK     =  IN-KVLEVART2                                              
      T1-VKORDBTO-KOLLI = IN-VKORDBTO-KOLLI                                     
      T1-VKORDNTO-KOLLI = IN-VKORDNTO-KOLLI                                     
*     DISPLAY 'IDARTNR ' IN-IDARTNR ' BTO ' IN-VKORDBTO-KOLLI +                 
*            ' NTO ' IN-VKORDNTO-KOLLI +                                        
*      ' KUNDNR ' IN-IDKUNDNR          +                                        
*      ' ORDNR '  IN-IDORDNR5          +                                        
*      ' KOLLINR '  IN-IDKOLLI ' KLASS ' IN-KDORDKL                             
      PUT TPFIL1                                                                
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
                                                                                
INIT. PROC                                                                      
  CALL DATKORT USING (PROGRAM-NAMN WDATUM DATUMKORT)                            
  W-VV  =  D-VECKA                                                              
  W-AAR =  D-AAR                                                                
  E-AAR =  W-AAR                                                                
  E-VV  =  W-VV                                                                 
END-PROC                                                                        
*-------------------------------------------------*                             
* STEG2 SORTERA TPFIL1 PÅ IDKUNDNR, KDORDKL, IDORDNR5, IDKOLLI                  
*-------------------------------------------------*                             
                                                                                
SORT TPFIL1 TO TPFIL1 USING (T1-IDKUNDNR, T1-KDORDKL +                          
               T1-IDORDNR5, T1-IDKOLLI)                                         
*--------------------------------------------------*                            
NEWPAGE                                                                         
JOB INPUT NULL                                                                  
  GET TPFIL1                                                                    
  IF NOT EOF TPFIL1                                                             
    PERFORM INITIERA                                                            
  END-IF                                                                        
  DO WHILE NOT EOF TPFIL1                                                       
    IF  T1-IDKUNDNR = ID-KUNDNR                                                 
      IF  T1-IDKUNDNR = ID-KUNDNR AND T1-KDORDKL = KDORDKL                      
        IF  T1-IDKUNDNR = ID-KUNDNR AND T1-KDORDKL = KDORDKL +                  
           AND T1-IDORDNR5 = IDORDNR5                                           
          IF  T1-IDKUNDNR = ID-KUNDNR AND T1-KDORDKL = KDORDKL +                
            AND T1-IDKOLLI = IDKOLLI AND T1-IDORDNR5 = IDORDNR5                 
***          VIKT-KOLLI-B = T1-VKORDBTO-KOLLI + VIKT-KOLLI-B                    
          ELSE                                                                  
            ANT-KOLLI = ANT-KOLLI + 1                                           
            W-SUMKOLLI  = W-SUMKOLLI  + 1                                       
            W-TOTKOLLI  = W-TOTKOLLI  + 1                                       
            IDKOLLI = T1-IDKOLLI                                                
            VIKT-KOLLI-B = T1-VKORDBTO-KOLLI + VIKT-KOLLI-B                     
                                                                                
          END-IF                                                                
        ELSE                                                                    
          W-SUMKOLLI  = W-SUMKOLLI  + 1                                         
          W-SUMORDER  = W-SUMORDER  + 1                                         
          W-TOTKOLLI  = W-TOTKOLLI  + 1                                         
          W-TOTORDER  = W-TOTORDER  + 1                                         
          ANT-KOLLI = ANT-KOLLI + 1                                             
          VIKT-KOLLI-B = T1-VKORDBTO-KOLLI + VIKT-KOLLI-B                       
          ANT-ORDER = ANT-ORDER + 1                                             
          ID-KUNDNR          = T1-IDKUNDNR                                      
          KDORDKL            = T1-KDORDKL                                       
          IDKOLLI            = T1-IDKOLLI                                       
          IDORDNR5           = T1-IDORDNR5                                      
        END-IF                                                                  
      ELSE                                                                      
        E-IDKUNDNR         = ID-KUNDNR                                          
        E-KDORDKL          = KDORDKL                                            
        E-KVASTYCK         = KVA-STYCK                                          
        E-ANTRADER         = ANT-RADER                                          
        E-ANTKOLLI         = ANT-KOLLI                                          
        E-ANTORDER         = ANT-ORDER                                          
        W-VIKT-KOLLI       = VIKT-KOLLI-B                                       
        E-VIKT             = W-VIKT-KOLLI-HEL                                   
        E-VIKT-DEC         = W-VIKT-KOLLI-DEC                                   
                                                                                
        E-HEADER           = UTFIL                                              
        PUT W47961D3                                                            
                                                                                
        PRINT REPORT01                                                          
        ANT-RADER          = 0                                                  
        KVA-STYCK          = 0                                                  
        ID-KUNDNR          = T1-IDKUNDNR                                        
        KDORDKL            = T1-KDORDKL                                         
        IDKOLLI            = T1-IDKOLLI                                         
        IDORDNR5           = T1-IDORDNR5                                        
        ANT-ORDER          = 1                                                  
        ANT-KOLLI          = 1                                                  
        TOT-VIKT-KOLLI     = TOT-VIKT-KOLLI + VIKT-KOLLI-B                      
        VIKT-KOLLI-B       = T1-VKORDBTO-KOLLI                                  
*       VIKT-KOLLI-N       = T1-VKORDNTO-KOLLI                                  
                                                                                
        W-TOTKOLLI  = W-TOTKOLLI  + 1                                           
        W-TOTORDER  = W-TOTORDER  + 1                                           
      END-IF                                                                    
    ELSE                                                                        
        E-IDKUNDNR         = ID-KUNDNR                                          
        E-KDORDKL          = KDORDKL                                            
        E-KVASTYCK         = KVA-STYCK                                          
        E-ANTRADER         = ANT-RADER                                          
        E-ANTKOLLI         = ANT-KOLLI                                          
        E-ANTORDER         = ANT-ORDER                                          
        W-VIKT-KOLLI       = VIKT-KOLLI-B                                       
        E-VIKT             = W-VIKT-KOLLI-HEL                                   
        E-VIKT-DEC         = W-VIKT-KOLLI-DEC                                   
        E-HEADER           = UTFIL                                              
        PUT W47961D3                                                            
                                                                                
        W-SUMKOLLI         = W-SUMKOLLI + 1                                     
        W-SUMORDER         = W-SUMORDER + 1                                     
        W-TOTKOLLI         = W-TOTKOLLI + 1                                     
        W-TOTORDER         = W-TOTORDER + 1                                     
        E-ATERFOR          = ID-KUNDNR                                          
        E-SUMSTYCK         = W-SUMSTYCK                                         
        E-SUMRAD           = W-SUMRAD                                           
        E-SUMKOLLI         = W-SUMKOLLI                                         
        E-SUMORDER         = W-SUMORDER                                         
        TOT-VIKT-KOLLI = TOT-VIKT-KOLLI + VIKT-KOLLI-B                          
        W-VIKT-KOLLI       = TOT-VIKT-KOLLI                                     
        E-SUMVIKT          = W-VIKT-KOLLI-HEL                                   
        E-SUMVIKT-DEC      = W-VIKT-KOLLI-DEC                                   
        E-HEADER           = E-RUBRIK3                                          
        PUT W47961D3                                                            
                                                                                
        E-HEADER           = E-RUBRIK5                                          
        PUT W47961D3                                                            
                                                                                
        E-TOTRAD           = W-TOTRAD                                           
        E-TOTSTYCK         = W-TOTSTYCK                                         
        E-TOTKOLLI         = W-TOTKOLLI                                         
        E-TOTORDER         = W-TOTORDER                                         
                                                                                
        W-SUMSTYCK         = 0                                                  
        W-SUMRAD           = 0                                                  
        W-SUMKOLLI         = 1                                                  
        W-SUMORDER         = 1                                                  
                                                                                
        SUPERTOT-VIKT = SUPERTOT-VIKT + TOT-VIKT-KOLLI                          
        TOT-VIKT-KOLLI     = 0                                                  
                                                                                
        PRINT REPORT01                                                          
        ANT-RADER          = 0                                                  
        KVA-STYCK          = 0                                                  
        ID-KUNDNR          = T1-IDKUNDNR                                        
        KDORDKL            = T1-KDORDKL                                         
        IDKOLLI            = T1-IDKOLLI                                         
        IDORDNR5           = T1-IDORDNR5                                        
        ANT-ORDER          = 1                                                  
        ANT-KOLLI          = 1                                                  
        VIKT-KOLLI-B       = T1-VKORDBTO-KOLLI                                  
*       VIKT-KOLLI-N       = T1-VKORDNTO-KOLLI                                  
    END-IF                                                                      
    ANT-RADER = ANT-RADER + 1                                                   
    KVA-STYCK = KVA-STYCK + T1-STYCK                                            
    W-SUMRAD  = W-SUMRAD  + 1                                                   
    W-SUMSTYCK = W-SUMSTYCK  + T1-STYCK                                         
    W-TOTRAD  = W-TOTRAD  + 1                                                   
    W-TOTSTYCK = W-TOTSTYCK  + T1-STYCK                                         
    GET TPFIL1                                                                  
   END-DO                                                                       
   E-IDKUNDNR         = ID-KUNDNR                                               
   E-KDORDKL          = KDORDKL                                                 
   E-KVASTYCK         = KVA-STYCK                                               
   E-ANTRADER         = ANT-RADER                                               
   E-ANTKOLLI         = ANT-KOLLI                                               
   E-ANTORDER         = ANT-ORDER                                               
   W-VIKT-KOLLI       = VIKT-KOLLI-B                                            
   E-VIKT             = W-VIKT-KOLLI-HEL                                        
   E-VIKT-DEC         = W-VIKT-KOLLI-DEC                                        
   E-HEADER           = UTFIL                                                   
   PUT W47961D3                                                                 
                                                                                
   W-SUMKOLLI         = W-SUMKOLLI + 1                                          
   W-SUMORDER         = W-SUMORDER + 1                                          
   E-ATERFOR          = ID-KUNDNR                                               
   E-SUMSTYCK         = W-SUMSTYCK                                              
   E-SUMRAD           = W-SUMRAD                                                
   E-SUMKOLLI         = W-SUMKOLLI                                              
   E-SUMORDER         = W-SUMORDER                                              
   TOT-VIKT-KOLLI = TOT-VIKT-KOLLI + VIKT-KOLLI-B                               
   W-VIKT-KOLLI       = TOT-VIKT-KOLLI                                          
   E-SUMVIKT          = W-VIKT-KOLLI-HEL                                        
   E-SUMVIKT-DEC          = W-VIKT-KOLLI-DEC                                    
   E-HEADER           = E-RUBRIK3                                               
   PUT W47961D3                                                                 
                                                                                
   W-TOTKOLLI         = W-TOTKOLLI + 1                                          
   W-TOTORDER         = W-TOTORDER + 1                                          
   E-TOTRAD           = W-TOTRAD                                                
   E-TOTSTYCK         = W-TOTSTYCK                                              
   E-TOTKOLLI         = W-TOTKOLLI                                              
   E-TOTORDER         = W-TOTORDER                                              
   SUPERTOT-VIKT = SUPERTOT-VIKT + TOT-VIKT-KOLLI                               
   W-VIKT-KOLLI       = SUPERTOT-VIKT                                           
   E-TOTVIKT          = W-VIKT-KOLLI-HEL                                        
   E-TOTVIKT-DEC          = W-VIKT-KOLLI-DEC                                    
   E-HEADER     = E-RUBRIK4                                                     
   PUT W47961D3                                                                 
                                                                                
   PRINT REPORT01                                                               
STOP                                                                            
INITIERA. PROC                                                                  
    ID-KUNDNR          = T1-IDKUNDNR                                            
    KDORDKL            = T1-KDORDKL                                             
    IDKOLLI            = T1-IDKOLLI                                             
    IDORDNR5           = T1-IDORDNR5                                            
    ANT-ORDER          = 1                                                      
    ANT-RADER          = 0                                                      
    ANT-KOLLI          = 1                                                      
*   VIKT-KOLLI-B       = 0                                                      
    VIKT-KOLLI-B       = T1-VKORDBTO-KOLLI                                      
*   VIKT-KOLLI-N       = 0                                                      
    KVA-STYCK          = 0                                                      
    W-SUMSTYCK         = 0                                                      
    W-SUMRAD           = 0                                                      
    W-SUMKOLLI         = 1                                                      
    W-SUMORDER         = 1                                                      
    E-HEADER           = E-RUBRIK1                                              
    PUT W47961D3                                                                
    E-HEADER           = E-RUBRIK5                                              
    PUT W47961D3                                                                
    E-HEADER           = E-RUBRIK2                                              
    PUT W47961D3                                                                
END-PROC                                                                        
*-------------------------------------------------*                             
                                                                                
REPORT      REPORT01         +                                                  
            PRINTER W47961D2 +                                                  
            NOPAGE           +                                                  
            TITLESKIP 0      +                                                  
            PAGESIZE 9999    +                                                  
            SPACE 1          +                                                  
            NOADJUST         +                                                  
            LINESIZE 99      +                                                  
            NOHEADING                                                           
*                                                                               
SEQUENCE    ID-KUNDNR KDORDKL                                                   
CONTROL     ID-KUNDNR KDORDKL NOPRINT                                           
*                                                                               
TITLE 01   COL 12 'W47961-001'        +                                         
           COL 25 'LAGER DANZAS '     +                                         
           COL 40 'FAKTURERAT VECKA ' +                                         
           COL 58  W-VV                                                         
*                                                                               
TITLE 03   COL 4  'ÅF'                 +                                        
           COL 9  'KLASS'              +                                        
           COL 19 'STYCK'              +                                        
           COL 30 'RADER'              +                                        
           COL 40 'KOLLI'              +                                        
           COL 50 'ORDER'              +                                        
           COL 61 'KOLLI-VIKT'                                                  
                                                                                
*                                                                               
LINE  ID-KUNDNR KDORDKL KVA-STYCK ANT-RADER ANT-KOLLI ANT-ORDER +               
      VIKT-KOLLI-B                                                              
