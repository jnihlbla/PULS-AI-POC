               IF IN8-IDDC = NDC-IN                                             
                 IF IN8-TIBERANK < OUT-TIBERANK-SLAG(04) +                      
                 OR OUT-TIBERANK-SLAG(04) = 0                                   
                   OUT-TIBERANK-SLAG (04) = IN8-TIBERANK                        
