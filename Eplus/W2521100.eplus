                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2521100                                              *        
*                                                                      *        
*  FUNKTION   :  PS&L NEW PARTS INFORMATION                            *        
*                                                                      *        
*  FÖRFATTARE :  STENING INGER                                         *        
*                                                                      *        
* WRITE OUTPUT FILE WITH PART DATA FROM W01160                                  
*                                       W01161                                  
*                                       W01163                                  
*                                       W01183                                  
*                                       W01184                                  
*                                       W01185                                  
*                                       W01174                                  
*                                       W23683                                  
*                                       W6125B                                  
*----------------------------------------------------------------------*        
                                                                                
FILE W25211D1                                                                   
* PART INFO FROM W01184                                                         
%W25209  'IN1-'                                                                 
                                                                                
FILE W25211D2                                                                   
* WDK601 AND WDK611                                                             
%W01160  'IN2-'                                                                 
                                                                                
FILE W25211D3                                                                   
* WDK621                                                                        
%W01161  'IN3-'                                                                 
                                                                                
FILE W25211D4                                                                   
* WDK623                                                                        
%W01163  'IN4-'                                                                 
                                                                                
FILE W25211D5                                                                   
* WDK723                                                                        
%W01183  'IN5-'                                                                 
*                                                                               
FILE W25211D6                                                                   
* WDK724                                                                        
%W01185  'IN6-'                                                                 
*                                                                               
FILE W25211D7                                                                   
* PART DESCRIPTION WDD3                                                         
%W01174  'IN7-'                                                                 
*                                                                               
FILE W25211D8                                                                   
* REC.DATE AND GIT ETA - WDL2/WDL6                                              
%W61250  'IN8-'                                                                 
*                                                                               
FILE W25211D9 FB(2290 0)                                                        
%W25209  'OUT-'                                                                 
*                                                                               
IX1                W  3 N  VALUE 0                                              
MAX-IX1-DC         W  3 N  VALUE 6                                              
W-KVRADER-SLAG     W  3 N  VALUE 0                                              
W-SPRL-DAPRLIST    W  6 N  VALUE 0.                                             
W-SLAG-IDARTNR     W  9 N  VALUE 0.                                             
*                                                                               
INNEV-AAVVD       W                5  N                                         
INNEV-AA          INNEV-AAVVD      2  N                                         
INNEV-VV          INNEV-AAVVD +2   2  N                                         
INNEV-DAG         INNEV-AAVVD +4   1  N                                         
PLUS2AAR          W                5  N                                         
FOREG-AA          PLUS2AAR         2  N                                         
FOREG-VV          PLUS2AAR    +2   2  N                                         
FOREG-DAG         PLUS2AAR    +4   1  N                                         
MINUS2AAR         W                5  N                                         
FORE2-AA          MINUS2AAR        2  N                                         
FORE2-VV          MINUS2AAR   +2   2  N                                         
FORE2-DAG         MINUS2AAR   +4   1  N                                         
*                                                                               
NEWPAGE                                                                         
%WDATAREA                                                                       
NEWPAGE                                                                         
*                                                                               
WDATKONV                W  8  A VALUE 'WDATKONV'                                
*                                                                               
PROGRAM-NAMN      W   6   A   VALUE 'W25211'                                    
DATUMKORT-ID      W   6   A   VALUE 'WDATUM'                                    
%WDATKORT 'DATKORT-'                                                            
NEWPAGE                                                                         
*                                                                               
*  CHECK IDDC VALUES                                                            
%WWDC99                                                                         
NEWPAGE                                                                         
JOB INPUT (W25211D2 KEY (IN2-CLAG-IDARTNR) +                                    
           W25211D1 KEY (IN1-IDARTNR))     +                                    
           START A-INIT                                                         
                                                                                
  IF MATCHED                                                                    
     IF IN2-CLAG-KDERS    = 0 THRU 9                            +               
    AND IN2-CLAG-KDPRODSL = 11 13 14 15 16 18 51 53 54 55 56 58 +               
    AND IN2-CLAG-TISOP    = MINUS2AAR THRU PLUS2AAR             +               
    AND IN2-CLAG-KDSORT  NE 'SW'                                +               
    AND IN2-CLAG-IDPROJ  NE 'OBJ'                                               
        PERFORM S02-INFO-FROM-W25209                                            
        PERFORM S03-INFO-FROM-W01160                                            
        PERFORM S04-INFO-FROM-W01161                                            
        PERFORM S05-INFO-FROM-W01163                                            
        PERFORM S06-INFO-FROM-W01183                                            
        PERFORM S07-INFO-FROM-W01185                                            
        PERFORM S08-INFO-FROM-W01174                                            
        PERFORM S09-INFO-FROM-W23683-W6125B                                     
        OUT-DADATUM      = SYSDATE-LONG                                         
        PUT W25211D9                                                            
        PERFORM S00-INIT-ALL-FIELDS                                             
     END-IF                                                                     
  ELSE                                                                          
     IF W25211D2                                                                
       IF IN2-CLAG-KDERS    = 0 THRU 9                            +             
      AND IN2-CLAG-KDPRODSL = 11 13 14 15 16 18 51 53 54 55 56 58 +             
      AND IN2-CLAG-TISOP    = MINUS2AAR THRU PLUS2AAR             +             
      AND IN2-CLAG-KDSORT  NE 'SW'                        +                     
      AND IN2-CLAG-IDPROJ  NE 'OBJ'                                             
         PERFORM S00-INIT-ALL-FIELDS                                            
         PERFORM S03-INFO-FROM-W01160                                           
         PERFORM S04-INFO-FROM-W01161                                           
         PERFORM S05-INFO-FROM-W01163                                           
         PERFORM S08-INFO-FROM-W01174                                           
         PERFORM S09-INFO-FROM-W23683-W6125B                                    
         OUT-DADATUM      = SYSDATE-LONG                                        
         PUT W25211D9                                                           
       END-IF                                                                   
     END-IF                                                                     
  END-IF                                                                        
                                                                                
A-INIT.   PROC                                                                  
                                                                                
  PERFORM S00-INIT-ALL-FIELDS                                                   
                                                                                
  CALL DATKORT  USING (PROGRAM-NAMN +                                           
                       DATUMKORT-ID +                                           
                       DATKORT-DATUMKORT)                                       
  INNEV-AA      = DATKORT-D-AAR                                                 
  INNEV-VV      = DATKORT-D-VECKA                                               
  FOREG-VV      = DATKORT-D-VECKA                                               
  FORE2-VV      = DATKORT-D-VECKA                                               
  INNEV-DAG     = DATKORT-D-DAGNR                                               
  FOREG-DAG     = DATKORT-D-DAGNR                                               
  FORE2-DAG     = DATKORT-D-DAGNR                                               
  FOREG-AA      = DATKORT-D-AAR + 2                                             
  FORE2-AA      = DATKORT-D-AAR - 2                                             
                                                                                
  DAT-KDDATFORM = 'IDAG  '                                                      
  DAT-I-TIDATUM = 0                                                             
                                                                                
  CALL WDATKONV USING (DAT-KDDATFORM                         +                  
                       DAT-I-TIDATUM                         +                  
                       DAT-O-TIDATUM                         +                  
                       DAT-KDSVAR    )                                          
                                                                                
  GET W25211D3                                                                  
                                                                                
  GET W25211D4                                                                  
  IF EOF W25211D4                                                               
     IN4-AVT-IDARTNR     = +0                                                   
  END-IF                                                                        
                                                                                
  GET W25211D5                                                                  
  IF EOF W25211D5                                                               
     IN5-SAVT-IDARTNR    = +0                                                   
  END-IF                                                                        
                                                                                
  GET W25211D6                                                                  
  IF EOF W25211D6                                                               
     IN6-SPRL-IDARTNR    = +0                                                   
     IN6-SPRL-IDDC       = ' '                                                  
     IN6-SPRL-IDLEVNR-PR = ' '                                                  
  END-IF                                                                        
                                                                                
  GET W25211D7                                                                  
                                                                                
  GET W25211D8                                                                  
  IF EOF W25211D8                                                               
     IN8-IDARTNR         = +0                                                   
     IN8-IDDC            = ' '                                                  
  END-IF                                                                        
                                                                                
END-PROC                                                                        
                                                                                
S00-INIT-ALL-FIELDS.    PROC                                                    
  OUT-BEART-ENG                 = ' '                                           
  OUT-BEUPPDSU                  = ' '                                           
  OUT-FLERS                     = ' '                                           
  OUT-FLPISK                    = ' '                                           
  OUT-FLUPG                     = ' '                                           
  OUT-IDAO                      = ' '                                           
  OUT-IDINK                     = ' '                                           
  OUT-IDNAMN-FORP               = ' '                                           
  OUT-IDNAMN-IDANSK             = ' '                                           
  OUT-IDNAMN-IDINK              = ' '                                           
  OUT-IDLEVNR                   = ' '                                           
  OUT-IDPROJ                    = ' '                                           
  OUT-IDPROJUP                  = ' '                                           
  OUT-IDUPPDKU                  = ' '                                           
  OUT-IDUPPDSU                  = ' '                                           
  OUT-KDARTURS                  = ' '                                           
  OUT-KDFPKPRI                  = ' '                                           
  OUT-KDTPD                     = ' '                                           
  OUT-KDUART                    = ' '                                           
  OUT-TELEVBSK                  = ' '                                           
  OUT-DADATUM                   = ' '                                           
                                                                                
  OUT-BEFT                      = +0                                            
  OUT-DAPUBL-CN                 = 0                                             
  OUT-DAPUBL-US                 = 0                                             
  OUT-IDANSK                    = +0                                            
  OUT-IDARTNR                   = +0                                            
  OUT-IDARTNR-EMBQ0             = +0                                            
  OUT-IDARTNR-TILLK             = +0                                            
  OUT-IDFKNGRP                  = +0                                            
  OUT-KDAVT                     = +0                                            
  OUT-KDEMBKOD-2                = +0                                            
  OUT-KDERS                     = +0                                            
  OUT-KDFARLIG                  = +0                                            
  OUT-KDPRODSL                  = +0                                            
  OUT-KVOKS-BULK                = +0                                            
  OUT-KVOKS-DAG                 = +0                                            
  OUT-KVOKS-VOR                 = +0                                            
  OUT-KVAKS-CDC                 = +0                                            
  OUT-KVAKS-PAV                 = +0                                            
  OUT-KVAKS-T                   = +0                                            
  OUT-KVLS                      = +0                                            
  OUT-KVLS-EMBQ0                = +0                                            
  OUT-KVLS-SS                   = +0                                            
  OUT-KVRADER-CDC               = +0                                            
  OUT-KVRADER-SLAG              = +0                                            
  OUT-KVRESS                    = +0                                            
  OUT-KVRESS-EMBQ0              = +0                                            
  OUT-KVRESS-SS                 = +0                                            
  OUT-KVROS                     = +0                                            
  OUT-KVROS-EMBQ0               = +0                                            
  OUT-KVROS-SS                  = +0                                            
  OUT-KVVORKO                   = +0                                            
  OUT-REDIRLEV                  = +0                                            
  OUT-SUTPO-TOT                 = +0                                            
  OUT-TIMOTSI                   = +0                                            
  OUT-TIAVIDAT                  = +0                                            
  OUT-TIAVTAL                   = +0                                            
  OUT-TIDISPIN                  = +0                                            
  OUT-TIFINLV                   = +0                                            
  OUT-TILEVBSK-DISP             = +0                                            
  OUT-TIREGDAT                  = +0                                            
  OUT-TISOP                     = +0                                            
  OUT-TIUPPDAT-BTO              = +0                                            
  OUT-TIUPPDAT-EMB              = +0                                            
                                                                                
  IX1                           = +1                                            
  DO WHILE IX1 <  MAX-IX1-DC + 1                                                
     OUT-IDDC-SLAG            (IX1) = ' '                                       
     OUT-IDLEVNR-SLAG         (IX1) = ' '                                       
     OUT-IDINK-SLAG           (IX1) = ' '                                       
     OUT-IDNAMN-IDANSK-SLAG   (IX1) = ' '                                       
     OUT-IDNAMN-IDINK-SLAG    (IX1) = ' '                                       
     OUT-KDARTURS-SLAG        (IX1) = ' '                                       
     OUT-KDMATRPR-SLAG        (IX1) = ' '                                       
     OUT-TELEVBSK-SLAG        (IX1) = ' '                                       
                                                                                
     OUT-DAPRLIST-SLAG        (IX1) = 0                                         
     OUT-IDANSK-SLAG          (IX1) = +0                                        
     OUT-IDARTNR-EMBQ0-SLAG   (IX1) = +0                                        
     OUT-KDAVT-SLAG           (IX1) = +0                                        
     OUT-KVAKS-SDC-SLAG       (IX1) = +0                                        
     OUT-KVAKS-SDC-EMBQ0-SLAG (IX1) = +0                                        
     OUT-KVAKS-SDC-SS-SLAG    (IX1) = +0                                        
     OUT-KVBEART-SLAG         (IX1) = +0                                        
     OUT-KVLS-SLAG            (IX1) = +0                                        
     OUT-KVLS-EMBQ0-SLAG      (IX1) = +0                                        
     OUT-KVLS-SS-SLAG         (IX1) = +0                                        
     OUT-KVOKS-BULK-SLAG      (IX1) = +0                                        
     OUT-KVOKS-BULK-EMBQ0-SLAG(IX1) = +0                                        
     OUT-KVOKS-BULK-SS-SLAG   (IX1) = +0                                        
     OUT-KVOKS-DAG-SLAG       (IX1) = +0                                        
     OUT-KVOKS-DAG-EMBQ0-SLAG (IX1) = +0                                        
     OUT-KVOKS-DAG-SS-SLAG    (IX1) = +0                                        
     OUT-KVRESS-SLAG          (IX1) = +0                                        
     OUT-KVRESS-EMBQ0-SLAG    (IX1) = +0                                        
     OUT-KVRESS-SS-SLAG       (IX1) = +0                                        
     OUT-KVROS-BULK-SLAG      (IX1) = +0                                        
     OUT-KVROS-BULK-EMBQ0-SLAG(IX1) = +0                                        
     OUT-KVROS-BULK-SS-SLAG   (IX1) = +0                                        
     OUT-KVROS-DAG-SLAG       (IX1) = +0                                        
     OUT-KVROS-DAG-EMBQ0-SLAG (IX1) = +0                                        
     OUT-KVROS-DAG-SS-SLAG    (IX1) = +0                                        
     OUT-TIAVTAL-SLAG         (IX1) = +0                                        
     OUT-TIBERANK-SLAG        (IX1) = 0                                         
     OUT-TIINLMOT-SLAG        (IX1) = +0                                        
     OUT-TIMOTSI-SLAG         (IX1) = +0                                        
     OUT-TILEVBSK-DISP-SLAG   (IX1) = +0                                        
                                                                                
     IX1 = IX1 + 1                                                              
  END-DO                                                                        
END-PROC                                                                        
                                                                                
S02-INFO-FROM-W25209.    PROC                                                   
                                                                                
  OUT-W25209-CTX             = IN1-W25209-CTX                                   
                                                                                
END-PROC                                                                        
                                                                                
S03-INFO-FROM-W01160.      PROC                                                 
**************************************************                              
* PART INFORMATION - WDK601 AND WDK611           *                              
**************************************************                              
  OUT-BEFT                = IN2-CLAG-BEFT                                       
  OUT-IDPROJ              = IN2-CLAG-IDPROJ                                     
  OUT-IDPROJUP            = IN2-CLAG-IDPROJUP                                   
  OUT-PRARTSTD            = IN2-CLAG-PRARTSTD                                   
  IF IN2-CLAG-IDAO(05) NE ' '                                                   
     OUT-IDAO             = IN2-CLAG-IDAO(05)                                   
  ELSE                                                                          
    IF IN2-CLAG-IDAO(04) NE ' '                                                 
       OUT-IDAO           = IN2-CLAG-IDAO(04)                                   
    ELSE                                                                        
      IF IN2-CLAG-IDAO(03) NE ' '                                               
         OUT-IDAO         = IN2-CLAG-IDAO(03)                                   
      ELSE                                                                      
        IF IN2-CLAG-IDAO(02) NE ' '                                             
           OUT-IDAO       = IN2-CLAG-IDAO(02)                                   
        ELSE                                                                    
          IF IN2-CLAG-IDAO(01) NE ' '                                           
             OUT-IDAO     = IN2-CLAG-IDAO(01)                                   
          ELSE                                                                  
             OUT-IDAO     = ' '                                                 
          END-IF                                                                
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
  OUT-IDARTNR             = IN2-CLAG-IDARTNR                                    
  OUT-IDARTNR-EMBQ0       = IN2-CLAG-IDARTNR-EMBQ0                              
  OUT-TIFINLV             = IN2-CLAG-TIFINLV                                    
  OUT-KDPRODSL            = IN2-CLAG-KDPRODSL                                   
  OUT-IDFKNGRP            = IN2-CLAG-IDFKNGRP                                   
  OUT-KDUART              = IN2-CLAG-KDUART                                     
  OUT-KDFARLIG            = IN2-CLAG-KDFARLIG                                   
  OUT-KDERS               = IN2-CLAG-KDERS                                      
  OUT-KVLS                = IN2-CLAG-KVLS                                       
  OUT-KVRESS              = IN2-CLAG-KVRESS                                     
  OUT-KVROS               = IN2-CLAG-KVROS                                      
  OUT-KVAKS-CDC           = IN2-CLAG-KVAKS-CDC                                  
  OUT-KVAKS-PAV           = IN2-CLAG-KVAKS-PAV                                  
  OUT-KVAKS-T             = IN2-CLAG-KVAKS-T                                    
  OUT-TIREGDAT            = IN2-CLAG-TIREGDAT                                   
  OUT-KDEMBKOD-2          = IN2-CLAG-KDEMBKOD-2                                 
  OUT-TIUPPDAT-EMB        = IN2-CLAG-TIUPPDAT-EMB                               
  OUT-IDANSK              = IN2-CLAG-IDANSK                                     
  OUT-IDINK               = IN2-CLAG-IDINK                                      
  OUT-KDAVT               = IN2-CLAG-KDAVT                                      
  OUT-IDLEVNR             = IN2-CLAG-IDLEVNR                                    
  OUT-KDARTURS            = IN2-CLAG-KDARTURS                                   
  OUT-REDIRLEV            = IN2-CLAG-REDIRLEV                                   
  OUT-KVVORKO             = IN2-CLAG-KVVORKO                                    
  OUT-TIDISPIN            = IN2-CLAG-TIDISPIN                                   
  OUT-TISOP               = IN2-CLAG-TISOP                                      
END-PROC                                                                        
                                                                                
S04-INFO-FROM-W01161.      PROC                                                 
**************************************************                              
* PART INFORMATION - WDK621                      *                              
**************************************************                              
                                                                                
  OUT-KDFPKPRI             = ' '                                                
                                                                                
  IX1                      = +0                                                 
  DO WHILE (NOT EOF W25211D3)                  +                                
     AND (IN3-PRL-IDARTNR <= IN2-CLAG-IDARTNR)                                  
     IF IN3-PRL-IDARTNR = IN2-CLAG-IDARTNR                                      
        IF IX1             = +0                                                 
           OUT-KDFPKPRI    = IN3-PRL-KDFPKPRI                                   
        END-IF                                                                  
        IX1 = IX1 + 1                                                           
     END-IF                                                                     
     GET W25211D3                                                               
  END-DO                                                                        
  OUT-KVRADER-CDC          = IX1                                                
                                                                                
END-PROC                                                                        
                                                                                
S05-INFO-FROM-W01163.      PROC                                                 
**************************************************                              
* PART INFORMATION - WDK623                      *                              
**************************************************                              
* SEVERAL WDK623 EXIST. READ THE FIRST WDK623.                                  
                                                                                
  DO WHILE (NOT EOF W25211D4)  +                                                
   AND IN4-AVT-IDARTNR <= IN2-CLAG-IDARTNR                                      
     IF IN4-AVT-IDARTNR = IN2-CLAG-IDARTNR                                      
        OUT-TIAVTAL        = IN4-AVT-TIAVTAL                                    
     END-IF                                                                     
     GET W25211D4                                                               
  END-DO                                                                        
                                                                                
END-PROC                                                                        
                                                                                
S06-INFO-FROM-W01183.    PROC.                                                  
**************************************************                              
* INFO FROM WDK723                               *                              
**************************************************                              
                                                                                
  DO WHILE (NOT EOF W25211D5) +                                                 
     AND (IN5-SAVT-IDARTNR <= IN2-CLAG-IDARTNR)                                 
     IF IN5-SAVT-IDARTNR = IN2-CLAG-IDARTNR                                     
       IF IN5-SAVT-IDDC = NDC-US-RU                                             
         OUT-TIAVTAL-SLAG (01)          = IN5-SAVT-TIAVTAL                      
       ELSE                                                                     
         IF IN5-SAVT-IDDC = NDC-JP                                              
           OUT-TIAVTAL-SLAG (02)        = IN5-SAVT-TIAVTAL                      
         ELSE                                                                   
           IF IN5-SAVT-IDDC = NDC-AU                                            
             OUT-TIAVTAL-SLAG (03)      = IN5-SAVT-TIAVTAL                      
           ELSE                                                                 
             IF IN5-SAVT-IDDC = NDC-IN                                          
               OUT-TIAVTAL-SLAG (04)    = IN5-SAVT-TIAVTAL                      
             ELSE                                                               
               IF IN5-SAVT-IDDC = NDC-CN-71                                     
                 OUT-TIAVTAL-SLAG (05)  = IN5-SAVT-TIAVTAL                      
               ELSE                                                             
                 IF IN5-SAVT-IDDC = NDC-CN-72                                   
                   OUT-TIAVTAL-SLAG (06) = IN5-SAVT-TIAVTAL                     
                 END-IF                                                         
               END-IF                                                           
             END-IF                                                             
           END-IF                                                               
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
     GET W25211D5                                                               
  END-DO                                                                        
                                                                                
END-PROC                                                                        
                                                                                
S07-INFO-FROM-W01185.    PROC.                                                  
**************************************************                              
* INFO FROM WDK724                               *                              
**************************************************                              
                                                                                
  W-KVRADER-SLAG = +0                                                           
                                                                                
  DO WHILE (NOT EOF W25211D6)                       +                           
    AND (IN6-SPRL-IDARTNR    <= IN2-CLAG-IDARTNR)                               
    IF IN6-SPRL-IDARTNR = IN2-CLAG-IDARTNR                                      
      IF IN6-SPRL-DAPRLIST-9KOMPL > 0                                           
        W-KVRADER-SLAG = W-KVRADER-SLAG + 1                                     
        W-SPRL-DAPRLIST = IN6-SPRL-DAPRLIST-9KOMPL - 99999999                   
                                                                                
                                                                                
        IF IN6-SPRL-IDDC = NDC-US-RU                                            
          IF OUT-DAPRLIST-SLAG(01) = 0                                          
             OUT-DAPRLIST-SLAG(01)            = W-SPRL-DAPRLIST                 
          END-IF                                                                
        ELSE                                                                    
          IF IN6-SPRL-IDDC = NDC-JP                                             
            IF OUT-DAPRLIST-SLAG(02) = 0                                        
               OUT-DAPRLIST-SLAG(02)         = W-SPRL-DAPRLIST                  
            END-IF                                                              
          ELSE                                                                  
            IF IN6-SPRL-IDDC = NDC-AU                                           
              IF OUT-DAPRLIST-SLAG(03) = 0                                      
                 OUT-DAPRLIST-SLAG(03)       = W-SPRL-DAPRLIST                  
              END-IF                                                            
            ELSE                                                                
              IF IN6-SPRL-IDDC = NDC-IN                                         
                IF OUT-DAPRLIST-SLAG(04) = 0                                    
                   OUT-DAPRLIST-SLAG(04)     = W-SPRL-DAPRLIST                  
                END-IF                                                          
              ELSE                                                              
                IF IN6-SPRL-IDDC = NDC-CN-71                                    
                  IF OUT-DAPRLIST-SLAG(05) = 0                                  
                    OUT-DAPRLIST-SLAG(05)    = W-SPRL-DAPRLIST                  
                  END-IF                                                        
                ELSE                                                            
                  IF IN6-SPRL-IDDC = NDC-CN-72                                  
                    IF OUT-DAPRLIST-SLAG(06) = 0                                
                      OUT-DAPRLIST-SLAG(06)  = W-SPRL-DAPRLIST                  
                    END-IF                                                      
                  END-IF                                                        
                END-IF                                                          
              END-IF                                                            
            END-IF                                                              
          END-IF                                                                
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
    GET W25211D6                                                                
  END-DO                                                                        
  OUT-KVRADER-SLAG = W-KVRADER-SLAG                                             
END-PROC                                                                        
                                                                                
S08-INFO-FROM-W01174.      PROC                                                 
**************************************************                              
* PART DESCRIPTION                               *                              
**************************************************                              
                                                                                
  DO WHILE (NOT EOF W25211D7)                     +                             
       AND (IN7-IDARTNR <= IN2-CLAG-IDARTNR)                                    
    IF IN7-IDARTNR = IN2-CLAG-IDARTNR                                           
       OUT-BEART-ENG      = IN7-BEART(4)                                        
    ELSE                                                                        
       OUT-BEART-ENG      = ' '                                                 
    END-IF                                                                      
    GET W25211D7                                                                
  END-DO                                                                        
                                                                                
END-PROC                                                                        
                                                                                
S09-INFO-FROM-W23683-W6125B. PROC                                               
                                                                                
  DO WHILE (NOT EOF W25211D8)  +                                                
   AND IN8-IDARTNR <= IN2-CLAG-IDARTNR                                          
     IF IN8-IDARTNR = IN2-CLAG-IDARTNR                                          
       IF IN8-IDDC = CDC-SE                                                     
         IF IN8-TIAVIDAT < OUT-TIAVIDAT +                                       
         OR OUT-TIAVIDAT = +0                                                   
            OUT-TIAVIDAT = IN8-TIAVIDAT                                         
         END-IF                                                                 
       ELSE                                                                     
         IF IN8-IDDC = NDC-US-RU                                                
           IF IN8-TIBERANK < OUT-TIBERANK-SLAG(01) +                            
           OR OUT-TIBERANK-SLAG(01) = 0                                         
              OUT-TIBERANK-SLAG(01) = IN8-TIBERANK                              
           END-IF                                                               
                                                                                
           IF IN8-TIINLMOT < OUT-TIINLMOT-SLAG(01) +                            
           OR OUT-TIINLMOT-SLAG(01) = +0                                        
             OUT-TIINLMOT-SLAG (01) = IN8-TIINLMOT                              
           END-IF                                                               
