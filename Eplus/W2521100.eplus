                     IF IN8-TIINLMOT < OUT-TIINLMOT-SLAG(06) +                  
                     OR OUT-TIINLMOT-SLAG(06) = +0                              
                       OUT-TIINLMOT-SLAG(06)  = IN8-TIINLMOT                    
                     END-IF                                                     
                   END-IF                                                       
                 END-IF                                                         
               END-IF                                                           
             END-IF                                                             
           END-IF                                                               
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
     GET W25211D8                                                               
