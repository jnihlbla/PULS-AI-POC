                   OUT-TIINLMOT-SLAG (04) = IN8-TIINLMOT                        
                 END-IF                                                         
               ELSE                                                             
                 IF IN8-IDDC = NDC-CN-71                                        
                   IF IN8-TIBERANK < OUT-TIBERANK-SLAG(05) +                    
                   OR OUT-TIBERANK-SLAG(05) = 0                                 
                     OUT-TIBERANK-SLAG (05) = IN8-TIBERANK                      
                   END-IF                                                       
                                                                                
                   IF IN8-TIINLMOT < OUT-TIINLMOT-SLAG(05) +                    
                   OR OUT-TIINLMOT-SLAG(05) = +0                                
                     OUT-TIINLMOT-SLAG (05) = IN8-TIINLMOT                      
                   END-IF                                                       
                 ELSE                                                           
                   IF IN8-IDDC = NDC-CN-72                                      
                     IF IN8-TIBERANK < OUT-TIBERANK-SLAG(06) +                  
                     OR OUT-TIBERANK-SLAG(06) = 0                               
                       OUT-TIBERANK-SLAG(06)  = IN8-TIBERANK                    
