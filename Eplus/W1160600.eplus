                                                                                
*----------------------------------------------------------------------*        
*  PROGRAM    :  W1160600                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR ARTIKELDATA, BENÄMNINGSFIL, BUYBACKFIL,       *        
*                SAMT CROSSFIL MED FIL GEMENSAM ART INFO VCC-KDP       *        
*                OCH FORD                                              *        
*                SKAPAR FIL FÖR UNDERLAG TILL VIPSÖVERFÖRING           *        
*                                                                      *        
*  FÖRFATTARE :  MONICA BERGSTRÖM                                      *        
*                                                                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
*    -- CHECKED BY WY2000                                                       
*                                                                               
*--------------------------------------*                                        
*   ARTIKELDATA                        *                                        
* -------------------------------------*                                        
                                                                                
FILE W11606D1                                                                   
*                                                                               
%W01160   'ART-'                                                                
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  BENÄMNINGAR                         *                                        
* -------------------------------------*                                        
FILE W11606D2                                                                   
%W01174   'BEN-'                                                                
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  BUYBACK-KODER                       *                                        
* -------------------------------------*                                        
FILE W11606D3                                                                   
%W11604   'BB-'                                                                 
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  CROSSFIL                            *                                        
* -------------------------------------*                                        
FILE W11606D6                                                                   
%W11685   'CROSS-'                                                              
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  UTFILER                             *                                        
* -------------------------------------*                                        
FILE W11606D4 FB (428 0)                                                        
%W11606    'UT-'                                                                
*                                                                               
NEWPAGE                                                                         
FILE W11606D5                                                                   
%W01169                                                                         
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  TEMPFILER                           *                                        
* -------------------------------------*                                        
FILE TEMPFIL1 FB(428 0) VIRTUAL                                                 
%W11606    'TEMP1-'                                                             
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE TEMPFIL2 FB(428 0) VIRTUAL                                                 
%W11606    'TEMP2-'                                                             
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE TEMPFIL3 FB(428 0) VIRTUAL                                                 
%W11606    'TEMP3-'                                                             
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  ARBETSFÄLT                          *                                        
* -------------------------------------*                                        
*                                                                               
 W-KDBBCL                 W  1 N                                                
 JA                       W  1 A   VALUE 'J'                                    
 NEJ                      W  1 A   VALUE 'N'                                    
 IX1                      W  2 N   VALUE 0                                      
                                                                                
*    --- VALID KDPRODSL                                                         
%WWPRODSL  'ART-CLAG-' WORK ''                                                  
*                                                                               
NEWPAGE                                                                         
*                                                                               
*------------------------------------------------------------------*            
* STEG 1. LÄSER ARTIKELDATA OCH BENÄMNINGAR                        *            
*         SKRIVER FIL TILL STEG 2                                  *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT (W11606D1 KEY (ART-CLAG-IDARTNR)                   +                  
           W11606D2 KEY (BEN-IDARTNR))                                          
                                                                                
 IF MATCHED                                                                     
    PERFORM S25-CHECK-ART-CLAG-KDPRODSL                                         
    IF ART-CLAG-FLLSRDEL   = JA            +                                    
    AND ART-CLAG-PRARTSTD  > 0             +                                    
    AND ART-CLAG-PRARTSJK  > 0             +                                    
    AND ART-CLAG-KDPRODSL NE KDPRODSL-LYNK                                      
       PERFORM AA-ARTIKELDATA                                                   
       PERFORM AB-BENAMNINGAR                                                   
       PUT TEMPFIL1                                                             
    END-IF                                                                      
 ELSE                                                                           
    IF W11606D1                                                                 
       PERFORM S25-CHECK-ART-CLAG-KDPRODSL                                      
       IF ART-CLAG-FLLSRDEL   = JA         +                                    
      AND ART-CLAG-PRARTSTD  > 0           +                                    
      AND ART-CLAG-PRARTSJK  > 0           +                                    
      AND ART-CLAG-KDPRODSL NE KDPRODSL-LYNK                                    
         PERFORM AA-ARTIKELDATA                                                 
         PERFORM AC-BLANK-BEN                                                   
         PUT TEMPFIL1                                                           
       END-IF                                                                   
    END-IF                                                                      
 END-IF                                                                         
%WWPRODSL 'ART-CLAG-' PROC ''                                                   
                                                                                
NEWPAGE                                                                         
                                                                                
 AA-ARTIKELDATA. PROC                                                           
       TEMP1-IDARTNR      =  ART-CLAG-IDARTNR                                   
       TEMP1-IDFKNGRP     =  ART-CLAG-IDFKNGRP                                  
       TEMP1-IDSTATNR (1) =  ART-CLAG-IDSTATNR (1)                              
       TEMP1-IDSTATNR (2) =  ART-CLAG-IDSTATNR (2)                              
       TEMP1-IDSTATNR (3) =  ART-CLAG-IDSTATNR (3)                              
       TEMP1-IDSTATNR (4) =  ART-CLAG-IDSTATNR (4)                              
       TEMP1-IDSTATNR (5) =  ART-CLAG-IDSTATNR (5)                              
       TEMP1-IDPROJ       =  ART-CLAG-IDPROJ                                    
       TEMP1-IDLEVNR      =  ART-CLAG-IDLEVNR                                   
       TEMP1-KDAGE        =  ART-CLAG-KDAGE                                     
       TEMP1-KDARTURS     =  ART-CLAG-KDARTURS                                  
       TEMP1-KDBBCL       =  0                                                  
       TEMP1-KDBPSR       =  ART-CLAG-KDBPSR                                    
       TEMP1-KDERS        =  ART-CLAG-KDERS                                     
       TEMP1-KDERS-UTG    =  ART-CLAG-KDERS-UTG                                 
       TEMP1-KDPRODSL     =  ART-CLAG-KDPRODSL                                  
       TEMP1-KDPSLLOC     =  ART-CLAG-KDPSLLOC                                  
       TEMP1-KDSORT       =  ART-CLAG-KDSORT                                    
       TEMP1-KDSRA        =  ART-CLAG-KDSRA                                     
       TEMP1-KDVSOP       =  ART-CLAG-KDVSOP                                    
       TEMP1-KVQPACK-0    =  ART-CLAG-KVQPACK-0                                 
       TEMP1-PRARTSJK     =  ART-CLAG-PRARTSJK                                  
       TEMP1-PRARTSTD     =  ART-CLAG-PRARTSTD                                  
       TEMP1-TIFINLV      =  ART-CLAG-TIFINLV                                   
       TEMP1-VLARTNTO     =  ART-CLAG-VLARTNTO                                  
       TEMP1-VKART        =  ART-CLAG-VKART                                     
       TEMP1-KDUART       =  ART-CLAG-KDUART                                    
       TEMP1-KDTIPPR      =  ART-CLAG-KDTIPPR                                   
       IF TEMP1-IDLEVNR = 'BQ2QA'                                               
          TEMP1-IDLEVNR = '1385 '                                               
       END-IF                                                                   
       IF TEMP1-IDLEVNR = 'D12YA'                                               
          TEMP1-IDLEVNR = '6414 '                                               
       END-IF                                                                   
       IF TEMP1-IDLEVNR = 'D0KLA'                                               
          TEMP1-IDLEVNR = '6916 '                                               
       END-IF                                                                   
       TEMP1-IDKAT(1)     =  ART-CLAG-IDKAT(1)                                  
       TEMP1-IDKAT(2)     =  ART-CLAG-IDKAT(2)                                  
       TEMP1-IDKAT(3)     =  ART-CLAG-IDKAT(3)                                  
       TEMP1-BELEVART     =  ' '                                                
       TEMP1-FLGEMFMC     =  ' '                                                
       TEMP1-IDPROJUP     =  ART-CLAG-IDPROJUP                                  
       TEMP1-TIERSDAT     =  ART-CLAG-TIERSDAT                                  
       TEMP1-TIURPROD     =  ART-CLAG-TIURPROD                                  
 END-PROC                                                                       
                                                                                
NEWPAGE                                                                         
                                                                                
 AB-BENAMNINGAR. PROC                                                           
       IX1 = 1                                                                  
       DO WHILE IX1 < 11                                                        
         TEMP1-BEART (IX1) = BEN-BEART (IX1)                                    
         TEMP1-IDSKYLT (IX1) = BEN-IDSKYLT (IX1)                                
         IX1 = IX1 + 1                                                          
       END-DO                                                                   
 END-PROC                                                                       
                                                                                
NEWPAGE                                                                         
                                                                                
 AC-BLANK-BEN. PROC                                                             
       IX1 = 1                                                                  
       DO WHILE IX1 < 11                                                        
         TEMP1-BEART (IX1)   = ' '                                              
         TEMP1-IDSKYLT (IX1) = ' '                                              
         IX1 = IX1 + 1                                                          
       END-DO                                                                   
 END-PROC                                                                       
                                                                                
NEWPAGE                                                                         
*------------------------------------------------------------------*            
* STEG 2. MATCHAR BUYBACK & TEMPFIL1 TILL TEMPFIL2                 *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT (TEMPFIL1 KEY(TEMP1-IDARTNR) W11606D3 KEY(BB-IDARTNR))                
                                                                                
    IF MATCHED                                                                  
        TEMP1-KDBBCL = BB-KDBBCL                                                
        PUT TEMPFIL2 FROM TEMPFIL1                                              
    ELSE                                                                        
        IF TEMPFIL1                                                             
            PUT TEMPFIL2 FROM TEMPFIL1                                          
        END-IF                                                                  
    END-IF                                                                      
                                                                                
NEWPAGE                                                                         
*------------------------------------------------------------------*            
* STEG 3. MATCHAR TEMP2 & CROSSFIL TILL TEMP3                      *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT (TEMPFIL2 KEY(TEMP2-IDARTNR) W11606D6 KEY(CROSS-IDARTNR))             
                                                                                
    IF MATCHED                                                                  
        TEMP2-BELEVART = CROSS-BELEVART                                         
        PUT TEMPFIL3 FROM TEMPFIL2                                              
    ELSE                                                                        
        IF TEMPFIL2                                                             
           PUT TEMPFIL3 FROM TEMPFIL2                                           
        END-IF                                                                  
    END-IF                                                                      
*                                                                               
NEWPAGE                                                                         
*------------------------------------------------------------------*            
* STEG 4. MATCHAR TEMP3 & FIL GEMENSAM ART. INFO VCC-KDP OCH FORD  *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT (TEMPFIL3 KEY(TEMP3-IDARTNR) W11606D5 KEY(MPNR-IDARTNR))              
                                                                                
    IF MATCHED                                                                  
        TEMP3-FLGEMFMC = MPNR-FLGEMFMC                                          
        PUT W11606D4 FROM TEMPFIL3                                              
    ELSE                                                                        
        IF TEMPFIL3                                                             
           PUT W11606D4 FROM TEMPFIL3                                           
        END-IF                                                                  
    END-IF                                                                      
*                                                                               
