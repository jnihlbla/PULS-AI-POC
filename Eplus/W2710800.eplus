                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2710800                                              *        
*                                                                      *        
*  FUNKTION   :  PROGRAMMET MATCHAR NY GRUNDFIL MED EN REGISTER        *        
*                FIL W27107. LETAR UPP ARTIKLAR SOM FÅTT ÄNDRAD        *        
*                ERSKOD.                                                        
*                00 > 05, 00 > 06, 00 > 09, 00 > 25, 00 > 26                    
*                05 > 25, 06 > 26                                               
*                SKRIVER FIL MED REFILLFÖRSLAG. DÅ ERS-                *        
*                ÄNDRINGEN GÄLLER FÖR SAMTLIGA LAGER GÖRS REFILL-     *         
*                FÖRSLAG ENDAST FÖR DET FÖRST PÅTRÄFFADE NDC T         *        
*                                                                      *        
*  FÖRFATTARE :  STEFAN KIHLBERG                                       *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W27108D1                                                                   
*                                                                               
%W01160                                                                         
                                                                                
NEWPAGE                                                                         
FILE W27108D2                                                                   
*                                                                               
%W27108   'OLD-'                                                                
                                                                                
NEWPAGE                                                                         
FILE TEMP VIRTUAL RETAIN FB(18 0)                                               
%W271081 'TEMP-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W27108D3                                                                   
*                                                                               
%W01184 'DC-'                                                                   
                                                                                
                                                                                
NEWPAGE                                                                         
FILE W27108D4 FB(058 0)                                                         
*                                                                               
%W27111  'W27109-'                                                              
                                                                                
NEWPAGE                                                                         
FILE W27108D5 FB(007 0)                                                         
*                                                                               
%W27108  'NEW-'                                                                 
                                                                                
                                                                                
  DAGENS-SYSDATE                       W   8  A                                 
  SYSDATE-TIAA        DAGENS-SYSDATE       2  N                                 
  SYSDATE-LINE1       DAGENS-SYSDATE   +2  1  A                                 
  SYSDATE-TIMM        DAGENS-SYSDATE   +3  2  N                                 
  SYSDATE-LINE2       DAGENS-SYSDATE   +5  1  A                                 
  SYSDATE-TIDD        DAGENS-SYSDATE   +6  2  N                                 
                                                                                
  DAGENS-DATUM                        W   6  N                                  
  DAGENS-TIAA         DAGENS-DATUM     2  N                                     
  DAGENS-TIMM         DAGENS-DATUM +2  2  N                                     
  DAGENS-TIDD         DAGENS-DATUM +4  2  N                                     
                                                                                
  ADART-NUM           W                  10  A                                  
  WS-ADLAGOMR         ADART-NUM           2  N                                  
  WS-ADGANG           ADART-NUM      +2   3  N                                  
  WS-ADPLATS          ADART-NUM      +5   5  N                                  
                                                                                
  NEXT-WORKDAY                        W   6  N                                  
                                                                                
NEWPAGE                                                                         
%WORKAREA                                                                       
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
  WS-IDDC              W  2  A                                                  
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. MATCHAR INFILER SKRIVER TEMFIL MED ARTIKLAR SOM FÅTT                  
*         VISSA FÖRÄNDRINGAR I ERSKOD SENASTE DYGNET                            
*                                                                               
    JOB INPUT (W27108D2 KEY (OLD-IDARTNR)            +                          
             W27108D1 KEY (CLAG-IDARTNR))            +                          
                                         NAME STEG01 +                          
    START(A-INIT)                                                               
    IF MATCHED                                                                  
       IF OLD-KDERS EQ 00 AND CLAG-KDERS NE 00                                  
          IF CLAG-KDERS EQ 05                                                   
             MOVE '18' TO TEMP-KDREFTXT                                         
             PERFORM TEMP                                                       
             PUT TEMP                                                           
          END-IF                                                                
          IF CLAG-KDERS EQ 06                                                   
             MOVE '19' TO TEMP-KDREFTXT                                         
             PERFORM TEMP                                                       
             PUT TEMP                                                           
          END-IF                                                                
          IF CLAG-KDERS EQ 25                                                   
             MOVE '21' TO TEMP-KDREFTXT                                         
             PERFORM TEMP                                                       
             PUT TEMP                                                           
          END-IF                                                                
          IF CLAG-KDERS EQ 26                                                   
             MOVE '22' TO TEMP-KDREFTXT                                         
             PERFORM TEMP                                                       
             PUT TEMP                                                           
          END-IF                                                                
       ELSE                                                                     
          IF OLD-KDERS EQ 05 AND CLAG-KDERS EQ 25                               
             MOVE '21' TO TEMP-KDREFTXT                                         
             PERFORM TEMP                                                       
             PUT TEMP                                                           
          ELSE                                                                  
             IF OLD-KDERS EQ 06 AND CLAG-KDERS EQ 26                            
                MOVE '22' TO TEMP-KDREFTXT                                      
                PERFORM TEMP                                                    
                PUT TEMP                                                        
             END-IF                                                             
          END-IF                                                                
                                                                                
       END-IF                                                                   
    END-IF                                                                      
                                                                                
    IF W27108D1                                                                 
       NEW-IDARTNR = CLAG-IDARTNR                                               
       NEW-KDERS   = CLAG-KDERS                                                 
       PUT W27108D5                                                             
    END-IF                                                                      
                                                                                
A-INIT. PROC                                                                    
                                                                                
  DAGENS-SYSDATE  = SYSDATE                                                     
  DAGENS-TIAA     = SYSDATE-TIAA                                                
  DAGENS-TIMM     = SYSDATE-TIMM                                                
  DAGENS-TIDD     = SYSDATE-TIDD                                                
                                                                                
  DAGENS-SYSDATE  = DAGENS-DATUM                                                
                                                                                
*    BERÄKNA NÄSTA ARBETSDAG                                                    
                                                                                
  WORK-TIAAMMDD-FOM    = DAGENS-DATUM                                           
  WORK-TIAAMMDD-TOM    = DAGENS-DATUM                                           
  WORK-KDCALL          = 003                                                    
  WORK-KVWORKD         = 0                                                      
  WORK-IDDC            = CDC-SE                                                 
                                                                                
  CALL WORKDAY             USING (WORK-KDCALL     +                             
                                  WORK-DATE-AREA  +                             
                                  WORK-KDSVAR)                                  
  IF WORK-KDSVAR EQ ' '                                                         
     NEXT-WORKDAY      = WORK-TIAAMMDD-NEXT-WORKDAY                             
  ELSE                                                                          
     NEXT-WORKDAY      = DAGENS-DATUM                                           
  END-IF                                                                        
                                                                                
END-PROC                                                                        
                                                                                
                                                                                
TEMP. PROC                                                                      
                                                                                
      TEMP-IDARTNR        = CLAG-IDARTNR                                        
      TEMP-IDANSK         = CLAG-IDANSK                                         
      TEMP-ADLAGOMR-CDC   = CLAG-ADLAGOMR                                       
      TEMP-ADGANG-CDC     = CLAG-ADGANG                                         
      TEMP-ADPLATS-CDC    = CLAG-ADPLATS                                        
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 2. MATCHAR TEMPFIL MED NDC FILER, REFILLFÖRSLAG LÄGGS                    
*         TILL DET FÖRST PÅTRÄFFADE NDC T DÄR ARTIKELN FINNS                    
*                                                                               
    JOB INPUT (TEMP KEY (TEMP-IDARTNR)      +                                   
             W27108D3 KEY (DC-SLAG-IDARTNR))        +                           
                                         NAME STEG02                            
                                                                                
    IF MATCHED                                                                  
       PERFORM SKRIV-W27109                                                     
       PUT W27108D4                                                             
    END-IF                                                                      
                                                                                
                                                                                
SKRIV-W27109. PROC                                                              
                                                                                
      WS-IDDC = DC-SLAG-IDDC                                                    
      PERFORM S23-CHECK-WS-IDDC                                                 
      W27109-IDPERSON-BUY   = DC-SLAG-IDPERSON-BUY                              
      IF DC-SLAG-FLFLYG     = 'J'                                               
         W27109-KDREFTYP    = 'A'                                               
      ELSE                                                                      
        WS-IDDC = DC-SLAG-IDDC-REF                                              
        PERFORM S23-CHECK-WS-IDDC                                               
        IF WS-IDDC NE '  '                                                      
           W27109-KDREFTYP  = 'B'                                               
        ELSE                                                                    
           W27109-KDREFTYP  = 'L'                                               
        END-IF                                                                  
      END-IF                                                                    
      W27109-IDARTNR        = TEMP-IDARTNR                                      
      W27109-IDDC           = DC-SLAG-IDDC                                      
      W27109-ADLAGOMR-CDC   = TEMP-ADLAGOMR-CDC                                 
      W27109-ADGANG-CDC     = TEMP-ADGANG-CDC                                   
      W27109-ADPLATS-CDC    = TEMP-ADPLATS-CDC                                  
      W27109-ADLAGOMR-SDC   = DC-SLAG-ADLAGOMR                                  
      W27109-ADGANG-SDC     = DC-SLAG-ADGANG                                    
      W27109-ADPLATS-SDC    = DC-SLAG-ADPLATS                                   
      MOVE ZEROES           TO W27109-IDDISTR                                   
      MOVE ZEROES           TO W27109-IDKUNDNR                                  
      MOVE ZEROES           TO W27109-KVBEART                                   
      W27109-KDREFORS       = 'P'                                               
      W27109-IDLEVNR        = DC-SLAG-IDLEVNR                                   
      W27109-KDREFTXT       = TEMP-KDREFTXT                                     
      MOVE ZEROES           TO W27109-KDFRAKT                                   
      MOVE ZEROES           TO W27109-KVBEART-CD                                
      MOVE ZEROES           TO W27109-ADLAGOMR-CD                               
      MOVE ZEROES           TO W27109-ADGANG-CD                                 
      MOVE ZEROES           TO W27109-ADPLATS-CD                                
      MOVE DC-SLAG-IDDC     TO W27109-IDDC-REF                                  
END-PROC                                                                        
NEWPAGE                                                                         
*    --- S23-CHECK-WS-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'WS-'                                                                   
NEWPAGE                                                                         
                                                                                
