NEWPAGE                                                                         
FILE W27151D1                                                                   
                                                                                
%W01184                                                                         
**                                                                              
FILE W27151D2                                                                   
%W01186     'L7-'                                                               
                                                                                
**                                                                              
FILE W27151D3                                                                   
%W01168                                                                         
                                                                                
**                                                                              
FILE W27151D4                                                                   
%W01160                                                                         
                                                                                
**                                                                              
FILE W27151D5                                                                   
%W01174     'BEN-'                                                              
                                                                                
**                                                                              
FILE W27151DX FB (39 0)                                                         
%W27151   'DC-'                                                                 
                                                                                
**                                                                              
FILE W27151DY FB (61 0)                                                         
%W27152   'CDC1-'                                                               
                                                                                
**                                                                              
FILE W27151DZ FB (61 0)                                                         
%W27152   'CDC2-'                                                               
                                                                                
NEWPAGE                                                                         
**                                                                              
* OVERSTOCK SDC                                                                 
FILE W27151D7  PRINTER FB (121 121)                                             
                                                                                
**                                                                              
* OVERSTOCK NDC ALL BUYERS                                                      
FILE W27151D8  PRINTER FB (121 121)                                             
                                                                                
**                                                                              
* OVERSTOCK NDC NA BUYERS                                                       
FILE W27151D9  PRINTER FB (121 121)                                             
                                                                                
**                                                                              
* PASSIV PARTS SDC                                                              
FILE W27151DA  PRINTER FB (121 121)                                             
                                                                                
**                                                                              
* PASSIV PARTS NDC ALL BUYERS                                                   
FILE W27151DB  PRINTER FB (121 121)                                             
                                                                                
**                                                                              
* PASSIV PARTS NDC NA BUYERS                                                    
FILE W27151DC  PRINTER FB (121 121)                                             
                                                                                
**                                                                              
* OVERSTOCK NDC JAPAN                                                           
FILE W27151DD  PRINTER FB (121 121)                                             
                                                                                
**                                                                              
* PASSIV PARTS NDC JAPAN                                                        
FILE W27151DE  PRINTER FB (121 121)                                             
                                                                                
**                                                                              
* OVERSTOCK NDC AUSTRALIEN                                                      
FILE W27151DF  PRINTER FB (121 121)                                             
                                                                                
**                                                                              
* PASSIV PARTS NDC AUSTRALIEN                                                   
FILE W27151DG  PRINTER FB (121 121)                                             
                                                                                
**                                                                              
* PASSIV PARTS LDC                                                              
FILE W27151DH  PRINTER FB (121 121)                                             
                                                                                
**                                                                              
* OVERSTOCK LDC                                                                 
FILE W27151DI  PRINTER FB (121 121)                                             
                                                                                
*****************                                                               
* ARBETSAREOR   *                                                               
*****************                                                               
                                                                                
*--------------------------*                                                    
* DATUMKORT                *                                                    
*--------------------------*                                                    
                                                                                
                                                                                
%WDATKORT 'DATKORT-'                                                            
                                                                                
                                                                                
  PROGRAM-NAMN          W  6 A   VALUE 'W27150'                                 
  DATUMKORT-ID          W  6 A   VALUE 'WDATUM'                                 
                                                                                
  DAGENS-DATUM        W                     6   N                               
  DAGENS-DATUM-AA     DAGENS-DATUM          2   N                               
  DAGENS-DATUM-MM     DAGENS-DATUM       +2 2   N                               
  DAGENS-DATUM-DD     DAGENS-DATUM       +4 2   N                               
                                                                                
  INNEV-AAVVD          W               5 N                                      
  INNEV-AA             INNEV-AAVVD     2 N                                      
  INNEV-VV             INNEV-AAVVD  +2 2 N                                      
  INNEV-D              INNEV-AAVVD  +4 1 N                                      
                                                                                
                                                                                
  IX               W  2 N                                                       
                                                                                
  WS-KVLS-DC       W  4 N                                                       
  WS-LAGERV-DC     W  8 N 2                                                     
  WS-VARDE-OL      W  8 N 2                                                     
  WS-FLARP         W  1 A                                                       
  WS-MINUS-ETT-AAR W  3 P                                                       
                                                                                
  UT-IDARTNR       W  9 N   MASK 'ZZZZZZZZ9'                                    
  UT-IDDC          W  2 A                                                       
  UT-BEART-ENG     W  9 A                                                       
  UT-PRARTSTD      W  7 N 2                                                     
  UT-KVPB-REF      W  4 N 1                                                     
  UT-KVOI-AR       W  4 N   MASK 'ZZZ9'                                         
  UT-KVLS-DC       W  4 N   MASK 'ZZZ9'                                         
  UT-LAGERV-DC     W  8 N 2                                                     
  UT-VARDE-OL      W  8 N 2                                                     
  UT-KDERS         W  2 N   MASK 'ZZ'                                           
  UT-DISP-CDC      W  5 N   MASK 'ZZZZ9'                                        
  UT-KVPB-TOT-CDC  W  6 N 1                                                     
  UT-KVMP          W  5 N   MASK 'ZZZZ9'                                        
  UT-IDANSK        W  3 N   MASK 'ZZ9'                                          
  UT-IDPERSON-BUY  W  3 N   MASK 'ZZ9'                                          
  UT-FLARP         W  1 A                                                       
  UT-TIFINLV       W  5 N   MASK 'ZZZZ9'                                        
                                                                                
%WY2000W2                                                                       
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
                                                                                
NEWPAGE                                                                         
                                                                                
***********                                                                     
*  JOB 1  *                                                                     
***********                                                                     
                                                                                
* STEG 1. MATCHAR GRUNDFILER FRÅN WDK7 OCH WDL7                                 
                                                                                
JOB INPUT(W27151D1 KEY (SLAG-IDARTNR SLAG-IDDC) +                               
          W27151D2 KEY (L7-DC-IDARTNR L7-DC-IDDC)) +                            
START(A-INIT)                                                                   
                                                                                
 IF MATCHED                                                                     
    PERFORM SKAPA-W27151DX                                                      
    PERFORM SUMMERA-OI                                                          
    PUT W27151DX                                                                
 ELSE                                                                           
    IF W27151D1                                                                 
       PERFORM SKAPA-W27151DX                                                   
       PUT W27151DX                                                             
    END-IF                                                                      
 END-IF                                                                         
                                                                                
                                                                                
SKAPA-W27151DX. PROC                                                            
                                                                                
 DC-IDARTNR           = SLAG-IDARTNR                                            
 DC-IDDC              = SLAG-IDDC                                               
 DC-KVPB-REF          = SLAG-KVPB-REF + SLAG-KVPBREOI                           
 DC-KVLS              = SLAG-KVLS                                               
 DC-KVREFOVL          = SLAG-KVREFOVL                                           
 DC-TIREFSTA          = SLAG-TIREFSTA                                           
 DC-KDREFSTA          = SLAG-KDREFSTA                                           
 DC-IDPERSON-BUY      = SLAG-IDPERSON-BUY                                       
 DC-IDANSK            = SLAG-IDANSK                                             
 DC-PRMATRL           = SLAG-PRMATRL                                            
END-PROC                                                                        
                                                                                
SUMMERA-OI. PROC                                                                
                                                                                
 IX = 1                                                                         
 MOVE ZERO TO DC-KVOI-AR                                                        
 DO WHILE IX LE 53                                                              
    DC-KVOI-AR = DC-KVOI-AR + L7-DC-KVOI-RULL (IX) +    +                       
                 L7-DC-KVOI-REF-RULL (IX)                                       
    IX = IX + 1                                                                 
 END-DO                                                                         
END-PROC                                                                        
                                                                                
                                                                                
A-INIT. PROC                                                                    
                                                                                
* HÄMTA INNEVARANDE ÅR                                                          
                                                                                
                                                                                
*  HÄMTA DATUM FRÅN DATKORT                                                     
                                                                                
   CALL DATKORT USING (PROGRAM-NAMN +                                           
                       DATUMKORT-ID +                                           
                       DATKORT-DATUMKORT)                                       
                                                                                
   MOVE DATKORT-D-AAR    TO DAGENS-DATUM-AA                                     
   MOVE DATKORT-D-MAANAD TO DAGENS-DATUM-MM                                     
   MOVE DATKORT-D-DAG    TO DAGENS-DATUM-DD                                     
                                                                                
   INNEV-AA       = DATKORT-D-AAR                                               
   INNEV-VV       = DATKORT-D-VECKA                                             
   INNEV-D        = 1                                                           
                                                                                
*  SKAPA LÄMFÖRELSE AAVV - ETT ÅR BAKÅT                                         
                                                                                
    IF INNEV-AA = 00                                                            
      WS-MINUS-ETT-AAR = (100000 + INNEV-AAVVD) - 1000                          
    ELSE                                                                        
      WS-MINUS-ETT-AAR = INNEV-AAVVD - 1000                                     
    END-IF                                                                      
 END-PROC                                                                       
                                                                                
**********                                                                      
* JOB 2  *                                                                      
**********                                                                      
*                                                                               
* STEG 2. MATCHAR CDC-UPPGIFTER MED OKS-UPPGIFTER                               
*                                                                               
                                                                                
JOB INPUT(W27151D4 KEY (CLAG-IDARTNR) +                                         
          W27151D3 KEY (ART-IDARTNR))                                           
                                                                                
  IF MATCHED                                                                    
     PERFORM SKAPA-W27151DY-FIL-MATCH                                           
     PUT W27151DY                                                               
  ELSE                                                                          
     IF  W27151D4                                                               
        PERFORM SKAPA-W27151DY-FIL-OMATCH                                       
        PUT W27151DY                                                            
     END-IF                                                                     
  END-IF                                                                        
                                                                                
                                                                                
 SKAPA-W27151DY-FIL-MATCH. PROC                                                 
                                                                                
    CDC1-IDARTNR      =  CLAG-IDARTNR                                           
    CDC1-PRARTSTD     =  CLAG-PRARTSTD                                          
    CDC1-TIFINLV      =  CLAG-TIFINLV                                           
    CDC1-IDLEVNR      =  CLAG-IDLEVNR                                           
    CDC1-KDERS        =  CLAG-KDERS                                             
    CDC1-KVMP         =  CLAG-KVMP                                              
    CDC1-IDANSK       =  CLAG-IDANSK                                            
    CDC1-KVDISP   = (CLAG-KVLS -      +                                         
                     CLAG-KVRESS -    +                                         
                     ART-KVOKS-DAG -  +                                         
                     ART-KVOKS-VOR -  +                                         
                     ART-KVOKS-BULK)                                            
    CDC1-KVPB-TOT =  CLAG-KVPB-SEP + CLAG-KVPB-SATS                             
                                                                                
 END-PROC                                                                       
                                                                                
 SKAPA-W27151DY-FIL-OMATCH. PROC                                                
                                                                                
    CDC1-IDARTNR      =  CLAG-IDARTNR                                           
    CDC1-PRARTSTD     =  CLAG-PRARTSTD                                          
    CDC1-TIFINLV      =  CLAG-TIFINLV                                           
    CDC1-IDLEVNR      =  CLAG-IDLEVNR                                           
    CDC1-KDERS        =  CLAG-KDERS                                             
    CDC1-KVMP         =  CLAG-KVMP                                              
    CDC1-IDANSK       =  CLAG-IDANSK                                            
    CDC1-KVDISP       = (CLAG-KVLS -      +                                     
                         CLAG-KVRESS)                                           
    CDC1-KVPB-TOT     =  CLAG-KVPB-SEP + CLAG-KVPB-SATS                         
                                                                                
 END-PROC                                                                       
                                                                                
**********                                                                      
* JOB 3  *                                                                      
**********                                                                      
*                                                                               
* STEG 3. MATCHAR CDC-UPPGIFTER MED UPPGIFTER FRÅN BEMÄMNINGSFIL                
*                                                                               
                                                                                
JOB INPUT(W27151DY KEY (CDC1-IDARTNR) +                                         
          W27151D5 KEY (BEN-IDARTNR))                                           
                                                                                
  IF MATCHED                                                                    
     PERFORM SKAPA-W27151DZ-FIL-MATCH                                           
     PUT W27151DZ                                                               
  ELSE                                                                          
     IF  W27151DY                                                               
        PERFORM SKAPA-W27151DZ-FIL-OMATCH                                       
        PUT W27151DZ                                                            
     END-IF                                                                     
  END-IF                                                                        
                                                                                
                                                                                
 SKAPA-W27151DZ-FIL-MATCH. PROC                                                 
                                                                                
    CDC2-IDARTNR  =  CDC1-IDARTNR                                               
    CDC2-KVDISP   =  CDC1-KVDISP                                                
    CDC2-PRARTSTD =  CDC1-PRARTSTD                                              
    CDC2-KVPB-TOT =  CDC1-KVPB-TOT                                              
    CDC2-TIFINLV  =  CDC1-TIFINLV                                               
    CDC2-IDLEVNR  =  CDC1-IDLEVNR                                               
    CDC2-KDERS    =  CDC1-KDERS                                                 
    CDC2-KVMP     =  CDC1-KVMP                                                  
    CDC2-IDANSK   =  CDC1-IDANSK                                                
    CDC2-BEART-ENG = BEN-BEART(4)                                               
                                                                                
 END-PROC                                                                       
                                                                                
 SKAPA-W27151DZ-FIL-OMATCH. PROC                                                
                                                                                
    CDC2-IDARTNR  =  CDC1-IDARTNR                                               
    CDC2-KVDISP   =  CDC1-KVDISP                                                
    CDC2-PRARTSTD =  CDC1-PRARTSTD                                              
    CDC2-KVPB-TOT =  CDC1-KVPB-TOT                                              
    CDC2-TIFINLV  =  CDC1-TIFINLV                                               
    CDC2-IDLEVNR  =  CDC1-IDLEVNR                                               
    CDC2-KDERS    =  CDC1-KDERS                                                 
    CDC2-KVMP     =  CDC1-KVMP                                                  
    CDC2-IDANSK   =  CDC1-IDANSK                                                
    MOVE SPACE TO CDC2-BEART-ENG                                                
                                                                                
 END-PROC                                                                       
                                                                                
*                                                                               
**********                                                                      
* JOB 4  *                                                                      
**********                                                                      
*                                                                               
* STEG 4. MATCHAR CDC-UPPGIFTER MED DC-UPPGIFTER                                
*                                                                               
                                                                                
JOB INPUT(W27151DZ KEY (CDC2-IDARTNR) +                                         
          W27151DX KEY (DC-IDARTNR))                                            
                                                                                
                                                                                
  IF MATCHED                                                                    
     PERFORM MATCH-W27151DX-W27151DZ                                            
  END-IF                                                                        
                                                                                
                                                                                
 MATCH-W27151DX-W27151DZ. PROC                                                  
                                                                                
    PERFORM NOLLSTALL-ARBETSFALT                                                
                                                                                
    TMP1-YYWWD = CDC2-TIFINLV                                                   
    TMP2-YYWWD = WS-MINUS-ETT-AAR                                               
    PERFORM WY2000P2                                                            
    IF TMP1-YYWWD > TMP2-YYWWD OR CDC2-IDLEVNR = '8261'                         
*        EJ ART ÖVER ETT ÅR ELLER BYTESOBJEKT                                   
                                                                                
    ELSE                                                                        
       PERFORM S23-CHECK-DC-IDDC                                                
       IF DC-KDREFSTA = 'A'                                                     
          IF DC-KVLS > DC-KVREFOVL                                              
             WS-LAGERV-DC = DC-KVLS * CDC2-PRARTSTD                             
             WS-VARDE-OL =                       +                              
                (DC-KVLS - DC-KVREFOVL) * CDC2-PRARTSTD                         
             IF DC-IDDC EQ NDC-CN                                               
               WS-LAGERV-DC = DC-KVLS * DC-PRMATRL                              
               WS-VARDE-OL =                     +                              
                  (DC-KVLS - DC-KVREFOVL) * DC-PRMATRL                          
             END-IF                                                             
             IF DC-IDDC EQ LDC-CN                                               
               WS-LAGERV-DC = DC-KVLS * DC-PRMATRL                              
               WS-VARDE-OL =                     +                              
                  (DC-KVLS - DC-KVREFOVL) * DC-PRMATRL                          
             END-IF                                                             
             IF DC-IDDC EQ NDC-NA                                               
               WS-LAGERV-DC = DC-KVLS * DC-PRMATRL                              
               WS-VARDE-OL =                     +                              
                  (DC-KVLS - DC-KVREFOVL) * DC-PRMATRL                          
             END-IF                                                             
             PERFORM FLYTTA-UTFALT                                              
             IF DC-IDDC EQ SDC                                                  
                PRINT OVERSTOCK-SDC-ALL-BUY                                     
             ELSE                                                               
                IF DC-IDDC EQ LDC                                               
                   PRINT OVERSTOCK-LDC-ALL-BUY                                  
                ELSE                                                            
                   IF DC-IDDC EQ NDC-JP                                         
                     PRINT OVERSTOCK-JAPAN                                      
                   ELSE                                                         
                     IF DC-IDDC EQ NDC-AU                                       
                       PRINT OVERSTOCK-AUSTRALIA                                
                     ELSE                                                       
                       IF DC-IDDC EQ NDC-NA                                     
                         PRINT OVERSTOCK-NDC-ALL-BUY                            
                         IF CDC2-IDPERSON-BUY GT 79                             
                            PRINT OVERSTOCK-NDC-NA-BUY                          
                         END-IF                                                 
                       END-IF                                                   
                     END-IF                                                     
                   END-IF                                                       
                END-IF                                                          
             END-IF                                                             
          END-IF                                                                
       ELSE                                                                     
          IF DC-KVLS > 0                                                        
             WS-LAGERV-DC = DC-KVLS * CDC2-PRARTSTD                             
             IF DC-IDDC EQ NDC-CN                                               
               WS-LAGERV-DC = DC-KVLS * DC-PRMATRL                              
             END-IF                                                             
             IF DC-IDDC EQ LDC-CN                                               
               WS-LAGERV-DC = DC-KVLS * DC-PRMATRL                              
             END-IF                                                             
             IF DC-IDDC EQ NDC-NA                                               
               WS-LAGERV-DC = DC-KVLS * DC-PRMATRL                              
             END-IF                                                             
             IF DC-TIREFSTA = DAGENS-DATUM                                      
               WS-FLARP = '*'                                                   
             ELSE                                                               
               WS-FLARP = ' '                                                   
             END-IF                                                             
             PERFORM FLYTTA-UTFALT                                              
             IF DC-IDDC EQ SDC                                                  
                PRINT PASSIV-SDC-ALL-BUY                                        
             ELSE                                                               
               IF DC-IDDC EQ LDC                                                
                  PRINT PASSIV-LDC-ALL-BUY                                      
               ELSE                                                             
                 IF DC-IDDC EQ NDC-JP                                           
                    PRINT PASSIV-JAPAN                                          
                 ELSE                                                           
                   IF DC-IDDC EQ NDC-AU                                         
                      PRINT PASSIV-AUSTRALIA                                    
                   ELSE                                                         
                     IF DC-IDDC EQ NDC-NA                                       
                       PRINT PASSIV-NDC-ALL-BUY                                 
                       IF CDC2-IDPERSON-BUY GT 79                               
                          PRINT PASSIV-NDC-NA-BUY                               
                       END-IF                                                   
                     END-IF                                                     
                   END-IF                                                       
                 END-IF                                                         
               END-IF                                                           
             END-IF                                                             
          END-IF                                                                
       END-IF                                                                   
    END-IF                                                                      
 END-PROC                                                                       
                                                                                
                                                                                
*                                                                               
 NOLLSTALL-ARBETSFALT. PROC                                                     
                                                                                
    MOVE ZERO TO WS-LAGERV-DC                                                   
    MOVE ZERO TO WS-VARDE-OL                                                    
                                                                                
    MOVE SPACE TO WS-FLARP                                                      
 END-PROC                                                                       
*    --- S23-CHECK-DC-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'DC-'                                                                   
*                                                                               
                                                                                
*                                                                               
 FLYTTA-UTFALT. PROC                                                            
                                                                                
    UT-IDARTNR            =     DC-IDARTNR                                      
    UT-IDDC               =     DC-IDDC                                         
    UT-BEART-ENG          =     CDC2-BEART-ENG                                  
    UT-KVPB-REF           =     DC-KVPB-REF                                     
    UT-KVOI-AR            =     DC-KVOI-AR                                      
    UT-KVLS-DC            =     DC-KVLS                                         
    UT-LAGERV-DC          =     WS-LAGERV-DC                                    
    UT-KDERS              =     CDC2-KDERS                                      
    UT-DISP-CDC           =     CDC2-KVDISP                                     
    UT-KVPB-TOT-CDC       =     CDC2-KVPB-TOT                                   
    UT-KVMP               =     CDC2-KVMP                                       
    UT-IDANSK             =     CDC2-IDANSK                                     
    UT-TIFINLV            =     CDC2-TIFINLV                                    
                                                                                
    IF DC-IDDC-REF = '71' +                                                     
    OR DC-IDDC-REF = '72' +                                                     
    OR DC-IDDC-REF = '73' +                                                     
    OR DC-IDDC-REF = '74' +                                                     
    OR DC-IDDC-REF = '41' +                                                     
    OR DC-IDDC-REF = '42' +                                                     
    OR DC-IDDC-REF = '43' +                                                     
    OR DC-IDDC-REF = '44' +                                                     
    OR DC-IDDC-REF = '45' +                                                     
    OR DC-IDDC-REF = '46' +                                                     
    OR DC-IDDC-REF = '47' +                                                     
    OR DC-IDDC-REF = '51'                                                       
      UT-IDANSK           =     DC-IDANSK                                       
    ELSE                                                                        
      UT-IDANSK           =     CDC2-IDANSK                                     
    END-IF                                                                      
                                                                                
    IF DC-IDDC EQ NDC-CN                                        +               
    OR DC-IDDC EQ LDC-CN                                        +               
    OR DC-IDDC EQ NDC-NA                                                        
      UT-PRARTSTD         =     DC-PRMATRL                                      
    ELSE                                                                        
      UT-PRARTSTD         =     CDC2-PRARTSTD                                   
    END-IF                                                                      
                                                                                
                                                                                
    UT-IDPERSON-BUY       =     DC-IDPERSON-BUY                                 
    CDC2-IDPERSON-BUY     =     DC-IDPERSON-BUY                                 
                                                                                
    UT-VARDE-OL           =     WS-VARDE-OL                                     
    UT-FLARP              =     WS-FLARP                                        
                                                                                
 END-PROC                                                                       
                                                                                
 NEWPAGE                                                                        
%WY2000P2                                                                       
*                                                                               
******************                                                              
*RAPPORTER       *                                                              
******************                                                              
                                                                                
REPORT OVERSTOCK-SDC-ALL-BUY                                    +               
       PRINTER W27151D7                                         +               
       LINESIZE 120 PAGESIZE 41                                 +               
       SPACE 1                                                                  
                                                                                
SEQUENCE UT-IDDC UT-VARDE-OL D  UT-IDARTNR                                      
                                                                                
CONTROL  UT-IDDC NEWPAGE RENUM NOPRINT                                          
                                                                                
SUM      UT-LAGERV-DC UT-VARDE-OL                                               
                                                                                
TITLE 1  '   '                                                                  
                                                                                
TITLE 2  'VOLVO CUSTOMER SERVICE    W27151-110           +                      
          OVERSTOCKLIST   SDC       ALL BUYERS '                                
TITLE 3  ' DC-WAREHOUSE ' UT-IDDC                                               
                                                                                
TITLE 4  ' '                                                                    
                                                                                
HEADING  UT-IDARTNR       ('PARTNO ')                                           
HEADING  UT-BEART-ENG     ('DESCR')                                             
HEADING  UT-PRARTSTD      ('PRICE')                                             
HEADING  UT-KVPB-REF      ('FC' ' DC')                                          
HEADING  UT-KVOI-AR       ('SALES' '12PER')                                     
HEADING  UT-KVLS-DC       ('AVAIL' ' DC')                                       
HEADING  UT-LAGERV-DC     ('STOCK-' 'VAL  DC')                                  
HEADING  UT-VARDE-OL      ('OVERST' 'VAL  DC')                                  
HEADING  UT-KDERS         ('SUP' 'CODE')                                        
HEADING  UT-DISP-CDC      ('AVAIL' 'CDC')                                       
HEADING  UT-KVPB-TOT-CDC  ('FC' 'CDC')                                          
HEADING  UT-KVMP          ('MP' 'CDC')                                          
HEADING  UT-IDANSK        ('PROC')                                              
HEADING  UT-TIFINLV       ('FIRST' 'WEEK')                                      
                                                                                
LINE 01  UT-IDARTNR      +                                                      
         UT-BEART-ENG    +                                                      
         UT-PRARTSTD     +                                                      
         UT-KVPB-REF     +                                                      
         UT-KVOI-AR      +                                                      
         UT-KVLS-DC      +                                                      
         UT-LAGERV-DC    +                                                      
         UT-VARDE-OL     +                                                      
         UT-KDERS        +                                                      
         UT-DISP-CDC     +                                                      
         UT-KVPB-TOT-CDC +                                                      
         UT-KVMP         +                                                      
         UT-IDANSK       +                                                      
         UT-TIFINLV                                                             
                                                                                
                                                                                
REPORT OVERSTOCK-LDC-ALL-BUY                                    +               
       PRINTER W27151DI                                         +               
