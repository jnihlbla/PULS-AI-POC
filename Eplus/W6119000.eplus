                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6119000                                              *        
*                                                                      *        
*  FUNKTION   :  LÄSER UT DAGENS INLEVERANSER MOT CROSSDOCKING.        *        
*                                                                      *        
*  FÖRFATTARE :  KENT JEBSEN                                           *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W61190D1                                                                   
%WCDCPART  'LB-'                                                                
                                                                                
FILE W61190D3 FB(5 0)                                                           
T1-IDARTNR  1 5 P                                                               
                                                                                
FILE W61190D2                                                                   
%W6111001  'IN-'                                                                
                                                                                
FILE W61190D4 FB(177 0)                                                         
%W6111001  'T2-'                                                                
                                                                                
FILE W61190D5  PRINTER FB (121 0)                                               
                                                                                
%WDATKORT  'DATKORT-'                                                           
NEWPAGE                                                                         
*                                                                               
%WDATAREA                                                                       
*                                                                               
PGM-NAMN    W  6  A  VALUE 'W61190'                                             
DATKORT-ID  W  6  A  VALUE 'WDATUM'                                             
*                                                                               
DAGENS-DATUM        W                     6   N                                 
DAGENS-DATUM-AA     DAGENS-DATUM          2   N                                 
DAGENS-DATUM-MM     DAGENS-DATUM       +2 2   N                                 
DAGENS-DATUM-DD     DAGENS-DATUM       +4 2   N                                 
                                                                                
WS-TIAAVVD          W                     5   N                                 
WS-AA               WS-TIAAVVD            2   N                                 
WS-VVD              WS-TIAAVVD         +2 3   N                                 
*                                                                               
                                                                                
WS-IDLOPNRM         W                     8   N                                 
WS-VVD-LOP          WS-IDLOPNRM           3   N                                 
WS-RESTEN           WS-IDLOPNRM        +3 5   N                                 
                                                                                
WS-ADTRDEST         W                     3   A                                 
WS-ADTRDEST-2POS    WS-ADTRDEST           2   A                                 
WS-RESTEN-DEST      WS-ADTRDEST        +2 1   A                                 
                                                                                
HELP-IDLOPNRM       W                     8   N  VALUE 0                        
                                                                                
UT-IDARTNR          W                     9   N  MASK 'ZZZZZZZZ9'               
UT-IDLOPNRM         W                     8   N  MASK 'ZZZZZZZ9'                
UT-KVAVIS           W                     7   N  MASK 'Z.ZZZ.ZZ9'               
UT-SLUT             W                     1   A                                 
*                                                                               
* STEG 1. SELEKTERAR CD-ARTIKLAR FRÅN SENASTE LAGERBANDET.                      
*                                                                               
JOB INPUT W61190D1  START A-INIT                                                
  IF LB-FLCDART = 'J'                                                           
    T1-IDARTNR = LB-IDARTNR                                                     
    PUT W61190D3                                                                
  END-IF                                                                        
                                                                                
*                                                                               
A-INIT. PROC                                                                    
   CALL DATKORT USING (PGM-NAMN DATKORT-ID DATKORT-DATUMKORT)                   
                                                                                
                                                                                
   DAGENS-DATUM-AA = DATKORT-D-AAR                                              
   DAGENS-DATUM-MM = DATKORT-D-MAANAD                                           
   DAGENS-DATUM-DD = DATKORT-D-DAG                                              
                                                                                
*  HÄMTA INNEVARANDE VVD                                                        
                                                                                
   DAT-I-TIDATUM = DAGENS-DATUM                                                 
   DAT-KDDATFORM = 'AAMMDD'                                                     
   CALL WDATKONV USING (DAT-KDDATFORM, +                                        
                        DAT-I-TIDATUM, +                                        
                        DAT-O-TIDATUM, +                                        
                        DAT-KDSVAR)                                             
   IF DAT-KDSVAR = ' '                                                          
      WS-TIAAVVD     = DAT-TIAAVVD                                              
   ELSE                                                                         
      DISPLAY 'FEL FRÅN DATKONV I A-INIT'                                       
      STOP EXECUTE                                                              
   END-IF                                                                       
END-PROC                                                                        
                                                                                
*                                                                               
* STEG 2. SELEKTERAR OCH SORTAR DAGENS INLEV                                    
*                                                                               
SORT W61190D2 TO +                                                              
     W61190D4 USING (IN-IDARTNR, IN-IDLOPNRM) BEFORE URVAL                      
*                                                                               
URVAL. PROC                                                                     
  IF IN-IDDC = '11'                                                             
    WS-IDLOPNRM = IN-IDLOPNRM                                                   
    WS-ADTRDEST = IN-ADTRDEST                                                   
    IF WS-VVD-LOP = WS-VVD AND WS-ADTRDEST-2POS = 'CD'                          
      SELECT                                                                    
    END-IF                                                                      
  END-IF                                                                        
END-PROC                                                                        
                                                                                
*                                                                               
* STEG 3. MATCHAR OCH SKRIVER DAGENS INLEVERANSER AV CD-ARTIKLAR                
*                                                                               
JOB INPUT (W61190D3 KEY T1-IDARTNR           +                                  
          W61190D4 KEY T2-IDARTNR)                                              
                                                                                
IF MATCHED                                                                      
  IF HELP-IDLOPNRM NE T2-IDLOPNRM                                               
    UT-IDARTNR  = T2-IDARTNR                                                    
    UT-IDLOPNRM = T2-IDLOPNRM                                                   
    UT-KVAVIS   = T2-KVAVIS                                                     
    UT-SLUT     = T2-FLKLAR                                                     
    PRINT W61190-001                                                            
    HELP-IDLOPNRM = T2-IDLOPNRM                                                 
  END-IF                                                                        
END-IF                                                                          
                                                                                
REPORT W61190-001  PRINTER W61190D5 LINESIZE 120 DTLCTL FIRST                   
TITLE 1  'VCCS   W61190-001   DAGENS INLEVERANSER AV CD-ARTIKLAR'               
HEADING  UT-IDARTNR   'ARTNR'                                                   
HEADING  UT-IDLOPNRM  'LÖPNR'                                                   
HEADING  UT-KVAVIS    'AVISERAT'                                                
HEADING  UT-SLUT      'AVSLUTAD'                                                
LINE  1  UT-IDARTNR  UT-IDLOPNRM UT-KVAVIS  UT-SLUT                             
