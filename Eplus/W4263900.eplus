*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W42639D1                                                                   
IN-IDPTYP       1   3  A                                                        
IN-DATA         4 395  A                                                        
*                                                                               
FILE W42639D2   FB(49 0)                                                        
%W4263901  'UT-'                                                                
*                                                                               
NEWPAGE                                                                         
%W6H701W                                                                        
                                                                                
NEWPAGE                                                                         
%W6H713W                                                                        
                                                                                
NEWPAGE                                                                         
%WDATKORT                                                                       
                                                                                
NEWPAGE                                                                         
PROGRAM-NAMN     W          6  A VALUE 'W42639'                                 
DATUMKORT-ID     W          6  A VALUE 'WDATUM'                                 
W-DATUM          W          6  N                                                
  W-AR           W-DATUM    2  N                                                
  W-MAN          W-DATUM +2 2  N                                                
  W-DAG          W-DATUM +4 2  N                                                
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
* STEP 1.  FILE WITH ADJUSTMENTS CONTROL REPORT                                 
*                                                                               
JOB INPUT W42639D1  START A-INIT                                                
                                                                                
  IF IN-IDPTYP = '701'                                                          
     KR-W6H701          = IN-DATA                                               
  ELSE                                                                          
    IF IN-IDPTYP = '713'                                                        
      JUST-W6H713       = IN-DATA                                               
      IF JUST-TIREGDAT  = W-DATUM                                               
                                                                                
        UT-FLANNULL     = KR-FLANNULL                                           
        UT-IDKR         = KR-IDKR                                               
        UT-IDFTG        = KR-IDFTG                                              
        UT-IDARTNR      = KR-IDARTNR                                            
        UT-IDDC         = KR-IDDC                                               
        UT-IDLOPNRM     = KR-IDLOPNRM                                           
                                                                                
        UT-KDKRJUST     = JUST-KDKRJUST                                         
        UT-KDKRSTA      = JUST-KDKRSTA                                          
        UT-KVARBTID     = JUST-KVARBTID                                         
        UT-KVART-RET    = JUST-KVART-RET                                        
        UT-KVART-SKROT  = JUST-KVART-SKROT                                      
        UT-KVART-SJUST  = JUST-KVART-SJUST                                      
        UT-SUMAT        = JUST-SUMAT                                            
        UT-SUOMK        = JUST-SUOMK                                            
        UT-TIREGDAT     = JUST-TIREGDAT                                         
                                                                                
        PUT W42639D2                                                            
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
A-INIT.  PROC                                                                   
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                      
  W-AR    = D-AAR                                                               
  W-MAN   = D-MAANAD                                                            
  W-DAG   = D-DAG                                                               
END-PROC                                                                        
