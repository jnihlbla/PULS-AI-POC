                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4635B00                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR W46356 (DESADV) MED W4635J (JUSTERINGSPOSTER) *        
*                ÄNDRAR KOLLITS BRUTTOVIKT ENLIGT JUSTERINGSFILEN      *        
*                UTFIL W4635B DESAVD MED JUSTERADE VIKTER              *        
*                                                                      *        
*  FÖRFATTARE :  GÖRAN KJELLSON                                        *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W4635BD1                                                                   
*                                                                               
%W46356    'IN-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W4635BD2                                                                   
*                                                                               
%W4635J    'ADJ-'                                                               
                                                                                
NEWPAGE                                                                         
FILE W4635BD3    FB (112 0)                                                     
*                                                                               
%W46356    'UT-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W4635BD4    FB (94 0)                                                      
*                                                                               
%W4635J    'DOP-'                                                               
                                                                                
NEWPAGE                                                                         
*                 WORKING STORAGE                                               
WS-IDPRODNR            W  7  N                                                  
WS-IDKOLLI             W  5  N                                                  
WS-VKORDBTO            W  7  N 1                                                
NEWPAGE                                                                         
*                                                                               
*                                                                               
* STEG 1. MATCHAR DESADV MED FIL MED JUSTERADE VIKTER                           
*                                                                               
JOB INPUT (W4635BD1 KEY (IN-IDLEVNR IN-IDPRODNR IN-IDKOLLI   +                  
                         IN-IDRADNR)  +                                         
           W4635BD2 KEY (ADJ-IDLEVNR ADJ-IDPRODNR ADJ-IDKOLLI +                 
                         ADJ-IDRADNR))                                          
*                                                                               
IF MATCHED                                                                      
  UT-W46356 = IN-W46356                                                         
  WS-IDPRODNR       = ADJ-IDPRODNR                                              
  WS-IDKOLLI        = ADJ-IDKOLLI                                               
  WS-VKORDBTO       = ADJ-VKORDBTO-KOLLI-ADJ                                    
  IF UT-VKORDBTO-KOLLI      = WS-VKORDBTO                                       
     UT-VKORDBTO-KOLLI      = WS-VKORDBTO + 0.1                                 
     ADJ-VKORDBTO-KOLLI-ADJ = ADJ-VKORDBTO-KOLLI-ADJ + 0.1                      
  ELSE                                                                          
     UT-VKORDBTO-KOLLI = WS-VKORDBTO                                            
  END-IF                                                                        
  PUT W4635BD3                                                                  
  PERFORM DOP-FIL                                                               
ELSE                                                                            
  IF W4635BD1                                                                   
     UT-W46356 = IN-W46356                                                      
     IF IN-IDPRODNR = WS-IDPRODNR AND +                                         
        IN-IDKOLLI  = WS-IDKOLLI                                                
        UT-VKORDBTO-KOLLI = WS-VKORDBTO                                         
     END-IF                                                                     
     PUT W4635BD3                                                               
  END-IF                                                                        
END-IF                                                                          
*                                                                               
DOP-FIL. PROC                                                                   
    DOP-IDPRODNR             = IN-IDPRODNR                                      
    DOP-IDSUPREF             = IN-IDSUPREF                                      
    DOP-DAREGDAT             = ADJ-DAREGDAT                                     
    DOP-IDLEVNR              = IN-IDLEVNR                                       
    DOP-IDDISTR              = IN-IDDISTR                                       
    DOP-IDKUNDNR             = IN-IDKUNDNR                                      
    DOP-IDORDNR7             = IN-IDORDNR7                                      
    DOP-IDDC                 = IN-IDDC                                          
    DOP-IDKOLLI              = IN-IDKOLLI                                       
    DOP-VKORDBTO-KOLLI       = IN-VKORDBTO-KOLLI                                
    DOP-VKORDBTO-KOLLI-ADJ   = ADJ-VKORDBTO-KOLLI-ADJ                           
    DOP-IDRADNR              = ADJ-IDRADNR                                      
    DOP-IDARTNR              = ADJ-IDARTNR                                      
    DOP-KVLEVART             = ADJ-KVLEVART                                     
    DOP-VKART                = ADJ-VKART                                        
    PUT W4635BD4                                                                
END-PROC.                                                                       
