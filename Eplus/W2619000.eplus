                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2619000                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR CDC OCH NDC-LAGERBAND OCH KOMPLETTERAR        *        
*                NDC MED LITE CDC-INFO                                 *        
*                                                                      *        
*  FÖRFATTARE :  INGER STENING                                         *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
                                                                                
FILE W26190D1                                                                   
%W01184                                                                         
                                                                                
FILE W26190D2                                                                   
%W01160                                                                         
                                                                                
                                                                                
FILE W26190D3 FB(130 0)                                                         
%W26190    'UT-'                                                                
                                                                                
*                                                                               
* STEG 1. MATCHA OCH SKAPA UTFIL                                                
*                                                                               
JOB INPUT (W26190D2 KEY (CLAG-IDARTNR) +                                        
           W26190D1 KEY (SLAG-IDARTNR))                                         
                                                                                
  IF MATCHED                                                                    
     IF CLAG-TIURPROD > +0   +                                                  
    AND SLAG-IDDC-REF = ' '                                                     
        UT-ADLAGOMR             = SLAG-ADLAGOMR                                 
        UT-ADPLATS              = CLAG-ADPLATS                                  
        UT-BEART                = ' '                                           
        UT-FLERS                = CLAG-FLERS                                    
        UT-FLIART               = CLAG-FLIART                                   
        UT-FLFKNPRI             = ' '                                           
        UT-FLSKROT-BEORD        = SLAG-FLSKROT-BEORD                            
        UT-IDANSK               = SLAG-IDANSK                                   
        UT-IDARTNR              = SLAG-IDARTNR                                  
        UT-IDDC                 = SLAG-IDDC                                     
        UT-IDFKNGRP             = CLAG-IDFKNGRP                                 
        UT-IDLEVNR              = SLAG-IDLEVNR                                  
        UT-KDERS                = CLAG-KDERS                                    
        UT-KDERS-UTG            = CLAG-KDERS-UTG                                
        UT-KDPRODSL             = CLAG-KDPRODSL                                 
        UT-KVAKS-PAV            = SLAG-KVAKS-PAV                                
        UT-KVAKS-SDC            = SLAG-KVAKS-SDC                                
        UT-KVLS                 = SLAG-KVLS                                     
        UT-KVOKS-BULK           = SLAG-KVOKS-BULK                               
        UT-KVOKS-DAG            = SLAG-KVOKS-DAG                                
        UT-KVRESS               = SLAG-KVRESS                                   
        UT-KVSLUTKP             = SLAG-KVSLUTKP                                 
        UT-KVSPANT              = SLAG-KVSPANT                                  
        UT-PRMATRL              = SLAG-PRMATRL                                  
        UT-REDIRLEV             = CLAG-REDIRLEV                                 
        UT-SULEVANT-RAAR        = +0                                            
        UT-SUTOTBV-FRAAR        = +0                                            
        UT-SUTOTBV-RAAR         = +0                                            
        UT-TISKROT-AUTO         = SLAG-TISKROT-AUTO                             
        UT-TISKROT-BEORD        = SLAG-TISKROT-BEORD                            
        UT-TIURPROD             = CLAG-TIURPROD                                 
        UT-TISLUTKP             = SLAG-TISLUTKP                                 
                                                                                
        PUT W26190D3                                                            
     END-IF                                                                     
  END-IF                                                                        
                                                                                
