                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W3350400                                              *        
*                                                                      *        
*  FUNKTION   :  SORTERAR INFIL PÅ ARTIKELNR OCH LÄGGER IHOP           *        
*                VÄRDEN I DE FALL ARTIKELNUMRET FÖREKOMMER MER         *        
*                ÄN EN GÅNG.                                           *        
*                                                                      *        
*                                                                      *        
*  FÖRFATTARE :  THOMAS LARSSON                                        *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W33504D1                                                                   
*                                                                               
%W33504  'IN-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE SORTFIL FB(54 0)                                                           
*                                                                               
%W33504  'SORT-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W33504D3 FB(54 0)                                                          
*                                                                               
%W33504  'UT-'                                                                  
                                                                                
NEWPAGE                                                                         
SPAR-IDARTNR  W    5   P  0                                                     
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
* STEG 1. SORTERAR PÅ ARTIKELNR                                                 
*                                                                               
SORT W33504D1 TO SORTFIL USING (IN-IDARTNR)  SIZE 999999                        
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 2. LÄGGER IHOP VÄRDEN OM DUBLETTER (ARTIKELNR)                           
*                                                                               
JOB INPUT SORTFIL  FINISH Z-FINIT                                               
                                                                                
                                                                                
  IF SORT-IDARTNR = SPAR-IDARTNR                                                
    PERFORM A-SUMMERA                                                           
  ELSE                                                                          
    IF RECORD-COUNT EQ 1                                                        
                                                                                
      SPAR-IDARTNR = SORT-IDARTNR                                               
      PERFORM B-NOLLSTAELL                                                      
      PERFORM A-SUMMERA                                                         
    ELSE                                                                        
      UT-IDARTNR = SPAR-IDARTNR                                                 
      PUT W33504D3                                                              
      PERFORM B-NOLLSTAELL                                                      
      SPAR-IDARTNR = SORT-IDARTNR                                               
      PERFORM A-SUMMERA                                                         
    END-IF                                                                      
  END-IF                                                                        
                                                                                
  A-SUMMERA.  PROC                                                              
                                                                                
    UT-KDARTRAB-A  = SORT-KDARTRAB-A + UT-KDARTRAB-A                            
    UT-PRARTBTO-MARK-A =  +                                                     
            SORT-PRARTBTO-MARK-A + UT-PRARTBTO-MARK-A                           
    UT-KDARTRAB-B  = SORT-KDARTRAB-B + UT-KDARTRAB-B                            
    UT-PRARTBTO-MARK-B =  +                                                     
            SORT-PRARTBTO-MARK-B + UT-PRARTBTO-MARK-B                           
    UT-KDARTRAB-C  = SORT-KDARTRAB-C + UT-KDARTRAB-C                            
    UT-PRARTBTO-MARK-C =  +                                                     
            SORT-PRARTBTO-MARK-C + UT-PRARTBTO-MARK-C                           
    UT-KDARTRAB-D  = SORT-KDARTRAB-D + UT-KDARTRAB-D                            
    UT-PRARTBTO-MARK-D =  +                                                     
            SORT-PRARTBTO-MARK-D + UT-PRARTBTO-MARK-D                           
    UT-KDARTRAB-E  = SORT-KDARTRAB-E + UT-KDARTRAB-E                            
    UT-PRARTBTO-MARK-E =  +                                                     
            SORT-PRARTBTO-MARK-E + UT-PRARTBTO-MARK-E                           
    UT-KDARTRAB-F  = SORT-KDARTRAB-F + UT-KDARTRAB-F                            
    UT-PRARTBTO-MARK-F = +                                                      
            SORT-PRARTBTO-MARK-F + UT-PRARTBTO-MARK-F                           
    UT-KDARTRAB-G  = SORT-KDARTRAB-G + UT-KDARTRAB-G                            
    UT-PRARTBTO-MARK-G = +                                                      
            SORT-PRARTBTO-MARK-G + UT-PRARTBTO-MARK-G                           
                                                                                
  END-PROC                                                                      
                                                                                
  B-NOLLSTAELL.  PROC                                                           
                                                                                
    UT-IDARTNR = 0                                                              
    UT-KDARTRAB-A = 0                                                           
    UT-PRARTBTO-MARK-A = 0                                                      
    UT-KDARTRAB-B = 0                                                           
    UT-PRARTBTO-MARK-B = 0                                                      
    UT-KDARTRAB-C = 0                                                           
    UT-PRARTBTO-MARK-C = 0                                                      
    UT-KDARTRAB-D = 0                                                           
    UT-PRARTBTO-MARK-D = 0                                                      
    UT-KDARTRAB-E = 0                                                           
    UT-PRARTBTO-MARK-E = 0                                                      
    UT-KDARTRAB-F = 0                                                           
    UT-PRARTBTO-MARK-F = 0                                                      
    UT-KDARTRAB-G = 0                                                           
    UT-PRARTBTO-MARK-G = 0                                                      
  END-PROC                                                                      
                                                                                
  Z-FINIT.  PROC                                                                
    UT-IDARTNR = SPAR-IDARTNR                                                   
    PUT W33504D3                                                                
  END-PROC                                                                      
                                                                                
