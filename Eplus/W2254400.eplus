                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2254400                                              *        
*                                                                      *        
*  FUNKTION   :  LISTA, ANTAL ARTIKLAR MED RESTORDER PER ANSKAFFARE    *        
*                                                                      *        
*  FÖRFATTARE :  STEFAN KIHLBERG                                       *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W22544D1                                                                   
**********                                                                      
*COPYTEXT*                                                                      
**********                                                                      
*                                                                               
%W22543    'IN-'                                                                
                                                                                
%W009W42  'SUB-'                                                                
                                                                                
FILE W22544D2   PRINTER FB(121 121)                                             
*                                                                               
UT-IDANSK              W    3   N     MASK '999'                                
UT-KVANTAL-RO          W    7   N     MASK (B  'ZZZZZZ9')                       
UT-KVANTAL-M-AK        W    7   N     MASK B                                    
UT-KVANTAL-M-AK-LEVB   W    7   N     MASK B                                    
UT-KVANTAL-M-TEXTB     W    7   N     MASK B                                    
UT-KVANTAL-EJ-TACKTA   W    7   N     MASK B                                    
                                                                                
BRYT-IDGRUPP           W    2   N                                               
                                                                                
UT-GRUPP-INTERVALL     W    7   A                                               
                                                                                
WS-PRO-EJ-T            W    4   N  1  MASK (C 'ZZ9.9')                          
WS-PRO-T               W    4   N  1  MASK C                                    
BS-PRO-EJ-T            W    4   N  1  MASK C                                    
BS-PRO-T               W    4   N  1  MASK C                                    
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
*********                                                                       
* JOB   *                                                                       
*********                                                                       
* STEG 1. LÄSER LISTFIL, SKRIVER LISTA                                          
*                                                                               
JOB INPUT W22544D1                                                              
                                                                                
SUB-IDANSK             = IN-IDANSK                                              
CALL W200ANSK USING SUB-W009W42                                                 
UT-GRUPP-INTERVALL     = SUB-GRUPP-INTERVALL                                    
BRYT-IDGRUPP           = SUB-IDGRUPP                                            
UT-IDANSK              = IN-IDANSK                                              
UT-KVANTAL-RO          = IN-KVANTAL-RO                                          
UT-KVANTAL-M-AK        = IN-KVANTAL-M-AK                                        
UT-KVANTAL-M-AK-LEVB   = IN-KVANTAL-M-AK-LEVB                                   
UT-KVANTAL-M-TEXTB     = IN-KVANTAL-M-TEXTB                                     
UT-KVANTAL-EJ-TACKTA   = IN-KVANTAL-EJ-TACKTA                                   
                                                                                
  IF UT-KVANTAL-RO > 0                                                          
     WS-PRO-EJ-T   = 100 * UT-KVANTAL-EJ-TACKTA / UT-KVANTAL-RO + 0.05          
     WS-PRO-T      = 100 - WS-PRO-EJ-T                                          
  ELSE                                                                          
     WS-PRO-EJ-T   = 0                                                          
     WS-PRO-T      = 0                                                          
  END-IF                                                                        
                                                                                
PRINT RO-RAPPORT                                                                
                                                                                
*********                                                                       
*REPORT *                                                                       
*********                                                                       
*                                                                               
                                                                                
  REPORT RO-RAPPORT                                   +                         
         PRINTER W22544D2                             +                         
         LINESIZE 120                                 +                         
         PAGESIZE 41                                  +                         
         TITLESKIP 2                                  +                         
         SKIP 1                                       +                         
         SPACE 0                                      +                         
         NOHEADING                                    +                         
         NOADJUST                                     +                         
         DTLCTL FIRST                                 +                         
         SUMCTL ALL                                                             
                                                                                
   CONTROL FINAL NOPRINT                               +                        
           BRYT-IDGRUPP   NEWPAGE RENUM                                         
                                                                                
   SUM     IN-KVANTAL-RO                               +                        
           IN-KVANTAL-M-AK                             +                        
           IN-KVANTAL-M-AK-LEVB                        +                        
           IN-KVANTAL-EJ-TACKTA                        +                        
           IN-KVANTAL-M-TEXTB                                                   
                                                                                
   TITLE 1  COL 001 ' '                                                         
                                                                                
   TITLE 2  COL 001 'VOLVO CAR AFTERSALES'             +                        
            COL 060 'W22544-001'                                                
                                                                                
   TITLE 3  COL 001 ' '                                                         
                                                                                
   TITLE 4  COL 040 'RESTORDER'                                                 
                                                                                
   TITLE 5  COL 020 'TÄCKTA / EJ TÄCKTA RESTORDER PER ANSKAFFARE' +             
            COL 080 'ANSKAFFARE '                                 +             
            COL 092 UT-GRUPP-INTERVALL                                          
                                                                                
   TITLE 6  COL 001 ' '                                                         
                                                                                
   TITLE 7  COL 003 'ANSK'                     +                                
            COL 010 'ANTAL ARTIKLAR'           +                                
            COL 027 'ANTAL ARTIKLAR'           +                                
            COL 044 'ANTAL ARTIKLAR'           +                                
            COL 064 'ANTAL ARTIKLAR'           +                                
            COL 081 'ANTAL ARTIKLAR'           +                                
            COL 103 'PROCENT'                  +                                
            COL 113 'PROCENT'                                                   
                                                                                
   TITLE 8  COL 010 'MED-RO'                   +                                
            COL 027 'TÄCKTA M AK'              +                                
            COL 044 'TÄCKTA M AK + LEVB'       +                                
            COL 064 'MED TEXTBESKED'           +                                
            COL 081 'EJ TÄCKTA'                +                                
            COL 103 'TÄCKTA'                   +                                
            COL 111 'EJ TÄCKTA'                                                 
                                                                                
   LINE 1   COL 004 UT-IDANSK                  +                                
            COL 017 UT-KVANTAL-RO              +                                
            COL 034 UT-KVANTAL-M-AK            +                                
            COL 055 UT-KVANTAL-M-AK-LEVB       +                                
            COL 071 UT-KVANTAL-M-TEXTB         +                                
            COL 088 UT-KVANTAL-EJ-TACKTA       +                                
            COL 105 WS-PRO-T                   +                                
            COL 115 WS-PRO-EJ-T                                                 
                                                                                
AFTER-BREAK. PROC                                                               
  IF IN-KVANTAL-RO > 0                                                          
     BS-PRO-EJ-T   = 100 * IN-KVANTAL-EJ-TACKTA / IN-KVANTAL-RO + 0.05          
     BS-PRO-T      = 100 - BS-PRO-EJ-T                                          
  ELSE                                                                          
     BS-PRO-EJ-T   = 0                                                          
     BS-PRO-T      = 0                                                          
  END-IF                                                                        
  DISPLAY '  '                                                                  
  DISPLAY COL 012 IN-KVANTAL-RO                +                                
          COL 029 IN-KVANTAL-M-AK              +                                
          COL 050 IN-KVANTAL-M-AK-LEVB         +                                
          COL 066 IN-KVANTAL-M-TEXTB           +                                
          COL 083 IN-KVANTAL-EJ-TACKTA         +                                
          COL 105 BS-PRO-T                     +                                
          COL 115 BS-PRO-EJ-T                                                   
END-PROC                                                                        
