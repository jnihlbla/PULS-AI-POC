                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6131100                                              *        
*                                                                      *        
*  FUNKTION   :  LÄSER W61110-FIL(NEDLÄSNING AV W6D1), SELEKTERAR      *        
*                VECKANS INLEVERANSER.                                 *        
*                RÄKNAR P32:OR SÅVIDA DET INTE FINNS NÅGOT UTTAGET TILL*        
*                SATS. PARTIER MED SATSANTAL RÄKNAS ISTÄLLET HELA      *        
*                ANTALET PÅ DEN VECKA DÅ PARTIET R32-RAPPORTERAS.      *        
*                                                                      *        
*  FÖRFATTARE :  KENT JEBSEN                                           *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W61311D1                                                                   
%W6111001  'IN-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W61311D2 FB(177 0)                                                         
%W6111001  'UT-'                                                                
                                                                                
NEWPAGE                                                                         
%WDATAREA                                                                       
NEWPAGE                                                                         
                                                                                
JA              W 1 A VALUE 'J'                                                 
NEJ             W 1 A VALUE 'N'                                                 
*                                                                               
WDATKONV        W 8 A VALUE 'WDATKONV'                                          
                                                                                
DAGENS-DATUM             W 6 N                                                  
WS-FIRSTDAY              W 6 N                                                  
WS-KVINLART              W 4 P 0                                                
FL-SKRIV                 W 1 A  VALUE 'N'                                       
                                                                                
SPAR-IDLEVNR             W 5 A                                                  
SPAR-IDFS                W 8 A                                                  
SPAR-TIAVIDAT            W 4 P 0                                                
SPAR-IDRADNR-INL         W 3 P 0                                                
*                                                                               
DATUM                    W 8 A                                                  
D-AA         DATUM         2 N                                                  
D-1          DATUM +2      1 A                                                  
D-MM         DATUM +3      2 N                                                  
D-2          DATUM +5      1 A                                                  
D-DD         DATUM +6      2 N                                                  
*                                                                               
DATUM-FIX                W 6 N                                                  
D-AA-FIX  DATUM-FIX        2 N                                                  
D-MM-FIX  DATUM-FIX +2     2 N                                                  
D-DD-FIX  DATUM-FIX +4     2 N                                                  
*                                                                               
DATUM-FIX2               W 5 N                                                  
D-AAVV-FIX  DATUM-FIX2     4 A                                                  
D-D-FIX     DATUM-FIX2 +4  1 A                                                  
*                                                                               
*    --- VALID IDDC CODES                                                       
%WWDC99                                                                         
*                                                                               
JOB INPUT W61311D1 START A-INIT FINISH Z-FINISH                                 
                                                                                
IF IN-IDDC = CDC-SE NDC-CN                                                      
  IF IN-KVAVIS-KIT > 0 AND IN-FLKLAR = JA AND IN-FLANNULL = NEJ AND +           
    (IN-ART-TIUPPDAT = WS-FIRSTDAY OR IN-ART-TIUPPDAT > WS-FIRSTDAY)            
** VID SATSUTTAG RÄKNAS HELA PARTIETS ANTAL SAMMA VECKA SOM PARTIET             
** R32-RAPPORTERATS.                                                            
** FÖR ÖVRIGA PARTIER RÄKNAS P32:OR (DELINLÄGGNINGAR).                          
    IF SPAR-IDLEVNR = IN-IDLEVNR AND SPAR-IDFS = IN-IDFS AND +                  
       SPAR-TIAVIDAT = IN-TIAVIDAT                       AND +                  
       SPAR-IDRADNR-INL = IN-IDRADNR-INL                                        
      IF IN-KDINLSTA = 'INL'                                                    
        UT-W61110       = IN-W61110                                             
        UT-RAD-TIUPPDAT = IN-ART-TIUPPDAT                                       
        FL-SKRIV = JA                                                           
        WS-KVINLART = WS-KVINLART + IN-KVINLART                                 
      END-IF                                                                    
    ELSE                                                                        
      IF FL-SKRIV = JA                                                          
        UT-KVINLART = WS-KVINLART                                               
        PUT W61311D2                                                            
      END-IF                                                                    
      IF IN-KDINLSTA = 'INL'                                                    
        SPAR-IDLEVNR     = IN-IDLEVNR                                           
        SPAR-IDFS        = IN-IDFS                                              
        SPAR-TIAVIDAT    = IN-TIAVIDAT                                          
        SPAR-IDRADNR-INL = IN-IDRADNR-INL                                       
        UT-W61110        = IN-W61110                                            
        WS-KVINLART      = IN-KVINLART                                          
        FL-SKRIV         = JA                                                   
      END-IF                                                                    
    END-IF                                                                      
  ELSE                                                                          
    IF FL-SKRIV = JA                                                            
      UT-KVINLART = WS-KVINLART                                                 
      PUT W61311D2                                                              
      FL-SKRIV = NEJ                                                            
    END-IF                                                                      
    IF IN-KDINLSTA = 'INL' AND IN-FLANNULL = NEJ                                
      IF IN-RAD-TIUPPDAT = WS-FIRSTDAY  OR +                                    
         IN-RAD-TIUPPDAT > WS-FIRSTDAY                                          
         UT-W61110 = IN-W61110                                                  
         WS-KVINLART     = IN-KVINLART                                          
         FL-SKRIV        = JA                                                   
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
*                                                                               
A-INIT. PROC                                                                    
                                                                                
  DATUM         = SYSDATE                                                       
  D-AA-FIX      = D-AA                                                          
  D-MM-FIX      = D-MM                                                          
  D-DD-FIX      = D-DD                                                          
  DAGENS-DATUM  = DATUM-FIX                                                     
                                                                                
  DAT-KDDATFORM = 'AAMMDD'                                                      
  DAT-I-TIDATUM = DAGENS-DATUM                                                  
                                                                                
  CALL WDATKONV USING (DAT-KDDATFORM, +                                         
                       DAT-I-TIDATUM, +                                         
                       DAT-O-TIDATUM, +                                         
                       DAT-KDSVAR)                                              
                                                                                
  IF DAT-KDSVAR = ' '                                                           
    DAT-KDDATFORM = 'AAVVD'                                                     
    D-AAVV-FIX    = DAT-TIAAVV-GRP                                              
    D-D-FIX       = '1'                                                         
    DAT-I-TIDATUM = DATUM-FIX2                                                  
                                                                                
** TAR REDA PÅ DATUM FRÅN VECKANS FÖRSTA DAG                                    
    CALL WDATKONV USING (DAT-KDDATFORM, +                                       
                         DAT-I-TIDATUM, +                                       
                         DAT-O-TIDATUM, +                                       
                         DAT-KDSVAR)                                            
                                                                                
    IF DAT-KDSVAR = ' '                                                         
      WS-FIRSTDAY = DAT-TIAAMMDD                                                
    ELSE                                                                        
      DISPLAY 'FEL FRÅN DATKONV-2'                                              
      STOP EXECUTE                                                              
    END-IF                                                                      
  ELSE                                                                          
    DISPLAY 'FEL FRÅN DATKONV'                                                  
    STOP EXECUTE                                                                
  END-IF                                                                        
END-PROC                                                                        
                                                                                
Z-FINISH. PROC                                                                  
  IF FL-SKRIV = JA                                                              
    UT-KVINLART = WS-KVINLART                                                   
    PUT W61311D2                                                                
  END-IF                                                                        
END-PROC                                                                        
