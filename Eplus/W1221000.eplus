    HEADING W-KVLS               ('     LS')                                    
    HEADING W-KVAKS              ('     AK')                                    
    HEADING W-KVROS              ('  ROS')                                      
    HEADING W-KVRESS             ('  RESS')                                     
    HEADING W-KVEFSR             ('  EFRS')                                     
    HEADING W-SUTPO-TOT          ('   TPO')                                     
    HEADING W-FLERS              ('FL-' 'ERS')                                  
    HEADING W-SALDO-SDC-1        ('SDC')                                        
    HEADING W-SALDO-NDC-2        ('NDC')                                        
    HEADING W-SALDO-LDC-3        ('LDC')                                        
    HEADING W-FLDISC             ('DISC')                                       
    LINE  COL 02 W-FLERS COL 07 W-KDPRODSL  COL 12 W-IDANSK   COL 16 +          
             W-IDARTNR   COL 27 W-IDLEVNR   COL 34 W-KVBR     COL 42 +          
             W-KDERS     COL 46 W-KVLS      COL 55 W-KVAKS    COL 63 +          
             W-KVROS     COL 71 W-KVRESS    COL 79 W-KVEFSR   COL 88 +          
             W-SUTPO-TOT +                                                      
