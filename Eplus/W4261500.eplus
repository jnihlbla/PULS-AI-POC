                                                                                
*    PROGRAMNAMN:W4261500                                       *               
*                                                               *               
*    UTFÄRDARE: ANNELIE ENGLUND           DATUM: 931008         *               
*    KORT BESKRIVNING: ERSATTA ARTIKLAR MED KONTROLLKOD         *               
*                      OCH/ELLER DOKUMENTPLACERING  -  KVALITET *               
*                                                               *               
                                                                                
FILE W42615D1                                                                   
%W4261501 'IN-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W42615D2  PRINTER FB (121 121)                                             
*                                                                               
001-IDARTNR            W  9 N   MASK 'ZZZZZZZZ9' HEADING 'ARTIKELNR'            
001-BEART              W 20 A   HEADING 'BENÄMNING'                             
001-IDFKNGRP           W  5 N   MASK 'ZZZZ9'     HEADING 'FUNKTIONSGRP'         
001-KDKVAKTL           W  4 A   HEADING 'KONTROLLKOD'                           
001-ADKVAULG           W  2 A   HEADING 'DOKUMENTPLAC'                          
001-TIERSDAT           W  5 N   MASK 'ZZZZ9' HEADING 'ERS.DATUM'                
001-KDERS              W  3 N   MASK 'ZZ9'   HEADING 'ERS.KOD'                  
*                                                                               
NEWPAGE                                                                         
FILE W42615D3  PRINTER FB (121 121)                                             
*                                                                               
002-IDARTNR            W  9 N   MASK 'ZZZZZZZZ9' HEADING 'ARTIKELNR'            
002-BEART              W 20 A   HEADING 'BENÄMNING'                             
002-IDFKNGRP           W  5 N   MASK 'ZZZZ9'     HEADING 'FUNKTIONSGRP'         
002-KDKVAKTL           W  4 A   HEADING 'KONTROLLKOD'                           
002-ADKVAULG           W  2 A   HEADING 'DOKUMENTPLAC'                          
002-TIERSDAT           W  5 N   MASK 'ZZZZ9' HEADING 'ERS.DATUM'                
002-KDERS              W  3 N   MASK 'ZZ9'   HEADING 'ERS.KOD'                  
*                                                                               
NEWPAGE                                                                         
*                                                                               
%WDATKORT                                                                       
*                                                                               
PROGRAM-NAMN       W  6  A  VALUE 'W42615'                                      
DATUMKORT-ID       W  6  A  VALUE 'WDATUM'                                      
W-IDARTNR          W  9  N  MASK 'ZZZZZZZZ9'                                    
W-IDFKNGRP         W  5  N  MASK 'ZZZZ9'                                        
W-TIERSDAT         W  5  N  MASK 'ZZZZ9'                                        
W-BEART            W 20  A  VALUE '                    '                        
FG-IDARTNR         W  5  P 0 VALUE +0                                           
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*  STEG 1                                                                       
SORT W42615D1 TO +                                                              
     W42615D1 USING (IN-IDARTNR)                                                
NEWPAGE                                                                         
*  STEG 2                                                                       
JOB INPUT W42615D1 START A-INIT                                                 
                                                                                
    IF IN-KDERS > 20                                                            
      IF IN-KDKVAKTL > '0000' OR                                       +        
         IN-ADKVAULG > '00'                                                     
       IF IN-IDARTNR NE FG-IDARTNR                                              
        FG-IDARTNR = IN-IDARTNR                                                 
        W-IDARTNR = IN-IDARTNR                                                  
        W-IDFKNGRP = IN-IDFKNGRP                                                
        W-TIERSDAT = IN-TIERSDAT                                                
        W-BEART    = IN-BEART                                                   
         IF IN-IDFKNGRP < 4999                                                  
           001-ADKVAULG = IN-ADKVAULG                                           
           001-IDARTNR  = W-IDARTNR                                             
           001-BEART    = W-BEART                                               
           001-IDFKNGRP = W-IDFKNGRP                                            
           001-KDKVAKTL = IN-KDKVAKTL                                           
           001-TIERSDAT = W-TIERSDAT                                            
           001-KDERS    = IN-KDERS                                              
           PRINT W42615-001                                                     
         ELSE                                                                   
           002-ADKVAULG = IN-ADKVAULG                                           
           002-IDARTNR  = W-IDARTNR                                             
           002-BEART    = W-BEART                                               
           002-IDFKNGRP = W-IDFKNGRP                                            
           002-KDKVAKTL = IN-KDKVAKTL                                           
           002-TIERSDAT = W-TIERSDAT                                            
           002-KDERS    = IN-KDERS                                              
           PRINT W42615-002                                                     
         END-IF                                                                 
       END-IF                                                                   
      END-IF                                                                    
    END-IF                                                                      
*                                                                               
 A-INIT.  PROC                                                                  
     CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                   
 END-PROC                                                                       
*                                                                               
NEWPAGE                                                                         
REPORT   W42615-001 PRINTER W42615D2 LINESIZE 120 DTLCTL FIRST +                
         SUMCTL NONE SPACE 3                                                    
TITLE 1  'VOLVO CAR AFTERSALES AB   ERSATTA ARTIKLAR  W42615-001'               
TITLE 2  'ERSATTA ARTIKLAR MED KONTROLLKOD OCH/ELLER DOKUMENTPLAC+              
         ERING'                                                                 
TITLE 3  'FUNKTIONSGRUPP 0 - 4999'                                              
LINE  1  001-IDARTNR 001-BEART 001-IDFKNGRP 001-KDKVAKTL +                      
         001-ADKVAULG 001-TIERSDAT 001-KDERS                                    
                                                                                
NEWPAGE                                                                         
                                                                                
REPORT   W42615-002 PRINTER W42615D3 LINESIZE 120 DTLCTL FIRST +                
         SUMCTL NONE SPACE 3                                                    
TITLE 1  'VOLVO CAR AFTERSALES AB   ERSATTA ARTIKLAR  W42615-002'               
TITLE 2  'ERSATTA ARTIKLAR MED KONTROLLKOD OCH/ELLER DOKUMENTPLAC+              
         ERING'                                                                 
TITLE 3  'FUNKTIONSGRUPP 5000 - 9999'                                           
LINE  1  002-IDARTNR 002-BEART 002-IDFKNGRP 002-KDKVAKTL +                      
         002-ADKVAULG 002-TIERSDAT 002-KDERS                                    
