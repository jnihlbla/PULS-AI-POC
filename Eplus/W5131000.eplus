                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W513   SUMMERAD POSTER FÖR INV LISTOR                 *        
*                FREKVENS, VECKOSLUT.                                  *        
*                                                                      *        
*  FUNKTION   :  LÄSER POSTER FRÅN W51068 OCH SKAPAR SUMMERADE POSTER  *        
*                                                                      *        
*  FÖRFATTARE :  MARKUS ASPFJÄLL                                       *        
*                                                                      *        
*  INFILER    :  W513.W513V1.W51310 (DAGFILER FRÅN W51068)             *        
*  INFILER    :  W011.W01172        (LAGERBAND WDK6      )             *        
*  INFILER    :  W011.DCXX.W01184   (LAGERBAND LDC       )             *        
*                                                                      *        
*  UTDATA     :  FIL W51312                                            *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W51310D1                                                                   
*                                                                               
%W51310   'INV-'                                                                
                                                                                
FILE W51310D2                                                                   
*                                                                               
%W011100  'LB1-'                                                                
                                                                                
FILE W51310D3                                                                   
*                                                                               
%W01184   'LB2-'                                                                
                                                                                
FILE TPFIL1   FB(28 0)                                                          
%W51310   'TP1-'                                                                
                                                                                
FILE TPFIL2   FB(28 0)                                                          
TP2-IDDC        1  2  A                                                         
TP2-ADLAGOMR    3  2  N                                                         
TP2-IDARTNR     6  9  N                                                         
                                                                                
FILE TPFIL3   FB(28 0)                                                          
%W51310   'TP3-'                                                                
                                                                                
FILE W51310D4  FB (28 0)                                                        
%W51310   'UT-'                                                                 
                                                                                
* ARBETS-AREOR                                                                  
*                                                                               
TRANS-TIAAVV            W   4   N                                               
TRANS-TIVV TRANS-TIAAVV +2  2   N                                               
                                                                                
W-TIMM        W   2  A                                                          
W-TIVV        W   2  N                                                          
W-KDMARK      W   3  N                                                          
W-SUARTFSG    W  11  N  2                                                       
W-SUBV        W  11  N  2                                                       
                                                                                
W-SUARTFSG-E  W  11  N  2                                                       
W-SUBV-E      W  11  N  2                                                       
FIRST-POST    W   1  A  VALUE 'J'                                               
                                                                                
W-SUARTFSG1                 W   11 N 2                                          
W-SUARTFSG-HEL W-SUARTFSG1       9 N                                            
W-SUARTFSG-DEC W-SUARTFSG1  +9   2 N                                            
                                                                                
W-SUBV1                     W   11 N 2                                          
W-SUBV-HEL     W-SUBV1           9 N                                            
W-SUBV-DEC     W-SUBV1     +9    2 N                                            
                                                                                
W-FORSTA-POST  W 1 A                                                            
*------------*                                                                  
*  JOB1 SORT *                                                                  
*------------*                                                                  
                                                                                
SORT W51310D1 TO TPFIL1 USING (INV-IDDC INV-IDARTNR)                            
                                                                                
*-------------------------------------------------------------*                 
*  JOB2 MATCHA TPFIL MED LAGERBANDEN OCH SKAPA EN TEMPFIL     *                 
*  MED IDDC LAGEROMR OCH ARTIKEL                              *                 
*-------------------------------------------------------------*                 
                                                                                
JOB INPUT (W51310D2 KEY (LB1-IDARTNR) W51310D3 KEY (LB2-SLAG-IDARTNR))          
 IF W51310D2                                                                    
   TP2-IDDC     = '11'                                                          
   TP2-ADLAGOMR = LB1-ADLAGOMR                                                  
   TP2-IDARTNR  = LB1-IDARTNR                                                   
   PUT TPFIL2                                                                   
 END-IF                                                                         
 IF W51310D3                                                                    
   TP2-IDDC     = LB2-SLAG-IDDC                                                 
   TP2-ADLAGOMR = LB2-SLAG-ADLAGOMR                                             
   TP2-IDARTNR  = LB2-SLAG-IDARTNR                                              
   PUT TPFIL2                                                                   
 END-IF                                                                         
*--------------------------------------------------------------------*          
*  SORT TPFIL2 TILL TPFIL2 PÅ IDDC OCH ARTIKEL                                  
*  TEMPFIL LAGERBANDS INFO                                                      
*--------------------------------------------------------------------*          
                                                                                
SORT TPFIL2 TO TPFIL2   USING (TP2-IDDC TP2-IDARTNR)                            
                                                                                
*--------------------------------------------------------------------*          
*  JOB4 MATCHA TPFIL MED LAGERBAND TPFIL2 FÖR ATT HÄMTA LAGEROMRÅDE  *          
*  SKAPA TPFIL3                                                      *          
*--------------------------------------------------------------------*          
                                                                                
JOB INPUT (TPFIL2  KEY (TP2-IDDC TP2-IDARTNR)                 +                 
           TPFIL1  KEY (TP1-IDDC TP1-IDARTNR))                                  
  IF MATCHED                                                                    
      TP1-ADLAGOMR  = TP2-ADLAGOMR                                              
      TP3-W51310 EQ TP1-W51310                                                  
      TP3-IDARTNR   = 0                                                         
      PUT TPFIL3                                                                
  ELSE                                                                          
      IF TPFIL1                                                                 
        DISPLAY 'IDARTNR SAKNAS PÅ LB BAND ' TP1-IDARTNR  +                     
        ' TYP ' TP1-IDPTYP ' DC ' TP1-IDDC                                      
        TP1-ADLAGOMR  = 0                                                       
        TP3-W51310 EQ TP1-W51310                                                
        TP3-IDARTNR   = 0                                                       
        PUT TPFIL3                                                              
      END-IF                                                                    
  END-IF                                                                        
                                                                                
*------------*                                                                  
*  JOB5 SORT *                                                                  
*------------*                                                                  
                                                                                
SORT TPFIL3 TO TPFIL3 USING (TP3-IDPTYP TP3-IDDC TP3-ADLAGOMR)                  
                                                                                
*------------------------------------------------------------*                  
*  JOB5 SUMMERA POSTER PÅ IDDC POSTTYP OCH LAGEROMRÅDE       *                  
*  IDPTYP 0 = FÖRSÄLJNINGSPOSTER                             *                  
*  IDPTYP 1 = POSITIVA INV POSTER                            *                  
*  IDPTYP 0 = NEGATIVA INV POSTER                            *                  
*------------------------------------------------------------*                  
JOB INPUT TPFIL3 START A-INIT FINISH Z-INIT                                     
  IF W-FORSTA-POST = 'J'                                                        
    W-FORSTA-POST = 'N'                                                         
    UT-IDDC       = TP3-IDDC                                                    
    UT-IDPTYP     = TP3-IDPTYP                                                  
    UT-SUARTSTD   = TP3-SUARTSTD                                                
    W-SUARTFSG    = TP3-SUARTSTD                                                
    UT-ADLAGOMR   = TP3-ADLAGOMR                                                
    UT-DAVVREG    = TP3-DAVVREG                                                 
  ELSE                                                                          
    IF TP3-IDPTYP  NE UT-IDPTYP                                                 
      PUT W51310D4                                                              
      UT-IDDC      = TP3-IDDC                                                   
      UT-IDPTYP    = TP3-IDPTYP                                                 
      UT-SUARTSTD  = TP3-SUARTSTD                                               
    W-SUARTFSG   = W-SUARTFSG + TP3-SUARTSTD                                    
      UT-ADLAGOMR  = TP3-ADLAGOMR                                               
      UT-DAVVREG   = TP3-DAVVREG                                                
    ELSE                                                                        
      IF UT-IDDC     NE TP3-IDDC                                                
        PUT W51310D4                                                            
        UT-IDDC      = TP3-IDDC                                                 
        UT-IDPTYP    = TP3-IDPTYP                                               
        UT-SUARTSTD  = TP3-SUARTSTD                                             
        W-SUARTFSG   = W-SUARTFSG + TP3-SUARTSTD                                
        UT-ADLAGOMR  = TP3-ADLAGOMR                                             
        UT-DAVVREG   = TP3-DAVVREG                                              
      ELSE                                                                      
        IF UT-ADLAGOMR NE TP3-ADLAGOMR                                          
          PUT W51310D4                                                          
          UT-IDDC      = TP3-IDDC                                               
          UT-IDPTYP    = TP3-IDPTYP                                             
          UT-SUARTSTD  = TP3-SUARTSTD                                           
          W-SUARTFSG   = W-SUARTFSG + TP3-SUARTSTD                              
          UT-ADLAGOMR  = TP3-ADLAGOMR                                           
          UT-DAVVREG   = TP3-DAVVREG                                            
        ELSE                                                                    
*         SUMMERA IHOP POSTER                                                   
          UT-SUARTSTD = UT-SUARTSTD + TP3-SUARTSTD                              
          W-SUARTFSG  = W-SUARTFSG  + TP3-SUARTSTD                              
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
                                                                                
A-INIT. PROC                                                                    
  UT-ADLAGOMR   = 0                                                             
  UT-IDPTYP     = '000'                                                         
  UT-SUARTSTD   = +0                                                            
  UT-IDARTNR    = 0                                                             
  W-FORSTA-POST = 'J'                                                           
END-PROC                                                                        
Z-INIT. PROC                                                                    
  DISPLAY ' TOTOL SUMMA ' W-SUARTFSG                                            
  PUT W51310D4                                                                  
                                                                                
END-PROC                                                                        
