******************************************************************              
*                                                                               
* PROGRAM     : W5517600.                                                       
*                                                                               
* FUNCTION    : AVSTÄMNINGSLISTOR FÖR PRISSÄTTNING AV KALKYLPÅLÄGG              
*               DETTA PROGRAM ÄR EN SPECIAL FÖR SVANTESSON                      
*               ATT KÖRAS INNAN ÅRSSLUT                                         
*                                                                               
* INPUT       : W55105D1 FILER MED PÅLÄGG AVSEDD FÖR SPIS                       
*                                                                               
* OUTPUT      : REPORT W55176-001 (D&P)                                         
*                                                                               
******************************************************************              
                                                                                
FILE W55176D1                                                                   
%W55124   'IN1-'                                                                
                                                                                
FILE W55176D2                                                                   
%W55159   'IN2-'                                                                
                                                                                
FILE TPFIL1 FB(19 0)                                                            
%W55124   'T1-'                                                                 
                                                                                
FILE TPFIL2 FB(29 0)                                                            
T2-IDARTNR                           1  5 P 0                                   
T2-BEFT                              6  2 P 0                                   
T2-PRDIRLON                          8  4 P 3                                   
T2-PRDMTRL                          12  5 P 3                                   
T2-PRDIRLON-NY                      17  4 P 3                                   
T2-PRDMTRL-NY                       21  5 P 3                                   
T2-KVBEHOVAR                        26  4 P 0                                   
                                                                                
FILE W55176D3 VB(159 0) PRINTER                                                 
                                                                                
*                                                                               
                                                                                
W-BEFT                           W      3 N     MASK ('ZZ9')                    
W-PRDIRLON                       W     11 N 3                                   
W-PRDIRLON-HEL W-PRDIRLON               8 N 0   MASK ('ZZZZZZZ9')               
W-PRDIRLON-DEC W-PRDIRLON           +8  3 N                                     
W-PRDMTRL                        W     11 N 3                                   
W-PRDMTRL-HEL  W-PRDMTRL                8 N 0   MASK ('ZZZZZZZ9')               
W-PRDMTRL-DEC  W-PRDMTRL            +8  3 N                                     
W-PRDIRLON-NY                    W     11 N 3                                   
W-PRDIRLON-NY-HEL W-PRDIRLON-NY         8 N 0   MASK ('ZZZZZZZ9')               
W-PRDIRLON-NY-DEC W-PRDIRLON-NY     +8  3 N                                     
W-PRDMTRL-NY                     W     11 N 3                                   
W-PRDMTRL-NY-HEL  W-PRDMTRL-NY          8 N 0   MASK ('ZZZZZZZ9')               
W-PRDMTRL-NY-DEC  W-PRDMTRL-NY      +8  3 N                                     
W-PRDIRLON-PROC                  W      9 N 0   MASK ('--------9')              
W-PRDMTRL-PROC                   W      9 N 0   MASK ('--------9')              
W-KVBEHOVAR-TOT                  W     11 N 0   MASK ('ZZZZZZZZZZ9')            
                                                                                
*                                                                               
                                                                                
W-DATUM                          W      8 A                                     
JA                               W      1 A     VALUE 'J'                       
NEJ                              W      1 A     VALUE 'N'                       
W-FIRST-TIME                     W      1 A     VALUE 'J'                       
W-HEADER-WRITTEN                 W      1 A     VALUE 'N'                       
W-DELIMITER                      W      1 A     VALUE ';'                       
                                                                                
W-KDFORP                         W      3 N                                     
W-KDFORPGP W-KDFORP                     2 N                                     
W-KDFORPUF W-KDFORP                 +2  1 N                                     
                                                                                
*                                                                               
                                                                                
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*        
*  STEG 1   SORTERA INPOSTERNA (KALKYLPÅLÄGGSPOSTER FÖR W551B1)                 
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*        
                                                                                
SORT W55176D1 TO TPFIL1 USING (IN1-IDARTNR)                                     
                                                                                
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*        
*  STEG 2   MATCHA PÅLÄGGSPOSTER OCH ARTIKELINFO                                
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*        
                                                                                
JOB INPUT (TPFIL1 KEY T1-IDARTNR W55176D2 KEY IN2-IDARTNR) +                    
           START A-INIT                                                         
                                                                                
    IF MATCHED                                                                  
      T2-IDARTNR             = IN2-IDARTNR                                      
      W-KDFORPGP             = IN2-KDFORPGP                                     
      W-KDFORPUF             = IN2-KDFORPUF                                     
      IF W-KDFORP NUMERIC                                                       
        T2-BEFT              = W-KDFORP                                         
      ELSE                                                                      
        T2-BEFT              = 0                                                
      END-IF                                                                    
      T2-PRDIRLON            = IN2-PRDIRLON                                     
      T2-PRDMTRL             = IN2-PRDMTRL                                      
      T2-PRDIRLON-NY         = T1-PRDIRLON                                      
      T2-PRDMTRL-NY          = T1-PRDMTRL                                       
      T2-KVBEHOVAR           = IN2-KVBEHOVAR                                    
      PUT TPFIL2                                                                
                                                                                
      IF IN2-PRDIRLON = +0 OR T1-PRDIRLON = +0                                  
        W-PRDIRLON-PROC      = +0                                               
      ELSE                                                                      
        W-PRDIRLON-PROC      =                                         +        
          ((T1-PRDIRLON - IN2-PRDIRLON) * 100) / IN2-PRDIRLON                   
      END-IF                                                                    
                                                                                
      IF IN2-PRDMTRL = +0 OR T1-PRDMTRL = +0                                    
        W-PRDMTRL-PROC       = +0                                               
      ELSE                                                                      
        W-PRDMTRL-PROC       =                                         +        
          ((T1-PRDMTRL - IN2-PRDMTRL) * 100) / IN2-PRDMTRL                      
      END-IF                                                                    
    END-IF                                                                      
                                                                                
A-INIT.  PROC                                                                   
    MOVE SYSDATE            TO W-DATUM                                          
END-PROC                                                                        
                                                                                
SORT TPFIL2 TO TPFIL2 USING (T2-BEFT)                                           
                                                                                
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*        
*  STEG 3                                                                       
*  SKAPA LISTA W55105-001 ÖVER:                                                 
*  KALKYLPÅLÄGG SUMMERAT PER         FÖRPACKNINGSTYP                            
*  BERÄKNAT PÅ PERIODBEHOV.                                                     
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*        
                                                                                
JOB INPUT TPFIL2 START A-INIT FINISH Z-FINIT                                    
                                                                                
    IF W-FIRST-TIME = JA                                                        
      W-BEFT                 = T2-BEFT                                          
      W-FIRST-TIME           = NEJ                                              
    END-IF                                                                      
                                                                                
    IF W-BEFT NE T2-BEFT                                                        
      IF W-PRDIRLON = +0 OR W-PRDIRLON-NY = +0                                  
        W-PRDIRLON-PROC      = +0                                               
      ELSE                                                                      
        W-PRDIRLON-PROC      =                                         +        
          ((W-PRDIRLON-NY - W-PRDIRLON) * 100) / W-PRDIRLON                     
      END-IF                                                                    
      IF W-PRDMTRL = +0 OR W-PRDMTRL-NY = +0                                    
        W-PRDMTRL-PROC       = +0                                               
      ELSE                                                                      
        W-PRDMTRL-PROC = ((W-PRDMTRL-NY - W-PRDMTRL) * 100) / W-PRDMTRL         
      END-IF                                                                    
                                                                                
      PRINT LISTA1                                                              
                                                                                
      W-PRDIRLON             = +0                                               
      W-PRDMTRL              = +0                                               
      W-PRDIRLON-NY          = +0                                               
      W-PRDMTRL-NY           = +0                                               
      W-PRDMTRL-PROC         = +0                                               
      W-PRDIRLON-PROC        = +0                                               
      W-KVBEHOVAR-TOT        = +0                                               
    END-IF                                                                      
                                                                                
    W-BEFT                   = T2-BEFT                                          
                                                                                
    IF W-BEFT EQ 852                                                            
      DISPLAY T2-IDARTNR                    +                                   
              T2-PRDMTRL-NY                                                     
    END-IF                                                                      
                                                                                
    W-PRDIRLON               = W-PRDIRLON + (T2-PRDIRLON * T2-KVBEHOVAR)        
    W-PRDIRLON-NY            =                                         +        
                         W-PRDIRLON-NY + (T2-PRDIRLON-NY * T2-KVBEHOVAR)        
                                                                                
    W-PRDMTRL                = W-PRDMTRL + (T2-PRDMTRL * T2-KVBEHOVAR)          
    W-PRDMTRL-NY             =                                         +        
                         W-PRDMTRL-NY + (T2-PRDMTRL-NY * T2-KVBEHOVAR)          
                                                                                
    W-KVBEHOVAR-TOT          = W-KVBEHOVAR-TOT + T2-KVBEHOVAR                   
                                                                                
    IF W-BEFT = 0                                                               
      DISPLAY T2-IDARTNR                    +                                   
              T2-BEFT                       +                                   
              T2-PRDIRLON-NY                +                                   
              T2-PRDMTRL-NY                 +                                   
              T2-KVBEHOVAR                                                      
    END-IF                                                                      
                                                                                
A-INIT.  PROC                                                                   
    W-FIRST-TIME             = JA                                               
    W-PRDIRLON               = +0                                               
    W-PRDMTRL                = +0                                               
    W-PRDIRLON-NY            = +0                                               
    W-PRDMTRL-NY             = +0                                               
    W-PRDMTRL-PROC           = +0                                               
    W-PRDIRLON-PROC          = +0                                               
    W-KVBEHOVAR-TOT          = +0                                               
END-PROC                                                                        
                                                                                
Z-FINIT. PROC                                                                   
    IF W-PRDIRLON = +0 OR W-PRDIRLON-NY = +0                                    
      W-PRDIRLON-PROC        = +0                                               
    ELSE                                                                        
      W-PRDIRLON-PROC        =                                         +        
        ((W-PRDIRLON-NY - W-PRDIRLON) * 100) / W-PRDIRLON                       
    END-IF                                                                      
    IF W-PRDMTRL = +0 OR W-PRDMTRL-NY = +0                                      
      W-PRDMTRL-PROC         = +0                                               
    ELSE                                                                        
      W-PRDMTRL-PROC         =                                         +        
        ((W-PRDMTRL-NY - W-PRDMTRL) * 100) / W-PRDMTRL                          
    END-IF                                                                      
                                                                                
    PRINT LISTA1                                                                
                                                                                
END-PROC                                                                        
                                                                                
REPORT LISTA1    PRINTER W55176D3           +                                   
                 LINESIZE 154               +                                   
                 PAGESIZE 32767             +                                   
                 NOHEADING                  +                                   
                 NOADJUST                   +                                   
                 NOSPREAD                   +                                   
                 NODATE                     +                                   
                 NOPAGE                     +                                   
                 SKIP  0                    +                                   
                 SPACE 0                    +                                   
                 TITLESKIP 0                                                    
                                                                                
   LINE          W-BEFT                     +                                   
                 W-DELIMITER                +                                   
                 W-PRDIRLON-HEL             +                                   
                 W-DELIMITER                +                                   
                 W-PRDIRLON-NY-HEL          +                                   
                 W-DELIMITER                +                                   
                 W-PRDIRLON-PROC            +                                   
                 W-DELIMITER                +                                   
                 W-PRDMTRL-HEL              +                                   
                 W-DELIMITER                +                                   
                 W-PRDMTRL-NY-HEL           +                                   
                 W-DELIMITER                +                                   
                 W-PRDMTRL-PROC             +                                   
                 W-DELIMITER                +                                   
                 W-KVBEHOVAR-TOT                                                
                                                                                
BEFORE-LINE.  PROC                                                              
  IF W-HEADER-WRITTEN = 'N'                                                     
    DISPLAY '¤DAPW55176-001'                                                    
    DISPLAY '¤DAPW55176'                                                        
    DISPLAY 'PACKAGING TYPE;SUM SALARY THIS YEAR;SUM SALARY NEXT YEAR;C+        
             HANGE SALARY (%);SUM MATERIAL THIS YEAR;SUM MATERIAL NEXT +        
             YEAR;CHANGE MATERIAL (%);YEARLY DEMAND'                            
    W-HEADER-WRITTEN         = 'J'                                              
  END-IF                                                                        
END-PROC                                                                        
                                                                                
