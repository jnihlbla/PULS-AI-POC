NEWPAGE                                                                         
FILE W21713D1                                                                   
%W2172020  'D1-'                                                                
*                                                                               
                                                                                
NEWPAGE                                                                         
FILE W21713D2                                                                   
%W2171201  'D2-'                                                                
*                                                                               
                                                                                
NEWPAGE                                                                         
FILE W21713D3 FB(380 0)                                                         
%W2172020 'OUT-'                                                                
*                                                                               
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. MATCH                                                                 
*                                                                               
JOB INPUT (W21713D1 KEY(D1-IDARTNR D1-IDDC)  +                                  
           W21713D2 KEY(D2-IDARTNR D2-IDDC))                                    
IF MATCHED                                                                      
  OUT-W2172020         = D1-W2172020                                            
  OUT-KVOI-12-RULL     = D2-KVOI-12-RULL                                        
  OUT-KVOI-YEAR-0      = D2-KVOI-YEAR-0                                         
  OUT-KVOI-YEAR-1      = D2-KVOI-YEAR-1                                         
  OUT-KVOI-YEAR-2      = D2-KVOI-YEAR-2                                         
  OUT-KVOI-YEAR-3      = D2-KVOI-YEAR-3                                         
  OUT-KVOI-YEAR-4      = D2-KVOI-YEAR-4                                         
  OUT-KVOI-YEAR-5      = D2-KVOI-YEAR-5                                         
  PUT W21713D3                                                                  
ELSE                                                                            
  IF W21713D1                                                                   
    OUT-W2172020       = D1-W2172020                                            
    OUT-KVOI-12-RULL   = 0                                                      
    OUT-KVOI-YEAR-0    = 0                                                      
    OUT-KVOI-YEAR-1    = 0                                                      
    OUT-KVOI-YEAR-2    = 0                                                      
    OUT-KVOI-YEAR-3    = 0                                                      
    OUT-KVOI-YEAR-4    = 0                                                      
    OUT-KVOI-YEAR-5    = 0                                                      
    PUT W21713D3                                                                
  END-IF                                                                        
END-IF                                                                          
