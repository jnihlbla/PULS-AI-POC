*                                                                      *        
*  PROGRAM    :  W1119000                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR DENNA VECKAS LAGERBAND MED                    *        
*                FÖRRA VECKANS                                         *        
*                DE ARTIKLAR SOM FÅTT ERSÄTTNINGSKOD = 9              *         
*                UNDER DEN SISTA VECKAN SKRIVS UT                               
*                                                                      *        
*  FÖRFATTARE :  PAH                                                   *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W11190D1                                                                   
*                                                                               
%W011100  'NLB-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W11190D2                                                                   
*                                                                               
%W011100  'GLB-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W11190D3  PRINTER VB (125 0)                                               
                                                                                
NEWPAGE                                                                         
                                                                                
WS-IDARTNR        W   8   N   MASK 'ZZZZZZZ9'                                   
WS-IDFKNGRP       W   4   N   MASK 'ZZZ9'                                       
WS-KDERS          W   2   N   MASK '99'                                         
WS-NERS           W   2   N                                                     
WS-NERS-2 WS-NERS +1  1   N                                                     
WS-GERS           W   2   N                                                     
WS-GERS-2 WS-GERS +1  1   N                                                     
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. SKAPA LISTA                                                           
*                                                                               
JOB INPUT (W11190D1 KEY NLB-IDARTNR W11190D2 KEY GLB-IDARTNR) +                 
  START(A-INIT)                                                                 
                                                                                
  IF MATCHED                                                                    
      WS-IDARTNR   = NLB-IDARTNR                                                
      WS-IDFKNGRP  = NLB-IDFKNGRP                                               
      WS-KDERS     = NLB-KDERS                                                  
      WS-NERS      = NLB-KDERS                                                  
      WS-GERS      = GLB-KDERS                                                  
      IF  WS-NERS-2 EQ 9   AND                                 +                
         (WS-GERS-2 < 9 OR WS-GERS-2 > 9)                                       
         PRINT RAPPORT01                                                        
      END-IF                                                                    
  END-IF                                                                        
NEWPAGE                                                                         
                                                                                
A-INIT. PROC                                                                    
                                                                                
  END-PROC                                                                      
                                                                                
                                                                                
NEWPAGE                                                                         
REPORT RAPPORT01 PRINTER W11190D3 LINESIZE 120 DTLCTL FIRST     +               
       NOADJUST PAGESIZE 49  TITLESKIP 3 NOSPREAD      +                        
       SUMCTL ALL                                                               
SEQUENCE NLB-IDFKNGRP NLB-IDARTNR                                               
                                                                                
TITLE 1  COL 12  'VOLVO CAR AFTERSALES   W11190-001 '           +               
         COL 48  'NEW SUPERSESSION CODES = 9        '                           
                                                                                
TITLE 2  COL 48  '                LAST WEEK '                                   
                                                                                
HEADING  WS-IDFKNGRP   ('FUNC.' 'GROUP')                                        
HEADING  WS-IDARTNR    ('PART NO')                                              
HEADING NLB-BEART-ENG  ('DESCRIPTION')                                          
HEADING NLB-KDPRODSL   ('PROD' 'GRP')                                           
HEADING NLB-KVLS       ('STOCK' 'BALANCE')                                      
HEADING NLB-KVBR-TOT   ('ON ORDER' 'BALANCE')                                   
HEADING  WS-KDERS      ('SUPERSESSION' 'CODE')                                  
                                                                                
LINE 01   WS-IDFKNGRP  WS-IDARTNR NLB-BEART-ENG +                               
         NLB-KDPRODSL NLB-KVLS NLB-KVBR-TOT  WS-KDERS                           
