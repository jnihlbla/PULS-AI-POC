        IF W-IDGTYP = 0                                                         
           MOVE '*** URVALET SAKNAR RESULTAT ***' TO         +                  
                W-RESULTAT-SAKNAS                                               
        ELSE                                                                    
           MOVE '                               ' TO         +                  
                W-RESULTAT-SAKNAS                                               
        END-IF                                                                  
                                                                                
        W-REGDATUM = BILD02-DAREGDAT                                            
        W-REGTID = BILD02-TIREGTID                                              
        SPAR-KDNIVA = BILD02-KDNIVA                                             
