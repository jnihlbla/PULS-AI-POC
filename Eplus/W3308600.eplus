                 MOVE SPACE TO W-URVALSTYP                                      
              END-IF                                                            
           END-IF                                                               
        END-IF                                                                  
     END-IF                                                                     
     IF RES-IDFKNGRP > W-FKN-GRP OR             +                               
        RES-IDFKNGRP < W-FKN-GRP                                                
        W-BEFKNGRP = RES-BEFKNGRP                                               
     END-IF                                                                     
     W-REGDATUM = RES-DAREGDAT                                                  
     W-REGTID = RES-TIREGTID                                                    
     W-RETOTBV-VV  = RES-RETOTBV-VV                                             
     W-RETOTBV-FVV = RES-RETOTBV-FVV                                            
     W-FKN-GRP = RES-IDFKNGRP                                                   
     W-BRYT-IDFKNGRP = RES-IDFKNGRP                                             
     W-SUARTFSG-VV = RES-SUARTFSG-VV                                            
     W-SUARTFSG-FVV = RES-SUARTFSG-FVV                                          
     IF W-IDTRANS = '3202'                                                      
       IF W-KDSVAR = 'J'                                                        
         W-BRYT-KDPRODSL = 0                                                    
         W-BEPRODSL = 'SAMMANSLAGN. PS'                                         
       ELSE                                                                     
         W-BRYT-KDPRODSL = RES-KDPRODSL                                         
         W-BEPRODSL = RES-BEPRODSL                                              
       END-IF                                                                   
     ELSE                                                                       
       W-BRYT-KDPRODSL = RES-KDPRODSL                                           
         W-BEPRODSL = RES-BEPRODSL                                              
     END-IF                                                                     
     PRINT RAPPORT-VP1                                                          
  END-IF                                                                        
                                                                                
