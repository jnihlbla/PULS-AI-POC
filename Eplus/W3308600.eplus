*                                                                               
  REPORT RAPPORT-VP1 SPACE 1 +                                                  
         PRINTER W33086D2    +                                                  
         LINESIZE 120        +                                                  
         NOADJUST            +                                                  
         TITLESKIP 0         +                                                  
         SUMCTL NONE                                                            
    CONTROL  FINAL NOPRINT                                  +                   
             RES-IDUSER NOPRINT W-REGDATUM NOPRINT RENUM    +                   
             W-REGTID NOPRINT RENUM W-BRYT-KDPRODSL NOPRINT +                   
             W-FKN-TUSEN NOPRINT                            +                   
             W-FKN-HUNDRA NOPRINT NEWPAGE                                       
                                                                                
                                                                                
    SUM      RES-SULEVANT-VV RES-SUARTFSG-VV                +                   
             RES-SULEVANT-FVV RES-SUARTFSG-FVV              +                   
             RES-SUARTSJK-VV  RES-SUARTSJK-FVV                                  
                                                                                
    TITLE 1 COL 005 ' '                                                         
                                                                                
    TITLE 2 COL 004 'VOLVO PARTS AB'                +                           
            COL 024 'W33086-001'                    +                           
            COL 040 'VP1       PRODUKTSTATISTIK'    +                           
            COL 080 'USERID '                       +                           
            COL 088 RES-IDUSER                      +                           
            COL 098 'DATUM'                         +                           
            COL 105 W-REGDATUM                                                  
                                                                                
    TITLE 3 COL 026 'URVAL'                         +                           
            COL 040 W-FSGURV                        +                           
            COL 098 'TID'                           +                           
            COL 105 W-REGTID                                                    
                                                                                
    TITLE 5 COL 002 'PRODUKTSLAG'                   +                           
            COL 015 W-BRYT-KDPRODSL                 +                           
            COL 019 W-BEPRODSL                      +                           
            COL 040 'FUNKTIONSGRUPP'                +                           
            COL 057 W-BRYT-IDFKNGRP                 +                           
            COL 063 W-BEFKNGRP                                                  
                                                                                
    TITLE 7 COL 033 'AVSER VECKA'                   +                           
            COL 045 W-VV-START                      +                           
            COL 051 '-'                             +                           
            COL 052 W-VV-SLUT                       +                           
            COL 076 'AVSER VECKA'                   +                           
            COL 088 W-FVV-START                     +                           
            COL 094 '-'                             +                           
            COL 095 W-FVV-SLUT                                                  
                                                                                
    HEADING  W-URVALSTYP ' '                                                    
    HEADING  RES-SULEVANT-VV '           ST'                                    
    HEADING  W-SUARTFSG-VV '        FSG KR'                                     
    HEADING  W-RETOTBV-VV 'TG % '                                               
    HEADING  RES-SULEVANT-FVV '           ST'                                   
    HEADING  W-SUARTFSG-FVV '        FSG KR'                                    
    HEADING  W-RETOTBV-FVV 'TG % '                                              
                                                                                
    LINE  1  COL 004 W-URVALSTYP       +                                        
             COL 020 RES-SULEVANT-VV   +                                        
             COL 038 W-SUARTFSG-VV     +                                        
             COL 055 W-RETOTBV-VV      +                                        
             COL 063 RES-SULEVANT-FVV  +                                        
             COL 081 W-SUARTFSG-FVV    +                                        
             COL 098 W-RETOTBV-FVV                                              
                                                                                
BEFORE-BREAK. PROC                                                              
   IF LEVEL = 1                                                                 
      SUM-PS-NIV-FSG-VV = SUM-PS-NIV-FSG-VV + RES-SUARTFSG-VV                   
      SUM-PS-NIV-FSG-FVV = SUM-PS-NIV-FSG-FVV + RES-SUARTFSG-FVV                
      SUM-PS-NIV-LEV-VV = SUM-PS-NIV-LEV-VV + RES-SULEVANT-VV                   
      SUM-PS-NIV-LEV-FVV = SUM-PS-NIV-LEV-FVV + RES-SULEVANT-FVV                
      SUM-1000-NIV-FSG-VV = SUM-1000-NIV-FSG-VV + RES-SUARTFSG-VV               
      SUM-1000-NIV-FSG-FVV = SUM-1000-NIV-FSG-FVV + RES-SUARTFSG-FVV            
      SUM-1000-NIV-LEV-VV = SUM-1000-NIV-LEV-VV + RES-SULEVANT-VV               
      SUM-1000-NIV-LEV-FVV = SUM-1000-NIV-LEV-FVV + RES-SULEVANT-FVV            
      W-PS-TOT-SJK-VV = W-PS-TOT-SJK-VV + +                                     
      RES-SUARTSJK-VV                                                           
      W-PS-TOT-SJK-FVV = W-PS-TOT-SJK-FVV + +                                   
      RES-SUARTSJK-FVV                                                          
      W-1000-TOT-SJK-VV = W-1000-TOT-SJK-VV + +                                 
      RES-SUARTSJK-VV                                                           
      W-1000-TOT-SJK-FVV = W-1000-TOT-SJK-FVV + +                               
      RES-SUARTSJK-FVV                                                          
      IF RES-SUARTFSG-VV NE 0                                                   
         W-TG-VV = (100 * (RES-SUARTFSG-VV - RES-SUARTSJK-VV)) +                
                       / RES-SUARTFSG-VV                                        
         IF W-TG-VV >= 0                                                        
           W-TG-VV = W-TG-VV + 0.05                                             
         ELSE                                                                   
           W-TG-VV = W-TG-VV - 0.05                                             
         END-IF                                                                 
         W-TG-VV-UT = W-TG-VV                                                   
      END-IF                                                                    
      IF RES-SUARTFSG-FVV NE 0                                                  
                                                                                
         W-TG-FVV = (100 * (RES-SUARTFSG-FVV - RES-SUARTSJK-FVV)) +             
                       / RES-SUARTFSG-FVV                                       
         IF W-TG-FVV >= 0                                                       
           W-TG-FVV = W-TG-FVV + 0.05                                           
         ELSE                                                                   
           W-TG-FVV = W-TG-FVV - 0.05                                           
         END-IF                                                                 
         W-TG-FVV-UT = W-TG-FVV                                                 
      END-IF                                                                    
      W-SUARTFSG-VV-NODEC = RES-SUARTFSG-VV                                     
      W-SUARTFSG-FVV-NODEC = RES-SUARTFSG-FVV                                   
      DISPLAY '                   '                                             
      DISPLAY COL 005 'NIVÅ 2'             +                                    
              COL 020 RES-SULEVANT-VV      +                                    
              COL 038 W-SUARTFSG-VV-NODEC  +                                    
              COL 055 W-TG-VV-UT           +                                    
              COL 063 RES-SULEVANT-FVV     +                                    
              COL 081 W-SUARTFSG-FVV-NODEC +                                    
              COL 098 W-TG-FVV-UT                                               
   ELSE                                                                         
     IF LEVEL = 2                                                               
          IF SUM-1000-NIV-FSG-VV NE 0                                           
             W-TG-VV = (100 * (SUM-1000-NIV-FSG-VV - +                          
                                W-1000-TOT-SJK-VV)) +                           
                               / SUM-1000-NIV-FSG-VV                            
             IF W-TG-VV >= 0                                                    
               W-TG-VV = W-TG-VV + 0.05                                         
             ELSE                                                               
               W-TG-VV = W-TG-VV - 0.05                                         
             END-IF                                                             
             W-TG-VV-UT = W-TG-VV                                               
          END-IF                                                                
          IF SUM-1000-NIV-FSG-FVV NE 0                                          
             W-TG-FVV = (100 * (SUM-1000-NIV-FSG-FVV - +                        
                                W-1000-TOT-SJK-FVV)) +                          
                                / SUM-1000-NIV-FSG-FVV                          
             IF W-TG-FVV >= 0                                                   
               W-TG-FVV = W-TG-FVV + 0.05                                       
             ELSE                                                               
               W-TG-FVV = W-TG-FVV - 0.05                                       
             END-IF                                                             
             W-TG-FVV-UT = W-TG-FVV                                             
          END-IF                                                                
          W-SUARTFSG-VV-NODEC = SUM-1000-NIV-FSG-VV                             
          W-SUARTFSG-FVV-NODEC = SUM-1000-NIV-FSG-FVV                           
          DISPLAY '                   '                                         
          DISPLAY COL 005 'NIVÅ 0'             +                                
                  COL 023 SUM-1000-NIV-LEV-VV  +                                
                  COL 038 W-SUARTFSG-VV-NODEC  +                                
                  COL 055 W-TG-VV-UT           +                                
                  COL 066 SUM-1000-NIV-LEV-FVV +                                
                  COL 081 W-SUARTFSG-FVV-NODEC  +                               
                  COL 098 W-TG-FVV-UT                                           
                                                                                
     END-IF                                                                     
     IF LEVEL = 3                                                               
          IF SUM-PS-NIV-FSG-VV NE 0                                             
             W-TG-VV = (100 * (SUM-PS-NIV-FSG-VV - +                            
                                W-PS-TOT-SJK-VV)) +                             
                               / SUM-PS-NIV-FSG-VV                              
             IF W-TG-VV >= 0                                                    
               W-TG-VV = W-TG-VV + 0.05                                         
             ELSE                                                               
               W-TG-VV = W-TG-VV - 0.05                                         
             END-IF                                                             
             W-TG-VV-UT = W-TG-VV                                               
          END-IF                                                                
          IF SUM-PS-NIV-FSG-FVV NE 0                                            
             W-TG-FVV = (100 * (SUM-PS-NIV-FSG-FVV - +                          
                                W-PS-TOT-SJK-FVV)) +                            
                                / SUM-PS-NIV-FSG-FVV                            
             IF W-TG-FVV >= 0                                                   
               W-TG-FVV = W-TG-FVV + 0.05                                       
             ELSE                                                               
               W-TG-FVV = W-TG-FVV - 0.05                                       
             END-IF                                                             
             W-TG-FVV-UT = W-TG-FVV                                             
          END-IF                                                                
          W-SUARTFSG-VV-NODEC = SUM-PS-NIV-FSG-VV                               
          W-SUARTFSG-FVV-NODEC = SUM-PS-NIV-FSG-FVV                             
          DISPLAY '                   '                                         
          DISPLAY COL 005 'PS-TOTAL'           +                                
                  COL 023 SUM-PS-NIV-LEV-VV    +                                
                  COL 038 W-SUARTFSG-VV-NODEC  +                                
                  COL 055 W-TG-VV-UT           +                                
                  COL 066 SUM-PS-NIV-LEV-FVV +                                  
                  COL 081 W-SUARTFSG-FVV-NODEC  +                               
                  COL 098 W-TG-FVV-UT                                           
                                                                                
     END-IF                                                                     
   END-IF                                                                       
END-PROC                                                                        
AFTER-BREAK. PROC                                                               
   W-TG-VV     = 0                                                              
   W-TG-FVV    = 0                                                              
   W-TG-VV-UT  = 0                                                              
   W-TG-FVV-UT = 0                                                              
   IF LEVEL = 2                                                                 
     SUM-1000-NIV-FSG-VV  = 0                                                   
     SUM-1000-NIV-FSG-FVV = 0                                                   
     SUM-1000-NIV-LEV-VV  = 0                                                   
     SUM-1000-NIV-LEV-FVV = 0                                                   
     W-1000-TOT-SJK-VV    = 0                                                   
     W-1000-TOT-SJK-FVV   = 0                                                   
   END-IF                                                                       
   IF LEVEL = 3                                                                 
     SUM-PS-NIV-FSG-VV =   0                                                    
     SUM-PS-NIV-FSG-FVV =  0                                                    
     SUM-PS-NIV-LEV-VV =   0                                                    
     SUM-PS-NIV-LEV-FVV =  0                                                    
     W-PS-TOT-SJK-VV =     0                                                    
     W-PS-TOT-SJK-FVV =    0                                                    
   END-IF                                                                       
END-PROC                                                                        
