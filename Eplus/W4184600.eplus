                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4184600                                              *        
*                                                                      *        
*  FUNKTION   :  CREATE REGISTER FILE AND FILE TO AZURE DATALAKE       *        
*                                                                      *        
*  FÖRFATTARE :  STENING INGER                                         *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W41846D1                                                                   
*                                                                               
%W41842X1  'NEW-'                                                               
                                                                                
NEWPAGE                                                                         
FILE W41846D2                                                                   
*                                                                               
%W41842X1  'OLD-'                                                               
                                                                                
NEWPAGE                                                                         
FILE W41846D3 FB(1467 0)                                                        
*                                                                               
%W41842X1  'OUT-'                                                               
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1.                                                                       
*                                                                               
JOB INPUT (W41846D1 KEY(NEW-IDDISTR NEW-IDKUNDNR NEW-IDRAPPNR  +                
                        NEW-IDARTNR NEW-IDRADNR  NEW-KDLEVANM) +                
           W41846D2 KEY(OLD-IDDISTR OLD-IDKUNDNR OLD-IDRAPPNR  +                
                        OLD-IDARTNR OLD-IDRADNR  OLD-KDLEVANM))                 
                                                                                
IF NOT MATCHED                                                                  
  IF W41846D1                                                                   
    OUT-W41842X1 = NEW-W41842X1                                                 
    PUT W41846D3                                                                
  END-IF                                                                        
END-IF                                                                          
                                                                                
