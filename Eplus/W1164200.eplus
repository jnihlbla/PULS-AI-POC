                                                                                
*----------------------------------------------------------------------*        
*  PROGRAM    :  W1164200                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR W01160(0) OCH W116.W11642(0)         *                 
*                SKAPAR NYTT REGISTER W11642                           *        
*                OCH FIL FÖRÄNDRAD KDERS                               *        
*                                                                      *        
*  FÖRFATTARE :  BODIL LINDAHL                                         *        
*                                                                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
*    -- CHECKED BY WY2000                                                       
*                                                                               
*--------------------------------------*                                        
*   W01160                             *                                        
* -------------------------------------*                                        
FILE W11642D1                                                                   
%W01160                                                                         
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W11642 REGISTER IN                  *                                        
* -------------------------------------*                                        
FILE W11642D2                                                                   
REGIN-IDARTNR  1  9 N                                                           
REGIN-KDERS    10 2 N                                                           
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W11642 REGISER UT                   *                                        
* -------------------------------------*                                        
FILE W11642D3 FB (11 27995)                                                     
REGUT-IDARTNR  1  9 N                                                           
REGUT-KDERS    10 2 N                                                           
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W11643 ARTIKLAR FÖRÄNDRAD KDERS     *                                        
* -------------------------------------*                                        
FILE W11642D4 FB (12 27996)                                                     
%W11173    'UT-'                                                                
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  ARBETSFÄLT                          *                                        
* -------------------------------------*                                        
*                                                                               
 W-IDLOPNR    W 3 N VALUE 0                                                     
*                                                                               
NEWPAGE                                                                         
*                                                                               
*------------------------------------------------------------------*            
* STEG 1. MATCHAR ARTIKELDATA                                      *            
*         SKRIVER UTFIL                                            *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT (W11642D1 KEY (CLAG-IDARTNR)                             +            
           W11642D2 KEY (REGIN-IDARTNR))                                        
                                                                                
 IF MATCHED                                                                     
    IF CLAG-KDERS     = REGIN-KDERS                                +            
    OR CLAG-KDERS-UTG = REGIN-KDERS                                             
       REGUT-IDARTNR  = REGIN-IDARTNR                                           
       REGUT-KDERS    = REGIN-KDERS                                             
       IF REGIN-KDERS > 0                                                       
          PUT W11642D3                                                          
       END-IF                                                                   
    ELSE                                                                        
       UT-IDARTNR    = CLAG-IDARTNR                                             
       UT-KDERS-OLD  = REGIN-KDERS                                              
       UT-KDERS-NEW  = CLAG-KDERS                                               
       W-IDLOPNR     = W-IDLOPNR + 1                                            
       UT-IDLOPNR    = W-IDLOPNR                                                
       PUT W11642D4                                                             
                                                                                
       REGUT-IDARTNR = CLAG-IDARTNR                                             
       REGUT-KDERS   = CLAG-KDERS                                               
       PUT W11642D3                                                             
    END-IF                                                                      
 ELSE                                                                           
    IF W11642D1                                                                 
       IF CLAG-KDERS > 0                                                        
          UT-IDARTNR   = CLAG-IDARTNR                                           
          UT-KDERS-OLD = 0                                                      
          UT-KDERS-NEW = CLAG-KDERS                                             
          W-IDLOPNR    = W-IDLOPNR + 1                                          
          UT-IDLOPNR   = W-IDLOPNR                                              
          PUT W11642D4                                                          
                                                                                
          REGUT-IDARTNR = CLAG-IDARTNR                                          
          REGUT-KDERS   = CLAG-KDERS                                            
          PUT W11642D3                                                          
       END-IF                                                                   
    END-IF                                                                      
 END-IF                                                                         
*                                                                               
