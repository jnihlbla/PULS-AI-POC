             RES-SUARTFSG-FAAR                               +                  
             RES-SUARTFSG-RAAR                               +                  
             RES-SUARTFSG-FRAAR                              +                  
             RES-SUARTSJK-RAAR                               +                  
             RES-SUARTSJK-FRAAR                              +                  
             RES-SULEVANT-AAR                                +                  
             RES-SULEVANT-FAAR                               +                  
             RES-SULEVANT-RAAR                               +                  
             RES-SULEVANT-FRAAR                                                 
                                                                                
    TITLE 1 COL 005 ' '                                                         
                                                                                
    TITLE 2 COL 004 'VOLVO PARTS AB'                         +                  
