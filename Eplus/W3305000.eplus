        W-KDMARK-BUDG06-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP    = URVAL3-MARKNADS-GRP(7)                              
        W-KDMARK-BUDG07-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG07-T = W-KDMARK-BUDG-TOM                                   
        W-MARKNADS-GRP    = URVAL3-MARKNADS-GRP(8)                              
        W-KDMARK-BUDG08-F = W-KDMARK-BUDG-FOM                                   
        W-KDMARK-BUDG08-T = W-KDMARK-BUDG-TOM                                   
                                                                                
        W-SOEK-IX = 1                                                           
        W-MAX-ARTNR-IX  = 0                                                     
                                                                                
        DO WHILE  W-SOEK-IX LT 501                                              
          IF URVAL3-IDARTNR(W-SOEK-IX) GT W-TOMT-IDARTNR                        
            W-MAX-ARTNR-IX = W-MAX-ARTNR-IX  + 1                                
          ELSE                                                                  
            W-SOEK-IX = 998                                                     
          END-IF                                                                
          W-SOEK-IX = W-SOEK-IX + 1                                             
        END-DO                                                                  
                                                                                
        W-ARTNR-IX = 1                                                          
        DO WHILE W-ARTNR-IX < W-MAX-ARTNR-IX                                    
           W-IDARTNR01    = URVAL3-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR02    = URVAL3-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR03    = URVAL3-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR04    = URVAL3-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR05    = URVAL3-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR06    = URVAL3-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR07    = URVAL3-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR08    = URVAL3-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR09    = URVAL3-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR10    = URVAL3-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           PRINT RAPPORT03                                                      
        END-DO                                                                  
     END-IF                                                                     
  ELSE                                                                          
***     SKAPAR RESULTATSIDOR FÖR LISTA A1                                       
***                                                                             
     W-REGDAT             = RES-DAREGDAT                                        
     W-REGTID             = RES-TIREGTID                                        
     W-A1-IDARTNR         = RES-IDARTNR                                         
     W-A1-BEART-SVE       = RES-BEART-SVE                                       
     W-A1-SULEVANT-AAR    = RES-SULEVANT-AAR                                    
     W-A1-SUARTFSG-AAR    = (RES-SUARTFSG-AAR + 500) / 1000                     
     W-A1-SULEVANT-RAAR   = RES-SULEVANT-RAAR                                   
     W-A1-SUARTFSG-RAAR   = (RES-SUARTFSG-RAAR + 500) / 1000                    
     W-A1-RELEVANT-AAR    = RES-RELEVANT-AAR                                    
     W-A1-REFSG-AAR       = RES-REFSG-AAR                                       
     W-A1-RELEVANT-RAAR   = RES-RELEVANT-RAAR                                   
     W-A1-RETOTBV-RAAR-TG = RES-RETOTBV-RAAR-TG                                 
     W-A1-RETOTBV-RAAR    = RES-RETOTBV-RAAR                                    
     W-A1-SUTOTBV-RAAR    = (RES-SUTOTBV-RAAR + 500) / 1000                     
* ü                                                                             
     PRINT RAPPORT-A1                                                           
  END-IF                                                                        
                                                                                
                                                                                
INIT-PROC. PROC                                                                 
                                                                                
W-TOMT-IDARTNR        = 0                                                       
W-TIO-RADER           = 1                                                       
END-PROC                                                                        
