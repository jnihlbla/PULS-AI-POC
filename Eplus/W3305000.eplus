             COL 056 W-A1-SULEVANT-RAAR                      +                  
             COL 067 W-A1-SUARTFSG-RAAR                      +                  
             COL 077 W-A1-RELEVANT-AAR                       +                  
             COL 084 W-A1-REFSG-AAR                          +                  
             COL 091 W-A1-RELEVANT-RAAR                      +                  
             COL 099 W-A1-RETOTBV-RAAR-TG                    +                  
             COL 106 W-A1-RETOTBV-RAAR                       +                  
             COL 113 W-A1-SUTOTBV-RAAR                                          
                                                                                
                                                                                
AFTER-LINE. PROC                                                                
* EN RÄKNARE FÖR ATT KUNNA BRYTA VID TIO SKRIVNA RADER                          
*----------------------------------------------------                           
   IF W-TIO-RADER = 10                                                          
         DISPLAY ' '                                                            
         W-TIO-RADER = 1                                                        
   ELSE                                                                         
      W-TIO-RADER = W-TIO-RADER + 1                                             
   END-IF                                                                       
END-PROC                                                                        
BEFORE-BREAK. PROC                                                              
    IF LEVEL = 1                                                                
                                                                                
****   UTRÄKNING AV TÄCKNINNGSBIDRAG MM PÅ ARTIKELNIVÅ                          
                                                                                
*7                                                                              
***    AF1 TG                                                                   
                                                                                
       IF RES-SUARTFSG-FRAAR NE 0                                               
          W-AF1-TG =                                         +                  
          100 * ((RES-SUARTFSG-FRAAR - RES-SUARTSJK-FRAAR) / +                  
                 RES-SUARTFSG-FRAAR)                                            
       ELSE                                                                     
          W-AF1-TG = 0                                                          
       END-IF                                                                   
                                                                                
*2                                                                              
***    AF2 TG                                                                   
                                                                                
       IF RES-SUARTFSG-RAAR NE 0                                                
          SUM-RETOTBV-RAAR =                                 +                  
          100 * ((RES-SUARTFSG-RAAR - RES-SUARTSJK-RAAR) /   +                  
                 RES-SUARTFSG-RAAR)                                             
       ELSE                                                                     
          SUM-RETOTBV-RAAR = 0                                                  
       END-IF                                                                   
*3                                                                              
***    AF2/AF1 TG                                                               
                                                                                
       SUM-RETOTBV-RAAR-TG = SUM-RETOTBV-RAAR - W-AF1-TG                        
                                                                                
*4                                                                              
***    AVV SEK AF4/AF3                                                          
                                                                                
       IF RES-SUARTFSG-FAAR NE 0                                                
          SUM-REFSG-AAR =                                    +                  
          100 * ((RES-SUARTFSG-AAR - RES-SUARTFSG-FAAR) /    +                  
                 RES-SUARTFSG-FAAR)                                             
       ELSE                                                                     
          SUM-REFSG-AAR = 0                                                     
       END-IF                                                                   
                                                                                
*5                                                                              
***    AVV STYCK AF4/AF3                                                        
                                                                                
       IF RES-SULEVANT-FAAR NE 0                                                
          SUM-RELEVANT-AAR =                                 +                  
          100 * ((RES-SULEVANT-AAR - RES-SULEVANT-FAAR) /    +                  
                 RES-SULEVANT-FAAR)                                             
       ELSE                                                                     
          SUM-RELEVANT-AAR = 0                                                  
       END-IF                                                                   
                                                                                
*6                                                                              
***    AVV STYCK AF2/AF1                                                        
                                                                                
       IF RES-SULEVANT-FRAAR NE 0                                               
          SUM-RELEVANT-RAAR =                                +                  
          100 * ((RES-SULEVANT-RAAR - RES-SULEVANT-FRAAR) /  +                  
                 RES-SULEVANT-FRAAR)                                            
       ELSE                                                                     
          SUM-RELEVANT-RAAR = 0                                                 
       END-IF                                                                   
                                                                                
*1                                                                              
***    AF2 TB                                                                   
                                                                                
***    AVRUNDNING                                                               
                                                                                
       SUM-SUTOTBV-RAAR =                                    +                  
        RES-SUARTFSG-RAAR - RES-SUARTSJK-RAAR                                   
                                                                                
       IF SUM-RETOTBV-RAAR > 0                                                  
          SUM-RETOTBV-RAAR =                                 +                  
          SUM-RETOTBV-RAAR + 0.05                                               
       ELSE                                                                     
          IF SUM-RETOTBV-RAAR < 0                                               
             SUM-RETOTBV-RAAR =                              +                  
             SUM-RETOTBV-RAAR - 0.05                                            
          END-IF                                                                
       END-IF                                                                   
                                                                                
       IF SUM-RETOTBV-RAAR-TG > 0                                               
          SUM-RETOTBV-RAAR-TG =                              +                  
          SUM-RETOTBV-RAAR-TG + 0.05                                            
       ELSE                                                                     
          IF SUM-RETOTBV-RAAR-TG < 0                                            
             SUM-RETOTBV-RAAR-TG =                           +                  
             SUM-RETOTBV-RAAR-TG - 0.05                                         
          END-IF                                                                
       END-IF                                                                   
                                                                                
                                                                                
       IF SUM-REFSG-AAR > 0                                                     
          SUM-REFSG-AAR =                                    +                  
          SUM-REFSG-AAR + 0.05                                                  
       ELSE                                                                     
          IF SUM-REFSG-AAR < 0                                                  
             SUM-REFSG-AAR =                                 +                  
             SUM-REFSG-AAR - 0.05                                               
          END-IF                                                                
       END-IF                                                                   
                                                                                
                                                                                
       IF SUM-RELEVANT-AAR > 0                                                  
          SUM-RELEVANT-AAR =                                 +                  
          SUM-RELEVANT-AAR + 0.05                                               
       ELSE                                                                     
          IF SUM-RELEVANT-AAR < 0                                               
             SUM-RELEVANT-AAR =                              +                  
             SUM-RELEVANT-AAR - 0.05                                            
          END-IF                                                                
       END-IF                                                                   
                                                                                
       IF SUM-RELEVANT-RAAR > 0                                                 
          SUM-RELEVANT-RAAR =                                +                  
          SUM-RELEVANT-RAAR + 0.05                                              
       ELSE                                                                     
          IF SUM-RELEVANT-RAAR < 0                                              
             SUM-RELEVANT-RAAR =                             +                  
             SUM-RELEVANT-RAAR - 0.05                                           
          END-IF                                                                
       END-IF                                                                   
                                                                                
       IF SUM-RELEVANT-RAAR > 0                                                 
          SUM-RELEVANT-RAAR =                                +                  
          SUM-RELEVANT-RAAR + 0.05                                              
       ELSE                                                                     
          IF SUM-RELEVANT-RAAR < 0                                              
             SUM-RELEVANT-RAAR =                             +                  
             SUM-RELEVANT-RAAR - 0.05                                           
          END-IF                                                                
       END-IF                                                                   
                                                                                
       W-A1-SUM-SULEVANT-AAR  = RES-SULEVANT-AAR                                
       W-A1-SUM-SUARTFSG-AAR  = (RES-SUARTFSG-AAR + 500)     +                  
                                / 1000                                          
       W-A1-SUM-SULEVANT-RAAR = RES-SULEVANT-RAAR                               
       W-A1-SUM-SUARTFSG-RAAR = (RES-SUARTFSG-RAAR + 500)    +                  
                                / 1000                                          
                                                                                
                                                                                
*       FLYTTA TILL LISTA, VÄRDEN STÖRRE ÄN 99.9  OCH                           
*       VÄRDEN MINDRE ÄN -99.9 GÖRS OM TILL 99.9 RESP                           
*       -99.9.                                                                  
                                                                                
       IF SUM-RELEVANT-AAR > 99.9                                               
          W-A1-SUM-RELEVANT-AAR = 99.9                                          
       ELSE                                                                     
         IF SUM-RELEVANT-AAR < -99.9                                            
            W-A1-SUM-RELEVANT-AAR = -99.9                                       
         ELSE                                                                   
            W-A1-SUM-RELEVANT-AAR = SUM-RELEVANT-AAR                            
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF SUM-REFSG-AAR > 99.9                                                  
          W-A1-SUM-REFSG-AAR = 99.9                                             
       ELSE                                                                     
         IF SUM-REFSG-AAR < -99.9                                               
            W-A1-SUM-REFSG-AAR = -99.9                                          
         ELSE                                                                   
            W-A1-SUM-REFSG-AAR = SUM-REFSG-AAR                                  
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF SUM-RELEVANT-RAAR > 99.9                                              
          W-A1-SUM-RELEVANT-RAAR = 99.9                                         
       ELSE                                                                     
         IF SUM-RELEVANT-RAAR < -99.9                                           
            W-A1-SUM-RELEVANT-RAAR = -99.9                                      
         ELSE                                                                   
            W-A1-SUM-RELEVANT-RAAR = SUM-RELEVANT-RAAR                          
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF SUM-RETOTBV-RAAR-TG > 99.9                                            
          W-A1-SUM-RETOTBV-RAAR-TG = 99.9                                       
       ELSE                                                                     
         IF SUM-RETOTBV-RAAR-TG < -99.9                                         
            W-A1-SUM-RETOTBV-RAAR-TG = -99.9                                    
         ELSE                                                                   
            W-A1-SUM-RETOTBV-RAAR-TG = SUM-RETOTBV-RAAR-TG                      
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       IF SUM-RETOTBV-RAAR > 99.9                                               
          W-A1-SUM-RETOTBV-RAAR = 99.9                                          
       ELSE                                                                     
         IF SUM-RETOTBV-RAAR < -99.9                                            
            W-A1-SUM-RETOTBV-RAAR = -99.9                                       
         ELSE                                                                   
            W-A1-SUM-RETOTBV-RAAR = SUM-RETOTBV-RAAR                            
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       W-A1-SUM-SUTOTBV-RAAR  = (SUM-SUTOTBV-RAAR + 500)     +                  
                                / 1000                                          
                                                                                
       DISPLAY '   '                                                            
       DISPLAY '   '                                                            
       DISPLAY  COL 005 'TOTAL'                              +                  
             COL 039 W-A1-SUM-SULEVANT-AAR                   +                  
             COL 048 W-A1-SUM-SUARTFSG-AAR                   +                  
             COL 056 W-A1-SUM-SULEVANT-RAAR                  +                  
             COL 067 W-A1-SUM-SUARTFSG-RAAR                  +                  
             COL 077 W-A1-SUM-RELEVANT-AAR                   +                  
             COL 084 W-A1-SUM-REFSG-AAR                      +                  
             COL 091 W-A1-SUM-RELEVANT-RAAR                  +                  
             COL 099 W-A1-SUM-RETOTBV-RAAR-TG                +                  
             COL 106 W-A1-SUM-RETOTBV-RAAR                   +                  
             COL 113 W-A1-SUM-SUTOTBV-RAAR                                      
    END-IF                                                                      
    W-TIO-RADER = 1                                                             
END-PROC                                                                        
