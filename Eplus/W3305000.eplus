           W-IDFKNGRP02-F    = W-IDFKNGRP-FOM                                   
           W-IDFKNGRP02-T    = W-IDFKNGRP-TOM                                   
           W-SOEK-IX         = W-SOEK-IX + 1                                    
           W-FUNKTIONS-GRP   = URVAL2-FUNKTIONS-GRP(W-SOEK-IX)                  
           W-IDFKNGRP03-F    = W-IDFKNGRP-FOM                                   
           W-IDFKNGRP03-T    = W-IDFKNGRP-TOM                                   
