            COL 078 'AF4'                                    +                  
            COL 085 'AF4'                                    +                  
            COL 092 'AF2'                                    +                  
            COL 100 'AF2'                                    +                  
            COL 107 'AF2'                                    +                  
            COL 117 'AF2'                                                       
                                                                                
    TITLE 7 COL 078 'AF3'                                    +                  
            COL 085 'AF3'                                    +                  
            COL 092 'AF1'                                    +                  
            COL 100 'AF1'                                    +                  
            COL 118 'TB'                                                        
                                                                                
    TITLE 8 COL 046 'ST'                                     +                  
