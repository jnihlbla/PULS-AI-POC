NEWPAGE                                                                         
*                                                                               
* STEG 1. LÄSER URVALS FILEN FRÅN 3221-BILDEN OCH ARTIKELFILEN W33097,          
*         SKAPAR TEMPFIL01 UT MED DOM ARTIKLAR SOM MATCHAR SELEKTERINGS         
*         VILLKOREN.                                                            
*                                                                               
JOB INPUT NULL START A-INIT                                                     
                                                                                
  PERFORM S01-READ-W3309BD2                                                     
  DO WHILE NOT EOF W3309BD2                                                     
     IF  (IN2-IDARTNR = IN1-IDARTNR) OR                        +                
         ((IN2-KDPRODSL >= IN1-KDPRODSL-FOM AND                +                
           IN2-KDPRODSL <= IN1-KDPRODSL-TOM) AND               +                
         (IN2-IDFKNGRP >= IN1-IDFKNGRP-FOM AND                 +                
          IN2-IDFKNGRP <= IN1-IDFKNGRP-TOM))                                    
                                                                                
       TMP1-IDARTNR  = IN2-IDARTNR2                                             
       PUT TMPFIL01                                                             
     END-IF                                                                     
     PERFORM S01-READ-W3309BD2                                                  
  END-DO                                                                        
  STOP                                                                          
                                                                                
A-INIT. PROC                                                                    
  GET W3309BD1                                                                  
END-PROC.                                                                       
                                                                                
S01-READ-W3309BD2. PROC                                                         
  GET W3309BD2                                                                  
END-PROC.                                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 2. MATCHAR TMPFIL01 MED W33098 (ERSÄTTNINGS FIL) FÖR ATT                 
*         HÄMTA ERSÄTTNINGS INFO FÖR DOM SELEKTERADE ARTIKLARNA.                
*                                                                               
JOB INPUT (TMPFIL01 KEY TMP1-IDARTNR  W3309BD3 KEY IN3-IDARTNR-G)               
    IF MATCHED                                                                  
       TMP2-IDARTNR = IN3-IDARTNR-G                                             
       TMP2-IDARTNR-TILLK = IN3-IDARTNR-N                                       
       TMP2-IDARTNR-TILLK-SISTA = IN3-IDARTNR-S                                 
       TMP2-ANT-IDARTNR-TILLK = IN3-ANT-IDARTNR-TILLK                           
       PUT TMPFIL02                                                             
       TMP2-IDARTNR = IN3-IDARTNR-S                                             
       TMP2-IDARTNR-TILLK = '         '                                         
       TMP2-IDARTNR-TILLK-SISTA = '         '                                   
       TMP2-ANT-IDARTNR-TILLK = 0                                               
       PUT TMPFIL02                                                             
    ELSE                                                                        
       IF TMPFIL01                                                              
          TMP2-IDARTNR = TMP1-IDARTNR                                           
          TMP2-IDARTNR-TILLK = '         '                                      
          TMP2-IDARTNR-TILLK-SISTA = '         '                                
          TMP2-ANT-IDARTNR-TILLK = 0                                            
          PUT TMPFIL02                                                          
          TMP2-IDARTNR = '         '                                            
          TMP2-IDARTNR-TILLK = '         '                                      
          TMP2-IDARTNR-TILLK-SISTA = TMP1-IDARTNR                               
          TMP2-ANT-IDARTNR-TILLK = 0                                            
          PUT TMPFIL02                                                          
       END-IF                                                                   
    END-IF                                                                      
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 3. SORTERAR TMPFIL02 TILL TPMFIL03                                       
*                                                                               
SORT TMPFIL02 TO TMPFIL03 USING(TMP2-IDARTNR-TILLK-SISTA TMP2-IDARTNR)          
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 4. SORTERAR W33098 FIL TILL TPMFIL04                                     
*                                                                               
SORT W3309BD3 TO TMPFIL04 USING(IN3-IDARTNR-TILLK-SISTA IN3-IDARTNR)            
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 5. MATCHAR TMPFIL03 MED TMPFIL04 FÖR ATT HITTA                           
*         TILLKOMMANDE ARTIKLAR I ERSÄTTNINGSKEDJAN.                            
*         UTFIL ÄR TMPFIL05.                                                    
*                                                                               
JOB INPUT NULL START A-INIT                                                     
                                                                                
  IF EOF TMPFIL03 OR EOF TMPFIL04                                               
     PERFORM Z-FINIT                                                            
  END-IF                                                                        
                                                                                
  IF TMP3-IDARTNR-TILLK-SISTA < TMP4-IDARTNR-TILLK-SISTA                        
     TMP5-IDARTNR = TMP3-IDARTNR                                                
     TMP5-IDARTNR-TILLK = TMP3-IDARTNR-TILLK                                    
     TMP5-IDARTNR-TILLK-SISTA = TMP3-IDARTNR-TILLK-SISTA                        
     TMP5-ANT-IDARTNR-TILLK = TMP3-ANT-IDARTNR-TILLK                            
     PUT TMPFIL05                                                               
     PERFORM S01-READ-TMPFIL03                                                  
  ELSE                                                                          
     IF TMP3-IDARTNR-TILLK-SISTA = TMP4-IDARTNR-TILLK-SISTA                     
        TMP5-IDARTNR = TMP4-IDARTNR                                             
        TMP5-IDARTNR-TILLK = TMP4-IDARTNR-TILLK                                 
        TMP5-IDARTNR-TILLK-SISTA = TMP4-IDARTNR-TILLK-SISTA                     
        TMP5-ANT-IDARTNR-TILLK = TMP4-ANT-IDARTNR-TILLK                         
        PUT TMPFIL05                                                            
        PERFORM S02-READ-TMPFIL04                                               
        DO WHILE TMP3-IDARTNR-TILLK-SISTA = TMP4-IDARTNR-TILLK-SISTA  +         
                 AND NOT EOF TMPFIL04                                           
           TMP5-IDARTNR = TMP4-IDARTNR                                          
           TMP5-IDARTNR-TILLK = TMP4-IDARTNR-TILLK                              
           TMP5-IDARTNR-TILLK-SISTA = TMP4-IDARTNR-TILLK-SISTA                  
           TMP5-ANT-IDARTNR-TILLK = TMP4-ANT-IDARTNR-TILLK                      
           PUT TMPFIL05                                                         
           PERFORM S02-READ-TMPFIL04                                            
        END-DO                                                                  
        PERFORM S01-READ-TMPFIL03                                               
     ELSE                                                                       
        PERFORM S02-READ-TMPFIL04                                               
     END-IF                                                                     
  END-IF                                                                        
                                                                                
A-INIT. PROC                                                                    
  PERFORM S01-READ-TMPFIL03                                                     
  PERFORM S02-READ-TMPFIL04                                                     
END-PROC.                                                                       
                                                                                
S01-READ-TMPFIL03. PROC                                                         
  GET TMPFIL03                                                                  
END-PROC.                                                                       
                                                                                
S02-READ-TMPFIL04. PROC                                                         
  GET TMPFIL04                                                                  
END-PROC.                                                                       
                                                                                
Z-FINIT. PROC                                                                   
    IF EOF TMPFIL04                                                             
       DO WHILE NOT EOF TMPFIL03                                                
          TMP5-IDARTNR = TMP3-IDARTNR                                           
          TMP5-IDARTNR-TILLK = TMP3-IDARTNR-TILLK                               
          TMP5-IDARTNR-TILLK-SISTA = TMP3-IDARTNR-TILLK-SISTA                   
          TMP5-ANT-IDARTNR-TILLK = TMP3-ANT-IDARTNR-TILLK                       
          PUT TMPFIL05                                                          
          PERFORM S01-READ-TMPFIL03                                             
       END-DO                                                                   
    ELSE                                                                        
       IF EOF TMPFIL03                                                          
          DO WHILE NOT EOF TMPFIL04                                             
             PERFORM S02-READ-TMPFIL04                                          
          END-DO                                                                
       END-IF                                                                   
    END-IF                                                                      
    STOP                                                                        
END-PROC.                                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 6. SORTERAR TMPFIL05 TILL TPMFIL06                                       
*                                                                               
SORT TMPFIL05 TO TMPFIL06 USING(TMP5-IDARTNR)                                   
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 7. SORTERAR W33098 (ERSÄTTNINGS FIL) TILL TMPFIL07                       
*                                                                               
SORT W3309BD3 TO TMPFIL07 USING(IN3-IDARTNR-TILLK)                              
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 8. MATCHAR TMPFIL06 MED TMPFIL07 FÖR ATT HITTA                           
*         ERSATTA ARTIKELNR I ERSÄTTNINGSKEDJAN.                                
*         UTFIL ÄR TMPFIL08.                                                    
*                                                                               
JOB INPUT NULL START A-INIT                                                     
                                                                                
  IF EOF TMPFIL06 OR EOF TMPFIL07                                               
     PERFORM Z-FINIT                                                            
  END-IF                                                                        
                                                                                
  IF TMP6-IDARTNR < TMP7-IDARTNR-TILLK                                          
     TMP8-IDARTNR = TMP6-IDARTNR                                                
     TMP8-IDARTNR-TILLK = TMP6-IDARTNR-TILLK                                    
     TMP8-IDARTNR-ERSATT = '         '                                          
     TMP8-ANT-IDARTNR-TILLK = TMP6-ANT-IDARTNR-TILLK                            
     PUT TMPFIL08                                                               
     PERFORM S01-READ-TMPFIL06                                                  
  ELSE                                                                          
     IF TMP6-IDARTNR = TMP7-IDARTNR-TILLK                                       
        TMP8-IDARTNR = TMP6-IDARTNR                                             
        TMP8-IDARTNR-TILLK = TMP6-IDARTNR-TILLK                                 
        TMP8-IDARTNR-ERSATT = TMP7-IDARTNR                                      
        TMP8-ANT-IDARTNR-TILLK = TMP6-ANT-IDARTNR-TILLK                         
        PUT TMPFIL08                                                            
        PERFORM S02-READ-TMPFIL07                                               
        PERFORM S01-READ-TMPFIL06                                               
     ELSE                                                                       
        PERFORM S02-READ-TMPFIL07                                               
     END-IF                                                                     
  END-IF                                                                        
                                                                                
A-INIT. PROC                                                                    
  PERFORM S01-READ-TMPFIL06                                                     
  PERFORM S02-READ-TMPFIL07                                                     
END-PROC.                                                                       
                                                                                
S01-READ-TMPFIL06. PROC                                                         
  GET TMPFIL06                                                                  
END-PROC.                                                                       
                                                                                
S02-READ-TMPFIL07. PROC                                                         
  GET TMPFIL07                                                                  
END-PROC.                                                                       
                                                                                
Z-FINIT. PROC                                                                   
    IF EOF TMPFIL07                                                             
       DO WHILE NOT EOF TMPFIL06                                                
          TMP8-IDARTNR = TMP6-IDARTNR                                           
          TMP8-IDARTNR-TILLK = TMP6-IDARTNR-TILLK                               
          TMP8-IDARTNR-ERSATT = '         '                                     
          TMP8-ANT-IDARTNR-TILLK = TMP6-ANT-IDARTNR-TILLK                       
          PUT TMPFIL08                                                          
          PERFORM S01-READ-TMPFIL06                                             
       END-DO                                                                   
    ELSE                                                                        
       IF EOF TMPFIL06                                                          
          DO WHILE NOT EOF TMPFIL07                                             
             PERFORM S02-READ-TMPFIL07                                          
          END-DO                                                                
       END-IF                                                                   
    END-IF                                                                      
    STOP                                                                        
END-PROC.                                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 9. MATCHAR TMPFIL08 MED W33097 (ARTIKEL FIL) FÖR ATT                     
*         LÄGGA TILL ARTIKEL DATA FÖR ALLA ARTIKLAR SOM SKALL MED               
*         PÅ RAPPORT FILEN.                                                     
*         UTFIL ÄR TMPFIL09.                                                    
*                                                                               
JOB INPUT (TMPFIL08 KEY TMP8-IDARTNR  W3309BD2 KEY IN2-IDARTNR2)                
    IF MATCHED                                                                  
       TMP9-IDARTNR = IN2-IDARTNR                                               
       TMP9-BEART   = IN2-BEART                                                 
       TMP9-IDPROJ  = IN2-IDPROJ                                                
       TMP9-TEARTNOT = IN2-TEARTNOT                                             
       TMP9-KDPRODSL = IN2-KDPRODSL                                             
       TMP9-IDFKNGRP = IN2-IDFKNGRP                                             
       TMP9-IDLEVNR = IN2-IDLEVNR                                               
       TMP9-PRARTSTD = IN2-PRARTSTD-2                                           
       TMP9-PRARTSTD-DEC = IN2-PRARTSTD-DEC                                     
       TMP9-TIFINLV = IN2-TIFINLV                                               
       TMP9-KDERS   = IN2-KDERS                                                 
       TMP9-TIERSDAT = IN2-TIERSDAT                                             
       TMP9-TIURPROD = IN2-TIURPROD                                             
       TMP9-IDARTNR-TILLK = TMP8-IDARTNR-TILLK                                  
       TMP9-IDARTNR-ERSATT = TMP8-IDARTNR-ERSATT                                
       TMP9-ANT-IDARTNR-TILLK = TMP8-ANT-IDARTNR-TILLK                          
       PUT TMPFIL09                                                             
    END-IF                                                                      
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 10. MATCHAR TMPFIL09 MED W3309A (FÖRSÄLJNINGS FIL) FÖR ATT               
*          LÄGGA TILL FSG INFO FÖR ALLA ARTIKLAR SOM SKALL MED                  
*          PÅ RAPPORT FILEN.                                                    
*          UTFIL ÄR W3309B.                                                     
*                                                                               
JOB INPUT NULL START A-INIT                                                     
                                                                                
  IF EOF TMPFIL09 OR EOF W3309BD4                                               
     PERFORM Z-FINIT                                                            
  END-IF                                                                        
                                                                                
  IF TMP9-IDARTNR < IN4-IDARTNR                                                 
     W-IDARTNR = TMP9-IDARTNR                                                   
     W-BEART = TMP9-BEART                                                       
     W-IDPROJ = TMP9-IDPROJ                                                     
     W-TEARTNOT = TMP9-TEARTNOT                                                 
     W-KDPRODSL = TMP9-KDPRODSL                                                 
     W-IDFKNGRP = TMP9-IDFKNGRP                                                 
     W-IDLEVNR = TMP9-IDLEVNR                                                   
     W-PRARTSTD = TMP9-PRARTSTD                                                 
     W-PRARTSTD-DEC = TMP9-PRARTSTD-DEC                                         
     IF TMP9-TIFINLV > 0                                                        
       W-PUB-AAR2   = TMP9-TIFINLV-Y                                            
       IF W-PUB-AAR2 >= 50                                                      
          W-PUB-AAR1 = 19                                                       
       ELSE                                                                     
          W-PUB-AAR1 = 20                                                       
       END-IF                                                                   
       W-PUBAAR = W-PUB-AAR                                                     
     ELSE                                                                       
       W-PUBAAR = 0                                                             
     END-IF                                                                     
     W-KDERS = TMP9-KDERS                                                       
     W-ANT-TILLK = TMP9-ANT-IDARTNR-TILLK                                       
     W-IDARTNR-G = TMP9-IDARTNR-ERSATT                                          
     W-IDARTNR-N = TMP9-IDARTNR-TILLK                                           
     W-TIERSDAT = TMP9-TIERSDAT                                                 
     W-FSGAAR = 0                                                               
     W-FSGANT = 0                                                               
     IF W-PUBAAR = 0                                                            
        W-ALDER = 0                                                             
     ELSE                                                                       
        IF W-TIERSDAT > 0                                                       
           W-DEF-ERSDAT = W-TIERSDAT                                            
           W-ERSDAT-AAR2 = W-DEF-ERSDAT-AAR                                     
           IF W-DEF-ERSDAT-AAR >= 50                                            
              W-ERSDAT-AAR1 = 19                                                
           ELSE                                                                 
              W-ERSDAT-AAR1 = 20                                                
           END-IF                                                               
           IF W-ERSDAT-AAR < W-PUBAAR                                           
              W-ALDER = 0                                                       
           ELSE                                                                 
              W-ALDER = (W-ERSDAT-AAR - W-PUBAAR) + 1                           
           END-IF                                                               
        ELSE                                                                    
           IF W-D-AAR < W-PUBAAR                                                
              W-ALDER = 0                                                       
           ELSE                                                                 
              W-ALDER = W-D-AAR - W-PUBAAR                                      
           END-IF                                                               
        END-IF                                                                  
     END-IF                                                                     
     IF W-FORSTA-SW = 'J'                                                       
        W-FORSTA-SW = 'N'                                                       
        UT-AREA = W-RUBRIK                                                      
        PUT W3309BD5                                                            
     END-IF                                                                     
     UT-AREA = W-UTFIL                                                          
     PUT W3309BD5                                                               
     PERFORM S01-READ-TMPFIL09                                                  
  ELSE                                                                          
     IF TMP9-IDARTNR = IN4-IDARTNR                                              
        W-IDARTNR = TMP9-IDARTNR                                                
        W-BEART = TMP9-BEART                                                    
        W-IDPROJ = TMP9-IDPROJ                                                  
        W-TEARTNOT = TMP9-TEARTNOT                                              
        W-KDPRODSL = TMP9-KDPRODSL                                              
        W-IDFKNGRP = TMP9-IDFKNGRP                                              
        W-IDLEVNR = TMP9-IDLEVNR                                                
        W-PRARTSTD = TMP9-PRARTSTD                                              
        W-PRARTSTD-DEC = TMP9-PRARTSTD-DEC                                      
        IF TMP9-TIFINLV > 0                                                     
           W-PUB-AAR2   = TMP9-TIFINLV-Y                                        
           IF W-PUB-AAR2 >= 50                                                  
              W-PUB-AAR1 = 19                                                   
           ELSE                                                                 
              W-PUB-AAR1 = 20                                                   
           END-IF                                                               
           W-PUBAAR = W-PUB-AAR                                                 
        ELSE                                                                    
           W-PUBAAR = 0                                                         
        END-IF                                                                  
        W-KDERS = TMP9-KDERS                                                    
        W-ANT-TILLK = TMP9-ANT-IDARTNR-TILLK                                    
        W-IDARTNR-G = TMP9-IDARTNR-ERSATT                                       
        W-IDARTNR-N = TMP9-IDARTNR-TILLK                                        
        W-TIERSDAT = TMP9-TIERSDAT                                              
        W-FSGAAR   = IN4-TIAAAA-2                                               
        IF W-PUBAAR = 0                                                         
           W-ALDER = 0                                                          
        ELSE                                                                    
           IF W-TIERSDAT > 0                                                    
              W-DEF-ERSDAT = W-TIERSDAT                                         
              W-ERSDAT-AAR2 = W-DEF-ERSDAT-AAR                                  
              IF W-DEF-ERSDAT-AAR >= 50                                         
                 W-ERSDAT-AAR1 = 19                                             
              ELSE                                                              
                 W-ERSDAT-AAR1 = 20                                             
              END-IF                                                            
              IF W-ERSDAT-AAR < W-PUBAAR                                        
                 W-ALDER = 0                                                    
              ELSE                                                              
                 W-ALDER = (W-ERSDAT-AAR - W-PUBAAR) + 1                        
              END-IF                                                            
           ELSE                                                                 
              IF W-D-AAR < W-PUBAAR                                             
                 W-ALDER = 0                                                    
              ELSE                                                              
                 W-ALDER = W-D-AAR - W-PUBAAR                                   
              END-IF                                                            
           END-IF                                                               
        END-IF                                                                  
        W-FSGANT-2 = 0                                                          
        IF IN4-SULEVANT-KDTECKEN = '-'                                          
           W-FSGANT-2 = W-FSGANT-2 - IN4-SULEVANT                               
        ELSE                                                                    
           W-FSGANT-2 = W-FSGANT-2 + IN4-SULEVANT                               
        END-IF                                                                  
        PERFORM S02-READ-W3309BD4                                               
        DO WHILE TMP9-IDARTNR = IN4-IDARTNR AND NOT EOF W3309BD4                
           W-FSGAAR   = IN4-TIAAAA-2                                            
           IF IN4-SULEVANT-KDTECKEN = '-'                                       
              W-FSGANT-2 = W-FSGANT-2 - IN4-SULEVANT                            
           ELSE                                                                 
              W-FSGANT-2 = W-FSGANT-2 + IN4-SULEVANT                            
           END-IF                                                               
           PERFORM S02-READ-W3309BD4                                            
        END-DO                                                                  
        W-FSGANT = W-FSGANT-2                                                   
        IF W-FSGANT-2 < 0                                                       
           W-FSGANT-X = '-'                                                     
        ELSE                                                                    
           W-FSGANT-X = ' '                                                     
        END-IF                                                                  
        IF W-FORSTA-SW = 'J'                                                    
           W-FORSTA-SW = 'N'                                                    
           UT-AREA = W-RUBRIK                                                   
           PUT W3309BD5                                                         
        END-IF                                                                  
        UT-AREA = W-UTFIL                                                       
        PUT W3309BD5                                                            
        PERFORM S01-READ-TMPFIL09                                               
     ELSE                                                                       
        PERFORM S02-READ-W3309BD4                                               
     END-IF                                                                     
  END-IF                                                                        
                                                                                
A-INIT. PROC                                                                    
  W-DAGENS-DATUM = SYSDATE                                                      
  W-D-AAR2 = W-DAGENS-AAR                                                       
  W-D-AAR1 = 20                                                                 
  PERFORM S01-READ-TMPFIL09                                                     
  PERFORM S02-READ-W3309BD4                                                     
END-PROC.                                                                       
                                                                                
S01-READ-TMPFIL09. PROC                                                         
  GET TMPFIL09                                                                  
END-PROC.                                                                       
                                                                                
S02-READ-W3309BD4. PROC                                                         
  GET W3309BD4                                                                  
END-PROC.                                                                       
                                                                                
Z-FINIT. PROC                                                                   
    IF EOF TMPFIL09                                                             
       DO WHILE NOT EOF W3309BD4                                                
          PERFORM S02-READ-W3309BD4                                             
       END-DO                                                                   
    ELSE                                                                        
       IF EOF W3309BD4                                                          
          DO WHILE NOT EOF TMPFIL09                                             
             PERFORM S01-READ-TMPFIL09                                          
          END-DO                                                                
       END-IF                                                                   
    END-IF                                                                      
    STOP                                                                        
END-PROC.                                                                       
