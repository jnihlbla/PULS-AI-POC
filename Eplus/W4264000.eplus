*  PROGRAM    :  W4264000                                              *        
*                                                                      *        
*  FUNKTION   :  KONTROLLRAPPORT                                       *        
*                LISTA ÖVER JUSTERINGAR SENASTE VECKAN                 *        
*                                                                      *        
*  FÖRFATTARE :  INGER NILSSON                                         *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W42640D1                                                                   
*                                                                               
%W4263901  'IN-'                                                                
*                                                                               
NEWPAGE                                                                         
FILE W42640D2  PRINTER FB (121 121)                                             
                                                                                
FILE W42640D3  PRINTER FB (121 121)                                             
                                                                                
FILE W42640D4  PRINTER FB (121 121)                                             
                                                                                
W-IDKR          W   5  N  MASK 'ZZZZZ'  VALUE 0                                 
W-IDARTNR       W   5  P                VALUE 0                                 
JUST-PV-CDC     W   1  A  VALUE 'N'                                             
JUST-PV-ST      W   1  A  VALUE 'N'                                             
JA              W   1  A  VALUE 'J'                                             
NEJ             W   1  A  VALUE 'N'                                             
TITEL-PV        W  35  A  VALUE 'VOLVO CAR CORPORATION, AFTERSALES'             
TITEL-RUBRIK-S  W  38  A  VALUE 'JUSTERADE KONTROLLRAPPORTER FÖR DC='           
TITEL-RUBRIK-GB W  38  A  VALUE 'ADJUSTED INSPECTION REPORTS FOR DC='           
JUST-TEXT-S     W  40  A  VALUE 'INGA JUSTERINGAR GJORDA'                       
JUST-TEXT-GB    W  40  A  VALUE 'NO ADJUSTMENTS MADE    '                       
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
* STEG 1. LISTA ÖVER JUSTERINGAR SENASTE VECKAN                                 
*                                                                               
JOB INPUT W42640D1 FINISH Z-FINISH                                              
                                                                                
    W-IDKR    = IN-IDKR                                                         
    W-IDARTNR = IN-IDARTNR                                                      
    IF IN-IDDC = CDC-SE                                                         
      JUST-PV-CDC = JA                                                          
      PRINT LISTA-PV-CDC                                                        
    ELSE                                                                        
      JUST-PV-ST = JA                                                           
      PRINT LISTA-PV-ST-S                                                       
      PRINT LISTA-PV-ST-GB                                                      
    END-IF                                                                      
Z-FINISH.  PROC                                                                 
    CONTINUE                                                                    
*   IF JUST-PV-CDC = NEJ                                                        
*      PRINT LISTA-PV-CDCX                                                      
*   END-IF                                                                      
*   IF JUST-PV-ST = NEJ                                                         
*      PRINT LISTA-PV-STX-S                                                     
*      PRINT LISTA-PV-STX-GB                                                    
*   END-IF                                                                      
END-PROC                                                                        
NEWPAGE                                                                         
REPORT LISTA-PV-CDC PRINTER W42640D2 LINESIZE 120 NODATE NOADJUST +             
                 SPACE 1                                                        
TITLE 01 TITEL-PV COL 40 'W42640-001 '                     +                    
                  COL 89 'DATUM ' SYSDATE                                       
TITLE 03 TITEL-RUBRIK-S IN-IDDC                                                 
HEADING  W-IDKR             ('KR-NR')                                           
HEADING  W-IDARTNR          ('ARTNR')                                           
HEADING  IN-IDLOPNRM        ('PARTINR')                                         
HEADING  IN-KDKRSTA         ('ST')                                              
HEADING  IN-FLANNULL        ('ANN')                                             
HEADING  IN-KVART-RET       ('RETUR')                                           
HEADING  IN-KVART-SKROT     ('SKROT')                                           
HEADING  IN-KVART-SJUST     ('JUST' 'KOST')                                     
HEADING  IN-KVARBTID        ('ARB'  'TID')                                      
HEADING  IN-SUOMK           ('ARB'  'KOST')                                     
HEADING  IN-SUMAT           ('OMK'  'KOST')                                     
LINE     W-IDKR W-IDARTNR IN-IDLOPNRM IN-KDKRSTA IN-FLANNULL +                  
         IN-KVART-RET IN-KVART-SKROT IN-KVART-SJUST IN-KVARBTID +               
         IN-SUOMK IN-SUMAT                                                      
*                                                                               
REPORT LISTA-PV-CDCX PRINTER W42640D2 LINESIZE 120 NODATE NOADJUST +            
                 SPACE 1  NOHEADING                                             
TITLE 01 TITEL-PV COL 40 'W42640-001 '                     +                    
                  COL 89 'DATUM ' SYSDATE                                       
TITLE 03 TITEL-RUBRIK-S '11'                                                    
*                                                                               
LINE     JUST-TEXT-S                                                            
NEWPAGE                                                                         
REPORT LISTA-PV-ST-S   PRINTER W42640D3 LINESIZE 120 NODATE NOADJUST +          
                 SPACE 1                                                        
TITLE 01 TITEL-PV COL 40 'W42640-002 '                  +                       
                  COL 89 'DATUM ' SYSDATE                                       
TITLE 03 TITEL-RUBRIK-S IN-IDDC                                                 
HEADING  W-IDKR             ('KR-NR')                                           
HEADING  W-IDARTNR          ('ARTNR')                                           
HEADING  IN-IDLOPNRM        ('PARTINR')                                         
HEADING  IN-KDKRSTA         ('STA')                                             
HEADING  IN-FLANNULL        ('ANN')                                             
HEADING  IN-KVART-RET       ('RETUR')                                           
HEADING  IN-KVART-SKROT     ('SKROT')                                           
HEADING  IN-KVART-SJUST     ('JUST' 'KOST')                                     
HEADING  IN-KVARBTID        ('ARB'  'TID')                                      
HEADING  IN-SUOMK           ('ARB'  'KOST')                                     
HEADING  IN-SUMAT           ('OMK'  'KOST')                                     
LINE     W-IDKR W-IDARTNR IN-IDLOPNRM IN-KDKRSTA IN-FLANNULL +                  
         IN-KVART-RET IN-KVART-SKROT IN-KVART-SJUST IN-KVARBTID +               
         IN-SUOMK IN-SUMAT                                                      
*                                                                               
REPORT LISTA-PV-STX-S  PRINTER W42640D3 LINESIZE 120 NODATE NOADJUST +          
                 SPACE 1  NOHEADING                                             
*                                                                               
TITLE 01 TITEL-PV COL 40 'W42640-002 '                  +                       
                  COL 89 'DATUM ' SYSDATE                                       
TITLE 03 TITEL-RUBRIK-S '12'                                                    
*                                                                               
LINE     JUST-TEXT-S                                                            
                                                                                
NEWPAGE                                                                         
REPORT LISTA-PV-ST-GB  PRINTER W42640D4 LINESIZE 120 NODATE NOADJUST +          
                 SPACE 1                                                        
TITLE 01 TITEL-PV COL 40 'W42640-003 '                  +                       
                  COL 89 'DATE  ' SYSDATE                                       
TITLE 03 TITEL-RUBRIK-GB IN-IDDC                                                
HEADING  W-IDKR             ('IR-NO')                                           
HEADING  W-IDARTNR          ('PART ')                                           
HEADING  IN-IDLOPNRM        ('REG.NO ')                                         
HEADING  IN-KDKRSTA         ('STA')                                             
HEADING  IN-FLANNULL        ('CAN')                                             
HEADING  IN-KVART-RET       ('RETUR')                                           
HEADING  IN-KVART-SKROT     ('SCRAP')                                           
HEADING  IN-KVART-SJUST     ('ADJ.' 'COST')                                     
HEADING  IN-KVARBTID        ('LAB'  'TIM')                                      
HEADING  IN-SUOMK           ('LAB'  'COST')                                     
HEADING  IN-SUMAT           ('OTH'  'COST')                                     
LINE     W-IDKR W-IDARTNR IN-IDLOPNRM IN-KDKRSTA IN-FLANNULL +                  
         IN-KVART-RET IN-KVART-SKROT IN-KVART-SJUST IN-KVARBTID +               
         IN-SUOMK IN-SUMAT                                                      
*                                                                               
REPORT LISTA-PV-STX-GB PRINTER W42640D4 LINESIZE 120 NODATE NOADJUST +          
                 SPACE 1  NOHEADING                                             
*                                                                               
TITLE 01 TITEL-PV COL 40 'W42640-003 '                  +                       
                  COL 89 'DATE  ' SYSDATE                                       
TITLE 03 TITEL-RUBRIK-GB '12'                                                   
