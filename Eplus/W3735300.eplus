*                                                                               
NEWPAGE                                                                         
*                                                                               
*****************************************************************               
*                                                               *               
* INFIL W371.W371D3.W3714C(+0) ALLA BYTESRAPPORTER I STATUS 4   *               
*                                                               *               
*****************************************************************               
*                                                                               
FILE W37353D1                                                                   
%W3714C  'IN4C-'                                                                
                                                                                
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* SORTAREA FÖR INFILEN MED BYTESRAPPORTER                       *               
*                                                               *               
*****************************************************************               
                                                                                
FILE TPFIL1 FB(10 0)                                                            
                                                                                
%W3714C   'T4C-'                                                                
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* RAPPORT BYTESUPPFÖLJNING PÅ STATUS 4 TILL CLASSIC DC          *               
*                                                               *               
*****************************************************************               
                                                                                
FILE W37353D2 PRINTER VB (125 0)                                                
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* RAPPORT BYTESUPPFÖLJNING PÅ STATUS 4 TILL WEB DC'S            *               
*                                                               *               
*****************************************************************               
                                                                                
FILE W37353D3 PRINTER VB (125 0)                                                
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* COPYTEXT TILL SUBPGM WL10WBDC                                 *               
*                                                               *               
*****************************************************************               
                                                                                
%WL10WBDC                                                                       
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* COPYTEXT TILL SUBPGM WDATKORT                                 *               
*                                                               *               
*****************************************************************               
                                                                                
%WDATKORT                                                                       
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* HOST VARIABLER                                                *               
*                                                               *               
*****************************************************************               
                                                                                
W-PAGE       W  10  A    VALUE '  PAGE  '                                       
W-SIDA       W  10  A    VALUE '  SIDA  '                                       
W-PGMNAMN    W  6   A    VALUE 'W37353'                                         
W-WDATUM     W  6   A    VALUE '000001'                                         
                                                                                
  W-DATUM          W  6   N                                                     
  W-MM   W-DATUM       2  N                                                     
  W-DD   W-DATUM   +2  2  N                                                     
  W-AAR  W-DATUM   +4  2  N                                                     
                                                                                
W-IDDC            W   2  A                                                      
W-PREV-IDDC-WEB   W   2  A VALUE '  '.                                          
W-PREV-IDDC-CL    W   2  A VALUE '  '.                                          
W-IDDISTR         W   5  N MASK 'ZZZZ9'.                                        
W-KVRETUR         W   7  N MASK 'ZZZZZZ9'.                                      
W-UT-FIX-SE       W   8  A                                                      
W-UT-FIX-1-SE W-UT-FIX-SE    2  A                                               
W-UT-FIX-2-SE W-UT-FIX-SE +2 1  A                                               
W-UT-FIX-3-SE W-UT-FIX-SE +3 2  A                                               
W-UT-FIX-4-SE W-UT-FIX-SE +5 1  A                                               
W-UT-FIX-5-SE W-UT-FIX-SE +6 2  A                                               
W-UT-FIX-US       W   8  A                                                      
W-UT-FIX-1-US W-UT-FIX-US    2  A                                               
W-UT-FIX-2-US W-UT-FIX-US +2 1  A                                               
W-UT-FIX-3-US W-UT-FIX-US +3 2  A                                               
W-UT-FIX-4-US W-UT-FIX-US +5 1  A                                               
W-UT-FIX-5-US W-UT-FIX-US +6 2  A                                               
W-UT-FIX-GB       W   8  A                                                      
W-UT-FIX-1-GB W-UT-FIX-GB    2  A                                               
W-UT-FIX-2-GB W-UT-FIX-GB +2 1  A                                               
W-UT-FIX-3-GB W-UT-FIX-GB +3 2  A                                               
W-UT-FIX-4-GB W-UT-FIX-GB +5 1  A                                               
W-UT-FIX-5-GB W-UT-FIX-GB +6 2  A                                               
W-SUM             W   4 P 0 MASK 'ZZZZZZ9'                                      
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* STEG 2  SORTERA BYTESFILEN PER IDDC IDDISTR IDBYTRAP          *               
*                                                               *               
*****************************************************************               
                                                                                
SORT W37353D1 TO TPFIL1 USING (IN4C-IDDC IN4C-IDDISTR)                          
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* STEG 4  LÄSER TPFIL1                                          *               
*                                                               *               
*****************************************************************               
                                                                                
                                                                                
JOB INPUT(TPFIL1) START INIT-PROC                                               
                                                                                
    W-UT-FIX-1-SE   = W-AAR                                                     
    W-UT-FIX-2-SE   = '-'                                                       
    W-UT-FIX-3-SE   = W-MM                                                      
    W-UT-FIX-4-SE   = '-'                                                       
    W-UT-FIX-5-SE   = W-DD                                                      
    W-UT-FIX-1-GB   = W-DD                                                      
    W-UT-FIX-2-GB   = '-'                                                       
    W-UT-FIX-3-GB   = W-MM                                                      
    W-UT-FIX-4-GB   = '-'                                                       
    W-UT-FIX-5-GB   = W-AAR                                                     
    W-UT-FIX-1-US   = W-MM                                                      
    W-UT-FIX-2-US   = '-'                                                       
    W-UT-FIX-3-US   = W-DD                                                      
    W-UT-FIX-4-US   = '-'                                                       
    W-UT-FIX-5-US   = W-AAR                                                     
                                                                                
    W-IDDISTR     = T4C-IDDISTR                                                 
    W-KVRETUR     = T4C-KVRETUR                                                 
    W-SUM         = W-KVRETUR                                                   
                                                                                
    WBDC-IDDC = T4C-IDDC                                                        
    CALL WL10WBDC USING WBDC-AREA                                               
                                                                                
    IF WBDC-FLWEBDC = 'J'                                                       
       PRINT LISTWEB                                                            
    ELSE                                                                        
       PRINT LISTACL                                                            
    END-IF                                                                      
NEWPAGE                                                                         
                                                                                
INIT-PROC. PROC                                                                 
    CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                           
    W-AAR  = D-AAR                                                              
    W-MM   = D-MAANAD                                                           
    W-DD   = D-DAG                                                              
                                                                                
END-PROC                                                                        
NEWPAGE                                                                         
                                                                                
  REPORT LISTACL                +                                               
         PRINTER W37353D2       +                                               
         LINESIZE 120           +                                               
         SPACE 0                +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NOADJUST               +                                               
         NODATE                 +                                               
         SUMCTL                 +                                               
         DTLCOPY                +                                               
         SUMMARY                                                                
                                                                                
                                                                                
CONTROL FINAL NOPRINT T4C-IDDC W-IDDISTR                                        
                                                                                
SUM W-SUM                                                                       
                                                                                
LINE  1  '    '     +                                                           
         W-IDDISTR  +                                                           
         '        ' +                                                           
         W-SUM      +                                                           
                                                                                
BEFORE-BREAK. PROC                                                              
  IF T4C-IDDC NE W-PREV-IDDC-CL                                                 
   DISPLAY '¤DAPW37353-002'                                                     
   DISPLAY '¤DAP' T4C-IDDC                                                      
   IF T4C-IDDC = CDC-SE                                                         
     DISPLAY W-UT-FIX-SE        +                                               
           '  W37353     '    +                                                 
           'MONTHLY  FOLLOW-UP CORES IN REPORTS IN STATUS 4'                    
   ELSE                                                                         
     IF T4C-IDDC = SDC-NL-ET                                                    
       DISPLAY W-UT-FIX-GB        +                                             
           '  W37353     '    +                                                 
           'MONTHLY  FOLLOW-UP CORES IN REPORTS IN STATUS 4'                    
     ELSE                                                                       
       DISPLAY W-UT-FIX-US        +                                             
           '  W37353     '    +                                                 
           'PERIOD FOLLOWING-UP CORES TREATED TO STATUS 4 NDC ' +               
           T4C-IDDC                                                             
     END-IF                                                                     
   END-IF                                                                       
   IF T4C-IDDC = CDC-SE                                                         
     DISPLAY 'DISTRIKT          ANTAL ARTIKLAR'                                 
   ELSE                                                                         
     DISPLAY 'DISTRICT          QUANTITY'                                       
   END-IF                                                                       
   W-PREV-IDDC-CL = T4C-IDDC                                                    
  END-IF                                                                        
END-PROC                                                                        
                                                                                
                                                                                
  REPORT LISTWEB                +                                               
         PRINTER W37353D3       +                                               
         LINESIZE 120           +                                               
         SPACE 0                +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NOADJUST               +                                               
         NODATE                 +                                               
         SUMCTL                 +                                               
         DTLCOPY                +                                               
         SUMMARY                                                                
                                                                                
CONTROL FINAL NOPRINT T4C-IDDC W-IDDISTR                                        
                                                                                
SUM W-SUM                                                                       
                                                                                
LINE  1  '   '       +                                                          
         W-IDDISTR   +                                                          
         '        '  +                                                          
         W-SUM                                                                  
                                                                                
*                                                                               
BEFORE-BREAK. PROC                                                              
  IF T4C-IDDC NE W-PREV-IDDC-WEB                                                
   DISPLAY '¤DAPW37353-001'                                                     
   DISPLAY '¤DAP' T4C-IDDC                                                      
   DISPLAY W-UT-FIX-US        +                                                 
           '  W37353-001 '    +                                                 
           'PERIOD FOLLOWING-UP CORES TREATED TO STATUS 4 NDC ' +               
           T4C-IDDC                                                             
   DISPLAY 'DISTRICT          QUANTITY'                                         
   W-PREV-IDDC-WEB = T4C-IDDC                                                   
  END-IF                                                                        
END-PROC                                                                        
*                                                                               
