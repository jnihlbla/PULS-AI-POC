                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W515                                                  *        
*                                                                      *        
*  FUNKTION   :  LAGERVÄRDESANALYS (COPY OF W57042)                             
*                                                                      *        
*  FÖRFATTARE :  ANDERS HENRIKSSON                                     *        
*                                                                      *        
*  INFILER    : -W515.W515M2.W51549                                    *        
*                                                                      *        
*  UTDATA     :  EXCELFIL W51550                                       *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W51550D1                                                                   
%W51549  'IN-'                                                                  
                                                                                
*---------------------------------------------*                                 
*TEMPFIL FÖR SORTADE ARTIKELFILER             *                                 
*---------------------------------------------*                                 
FILE TPFIL1 FB(32 0)                                                            
%W51549  'T1-'                                                                  
                                                                                
*---------------------------------------------*                                 
* TEMPFIL MED DIVERSE LISTTRANSAR, EJ SUMMERADE                                 
*---------------------------------------------*                                 
FILE TPFIL2 FB(12 0)                                                            
T2-AREA            1 12 A                                                       
T2-IDDC            1  2 A                                                       
T2-SUNETT          3  7 P 2                                                     
T2-KDPRODSL       10  3 A                                                       
                                                                                
****** EXCELENS UTFIL                                                           
FILE W51550D2 VB(57 0)                                                          
UTAREA         1 53 A                                                           
                                                                                
****** EXCELENS 2:A TOM X:TE RAD                                                
UT-AREA        W 53 A                                                           
UT-IDDC     UT-AREA     2  A                                                    
FILL01      UT-AREA +2  1  A  VALUE ';'                                         
UT-KDPRODSL UT-AREA +3  3  A                                                    
FILL02      UT-AREA +6  1  A  VALUE ';'                                         
UT-TEXT     UT-AREA +7  30 A                                                    
FILL03      UT-AREA +37 1  A  VALUE ';'                                         
UT-SUMMA-N  UT-AREA +38 11 N                                                    
SEMI1       UT-AREA +49 1  A  VALUE '.'                                         
UT-SUMMA-D  UT-AREA +50 2  N                                                    
FILL04      UT-AREA +52 1  A  VALUE ';'                                         
                                                                                
****** EXCELENS FÖRSTA RAD                                                      
W-EXCEL-RUB1             W  23  A                                               
RUB-TEXT    W-EXCEL-RUB1     6  A VALUE 'DATE  '                                
RUB-DATUM   W-EXCEL-RUB1 +6  6  N                                               
RUB-FILL01  W-EXCEL-RUB1 +12 1  A VALUE ';'                                     
RUB-FILL02  W-EXCEL-RUB1 +13 7  A VALUE 'PERIOD '                               
RUB-MÅNAD   W-EXCEL-RUB1 +20 2  N                                               
RUB-FILL03  W-EXCEL-RUB1 +22 1  A VALUE ';'                                     
                                                                                
%WDATKORT                                                                       
                                                                                
*-------------*                                                                 
* ARBETSAREOR *                                                                 
*-------------*                                                                 
W-IDDC           W   2 A                                                        
W-KDPRODSL       W   3 A                                                        
W-SUNETT         W   8 P 2  MASK ('ZZZZZZZZZZZ99.99-')                          
W-KVANTAL        W   5   P   0                                                  
IX               W   2   P   0                                                  
                                                                                
W-SUNETT-FMT                     W  13  N 2                                     
W-SUNETT-N       W-SUNETT-FMT       11  N                                       
W-SUNETT-D       W-SUNETT-FMT +11   2   N                                       
                                                                                
PROGRAM-NAMN     W   6   A  VALUE 'W51550'                                      
DATUMKORT-ID     W   6   A  VALUE 'WDATUM'                                      
                                                                                
W-AAMMDD         W   6   N                                                      
W-AA   W-AAMMDD      2   N                                                      
W-MM   W-AAMMDD  +2  2   N                                                      
W-DD   W-AAMMDD  +4  2   N                                                      
                                                                                
BEPRODSL                W 27  A    OCCURS 38                                    
BEPRODSL-PS  BEPRODSL      2  A                                                 
BEPRODSL-TXT BEPRODSL +3  24  A                                                 
                                                                                
NEWPAGE                                                                         
                                                                                
*---------------------------------------------------------------*               
* STEG 1.SORTERA  ARTIKELSALDOPOSTER ALLA DC PER ARTIKELNUMMER  *               
*---------------------------------------------------------------*               
SORT W51550D1 TO TPFIL1 USING(IN-IDDC)  SIZE 900000                             
                                                                                
JOB INPUT (TPFIL1 KEY (T1-IDDC)) +                                              
          START A-INIT                                                          
  T2-IDDC       = T1-IDDC                                                       
  T2-KDPRODSL   = '90S'                                                         
  T2-SUNETT     = T1-PRARTNTO                                                   
  IF T2-SUNETT NE 0                                                             
    PUT TPFIL2                                                                  
    T2-IDDC     = '00'                                                          
    PUT TPFIL2                                                                  
  END-IF                                                                        
                                                                                
A-INIT. PROC                                                                    
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                      
  W-AA       = D-AAR                                                            
  W-MM       = D-MAANAD                                                         
  W-DD       = D-DAG                                                            
  RUB-DATUM  = W-AAMMDD                                                         
  RUB-MÅNAD  = W-MM                                                             
                                                                                
END-PROC                                                                        
                                                                                
*--------------------------------------------------------*                      
* STEG 3 SORTERA TPFIL2 TILL TPFIL2 PER DC OCH PRODSL                           
*        OCH SUMMERA SAMT SKRIV EXCELFIL                                        
*--------------------------------------------------------*                      
                                                                                
SORT TPFIL2 TO TPFIL2 USING (T2-IDDC ) SIZE 200000                              
                                                                                
JOB INPUT NULL                                                                  
                                                                                
  PERFORM A-INIT-EXCEL                                                          
  GET TPFIL2                                                                    
  IF NOT EOF TPFIL2                                                             
    W-IDDC             = T2-IDDC                                                
    W-KDPRODSL         = T2-KDPRODSL                                            
    W-SUNETT           = 0                                                      
    DO WHILE NOT EOF TPFIL2                                                     
      IF T2-IDDC = W-IDDC                                                       
        W-SUNETT = W-SUNETT + T2-SUNETT                                         
      ELSE                                                                      
        PERFORM SKRIV-EXCELPOST                                                 
        W-IDDC             = T2-IDDC                                            
        W-KDPRODSL         = T2-KDPRODSL                                        
        W-SUNETT           = T2-SUNETT                                          
      END-IF                                                                    
      GET TPFIL2                                                                
    END-DO                                                                      
  END-IF                                                                        
  PERFORM SKRIV-EXCELPOST                                                       
                                                                                
  STOP                                                                          
                                                                                
A-INIT-EXCEL. PROC                                                              
  UTAREA      = W-EXCEL-RUB1                                                    
  PUT W51550D2                                                                  
END-PROC                                                                        
                                                                                
SKRIV-EXCELPOST. PROC                                                           
  UT-IDDC       = W-IDDC                                                        
  UT-KDPRODSL   = W-KDPRODSL                                                    
  UT-TEXT       = 'SURCHAGES'                                                   
  W-SUNETT-FMT  = W-SUNETT                                                      
  UT-SUMMA-N    = W-SUNETT-N                                                    
  UT-SUMMA-D    = W-SUNETT-D                                                    
  UTAREA        = UT-AREA                                                       
  PUT W51550D2                                                                  
END-PROC                                                                        
