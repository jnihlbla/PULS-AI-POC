                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4798900                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR W47922 (WDE4) OCH W47924 (WDE6).              *        
*                SKRIVER W47989 (EFR-POSTER).                          *        
*                                                                      *        
*  FÖRFATTARE :  STEFANO GIOBBI                                        *        
*                                                                      *        
*  DATUM      :  920514                                                *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     940517      STEFANO GIOBBI           57054                       *        
*                 ÄNDRAD BERÄKNING AV EFR-OPACK                        *        
*     ......      ..................       .....                       *        
*                                                                      *        
*----------------------------------------------------------------------*        
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE W47989D1                                                                   
%W47922   'E4-'                                                                 
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W47989D2                                                                   
%W47924   'E6-'                                                                 
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W47989D3 FB (180 0)                                                        
%W47989   'U89-'                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
JA              W  1 A  VALUE 'J'                                               
NEJ             W  1 A  VALUE 'N'                                               
FL-SKRIV-POST   W  1 A                                                          
*                                                                               
ACK-FRS-PACK    W  4 P 0                                                        
*                                                                               
W-IDDISTR       W  3 P 0                                                        
W-IDKUNDNR      W  4 P 0                                                        
W-IDKUNDRF      W 10 A                                                          
W-IDPRODNR      W  4 P 0                                                        
W-IDPURAD       W  3 P 0                                                        
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
JOB INPUT (W47989D1 KEY (E4-IDDISTR        +                                    
                         E4-IDKUNDNR       +                                    
                         E4-IDKUNDRF       +                                    
                         E4-IDPRODNR       +                                    
                         E4-IDPURAD )      +                                    
           W47989D2 KEY (E6-IDDISTR        +                                    
                         E6-IDKUNDNR       +                                    
                         E6-IDKUNDRF       +                                    
                         E6-IDPRODNR       +                                    
                         E6-IDPURAD ))                                          
                                                                                
IF MATCHED                                                                      
  IF E4-IDDISTR    = W-IDDISTR    AND  +                                        
     E4-IDKUNDNR   = W-IDKUNDNR   AND  +                                        
     E4-IDKUNDRF   = W-IDKUNDRF   AND  +                                        
     E4-IDPRODNR   = W-IDPRODNR   AND  +                                        
     E4-IDPURAD    = W-IDPURAD                                                  
    IF E6-IDFAKT = 0                                                            
      IF FL-SKRIV-POST = NEJ                                                    
        FL-SKRIV-POST = JA                                                      
        PERFORM A-FYLL-W47989-POST                                              
        IF E6-KDKOLSTA GE 7                                                     
          U89-KVEFRS-SKEPP = E6-KVLEVART                                        
        ELSE                                                                    
          U89-KVEFRS-PACK = E6-KVLEVART                                         
        END-IF                                                                  
      ELSE                                                                      
        IF E6-KDKOLSTA GE 7                                                     
          U89-KVEFRS-SKEPP = U89-KVEFRS-SKEPP + E6-KVLEVART                     
        ELSE                                                                    
          U89-KVEFRS-PACK = U89-KVEFRS-PACK + E6-KVLEVART                       
        END-IF                                                                  
      END-IF                                                                    
    ELSE                                                                        
      ACK-FRS-PACK = ACK-FRS-PACK + E6-KVLEVART                                 
    END-IF                                                                      
  ELSE                                                                          
    IF FL-SKRIV-POST = JA                                                       
      IF E6-KDKOLSTA GE 7                                                       
        U89-KVEFRS-OPACK = U89-KVAVBART - U89-KVEFRS-PACK              +        
        - ACK-FRS-PACK - U89-KVEFRS-SKEPP                                       
      ELSE                                                                      
        U89-KVEFRS-OPACK = U89-KVAVBART - U89-KVEFRS-PACK - ACK-FRS-PACK        
      END-IF                                                                    
      PUT W47989D3                                                              
      FL-SKRIV-POST = NEJ                                                       
    END-IF                                                                      
                                                                                
    W-IDDISTR         = E4-IDDISTR                                              
    W-IDKUNDNR        = E4-IDKUNDNR                                             
    W-IDKUNDRF        = E4-IDKUNDRF                                             
    W-IDPRODNR        = E4-IDPRODNR                                             
    W-IDPURAD         = E4-IDPURAD                                              
    ACK-FRS-PACK      = 0                                                       
    U89-KVEFRS-PACK   = 0                                                       
    U89-KVEFRS-SKEPP  = 0                                                       
                                                                                
    IF E6-IDFAKT = 0                                                            
      FL-SKRIV-POST   = JA                                                      
      PERFORM A-FYLL-W47989-POST                                                
      IF E6-KDKOLSTA GE 7                                                       
         U89-KVEFRS-SKEPP = E6-KVLEVART                                         
      ELSE                                                                      
        U89-KVEFRS-PACK = E6-KVLEVART                                           
      END-IF                                                                    
    ELSE                                                                        
      ACK-FRS-PACK = ACK-FRS-PACK + E6-KVLEVART                                 
    END-IF                                                                      
  END-IF                                                                        
ELSE                                                                            
  IF FL-SKRIV-POST = JA                                                         
      IF E6-KDKOLSTA GE 7                                                       
         U89-KVEFRS-OPACK = U89-KVAVBART - U89-KVEFRS-PACK             +        
                            - ACK-FRS-PACK - U89-KVEFRS-SKEPP                   
      ELSE                                                                      
         U89-KVEFRS-OPACK = U89-KVAVBART - U89-KVEFRS-PACK +                    
                            - ACK-FRS-PACK                                      
      END-IF                                                                    
    PUT W47989D3                                                                
    FL-SKRIV-POST = NEJ                                                         
  END-IF                                                                        
                                                                                
  IF W47989D1                                                                   
    IF E4-KVLEVART NE 0                                                         
      CONTINUE                                                                  
*     DISPLAY '***********************************************'                 
*     DISPLAY 'KOLLI KOPPLING SAKNAS'                                           
*     DISPLAY 'IDDISTR    >' E4-IDDISTR                                         
*     DISPLAY 'IDKUNDNR   >' E4-IDKUNDNR                                        
*     DISPLAY 'IDKUNDRF   >' E4-IDKUNDRF                                        
*     DISPLAY 'IDPRODNR   >' E4-IDPRODNR                                        
*     DISPLAY 'IDPURAD    >' E4-IDPURAD                                         
*     DISPLAY 'KVLEVART   >' E4-KVLEVART                                        
*     DISPLAY '***********************************************'                 
*RETURN-CODE = 999                                                              
*     STOP EXECUTE                                                              
    ELSE                                                                        
      IF E4-KDRADSTA < 4                                                        
        PERFORM A-FYLL-W47989-POST                                              
        U89-KVEFRS-OPACK = E4-KVAVBART                                          
        U89-KVEFRS-PACK  = 0                                                    
        U89-KVEFRS-SKEPP = 0                                                    
        PUT W47989D3                                                            
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
*                                                                               
NEWPAGE                                                                         
*                                                                               
A-FYLL-W47989-POST.  PROC                                                       
                                                                                
    U89-IDDISTR           = E4-IDDISTR                                          
    U89-IDKUNDNR          = E4-IDKUNDNR                                         
    U89-IDKUNDRF          = E4-IDKUNDRF                                         
    U89-IDPRODNR          = E4-IDPRODNR                                         
    U89-IDPURAD           = E4-IDPURAD                                          
    U89-IDPLKLST          = E4-IDPLKLST                                         
    U89-IDARTNR           = E4-IDARTNR                                          
    U89-REKSIFFR          = E4-REKSIFFR                                         
    U89-IDDC              = E4-IDDC                                             
    U89-KDORDKL           = E4-KDORDKL                                          
    U89-KDFRAKT           = E4-KDFRAKT                                          
    U89-KDRADSTA          = E4-KDRADSTA                                         
    U89-ADLAGOMR          = E4-ADLAGOMR                                         
    U89-IDLEVNR           = E4-IDLEVNR                                          
    U89-KDFAKTYP          = E4-KDFAKTYP                                         
    U89-TIBEGPAC          = E4-TIBEGPAC                                         
    U89-TIUTSKR           = E4-TIUTSKR                                          
    U89-KVORDRAD          = E4-KVORDRAD                                         
    U89-KVORDRAD-PACK     = E4-KVORDRAD-PACK                                    
    U89-TIORDREG          = E4-TIORDREG                                         
    U89-IDARTNR-ERS       = E4-IDARTNR-ERS                                      
    U89-ADLEVPL           = E4-ADLEVPL                                          
    U89-BERADREF          = E4-BERADREF                                         
    U89-LOW-VALUE1        = E4-LOW-VALUE1                                       
    U89-FLDIRLEV          = E4-FLDIRLEV                                         
    U89-FLRESTN           = E4-FLRESTN                                          
    U89-IDKUNDRF-RO       = E4-IDKUNDRF-RO                                      
    U89-KDORDTYP          = E4-KDORDTYP                                         
    U89-KDPRODSL          = E4-KDPRODSL                                         
    U89-IDKONTO           = E4-IDKONTO                                          
    U89-IDKST             = E4-IDKST                                            
    U89-LOW-VALUE2        = E4-LOW-VALUE2                                       
    U89-KVBEART           = E4-KVBEART                                          
    U89-KVAVBART          = E4-KVAVBART                                         
    U89-KVLEVART          = E4-KVLEVART                                         
    U89-PRARTNTO          = E4-PRARTNTO                                         
    U89-PRARTNTO-LOC      = E4-PRARTNTO-LOC                                     
    U89-PRARTNTO-LOCPREL  = E4-PRARTNTO-LOCPREL                                 
    U89-KDVALISO          = E4-KDVALISO                                         
    U89-TIRODAT           = E4-TIRODAT                                          
    U89-TIUTSKR           = E4-TIUTSKR                                          
    U89-VKARTNTO          = E4-VKARTNTO                                         
    U89-VLARTNTO          = E4-VLARTNTO                                         
    U89-KDKVBRYT          = E4-KDKVBRYT                                         
    U89-TIREF1            = 0                                                   
    U89-FLKRED            = ' '                                                 
    U89-IDDIVORD          = 0                                                   
                                                                                
END-PROC.                                                                       
*                                                                               
NEWPAGE                                                                         
