                                                                                
************************************************************************        
***                                                                    *        
***PROGRAM    :  W2164100                                              *        
***                                                                    *        
***FUNKTION   :  SKAPAR INFO VID VECKOSLUT                             *        
***              FÖR MEMO TILL PRISADM OCH CLASSIC                     *        
***                                                                    *        
***FÖRFATTARE :  JAN PETTERSSON                                        *        
***                                                                    *        
***           :                                                        *        
***                                                                    *        
***   DATUM       NAMN                     AVDELNING                   *        
***   ......      ..................       ......                      *        
***   ......      ..................       ......                      *        
***                                                                    *        
************************************************************************        
*IST OFF                                                                        
                                                                                
FILE W21641D1                                                                   
%W21632                                                                         
                                                                                
FILE W21641D2                                                                   
%W01162                                                                         
                                                                                
FILE W21641D3                                                                   
%W91042        'ART-'                                                           
                                                                                
FILE W21641D4                                                                   
%W33504        'PP-'                                                            
                                                                                
FILE W21641D5                                                                   
%W91028L1      'D5-'                                                            
                                                                                
FILE W21641D6   FB (210 0)                                                      
%W21641        'U01-'                                                           
                                                                                
FILE SFIL01 FB(37 0)   VIRTUAL RETAIN                                           
%W21632        'S01-'                                                           
                                                                                
FILE SFIL02 FB(15 0)   VIRTUAL RETAIN                                           
%W91028L1      'KAT-'                                                           
                                                                                
FILE TFIL00 FB(37 0)   VIRTUAL RETAIN                                           
%W21632        'T00-'                                                           
                                                                                
FILE TFIL01 FB(37 0)   VIRTUAL RETAIN                                           
%W21632        'T01-'                                                           
                                                                                
FILE TFIL02 FB(210 0)  VIRTUAL RETAIN                                           
%W21641       'T02-'                                                            
                                                                                
FILE TFIL03 FB(210 0)  VIRTUAL RETAIN                                           
%W21641       'T03-'                                                            
                                                                                
FILE TFIL04 FB(210 0)  VIRTUAL RETAIN                                           
%W21641       'T04-'                                                            
                                                                                
******************************************************                          
***           HJÄLP AREA                           ***                          
******************************************************                          
*                                                                               
  W-LAGRAD             W   3   A                                                
  W-ANTAL              W   3   P                                                
  W-ARTNR              W   5   P                                                
  W-ARTNR2             W   5   P                                                
  W-ART-NOT1           W  40   A                                                
  W-ART-NOT2           W  40   A                                                
  SW1                  W   1   P                                                
  SW2                  W   1  P                                                 
  W02-IDARTNR          W   5  P                                                 
  W02-REKSIFFR         W   1  P                                                 
  W02-BEART-SVE        W  25  A                                                 
  W02-BEART-ENG        W  25  A                                                 
  W02-IDLEVNR          W   5  A                                                 
  W02-KDARTURS         W   2  A                                                 
  W02-IDFKNGRP         W   3  P                                                 
  W02-PRARTSJK         W   5  P  2                                              
  W02-PRARTBTO-MARK-A  W   5  P  2                                              
  W02-VKART            W   4  P  0                                              
  W02-TEARTNOT1        W  40  A                                                 
  W02-TEARTNOT2        W  40  A                                                 
  W02-BEEMBLEM1        W   5  A                                                 
  W02-BEEMBLEM2        W   5  A                                                 
  W02-BEEMBLEM3        W   5  A                                                 
  W02-BEEMBLEM4        W   5  A                                                 
  W02-BEEMBLEM5        W   5  A                                                 
  W02-BEEMBLEM6        W   5  A                                                 
  W02-BEEMBLEM7        W   5  A                                                 
  W02-BEEMBLEM8        W   5  A                                                 
  W02-BEEMBLEM9        W   5  A                                                 
  W02-BEEMBLEM10       W   5  A                                                 
******************************************************                          
                                                                                
 SORT W21641D1 TO SFIL01 USING IDARTNR                                          
*     SORTERA IHOP VECKANS SKROTNINGAR                                          
                                                                                
 JOB INPUT SFIL01                                                               
*     RENSA BORT EV DUBLETTER                                                   
    IF NOT DUPLICATE SFIL01 OR LAST-DUP SFIL01                                  
       PUT TFIL00 FROM SFIL01                                                   
    END-IF                                                                      
                                                                                
 JOB INPUT (TFIL00 KEY T00-IDARTNR W21641D2 KEY NOT-IDARTNR) +                  
          FINISH B-SLUT +                                                       
          NAME   STEG02                                                         
*            KOMPLETERA TFIL01 MED BEREDAR NOTERINGAR                           
    IF MATCHED                                                                  
       IF SW1       = 0                                                         
          SW1       = 1                                                         
          W-ARTNR   = T00-IDARTNR                                               
       END-IF                                                                   
        IF W-ARTNR NE NOT-IDARTNR                                               
           PERFORM C-SKRIV-T02                                                  
           W-ARTNR    = T00-IDARTNR                                             
           W-ART-NOT1 = ' '                                                     
           W-ART-NOT2 = ' '                                                     
        END-IF                                                                  
        IF NOT-KDNOTTYP = 3                                                     
           W-ART-NOT1      = NOT-TEARTNOT                                       
        END-IF                                                                  
        IF NOT-KDNOTTYP  = 7                                                    
           W-ART-NOT2    = NOT-TEARTNOT                                         
        END-IF                                                                  
     ELSE                                                                       
        IF TFIL00                                                               
           IF SW1       = 0                                                     
              SW1       = 1                                                     
              W-ARTNR   = T00-IDARTNR                                           
           END-IF                                                               
           PERFORM C-SKRIV-T02                                                  
           W-ARTNR    = T00-IDARTNR                                             
        END-IF                                                                  
     END-IF                                                                     
B-SLUT.         PROC                                                            
                                                                                
  PERFORM C-SKRIV-T02                                                           
                                                                                
END-PROC                                                                        
                                                                                
C-SKRIV-T02.    PROC                                                            
                                                                                
  T02-IDARTNR          = W-ARTNR                                                
  T02-REKSIFFR         = 0                                                      
  T02-BEART-SVE        = ' '                                                    
  T02-BEART-ENG        = ' '                                                    
  T02-IDLEVNR          = ' '                                                    
  T02-KDARTURS         = ' '                                                    
  T02-IDFKNGRP         = 0                                                      
  T02-PRARTSJK         = 0                                                      
  T02-PRARTBTO-MARK-A  = 0                                                      
  T02-VKART            = 0                                                      
  T02-TEARTNOT (1)     = W-ART-NOT1                                             
  T02-TEARTNOT (2)     = W-ART-NOT2                                             
  T02-BEEMBLEM (1)     = ' '                                                    
  T02-BEEMBLEM (2)     = ' '                                                    
  T02-BEEMBLEM (3)     = ' '                                                    
  T02-BEEMBLEM (4)     = ' '                                                    
  T02-BEEMBLEM (5)     = ' '                                                    
  T02-BEEMBLEM (6)     = ' '                                                    
  T02-BEEMBLEM (7)     = ' '                                                    
  T02-BEEMBLEM (8)     = ' '                                                    
  T02-BEEMBLEM (9)     = ' '                                                    
  T02-BEEMBLEM (10)    = ' '                                                    
  PUT TFIL02                                                                    
                                                                                
END-PROC                                                                        
                                                                                
JOB INPUT (TFIL02 KEY T02-IDARTNR W21641D3 KEY ART-IDARTNR)                     
                                                                                
*     KOMPLETTERA T02 MED ARTIKEL-DATA                                          
                                                                                
  IF MATCHED                                                                    
     T02-REKSIFFR      = ART-REKSIFFR                                           
     T02-BEART-SVE     = ART-BEART (8)                                          
     T02-BEART-ENG     = ART-BEART (4)                                          
     T02-IDLEVNR       = ART-IDLEVNR                                            
     T02-KDARTURS      = ART-KDARTURS                                           
     T02-IDFKNGRP      = ART-IDFKNGRP                                           
     T02-PRARTSJK      = ART-PRARTSJK                                           
     T02-VKART         = ART-VKART                                              
     PUT TFIL03 FROM TFIL02                                                     
                                                                                
  END-IF                                                                        
                                                                                
JOB INPUT (TFIL03 KEY T03-IDARTNR W21641D4 KEY PP-IDARTNR)                      
                                                                                
*     KOMPLETTERA T03 MED BRUTTOPRIS                                            
                                                                                
  IF MATCHED                                                                    
     T03-PRARTBTO-MARK-A = PP-PRARTBTO-MARK-A                                   
     PUT TFIL04 FROM TFIL03                                                     
  ELSE                                                                          
     IF TFIL03                                                                  
        PUT TFIL04 FROM TFIL03                                                  
     END-IF                                                                     
  END-IF                                                                        
                                                                                
SORT W21641D5 TO SFIL02 USING D5-IDARTNR                                        
                                                                                
JOB INPUT (TFIL04 KEY T04-IDARTNR SFIL02 KEY KAT-IDARTNR) +                     
           FINISH F-SLUT                                                        
                                                                                
*     KOMPLETTERA T04 MED EMBLEM                                                
                                                                                
  IF MATCHED                                                                    
     IF SW2       = 0                                                           
        SW2       = 1                                                           
        W-ARTNR2  = T04-IDARTNR                                                 
        PERFORM D-LAGRA-T04                                                     
     END-IF                                                                     
     IF W-ARTNR2 NE T04-IDARTNR                                                 
           PERFORM E-SKRIV-U01                                                  
           W-ARTNR2 = T04-IDARTNR                                               
           PERFORM D-LAGRA-T04                                                  
           PERFORM DA-BLANKA                                                    
     END-IF                                                                     
           PERFORM DB-SPARA-EMBLEM                                              
           W-LAGRAD = 'JA'                                                      
  ELSE                                                                          
     IF TFIL04                                                                  
        IF W-LAGRAD  = 'JA'                                                     
           PERFORM E-SKRIV-U01                                                  
           W-LAGRAD  = 'NEJ'                                                    
        END-IF                                                                  
        PERFORM DA-BLANKA                                                       
        PERFORM D-LAGRA-T04                                                     
        PERFORM E-SKRIV-U01                                                     
        W-ARTNR2 = T04-IDARTNR                                                  
     END-IF                                                                     
  END-IF                                                                        
*                                                                               
D-LAGRA-T04.    PROC                                                            
                                                                                
  W02-IDARTNR          = T04-IDARTNR                                            
  W02-REKSIFFR         = T04-REKSIFFR                                           
  W02-BEART-SVE        = T04-BEART-SVE                                          
  W02-BEART-ENG        = T04-BEART-ENG                                          
  W02-IDLEVNR          = T04-IDLEVNR                                            
  W02-KDARTURS         = T04-KDARTURS                                           
  W02-IDFKNGRP         = T04-IDFKNGRP                                           
  W02-PRARTSJK         = T04-PRARTSJK                                           
  W02-PRARTBTO-MARK-A  = T04-PRARTBTO-MARK-A                                    
  W02-VKART            = T04-VKART                                              
  W02-TEARTNOT1        = T04-TEARTNOT (1)                                       
  W02-TEARTNOT2        = T04-TEARTNOT (2)                                       
                                                                                
END-PROC                                                                        
                                                                                
 DA-BLANKA.  PROC                                                               
                                                                                
           W02-BEEMBLEM1    = ' '                                               
           W02-BEEMBLEM2    = ' '                                               
           W02-BEEMBLEM3    = ' '                                               
           W02-BEEMBLEM4    = ' '                                               
           W02-BEEMBLEM5    = ' '                                               
           W02-BEEMBLEM6    = ' '                                               
           W02-BEEMBLEM7    = ' '                                               
           W02-BEEMBLEM8    = ' '                                               
           W02-BEEMBLEM9    = ' '                                               
           W02-BEEMBLEM10   = ' '                                               
  END-PROC                                                                      
                                                                                
DB-SPARA-EMBLEM.         PROC                                                   
 IF W02-BEEMBLEM1 = ' '                                                         
    W02-BEEMBLEM1 = KAT-BEEMBLEM                                                
 ELSE                                                                           
  IF W02-BEEMBLEM2 = ' '                                                        
     W02-BEEMBLEM2 = KAT-BEEMBLEM                                               
  ELSE                                                                          
   IF W02-BEEMBLEM3 = ' '                                                       
      W02-BEEMBLEM3 = KAT-BEEMBLEM                                              
   ELSE                                                                         
    IF W02-BEEMBLEM4 = ' '                                                      
       W02-BEEMBLEM4 = KAT-BEEMBLEM                                             
    ELSE                                                                        
     IF W02-BEEMBLEM5 = ' '                                                     
        W02-BEEMBLEM5 = KAT-BEEMBLEM                                            
     ELSE                                                                       
      IF W02-BEEMBLEM6 = ' '                                                    
           W02-BEEMBLEM6 = KAT-BEEMBLEM                                         
      ELSE                                                                      
       IF W02-BEEMBLEM7 = ' '                                                   
          W02-BEEMBLEM7 = KAT-BEEMBLEM                                          
       ELSE                                                                     
        IF W02-BEEMBLEM8 = ' '                                                  
           W02-BEEMBLEM8 = KAT-BEEMBLEM                                         
        ELSE                                                                    
         IF W02-BEEMBLEM9 = ' '                                                 
            W02-BEEMBLEM9 = KAT-BEEMBLEM                                        
         ELSE                                                                   
          IF W02-BEEMBLEM10 = ' '                                               
             W02-BEEMBLEM10 = KAT-BEEMBLEM                                      
          END-IF                                                                
        END-IF                                                                  
       END-IF                                                                   
      END-IF                                                                    
     END-IF                                                                     
    END-IF                                                                      
   END-IF                                                                       
  END-IF                                                                        
 END-IF                                                                         
END-IF                                                                          
                                                                                
 END-PROC                                                                       
                                                                                
E-SKRIV-U01.   PROC                                                             
                                                                                
  IF W02-IDLEVNR = '10987' 'BQ8VA'                                              
     CONTINUE                                                                   
  ELSE                                                                          
     U01-IDARTNR          = W02-IDARTNR                                         
     U01-REKSIFFR         = W02-REKSIFFR                                        
     U01-BEART-SVE        = W02-BEART-SVE                                       
     U01-BEART-ENG        = W02-BEART-ENG                                       
     U01-IDLEVNR          = W02-IDLEVNR                                         
     U01-KDARTURS         = W02-KDARTURS                                        
     U01-IDFKNGRP         = W02-IDFKNGRP                                        
     U01-PRARTSJK         = W02-PRARTSJK                                        
     U01-PRARTBTO-MARK-A  = W02-PRARTBTO-MARK-A                                 
     U01-VKART            = W02-VKART                                           
     U01-TEARTNOT (1)     = W02-TEARTNOT1                                       
     U01-TEARTNOT (2)     = W02-TEARTNOT2                                       
     U01-BEEMBLEM (1)     = W02-BEEMBLEM1                                       
     U01-BEEMBLEM (2)     = W02-BEEMBLEM2                                       
     U01-BEEMBLEM (3)     = W02-BEEMBLEM3                                       
     U01-BEEMBLEM (4)     = W02-BEEMBLEM4                                       
     U01-BEEMBLEM (5)     = W02-BEEMBLEM5                                       
     U01-BEEMBLEM (6)     = W02-BEEMBLEM6                                       
     U01-BEEMBLEM (7)     = W02-BEEMBLEM7                                       
     U01-BEEMBLEM (8)     = W02-BEEMBLEM8                                       
     U01-BEEMBLEM (9)     = W02-BEEMBLEM9                                       
     U01-BEEMBLEM (10)    = W02-BEEMBLEM10                                      
     PUT W21641D6                                                               
  END-IF                                                                        
                                                                                
  END-PROC                                                                      
*                                                                               
                                                                                
 F-SLUT.   PROC                                                                 
                                                                                
 PERFORM E-SKRIV-U01                                                            
                                                                                
END-PROC                                                                        
*                                                                               
