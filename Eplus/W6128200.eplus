*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. SUMMERAR IHOP OCH SKRIVER LISTA                                       
*                                                                               
JOB INPUT W61282D1                                        +                     
                                START  A-INIT             +                     
                                FINISH Z-FINIT                                  
                                                                                
  PERFORM S01-KOLLA-INTERVALL                                                   
                                                                                
  IF RECORD-COUNT = 1                                                           
    SPAR-IDDC           = IN-IDDC                                               
    SPAR-BUYERINTERVALL = WS-BUYERINTERVALL                                     
  END-IF                                                                        
                                                                                
  IF WS-BUYERINTERVALL NE SPAR-BUYERINTERVALL OR IN-IDDC NE SPAR-IDDC           
    PERFORM S23-CHECK-SPAR-IDDC                                                 
    IF IN-IDDC NE SPAR-IDDC                                                     
      PERFORM S02-FLYTTA-INTERVALL-TILL-SKRIV                                   
      IF SPAR-IDDC = NDC-US                                                     
        PERFORM S06-RAKNA-UPP-FALT-USA                                          
      END-IF                                                                    
      IF SPAR-IDDC = NDC-CA                                                     
        PERFORM S06A-RAKNA-UPP-FALT-CANADA                                      
      END-IF                                                                    
      PERFORM S03-FLYTTA-TOT-TILL-SKRIV                                         
    ELSE                                                                        
      PERFORM S02-FLYTTA-INTERVALL-TILL-SKRIV                                   
    END-IF                                                                      
    IF (SPAR-IDDC = NDC-AU) OR (SPAR-IDDC = NDC-JP-61)                          
       PERFORM S05B-RAKNA-UPP-FALT                                              
    ELSE                                                                        
       PERFORM S05A-RAKNA-UPP-FALT                                              
    END-IF                                                                      
    SPAR-BUYERINTERVALL = WS-BUYERINTERVALL                                     
    SPAR-IDDC           = IN-IDDC                                               
  ELSE                                                                          
    IF (SPAR-IDDC = NDC-AU) OR (SPAR-IDDC = NDC-JP-61)                          
       PERFORM S05B-RAKNA-UPP-FALT                                              
    ELSE                                                                        
       PERFORM S05A-RAKNA-UPP-FALT                                              
    END-IF                                                                      
  END-IF                                                                        
*                                                                               
A-INIT. PROC                                                                    
      CALL DATKORT USING (PGM-NAMN DATKORT-ID DATUMKORT)                        
      W-AA = D-AAR                                                              
      W-MM = D-MAANAD                                                           
      W-DD = D-DAG                                                              
                                                                                
END-PROC                                                                        
*    --- S23-CHECK-SPAR-IDDC (MACRO PROCEDURE)                                  
%WWDC02 'SPAR-'                                                                 
*                                                                               
*                                                                               
Z-FINIT. PROC                                                                   
      PERFORM S02-FLYTTA-INTERVALL-TILL-SKRIV                                   
      IF SPAR-IDDC = NDC-US                                                     
        PERFORM S06-RAKNA-UPP-FALT-USA                                          
      END-IF                                                                    
      IF SPAR-IDDC = NDC-CA                                                     
        PERFORM S06A-RAKNA-UPP-FALT-CANADA                                      
      END-IF                                                                    
      PERFORM S03-FLYTTA-TOT-TILL-SKRIV                                         
      PERFORM S04-FLYTTA-USA-TOT-TILL-SKRIV                                     
      PERFORM S04A-FLYTTA-CAN-TOT-TILL-SKRIV                                    
END-PROC                                                                        
*                                                                               
S01-KOLLA-INTERVALL. PROC                                                       
      IF IN-IDPERSON-BUY < 80                                                   
        WS-BUYERINTERVALL = 1                                                   
      ELSE                                                                      
        IF IN-IDPERSON-BUY < 97                                                 
          WS-BUYERINTERVALL = 2                                                 
        ELSE                                                                    
          WS-BUYERINTERVALL = 3                                                 
        END-IF                                                                  
      END-IF                                                                    
END-PROC                                                                        
*                                                                               
S02-FLYTTA-INTERVALL-TILL-SKRIV. PROC                                           
      IF SPAR-BUYERINTERVALL = 1                                                
        WS-BUYER-TEXT             = ' 0-79    '                                 
      END-IF                                                                    
      IF SPAR-BUYERINTERVALL = 2                                                
        WS-BUYER-TEXT             = '80-96    '                                 
      END-IF                                                                    
      IF SPAR-BUYERINTERVALL = 3                                                
        WS-BUYER-TEXT             = '97-99    '                                 
      END-IF                                                                    
      IF WS-PRLS < 0                                                            
         PRLS-TECKEN              = '-'                                         
      ELSE                                                                      
         PRLS-TECKEN              = ' '                                         
      END-IF                                                                    
      WS-PRLS-SKRIV ROUNDED       = WS-PRLS                                     
      IF WS-AVAIL < 0                                                           
         AVAIL-TECKEN             = '-'                                         
      ELSE                                                                      
         AVAIL-TECKEN             = ' '                                         
      END-IF                                                                    
      WS-AVAIL-SKRIV ROUNDED      = WS-AVAIL                                    
      IF WS-PRUTRS < 0                                                          
         PRUTRS-TECKEN            = '-'                                         
      ELSE                                                                      
         PRUTRS-TECKEN            = ' '                                         
      END-IF                                                                    
      WS-PRUTRS-SKRIV ROUNDED     = WS-PRUTRS                                   
      IF WS-PROKS < 0                                                           
         PROKS-TECKEN             = '-'                                         
      ELSE                                                                      
         PROKS-TECKEN             = ' '                                         
      END-IF                                                                    
      WS-PROKS-SKRIV ROUNDED      = WS-PROKS                                    
      IF WS-PRRESS < 0                                                          
         PRRESS-TECKEN            = '-'                                         
      ELSE                                                                      
         PRRESS-TECKEN            = ' '                                         
      END-IF                                                                    
      WS-PRRESS-SKRIV ROUNDED     = WS-PRRESS                                   
      IF WS-PRROS < 0                                                           
         PRROS-TECKEN             = '-'                                         
      ELSE                                                                      
         PRROS-TECKEN             = ' '                                         
      END-IF                                                                    
      WS-PRROS-SKRIV ROUNDED      = WS-PRROS                                    
      IF WS-PREFRS < 0                                                          
         PREFRS-TECKEN            = '-'                                         
      ELSE                                                                      
         PREFRS-TECKEN            = ' '                                         
      END-IF                                                                    
      WS-PREFRS-SKRIV ROUNDED     = WS-PREFRS                                   
      IF WS-SUAKSV-SDC < 0                                                      
         SUAKSV-SDC-TECKEN        = '-'                                         
      ELSE                                                                      
         SUAKSV-SDC-TECKEN        = ' '                                         
      END-IF                                                                    
      WS-SUAKSV-SDC-SKRIV ROUNDED = WS-SUAKSV-SDC                               
      IF WS-SUAKSV-PAV < 0                                                      
         SUAKSV-PAV-TECKEN        = '-'                                         
      ELSE                                                                      
         SUAKSV-PAV-TECKEN        = ' '                                         
      END-IF                                                                    
      WS-SUAKSV-PAV-SKRIV ROUNDED = WS-SUAKSV-PAV                               
      IF WS-PRBEART < 0                                                         
         PRBEART-TECKEN           = '-'                                         
      ELSE                                                                      
         PRBEART-TECKEN           = ' '                                         
      END-IF                                                                    
      WS-PRBEART-SKRIV ROUNDED    = WS-PRBEART                                  
      IF WS-SPARR < 0                                                           
         SPARR-TECKEN             = '-'                                         
      ELSE                                                                      
         SPARR-TECKEN             = ' '                                         
      END-IF                                                                    
      WS-SPARR-SKRIV ROUNDED      = WS-SPARR                                    
                                                                                
      WS-OUT-PRLS-SKRIV       ROUNDED = WS-PRLS                                 
      WS-OUT-AVAIL-SKRIV      ROUNDED = WS-AVAIL                                
      WS-OUT-PRUTRS-SKRIV     ROUNDED = WS-PRUTRS                               
      WS-OUT-PROKS-SKRIV      ROUNDED = WS-PROKS                                
      WS-OUT-PRRESS-SKRIV     ROUNDED = WS-PRRESS                               
      WS-OUT-PRROS-SKRIV      ROUNDED = WS-PRROS                                
      WS-OUT-PREFRS-SKRIV     ROUNDED = WS-PREFRS                               
      WS-OUT-SUAKSV-SDC-SKRIV ROUNDED = WS-SUAKSV-SDC                           
      WS-OUT-SUAKSV-PAV-SKRIV ROUNDED = WS-SUAKSV-PAV                           
      WS-OUT-PRBEART-SKRIV    ROUNDED = WS-PRBEART                              
      WS-OUT-SPARR-SKRIV      ROUNDED = WS-SPARR                                
                                                                                
      PERFORM S07-SKRIV-LISTA                                                   
                                                                                
      WS-PRLS                     = 0                                           
      WS-AVAIL                    = 0                                           
      WS-PRUTRS                   = 0                                           
      WS-PROKS                    = 0                                           
      WS-PRRESS                   = 0                                           
      WS-PRROS                    = 0                                           
      WS-PREFRS                   = 0                                           
      WS-SUAKSV-SDC               = 0                                           
      WS-SUAKSV-PAV               = 0                                           
      WS-PRBEART                  = 0                                           
      WS-SPARR                    = 0                                           
END-PROC                                                                        
*                                                                               
S03-FLYTTA-TOT-TILL-SKRIV. PROC                                                 
      WS-BUYER-TEXT               = 'TOTAL    '                                 
      IF WS-PRLS-TOT < 0                                                        
         PRLS-TECKEN              = '-'                                         
      ELSE                                                                      
         PRLS-TECKEN              = ' '                                         
      END-IF                                                                    
      WS-PRLS-SKRIV ROUNDED       = WS-PRLS-TOT                                 
      IF WS-AVAIL-TOT < 0                                                       
         AVAIL-TECKEN             = '-'                                         
      ELSE                                                                      
         AVAIL-TECKEN             = ' '                                         
      END-IF                                                                    
      WS-AVAIL-SKRIV ROUNDED      = WS-AVAIL-TOT                                
      IF WS-PRUTRS-TOT < 0                                                      
         PRUTRS-TECKEN            = '-'                                         
      ELSE                                                                      
         PRUTRS-TECKEN            = ' '                                         
      END-IF                                                                    
      WS-PRUTRS-SKRIV ROUNDED     = WS-PRUTRS-TOT                               
      IF WS-PROKS-TOT < 0                                                       
         PROKS-TECKEN             = '-'                                         
      ELSE                                                                      
         PROKS-TECKEN             = ' '                                         
      END-IF                                                                    
      WS-PROKS-SKRIV ROUNDED      = WS-PROKS-TOT                                
      IF WS-PRRESS-TOT < 0                                                      
         PRRESS-TECKEN            = '-'                                         
      ELSE                                                                      
         PRRESS-TECKEN            = ' '                                         
      END-IF                                                                    
      WS-PRRESS-SKRIV ROUNDED     = WS-PRRESS-TOT                               
      IF WS-PRROS-TOT < 0                                                       
         PRROS-TECKEN             = '-'                                         
      ELSE                                                                      
         PRROS-TECKEN             = ' '                                         
      END-IF                                                                    
      WS-PRROS-SKRIV ROUNDED      = WS-PRROS-TOT                                
      IF WS-PREFRS-TOT < 0                                                      
         PREFRS-TECKEN            = '-'                                         
      ELSE                                                                      
         PREFRS-TECKEN            = ' '                                         
      END-IF                                                                    
      WS-PREFRS-SKRIV ROUNDED     = WS-PREFRS-TOT                               
      IF WS-SUAKSV-SDC-TOT < 0                                                  
         SUAKSV-SDC-TECKEN        = '-'                                         
      ELSE                                                                      
         SUAKSV-SDC-TECKEN        = ' '                                         
      END-IF                                                                    
      WS-SUAKSV-SDC-SKRIV ROUNDED = WS-SUAKSV-SDC-TOT                           
      IF WS-SUAKSV-PAV-TOT <  0                                                 
         SUAKSV-PAV-TECKEN        = '-'                                         
      ELSE                                                                      
         SUAKSV-PAV-TECKEN        = ' '                                         
      END-IF                                                                    
      WS-SUAKSV-PAV-SKRIV ROUNDED = WS-SUAKSV-PAV-TOT                           
      IF WS-PRBEART-TOT < 0                                                     
         PRBEART-TECKEN           = '-'                                         
      ELSE                                                                      
         PRBEART-TECKEN           = ' '                                         
      END-IF                                                                    
      WS-PRBEART-SKRIV ROUNDED    = WS-PRBEART-TOT                              
      IF WS-SPARR-TOT < 0                                                       
         SPARR-TECKEN             = '-'                                         
      ELSE                                                                      
         SPARR-TECKEN             = ' '                                         
      END-IF                                                                    
      WS-SPARR-SKRIV ROUNDED      = WS-SPARR-TOT                                
                                                                                
      WS-OUT-PRLS-SKRIV       ROUNDED = WS-PRLS-TOT                             
      WS-OUT-AVAIL-SKRIV      ROUNDED = WS-AVAIL-TOT                            
      WS-OUT-PRUTRS-SKRIV     ROUNDED = WS-PRUTRS-TOT                           
      WS-OUT-PROKS-SKRIV      ROUNDED = WS-PROKS-TOT                            
      WS-OUT-PRRESS-SKRIV     ROUNDED = WS-PRRESS-TOT                           
      WS-OUT-PRROS-SKRIV      ROUNDED = WS-PRROS-TOT                            
      WS-OUT-PREFRS-SKRIV     ROUNDED = WS-PREFRS-TOT                           
      WS-OUT-SUAKSV-SDC-SKRIV ROUNDED = WS-SUAKSV-SDC-TOT                       
      WS-OUT-SUAKSV-PAV-SKRIV ROUNDED = WS-SUAKSV-PAV-TOT                       
      WS-OUT-PRBEART-SKRIV    ROUNDED = WS-PRBEART-TOT                          
      WS-OUT-SPARR-SKRIV      ROUNDED = WS-SPARR-TOT                            
                                                                                
      PERFORM S07-SKRIV-LISTA                                                   
                                                                                
      WS-PRLS-TOT                 = 0                                           
      WS-AVAIL-TOT                = 0                                           
      WS-PRUTRS-TOT               = 0                                           
      WS-PROKS-TOT                = 0                                           
      WS-PRRESS-TOT               = 0                                           
      WS-PRROS-TOT                = 0                                           
      WS-PREFRS-TOT               = 0                                           
      WS-SUAKSV-SDC-TOT           = 0                                           
      WS-SUAKSV-PAV-TOT           = 0                                           
      WS-PRBEART-TOT              = 0                                           
      WS-SPARR-TOT                = 0                                           
END-PROC                                                                        
*                                                                               
S04-FLYTTA-USA-TOT-TILL-SKRIV. PROC                                             
      WS-BUYER-TEXT               = 'TOTAL USA'                                 
      SPAR-IDDC                   = '4X'                                        
      IF WS-PRLS-USA < 0                                                        
         PRLS-TECKEN              = '-'                                         
      ELSE                                                                      
         PRLS-TECKEN              = ' '                                         
      END-IF                                                                    
      WS-PRLS-SKRIV ROUNDED       = WS-PRLS-USA                                 
      IF WS-AVAIL-USA < 0                                                       
         AVAIL-TECKEN             = '-'                                         
      ELSE                                                                      
         AVAIL-TECKEN             = ' '                                         
      END-IF                                                                    
      WS-AVAIL-SKRIV ROUNDED      = WS-AVAIL-USA                                
      IF WS-PRUTRS-USA < 0                                                      
         PRUTRS-TECKEN            = '-'                                         
      ELSE                                                                      
         PRUTRS-TECKEN            = ' '                                         
      END-IF                                                                    
      WS-PRUTRS-SKRIV ROUNDED     = WS-PRUTRS-USA                               
      IF WS-PROKS-USA < 0                                                       
         PROKS-TECKEN             = '-'                                         
      ELSE                                                                      
         PROKS-TECKEN             = ' '                                         
      END-IF                                                                    
      WS-PROKS-SKRIV ROUNDED      = WS-PROKS-USA                                
      IF WS-PRRESS-USA < 0                                                      
         PRRESS-TECKEN            = '-'                                         
      ELSE                                                                      
         PRRESS-TECKEN            = ' '                                         
      END-IF                                                                    
      WS-PRRESS-SKRIV ROUNDED     = WS-PRRESS-USA                               
      IF WS-PRROS-USA < 0                                                       
         PRROS-TECKEN             = '-'                                         
      ELSE                                                                      
         PRROS-TECKEN             = ' '                                         
      END-IF                                                                    
      WS-PRROS-SKRIV ROUNDED      = WS-PRROS-USA                                
      IF WS-PREFRS-USA < 0                                                      
         PREFRS-TECKEN            = '-'                                         
      ELSE                                                                      
         PREFRS-TECKEN            = ' '                                         
      END-IF                                                                    
      WS-PREFRS-SKRIV ROUNDED     = WS-PREFRS-USA                               
      IF WS-SUAKSV-SDC-USA < 0                                                  
         SUAKSV-SDC-TECKEN        = '-'                                         
      ELSE                                                                      
         SUAKSV-SDC-TECKEN        = ' '                                         
      END-IF                                                                    
      WS-SUAKSV-SDC-SKRIV ROUNDED = WS-SUAKSV-SDC-USA                           
      IF WS-SUAKSV-PAV-USA <  0                                                 
         SUAKSV-PAV-TECKEN        = '-'                                         
      ELSE                                                                      
         SUAKSV-PAV-TECKEN        = ' '                                         
      END-IF                                                                    
      WS-SUAKSV-PAV-SKRIV ROUNDED = WS-SUAKSV-PAV-USA                           
      IF WS-PRBEART-USA < 0                                                     
         PRBEART-TECKEN           = '-'                                         
      ELSE                                                                      
         PRBEART-TECKEN           = ' '                                         
      END-IF                                                                    
      WS-PRBEART-SKRIV ROUNDED    = WS-PRBEART-USA                              
      IF WS-SPARR-USA < 0                                                       
         SPARR-TECKEN             = '-'                                         
      ELSE                                                                      
         SPARR-TECKEN             = ' '                                         
      END-IF                                                                    
      WS-SPARR-SKRIV ROUNDED      = WS-SPARR-USA                                
                                                                                
      PERFORM S07-SKRIV-LISTA                                                   
                                                                                
END-PROC                                                                        
*                                                                               
*                                                                               
S04A-FLYTTA-CAN-TOT-TILL-SKRIV. PROC                                            
      WS-BUYER-TEXT               = ' '                                         
      SPAR-IDDC                   = '51'                                        
                                                                                
      WS-OUT-PRLS-SKRIV       ROUNDED = WS-PRLS-CAN                             
      WS-OUT-AVAIL-SKRIV      ROUNDED = WS-AVAIL-CAN                            
      WS-OUT-PRUTRS-SKRIV     ROUNDED = WS-PRUTRS-CAN                           
      WS-OUT-PROKS-SKRIV      ROUNDED = WS-PROKS-CAN                            
      WS-OUT-PRRESS-SKRIV     ROUNDED = WS-PRRESS-CAN                           
      WS-OUT-PRROS-SKRIV      ROUNDED = WS-PRROS-CAN                            
      WS-OUT-PREFRS-SKRIV     ROUNDED = WS-PREFRS-CAN                           
      WS-OUT-SUAKSV-SDC-SKRIV ROUNDED = WS-SUAKSV-SDC-CAN                       
      WS-OUT-SUAKSV-PAV-SKRIV ROUNDED = WS-SUAKSV-PAV-CAN                       
      WS-OUT-PRBEART-SKRIV    ROUNDED = WS-PRBEART-CAN                          
      WS-OUT-SPARR-SKRIV      ROUNDED = WS-SPARR-CAN                            
                                                                                
      PRINT RAPPORT03                                                           
                                                                                
END-PROC                                                                        
*                                                                               
S05A-RAKNA-UPP-FALT. PROC                                                       
    WS-PRLS           = WS-PRLS       + (IN-KVLS          * IN-PRAVCOST)        
    WS-AVAIL          = WS-AVAIL + ((IN-KVLS - IN-KVOKS - IN-KVRESS)   +        
                                                          * IN-PRAVCOST)        
    WS-PRUTRS         = WS-PRUTRS     + (IN-KVUTRS        * IN-PRAVCOST)        
    WS-PROKS          = WS-PROKS      + (IN-KVOKS         * IN-PRAVCOST)        
    WS-PRRESS         = WS-PRRESS     + (IN-KVRESS        * IN-PRAVCOST)        
    WS-PRROS          = WS-PRROS      + (IN-KVROS         * IN-PRAVCOST)        
    WS-PREFRS         = WS-PREFRS     + (IN-KVEFRS        * IN-PRAVCOST)        
    WS-SUAKSV-SDC     = WS-SUAKSV-SDC +  IN-SUAKSV-SDC                          
    WS-SUAKSV-PAV     = WS-SUAKSV-PAV +  IN-SUAKSV-PAV                          
    WS-PRBEART        = WS-PRBEART    + (IN-KVBEART       * IN-PRAVCOST)        
    WS-SPARR          = WS-SPARR      + (IN-KVSPARR-KVAL  * IN-PRAVCOST)        
*                                                                               
    WS-PRLS-TOT       = WS-PRLS-TOT   + (IN-KVLS          * IN-PRAVCOST)        
    WS-AVAIL-TOT    = WS-AVAIL-TOT + ((IN-KVLS - IN-KVOKS - IN-KVRESS) +        
                                                          * IN-PRAVCOST)        
    WS-PRUTRS-TOT     = WS-PRUTRS-TOT + (IN-KVUTRS        * IN-PRAVCOST)        
    WS-PROKS-TOT      = WS-PROKS-TOT  + (IN-KVOKS         * IN-PRAVCOST)        
    WS-PRRESS-TOT     = WS-PRRESS-TOT + (IN-KVRESS        * IN-PRAVCOST)        
    WS-PRROS-TOT      = WS-PRROS-TOT  + (IN-KVROS         * IN-PRAVCOST)        
    WS-PREFRS-TOT     = WS-PREFRS-TOT + (IN-KVEFRS        * IN-PRAVCOST)        
    WS-SUAKSV-SDC-TOT = WS-SUAKSV-SDC-TOT +  IN-SUAKSV-SDC                      
    WS-SUAKSV-PAV-TOT = WS-SUAKSV-PAV-TOT +  IN-SUAKSV-PAV                      
    WS-PRBEART-TOT    = WS-PRBEART-TOT + (IN-KVBEART      * IN-PRAVCOST)        
    WS-SPARR-TOT      = WS-SPARR-TOT   + (IN-KVSPARR-KVAL * IN-PRAVCOST)        
END-PROC                                                                        
*                                                                               
*                                                                               
S05B-RAKNA-UPP-FALT. PROC                                                       
*                                                                               
* RÄKNAR UPP FÄLT FÖR DC 61 OCH 62 SOM VILL HA SINA VÄRDEN I                    
* STANDARPRIS OCH INTE I AVERAGECOST.                                           
*                                                                               
    WS-PRLS           = WS-PRLS       + (IN-KVLS          * IN-PRARTSTD)        
    WS-AVAIL          = WS-AVAIL + ((IN-KVLS - IN-KVOKS - IN-KVRESS)   +        
                                                          * IN-PRARTSTD)        
    WS-PRUTRS         = WS-PRUTRS     + (IN-KVUTRS        * IN-PRARTSTD)        
    WS-PROKS          = WS-PROKS      + (IN-KVOKS         * IN-PRARTSTD)        
    WS-PRRESS         = WS-PRRESS     + (IN-KVRESS        * IN-PRARTSTD)        
    WS-PRROS          = WS-PRROS      + (IN-KVROS         * IN-PRARTSTD)        
    WS-PREFRS         = WS-PREFRS     + (IN-KVEFRS        * IN-PRARTSTD)        
    WS-SUAKSV-SDC     = WS-SUAKSV-SDC +  IN-SUAKSV-SDC                          
    WS-SUAKSV-PAV     = WS-SUAKSV-PAV +  IN-SUAKSV-PAV                          
    WS-PRBEART        = WS-PRBEART    + (IN-KVBEART       * IN-PRARTSTD)        
    WS-SPARR          = WS-SPARR      + (IN-KVSPARR-KVAL  * IN-PRARTSTD)        
*                                                                               
    WS-PRLS-TOT       = WS-PRLS-TOT   + (IN-KVLS          * IN-PRARTSTD)        
    WS-AVAIL-TOT    = WS-AVAIL-TOT + ((IN-KVLS - IN-KVOKS - IN-KVRESS) +        
                                                          * IN-PRARTSTD)        
    WS-PRUTRS-TOT     = WS-PRUTRS-TOT + (IN-KVUTRS        * IN-PRARTSTD)        
    WS-PROKS-TOT      = WS-PROKS-TOT  + (IN-KVOKS         * IN-PRARTSTD)        
    WS-PRRESS-TOT     = WS-PRRESS-TOT + (IN-KVRESS        * IN-PRARTSTD)        
    WS-PRROS-TOT      = WS-PRROS-TOT  + (IN-KVROS         * IN-PRARTSTD)        
    WS-PREFRS-TOT     = WS-PREFRS-TOT + (IN-KVEFRS        * IN-PRARTSTD)        
    WS-SUAKSV-SDC-TOT = WS-SUAKSV-SDC-TOT +  IN-SUAKSV-SDC                      
    WS-SUAKSV-PAV-TOT = WS-SUAKSV-PAV-TOT +  IN-SUAKSV-PAV                      
    WS-PRBEART-TOT    = WS-PRBEART-TOT + (IN-KVBEART      * IN-PRARTSTD)        
    WS-SPARR-TOT      = WS-SPARR-TOT   + (IN-KVSPARR-KVAL * IN-PRARTSTD)        
END-PROC                                                                        
*                                                                               
S06-RAKNA-UPP-FALT-USA. PROC                                                    
      WS-PRLS-USA       = WS-PRLS-USA       + WS-PRLS-TOT                       
      WS-AVAIL-USA      = WS-AVAIL-USA      + WS-AVAIL-TOT                      
      WS-PRUTRS-USA     = WS-PRUTRS-USA     + WS-PRUTRS-TOT                     
      WS-PROKS-USA      = WS-PROKS-USA      + WS-PROKS-TOT                      
      WS-PRRESS-USA     = WS-PRRESS-USA     + WS-PRRESS-TOT                     
      WS-PRROS-USA      = WS-PRROS-USA      + WS-PRROS-TOT                      
      WS-PREFRS-USA     = WS-PREFRS-USA     + WS-PREFRS-TOT                     
      WS-SUAKSV-SDC-USA = WS-SUAKSV-SDC-USA + WS-SUAKSV-SDC-TOT                 
      WS-SUAKSV-PAV-USA = WS-SUAKSV-PAV-USA + WS-SUAKSV-PAV-TOT                 
      WS-PRBEART-USA    = WS-PRBEART-USA    + WS-PRBEART-TOT                    
      WS-SPARR-USA      = WS-SPARR-USA      + WS-SPARR-TOT                      
END-PROC                                                                        
*                                                                               
S06A-RAKNA-UPP-FALT-CANADA. PROC                                                
      WS-PRLS-CAN       = WS-PRLS-CAN       + WS-PRLS-TOT                       
      WS-AVAIL-CAN      = WS-AVAIL-CAN      + WS-AVAIL-TOT                      
      WS-PRUTRS-CAN     = WS-PRUTRS-CAN     + WS-PRUTRS-TOT                     
      WS-PROKS-CAN      = WS-PROKS-CAN      + WS-PROKS-TOT                      
      WS-PRRESS-CAN     = WS-PRRESS-CAN     + WS-PRRESS-TOT                     
      WS-PRROS-CAN      = WS-PRROS-CAN      + WS-PRROS-TOT                      
      WS-PREFRS-CAN     = WS-PREFRS-CAN     + WS-PREFRS-TOT                     
      WS-SUAKSV-SDC-CAN = WS-SUAKSV-SDC-CAN + WS-SUAKSV-SDC-TOT                 
      WS-SUAKSV-PAV-CAN = WS-SUAKSV-PAV-CAN + WS-SUAKSV-PAV-TOT                 
      WS-PRBEART-CAN    = WS-PRBEART-CAN    + WS-PRBEART-TOT                    
      WS-SPARR-CAN      = WS-SPARR-CAN      + WS-SPARR-TOT                      
END-PROC                                                                        
*                                                                               
S07-SKRIV-LISTA. PROC                                                           
                                                                                
    WBDC-IDDC = SPAR-IDDC                                                       
    CALL WL10WBDC USING WBDC-AREA                                               
                                                                                
    IF SPAR-IDDC = NDC-US-RU                                                    
      LISTNR = 'W61282-001'                                                     
    END-IF                                                                      
    IF SPAR-IDDC = NDC-US-BAT                                                   
      LISTNR = 'W61282-002'                                                     
    END-IF                                                                      
    IF SPAR-IDDC = NDC-US-LA                                                    
      LISTNR = 'W61282-003'                                                     
    END-IF                                                                      
    IF SPAR-IDDC = '4X'                                                         
      LISTNR = 'W61282-004'                                                     
    END-IF                                                                      
    IF SPAR-IDDC = NDC-JP-61                                                    
      LISTNR = 'W61282-006'                                                     
    END-IF                                                                      
    IF WBDC-FLWEBDC = 'J'                                                       
      PRINT RAPPORT02                                                           
    ELSE                                                                        
      PRINT RAPPORT01                                                           
    END-IF                                                                      
                                                                                
                                                                                
END-PROC                                                                        
*                                                                               
