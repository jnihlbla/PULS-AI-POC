*                                                                    *          
* PROGRAM ............ : WXTRE100                                    *          
*                                                                    *          
* SKRIVET AV ......... : PER FREDRIKSSON  57054                      *          
*                                                                    *          
* DATUM .............. : 930920                                      *          
*                                                                    *          
* FUNKTION .. : DETTA PROGRAM SKAPAR FIL MED INFORMATION             *          
*               PÅ IDDC/LAGEROMRÅDE/PS                               *          
*               AK OKS EFR OCH BELÄGGNING                            *          
*                                                                    *          
* INDATA .... : WXTR.WXTRV2.WXTRA1(+0)        OKS EFR-OPACK          *          
*               W910.W91042(+0)               AK  LS                 *          
*                                                                    *          
* UTDATA .... : WXTR.WXTRV2.WXTRE1(+1)                               *          
*                                                                    *          
*                                                                    *          
**********************************************************************          
*                                                                               
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* INFIL EFR/OKS PER VECKA  (WXTRA1)                             *               
*                                                               *               
*****************************************************************               
FILE WXTRE1D1                                                                   
%WXTRA3   (WXTR-)                                                               
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* INFIL WCDCPART                                                *               
*                                                               *               
*****************************************************************               
FILE WXTRE1D2                                                                   
%WCDCPART (CDC-)                                                                
*                                                                               
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* INFIL WSDCPART                                                *               
*                                                               *               
*****************************************************************               
FILE WXTRE1D3                                                                   
%WSDCPART (SDC-)                                                                
*                                                                               
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* UTFIL     -  LAGEROMRÅDES INFORMATION OKS EFR-OPACK           *               
*                                                               *               
*****************************************************************               
FILE WXTRE1D4             FB(53 0)                                              
%WXTRE1 (UT1-)                                                                  
*                                                                               
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* UTFIL     -  LAGEROMRÅDES INFORMATION AK BELÄGGNING           *               
*              CDC                                              *               
*****************************************************************               
FILE WXTRE1D5             FB(53 0)                                              
%WXTRE1 (UT2-)                                                                  
*                                                                               
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* UTFIL     -  LAGEROMRÅDES INFORMATION AK BELÄGGNING           *               
*              SDC                                              *               
*****************************************************************               
FILE WXTRE1D6             FB(53 0)                                              
%WXTRE1 (UT3-)                                                                  
*                                                                               
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* PARAMETRAR TILL WDATKONV                                      *               
*                                                               *               
*****************************************************************               
%WDATAREA                                                                       
*                                                                               
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* ARBETSAREA                                                    *               
*                                                               *               
*****************************************************************               
                                                                                
WDATKONV                W   8   A   VALUE 'WDATKONV'                            
                                                                                
DATUM1                  W   8   A                                               
AA1     DATUM1              2   A                                               
MM1     DATUM1         +3   2   A                                               
DD1     DATUM1         +6   2   A                                               
                                                                                
DATUM2                  W   6   A                                               
AA2     DATUM2              2   A                                               
MM2     DATUM2         +2   2   A                                               
DD2     DATUM2         +4   2   A                                               
DATUM   DATUM2              6   N                                               
                                                                                
W-TIAAVVD               W   5   N                                               
W-TIAAVV W-TIAAVVD          4   N                                               
W-TIAA   W-TIAAVVD          2   N                                               
W-TIVV   W-TIAAVVD     +2   2   N                                               
W-DAG    W-TIAAVVD     +4   1   N                                               
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* JOBSTEG 1 : LÄSER IN OKS/EFR-OPACK                            *               
*                                                               *               
*****************************************************************               
JOB INPUT WXTRE1D1                                              +               
    START A-INIT                                                +               
NAME STEG-1-LÄSER-IN-OKS-EFR                                                    
                                                                                
   UT1-TIAAVV           =      W-TIAAVV                                         
   UT1-IDDC             =      WXTR-IDDC                                        
   UT1-ADLAGOMR         =      WXTR-ADLAGOMR                                    
   UT1-KDPRODSL         =      WXTR-KDPRODSL                                    
   UT1-SUSTDTOT-AK      =      0                                                
   UT1-SUSTDTOT-LS      =      0                                                
   UT1-KVART-LS         =      0                                                
   UT1-VLSUMNTO-LS      =      0                                                
   UT1-VKSUMNTO-LS      =      0                                                
                                                                                
   IF WXTR-KVBEART-Q GT 0                                                       
     UT1-SUSTDTOT-OKS   =   WXTR-KVBEART-Q * WXTR-PRARTSTD                      
     UT1-SUSTDTOT-EFR   =   0                                                   
   ELSE                                                                         
     IF (WXTR-KVEFRS-PACK GT 0) OR (WXTR-KVEFRS-OPACK GT 0)           +         
        OR (WXTR-KVEFRS-SKEPP GT 0)                                             
       UT1-SUSTDTOT-OKS =   0                                                   
       UT1-SUSTDTOT-EFR =   WXTR-KVEFRS-OPACK * WXTR-PRARTSTD                   
     ELSE                                                                       
       UT1-SUSTDTOT-OKS =   0                                                   
       UT1-SUSTDTOT-EFR =   0                                                   
     END-IF                                                                     
   END-IF                                                                       
                                                                                
   PUT WXTRE1D4                                                                 
                                                                                
 A-INIT.  PROC                                                                  
                                                                                
 DATUM1 = SYSDATE                                                               
 AA2 = AA1                                                                      
 MM2 = MM1                                                                      
 DD2 = DD1                                                                      
 DAT-I-TIDATUM = DATUM                                                          
 DAT-KDDATFORM = 'AAMMDD'                                                       
                                                                                
 CALL WDATKONV USING (DAT-KDDATFORM,  +                                         
                      DAT-I-TIDATUM,  +                                         
                      DAT-O-TIDATUM,  +                                         
                      DAT-KDSVAR)                                               
                                                                                
                                                                                
 W-TIAAVVD = DAT-TIAAVVD                                                        
                                                                                
 END-PROC                                                                       
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* JOBSTEG 2 : LÄSER IN WCDCPART                                 *               
*                                                               *               
*****************************************************************               
JOB INPUT WXTRE1D2                                              +               
NAME STEG-2-LÄSER-IN-WCDCPART                                                   
                                                                                
   UT2-TIAAVV        =      W-TIAAVV                                            
   UT2-KDPRODSL      =      CDC-KDPRODSL                                        
   UT2-SUSTDTOT-OKS  =      0                                                   
   UT2-SUSTDTOT-EFR  =      0                                                   
   UT2-KVART-LS      =      +1                                                  
                                                                                
   UT2-IDDC          =      CDC-SE                                              
   UT2-ADLAGOMR      =      CDC-ADLAGOMR                                        
   UT2-SUSTDTOT-AK   =      CDC-KVAKS-CDC  * CDC-PRARTSTD                       
   UT2-SUSTDTOT-LS   =      CDC-KVLS       * CDC-PRARTSTD                       
   UT2-VLSUMNTO-LS   =      CDC-KVLS       * CDC-VLARTNTO                       
   UT2-VKSUMNTO-LS   =      CDC-KVLS       * CDC-VKART                          
   PUT WXTRE1D5                                                                 
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* JOBSTEG 3 : LÄSER IN WSDCPART                                 *               
*                                                               *               
*****************************************************************               
JOB INPUT WXTRE1D3                                              +               
NAME STEG-3-LÄSER-IN-WSDCPART                                                   
                                                                                
   UT3-TIAAVV        =      W-TIAAVV                                            
   UT3-KDPRODSL      =      SDC-KDPRODSL                                        
   UT3-SUSTDTOT-OKS  =      0                                                   
   UT3-SUSTDTOT-EFR  =      0                                                   
   UT3-KVART-LS      =      +1                                                  
                                                                                
   UT3-IDDC          =      SDC-IDDC                                            
   UT3-ADLAGOMR      =      SDC-ADLAGOMR                                        
   UT3-SUSTDTOT-AK   =      SDC-KVAKS-SDC  * SDC-PRARTSTD                       
   UT3-SUSTDTOT-LS   =      SDC-KVLS       * SDC-PRARTSTD                       
   UT3-VLSUMNTO-LS   =      SDC-KVLS       * SDC-VLARTNTO                       
   UT3-VKSUMNTO-LS   =      SDC-KVLS       * SDC-VKART                          
   PUT WXTRE1D6                                                                 
                                                                                
