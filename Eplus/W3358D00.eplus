*----------------------------------------------------------------------*        
*  PROGRAM    :  W3358D00                                              *        
*                                                                      *        
*  FUNKTION   :  1. W3358A-FIL(ARTRAD-FIL) OCH W33592(VALUTAFIL)       *        
*                   OCH BERÄKNAR BESTÄLNNINGSPRIS TILL TPFIL3          *        
*                2. MATCHAR W01160-FIL OCH TPFIL3 OCH RÄKNAR UT        *        
*                   SJÄLVKOST TILL UTFIL W3358D.                       *        
*                                                                      *        
*  FÖRFATTARE :  ANDERS HENRIKSSON                                     *        
*                                                                      *        
*  DATUM      :  FEB 13                                                *        
*                                                                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
*----------------------------------------------*                                
*  W3358A FÄRSKASTE PRISRAD PER ART & IDLEVNR  *                                
*         (FLERA SAMMA ART MED OLIKA IDLEVNR)  *                                
*         (FRÅN W3358A SOM SORTERAT W01185-FIL *                                
*          PÅ DATUM.)                          *                                
* ---------------------------------------------*                                
FILE W3358DD1                                                                   
%W3358A   'ART-'                                                                
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W33192-FIL VALUTAKURSINFO           *                                        
* -------------------------------------*                                        
FILE W3358DD2                                                                   
%W33592   '9304-'                                                               
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W01160-FIL ARTIKELFIL               *                                        
* -------------------------------------*                                        
FILE W3358DD3                                                                   
%W01160   'I4-'                                                                 
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  KALKYLPÅLÄGGPROCENT                 *                                        
* -------------------------------------*                                        
FILE W3358DD6                                                                   
%W3358G  'I6-'                                                                  
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  UTFIL TOTALFIL                      *                                        
* -------------------------------------*                                        
FILE W3358DD4 FB (49 0)                                                         
%W3358D    'UT-'                                                                
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  TEMPFILER                           *                                        
* -------------------------------------*                                        
*                                                                               
FILE TPFIL1  FB (49 0)                                                          
%W3358A    'T1-'                                                                
*                                                                               
FILE TPFIL2  FB (15 0)                                                          
%W33592    'T2-'                                                                
*                                                                               
FILE TPFIL3 FB (61 0)                                                           
T3-IDARTNR          1  5 P 0                                                    
T3-IDDC             6  2 A                                                      
T3-IDLEVNR-PR       8  5 A                                                      
T3-DAPRLIST-9KOMPL 13  8 N                                                      
T3-PRARTBEL-PR     21  7 P 5                                                    
T3-FLHUVLEV        28  1 A                                                      
T3-KDVALISO        29  3 A                                                      
T3-RETULF          32  4 P 4                                                    
T3-PRKURS          36  6 P 5                                                    
T3-REVALUTA        42  4 P 0                                                    
T3-PRARTBES        46  5 P 2                                                    
T3-IDLEVNR-MOTSV   51  5 A                                                      
T3-REDMTRL         56  3 P 2                                                    
T3-REDIRLON        59  3 P 2                                                    
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  PARAMETRAR TILL WDATKONV            *                                        
* -------------------------------------*                                        
%WDATAREA                                                                       
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  ARBETSFÄLT                          *                                        
* -------------------------------------*                                        
*                                                                               
IX           W  2 N                                                             
W-PRARTBES   W  7 P 5                                                           
                                                                                
NEWPAGE                                                                         
*------------------------------------------------------------------*            
* STEG 1. SORTERAR W3358DD1 ART/LEVFIL PÅ KDVALISO                 *            
* -----------------------------------------------------------------*            
                                                                                
SORT W3358DD1 TO TPFIL1   USING (ART-KDVALISO) SIZE 200000                      
                                                                                
*------------------------------------------------------------------*            
* STEG 2. SORTERAR W3358DD2 VALUTAFIL  PÅ KDVALISO                 *            
* -----------------------------------------------------------------*            
                                                                                
SORT W3358DD2 TO TPFIL2 USING (9304-KDVALISO) SIZE 1000                         
                                                                                
*------------------------------------------------------------------*            
* STEG 3. MATCHAR TEMPFIL2 OCH TEMPFIL1 PÅ KDVALISO                *            
* -----------------------------------------------------------------*            
JOB INPUT(TPFIL2 KEY (T2-KDVALISO)                                  +           
          TPFIL1 KEY (T1-KDVALISO))                                             
                                                                                
IF MATCHED                                                                      
   T3-IDARTNR          = T1-IDARTNR                                             
   T3-IDDC             = T1-IDDC                                                
   T3-IDLEVNR-PR       = T1-IDLEVNR-PR                                          
   T3-DAPRLIST-9KOMPL  = T1-DAPRLIST-9KOMPL                                     
   T3-PRARTBEL-PR      = T1-PRARTBEL-PR                                         
   T3-FLHUVLEV         = T1-FLHUVLEV                                            
   T3-KDVALISO         = T1-KDVALISO                                            
   T3-RETULF           = T1-RETULF                                              
   T3-PRKURS           = T2-PRKURS                                              
   T3-REVALUTA         = T2-REVALUTA                                            
   T3-IDLEVNR-MOTSV    = T1-IDLEVNR-MOTSV                                       
   T3-REDMTRL          = 0                                                      
   T3-REDIRLON         = 0                                                      
                                                                                
   IF T1-FLHUVLEV = 'J'                                                         
     W-PRARTBES ROUNDED = T1-PRARTBEL-PR * T1-RETULF * T2-PRKURS                
                                                                                
   ELSE                                                                         
     W-PRARTBES ROUNDED = T1-PRARTBEL-PR * T2-PRKURS                            
   END-IF                                                                       
                                                                                
   T3-PRARTBES ROUNDED = W-PRARTBES                                             
   IF T3-PRARTBES = 0                                                           
     IF W-PRARTBES > 0                                                          
       T3-PRARTBES = 0.01                                                       
     END-IF                                                                     
   END-IF                                                                       
                                                                                
   PUT TPFIL3                                                                   
END-IF                                                                          
*                                                                               
NEWPAGE                                                                         
                                                                                
*------------------------------------------------------------------*            
*STEG 4. SORTERAR TPFIL3 PÅ DC                                     *            
*------------------------------------------------------------------*            
                                                                                
SORT TPFIL3 TO TPFIL3 USING                                       +             
  (T3-IDDC)                                      SIZE 200000                    
                                                                                
*------------------------------------------------------------------*            
*STEG 5. MATCHAR IHOP ART-FIL(W01160) T4 MED RADFIL(W01161) T3     *            
*------------------------------------------------------------------*            
                                                                                
JOB INPUT(W3358DD6 KEY (I6-IDDC)                                  +             
            TPFIL3 KEY (T3-IDDC))                                               
                                                                                
 IF MATCHED                                                                     
   T3-REDMTRL  = I6-REDMTRL                                                     
   T3-REDIRLON = I6-REDIRLON                                                    
 END-IF                                                                         
                                                                                
*STEG 6. SORTERAR TPFIL3 PÅ ART-NR OCH DATUM OCH DC                *            
*------------------------------------------------------------------*            
                                                                                
SORT TPFIL3 TO TPFIL3 USING                                       +             
  (T3-IDARTNR, T3-IDDC, T3-DAPRLIST-9KOMPL D)    SIZE 200000                    
                                                                                
*------------------------------------------------------------------*            
*STEG 7. MATCHAR IHOP ART-FIL(W01160) T4 MED RADFIL(W01161) T3     *            
*------------------------------------------------------------------*            
                                                                                
JOB INPUT(W3358DD3 KEY (I4-CLAG-IDARTNR)                          +             
            TPFIL3 KEY (T3-IDARTNR)) START A-INIT                               
                                                                                
 IF MATCHED                                                                     
   PERFORM FYLL-I-HUVUD-OCH-NOLLA-RADER                                         
   PUT W3358DD4                                                                 
 END-IF                                                                         
                                                                                
A-INIT. PROC                                                                    
END-PROC                                                                        
                                                                                
 FYLL-I-HUVUD-OCH-NOLLA-RADER. PROC                                             
  UT-IDARTNR           = I4-CLAG-IDARTNR                                        
  UT-IDDC              = T3-IDDC                                                
  UT-IDLEVNR-HUV       = I4-CLAG-IDLEVNR                                        
  UT-PRHANTK = (I4-CLAG-PRDIRLON * T3-REDIRLON) + +                             
               (I4-CLAG-PRDMTRL  * T3-REDMTRL)                                  
  UT-PRARTSJK          = T3-PRARTBES + UT-PRHANTK                               
  UT-PRARTBES          = T3-PRARTBES                                            
  UT-IDLEVNR           = T3-IDLEVNR-PR                                          
  UT-IDLEVNR-MOTSV     = T3-IDLEVNR-MOTSV                                       
  UT-PRARTBES-PR       = T3-PRARTBES + UT-PRHANTK                               
  UT-PRARTSTD          = I4-CLAG-PRARTSTD                                       
  UT-KDPRODSL          = I4-CLAG-KDPRODSL                                       
  UT-KVAL              = 0                                                      
                                                                                
 END-PROC                                                                       
