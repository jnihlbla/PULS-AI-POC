                                                                                
**---------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4265000                                              *        
*                                                                      *        
*  DATUM      :  11/2 -92                                              *        
*                                                                      *        
*  FUNKTION   :  LÄSER HSSR-FIL FRÅN KONTROLLRAPPORTREG WLKVAE         *        
*                OCH SÅLLAR UT KONTROLLRAPPORTER ÄLDRE ÄN 3 ÅR         *        
*                SKRIVER UTFIL MED KR-NR + SORTBEGREPP                 *        
*                                                                      *        
*  FÖRFATTARE :  ELAINE CURTSSON                                       *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W42650D1                                                                   
*                                                                               
 W6H7-IDPTYP  1   3  A                                                          
 W6H7-DATA    4  395 A                                                          
*                                                                               
%W6H701                                                                         
*                                                                               
%W6H712                                                                         
FILLER   390  60 A                                                              
                                                                                
NEWPAGE                                                                         
FILE W42650D2 FB(31 0)                                                          
                                                                                
%W4265001  'UT-'                                                                
                                                                                
JA                      W  1  A VALUE 'J'                                       
NEJ                     W  1  A VALUE 'N'                                       
W-KR-SKA-SKRIVAS        W  1  A VALUE 'N'                                       
W-REG-YYYY              W  4  N VALUE 0                                         
W-TO-YYYY               W  4  N VALUE 0                                         
                                                                                
W-KR-DAREGDAT            W  8  N                                                
W-YYYY   W-KR-DAREGDAT      4  N                                                
W-YYMMDD W-KR-DAREGDAT  +2  6  N                                                
                                                                                
DATE-YYYYMMDD             W  8  A                                               
SEKEL     DATE-YYYYMMDD      2  N                                               
DATE-YYYY DATE-YYYYMMDD      4  N                                               
DATE      DATE-YYYYMMDD  +2  6  A                                               
DATE-YY   DATE-YYYYMMDD  +2  2  N                                               
                                                                                
*   --  CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
                                                                                
* STEG 1. LÄSER HSSR-FIL FRÅN W6H7 (KONTROLLRAPPORTREG)                         
*                                                                               
JOB INPUT W42650D1  +                                                           
    START START-PROC FINISH SLUT-PROC                                           
                                                                                
    IF W6H7-IDPTYP = '701'                                                      
       IF W-KR-SKA-SKRIVAS = JA                                                 
          PUT W42650D2                                                          
       END-IF                                                                   
                                                                                
       KR-W6H701 = W6H7-DATA                                                    
       PERFORM B-BEHANDLA                                                       
    END-IF                                                                      
                                                                                
    IF W6H7-IDPTYP = '712'                                                      
       EK-W6H712 = W6H7-DATA                                                    
       UT-IDVERNR = EK-IDVERNR                                                  
    END-IF                                                                      
                                                                                
START-PROC. PROC                                                                
                                                                                
    DATE = SYSDATE                                                              
                                                                                
    IF DATE-YY < 50                                                             
       MOVE 20 TO SEKEL                                                         
    ELSE                                                                        
       MOVE 19 TO SEKEL                                                         
    END-IF                                                                      
    W-TO-YYYY = DATE-YYYY - 4                                                   
                                                                                
END-PROC                                                                        
*                                                                               
SLUT-PROC. PROC                                                                 
                                                                                
    IF W-KR-SKA-SKRIVAS = JA                                                    
       PUT W42650D2                                                             
    END-IF                                                                      
                                                                                
END-PROC                                                                        
*                                                                               
B-BEHANDLA. PROC                                                                
                                                                                
    W-KR-DAREGDAT = 99999999 - KR-DAREGDAT-9KOMPL                               
                                                                                
    W-REG-YYYY = W-YYYY                                                         
                                                                                
    IF W-REG-YYYY LE W-TO-YYYY                                                  
       UT-IDKR          = KR-IDKR                                               
       UT-IDARTNR       = KR-IDARTNR                                            
       UT-TIREGDAT      = W-YYMMDD                                              
       UT-TIKRANS       = KR-TIKRANS                                            
       UT-IDFTG         = KR-IDFTG                                              
       UT-IDDC          = KR-IDDC                                               
       UT-KDKRSTA       = KR-KDKRSTA                                            
       UT-IDVERNR       = +0                                                    
       W-KR-SKA-SKRIVAS = JA                                                    
    ELSE                                                                        
       W-KR-SKA-SKRIVAS = NEJ                                                   
    END-IF                                                                      
                                                                                
END-PROC                                                                        
