                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W560   INVENTERING  NDC                               *        
*                                                                      *        
*  FUNKTION   :  SKAPAR LISTA W56047-XX GJORDA JUSTERINGAR             *        
*                UNDER VECKAN                                          *        
*             :  SKAPAR FIL MED GJORDA JUSTERINGAR UNDER VECKAN        *        
*                SOM SKICKAS TILL D&P                                  *        
*                                                                      *        
*  FÖRFATTARE :  GUN LÖFGREN   FEBRUARI 1997                           *        
*                                                                      *        
*  INFIL      :  W56046(+0)                                            *        
*  INFIL      :  W01184(+0)                                            *        
*                                                                      *        
*  UTDATA     :  LISTA W56047-XX   DAP REPORT FOR NDC-NA               *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W56047D1                                                                   
                                                                                
%W56046   'IN-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W56047D2                                                                   
                                                                                
%W01184   'IN2-'                                                                
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
                                                                                
FILE TEMPSORT FB(17 0)                                                          
                                                                                
%W56046   'TEMP-'                                                               
                                                                                
NEWPAGE                                                                         
                                                                                
FILE TEMPFIL1 FB(17 0)                                                          
                                                                                
%W56046   'TE-'                                                                 
                                                                                
NEWPAGE                                                                         
                                                                                
FILE TEMPFIL2 FB(45 0)                                                          
                                                                                
T2-IDDC           1  2   A                                                      
T2-JUSTYP         3  1   P                                                      
T2-VAL-D          4  8   N 2                                                    
T2-VAL-U         12  8   N 2                                                    
T2-VAL-T         20  8   N 2                                                    
T2-QTY-D         28  6   N 0                                                    
T2-QTY-U         34  6   N 0                                                    
T2-QTY-T         40  6   N 0                                                    
                                                                                
NEWPAGE                                                                         
                                                                                
FILE TEMPART  FB(483 0)                                                         
                                                                                
%W01184   'TEA-'                                                                
                                                                                
NEWPAGE                                                                         
                                                                                
FILE W56047D3 PRINTER VB(125   0)                                               
                                                                                
NEWPAGE                                                                         
                                                                                
%WDATKORT                                                                       
                                                                                
NEWPAGE                                                                         
                                                                                
W-PAGE      W  10  A         VALUE '  PAGE  '                                   
                                                                                
W-PGMNAMN   W  6  A  VALUE 'W56047'                                             
W-WDATUM    W  6  A  VALUE 'WDATUM'                                             
                                                                                
W-DATUM                W  6   N                                                 
W-MM      W-DATUM         2   N                                                 
W-DD      W-DATUM    +2   2   N                                                 
W-AAR     W-DATUM    +4   2   N                                                 
                                                                                
W-VECKA                W  2   N                                                 
                                                                                
W-JUSTYP               W  1   P    HEADING(' ADJ.TYPE')                         
VÄRDE1                 W  8   N 2  HEADING('    VALUE')                         
VÄWDE2                 W  8   N 2  HEADING('    VALUE')                         
VÄRDE                  W  8   N 2  HEADING('NET  VALUE')                        
ANTAL                  W  6   N 0  HEADING(' NO. OF ADJ.')                      
ANTAL1                 W  5   N 0  HEADING(' NO. OF ADJ.')                      
ANTAL2                 W  5   N 0  HEADING(' NO. OF ADJ.')                      
                                                                                
WS-FIRST-REC           W  1   A    VALUE 'J'                                    
WS-T2-IDDC             W  2   A                                                 
WS-T2-JUSTYP           W  1   P                                                 
WS-SUM-VAL-T           W  8   N 2                                               
WS-SUM-VAL-D           W  8   N 2                                               
WS-SUM-VAL-U           W  8   N 2                                               
WS-SUM-QTY-T           W  6   N 0                                               
WS-SUM-QTY-D           W  6   N 0                                               
WS-SUM-QTY-U           W  6   N 0                                               
                                                                                
W-SEM                  W  1   A    VALUE ';'                                    
W-PREV-IDDC            W  2   A                                                 
W-JUSTYP-E             W  1   N                                                 
W-SUM-VAL-T            W  8   N 2  MASK '-----9.99'                             
W-SUM-VAL-D            W  8   N 2  MASK '-----9.99'                             
W-SUM-VAL-U            W  8   N 2  MASK '-----9.99'                             
W-SUM-QTY-T            W  6   N 0  MASK 'ZZZZZ9'                                
W-SUM-QTY-D            W  6   N 0  MASK 'ZZZZZ9'                                
W-SUM-QTY-U            W  6   N 0  MASK 'ZZZZZ9'                                
NEWPAGE                                                                         
                                                                                
SORT W56047D1 TO TEMPSORT USING (IN-IDARTNR IN-IDDC)                            
SORT W56047D2 TO TEMPART  USING (IN2-SLAG-IDARTNR IN2-SLAG-IDDC) +              
                 SIZE 320000                                                    
                                                                                
JOB INPUT (TEMPART  KEY (TEA-SLAG-IDARTNR TEA-SLAG-IDDC)  +                     
           TEMPSORT KEY (TEMP-IDARTNR TEMP-IDDC))                               
                                                                                
IF  MATCHED                                                                     
   TE-IDDC     = TEMP-IDDC                                                      
   TE-IDARTNR = TEMP-IDARTNR                                                    
   TE-PRAVCOST = TEA-SLAG-PRAVCOST                                              
   TE-KVJUSTKV = TEMP-KVJUSTKV                                                  
   TE-KDJUSTYP = TEMP-KDJUSTYP                                                  
   PUT TEMPFIL1                                                                 
END-IF                                                                          
                                                                                
JOB INPUT TEMPFIL1 START INIT-PROC                                              
                                                                                
 IF TE-KDJUSTYP NE 6 AND  +                                                     
    TE-KDJUSTYP NE 0                                                            
   VÄRDE = TE-KVJUSTKV * TE-PRAVCOST                                            
   T2-VAL-T = TE-KVJUSTKV * TE-PRAVCOST                                         
   T2-JUSTYP = TE-KDJUSTYP                                                      
   W-JUSTYP = TE-KDJUSTYP                                                       
   IF VÄRDE < 0                                                                 
      VÄRDE1  = VÄRDE                                                           
      ANTAL1  = 1                                                               
      ANTAL2  = 0                                                               
      VÄWDE2  = 0                                                               
   ELSE                                                                         
      VÄRDE1  = 0                                                               
      ANTAL2  = 1                                                               
      ANTAL1  = 0                                                               
      VÄWDE2  = VÄRDE                                                           
   END-IF                                                                       
   ANTAL = 1                                                                    
                                                                                
   IF T2-VAL-T < 0                                                              
      T2-VAL-D = T2-VAL-T                                                       
      T2-QTY-D = 1                                                              
      T2-QTY-U = 0                                                              
      T2-VAL-U = 0                                                              
   ELSE                                                                         
      T2-VAL-D = 0                                                              
      T2-QTY-U = 1                                                              
      T2-QTY-D = 0                                                              
      T2-VAL-U = T2-VAL-T                                                       
   END-IF                                                                       
   T2-QTY-T = 1                                                                 
     T2-IDDC     = TE-IDDC                                                      
     PUT TEMPFIL2                                                               
 END-IF                                                                         
                                                                                
INIT-PROC. PROC                                                                 
   CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                            
                                                                                
   W-AAR = D-AAR                                                                
   W-MM  = D-MAANAD                                                             
   W-DD  = D-DAG                                                                
   W-VECKA = D-VECKA                                                            
                                                                                
END-PROC                                                                        
                                                                                
                                                                                
SORT TEMPFIL2 TO TEMPFIL2 USING (T2-IDDC, T2-JUSTYP)                            
JOB INPUT TEMPFIL2 FINISH Z-FINIT                                               
                                                                                
  IF T2-IDDC    = WS-T2-IDDC AND +                                              
     T2-JUSTYP  = WS-T2-JUSTYP                                                  
    WS-SUM-QTY-D   = T2-QTY-D  + WS-SUM-QTY-D                                   
    WS-SUM-QTY-U   = T2-QTY-U  + WS-SUM-QTY-U                                   
    WS-SUM-QTY-T   = T2-QTY-T  + WS-SUM-QTY-T                                   
    WS-SUM-VAL-D   = T2-VAL-D  + WS-SUM-VAL-D                                   
    WS-SUM-VAL-U   = T2-VAL-U  + WS-SUM-VAL-U                                   
    WS-SUM-VAL-T   = T2-VAL-T  + WS-SUM-VAL-T                                   
  ELSE                                                                          
    IF WS-FIRST-REC = 'N'                                                       
       W-SUM-QTY-D   = WS-SUM-QTY-D                                             
       W-SUM-QTY-U   = WS-SUM-QTY-U                                             
       W-SUM-QTY-T   = WS-SUM-QTY-T                                             
       W-SUM-VAL-D   = WS-SUM-VAL-D                                             
       W-SUM-VAL-U   = WS-SUM-VAL-U                                             
       W-SUM-VAL-T   = WS-SUM-VAL-T                                             
       W-JUSTYP-E    = WS-T2-JUSTYP                                             
       PRINT RAPPORT05                                                          
    END-IF                                                                      
    WS-T2-IDDC     = T2-IDDC                                                    
    WS-T2-JUSTYP   = T2-JUSTYP                                                  
    WS-SUM-QTY-D   = T2-QTY-D                                                   
    WS-SUM-QTY-U   = T2-QTY-U                                                   
    WS-SUM-QTY-T   = T2-QTY-T                                                   
    WS-SUM-VAL-D   = T2-VAL-D                                                   
    WS-SUM-VAL-U   = T2-VAL-U                                                   
    WS-SUM-VAL-T   = T2-VAL-T                                                   
    WS-FIRST-REC   = 'N'                                                        
  END-IF                                                                        
                                                                                
  Z-FINIT. PROC                                                                 
    IF WS-FIRST-REC = 'N'                                                       
       W-SUM-QTY-D   = WS-SUM-QTY-D                                             
       W-SUM-QTY-U   = WS-SUM-QTY-U                                             
       W-SUM-QTY-T   = WS-SUM-QTY-T                                             
       W-SUM-VAL-D   = WS-SUM-VAL-D                                             
       W-SUM-VAL-U   = WS-SUM-VAL-U                                             
       W-SUM-VAL-T   = WS-SUM-VAL-T                                             
       W-JUSTYP-E    = WS-T2-JUSTYP                                             
       PRINT RAPPORT05                                                          
    END-IF                                                                      
  END-PROC                                                                      
**************************                                                      
** LISTADAP FOR ALL NDC-NA                                                      
**************************                                                      
                                                                                
  REPORT RAPPORT05              +                                               
         PRINTER W56047D3       +                                               
         PAGESIZE 32767         +                                               
         LINESIZE 120           +                                               
         SPACE 0                +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NODATE                 +                                               
         NOADJUST                                                               
                                                                                
LINE  1  W-JUSTYP-E         +                                                   
         W-SEM              +                                                   
         W-SUM-QTY-D        +                                                   
         W-SEM              +                                                   
         W-SUM-VAL-D        +                                                   
         W-SEM              +                                                   
         W-SUM-QTY-U        +                                                   
         W-SEM              +                                                   
         W-SUM-VAL-U        +                                                   
         W-SEM              +                                                   
         W-SUM-QTY-T        +                                                   
         W-SEM              +                                                   
         W-SUM-VAL-T        +                                                   
         W-SEM                                                                  
*                                                                               
BEFORE-LINE. PROC                                                               
 IF WS-T2-IDDC NE W-PREV-IDDC                                                   
   DISPLAY '¤DAPW56047'                                                         
   DISPLAY '¤DAP' WS-T2-IDDC                                                    
   DISPLAY 'ADJ.TYPE;NO.OF DOWN ADJ;DOWN ADJ VALUE;NO.OF UP ADJ;'  +            
           'UP ADJ VALUE;TOTAL NO. OF ADJ;TOTAL NET VALUE;'                     
   W-PREV-IDDC = WS-T2-IDDC                                                     
 END-IF                                                                         
END-PROC                                                                        
