                                                                                
*----------------------------------------------------------------------*        
*  PROGRAM    :  W6121C00                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR NEDLÄST WDD8 OCH W01184 FÖR LDC.              *        
*                SKAPAR FIL FÖR UPPFÖLJNINGSLISTA.                     *        
*                                                                      *        
*  FÖRFATTARE :  BODIL LINDAHL                                         *        
*                                                                      *        
*  DATUM      :  JANUARI 2007.                                         *        
*  ÄNDRINGAR  : VISA INTE ARTIKLAR MED LAGEROMRÅDE 98                  *        
*             : VISA INTE ARTIKLAR MED SALDO                           *        
*             : ETRACKER 5277670                                       *        
*                                                                      *        
*----------------------------------------------------------------------*        
*--------------------------------------*                                        
*   ARTIKELDATA                        *                                        
* -------------------------------------*                                        
FILE W6121CD1                                                                   
%W01184                                                                         
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  BUFFERT DATA                        *                                        
* -------------------------------------*                                        
FILE W6121CD2                                                                   
%W48881   'BUFF-'                                                               
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  UTFIL                               *                                        
* -------------------------------------*                                        
FILE W6121CD3 FB (72  0)                                                        
%W6121C   'UT-'                                                                 
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  TEMPFIL1                            *                                        
* -------------------------------------*                                        
FILE TPFIL1 FB(41 0) VIRTUAL                                                    
%W48881   'TEMP1-'                                                              
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  ARBETSFÄLT                          *                                        
* -------------------------------------*                                        
*                                                                               
 JA                       W  1 A   VALUE 'J'                                    
 NEJ                      W  1 A   VALUE 'N'                                    
*                                                                               
*    --- TO CHECK IF "WEB DC"                                                   
*                                                                               
%WL10WBDC                                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*------------------------------------------------------------------*            
* STEG 1. NEDLÄSNING W48881 BUFFERT SKRIVER TEMP-FIL1              *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT W6121CD2                                                              
*                                                                               
    PERFORM X-CHECK-IF-WEB-DC                                                   
    IF WBDC-FLWEBDC = 'J'                                                       
       PERFORM A-SKAPA-TPFIL1                                                   
       PUT TPFIL1                                                               
    END-IF                                                                      
*                                                                               
NEWPAGE                                                                         
*                                                                               
 A-SKAPA-TPFIL1. PROC                                                           
                                                                                
    TEMP1-IDPTYP     = BUFF-IDPTYP                                              
    TEMP1-IDARTNR    = BUFF-IDARTNR                                             
    TEMP1-IDDC       = BUFF-IDDC                                                
    TEMP1-ADBUFFOMR  = BUFF-ADBUFFOMR                                           
    TEMP1-ADBUFFGANG = BUFF-ADBUFFGANG                                          
    TEMP1-ADBUFFPL   = BUFF-ADBUFFPL                                            
    TEMP1-KVBUFF-F   = BUFF-KVBUFF-F                                            
    TEMP1-KVBUFF-OF  = BUFF-KVBUFF-OF                                           
    TEMP1-KVKOLLI-F  = BUFF-KVKOLLI-F                                           
    TEMP1-KVKOLLI-OF = BUFF-KVKOLLI-OF                                          
    TEMP1-KDBRIST    = BUFF-KDBRIST                                             
    TEMP1-KDPAF      = BUFF-KDPAF                                               
    TEMP1-DABUFPAF   = BUFF-DABUFPAF                                            
END-PROC                                                                        
                                                                                
*                                                                               
X-CHECK-IF-WEB-DC. PROC                                                         
   WBDC-IDDC = BUFF-IDDC                                                        
   CALL WL10WBDC USING WBDC-AREA                                                
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
*                                                                               
*------------------------------------------------------------------*            
* STEG 2. MATCHAR TEMPFIL1 OCH W01184 FIL TILL UTFIL               *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT (W6121CD1 KEY(SLAG-IDDC SLAG-IDARTNR)                    +            
           TPFIL1   KEY(TEMP1-IDDC TEMP1-IDARTNR))                              
                                                                                
    IF MATCHED                                                                  
         IF SLAG-ADLAGOMR NE 98                                                 
           IF SLAG-KVLS = 0 AND SLAG-KVBEART = 0 AND        +                   
              SLAG-KVAKS-SDC = 0 AND SLAG-KVAKS-PAV = 0 AND +                   
              SLAG-KVEFRS = 0                                                   
                PERFORM B-SKAPA-UTFIL                                           
                PUT W6121CD3                                                    
           END-IF                                                               
         END-IF                                                                 
    ELSE                                                                        
      IF W6121CD1                                                               
          IF SLAG-ADLAGOMR NE 98                                                
            PERFORM X2-CHECK-IF-WEB-DC                                          
            IF WBDC-FLWEBDC = 'J'                                               
              IF SLAG-KVLS = 0 AND SLAG-KVBEART = 0 AND        +                
                 SLAG-KVAKS-SDC = 0 AND SLAG-KVAKS-PAV = 0 AND +                
                 SLAG-KVEFRS = 0                                                
                PERFORM B-SKAPA-UTFIL                                           
                PUT W6121CD3                                                    
              END-IF                                                            
            END-IF                                                              
          END-IF                                                                
      END-IF                                                                    
    END-IF                                                                      
                                                                                
                                                                                
X2-CHECK-IF-WEB-DC. PROC                                                        
   WBDC-IDDC = SLAG-IDDC                                                        
   CALL WL10WBDC USING WBDC-AREA                                                
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
*                                                                               
 B-SKAPA-UTFIL. PROC                                                            
                                                                                
   UT-DOC-IDDC         = SLAG-IDDC                                              
   UT-DOC-IDARTNR      = SLAG-IDARTNR                                           
   UT-DOC-ADLAGOMR     = SLAG-ADLAGOMR                                          
   UT-DOC-ADGANG       = SLAG-ADGANG                                            
   UT-DOC-ADPLATS      = SLAG-ADPLATS                                           
   UT-DOC-KVREFPKT     = SLAG-KVREFPKT                                          
   UT-DOC-KDREFSTA     = SLAG-KDREFSTA                                          
   UT-DOC-ADBUFFOMR    = TEMP1-ADBUFFOMR                                        
   UT-DOC-ADBUFFGANG   = TEMP1-ADBUFFGANG                                       
   UT-DOC-ADBUFFPL     = TEMP1-ADBUFFPL                                         
   UT-DOC-BEART        = ' '                                                    
   UT-DOC-IDAFPRCD     = ' '                                                    
 END-PROC                                                                       
*                                                                               
