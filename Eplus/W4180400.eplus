   NEJ                        W   1  A     VALUE 'N'                            
   GAMMAL-POST                W  25  A     VALUE ' '                            
   NY-POST-GRP                W  25  A     VALUE ' '                            
     NY-POST NY-POST-GRP           22 A                                         
     NY-POST-IDORDNR NY-POST-GRP  +22 3 P 0                                     
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
*NEWPAGE                                                                        
*-------------*                                                                 
* JOB         *                                                                 
*-------------*                                                                 
*                                                                               
JOB INPUT W41804D1                                                              
*                                                                               
   IN02-W418002A-CTX                     = ' '                                  
   IN07-W41807-CTX                       = ' '                                  
                                                                                
   IF IN-IDPTYP                          = '002'                                
      IN02-W418002A-CTX                  = INPOST                               
      NY-POST                            = IN02-W418002A-001-GRP                
      NY-POST-IDORDNR                    = 0                                    
   ELSE                                                                         
      IN07-W41807-CTX                    = INPOST                               
      NY-POST                            = IN07-W41807-001-GRP                  
      NY-POST-IDORDNR                    = IN07-IDORDNR                         
   END-IF                                                                       
   IF NY-POST-GRP = GAMMAL-POST                                                 
      IF IN-IDPTYP                       = '002'                                
         PERFORM E-SKRIV-FELPOST-VIPS-BKR                                       
      ELSE                                                                      
         PERFORM D-SKRIV-FELPOST-VIPS-BAT                                       
      END-IF                                                                    
   ELSE                                                                         
      IF IN-IDPTYP                       = '002'                                
         PERFORM C-SKRIV-GODK-POST-BKR                                          
      ELSE                                                                      
         PERFORM B-SKRIV-GODK-POST-BAT                                          
      END-IF                                                                    
   END-IF                                                                       
                                                                                
   GAMMAL-POST                           = NY-POST-GRP                          
*                                                                               
 B-SKRIV-GODK-POST-BAT.  PROC                                                   
*                                                                               
     PUT W41804D2 FROM W41804D1                                                 
                                                                                
 END-PROC                                                                       
*                                                                               
