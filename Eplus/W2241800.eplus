                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2241800                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR CDC OCH NDC-LAGERBAND OCH KOMPLETTERAR        *        
*                NDC MED LITE CDC-INFO                                 *        
*                                                                      *        
*  FÖRFATTARE :  KJELLSON GÖRAN                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
                                                                                
FILE W22418D1                                                                   
%W01184                                                                         
                                                                                
FILE W22418D2                                                                   
%W01160                                                                         
                                                                                
                                                                                
FILE W22418D3 FB(439 0)                                                         
%W22418    'UT-'                                                                
                                                                                
                                                                                
W-KDSORT      W  2 A                                                            
W-KDERS       W  2 P 0                                                          
W-KDPRODSL    W  2 P 0                                                          
W-REDIRLEV    W  2 P 2                                                          
W-TIFINLV     W  3 P 0                                                          
W-KDERS-UTG   W  2 P 0                                                          
W-KVTILLG-TOT W  4 P 0                                                          
IX            W  2 N  VALUE 0                                                   
                                                                                
*                                                                               
* STEG 1. MATCHA OCH SKAPA UTFIL                                                
*                                                                               
JOB INPUT (W22418D2 KEY (CLAG-IDARTNR) +                                        
           W22418D1 KEY (SLAG-IDARTNR))                                         
                                                                                
  IF MATCHED                                                                    
     IF SLAG-IDDC-REF = '  '  AND +                                             
        (SLAG-IDLEVNR NE '9993 ' AND +                                          
         SLAG-IDLEVNR NE '9998 ')                                               
        IF CLAG-KDSORT NE 'SW'                                                  
           PERFORM S01-W01184-W01160-INFO                                       
           UT-NDCCN-KDERS          = CLAG-KDERS                                 
           UT-NDCCN-KDPRODSL       = CLAG-KDPRODSL                              
           UT-NDCCN-TIFINLV        = CLAG-TIFINLV                               
           UT-NDCCN-KDERS-UTG      = CLAG-KDERS-UTG                             
           UT-NDCCN-KVTILLG-TOT    = CLAG-KVTILLG-TOT                           
           UT-NDCCN-REDIRLEV       = CLAG-REDIRLEV                              
           W-KDSORT                = CLAG-KDSORT                                
           W-KDERS                 = CLAG-KDERS                                 
           W-KDPRODSL              = CLAG-KDPRODSL                              
           W-TIFINLV               = CLAG-TIFINLV                               
           W-KDERS-UTG             = CLAG-KDERS-UTG                             
           W-KVTILLG-TOT           = CLAG-KVTILLG-TOT                           
           W-REDIRLEV              = CLAG-REDIRLEV                              
                                                                                
           PUT W22418D3                                                         
        END-IF                                                                  
     END-IF                                                                     
  ELSE                                                                          
     IF W22418D1                                                                
        IF SLAG-IDDC-REF = '  ' AND +                                           
        (SLAG-IDLEVNR NE '9993 ' AND +                                          
         SLAG-IDLEVNR NE '9998 ')                                               
           IF W-KDSORT NE 'SW'                                                  
              PERFORM S01-W01184-W01160-INFO                                    
              UT-NDCCN-KDERS       = W-KDERS                                    
              UT-NDCCN-KDPRODSL    = W-KDPRODSL                                 
              UT-NDCCN-TIFINLV     = W-TIFINLV                                  
              UT-NDCCN-KDERS-UTG   = W-KDERS-UTG                                
              UT-NDCCN-KVTILLG-TOT = W-KVTILLG-TOT                              
              UT-NDCCN-REDIRLEV    = W-REDIRLEV                                 
                                                                                
              PUT W22418D3                                                      
           END-IF                                                               
        END-IF                                                                  
     END-IF                                                                     
  END-IF                                                                        
                                                                                
                                                                                
