                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  WF104500                                              *        
*                                                                      *        
*  FUNKTION   :  FREIGHT COST REPORT FROM T01DHEA_ARC AND T01DLIN_ARC  *        
*                                                                      *        
*  FÖRFATTARE :  BARSHARANI BISHOYE                                    *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE WF1045D1                                                                   
*                                                                               
%WF1044  'IN-'                                                                  
NEWPAGE                                                                         
FILE WF1045D2 PRINTER VB (87  0)                                                
                                                                                
UT-IDFINDOC             W    9   N                                              
UT-DAFINDOC             W    8   N                                              
UT-IDEXCUST             W    5   A                                              
UT-BEART                W   25   A                                              
UT-PRARTNTO-N           W   11   N                                              
UT-PRARTNTO-D           W    2   N                                              
UT-KDVALISO             W    3   A                                              
UT-KDFRAKT              W    3   N 0  MASK 'Z99'       VALUE 0                  
UT-SEM1                 W    1   A   VALUE ';'                                  
*                                                                               
NEWPAGE                                                                         
*****************************************************                           
*WORKING STORAGE                                    *                           
W-PRARTNTO-FMT                   W  13  N 2                                     
W-PRARTNTO-N     W-PRARTNTO-FMT     11  N                                       
W-PRARTNTO-D     W-PRARTNTO-FMT +11  2  N                                       
                                                                                
W-DECIMAL         W   1 A    VALUE '.'                                          
FIRST-LINE        S   1   A  VALUE 'J'                                          
******************************************************                          
  JOB INPUT  WF1045D1                                                           
  UT-IDFINDOC           = IN-IDFINDOC                                           
  UT-DAFINDOC           = IN-DAFINDOC                                           
  UT-IDEXCUST           = IN-IDEXCUST                                           
  UT-BEART              = IN-BEART                                              
  W-PRARTNTO-FMT        = IN-PRARTNTO                                           
  UT-PRARTNTO-N         = W-PRARTNTO-N                                          
  UT-PRARTNTO-D         = W-PRARTNTO-D                                          
  UT-KDVALISO           = IN-KDVALISO                                           
  UT-KDFRAKT            = IN-KDFRAKT                                            
  UT-SEM1               = ';'                                                   
                                                                                
  PRINT RPT1                                                                    
*-----------------------------------------------------------------*             
*     REPORT  WF1045-001                                                        
*-----------------------------------------------------------------*             
  REPORT    RPT1                +                                               
            PRINTER   WF1045D2  +                                               
            LINESIZE  82        +                                               
            PAGESIZE  32000     +                                               
            NOHEADING           +                                               
            SPACE     0         +                                               
            SKIP      0         +                                               
            TITLESKIP 0         +                                               
            NOADJUST            +                                               
            NOSPREAD                                                            
*                                                                               
LINE 1      UT-IDFINDOC         +                                               
            UT-SEM1             +                                               
            UT-DAFINDOC         +                                               
            UT-SEM1             +                                               
            UT-IDEXCUST         +                                               
            UT-SEM1             +                                               
            UT-BEART            +                                               
            UT-SEM1             +                                               
            UT-PRARTNTO-N       +                                               
            W-DECIMAL           +                                               
            UT-PRARTNTO-D       +                                               
            UT-SEM1             +                                               
            UT-KDVALISO         +                                               
            UT-SEM1             +                                               
            UT-KDFRAKT          +                                               
            UT-SEM1                                                             
                                                                                
BEFORE-LINE. PROC                                                               
 IF FIRST-LINE = 'J'                                                            
  DISPLAY '¤DAPWF1045-001'                                                      
  DISPLAY '¤DAPWF1045'                                                          
  DISPLAY 'INVOICE NO;INVOICE DATE;DISTRICT;DESCRIPTION;'           +           
          'NET PRICE;CURRENCY CODE;FREIGHT CODE;'                               
    FIRST-LINE = 'N'                                                            
 END-IF                                                                         
END-PROC                                                                        
