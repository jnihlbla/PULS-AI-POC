                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5517100                                              *        
*                                                                      *        
*  FUNKTION   :  CREATE .CSV LIST FOR STANDARD PRICE CHANGES.          *        
*                THE CSV REPORT IS SENT TO D&P.                        *        
*                                                                      *        
*  FÖRFATTARE :  ARCHANA BHAT                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W55171D1                                                                   
*                                                                               
%W55147  'IN-'                                                                  
                                                                                
**** EXCEL-FIL, MAIL VIA DAP                                                    
FILE W55171D2  PRINTER VB(364 0)                                                
                                                                                
W-PART-NUM                  W    9 N 0 MASK 'ZZZZZZZZ9'                         
W-SUPPLIER                  W    5 A                                            
W-CHANGE                    W    5 N 1 MASK '---9.9'                            
W-PURCH-ACTUAL              W    9 N 2 MASK 'ZZZZZZ9.99'                        
W-PURCH-COMING              W    9 N 2 MASK 'ZZZZZZ9.99'                        
W-YEARLY-DEMD               W    7 N 0 MASK 'ZZZZZZ9'                           
W-STOCK-BAL                 W    7 N 0 MASK '------9'                           
W-PURCHASER-NAME            W   40 A                                            
W-PURCHASER-NO              W    5 A                                            
W-PURCHASER-EMAIL           W   60 A                                            
W-SUPPLIER-INLEV            W    5 A                                            
W-PURCH-INLEV               W    9 N 2 MASK 'ZZZZZZ9.99'                        
W-DATE-INLEV                W    7 N                                            
W-SUPPLIER-GODK             W    5 A                                            
W-PURCH-GODK                W    9 N 2 MASK 'ZZZZZZ9.99'                        
W-DATE-GODK                 W    7 N                                            
W-SUPPLIER-LOCAL            W    5 A                                            
W-PURCH-LOCAL               W    9 N 2 MASK 'ZZZZZZ9.99'                        
W-DATE-LOCAL                W    7 N                                            
W-DIRLON-AKT                W    9 N 2 MASK 'ZZZZZZ9.99'                        
W-DIRLON-KOM                W    9 N 2 MASK 'ZZZZZZ9.99'                        
W-PRMATRL-AKT               W    9 N 2 MASK 'ZZZZZZ9.99'                        
W-PRMATRL-KOM               W    9 N 2 MASK 'ZZZZZZ9.99'                        
W-OVRPAL-AKT                W    9 N 2 MASK 'ZZZZZZ9.99'                        
W-OVRPAL-KOM                W    9 N 2 MASK 'ZZZZZZ9.99'                        
W-PRKURS                    W    9 N 5 MASK 'ZZZ9.99999'                        
W-KDVALISO                  W    3 A                                            
W-SEM1                      W    1 A VALUE ';'                                  
FIRST-TIME-SW               W    1 A VALUE 'Y'                                  
                                                                                
JOB INPUT W55171D1                                                              
                                                                                
 IF IN-REAENDR NE 0                                                             
   IF IN-KVBEHOVAR NE 0                                                         
     W-PART-NUM        = IN-IDARTNR                                             
     W-SUPPLIER        = IN-IDLEVNR                                             
     W-CHANGE          = IN-REAENDR                                             
     W-PURCH-ACTUAL    = IN-PRINK-AKT                                           
     W-PURCH-COMING    = IN-PRINK-KOM                                           
     W-YEARLY-DEMD     = IN-KVBEHOVAR                                           
     W-STOCK-BAL       = IN-KVDISP-SPIS                                         
     W-PURCHASER-NAME  = IN-IDNAMN                                              
     W-PURCHASER-NO    = IN-IDINK                                               
     W-PURCHASER-EMAIL = IN-IDMAIL                                              
     W-DATE-INLEV      = IN-INLEV-TIPRLIST                                      
     W-SUPPLIER-INLEV  = IN-INLEV-IDLEVNR-PR                                    
     W-PURCH-INLEV     = IN-INLEV-PRARTBEL-PR                                   
     W-DATE-GODK       = IN-GODK-TIPRLIST                                       
     W-SUPPLIER-GODK   = IN-GODK-IDLEVNR-PR                                     
     W-PURCH-GODK      = IN-GODK-PRARTBEL-PR                                    
     W-DATE-LOCAL      = IN-LOCAL-TIPRLIST                                      
     W-SUPPLIER-LOCAL  = IN-LOCAL-IDLEVNR-PR                                    
     W-PURCH-LOCAL     = IN-LOCAL-PRARTBEL-PR                                   
     W-DIRLON-AKT      = IN-PRDIRLON-AKT                                        
     W-DIRLON-KOM      = IN-PRDIRLON-KOM                                        
     W-PRMATRL-AKT     = IN-PRDMTRL-AKT                                         
     W-PRMATRL-KOM     = IN-PRDMTRL-KOM                                         
     W-OVRPAL-AKT      = IN-PROVRPAL-AKT                                        
     W-OVRPAL-KOM      = IN-PROVRPAL-KOM                                        
     W-PRKURS          = IN-PRKURS                                              
     W-KDVALISO        = IN-KDVALISO                                            
     PRINT XL-LIST                                                              
   END-IF                                                                       
 END-IF                                                                         
                                                                                
NEWPAGE                                                                         
  REPORT   XL-LIST              +                                               
           PRINTER W55171D2     +                                               
           LINESIZE 327         +                                               
           SPACE 0              +                                               
           NOHEADING            +                                               
           NOSPREAD             +                                               
           NOADJUST             +                                               
           PAGESIZE 32000       +                                               
           NODATE                                                               
  LINE  1  W-PART-NUM           +                                               
           W-SEM1               +                                               
           W-SUPPLIER           +                                               
           W-SEM1               +                                               
           W-CHANGE             +                                               
           W-SEM1               +                                               
           W-PURCH-ACTUAL       +                                               
           W-SEM1               +                                               
           W-PURCH-COMING       +                                               
           W-SEM1               +                                               
           W-YEARLY-DEMD        +                                               
           W-SEM1               +                                               
           W-STOCK-BAL          +                                               
           W-SEM1               +                                               
           W-PURCHASER-NAME     +                                               
           W-SEM1               +                                               
           W-PURCHASER-NO       +                                               
           W-SEM1               +                                               
           W-PURCHASER-EMAIL    +                                               
           W-SEM1               +                                               
           W-DATE-INLEV         +                                               
           W-SEM1               +                                               
           W-SUPPLIER-INLEV     +                                               
           W-SEM1               +                                               
           W-PURCH-INLEV        +                                               
           W-SEM1               +                                               
           W-DATE-GODK          +                                               
           W-SEM1               +                                               
           W-SUPPLIER-GODK      +                                               
           W-SEM1               +                                               
           W-PURCH-GODK         +                                               
           W-SEM1               +                                               
           W-DATE-LOCAL         +                                               
           W-SEM1               +                                               
           W-SUPPLIER-LOCAL     +                                               
           W-SEM1               +                                               
           W-PURCH-LOCAL        +                                               
           W-SEM1               +                                               
           W-DIRLON-AKT         +                                               
           W-SEM1               +                                               
           W-DIRLON-KOM         +                                               
           W-SEM1               +                                               
           W-PRMATRL-AKT        +                                               
           W-SEM1               +                                               
           W-PRMATRL-KOM        +                                               
           W-SEM1               +                                               
           W-OVRPAL-AKT         +                                               
           W-SEM1               +                                               
           W-OVRPAL-KOM         +                                               
           W-SEM1               +                                               
           W-PRKURS             +                                               
           W-SEM1               +                                               
           W-KDVALISO           +                                               
           W-SEM1                                                               
*                                                                               
BEFORE-LINE. PROC                                                               
 IF FIRST-TIME-SW = 'Y'                                                         
   DISPLAY '¤DAPW55171-001'                                                     
   DISPLAY '¤DAPW55171'                                                         
   DISPLAY 'PART NUMBER;SUPPLIER;CHANGE(%);PURCHASE PRICE ACTUAL;' +            
           'PURCHASE PRICE COMING;YEARLY DEMAND;STOCK BALANCE;'    +            
           'PURCHASER-NAME;PURCHASER-NO;PURCHASER-EMAIL;'          +            
           'INLEV-DATE;INLEV-SUP;INLEV-PRICE;'                     +            
           'GODK-DATE;GODK-SUP;GODK-PRICE;'                        +            
           'LOCAL-DATE;LOCAL-SUP;LOCAL-PRICE;'                     +            
           'SALARY-ACTUAL;SALARY-COMING;MATERIAL-ACTUAL;'          +            
           'MATERIAL-COMING;OTHER-ACTUAL;OTHER-COMING;'            +            
           'CURRENCY RATE;CURRRENCY CODE;'                                      
   FIRST-TIME-SW = 'N'                                                          
 END-IF                                                                         
END-PROC                                                                        
