                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6131200                                              *        
*                                                                      *        
*  FUNKTION   :  HÄMTAR KVQPACK-1 TILL VECKANS INLEVERANSER.           *        
*                                                                      *        
*  FÖRFATTARE :  KENT JEBSEN                                           *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W61312D1                                                                   
%W01160  'LB-'                                                                  
                                                                                
FILE W61312D2                                                                   
%W6111001  'IN-'                                                                
                                                                                
FILE W61312D3                                                                   
%W6133001 'FPCK-'                                                               
                                                                                
FILE TPFIL1 FB(25 0)                                                            
TEMP-IDARTNR       1  5 P 0                                                     
TEMP-BEFT          6  2 P 0                                                     
TEMP-IDDC          8  2 A                                                       
TEMP-KVINLART     10  4 P 0                                                     
TEMP-KVAVIS-KIT   14  4 P 0                                                     
TEMP-KDFORP       18  4 A                                                       
TEMP-KVQPACK-1    22  3 P 0                                                     
*                                                                               
FILE W61312D4 FB(19 0)                                                          
%W6131201  'UT-'                                                                
                                                                                
*    --- VALID IDDC CODES                                                       
%WWDC99                                                                         
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------                     
* STEG 1. HÄMTAR KDFORP                                                         
*----------------------------------------------------------                     
*                                                                               
JOB INPUT (W61312D1 KEY(LB-CLAG-IDARTNR) W61312D2 KEY(IN-IDARTNR))              
IF MATCHED                                                                      
  TEMP-IDARTNR    = IN-IDARTNR                                                  
  TEMP-BEFT       = IN-BEFT                                                     
  TEMP-IDDC       = IN-IDDC                                                     
  TEMP-KVINLART   = IN-KVINLART                                                 
  TEMP-KVQPACK-1  = LB-CLAG-KVQPACK-1                                           
  TEMP-KVAVIS-KIT = IN-KVAVIS-KIT                                               
  TEMP-KDFORP     = LB-CLAG-KDFORP                                              
  PUT TPFIL1                                                                    
END-IF                                                                          
*                                                                               
*----------------------------------------------------------                     
* STEG 2. GET Q1 FROM WDK6 AND KDFORP FROM WDT3 FOR CHINA,                      
*         IF IT IS GREATER THAN ZERO                                            
*----------------------------------------------------------                     
*                                                                               
SORT W61312D3 TO W61312D3 USING (FPCK-IDARTNR)                                  
*                                                                               
JOB INPUT (W61312D3 KEY(FPCK-IDARTNR) TPFIL1 KEY(TEMP-IDARTNR))                 
IF MATCHED                                                                      
  UT-BEFT       = TEMP-BEFT                                                     
  UT-IDDC       = TEMP-IDDC                                                     
  UT-KVINLART   = TEMP-KVINLART                                                 
  UT-KVAVIS-KIT = TEMP-KVAVIS-KIT                                               
  UT-KVQPACK-1  = TEMP-KVQPACK-1                                                
  UT-KDFORP     = TEMP-KDFORP                                                   
  PERFORM S23-CHECK-TEMP-IDDC                                                   
  IF TEMP-IDDC = NDC-CN                                                         
    IF FPCK-KDFORPPL > 0 OR FPCK-KDFORPGP > 0 OR FPCK-KDFORPUF > 0              
      UT-KDFORP   = FPCK-KDFORP                                                 
    END-IF                                                                      
  END-IF                                                                        
  PUT W61312D4                                                                  
ELSE                                                                            
  IF TPFIL1                                                                     
     UT-BEFT       = TEMP-BEFT                                                  
     UT-IDDC       = TEMP-IDDC                                                  
     UT-KVINLART   = TEMP-KVINLART                                              
     UT-KVAVIS-KIT = TEMP-KVAVIS-KIT                                            
     UT-KVQPACK-1  = TEMP-KVQPACK-1                                             
     UT-KDFORP     = TEMP-KDFORP                                                
     PUT W61312D4                                                               
  END-IF                                                                        
END-IF                                                                          
*    --- S23-CHECK-TEMP-IDDC (MACRO PROCEDURE)                                  
%WWDC02 'TEMP-'                                                                 
*                                                                               
