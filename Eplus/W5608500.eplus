*  FUNKTION   :  SKAPA ÅRSRAPPORT FÖR LAB, DC 42 ATLANTA.                       
*                LISTA ÖVER ALLA ARTIKLAR SOM EJ OMSATTS UNDER                  
*                GÅNGET ÅR. (FÖR ATT UNDVIKA STRAFFSKATT TILL ATLANTA)          
*  FÖRFATTARE :  KJ HANSSON                                                     
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
**  INFIL NDC MED LAGERSALDON VID ÅRETS BÖRJAN                                  
FILE W56085D1                                                                   
%W51052 'I1-'                                                                   
                                                                                
**  INFIL NDC MED LAGERSALDON VID ÅRETS SLUT                                    
FILE W56085D2                                                                   
%W51052 'I2-'                                                                   
                                                                                
**  ARTIKEL-EXTRAKT WDK6                                                        
FILE W56085D3                                                                   
%W01160  'I3-'                                                                  
                                                                                
**  ARTIKEL-BENÄMNINGSFIL                                                       
FILE W56085D4                                                                   
%W01174  'BEN-'                                                                 
                                                                                
**  ÅRETS LAB-POSTER                                                            
FILE W56085D5                                                                   
 LAB-TRANS-IDPTYP    1   3    A                                                 
%W510A02  'L02-'                                                                
%W510AX2  'AX2-'                                                                
%W510A03  'A03-'                                                                
%W510A05  'L05-'                                                                
%W510A06  'A06-'                                                                
%W510A06  'L06-'                                                                
%W510A07  'A07-'                                                                
%W510A08  'A08-'                                                                
%W510L09  'L09-'                                                                
%W510A09  'A09-'                                                                
%W510A11  'A11-'                                                                
%W510A12  'A12-'                                                                
%W510A13  'A13-'                                                                
%W510A14  'A14-'                                                                
%W510A15  'A15-'                                                                
%W510A18  'A18-'                                                                
%W510A19  'A19-'                                                                
                                                                                
FILE W56085D6  PRINTER VB(600 0)                                                
                                                                                
**  SORTERAD TEMPFIL DC 42 MED GAMLA LAGERSALDON                                
FILE TPFILTO  FB (58 0)                                                         
%W51052 'TO-'                                                                   
                                                                                
**  SORTERAD TEMPFIL DC 42 MED NYA LAGERSALDON                                  
FILE TPFILTN  FB (58 0)                                                         
%W51052 'TN-'                                                                   
                                                                                
** DC 42-ARTIKLAR MED GAMLA OCH NYA SALDON                                      
FILE TPFIL1 FB (80 0)                                                           
 T1-POST             1   50   A                                                 
 T1-IDARTNR          1    5   P 0                                               
 T1-BEART            6   25   A                                                 
 T1-KDPSLLOC        31    2   N                                                 
 T1-TOTLS-O         33    4   P 0                                               
 T1-TOTLS-N         37    4   P 0                                               
 T1-PRAVCOST-O      41    5   P 2                                               
 T1-PRAVCOST-N      46    5   P 2                                               
                                                                                
** DC 42-ARTIKLAR MED GAMLA OCH NYA SALDON OCH KDPSLLOC                         
FILE TPFIL2 FB (80 0)                                                           
 T2-POST             1   50   A                                                 
 T2-IDARTNR          1    5   P 0                                               
 T2-BEART            6   25   A                                                 
 T2-KDPSLLOC        31    2   N                                                 
 T2-TOTLS-O         33    4   P 0                                               
 T2-TOTLS-N         37    4   P 0                                               
 T2-PRAVCOST-O      41    5   P 2                                               
 T2-PRAVCOST-N      46    5   P 2                                               
                                                                                
** DC 42-ARTIKLAR MED GAMLA OCH NYA SALDON OCH KDPSLLOC SAMT BENÄMNING          
FILE TPFIL3 FB (80 0)                                                           
 T3-POST             1   50   A                                                 
 T3-IDARTNR          1    5   P 0                                               
 T3-BEART            6   25   A                                                 
 T3-KDPSLLOC        31    2   N                                                 
 T3-TOTLS-O         33    4   P 0                                               
 T3-TOTLS-N         37    4   P 0                                               
 T3-PRAVCOST-O      41    5   P 2                                               
 T3-PRAVCOST-N      46    5   P 2                                               
                                                                                
**  AKTUELLA LAB-TRANSAR, DC 42 SOM PÅVERKAR SALDO                              
FILE TPFIL4 FB (85 0)                                                           
 T4-POST             1   15   A                                                 
 T4-IDARTNR          1    5   P 0                                               
 T4-TOTSALES         6    5   P 0                                               
 T4-TOTRECIP        11    5   P 0                                               
                                                                                
**  AKTUELLA LAB-TRANSAR SOM PÅVERKAR SALDO SUMMERAD PER ART, FÖR DC 42         
FILE TPFIL5 FB (85 0)                                                           
 T5-POST             1   15   A                                                 
 T5-IDARTNR          1    5   P 0                                               
 T5-TOTSALES         6    5   P 0                                               
 T5-TOTRECIP        11    5   P 0                                               
                                                                                
***** SLUT PÅ FILDEFINITIONER **************************                        
                                                                                
***** DEFINITION FÖR LISTRADERNA                                                
 W-SEM           W  6  A                           VALUE ';'                    
 FIRST-LINE1     S  1  A                           VALUE 'J'                    
 W-IDARTNR       W  5  P 0   MASK '--------9'                                   
 W-BEART         W 21  A                                                        
 W-LPC           W  2  N                                                        
 WS-LPC          W  2  N                                                        
 W-TOTLS-O       W  9  N 0   MASK '--------9'      VALUE 0                      
 W-RECIP         W  7  N 0   MASK '------9'        VALUE 0                      
 W-SALES         W  7  N 0   MASK '------9'        VALUE 0                      
 W-TOTLS-N       W  9  N 0   MASK '--------9'      VALUE 0                      
 W-OVER-YEAR     W  9  N 0   MASK '--------9'      VALUE 0                      
 W-PRAVCOST      W  9  N 2   MASK '------9.99'     VALUE 0                      
 W-SUAVCOST      W  9  N 2   MASK '------9.99'     VALUE 0                      
                                                                                
***** ÖVRIGA DEFINITIONER                                                       
 WS-KVJUST       W  7  N 0                                                      
 WS-IDDC         W  2  A                                                        
 W-OLD-YEAR      W  2  N                                                        
 W-NEW-SEKEL     W  2  N                                                        
 W-NEW-YEAR      W  2  N                                                        
 W-DIFF          W  7  N 0                         VALUE 0                      
 W-ANT-PARTS     W  7  N 0   MASK '------9'        VALUE 0                      
                                                                                
PROGRAM-NAMN    W     8    A     VALUE 'W5608500'                               
WDATUM          W     6    A     VALUE 'WDATUM'                                 
                                                                                
%WDATKORT                                                                       
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
*******  HÄR BÖRJAR JOBB-STEGEN *********************                           
                                                                                
*----------------------------------------------------------------------*        
*  STEG 1                                                                       
* SELEKTERA UT ALLA ARTIKLAR FÖR DC 42 FRÅN GAMMALT OCH NYTT LAGERBAND          
* OCH SORTERA SEDAN DESSA PER ARTIKELNUMMER, DE SORTERADE POSTERNA              
* LÄGGS PÅ TPFILO OCH TPFILN.                                                   
* DESSA MATCHAS, GAMMALT OCH NYTT KVLS, KVEFRS OCH PRAVCOST SAMT                
* ARTIKELNUMMER LÄGGS PÅ TPFIL1                                                 
*----------------------------------------------------------------------*        
                                                                                
SORT W56085D1 TO TPFILTO USING (I1-IDARTNR) BEFORE D1-SORT-INIT                 
                                                                                
 D1-SORT-INIT. PROC                                                             
  IF I1-IDDC EQ '42'                                                            
    SELECT                                                                      
  END-IF                                                                        
 END-PROC                                                                       
                                                                                
SORT W56085D2 TO TPFILTN USING (I2-IDARTNR) BEFORE D2-SORT-INIT                 
                                                                                
 D2-SORT-INIT. PROC                                                             
  IF I2-IDDC EQ '42'                                                            
    SELECT                                                                      
  END-IF                                                                        
 END-PROC                                                                       
                                                                                
JOB INPUT (TPFILTN KEY (TN-IDARTNR)    +                                        
           TPFILTO KEY (TO-IDARTNR)) START 1-INIT                               
                                                                                
IF MATCHED                                                                      
  T1-IDARTNR       = TN-IDARTNR                                                 
  T1-TOTLS-O       = TO-KVLS + TO-KVEFRS                                        
  T1-TOTLS-N       = TN-KVLS + TN-KVEFRS                                        
  T1-PRAVCOST-O    = TO-PRAVCOST                                                
  T1-PRAVCOST-N    = TN-PRAVCOST                                                
  PUT TPFIL1                                                                    
ELSE                                                                            
  IF TPFILTO                                                                    
    T1-IDARTNR     = TO-IDARTNR                                                 
    T1-TOTLS-O     = TO-KVLS + TO-KVEFRS                                        
    T1-TOTLS-N     = 0                                                          
    T1-PRAVCOST-O  = TO-PRAVCOST                                                
    T1-PRAVCOST-N  = 0                                                          
    PUT TPFIL1                                                                  
  ELSE                                                                          
    T1-IDARTNR     = TN-IDARTNR                                                 
    T1-TOTLS-O     = 0                                                          
    T1-TOTLS-N     = TN-KVLS + TN-KVEFRS                                        
    T1-PRAVCOST-O  = 0                                                          
    T1-PRAVCOST-N  = TN-PRAVCOST                                                
    PUT TPFIL1                                                                  
  END-IF                                                                        
END-IF                                                                          
                                                                                
1-INIT. PROC                                                                    
   T1-BEART        = ' '                                                        
   T1-KDPSLLOC     = 0                                                          
END-PROC                                                                        
                                                                                
*----------------------------------------------------------------------*        
*  STEG 2                                                                       
* MATCHA TEMPFIL1 MED ARTIKELREGEXTRAKT OCH HÄMTA LOKALT PRODUKTSLAG,           
*  LÄGG DETTA PÅ TPFIL2                                                         
*----------------------------------------------------------------------*        
                                                                                
JOB INPUT (W56085D3 KEY (I3-CLAG-IDARTNR) +                                     
           TPFIL1  KEY (T1-IDARTNR))                                            
IF MATCHED                                                                      
   T2-POST        = T1-POST                                                     
   T2-KDPSLLOC    = I3-CLAG-KDPSLLOC                                            
   PUT TPFIL2                                                                   
ELSE                                                                            
 IF TPFIL1                                                                      
   T2-POST        = T1-POST                                                     
   T2-KDPSLLOC    = 0                                                           
   PUT TPFIL2                                                                   
 END-IF                                                                         
END-IF                                                                          
                                                                                
*----------------------------------------------------------------------*        
*  STEG 3                                                                       
* MATCHA TEMPFIL2 MED BENÄMNINGSFIL FÖR ATT HÄMTA ARTIKELBENÄMNING,             
* OM US-BENÄMNING FINNS HÄMTAS DENNA ANNARS TAS ENGELSK BENÄMNING               
* OCH LÄGG UT PÅ TPFIL3                                                         
*----------------------------------------------------------------------*        
                                                                                
JOB INPUT (W56085D4 KEY (BEN-IDARTNR)  +                                        
           TPFIL2  KEY (T2-IDARTNR))                                            
IF MATCHED                                                                      
   T3-POST        = T2-POST                                                     
   IF BEN-BEART(10) NE '                         '                              
     T3-BEART     = BEN-BEART(10)                                               
   ELSE                                                                         
     T3-BEART     = BEN-BEART(04)                                               
   END-IF                                                                       
   PUT TPFIL3                                                                   
ELSE                                                                            
 IF TPFIL2                                                                      
   T3-POST        = T2-POST                                                     
   T3-BEART       = '                         '                                 
   PUT TPFIL3                                                                   
 END-IF                                                                         
END-IF                                                                          
                                                                                
*----------------------------------------------------------------------*        
*  STEG 4                                                                       
* PLOCKA FRAM LV-POSTERS OCH LAB-POSTERS SALDON PÅ TEMPFIL 4,                   
* (LV-POSTER = L02, L05 OCH L09, LAB-POSTER = A03 - A19-TRANSAR)                
*  LV-POSTER = LAGERVÄRDESFÖRÄNDRINGS-POSTER                                    
*----------------------------------------------------------------------*        
                                                                                
JOB INPUT W56085D5                                                              
                                                                                
 T4-TOTRECIP   = 0                                                              
 T4-TOTSALES   = 0                                                              
                                                                                
 CASE LAB-TRANS-IDPTYP                                                          
                                                                                
   WHEN 'L02'                                                                   
     T4-IDARTNR        = L02-IDARTNR                                            
     WS-IDDC           = L02-IDDC-REC                                           
     T4-TOTSALES       = L02-KVLEVART                                           
     PERFORM SKRIV-TPFIL4                                                       
                                                                                
   WHEN 'A03'                                                                   
     T4-IDARTNR        = A03-IDARTNR                                            
     WS-IDDC           = A03-IDDC-REC                                           
     IF A03-KDEKOHT = 'T10' 'T40' 'T50' 'I20'                                   
       T4-TOTRECIP     = A03-KVANTMOT                                           
       PERFORM SKRIV-TPFIL4                                                     
     END-IF                                                                     
     IF A03-KDEKOHT = 'T30'                                                     
       IF A03-KDANMORS NE '60' '61'                                             
         WS-IDDC       = A03-IDDC-SEND                                          
         WS-KVJUST     = A03-KVLEVART - A03-KVANTMOT - A03-KVSKROT              
         PERFORM SKRIV-TPFIL4                                                   
       END-IF                                                                   
       WS-IDDC         = A03-IDDC-REC                                           
       T4-TOTRECIP     = A03-KVANTMOT                                           
       T4-TOTSALES     = 0                                                      
       PERFORM SKRIV-TPFIL4                                                     
     END-IF                                                                     
                                                                                
   WHEN 'L05'                                                                   
     T4-IDARTNR        = L05-IDARTNR                                            
     WS-IDDC           = L05-IDDC-REC                                           
     IF L05-KDANMORS = '00' '20'                                                
       WS-KVJUST       = L05-KVKREANT                                           
     ELSE                                                                       
       WS-KVJUST       = L05-KVKREANT * -1                                      
     END-IF                                                                     
     PERFORM SKRIV-TPFIL4                                                       
                                                                                
   WHEN 'A06'                                                                   
     T4-IDARTNR        = A06-IDARTNR                                            
     WS-IDDC           = A06-IDDC-REC                                           
     WS-KVJUST         = A06-KVRETINL                                           
     PERFORM SKRIV-TPFIL4                                                       
                                                                                
   WHEN 'A07'                                                                   
     T4-IDARTNR        = A07-IDARTNR                                            
     WS-IDDC           = A07-IDDC-SEND                                          
     WS-KVJUST         = A07-KVLEVART * -1                                      
     PERFORM SKRIV-TPFIL4                                                       
                                                                                
   WHEN 'A08'                                                                   
     T4-IDARTNR        = A08-IDARTNR                                            
     WS-IDDC           = A08-IDDC-REC                                           
     WS-KVJUST         = A08-KVJUSTKV                                           
     PERFORM SKRIV-TPFIL4                                                       
                                                                                
   WHEN 'A09'                                                                   
     T4-IDARTNR        = A09-IDARTNR                                            
     IF A09-KDEKOHT = 'T20' 'T30' 'T40'                                         
       WS-IDDC         = A09-IDDC-SEND                                          
       WS-KVJUST       = A09-KVLEVART * -1                                      
       PERFORM SKRIV-TPFIL4                                                     
     END-IF                                                                     
                                                                                
   WHEN 'L09'                                                                   
     IF L09-KDEKOHT = 'T40'                                                     
       T4-IDARTNR      = L09-IDARTNR                                            
       WS-IDDC         = L09-IDDC-SEND                                          
       WS-KVJUST       = L09-KVLEVART * -1                                      
       PERFORM SKRIV-TPFIL4                                                     
     END-IF                                                                     
                                                                                
   WHEN 'A11'                                                                   
     T4-IDARTNR        = A11-IDARTNR                                            
     WS-IDDC           = A11-IDDC-REC                                           
     T4-TOTRECIP       = A11-KVANTMOT                                           
     PERFORM SKRIV-TPFIL4                                                       
                                                                                
   WHEN 'A12'                                                                   
     T4-IDARTNR        = A12-IDARTNR                                            
     WS-IDDC           = A12-IDDC-REC                                           
     WS-KVJUST         = A12-KVJUSTKV                                           
     PERFORM SKRIV-TPFIL4                                                       
                                                                                
   WHEN 'A13'                                                                   
     T4-IDARTNR        = A13-IDARTNR                                            
     WS-IDDC           = A13-IDDC-REC                                           
     T4-TOTRECIP       = A13-KVLEVART                                           
     T4-TOTSALES       = A13-KVLEVART                                           
     PERFORM SKRIV-TPFIL4                                                       
                                                                                
   WHEN 'A14'                                                                   
     T4-IDARTNR        = A14-IDARTNR                                            
     WS-IDDC           = A14-IDDC-REC                                           
     WS-KVJUST         = A14-KVRETUR                                            
     PERFORM SKRIV-TPFIL4                                                       
                                                                                
   WHEN 'A15'                                                                   
     T4-IDARTNR        = A15-IDARTNR                                            
     IF A15-KDEKOHT = 'O31' 'O72'                                               
       WS-IDDC         = A15-IDDC-SEND                                          
     ELSE                                                                       
       WS-IDDC         = A15-IDDC-REC                                           
     END-IF                                                                     
     WS-KVJUST         = A15-KVLEVART * -1                                      
     PERFORM SKRIV-TPFIL4                                                       
                                                                                
   WHEN 'A18'                                                                   
     T4-IDARTNR        = A18-IDARTNR                                            
     WS-IDDC           = A18-IDDC-REC                                           
     WS-KVJUST         = A18-KVANTMOT                                           
     PERFORM SKRIV-TPFIL4                                                       
                                                                                
   WHEN 'A19'                                                                   
     T4-IDARTNR        = A19-IDARTNR                                            
     WS-IDDC           = A19-IDDC-REC                                           
     WS-KVJUST         = A19-KVJUSTKV                                           
     PERFORM SKRIV-TPFIL4                                                       
END-CASE                                                                        
                                                                                
SKRIV-TPFIL4. PROC                                                              
  IF WS-IDDC = '42'                                                             
    IF WS-KVJUST LT 0                                                           
      T4-TOTSALES       = T4-TOTSALES - WS-KVJUST                               
    ELSE                                                                        
      T4-TOTRECIP       = T4-TOTRECIP + WS-KVJUST                               
    END-IF                                                                      
    PUT TPFIL4                                                                  
  END-IF                                                                        
  WS-KVJUST = 0                                                                 
END-PROC.                                                                       
                                                                                
*----------------------------------------------------------------------*        
*  STEG 5                                                                       
*       SORTERA LAB-TRANSARNA PÅ ARTIKELNUMMER (TEMP4)                          
*       OCH SUMMERA PÅ DESSA BEGREPP                                            
*       RESULTATET ÄR EN TRANS PER ARTIKELNUMMER FÖR DC 42 PÅ TPFIL5            
*----------------------------------------------------------------------*        
                                                                                
SORT TPFIL4 TO TPFIL4 USING (T4-IDARTNR) SIZE 2000000                           
                                                                                
JOB INPUT TPFIL4 START 5-INIT FINISH 5-FIN                                      
                                                                                
   IF T5-IDARTNR NE T4-IDARTNR                                                  
     IF T5-IDARTNR NE 0                                                         
       PUT TPFIL5                                                               
     END-IF                                                                     
     T5-POST      = T4-POST                                                     
   ELSE                                                                         
     T5-TOTSALES  = T5-TOTSALES + T4-TOTSALES                                   
     T5-TOTRECIP  = T5-TOTRECIP + T4-TOTRECIP                                   
   END-IF                                                                       
                                                                                
5-INIT. PROC                                                                    
   T5-TOTSALES    = 0                                                           
   T5-TOTRECIP    = 0                                                           
   T5-IDARTNR     = 0                                                           
END-PROC                                                                        
                                                                                
5-FIN. PROC                                                                     
   PUT TPFIL5                                                                   
END-PROC                                                                        
*----------------------------------------------------------------------*        
*  STEG 6                                                                       
*          MATCHA FILERNA OCH SKAPA LISTA                                       
*----------------------------------------------------------------------*        
                                                                                
JOB INPUT (TPFIL3 KEY (T3-IDARTNR)    +                                         
           TPFIL5 KEY (T5-IDARTNR)) START 6-INIT FINISH 6-AVSLUT                
IF MATCHED                                                                      
    W-IDARTNR   = T3-IDARTNR                                                    
    W-BEART     = T3-BEART                                                      
    W-LPC       = T3-KDPSLLOC                                                   
    WS-LPC      = T3-KDPSLLOC                                                   
    W-TOTLS-O   = T3-TOTLS-O                                                    
    W-TOTLS-N   = T3-TOTLS-N                                                    
    W-SALES     = T5-TOTSALES                                                   
    W-RECIP     = T5-TOTRECIP                                                   
    W-PRAVCOST  = T3-PRAVCOST-N                                                 
    W-OVER-YEAR = T3-TOTLS-O - T5-TOTSALES                                      
    IF W-OVER-YEAR LT 0                                                         
      W-OVER-YEAR = 0                                                           
    END-IF                                                                      
    W-SUAVCOST  = T3-PRAVCOST-N * W-OVER-YEAR                                   
    PRINT LISTA42                                                               
    W-DIFF      = T3-TOTLS-O - T3-TOTLS-N + T5-TOTRECIP - T5-TOTSALES           
ELSE                                                                            
  IF TPFIL3                                                                     
    W-IDARTNR   = T3-IDARTNR                                                    
    W-BEART     = T3-BEART                                                      
    W-LPC       = T3-KDPSLLOC                                                   
    WS-LPC      = T3-KDPSLLOC                                                   
    W-TOTLS-O   = T3-TOTLS-O                                                    
    W-TOTLS-N   = T3-TOTLS-N                                                    
    W-SALES     = 0                                                             
    W-RECIP     = 0                                                             
    W-PRAVCOST  = T3-PRAVCOST-N                                                 
    W-OVER-YEAR = T3-TOTLS-O                                                    
    IF W-OVER-YEAR LT 0                                                         
      W-OVER-YEAR = 0                                                           
    END-IF                                                                      
    W-SUAVCOST  = T3-PRAVCOST-N * W-OVER-YEAR                                   
    PRINT LISTA42                                                               
    W-DIFF      = T3-TOTLS-O - T3-TOTLS-N                                       
  ELSE                                                                          
    W-IDARTNR   = T5-IDARTNR                                                    
    W-BEART     = ' '                                                           
    W-LPC       = 0                                                             
    WS-LPC      = 0                                                             
    W-TOTLS-O   = 0                                                             
    W-TOTLS-N   = 0                                                             
    W-SALES     = T5-TOTSALES                                                   
    W-RECIP     = T5-TOTRECIP                                                   
    W-PRAVCOST  = 0                                                             
    W-OVER-YEAR = 0                                                             
    W-SUAVCOST  = 0                                                             
    PRINT LISTA42                                                               
    W-DIFF      = T5-TOTRECIP - T5-TOTSALES                                     
  END-IF                                                                        
END-IF                                                                          
                                                                                
IF W-DIFF NE 0                                                                  
  W-ANT-PARTS = W-ANT-PARTS + 1                                                 
END-IF                                                                          
                                                                                
6-INIT. PROC                                                                    
  CALL DATKORT USING (PROGRAM-NAMN WDATUM DATUMKORT)                            
  W-NEW-SEKEL   = 20                                                            
  W-NEW-YEAR    = D-AAR - 1                                                     
  W-OLD-YEAR    = D-AAR - 2                                                     
END-PROC                                                                        
                                                                                
6-AVSLUT. PROC                                                                  
  DISPLAY 'ANTAL DIFF PARTS ' W-ANT-PARTS                                       
END-PROC                                                                        
                                                                                
*-----------------------*                                                       
* REPORT LISTA 1 NDC 42                                                         
*-----------------------*                                                       
  REPORT LISTA42                +                                               
         PRINTER W56085D6       +                                               
         PAGESIZE 32767         +                                               
         LINESIZE 300           +                                               
         SUMSPACE 0             +                                               
         SPACE 0                +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NOADJUST                                                               
                                                                                
SEQUENCE WS-LPC W-IDARTNR                                                       
CONTROL  WS-LPC                                                                 
SUM      W-SUAVCOST                                                             
                                                                                
                                                                                
LINE  1  W-IDARTNR          +                                                   
         W-SEM              +                                                   
         W-BEART            +                                                   
         W-SEM              +                                                   
         W-LPC              +                                                   
         W-SEM              +                                                   
         W-TOTLS-O          +                                                   
         W-SEM              +                                                   
         W-RECIP            +                                                   
         W-SEM              +                                                   
         W-SALES            +                                                   
         W-SEM              +                                                   
         W-TOTLS-N          +                                                   
         W-SEM              +                                                   
         W-OVER-YEAR        +                                                   
         W-SEM              +                                                   
         W-PRAVCOST         +                                                   
         W-SEM              +                                                   
         W-SUAVCOST         +                                                   
         W-SEM                                                                  
                                                                                
  BEFORE-BREAK. PROC                                                            
    IF LEVEL = 1                                                                
      DISPLAY  ' '                                                              
      DISPLAY  COL   1 'TOTAL:'                                                 
    END-IF                                                                      
                                                                                
    IF LEVEL = 2                                                                
      DISPLAY  ' '                                                              
      DISPLAY  COL   1 'GRAND TOTAL ALL LPC S:'                                 
    END-IF                                                                      
  END-PROC.                                                                     
                                                                                
BEFORE-LINE. PROC                                                               
 IF FIRST-LINE1 = 'J'                                                           
   DISPLAY '¤DAPW56085-001'                                                     
   DISPLAY '¤DAPW56085'                                                         
   DISPLAY 'PART NUMBER;DESCRIPTION;LPC;'    +                                  
           'BALANCE 12/31/' W-OLD-YEAR ';'   +                                  
           '20'  W-NEW-YEAR ' RECIEPTS;'  +                                     
           '20' W-NEW-YEAR ' SALES;'  +                                         
           'BALANCE 12/31/' W-OLD-YEAR ';UNITS OVER 1 YEAR;'  +                 
           'AVERAGE COST;EXTENDED VALUE;'                                       
   FIRST-LINE1 = 'N'                                                            
 END-IF                                                                         
END-PROC                                                                        
