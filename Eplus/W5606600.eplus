                                                                                
**********************************************************************          
*                                                                    *          
* PROGRAM ............ : W56066                                      *          
*                                                                    *          
* SKRIVET AV ......... : INGVAR SKJELBRED                            *          
*                                                                    *          
* DATUM .............. : 970731                                      *          
*                                                                    *          
* FUNKTION .. : LÄSER ÅRSINVENTARIE-FIL OCH KOMPLETTERAR MED         *          
*               BENÄMNING.                                           *          
*               SKAPAR TVÅ RAPPORTER (U2503 OCH U2505).              *          
*               LISTORNA W56066-001 OCH -002.                        *          
*                                                                    *          
* INDATA .... : W560.W560Y1.W56064(+0)                               *          
*               W011.PROD.W01174(+0)                                 *          
*                                                                    *          
* UTDATA..... : REPORT U2504 OCH U2503                               *          
*                                                                    *          
**********************************************************************          
*                                                                               
*                                                                               
* INFIL W560.W560Y1.W56064(+0) ÅRSINVENTARIUM                                   
*                                                                               
FILE W56066D1                                                                   
%W56064  'IN64-'                                                                
*                                                                               
*                                                                               
* TEMPFIL ÅRSINVENTARIUM SORTERAD                                               
*                                                                               
FILE TPFIL1 FB(91 0)                                                            
%W56064  'T1-'                                                                  
                                                                                
*                                                                               
* INFIL W011.PROD.W01174(+0) BENÄMNINGAR                                        
*                                                                               
FILE W56066D2                                                                   
%W01174  'BEN-'                                                                 
                                                                                
                                                                                
* RAPPORT U2504  (LISTA W56066-001)                                             
                                                                                
FILE W56066D3 PRINTER VB (210 0)                                                
                                                                                
* RAPPORT U2503  (LISTA W56066-002)                                             
                                                                                
FILE W56066D4 PRINTER VB (210 0)                                                
                                                                                
W-IDLEVNR         W   5  A                                                      
W-SEM             W   1  A                    VALUE ';'                         
FIRST-LINE1       S   1  A                    VALUE 'J'                         
FIRST-LINE2       S   1  A                    VALUE 'J'                         
W-IDLEVNR1        W   5  A                                                      
W-KDPSLLOC        W   2  N     MASK 'Z9'.                                       
W-TOT-STOCK       W   7  N  0  MASK '------9'.                                  
W-IDARTNR         W   9  N     MASK 'ZZZZZZZZ9'.                                
W-PRARTAVG-OLD    W   9  N  2  MASK 'ZZZZZZ9.99'                                
W-PRARTAVG-NEW    W   9  N  2  MASK 'ZZZZZZ9.99'                                
W-SUARTAVG-OLD    W   9  N  2  MASK '------9.99'                                
W-SUARTAVG-NEW    W   9  N  2  MASK '------9.99'                                
W-BEART           W  25  A                                                      
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
*********************************                                               
* STEG 1  SORTERAR INFILEN      *                                               
*********************************                                               
                                                                                
SORT W56066D1 TO TPFIL1 USING (IN64-IDARTNR)                                    
                                                                                
*****************************************************************               
*                                                               *               
* STEG 2  MATCHAR INFILEN OCH BENAMNINGS-FIL                    *               
*         OCH SKAPAR LISTORNA U2503 OCH U2504                   *               
*                                                               *               
*****************************************************************               
                                                                                
JOB INPUT (TPFIL1 KEY (T1-IDARTNR)    +                                         
           W56066D2 KEY (BEN-IDARTNR))                                          
                                                                                
 IF MATCHED                                                                     
   IF BEN-BEART(10) = '                         '                               
     W-BEART = BEN-BEART(04)                                                    
   ELSE                                                                         
     W-BEART = BEN-BEART(10)                                                    
   END-IF                                                                       
 ELSE                                                                           
   IF TPFIL1                                                                    
     W-BEART        = '                         '                               
   END-IF                                                                       
 END-IF                                                                         
                                                                                
 IF TPFIL1                                                                      
    W-IDLEVNR      = T1-IDLEVNR                                                 
    W-IDLEVNR1     = T1-IDLEVNR                                                 
    W-KDPSLLOC     = T1-KDPSLLOC                                                
    W-TOT-STOCK    = T1-TOT-STOCK                                               
    W-PRARTAVG-OLD = T1-PRARTAVG-OLD                                            
    W-PRARTAVG-NEW = T1-PRARTAVG-NEW                                            
    W-SUARTAVG-NEW = T1-SUARTAVG-NEW                                            
    W-SUARTAVG-OLD = T1-SUARTAVG-OLD                                            
    W-IDARTNR      = T1-IDARTNR                                                 
                                                                                
    PRINT LISTA1                                                                
    PRINT LISTA2                                                                
 END-IF                                                                         
                                                                                
NEWPAGE                                                                         
  REPORT LISTA1                 +                                               
         PRINTER W56066D3       +                                               
         LINESIZE 180                +                                          
         SPACE 0                     +                                          
         NOHEADING                   +                                          
         NOSPREAD                    +                                          
         NOADJUST                    +                                          
         PAGESIZE 32767              +                                          
         NODATE                                                                 
                                                                                
SEQUENCE W-IDLEVNR T1-KDPSLLOC                                                  
                                                                                
CONTROL FINAL NOPRINT                                                           
                                                                                
                                                                                
LINE  1   W-IDLEVNR1           +                                                
          W-SEM                +                                                
          W-KDPSLLOC           +                                                
          W-SEM                +                                                
          W-IDARTNR            +                                                
          W-SEM                +                                                
          W-TOT-STOCK          +                                                
          W-SEM                +                                                
          W-PRARTAVG-OLD       +                                                
          W-SEM                +                                                
          W-SUARTAVG-OLD       +                                                
          W-SEM                +                                                
          W-PRARTAVG-NEW       +                                                
          W-SEM                +                                                
          W-SUARTAVG-NEW       +                                                
          W-SEM                +                                                
          W-BEART              +                                                
          W-SEM                                                                 
                                                                                
  BEFORE-BREAK. PROC                                                            
    IF LEVEL = 1                                                                
         DISPLAY ' '                                                            
         DISPLAY W-SEM          +                                               
                 W-SEM          +                                               
                 W-SEM          +                                               
                 W-SEM          +                                               
                 W-SEM          +                                               
                 W-SUARTAVG-OLD +                                               
                 W-SEM          +                                               
                 W-SEM          +                                               
                 W-SUARTAVG-NEW +                                               
                 W-SEM                                                          
                 W-SEM                                                          
         DISPLAY ' '                                                            
    END-IF                                                                      
  END-PROC                                                                      
                                                                                
BEFORE-LINE. PROC                                                               
 IF FIRST-LINE1 = 'J'                                                           
   DISPLAY '¤DAPW56066-001'                                                     
   DISPLAY '¤DAPW56066'                                                         
   DISPLAY 'VENDOR;LPC;PART NUMBER;TOTAL-STOCK;BASE;'  +                        
           'BEGINNING-YEAR-COST;COST;END-YEAR-COST;DESCRIPTION;'                
   FIRST-LINE1 = 'N'                                                            
 END-IF                                                                         
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
                                                                                
  REPORT LISTA2                 +                                               
         PRINTER W56066D4       +                                               
         LINESIZE 180           +                                               
         SPACE 0                +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NOADJUST               +                                               
         PAGESIZE 32767         +                                               
         NODATE                                                                 
                                                                                
                                                                                
SEQUENCE W-IDLEVNR T1-KDPSLLOC                                                  
CONTROL FINAL NOPRINT                                                           
SUM     W-SUARTAVG-OLD W-SUARTAVG-NEW                                           
                                                                                
                                                                                
LINE  1  W-IDLEVNR1           +                                                 
         W-SEM                +                                                 
         W-KDPSLLOC           +                                                 
         W-SEM                +                                                 
         W-SUARTAVG-OLD       +                                                 
         W-SEM                +                                                 
         W-SUARTAVG-NEW       +                                                 
         W-SEM                                                                  
                                                                                
  BEFORE-BREAK. PROC                                                            
    IF LEVEL = 1                                                                
         DISPLAY '   '                                                          
         DISPLAY W-SEM          +                                               
                 W-SEM          +                                               
                 W-SUARTAVG-OLD +                                               
                 W-SEM          +                                               
                 W-SUARTAVG-NEW +                                               
                 W-SEM                                                          
    END-IF                                                                      
  END-PROC                                                                      
BEFORE-LINE. PROC                                                               
 IF FIRST-LINE2 = 'J'                                                           
   DISPLAY '¤DAPW56066-002'                                                     
   DISPLAY '¤DAPW56066'                                                         
   DISPLAY 'VENDOR;LPC;BEGINNING-YEAR-COST;END-YEAR-COST;'                      
   FIRST-LINE2 = 'N'                                                            
 END-IF                                                                         
END-PROC                                                                        
