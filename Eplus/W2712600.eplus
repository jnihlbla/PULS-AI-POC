                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2712600                                              *        
*                                                                      *        
*  FUNKTION   :  REFILL;                                               *        
*                SKAPAR EN EXTRAKTFIL SOM UNDERLAG FÖR                 *        
*                BESTÄLLNINGSBILD 2348                                 *        
*                (KOPIERAT W2715100)                                   *        
*                                                                      *        
*                                                                      *        
*  FÖRFATTARE :  STEFAN ÅSGÅRDEN   DEC 2002                            *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W27126D1                                                                   
                                                                                
%W01184                                                                         
**                                                                              
FILE W27126D2                                                                   
%W01186     'L7-'                                                               
                                                                                
**                                                                              
FILE W27126D3                                                                   
%W01160                                                                         
                                                                                
**                                                                              
FILE W27126D4                                                                   
%W01174     'BEN-'                                                              
                                                                                
**                                                                              
FILE W27126D5 FB (875 0)                                                        
%W27126   'DC-'                                                                 
                                                                                
**                                                                              
FILE W27126D6 FB (875 0)                                                        
%W27126   'CDC1-'                                                               
                                                                                
**                                                                              
FILE W27126D7 FB (875 0)                                                        
%W27126   'UT-'                                                                 
                                                                                
*****************                                                               
* ARBETSAREOR   *                                                               
*****************                                                               
                                                                                
*--------------------------*                                                    
* DATUMKORT                *                                                    
*--------------------------*                                                    
                                                                                
                                                                                
%WDATKORT 'DATKORT-'                                                            
                                                                                
                                                                                
  PROGRAM-NAMN          W  6 A   VALUE 'W27150'                                 
  DATUMKORT-ID          W  6 A   VALUE 'WDATUM'                                 
                                                                                
  SLAG-IDDC-REF         W  2 A   VALUE '  '                                     
                                                                                
  DAGENS-DATUM        W                     6   N                               
  DAGENS-DATUM-AA     DAGENS-DATUM          2   N                               
  DAGENS-DATUM-MM     DAGENS-DATUM       +2 2   N                               
  DAGENS-DATUM-DD     DAGENS-DATUM       +4 2   N                               
                                                                                
  INNEV-AAVVD          W               5 N                                      
  INNEV-AA             INNEV-AAVVD     2 N                                      
  INNEV-VV             INNEV-AAVVD  +2 2 N                                      
  INNEV-D              INNEV-AAVVD  +4 1 N                                      
                                                                                
                                                                                
  IX               W  2 N  VALUE 0                                              
                                                                                
  WS-KVLS-DC       W  4 N                                                       
  WS-LAGERV-DC     W  8 N 2                                                     
  WS-VARDE-OL      W  8 N 2                                                     
  WS-FLARP         W  1 A                                                       
  WS-MINUS-ETT-AAR W  3 P                                                       
  WS-SALDO         W  9 N   VALUE 0                                             
  WS-BALANCE       W  9 N   VALUE 0                                             
  WS-SUPERWEEK     W  5 N   VALUE 0                                             
  WS-SUPERWEEK-999 W  5 N   VALUE 999                                           
                                                                                
                                                                                
%WY2000W2                                                                       
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
                                                                                
NEWPAGE                                                                         
                                                                                
***********                                                                     
*  JOB 1  *                                                                     
***********                                                                     
                                                                                
* STEG 1. MATCHAR GRUNDFILER FRÅN WDK7 OCH WDL7                                 
                                                                                
JOB INPUT(W27126D1 KEY (SLAG-IDARTNR SLAG-IDDC) +                               
          W27126D2 KEY (L7-DC-IDARTNR L7-DC-IDDC)) +                            
START(A-INIT)                                                                   
                                                                                
 IF MATCHED                                                                     
    PERFORM SKAPA-W27126D5                                                      
    PERFORM SKAPA-WDL7-WDK7-TILLAGG                                             
    PUT W27126D5                                                                
 ELSE                                                                           
    IF W27126D1                                                                 
      PERFORM SKAPA-W27126D5                                                    
      PERFORM SKAPA-WDK7-TILLAGG                                                
      PUT W27126D5                                                              
    END-IF                                                                      
 END-IF                                                                         
                                                                                
                                                                                
SKAPA-W27126D5. PROC                                                            
                                                                                
 DC-IDARTNR           =  SLAG-IDARTNR                                           
 DC-IDDC              =  SLAG-IDDC                                              
 DC-IDDC-REF          =  SLAG-IDDC-REF                                          
 DC-IDPERSON-BUY      =  SLAG-IDPERSON-BUY                                      
 DC-KVPB-REF          =  SLAG-KVPB-REF                                          
 DC-KVPBREOI          =  SLAG-KVPBREOI                                          
 DC-ADLAGOMR          =  SLAG-ADLAGOMR                                          
 DC-ADGANG            =  SLAG-ADGANG                                            
 DC-ADPLATS           =  SLAG-ADPLATS                                           
 DC-KVLS              =  SLAG-KVLS                                              
 DC-KVAKS-PAV         =  SLAG-KVAKS-PAV                                         
 DC-KVAKS-SDC         =  SLAG-KVAKS-SDC                                         
 DC-KVBEART           =  SLAG-KVBEART                                           
 DC-KVREFBER          =  SLAG-KVREFBER                                          
 DC-KVREFPKT          =  SLAG-KVREFPKT                                          
 DC-KVROS-DAG         =  SLAG-KVROS-DAG                                         
 DC-KVROS-BULK        =  SLAG-KVROS-BULK                                        
 DC-TIREFPAF          =  SLAG-TIREFPAF                                          
 DC-TIREFPKT          =  SLAG-TIREFPKT                                          
 DC-IDLEVNR-DC        =  SLAG-IDLEVNR                                           
 DC-FLWILSON          =  SLAG-FLWILSON                                          
 DC-FLREFBEO          =  SLAG-FLREFBEO                                          
 DC-IDREFTAB          =  SLAG-IDREFTAB                                          
 DC-FLFLYG            =  SLAG-FLFLYG                                            
 DC-KVDAGAR-MANLT     =  SLAG-KVDAGAR-MANLT                                     
 DC-KDREFSTA          =  SLAG-KDREFSTA                                          
 DC-VKART             =  SLAG-VKART                                             
 DC-VLARTNTO          =  SLAG-VLARTNTO                                          
 WS-SUPERWEEK         = ((SLAG-KVLS + SLAG-KVBEART +                            
                        + SLAG-KVAKS-PAV + SLAG-KVAKS-SDC) +                    
                        - (SLAG-KVOKS-DAG + SLAG-KVOKS-BULK +                   
                        + SLAG-KVROS-DAG + SLAG-KVROS-BULK)) +                  
                        / ((SLAG-KVPB-REF + SLAG-KVPBREOI) / 4.33)              
 IF WS-SUPERWEEK > WS-SUPERWEEK-999                                             
   DC-SUPERWEEK       =  WS-SUPERWEEK-999                                       
 ELSE                                                                           
   DC-SUPERWEEK       = WS-SUPERWEEK                                            
 END-IF                                                                         
                                                                                
 IF WS-SUPERWEEK < 0                                                            
   DC-SUPERWEEK       =  0                                                      
 END-IF                                                                         
 IF SLAG-KVPB-REF = 0                                                 +         
 AND SLAG-KVPBREOI = 0                                                          
   WS-SALDO           = ((SLAG-KVLS + SLAG-KVBEART +                            
                          + SLAG-KVAKS-PAV + SLAG-KVAKS-SDC) +                  
                          - (SLAG-KVOKS-DAG + SLAG-KVOKS-BULK +                 
                          + SLAG-KVROS-DAG + SLAG-KVROS-BULK))                  
   IF WS-SALDO > 0                                                              
     DC-SUPERWEEK     =  WS-SUPERWEEK-999                                       
   END-IF                                                                       
 END-IF                                                                         
 WS-BALANCE           = SLAG-KVLS +                                             
                        - SLAG-KVOKS-DAG - SLAG-KVOKS-BULK +                    
                        - SLAG-KVROS-DAG - SLAG-KVROS-BULK                      
 IF WS-BALANCE < 0                                                              
   DC-SUPERWEEK       = 0                                                       
 END-IF                                                                         
                                                                                
 MOVE SPACE           TO DC-IDPROJ                                              
                         DC-BEART                                               
                         DC-BEART-ENG                                           
                         DC-IDLEVNR-CDC                                         
 MOVE ZERO            TO DC-KDERS                                               
                         DC-KDPRODSL                                            
                         DC-IDFKNGRP                                            
                         DC-PRARTBES                                            
                         DC-PRARTSTD                                            
                         DC-TIFINLV                                             
 IX = 1                                                                         
 DO WHILE IX LT 13                                                              
    DC-RESEASON(IX) = SLAG-RESEASON(IX)                                         
    IX = IX + 1                                                                 
 END-DO                                                                         
END-PROC                                                                        
                                                                                
*************************                                                       
SKAPA-WDL7-WDK7-TILLAGG. PROC                                                   
                                                                                
 DC-FLREFILL          =  SLAG-FLREFILL                                          
 DC-TIREFEFT          =  L7-DC-TIREFEFT                                         
END-PROC                                                                        
*************************                                                       
SKAPA-WDK7-TILLAGG. PROC                                                        
                                                                                
 DC-FLREFILL          =  'O'                                                    
 DC-TIREFEFT          =  0                                                      
END-PROC                                                                        
*************************                                                       
                                                                                
A-INIT. PROC                                                                    
                                                                                
* HÄMTA INNEVARANDE ÅR                                                          
                                                                                
                                                                                
*  HÄMTA DATUM FRÅN DATKORT                                                     
                                                                                
   CALL DATKORT USING (PROGRAM-NAMN +                                           
                       DATUMKORT-ID +                                           
                       DATKORT-DATUMKORT)                                       
                                                                                
   MOVE DATKORT-D-AAR    TO DAGENS-DATUM-AA                                     
   MOVE DATKORT-D-MAANAD TO DAGENS-DATUM-MM                                     
   MOVE DATKORT-D-DAG    TO DAGENS-DATUM-DD                                     
                                                                                
   INNEV-AA       = DATKORT-D-AAR                                               
   INNEV-VV       = DATKORT-D-VECKA                                             
   INNEV-D        = 1                                                           
                                                                                
*  SKAPA LÄMFÖRELSE AAVV - ETT ÅR BAKÅT                                         
                                                                                
    IF INNEV-AA = 00                                                            
      WS-MINUS-ETT-AAR = (100000 + INNEV-AAVVD) - 1000                          
    ELSE                                                                        
      WS-MINUS-ETT-AAR = INNEV-AAVVD - 1000                                     
    END-IF                                                                      
 END-PROC                                                                       
                                                                                
**********                                                                      
* JOB 3  *                                                                      
**********                                                                      
*                                                                               
* STEG 3. MATCHAR CDC-UPPGIFTER MED UPPGIFTER FRÅN BEMÄMNINGSFIL                
*                                                                               
                                                                                
JOB INPUT(W27126D3 KEY (CLAG-IDARTNR) +                                         
          W27126D4 KEY (BEN-IDARTNR))                                           
                                                                                
  IF MATCHED                                                                    
     PERFORM SKAPA-W27126D6-FIL-MATCH                                           
     PUT W27126D6                                                               
  END-IF                                                                        
                                                                                
                                                                                
 SKAPA-W27126D6-FIL-MATCH. PROC                                                 
                                                                                
    CDC1-IDARTNR        =  CLAG-IDARTNR                                         
    CDC1-IDPROJ         =  CLAG-IDPROJ                                          
    CDC1-KDERS          =  CLAG-KDERS                                           
    CDC1-KDPRODSL       =  CLAG-KDPRODSL                                        
    CDC1-IDFKNGRP       =  CLAG-IDFKNGRP                                        
    CDC1-IDLEVNR-CDC    =  CLAG-IDLEVNR                                         
    CDC1-PRARTBES       =  CLAG-PRARTSTD                                        
    CDC1-PRARTSTD       =  CLAG-PRARTSTD                                        
    CDC1-TIFINLV        =  CLAG-TIFINLV                                         
    CDC1-VKART          =  CLAG-VKART                                           
    CDC1-VLARTNTO       =  CLAG-VLARTNTO                                        
    CDC1-BEART-ENG      =  BEN-BEART(4)                                         
    CDC1-BEART          =  BEN-BEART(8)                                         
    IX = 1                                                                      
    DO WHILE IX LT 46                                                           
       MOVE SPACE       TO CDC1-BEMODELL(IX)                                    
       IX = IX + 1                                                              
    END-DO                                                                      
    MOVE SPACE          TO CDC1-IDDC                                            
                           CDC1-IDDC-REF                                        
                           CDC1-KLASS                                           
                           CDC1-IDLEVNR-DC                                      
                           CDC1-FLWILSON                                        
                           CDC1-FLREFBEO                                        
                           CDC1-IDREFTAB                                        
                           CDC1-FLREFILL                                        
                           CDC1-KDREFSTA                                        
    MOVE ZERO           TO CDC1-KVPB-REF                                        
                           CDC1-KVPBREOI                                        
                           CDC1-ADLAGOMR                                        
                           CDC1-ADGANG                                          
                           CDC1-ADPLATS                                         
                           CDC1-KVLS                                            
                           CDC1-TIREFEFT                                        
                           CDC1-KVAKS-PAV                                       
                           CDC1-KVAKS-SDC                                       
                           CDC1-KVBEART                                         
                           CDC1-KVREFBER                                        
                           CDC1-KVREFPKT                                        
                           CDC1-KVROS-DAG                                       
                           CDC1-KVROS-BULK                                      
                           CDC1-TIREFPAF                                        
                           CDC1-TIREFPKT                                        
                           CDC1-KVDAGAR-MANLT                                   
                           CDC1-SUPERWEEK                                       
    IX = 1                                                                      
    DO WHILE IX LT 13                                                           
       MOVE ZERO        TO CDC1-RESEASON(IX)                                    
       IX = IX + 1                                                              
    END-DO                                                                      
                                                                                
 END-PROC                                                                       
                                                                                
*                                                                               
**********                                                                      
* JOB 4  *                                                                      
**********                                                                      
*                                                                               
* STEG 4. MATCHAR CDC-UPPGIFTER MED DC-UPPGIFTER                                
*                                                                               
                                                                                
JOB INPUT(W27126D6 KEY (CDC1-IDARTNR) +                                         
          W27126D5 KEY (DC-IDARTNR))                                            
                                                                                
                                                                                
  IF MATCHED                                                                    
     PERFORM S23-CHECK-DC-IDDC                                                  
     PERFORM MATCH-W27126D5-W27126D6                                            
  END-IF                                                                        
                                                                                
                                                                                
 MATCH-W27126D5-W27126D6. PROC                                                  
                                                                                
    PERFORM FLYTTA-UTFALT                                                       
                                                                                
    IF UT-IDDC = NDC-CN NDC-US +                                                
    AND UT-IDDC-REF = '  '                                                      
      CONTINUE                                                                  
    ELSE                                                                        
      PUT W27126D7                                                              
    END-IF                                                                      
                                                                                
 END-PROC                                                                       
                                                                                
                                                                                
*    --- S23-CHECK-DC-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'DC-'                                                                   
*                                                                               
                                                                                
*                                                                               
 FLYTTA-UTFALT. PROC                                                            
                                                                                
    UT-IDARTNR            =     DC-IDARTNR                                      
    UT-IDDC               =     DC-IDDC                                         
    UT-IDDC-REF           =     DC-IDDC-REF                                     
    UT-KVPB-REF           =     DC-KVPB-REF                                     
    UT-KVPBREOI           =     DC-KVPBREOI                                     
    UT-ADLAGOMR           =     DC-ADLAGOMR                                     
    UT-ADGANG             =     DC-ADGANG                                       
    UT-ADPLATS            =     DC-ADPLATS                                      
    UT-KVLS               =     DC-KVLS                                         
    UT-IDPROJ             =     CDC1-IDPROJ                                     
    UT-KDERS              =     CDC1-KDERS                                      
    UT-KDPRODSL           =     CDC1-KDPRODSL                                   
    UT-IDFKNGRP           =     CDC1-IDFKNGRP                                   
    UT-TIREFEFT           =     DC-TIREFEFT                                     
    UT-PRARTBES           =     CDC1-PRARTBES                                   
    UT-PRARTSTD           =     CDC1-PRARTSTD                                   
    UT-KVAKS-PAV          =     DC-KVAKS-PAV                                    
    UT-KVAKS-SDC          =     DC-KVAKS-SDC                                    
    UT-KVBEART            =     DC-KVBEART                                      
    UT-KVREFBER           =     DC-KVREFBER                                     
    UT-KVREFPKT           =     DC-KVREFPKT                                     
    UT-KVROS-DAG          =     DC-KVROS-DAG                                    
    UT-KVROS-BULK         =     DC-KVROS-BULK                                   
    UT-TIFINLV            =     CDC1-TIFINLV                                    
    UT-TIREFPAF           =     DC-TIREFPAF                                     
    UT-TIREFPKT           =     DC-TIREFPKT                                     
    UT-IDLEVNR-CDC        =     CDC1-IDLEVNR-CDC                                
    UT-IDLEVNR-DC         =     DC-IDLEVNR-DC                                   
    UT-FLREFILL           =     DC-FLREFILL                                     
    UT-FLWILSON           =     DC-FLWILSON                                     
    UT-FLREFBEO           =     DC-FLREFBEO                                     
    UT-IDREFTAB           =     DC-IDREFTAB                                     
    UT-KVDAGAR-MANLT      =     DC-KVDAGAR-MANLT                                
    UT-BEART              =     CDC1-BEART                                      
    UT-BEART-ENG          =     CDC1-BEART-ENG                                  
    UT-KDREFSTA           =     DC-KDREFSTA                                     
    UT-SUPERWEEK          =     DC-SUPERWEEK                                    
                                                                                
                                                                                
    IF DC-IDDC-REF = '11' +                                                     
    OR DC-IDDC-REF = '  '                                                       
      UT-VKART            =     CDC1-VKART                                      
      UT-VLARTNTO         =     CDC1-VLARTNTO                                   
    ELSE                                                                        
      UT-VKART            =     DC-VKART                                        
      UT-VLARTNTO         =     DC-VLARTNTO                                     
    END-IF                                                                      
                                                                                
    UT-IDPERSON-BUY       =     DC-IDPERSON-BUY                                 
    UT-FLFLYG             =     DC-FLFLYG                                       
                                                                                
    MOVE SPACE            TO    UT-KLASS                                        
    IX = 1                                                                      
    DO WHILE IX LT 46                                                           
       MOVE SPACE         TO    UT-BEMODELL(IX)                                 
       IX = IX + 1                                                              
    END-DO                                                                      
                                                                                
    IX = 1                                                                      
    DO WHILE IX LT 13                                                           
       UT-RESEASON(IX) = DC-RESEASON(IX)                                        
       IX = IX + 1                                                              
    END-DO                                                                      
                                                                                
 END-PROC                                                                       
                                                                                
 NEWPAGE                                                                        
%WY2000P2                                                                       
*                                                                               
                                                                                
