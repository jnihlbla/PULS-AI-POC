                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W1126100                                              *        
*                                                                      *        
*  FUNKTION   :  LÄSER FIL W11260                                      *        
*                SKAPAR LISTA ARTIKEL TILLKOMMER/UTGÅR I SATS          *        
*                                                                      *        
*  FÖRFATTARE :  BODIL LINDAHL                                         *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W11261D1                                                                   
*                                                                               
%W11260  'IN-'                                                                  
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W11261D2  PRINTER FB (120 0)                                               
*                                                                               
PROGRAM-NAMN      W   6   A   VALUE 'W11261'                                    
DATUMKORT-ID      W   6   A   VALUE 'WDATUM'                                    
%WDATKORT 'DATKORT-'                                                            
NEWPAGE                                                                         
INNEV-AAMMDD      W                  6  N                                       
INNEV-AA          INNEV-AAMMDD       2  N                                       
INNEV-MM          INNEV-AAMMDD  +2   2  N                                       
INNEV-DD          INNEV-AAMMDD  +4   2  N                                       
WS-IDARTNR        W   9   N   MASK 'ZZZZZZZZ9'.                                 
WS-ADLAGOMR       W   3   N   MASK 'ZZ9'.                                       
WS-ADGANG         W   5   N   MASK 'ZZZZ9'.                                     
WS-ADPLATS        W   5   N   MASK 'ZZZZ9'.                                     
WS-ADLAGOMR-SVS   W   3   N   MASK 'ZZ9'.                                       
WS-ADGANG-SVS     W   5   N   MASK 'ZZZZ9'.                                     
WS-ADPLATS-SVS    W   5   N   MASK 'ZZZZ9'.                                     
WS-VECKA-TILLK    W   4   N   MASK BWZ.                                         
WS-VECKA-UTG      W   4   N   MASK BWZ.                                         
*                                                                               
NEWPAGE                                                                         
*                                                                               
************************************************************************        
* LÄSER INFIL W11260                                                            
************************************************************************        
*                                                                               
JOB INPUT (W11261D1) +                                                          
    START (A-INIT)                                                              
                                                                                
    WS-IDARTNR      = IN-IDARTNR                                                
    WS-ADLAGOMR     = IN-ADLAGOMR                                               
    WS-ADGANG       = IN-ADGANG                                                 
    WS-ADPLATS      = IN-ADPLATS                                                
    WS-ADLAGOMR-SVS = IN-ADLAGOMR-SVS                                           
    WS-ADGANG-SVS   = IN-ADGANG-SVS                                             
    WS-ADPLATS-SVS  = IN-ADPLATS-SVS                                            
    IF IN-FLIART = 'J'                                                          
       WS-VECKA-TILLK = IN-TIAAVV                                               
       WS-VECKA-UTG   = 0                                                       
    ELSE                                                                        
       WS-VECKA-UTG   = IN-TIAAVV                                               
       WS-VECKA-TILLK = 0                                                       
    END-IF                                                                      
                                                                                
    PRINT RAPPORT01                                                             
*                                                                               
NEWPAGE                                                                         
*                                                                               
A-INIT. PROC                                                                    
*                                                                               
  CALL DATKORT  USING (PROGRAM-NAMN +                                           
                       DATUMKORT-ID +                                           
                       DATKORT-DATUMKORT)                                       
  INNEV-AA      = DATKORT-D-AAR                                                 
  INNEV-MM      = DATKORT-D-MAANAD                                              
  INNEV-DD      = DATKORT-D-DAG                                                 
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
REPORT RAPPORT01 PRINTER W11261D2 LINESIZE 116 PAGESIZE 41 +                    
       NOADJUST NOSPREAD SPACE 1 TITLESKIP 3                                    
                                                                                
SEQUENCE IN-FLIART                                                              
                                                                                
TITLE 1  COL 12  'VCCS W11261-001'                                              
TITLE 2  COL 12  'TILLKOMMANDE/UTGÅENDE ARTIKLAR I SATS'                        
HEADING WS-IDARTNR       ('ARTIKELNR')                                          
HEADING WS-VECKA-TILLK   ('TILLK. VECKA')                                       
HEADING WS-VECKA-UTG     ('UTGÅR VECKA')                                        
HEADING WS-ADLAGOMR      ('LAGEROMR.')                                          
HEADING WS-ADGANG        ('GÅNG')                                               
HEADING WS-ADPLATS       ('PLATS')                                              
HEADING WS-ADLAGOMR-SVS  ('LAGEROMR.-SVS')                                      
HEADING WS-ADGANG-SVS    ('GÅNG-SVS')                                           
HEADING WS-ADPLATS-SVS   ('PLATS-SVS')                                          
                                                                                
LINE 01  WS-IDARTNR WS-VECKA-TILLK WS-VECKA-UTG WS-ADLAGOMR   +                 
      WS-ADGANG WS-ADPLATS WS-ADLAGOMR-SVS WS-ADGANG-SVS WS-ADPLATS-SVS         
