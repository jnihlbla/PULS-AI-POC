*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W3309700                                              *        
*                                                                      *        
*  FUNKTION   :  LÄSER W91042(+0) OCH SKAPAR UTFIL MED ARTIKEL INFO.   *        
*                                                                      *        
*  FÖRFATTARE :  BOHLIN HÅKAN                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W33097D1                                                                   
*                                                                               
%W91042  'IN-'                                                                  
IN-BEART-ENG    598  25   A                                                     
                                                                                
NEWPAGE                                                                         
FILE W33097D2 FB(116 0)                                                         
*                                                                               
%W33097  'OUT-'                                                                 
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. LÄSER W91042(+0) OCH SKAPAR EN UTFIL MED ARTIKEL INFO                 
*                                                                               
JOB INPUT W33097D1                                                              
                                                                                
    OUT-IDARTNR  = IN-IDARTNR                                                   
    OUT-BEART    = IN-BEART-ENG                                                 
    OUT-IDPROJ   = IN-IDPROJ                                                    
    OUT-TEARTNOT = IN-TEARTNOT                                                  
    OUT-KDPRODSL = IN-KDPRODSL                                                  
    OUT-IDFKNGRP = IN-IDFKNGRP                                                  
    OUT-IDLEVNR  = IN-IDLEVNR                                                   
    OUT-PRARTSTD = IN-PRARTSTD                                                  
    OUT-TIFINLV  = IN-TIFINLV                                                   
    IF IN-KDERS-UTG > 0                                                         
       OUT-KDERS    = IN-KDERS-UTG                                              
    ELSE                                                                        
       OUT-KDERS    = IN-KDERS                                                  
    END-IF                                                                      
    OUT-TIERSDAT = IN-TIERSDAT                                                  
    OUT-TIURPROD = IN-TIURPROD                                                  
    PUT W33097D2                                                                
                                                                                
