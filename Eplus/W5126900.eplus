*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5126900                                              *        
*                                                                      *        
*  FUNKTION   :  OBSOLESCENCE REPORT FOR SEPV (COMPANY CODE 57)        *        
*                PART NO SPLIT PER OBSOLESCENCE GROUPS                 *        
*                                                                      *        
*  FÖRFATTARE :  SARASWATHY S                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
*                                                                               
NEWPAGE                                                                         
FILE W51269D1 FB(69 0)                                                          
*                                                                               
%W51268  'IN-'                                                                  
*                                                                               
NEWPAGE                                                                         
FILE W51269D2 PRINTER VB(319 0)                                                 
*                                                                               
UT-IDARTNR       W   9   N   0 MASK 'ZZZZZZZZ9'         VALUE 0                 
UT-PRARTSTD      W  11   N   2 MASK 'ZZZZZZZZ9.99-'     VALUE 0                 
UT-KDPRODSL      W   3   N   0 MASK 'ZZ9'               VALUE 0                 
UT-KVANTAL       W   9   N   0 MASK 'ZZZZZZZZ9'         VALUE 0                 
UT-SULEVANT      W   9   N                              VALUE 0                 
UT-TIFINLV       W   5   N                              VALUE 0                 
UT-KDERS         W   2   N                              VALUE 0                 
UT-KVPB          W   8   N   1 MASK 'ZZZZZZ9.9-'        VALUE 0                 
UT-KDKG          W   1   N   0                          VALUE 0                 
UT-STOCKVALUE1   W  13   N   2 MASK 'ZZZZZZZZZZ9.99-'   VALUE 0                 
UT-STOCKVALUE2   W  13   N   2 MASK 'ZZZZZZZZZZ9.99-'   VALUE 0                 
UT-STOCKVALUE3   W  13   N   2 MASK 'ZZZZZZZZZZ9.99-'   VALUE 0                 
UT-STOCKVALUE4   W  13   N   2 MASK 'ZZZZZZZZZZ9.99-'   VALUE 0                 
UT-STOCKVALUE5   W  13   N   2 MASK 'ZZZZZZZZZZ9.99-'   VALUE 0                 
UT-STOCKVALUE6   W  13   N   2 MASK 'ZZZZZZZZZZ9.99-'   VALUE 0                 
UT-SEMICOLON     W   1   A   VALUE ';'                                          
*                                                                               
NEWPAGE                                                                         
*                                                                               
****WORKING STORAGE SECTION                                                     
FIRST-LINE        S   1   A  VALUE 'J'                                          
WS-STOCKVALUE1   W  13   N   2 VALUE 0                                          
WS-STOCKVALUE2   W  13   N   2 VALUE 0                                          
WS-STOCKVALUE3   W  13   N   2 VALUE 0                                          
WS-STOCKVALUE4   W  13   N   2 VALUE 0                                          
WS-STOCKVALUE5   W  13   N   2 VALUE 0                                          
WS-STOCKVALUE6   W  13   N   2 VALUE 0                                          
WS-ST-TOTAL      W  13   N   2 VALUE 0                                          
*                                                                               
*-----------------------------------------------------------------*             
* STEP 1  READ W51268 SORTED WITH KDKG AND IDARTNR                              
*-----------------------------------------------------------------*             
JOB INPUT W51269D1                                                              
   IF IN-KVANTAL  NE 0                                                          
     UT-IDARTNR     = IN-IDARTNR                                                
     UT-PRARTSTD    = IN-PRARTSTD                                               
     UT-KDPRODSL    = IN-KDPRODSL                                               
     UT-SULEVANT    = IN-SULEVANT                                               
     UT-TIFINLV     = IN-TIFINLV                                                
     UT-KDERS       = IN-KDERS                                                  
     UT-KVPB        = IN-KVPB                                                   
     UT-KDKG        = IN-KDKG                                                   
     UT-KVANTAL     = IN-KVANTAL                                                
     UT-STOCKVALUE1 = IN-STOCKVALUE1                                            
     UT-STOCKVALUE2 = IN-STOCKVALUE2                                            
     UT-STOCKVALUE3 = IN-STOCKVALUE3                                            
     UT-STOCKVALUE4 = IN-STOCKVALUE4                                            
     UT-STOCKVALUE5 = IN-STOCKVALUE5                                            
     UT-STOCKVALUE6 = IN-STOCKVALUE6                                            
     PRINT REPORT1                                                              
   END-IF                                                                       
*-----------------------------------------------------------------*             
*     REPORT  W51269-001                                                        
*-----------------------------------------------------------------*             
NEWPAGE                                                                         
   REPORT   REPORT1              +                                              
            PRINTER W51269D2     +                                              
            PAGESIZE 32000       +                                              
            LINESIZE 314         +                                              
            SPACE 0              +                                              
            NOHEADING            +                                              
            NOSPREAD             +                                              
            NOADJUST             +                                              
            NOPAGE               +                                              
            NODATE                                                              
   LINE 1   UT-IDARTNR           +                                              
            UT-SEMICOLON         +                                              
            UT-PRARTSTD          +                                              
            UT-SEMICOLON         +                                              
            UT-KDPRODSL          +                                              
            UT-SEMICOLON         +                                              
            UT-KVANTAL           +                                              
            UT-SEMICOLON         +                                              
            UT-SULEVANT          +                                              
            UT-SEMICOLON         +                                              
            UT-TIFINLV           +                                              
            UT-SEMICOLON         +                                              
            UT-KDERS             +                                              
            UT-SEMICOLON         +                                              
            UT-KVPB              +                                              
            UT-SEMICOLON         +                                              
            UT-KDKG              +                                              
            UT-SEMICOLON         +                                              
            UT-STOCKVALUE1       +                                              
            UT-SEMICOLON         +                                              
            UT-STOCKVALUE2       +                                              
            UT-SEMICOLON         +                                              
            UT-STOCKVALUE3       +                                              
            UT-SEMICOLON         +                                              
            UT-STOCKVALUE4       +                                              
            UT-SEMICOLON         +                                              
            UT-STOCKVALUE5       +                                              
            UT-SEMICOLON         +                                              
            UT-STOCKVALUE6                                                      
                                                                                
 BEFORE-LINE. PROC                                                              
  IF FIRST-LINE = 'J'                                                           
    DISPLAY '¤DAPW51269-001'                                                    
    DISPLAY '¤DAPW51269'                                                        
    DISPLAY 'PART NUMBER;STANDARD PRICE;PRODUCT GROUP;' +                       
            'QUANTITY;SALES QTY;PUBLICATION WEEK;' +                            
            'SUPERSESSION CODE;PERIOD REQUIREMENTS;TURNOVER CODE;' +            
            'STOCKVALUE TURNOVER GROUP 1;STOCKVALUE TURNOVER GROUP 2;' +        
            'STOCKVALUE TURNOVER GROUP 3;STOCKVALUE TURNOVER GROUP 4;' +        
            'STOCKVALUE TURNOVER GROUP 5;STOCKVALUE TURNOVER GROUP 6;'          
    FIRST-LINE = 'N'                                                            
  END-IF                                                                        
 END-PROC                                                                       
