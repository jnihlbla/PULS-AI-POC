                                                                                
*    PROGRAMNAMN:W4260800                                       *               
*                                                               *               
*    UTFÄRDARE: INGER NILSSON             DATUM: 900514         *               
*    KORT BESKRIVNING: KVALITET FELLISTA                        *               
*                                                               *               
                                                                                
FILE W42608D1                                                                   
%W4260402 'IN-'                                                                 
                                                                                
W-TIAARP   IN-TIAARP      3 P                                                   
W-ADLAGOMR IN-ADLAGOMR    2 P                                                   
W-KVKVAFPO IN-KVKVAFPO    2 P                                                   
                                                                                
                                                                                
FILE W42608D2 PRINTER FB(121 121)                                               
FILE W42608D3 PRINTER FB(121 121)                                               
FILE W42608D4 PRINTER FB(121 121)                                               
FILE W42608D5 PRINTER FB(121 121)                                               
FILE W42608D6 PRINTER FB(121 121)                                               
FILE W42608D7 PRINTER FB(121 121)                                               
FILE W42608D8 PRINTER FB(121 121)                                               
*                                                                               
%WDATKORT                                                                       
*                                                                               
PROGRAM-NAMN       W  6  A  VALUE 'W42608'                                      
DATUMKORT-ID       W  6  A  VALUE 'WDATUM'                                      
W-BEART            W 22  A                                                      
W-ADGANG           W  3  N  MASK 'ZZ9'                                          
W-ADPLATS          W  5  N  MASK 'ZZZZ9'                                        
W-IDARTNR          W  9  N  MASK 'ZZZZZZZ99'                                    
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
%WY2000W7                                                                       
 W-Y2K-TIAARP      W  4  N                                                      
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT W42608D1 START A-INIT                                                 
                                                                                
    W-ADGANG  = IN-ADGANG                                                       
    W-ADPLATS = IN-ADPLATS                                                      
    W-IDARTNR = IN-IDARTNR                                                      
    W-BEART   = IN-BEART                                                        
    TMP1-YYRP = W-TIAARP                                                        
    PERFORM WY2000P7                                                            
    W-Y2K-TIAARP = TMP1-YYRP                                                    
    IF IN-IDDC = CDC-SE                                                         
       PRINT LISTA-CDC                                                          
    ELSE                                                                        
      IF IN-IDDC = SDC-NL                                                       
        PRINT LISTA-DC21                                                        
      ELSE                                                                      
*       IF IN-IDDC = DC22                                                       
*         PRINT LISTA-DC22                                                      
*       ELSE                                                                    
          IF IN-IDDC = SDC-GB                                                   
            PRINT LISTA-DC23                                                    
          ELSE                                                                  
            IF IN-IDDC = SDC-ES                                                 
              PRINT LISTA-DC24                                                  
            ELSE                                                                
              IF IN-IDDC = SDC-IT                                               
                PRINT LISTA-DC25                                                
              ELSE                                                              
                IF IN-IDDC = SDC-AT                                             
                  PRINT LISTA-DC26                                              
                END-IF                                                          
              END-IF                                                            
            END-IF                                                              
          END-IF                                                                
*       END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
*                                                                               
 A-INIT.  PROC                                                                  
     CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                   
 END-PROC                                                                       
*                                                                               
%WY2000P7                                                                       
*                                                                               
