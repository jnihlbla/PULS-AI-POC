                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5156900                                              *        
*                                                                      *        
*  FUNKTION   :  MARKERA RADER OCH HUVUDEN MED EN SOFTWARE MARKERING   *        
*                SW.                                                   *        
*                                                                      *        
*  FÖRFATTARE :  HÅKAN BOHLIN                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
*****************************************************************               
*    IN-FILER: W51571A, SAP/R3 - EJ FAKTUROR/KREDITNOTOR         *              
*            : W51573A, SAP/R3 - FAKTURA-/KREDITNOTAPOSTER ÖVRIGA*              
*****************************************************************               
FILE W51569D1                                                                   
%R3HEAD41  'IN71A-'                                                             
%R3LINE20  'IN71A-'                                                             
                                                                                
                                                                                
FILE W51569D2                                                                   
%R3HEAD41  'IN73A-'                                                             
%R3LINE20  'IN73A-'                                                             
                                                                                
                                                                                
NEWPAGE                                                                         
                                                                                
**************************************************                              
* UTFIL MED DAGENS LAGERBOKADE POSTER            *                              
**************************************************                              
FILE W51569D3      VB(755 0)                                                    
%R3HEAD41  'UT71-'                                                              
%R3LINE20  'UT71-'                                                              
                                                                                
*                                                                               
FILE W51569D4      VB(755 0)                                                    
%R3HEAD41  'UT73-'                                                              
%R3LINE20  'UT73-'                                                              
                                                                                
********************************************************                        
* WORKING-STORAGE                                      *                        
********************************************************                        
*                                                                               
  JA                        W   1 A   VALUE 'J'                                 
  NEJ                       W   1 A   VALUE 'N'                                 
*                                                                               
  WS-DOCUMENT-NO-REF              W  16  A                                      
  WS-IN73A-LINE-DOCUMENT-NO-REF   W  16  A                                      
  WS-IN73A-HEAD-DOCUMENT-NO-REF   W  16  A                                      
*                                                                               
**%WWDC99                                                                       
                                                                                
W-IDDC          W  2 A                                                          
                                                                                
FIRST-TIME-SW         W 1 A VALUE 'N'                                           
                                                                                
WS-KOLL-TEXT                        W 50 A                                      
WS-KOLL-TEXT-KDEKHHT  WS-KOLL-TEXT     3 A                                      
WS-KOLL-TEXT-KDEKSHT  WS-KOLL-TEXT +3  3 A                                      
WS-KOLL-TEXT-SOFT     WS-KOLL-TEXT +6  2 A                                      
WS-KOLL-REST          WS-KOLL-TEXT +8  42 A                                     
                                                                                
WS-HEAD-TEXT                         W 25 A                                     
WS-HEAD-FEEDER-SYSTEM WS-HEAD-TEXT     10 A                                     
WS-HEAD-KDEKHHT       WS-HEAD-TEXT +10  3 A                                     
WS-HEAD-KDEKSHT       WS-HEAD-TEXT +13  3 A                                     
WS-HEAD-TEXT-SOFT     WS-HEAD-TEXT +16  2 A                                     
WS-HEAD-REST          WS-HEAD-TEXT +18  7 A                                     
                                                                                
WS-LINE-TEXT                        W 50 A                                      
WS-LINE-TEXT-KDEKHHT  WS-LINE-TEXT     3 A                                      
WS-LINE-TEXT-KDEKSHT  WS-LINE-TEXT +3  3 A                                      
WS-LINE-TEXT-SOFT     WS-LINE-TEXT +6  2 A                                      
WS-LINE-REST          WS-LINE-TEXT +8  42 A                                     
                                                                                
*----------------------------------------------------------------*              
* STEG 1             JOB SECTION                                 *              
* MARKERA HUVUDEN OCH RADER I INFIL W51571 MED EN                *              
* SOFTWAREMARKERING 'SW'.                                        *              
*----------------------------------------------------------------*              
                                                                                
***                                                                             
                                                                                
JOB INPUT NULL                                                                  
                                                                                
  GET W51569D1                                                                  
                                                                                
  DO WHILE NOT EOF W51569D1                                                     
                                                                                
    IF IN71A-HEAD-RECORD-TYPE = '200' '300' '600'                               
      UT71-HEAD-R3            = IN71A-HEAD-R3                                   
    ELSE                                                                        
      UT71-LINE-R3            = IN71A-LINE-R3                                   
    END-IF                                                                      
                                                                                
    IF IN71A-LINE-RECORD-TYPE = '610'                                           
      WS-KOLL-TEXT            = IN71A-LINE-TEXT                                 
                                                                                
      IF WS-KOLL-TEXT-SOFT    = 'SW'                                            
        WS-DOCUMENT-NO-REF    = IN71A-LINE-DOCUMENT-NO-REF                      
      ELSE                                                                      
        WS-DOCUMENT-NO-REF = '0000000000000000'                                 
      END-IF                                                                    
    END-IF                                                                      
                                                                                
    IF  IN71A-HEAD-DOCUMENT-NO-REF  = WS-DOCUMENT-NO-REF                        
      IF IN71A-HEAD-RECORD-TYPE     = '200' '300' '600'                         
                                                                                
          WS-HEAD-TEXT     = IN71A-HEAD-TEXT                                    
          WS-HEAD-TEXT-SOFT = 'SW'                                              
          UT71-HEAD-TEXT   = WS-HEAD-TEXT                                       
      END-IF                                                                    
    END-IF                                                                      
                                                                                
    IF  IN71A-LINE-DOCUMENT-NO-REF  = WS-DOCUMENT-NO-REF                        
      IF IN71A-LINE-RECORD-TYPE     = '310'                                     
          WS-LINE-TEXT     = IN71A-LINE-TEXT                                    
          WS-LINE-TEXT-SOFT = 'SW'                                              
          UT71-LINE-TEXT   = WS-LINE-TEXT                                       
      END-IF                                                                    
    END-IF                                                                      
                                                                                
    IF IN71A-HEAD-RECORD-TYPE = '200' '300' '600'                               
      RECORD-LENGTH(W51569D3) = 148                                             
    ELSE                                                                        
      RECORD-LENGTH(W51569D3) = 751                                             
    END-IF                                                                      
                                                                                
    PUT W51569D3                                                                
    GET W51569D1                                                                
  END-DO                                                                        
                                                                                
  FIRST-TIME-SW                = 'N'                                            
                                                                                
STOP                                                                            
                                                                                
*----------------------------------------------------------------*              
* STEG 2             JOB SECTION                                 *              
* MARKERA HUVUDEN OCH RADER I INFIL W51573 MED EN                *              
* SOFTWAREMARKERING 'SW'.                                        *              
*----------------------------------------------------------------*              
                                                                                
***                                                                             
                                                                                
JOB INPUT NULL                                                                  
                                                                                
  GET W51569D2                                                                  
                                                                                
  DO WHILE NOT EOF W51569D2                                                     
                                                                                
    IF IN73A-HEAD-RECORD-TYPE = '200' '300' '600'                               
      UT73-HEAD-R3            = IN73A-HEAD-R3                                   
    ELSE                                                                        
      UT73-LINE-R3            = IN73A-LINE-R3                                   
    END-IF                                                                      
                                                                                
    IF IN73A-LINE-RECORD-TYPE = '610'                                           
      WS-KOLL-TEXT            = IN73A-LINE-TEXT                                 
                                                                                
      IF WS-KOLL-TEXT-SOFT    = 'SW'                                            
        WS-DOCUMENT-NO-REF = IN73A-LINE-DOCUMENT-NO-REF                         
      ELSE                                                                      
        WS-DOCUMENT-NO-REF = '0000000000000000'                                 
      END-IF                                                                    
    END-IF                                                                      
                                                                                
    IF  IN73A-HEAD-DOCUMENT-NO-REF  = WS-DOCUMENT-NO-REF                        
      IF IN73A-HEAD-RECORD-TYPE     = '200' '300' '600'                         
          WS-HEAD-TEXT    = IN73A-HEAD-TEXT                                     
          WS-HEAD-TEXT-SOFT = 'SW'                                              
          UT73-HEAD-TEXT  = WS-HEAD-TEXT                                        
      END-IF                                                                    
    END-IF                                                                      
                                                                                
    IF  IN73A-LINE-DOCUMENT-NO-REF  = WS-DOCUMENT-NO-REF                        
      IF IN73A-LINE-RECORD-TYPE     = '310'                                     
          WS-LINE-TEXT    = IN73A-LINE-TEXT                                     
          WS-LINE-TEXT-SOFT = 'SW'                                              
          UT73-LINE-TEXT  = WS-LINE-TEXT                                        
      END-IF                                                                    
    END-IF                                                                      
                                                                                
    IF IN73A-HEAD-RECORD-TYPE = '200' '300' '600'                               
      RECORD-LENGTH(W51569D4) = 148                                             
    ELSE                                                                        
      RECORD-LENGTH(W51569D4) = 751                                             
    END-IF                                                                      
                                                                                
    PUT W51569D4                                                                
    GET W51569D2                                                                
  END-DO                                                                        
                                                                                
STOP                                                                            
                                                                                
***                                                                             
