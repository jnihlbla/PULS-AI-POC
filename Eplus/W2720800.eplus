                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2720800                                              *        
*                                                                      *        
*  FUNKTION   :  SELECTS CHANGED KDERS FOR CDC REFILL                  *        
*                                                                      *        
*  FÖRFATTARE :  JOHAN NIHLBLAD                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
                                                                                
FILE W27208D1                                                                   
%W27108   'OLD-'                                                                
                                                                                
FILE W27208D2                                                                   
%W27108   'NEW-'                                                                
                                                                                
FILE W27208D3 FB(9 0)                                                           
%W27208  'UT-'                                                                  
NEWPAGE                                                                         
*                                                                               
JOB INPUT (W27208D1 KEY (OLD-IDARTNR) +                                         
           W27208D2 KEY (NEW-IDARTNR))                                          
                                                                                
  IF MATCHED                                                                    
     UT-IDARTNR     = NEW-IDARTNR                                               
     UT-KDERS       = NEW-KDERS                                                 
     IF OLD-KDERS EQ 00 AND NEW-KDERS NE 00                                     
        IF NEW-KDERS EQ 02                                                      
           MOVE '18' TO UT-KDREFTXT                                             
           PUT W27208D3                                                         
        END-IF                                                                  
        IF NEW-KDERS EQ 03                                                      
           MOVE '19' TO UT-KDREFTXT                                             
           PUT W27208D3                                                         
        END-IF                                                                  
        IF NEW-KDERS EQ 09                                                      
           MOVE '20' TO UT-KDREFTXT                                             
           PUT W27208D3                                                         
        END-IF                                                                  
        IF NEW-KDERS EQ 14                                                      
           MOVE '14' TO UT-KDREFTXT                                             
           PUT W27208D3                                                         
        END-IF                                                                  
        IF NEW-KDERS EQ 22                                                      
           MOVE '21' TO UT-KDREFTXT                                             
           PUT W27208D3                                                         
        END-IF                                                                  
        IF NEW-KDERS EQ 23                                                      
           MOVE '22' TO UT-KDREFTXT                                             
           PUT W27208D3                                                         
        END-IF                                                                  
        IF NEW-KDERS EQ 24                                                      
           MOVE '24' TO UT-KDREFTXT                                             
           PUT W27208D3                                                         
        END-IF                                                                  
     ELSE                                                                       
        IF OLD-KDERS EQ 02 AND NEW-KDERS EQ 22                                  
           MOVE '21' TO UT-KDREFTXT                                             
           PUT W27208D3                                                         
        ELSE                                                                    
          IF OLD-KDERS EQ 03 AND NEW-KDERS EQ 23                                
             MOVE '22' TO UT-KDREFTXT                                           
             PUT W27208D3                                                       
          ELSE                                                                  
            IF OLD-KDERS EQ 04 AND NEW-KDERS EQ 14                              
               MOVE '14' TO UT-KDREFTXT                                         
               PUT W27208D3                                                     
            ELSE                                                                
              IF OLD-KDERS EQ 04 AND NEW-KDERS EQ 24                            
                 MOVE '24' TO UT-KDREFTXT                                       
                 PUT W27208D3                                                   
              ELSE                                                              
                IF OLD-KDERS EQ 14 AND NEW-KDERS EQ 24                          
                   MOVE '24' TO UT-KDREFTXT                                     
                   PUT W27208D3                                                 
                ELSE                                                            
                  IF OLD-KDERS NE 00 AND NEW-KDERS EQ 00                        
                     IF OLD-KDERS = 09 19 29                                    
                        CONTINUE                                                
                     ELSE                                                       
                        MOVE '76' TO UT-KDREFTXT                                
                        PUT W27208D3                                            
                     END-IF                                                     
                  END-IF                                                        
                END-IF                                                          
              END-IF                                                            
            END-IF                                                              
          END-IF                                                                
        END-IF                                                                  
     END-IF                                                                     
  END-IF                                                                        
                                                                                
