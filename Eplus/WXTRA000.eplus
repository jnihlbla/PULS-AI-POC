FILE WXTRA0DF FB(178 0).                                                        
%WXTRA7   'UT7-'                                                                
*                                                                               
W-DARFS-3-12         W 10  N                                                    
W-DARFS-3-8          W  6  N                                                    
W-DARFS-9-12         W  4  N                                                    
                                                                                
*                                                                               
*    -- CHECKED BY WY2000                                                       
***                                                                             
                                                                                
JOB INPUT (WXTRA0D3 KEY (E6-IDPRODNR E6-IDKOLLI))                               
                                                                                
  IF DUPLICATE WXTRA0D3                                                         
     IF FIRST-DUP WXTRA0D3                                                      
                                                                                
        PUT WXTRA0DD FROM WXTRA0D3                                              
     END-IF                                                                     
  ELSE                                                                          
                                                                                
     PUT WXTRA0DD FROM WXTRA0D3                                                 
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT (WXTRA0DD KEY (E6T-IDPRODNR E6T-IDKOLLI) +                            
           WXTRA0D1 KEY (E4-IDPRODNR  E4-IDKOLLI))                              
                                                                                
*MATCH W47923B FILE (WDE4) AND W47925X FILE (INVOICED LINES)                    
                                                                                
  IF MATCHED                                                                    
    E4-IDPTYP   = E6T-IDPTYP                                                    
    IF E4-FLDIRLEV = 'J'                                                        
***    *DDGS ORDERS HAS CORRECT E4-TIBEGPAC                                     
    ELSE                                                                        
       E4-TIBEGPAC = E6T-TIBEGPAC                                               
    END-IF                                                                      
    E4-IDPRC        = '0000'                                                    
    E4-IDSHIFT      = '0'                                                       
    E4-KDPRODSL     = 0                                                         
    E4-PRARTSTD     = 0                                                         
    E4-TIPACKN      = E6T-TIPACKN                                               
    E4-TIPACTID     = E6T-TIPACTID                                              
    E4-IDPLOCK      = E6T-IDPLOCK                                               
    E4-IDFAKT       = E6T-IDFAKT                                                
    E4-DASUPREF     = E6T-DASUPREF                                              
    E4-IDSHIPM      = E6T-IDSHIPM                                               
    E4-IDLBBET      = E6T-IDLBBET                                               
    E4-KDKOLLI      = E6T-KDKOLLI                                               
    E4-KDVIA        = E6T-KDVIA                                                 
    E4-TISUPTID     = E6T-TISUPTID                                              
    E4-TILASTN      = E6T-TILASTN                                               
    E4-TILASTID     = E6T-TILASTID                                              
    E4-TIFAKT       = E6T-TIFAKT                                                
    E4-TIFAKTID     = E6T-TIFAKTID                                              
    E4-TISKPTID     = E6T-TISKPTID / 100                                        
    E4-TISKEPPN     = E6T-TISKEPPN                                              
                                                                                
    PUT WXTRA0D7 FROM WXTRA0D1                                                  
                                                                                
  END-IF                                                                        
***                                                                             
SORT WXTRA0D7 TO WXTRA0D8 USING +                                               
                (T1-IDDC T1-IDUSER)                                             
***                                                                             
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT (WXTRA0D2 KEY (R1-IDDC R1-IDUSER) +                                   
           WXTRA0D8 KEY (S1-IDDC S1-IDUSER))                                    
                                                                                
  IF MATCHED                                                                    
                                                                                
                                                                                
    S1-IDSHIFT         = R1-IDSHIFT                                             
    PUT WXTRA0D9 FROM WXTRA0D8                                                  
                                                                                
  ELSE                                                                          
    IF WXTRA0D8                                                                 
                                                                                
      S1-IDSHIFT         = '0'                                                  
      PUT WXTRA0D9 FROM WXTRA0D8                                                
                                                                                
    END-IF                                                                      
  END-IF                                                                        
***                                                                             
SORT WXTRA0D9 TO WXTRA0DA USING           +                                     
                (T2-IDORDER  T2-IDDC      +                                     
                 T2-IDPRODNR T2-IDPLKLST)                                       
***                                                                             
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT (WXTRA0D4 KEY (Q3-ODEL-IDORDER  Q3-ODEL-IDDC      +                   
                         Q3-ODEL-IDPRODNR Q3-ODEL-IDPLKLST) +                   
           WXTRA0DA KEY (S2-IDORDER  S2-IDDC      +                             
                         S2-IDPRODNR S2-IDPLKLST))                              
                                                                                
  IF MATCHED                                                                    
                                                                                
    S2-IDPRC           = Q3-ODEL-IDPRC                                          
    S2-DATRPAVT        = Q3-ODEL-DATRPAVT                                       
    S2-IDLEVNR         = Q3-ODEL-IDLEVNR                                        
    S2-IDORDNR5        = Q3-ODEL-IDORDNR7                                       
    S2-IDTRP           = Q3-ODEL-IDTRP                                          
    S2-IDUSER-PACK     = Q3-ODEL-IDUSER                                         
    S2-DARFS           = Q3-ODEL-DARFS                                          
    S2-TIREGTID        = Q3-ODEL-TIREGTID                                       
    S2-TIUTSKR         = Q3-ODEL-DAUTSKR                                        
    S2-TIUTSTID        = Q3-ODEL-TIUTSTID / 100                                 
    PUT WXTRA0DB FROM WXTRA0DA                                                  
                                                                                
  ELSE                                                                          
    IF WXTRA0DA                                                                 
                                                                                
      PUT WXTRA0DB FROM WXTRA0DA                                                
                                                                                
    END-IF                                                                      
  END-IF                                                                        
***                                                                             
SORT WXTRA0DB TO WXTRA0DB USING           +                                     
                (T3-IDDC T3-IDPRC)                                              
*                                                                               
JOB INPUT (WXTRA0DG KEY (PRC-IDDC PRC-IDPRC) +                                  
           WXTRA0DB KEY (T3-IDDC  T3-IDPRC))                                    
                                                                                
  IF MATCHED                                                                    
     S3-W47923B        = T3-W47923B                                             
     S3-KDPRCGRP       = PRC-KDPRCGRP                                           
     PUT WXTRA0DC                                                               
  ELSE                                                                          
     IF WXTRA0DB                                                                
        S3-W47923B     = T3-W47923B                                             
        S3-KDPRCGRP    = '00000'                                                
        PUT WXTRA0DC                                                            
     END-IF                                                                     
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
***                                                                             
SORT WXTRA0DC TO WXTRA0DC USING +                                               
                (S3-IDARTNR  S3-IDDC)                                           
***                                                                             
JOB INPUT (WXTRA0D5 KEY (DLB-IDARTNR ) +                                        
           WXTRA0DC KEY (S3-IDARTNR ))                                          
                                                                                
  IF MATCHED                                                                    
                                                                                
    S3-KDPRODSL        = DLB-KDPRODSL                                           
    S3-PRARTSTD        = DLB-PRARTSTD                                           
    S3-ADLAGOMR-DLB    = DLB-ADLAGOMR                                           
    S3-ADGANG-DLB      = DLB-ADGANG                                             
    S3-ADPLATS-DLB     = DLB-ADPLATS                                            
    S3-IDFKNGRP        = DLB-IDFKNGRP                                           
    S3-KDARTURS        = DLB-KDARTURS                                           
    S3-KDFARLIG        = DLB-KDFARLIG                                           
    S3-KDSORT          = DLB-KDSORT                                             
    S3-KVQPACK-0       = DLB-KVQPACK-0                                          
    S3-KVQPACK-1       = DLB-KVQPACK-1                                          
    S3-KVQPACK-2       = DLB-KVQPACK-2                                          
    S3-KVQPACK-3       = DLB-KVQPACK-3                                          
    S3-KVQPACK-4       = DLB-KVQPACK-4                                          
                                                                                
    IF S3-IDPTYP  = 'P  ' +                                                     
    OR S3-IDPTYP  = 'PF '                                                       
       UT-IDDISTR       = S3-IDDISTR                                            
       UT-IDKUNDNR      = S3-IDKUNDNR                                           
       UT-IDPRODNR      = S3-IDPRODNR                                           
       UT-IDORDER       = S3-IDORDER                                            
       UT-IDDC          = S3-IDDC                                               
       UT-TIBEGPAC      = S3-TIBEGPAC                                           
       UT-TIORDREG      = S3-TIORDREG                                           
       UT-IDPLKLST      = S3-IDPLKLST                                           
       UT-IDARTNR       = S3-IDARTNR                                            
       UT-ADLAGOMR      = S3-ADLAGOMR-VERKLIG                                   
       UT-KDFRAKT       = S3-KDFRAKT                                            
       UT-KDORDKL       = S3-KDORDKL                                            
       UT-KVBEART       = S3-KVBEART                                            
       UT-KVLEVART      = S3-KVLEVART                                           
       UT-VKARTNTO      = S3-VKARTNTO                                           
       UT-VLARTNTO      = S3-VLARTNTO                                           
       UT-FLDIRLEV      = S3-FLDIRLEV                                           
       UT-IDKUNDRF-RO   = S3-IDKUNDRF-RO                                        
       UT-IDKOLLI       = S3-IDKOLLI                                            
       UT-IDUSER        = S3-IDUSER                                             
       UT-KVLEVART2     = S3-KVLEVART2                                          
       UT-IDPRC         = S3-IDPRC                                              
       UT-IDSKIFT       = S3-IDSHIFT                                            
       UT-KDPRODSL      = S3-KDPRODSL                                           
       UT-PRARTSTD      = S3-PRARTSTD                                           
       UT-TIPACKN       = S3-TIPACKN                                            
       UT-IDPLOCK       = S3-IDPLOCK                                            
       PUT WXTRA0D6                                                             
    END-IF                                                                      
                                                                                
    IF S3-IDPTYP  = 'F  ' +                                                     
    OR S3-IDPTYP  = 'PF '                                                       
       UT4-IDDISTR        = S3-IDDISTR                                          
       UT4-IDKUNDNR       = S3-IDKUNDNR                                         
       UT4-IDPRODNR       = S3-IDPRODNR                                         
       UT4-IDORDER        = S3-IDORDER                                          
       UT4-IDDC           = S3-IDDC                                             
       UT4-IDARTNR        = S3-IDARTNR                                          
       UT4-ADLAGOMR-DLB   = S3-ADLAGOMR-DLB                                     
       UT4-ADLAGOMR-VERKLIGT = S3-ADLAGOMR-VERKLIG                              
       UT4-DASUPREF       = S3-DASUPREF                                         
       UT4-DATRPAVD       = S3-DATRPAVD                                         
       UT4-TIHHMM         = S3-TIHHMM                                           
       UT4-FLDIRLEV       = S3-FLDIRLEV                                         
       UT4-FLLDCKND       = S3-FLLDCKND                                         
       UT4-IDFAKT         = S3-IDFAKT                                           
       UT4-IDFKNGRP       = S3-IDFKNGRP                                         
       UT4-IDKOLLI        = S3-IDKOLLI                                          
       UT4-IDLBBET        = S3-IDLBBET                                          
       UT4-IDLEVNR        = S3-IDLEVNR                                          
       UT4-IDORDNR5       = S3-IDORDNR5                                         
       UT4-IDPLKLST       = S3-IDPLKLST                                         
       UT4-IDPLOCK        = S3-IDPLOCK                                          
       UT4-IDPRC          = S3-IDPRC                                            
       UT4-IDPSN          = S3-IDPSN                                            
       UT4-IDPSN-DC       = S3-IDPSN-DC                                         
       UT4-IDRONR         = S3-IDKUNDRF-RO                                      
       UT4-IDSHIPM        = S3-IDSHIPM                                          
       UT4-IDSKIFT        = S3-IDSHIFT                                          
       UT4-IDSYSTEM       = S3-IDSYSTEM                                         
       UT4-IDTRP          = S3-IDTRP                                            
       UT4-IDUSER-OREG    = S3-IDUSER                                           
       UT4-IDUSER-PACK    = S3-IDUSER-PACK                                      
       UT4-KDARTURS       = S3-KDARTURS                                         
       UT4-KDFAKTYP       = S3-KDFAKTYP                                         
       UT4-KDFARLIG       = S3-KDFARLIG                                         
       UT4-KDFRAKT        = S3-KDFRAKT                                          
       UT4-KDORDKL        = S3-KDORDKL                                          
       UT4-KDPRODSL       = S3-KDPRODSL                                         
       UT4-KDKOLLI        = S3-KDKOLLI                                          
       UT4-KDPRCGRP       = S3-KDPRCGRP                                         
       UT4-KDSORT         = S3-KDSORT                                           
       UT4-KDVIA          = S3-KDVIA                                            
       UT4-KVBEART        = S3-KVBEART                                          
       UT4-KVLEVART       = S3-KVLEVART                                         
       UT4-KVLEVART2      = S3-KVLEVART2                                        
       UT4-KVQPACK-0      = S3-KVQPACK-0                                        
       UT4-KVQPACK-1      = S3-KVQPACK-1                                        
       UT4-KVQPACK-2      = S3-KVQPACK-2                                        
       UT4-KVQPACK-3      = S3-KVQPACK-3                                        
       UT4-KVQPACK-4      = S3-KVQPACK-4                                        
       UT4-KVULOAD        = S3-KVULOAD                                          
       UT4-PRARTNTO       = S3-PRARTNTO                                         
       UT4-PRARTNTO-LOC   = S3-PRARTNTO-LOC                                     
       UT4-PRARTSTD       = S3-PRARTSTD                                         
       IF S3-FLDIRLEV = 'J'                                                     
***      *DDGS ORDERS HAS CORRECT S3-TIBEGPAC                                   
         UT4-TIBEGPAC     = S3-TIBEGPAC                                         
         UT4-TIBEGTID     = 0                                                   
       ELSE                                                                     
         W-DARFS-3-12      = S3-DARFS                                           
         W-DARFS-3-8       = W-DARFS-3-12 / 10000                               
         W-DARFS-9-12      = W-DARFS-3-12                                       
         UT4-TIBEGPAC      = W-DARFS-3-8                                        
         UT4-TIBEGTID      = W-DARFS-9-12                                       
       END-IF                                                                   
       UT4-TIFAKT         = S3-TIFAKT                                           
       UT4-TIFAKTID       = S3-TIFAKTID / 100                                   
       UT4-TILASTID       = S3-TILASTID / 100                                   
       UT4-TILASTN        = S3-TILASTN                                          
       UT4-TIORDREG       = S3-TIORDREG                                         
       UT4-TIPACKN        = S3-TIPACKN                                          
       UT4-TIPACTID       = S3-TIPACTID / 100                                   
       UT4-TIREGTID       = S3-TIREGTID / 100                                   
       UT4-TIREPDAT       = S3-TIREPDAT                                         
       UT4-TISKEPPN       = S3-TISKEPPN                                         
       UT4-TISKPTID       = S3-TISKPTID                                         
       UT4-TISUPTID       = S3-TISUPTID                                         
       UT4-TIUTSKR        = S3-TIUTSKR                                          
       UT4-TIUTSTID       = S3-TIUTSTID                                         
       UT4-VKARTNTO       = S3-VKARTNTO                                         
       UT4-VLARTNTO       = S3-VLARTNTO                                         
       UT4-IDSTATNR-3     = 0                                                   
       UT4-IDVIN          = S3-IDVIN                                            
       PUT WXTRA0DE                                                             
    END-IF                                                                      
                                                                                
    IF S3-IDPTYP  = 'P  ' +                                                     
    OR S3-IDPTYP  = 'PF '                                                       
       UT7-IDDISTR      = S3-IDDISTR                                            
       UT7-IDKUNDNR     = S3-IDKUNDNR                                           
       UT7-IDPRODNR     = S3-IDPRODNR                                           
       UT7-IDORDER      = S3-IDORDER                                            
       UT7-IDDC         = S3-IDDC                                               
       IF S3-FLDIRLEV = 'J'                                                     
***     *DDGS ORDERS HAS CORRECT S3-TIBEGPAC                                    
          UT7-TIBEGPAC = S3-TIBEGPAC                                            
       ELSE                                                                     
          W-DARFS-3-12  = S3-DARFS                                              
          W-DARFS-3-8   = W-DARFS-3-12 / 10000                                  
          W-DARFS-9-12  = W-DARFS-3-12                                          
          UT7-TIBEGPAC  = W-DARFS-3-8                                           
          UT7-TIBEGTID  = W-DARFS-9-12                                          
       END-IF                                                                   
       UT7-TIORDREG     = S3-TIORDREG                                           
       UT7-IDPLKLST     = S3-IDPLKLST                                           
       UT7-IDARTNR      = S3-IDARTNR                                            
       UT7-ADLAGOMR-VERKLIG = S3-ADLAGOMR-VERKLIG                               
       UT7-ADLAGOMR-DLB = S3-ADLAGOMR-DLB                                       
       UT7-ADGANG-DLB   = S3-ADGANG-DLB                                         
       UT7-ADPLATS-DLB  = S3-ADPLATS-DLB                                        
       UT7-KDFRAKT      = S3-KDFRAKT                                            
       UT7-KDORDKL      = S3-KDORDKL                                            
       UT7-KVBEART      = S3-KVBEART                                            
       UT7-KVLEVART     = S3-KVLEVART                                           
       UT7-VKARTNTO     = S3-VKARTNTO                                           
       UT7-VLARTNTO     = S3-VLARTNTO                                           
       UT7-FLDIRLEV     = S3-FLDIRLEV                                           
       UT7-IDKUNDRF-RO  = S3-IDKUNDRF-RO                                        
       UT7-IDKOLLI      = S3-IDKOLLI                                            
       UT7-IDUSER       = S3-IDUSER                                             
       UT7-KVLEVART2    = S3-KVLEVART2                                          
       UT7-IDPRC        = S3-IDPRC                                              
       UT7-IDSKIFT      = S3-IDSHIFT                                            
       UT7-KDPRODSL     = S3-KDPRODSL                                           
       UT7-PRARTSTD     = S3-PRARTSTD                                           
       UT7-TIPACKN      = S3-TIPACKN                                            
       UT7-IDPLOCK      = S3-IDPLOCK                                            
       UT7-TIREGTID     = S3-TIREGTID / 100                                     
       UT7-TIUTSKR      = S3-TIUTSKR                                            
       UT7-TIUTSTID     = S3-TIUTSTID                                           
       UT7-TIPACTID     = S3-TIPACTID / 100                                     
       UT7-KDPRCGRP     = S3-KDPRCGRP                                           
       PUT WXTRA0DF                                                             
    END-IF                                                                      
                                                                                
  ELSE                                                                          
    IF WXTRA0DC                                                                 
                                                                                
      IF S3-IDPTYP  = 'P  ' +                                                   
      OR S3-IDPTYP  = 'PF '                                                     
         UT-IDDISTR     = S3-IDDISTR                                            
         UT-IDKUNDNR    = S3-IDKUNDNR                                           
         UT-IDPRODNR    = S3-IDPRODNR                                           
         UT-IDORDER     = S3-IDORDER                                            
         UT-IDDC        = S3-IDDC                                               
         UT-TIBEGPAC    = S3-TIBEGPAC                                           
         UT-IDPLKLST    = S3-IDPLKLST                                           
         UT-IDARTNR     = S3-IDARTNR                                            
         UT-ADLAGOMR    = S3-ADLAGOMR-VERKLIG                                   
         UT-KDFRAKT     = S3-KDFRAKT                                            
         UT-KDORDKL     = S3-KDORDKL                                            
         UT-KVBEART     = S3-KVBEART                                            
         UT-KVLEVART    = S3-KVLEVART                                           
         UT-VKARTNTO    = S3-VKARTNTO                                           
         UT-VLARTNTO    = S3-VLARTNTO                                           
         UT-FLDIRLEV    = S3-FLDIRLEV                                           
         UT-IDKUNDRF-RO = S3-IDKUNDRF-RO                                        
         UT-IDKOLLI     = S3-IDKOLLI                                            
         UT-IDUSER      = S3-IDUSER                                             
         UT-KVLEVART2   = S3-KVLEVART2                                          
         UT-IDPRC       = S3-IDPRC                                              
         UT-IDSKIFT     = S3-IDSHIFT                                            
         UT-KDPRODSL    = S3-KDPRODSL                                           
         UT-PRARTSTD    = S3-PRARTSTD                                           
         UT-TIPACKN     = S3-TIPACKN                                            
         UT-IDPLOCK     = S3-IDPLOCK                                            
                                                                                
         PUT WXTRA0D6                                                           
      END-IF                                                                    
                                                                                
      IF S3-IDPTYP  = 'F  ' +                                                   
      OR S3-IDPTYP  = 'PF '                                                     
        UT4-IDDISTR         = S3-IDDISTR                                        
        UT4-IDKUNDNR        = S3-IDKUNDNR                                       
        UT4-IDPRODNR        = S3-IDPRODNR                                       
        UT4-IDORDER         = S3-IDORDER                                        
        UT4-IDDC            = S3-IDDC                                           
        UT4-IDARTNR         = S3-IDARTNR                                        
        UT4-ADLAGOMR-DLB    = S3-ADLAGOMR-DLB                                   
        UT4-ADLAGOMR-VERKLIGT = S3-ADLAGOMR-VERKLIG                             
        UT4-DASUPREF        = S3-DASUPREF                                       
        UT4-DATRPAVD        = S3-DATRPAVD                                       
        UT4-TIHHMM          = S3-TIHHMM                                         
        UT4-FLDIRLEV        = S3-FLDIRLEV                                       
        UT4-FLLDCKND        = S3-FLLDCKND                                       
        UT4-IDFAKT          = S3-IDFAKT                                         
        UT4-IDFKNGRP        = S3-IDFKNGRP                                       
        UT4-IDKOLLI         = S3-IDKOLLI                                        
        UT4-IDLBBET         = S3-IDLBBET                                        
        UT4-IDLEVNR         = S3-IDLEVNR                                        
        UT4-IDORDNR5        = S3-IDORDNR5                                       
        UT4-IDPLKLST        = S3-IDPLKLST                                       
        UT4-IDPLOCK         = S3-IDPLOCK                                        
        UT4-IDPRC           = S3-IDPRC                                          
        UT4-IDPSN           = S3-IDPSN                                          
        UT4-IDPSN-DC        = S3-IDPSN-DC                                       
        UT4-IDRONR          = S3-IDKUNDRF-RO                                    
        UT4-IDSHIPM         = S3-IDSHIPM                                        
        UT4-IDSKIFT         = S3-IDSHIFT                                        
        UT4-IDSYSTEM        = S3-IDSYSTEM                                       
        UT4-IDTRP           = S3-IDTRP                                          
        UT4-IDUSER-OREG     = S3-IDUSER                                         
        UT4-IDUSER-PACK     = S3-IDUSER-PACK                                    
        UT4-KDARTURS        = S3-KDARTURS                                       
        UT4-KDFAKTYP        = S3-KDFAKTYP                                       
        UT4-KDFARLIG        = S3-KDFARLIG                                       
        UT4-KDFRAKT         = S3-KDFRAKT                                        
        UT4-KDORDKL         = S3-KDORDKL                                        
        UT4-KDPRODSL        = S3-KDPRODSL                                       
        UT4-KDKOLLI         = S3-KDKOLLI                                        
        UT4-KDPRCGRP        = S3-KDPRCGRP                                       
        UT4-KDSORT          = S3-KDSORT                                         
        UT4-KDVIA           = S3-KDVIA                                          
        UT4-KVBEART         = S3-KVBEART                                        
        UT4-KVLEVART        = S3-KVLEVART                                       
        UT4-KVLEVART2       = S3-KVLEVART2                                      
        UT4-KVQPACK-0       = S3-KVQPACK-0                                      
        UT4-KVQPACK-1       = S3-KVQPACK-1                                      
        UT4-KVQPACK-2       = S3-KVQPACK-2                                      
        UT4-KVQPACK-3       = S3-KVQPACK-3                                      
        UT4-KVQPACK-4       = S3-KVQPACK-4                                      
        UT4-KVULOAD         = S3-KVULOAD                                        
        UT4-PRARTNTO        = S3-PRARTNTO                                       
        UT4-PRARTNTO-LOC    = S3-PRARTNTO-LOC                                   
        UT4-PRARTSTD        = S3-PRARTSTD                                       
        IF S3-FLDIRLEV = 'J'                                                    
***       *DDGS ORDERS HAS CORRECT S3-TIBEGPAC                                  
          UT4-TIBEGPAC      = S3-TIBEGPAC                                       
          UT4-TIBEGTID      = 0                                                 
        ELSE                                                                    
          W-DARFS-3-12      = S3-DARFS                                          
          W-DARFS-3-8       = W-DARFS-3-12 / 10000                              
          W-DARFS-9-12      = W-DARFS-3-12                                      
          UT4-TIBEGPAC      = W-DARFS-9-12                                      
          UT4-TIBEGTID      = S3-DARFS                                          
        END-IF                                                                  
        UT4-TIFAKT          = S3-TIFAKT                                         
        UT4-TIFAKTID        = S3-TIFAKTID / 100                                 
        UT4-TILASTID        = S3-TILASTID / 100                                 
        UT4-TILASTN         = S3-TILASTN                                        
        UT4-TIORDREG        = S3-TIORDREG                                       
        UT4-TIPACKN         = S3-TIPACKN                                        
        UT4-TIPACTID        = S3-TIPACTID / 100                                 
        UT4-TIREGTID        = S3-TIREGTID / 100                                 
        UT4-TIREPDAT        = S3-TIREPDAT                                       
        UT4-TISKEPPN        = S3-TISKEPPN                                       
        UT4-TISKPTID        = S3-TISKPTID                                       
        UT4-TISUPTID        = S3-TISUPTID                                       
        UT4-TIUTSKR         = S3-TIUTSKR                                        
        UT4-TIUTSTID        = S3-TIUTSTID                                       
        UT4-VKARTNTO        = S3-VKARTNTO                                       
        UT4-VLARTNTO        = S3-VLARTNTO                                       
        UT4-IDSTATNR-3      = 0                                                 
        UT4-IDVIN           = S3-IDVIN                                          
        PUT WXTRA0DE                                                            
      END-IF                                                                    
                                                                                
      IF S3-IDPTYP  = 'P  ' +                                                   
      OR S3-IDPTYP  = 'PF '                                                     
         UT7-IDDISTR        = S3-IDDISTR                                        
         UT7-IDKUNDNR       = S3-IDKUNDNR                                       
         UT7-IDPRODNR       = S3-IDPRODNR                                       
         UT7-IDORDER        = S3-IDORDER                                        
         UT7-IDDC           = S3-IDDC                                           
         IF S3-FLDIRLEV = 'J'                                                   
***       *DDGS ORDERS HAS CORRECT S3-TIBEGPAC                                  
            UT7-TIBEGPAC    = S3-TIBEGPAC                                       
         ELSE                                                                   
            W-DARFS-3-12    = S3-DARFS                                          
            W-DARFS-3-8     = W-DARFS-3-12 / 10000                              
            W-DARFS-9-12    = W-DARFS-3-12                                      
            UT7-TIBEGPAC    = W-DARFS-3-8                                       
            UT7-TIBEGTID    = W-DARFS-9-12                                      
         END-IF                                                                 
         UT7-IDPLKLST       = S3-IDPLKLST                                       
         UT7-IDARTNR        = S3-IDARTNR                                        
         UT7-ADLAGOMR-VERKLIG = S3-ADLAGOMR-VERKLIG                             
         UT7-ADLAGOMR-DLB   = S3-ADLAGOMR-DLB                                   
         UT7-ADGANG-DLB     = S3-ADGANG-DLB                                     
         UT7-ADPLATS-DLB    = S3-ADPLATS-DLB                                    
         UT7-KDORDKL        = S3-KDORDKL                                        
         UT7-KVBEART        = S3-KVBEART                                        
         UT7-KVLEVART       = S3-KVLEVART                                       
         UT7-VKARTNTO       = S3-VKARTNTO                                       
         UT7-VLARTNTO       = S3-VLARTNTO                                       
         UT7-FLDIRLEV       = S3-FLDIRLEV                                       
         UT7-IDKUNDRF-RO    = S3-IDKUNDRF-RO                                    
         UT7-IDKOLLI        = S3-IDKOLLI                                        
         UT7-IDUSER         = S3-IDUSER                                         
         UT7-KVLEVART2      = S3-KVLEVART2                                      
         UT7-IDPRC          = S3-IDPRC                                          
         UT7-IDSKIFT        = S3-IDSHIFT                                        
         UT7-KDPRODSL       = S3-KDPRODSL                                       
         UT7-PRARTSTD       = S3-PRARTSTD                                       
         UT7-TIPACKN        = S3-TIPACKN                                        
         UT7-IDPLOCK        = S3-IDPLOCK                                        
         UT7-TIREGTID       = S3-TIREGTID / 100                                 
         UT7-TIUTSKR        = S3-TIUTSKR                                        
         UT7-TIUTSTID       = S3-TIUTSTID                                       
         UT7-TIPACTID       = S3-TIPACTID / 100                                 
         UT7-KDPRCGRP       = S3-KDPRCGRP                                       
                                                                                
         PUT WXTRA0DF                                                           
      END-IF                                                                    
    END-IF                                                                      
                                                                                
  END-IF                                                                        
