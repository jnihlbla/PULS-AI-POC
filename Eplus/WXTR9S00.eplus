************************************************************************        
*                                                                      *        
* PARAMETRAR TILL WDATKONV                                             *        
*                                                                      *        
************************************************************************        
*                                                                               
%WDATAREA                                                                       
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
************************************************************************        
*                                                                      *        
* JOBSTEG 1  MATCHAR SDC-FILER OCH SKRIVER WXTR9SD5 (TEMP1)            *        
*                                                                      *        
************************************************************************        
JOB INPUT (WXTR9SD2  KEY (W01184-SLAG-IDARTNR,             +                    
                          W01184-SLAG-IDDC)                +                    
           WXTR9SD3  KEY (W01186-DC-IDARTNR,               +                    
                          W01186-DC-IDDC)                  +                    
           WXTR9SD4  KEY (W27120-IDARTNR,                  +                    
                          W27120-IDDC))                    +                    
START A-INIT                                               +                    
NAME STEG1-MATCHAR-O-SKRIVER                                                    
                                                                                
  IF MATCHED WXTR9SD2 WXTR9SD3 WXTR9SD4                                         
    T1-IDARTNR EQ W01184-SLAG-IDARTNR                                           
    T1-IDDC    EQ W01184-SLAG-IDDC                                              
    PERFORM B-SKRIV-W01184-UPPG                                                 
    PERFORM C-SKRIV-W01186-UPPG                                                 
    PERFORM D-SKRIV-W27120-UPPG                                                 
    PUT WXTR9SD5                                                                
  ELSE                                                                          
    IF MATCHED WXTR9SD2 WXTR9SD3                                                
      T1-IDARTNR EQ W01184-SLAG-IDARTNR                                         
      T1-IDDC    EQ W01184-SLAG-IDDC                                            
      PERFORM B-SKRIV-W01184-UPPG                                               
      PERFORM C-SKRIV-W01186-UPPG                                               
      PERFORM F-NOLLA-W27120-UPPG                                               
      PUT WXTR9SD5                                                              
    ELSE                                                                        
      IF MATCHED WXTR9SD2 WXTR9SD4                                              
        T1-IDARTNR EQ W01184-SLAG-IDARTNR                                       
        T1-IDDC    EQ W01184-SLAG-IDDC                                          
        PERFORM B-SKRIV-W01184-UPPG                                             
        PERFORM E-NOLLA-W01186-UPPG                                             
        PERFORM D-SKRIV-W27120-UPPG                                             
        PUT WXTR9SD5                                                            
      ELSE                                                                      
        IF WXTR9SD2                                                             
          T1-IDARTNR EQ W01184-SLAG-IDARTNR                                     
          T1-IDDC    EQ W01184-SLAG-IDDC                                        
          PERFORM B-SKRIV-W01184-UPPG                                           
          PERFORM E-NOLLA-W01186-UPPG                                           
          PERFORM F-NOLLA-W27120-UPPG                                           
          PUT WXTR9SD5                                                          
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
A-INIT. PROC                                                                    
  T1-REKSIFFR       = +0                                                        
  T1-BEART-SVE      = ' '                                                       
  T1-BEART-ENG      = ' '                                                       
  T1-BEFT           = +0                                                        
  T1-FLBUYUPD       = ' '                                                       
  T1-FLAVRART       = ' '                                                       
  T1-FLERS          = ' '                                                       
  T1-FLGEMART       = ' '                                                       
  T1-FLIART         = ' '                                                       
  T1-FLJIT          = ' '                                                       
  T1-FLLSRDEL       = ' '                                                       
  T1-FLTABUPD       = ' '                                                       
  T1-FLTPO1         = ' '                                                       
  T1-IDANSK         = +0                                                        
  T1-IDARTNR-EMBQ0  = +0                                                        
  T1-IDARTNR-EMBQ1  = +0                                                        
  T1-IDARTNR-EMBQ2  = +0                                                        
  T1-IDARTNR-EMBQ3  = +0                                                        
  T1-IDARTNR-EMBQ4  = +0                                                        
  T1-IDBERED        = +0                                                        
  T1-IDFKNGRP       = +0                                                        
  T1-IDINK          = ' '                                                       
  T1-IDLEVNR        = ' '                                                       
  T1-IDLKTO         = +0                                                        
  T1-IDPROJ         = ' '                                                       
  T1-IDPSN          = +0                                                        
  T1-IDPSN-DC       = +0                                                        
  T1-IDSTATNR-1     = +0                                                        
  T1-IDSTATNR-2     = +0                                                        
  T1-IDSTATNR-3     = +0                                                        
  T1-IDSTATNR-4     = +0                                                        
  T1-IDSTATNR-5     = +0                                                        
  T1-IDSTATNR-6     = +0                                                        
  T1-KDAGE          = ' '                                                       
  T1-KDARTHNT       = +0                                                        
  T1-KDARTURS       = ' '                                                       
  T1-KDBPSR         = +0                                                        
  T1-KDEMBKOD-0     = +0                                                        
  T1-KDEMBKOD-1     = +0                                                        
  T1-KDEMBKOD-2     = +0                                                        
  T1-KDERS          = +0                                                        
  T1-KDERS-UTG      = +0                                                        
  T1-KDFARLIG       = +0                                                        
  T1-KDGK           = +0                                                        
  T1-KDPRODSL       = +0                                                        
  T1-KDSORT         = ' '                                                       
  T1-KDSPEEMB       = +0                                                        
  T1-KDSRA          = +0                                                        
  T1-KDUART         = ' '                                                       
  T1-KDVVKL         = +0                                                        
  T1-KDYTBEH        = +0                                                        
  T1-KVOKS-DAG      = +0                                                        
  T1-KVOKS-BULK     = +0                                                        
  T1-KVPALL         = +0                                                        
  T1-KVQPACK-0      = +0                                                        
  T1-KVQPACK-1      = +0                                                        
  T1-KVQPACK-2      = +0                                                        
  T1-KVQPACK-3      = +0                                                        
  T1-KVQPACK-4      = +0                                                        
  T1-PRARTBES       = +0                                                        
  T1-PRARTBTO-EXP   = +0                                                        
  T1-PRARTSJK       = +0                                                        
  T1-PRARTSTD       = +0                                                        
  T1-PRINK          = +0                                                        
  T1-TIERSDAT       = +0                                                        
  T1-TIFINLV        = +0                                                        
  T1-VKART          = +0                                                        
  T1-VLARTNTO       = +0                                                        
*                                                                               
  T1-REOSAEK        = +0                                                        
*                                                                               
  PERFORM E-NOLLA-W01186-UPPG                                                   
  PERFORM F-NOLLA-W27120-UPPG                                                   
  PERFORM S-BERAKNA-ANTAL-VECKOR                                                
  PERFORM S1-GET-WEEKS-IN-PERIOD                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
B-SKRIV-W01184-UPPG. PROC                                                       
  T1-ADLAGOMR            = W01184-SLAG-ADLAGOMR                                 
  T1-ADGANG              = W01184-SLAG-ADGANG                                   
  T1-ADPLATS             = W01184-SLAG-ADPLATS                                  
  T1-IDREFTAB            = W01184-SLAG-IDREFTAB                                 
  T1-FLBUYUPD            = W01184-SLAG-FLBUYUPD                                 
  T1-FLREFBEO            = W01184-SLAG-FLREFBEO                                 
  T1-FLSKROT-BEORD       = W01184-SLAG-FLSKROT-BEORD                            
  T1-FLTABUPD            = W01184-SLAG-FLTABUPD                                 
  T1-TISPARR-KVAL        = W01184-SLAG-TISPARR-KVAL                             
  T1-ADLAGOMR-CD         = W01184-SLAG-ADLAGOMR-CD                              
  T1-FLCDREL             = W01184-SLAG-FLCDREL                                  
  T1-KVDAGAR-CDBEH       = W01184-SLAG-KVDAGAR-CDBEH                            
  T1-FLWILSON            = W01184-SLAG-FLWILSON                                 
  T1-IDPERSON-BUY        = W01184-SLAG-IDPERSON-BUY                             
  T1-KDLEVSP             = W01184-SLAG-KDLEVSP                                  
  T1-KDREFSTA            = W01184-SLAG-KDREFSTA                                 
  T1-KVAKS-PAV           = W01184-SLAG-KVAKS-PAV                                
  T1-KVAKS-SDC           = W01184-SLAG-KVAKS-SDC                                
  T1-KVBEART             = W01184-SLAG-KVBEART                                  
  T1-KVEFRS              = W01184-SLAG-KVEFRS                                   
  T1-KVINVS              = W01184-SLAG-KVINVS                                   
  T1-KVLS                = W01184-SLAG-KVLS                                     
  T1-KVOKS-DAG           = W01184-SLAG-KVOKS-DAG                                
  T1-KVOKS-BULK          = W01184-SLAG-KVOKS-BULK                               
  T1-KVPB-REF            = W01184-SLAG-KVPB-REF                                 
  T1-KVREFBER            = W01184-SLAG-KVREFBER                                 
  T1-KVREFOVL            = W01184-SLAG-KVREFOVL                                 
  T1-KVREFPKT            = W01184-SLAG-KVREFPKT                                 
  T1-KVRETUR-BEORD       = W01184-SLAG-KVRETUR-BEORD                            
  T1-KVSKROT             = W01184-SLAG-KVSKROT                                  
  T1-KVUTRS              = W01184-SLAG-KVUTRS                                   
  T1-TIINVDAT            = W01184-SLAG-TIINVDAT                                 
  T1-TIORDREG            = W01184-SLAG-TIORDREG                                 
  T1-TIREFMPB            = W01184-SLAG-TIREFMPB                                 
  T1-TIREFPAF            = W01184-SLAG-TIREFPAF                                 
  T1-TIREFPKT            = W01184-SLAG-TIREFPKT                                 
  T1-TIREFSTA            = W01184-SLAG-TIREFSTA                                 
  T1-TIREFSTO            = W01184-SLAG-TIREFSTO                                 
  T1-TIRETUR-BEORD       = W01184-SLAG-TIRETUR-BEORD                            
  T1-TISKROT             = W01184-SLAG-TISKROT                                  
  T1-TISKROT-BEORD       = W01184-SLAG-TISKROT-BEORD                            
  T1-TISPARR-KVAL        = W01184-SLAG-TISPARR-KVAL                             
  T1-ADLAGOMR-CD         = W01184-SLAG-ADLAGOMR-CD                              
  T1-FLCDREL             = W01184-SLAG-FLCDREL                                  
  T1-KVDAGAR-CDBEH       = W01184-SLAG-KVDAGAR-CDBEH                            
  T1-FLREFILL            = W01184-SLAG-FLREFILL                                 
  T1-FLREFNYO            = W01184-SLAG-FLREFNYO                                 
  T1-IDPSN-DC            = W01184-SLAG-IDPSN-DC                                 
                                                                                
  WS-FLSEASON = 'N'                                                             
  INDX = 1                                                                      
  DO WHILE INDX LE INDX-MAX                                                     
    T1-RESEASON(INDX)     = W01184-SLAG-RESEASON(INDX)                          
    IF W01184-SLAG-RESEASON(INDX) = 1.00                                        
       CONTINUE                                                                 
    ELSE                                                                        
       WS-FLSEASON = 'J'                                                        
    END-IF                                                                      
    INDX = INDX + 1                                                             
  END-DO                                                                        
  T1-FLSEASON            = WS-FLSEASON                                          
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
C-SKRIV-W01186-UPPG. PROC                                                       
                                                                                
  T1-TIREFEFT            = W01186-DC-TIREFEFT                                   
                                                                                
  INDX = 1                                                                      
  T1-KVOI-CDC-RULL       = +0                                                   
  T1-KVOI-RULL           = +0                                                   
  T1-KVOT-CDC-RULL       = +0                                                   
  T1-KVOT-RULL           = +0                                                   
                                                                                
  DO WHILE INDX LE W-ANTAL-VECKOR                                               
   T1-KVOI-CDC-RULL = T1-KVOI-CDC-RULL + W01186-DC-KVOI-CDC-RULL(INDX)          
   T1-KVOI-RULL     = T1-KVOI-RULL     + W01186-DC-KVOI-RULL(INDX)              
   T1-KVOT-CDC-RULL = T1-KVOT-CDC-RULL + W01186-DC-KVOT-CDC-RULL(INDX)          
   T1-KVOT-RULL     = T1-KVOT-RULL     + W01186-DC-KVOT-RULL(INDX)              
   INDX = INDX + 1                                                              
  END-DO                                                                        
                                                                                
  PERFORM CA-SKRIV-NYA-W01186-UPPG                                              
                                                                                
  PERFORM CB-GET-ORDER-HIT-PREV                                                 
                                                                                
  END-PROC                                                                      
*                                                                               
NEWPAGE                                                                         
*                                                                               
CA-SKRIV-NYA-W01186-UPPG. PROC                                                  
                                                                                
  INDX = 1                                                                      
  DO WHILE INDX LE INDX-MAX                                                     
     W-KVOI-TOT-NUV(INDX) = 0                                                   
     W-KVVIPER-NUV (INDX) = 0                                                   
     W-KVOI-TOT-FORRA(INDX) = 0                                                 
     W-KVVIPER-FORRA(INDX) = 0                                                  
     INDX = INDX + 1                                                            
  END-DO                                                                        
  W-PER-FORRA = 0                                                               
  W-PER-NUV   = 0                                                               
                                     ***** FÖREG TVÅ ÅR                         
  INDX  = 1                                                                     
  INDX2 = 1                                                                     
  WS-KVOI-TOT-1          = +0                                                   
  WS-KVOI-TOT-2          = +0                                                   
  T1-KVOI-FOREG(1)       = +0                                                   
  T1-KVOI-FOREG(2)       = +0                                                   
  DO WHILE INDX LE 2                                                            
     DO WHILE INDX2 LE INDX-MAX                                                 
        IF INDX = 1                                                             
           WS-KVOI-TOT-1 = WS-KVOI-TOT-1 +                                      
                         + W01186-DC-KVOI ((INDX)(INDX2))                       
        ELSE                                                                    
           WS-KVOI-TOT-2 = WS-KVOI-TOT-2 +                                      
                         + W01186-DC-KVOI ((INDX)(INDX2))                       
        END-IF                                                                  
        INDX2 = INDX2 + 1                                                       
     END-DO                                                                     
     INDX = INDX + 1                                                            
     INDX2 = 1                                                                  
  END-DO                                                                        
  T1-KVOI-FOREG(1) = WS-KVOI-TOT-1                                              
  T1-KVOI-FOREG(2) = WS-KVOI-TOT-2                                              
                                     ***** DAGENS-DATUM                         
  DAT-I-TIDATUM = 0                                                             
  DAT-KDDATFORM = 'IDAG'                                                        
  CALL WDATKONV USING (DAT-KDDATFORM,  +                                        
                       DAT-I-TIDATUM,  +                                        
                       DAT-O-TIDATUM,  +                                        
                       DAT-KDSVAR)                                              
                                                                                
  W-AAR            =  DAT-TIAA                                                  
  W-VV             =  DAT-TIVV                                                  
  W-DAGENS-AA      =  DAT-TIAA                                                  
  W-DAGENS-AAR     =  DAT-TIAA                                                  
  W-DAGENS-VV      =  DAT-TIVV                                                  
  W-DAGENS-RP      =  DAT-TIRP                                                  
                                     ***** FÖRSTA VECKAN NUV PERIOD             
  DAT-I-TIDATUM = W-DAGENS-AARP                                                 
  DAT-KDDATFORM = 'AARP  '                                                      
  CALL WDATKONV USING (DAT-KDDATFORM,  +                                        
                       DAT-I-TIDATUM,  +                                        
                       DAT-O-TIDATUM,  +                                        
                       DAT-KDSVAR)                                              
  WS-TIAA          =  DAT-TIAA                                                  
  WS-TIVV          =  DAT-TIVV                                                  
                                     ***** KONTROLL OM NY PERIOD                
  IF W01186-DC-TIVV(1) = WS-TIVV                                                
     SW-NY-PERIOD = NEJ                                                         
     INDX2-MAX = WS-TIVV - 1                                                    
  ELSE                                                                          
     SW-NY-PERIOD = JA                                                          
     INDX2-MAX = W-DAGENS-VV                                                    
  END-IF                                                                        
  IF W01186-DC-TIVV(1) < WS-TIVV                                                
     SW-NYTT-AR = JA                                                            
  ELSE                                                                          
     SW-NYTT-AR = NEJ                                                           
  END-IF                                                                        
                                                                                
  INDX   = 1                                                                    
  W-VV   = 1                                                                    
  DO WHILE INDX LE INDX2-MAX                                                    
     DAT-I-TIDATUM = W-AAVV                                                     
     DAT-KDDATFORM = 'AAVV  '                                                   
     CALL WDATKONV USING (DAT-KDDATFORM,  +                                     
                          DAT-I-TIDATUM,  +                                     
                          DAT-O-TIDATUM,  +                                     
                          DAT-KDSVAR)                                           
     INDX-PER = DAT-TIRP                                                        
     W-KVOI-TOT-NUV(INDX-PER) = W-KVOI-TOT-NUV(INDX-PER)          +             
                         + W01186-DC-KVOI-RULL(INDX)                            
     W-KVVIPER-NUV(INDX-PER) = DAT-KVVIPER                                      
     INDX = INDX + 1                                                            
     W-VV = W-VV + 1                                                            
  END-DO                                                                        
                                                                                
  W-PER-NUV = INDX-PER                                                          
  INDX  = 1                                                                     
  INDX2 = INDX-PER + 1                                                          
  INDX2-MAX = 5                                                                 
  W-PER-FORRA = INDX-PER + 1                                                    
                                                                                
  DO WHILE INDX2 LE INDX-MAX                                                    
     W-KVOI-TOT-FORRA (INDX2) =                               +                 
          + W01186-DC-KVOI ((INDX)(INDX2))                                      
     W-KVVIPER-FORRA(INDX2) = W01186-DC-KVVIPER((INDX)(INDX2))                  
     INDX2 = INDX2 + 1                                                          
  END-DO                                                                        
                                                                                
********  TX TILLAGT                                                            
  INDX-T1 = 1                                                                   
  INDX = W-PER-FORRA                                                            
  DO WHILE INDX LE INDX-MAX                                                     
    IF W-KVOI-TOT-FORRA(INDX) = 0                                               
***    T1-KVOI-RP(INDX-T1) = 0                                                  
       TX-KVOI-RP(INDX-T1) = 0                                                  
    ELSE                                                                        
***    T1-KVOI-RP(INDX-T1) = (W-KVOI-TOT-FORRA(INDX)           +                
***                   / W-KVVIPER-FORRA(INDX) * 4.33) + 0.5                     
       TX-KVOI-RP(INDX-T1) = (W-KVOI-TOT-FORRA(INDX)           +                
                      / W-KVVIPER-FORRA(INDX) * 4.33) + 0.5                     
    END-IF                                                                      
    INDX    = INDX + 1                                                          
    INDX-T1 = INDX-T1 + 1                                                       
  END-DO                                                                        
                                                                                
  IF W-PER-NUV = 0                                                              
  ELSE                                                                          
     INDX = 1                                                                   
     DO WHILE INDX LE W-PER-NUV                                                 
       IF W-KVOI-TOT-NUV(INDX) = 0                                              
***       T1-KVOI-RP(INDX-T1) = 0                                               
          TX-KVOI-RP(INDX-T1) = 0                                               
       ELSE                                                                     
***       T1-KVOI-RP(INDX-T1) = (W-KVOI-TOT-NUV(INDX)          +                
***                   / W-KVVIPER-NUV(INDX) * 4.33) + 0.5                       
          TX-KVOI-RP(INDX-T1) = (W-KVOI-TOT-NUV(INDX)          +                
                      / W-KVVIPER-NUV(INDX) * 4.33) + 0.5                       
       END-IF                                                                   
       INDX    = INDX + 1                                                       
       INDX-T1 = INDX-T1 + 1                                                    
     END-DO                                                                     
  END-IF                                                                        
                                                                                
************                                                                    
  T1-KVOI-RP(12) = TX-KVOI-RP(1)                                                
  T1-KVOI-RP(11) = TX-KVOI-RP(2)                                                
  T1-KVOI-RP(10) = TX-KVOI-RP(3)                                                
  T1-KVOI-RP(9)  = TX-KVOI-RP(4)                                                
  T1-KVOI-RP(8)  = TX-KVOI-RP(5)                                                
  T1-KVOI-RP(7)  = TX-KVOI-RP(6)                                                
  T1-KVOI-RP(6)  = TX-KVOI-RP(7)                                                
  T1-KVOI-RP(5)  = TX-KVOI-RP(8)                                                
  T1-KVOI-RP(4)  = TX-KVOI-RP(9)                                                
  T1-KVOI-RP(3)  = TX-KVOI-RP(10)                                               
  T1-KVOI-RP(2)  = TX-KVOI-RP(11)                                               
  T1-KVOI-RP(1)  = TX-KVOI-RP(12)                                               
************                                                                    
                                                                                
  WS-KVOI-INNEV = 0                                                             
  WS-KVOI-IAAR  = 0                                                             
  WS-KVOT-SDC-INNEV = 0                                                         
  WS-KVOT-MISS-INNEV = 0                                                        
  INDX = 1                                                                      
  INDX2-MAX = 5                                                                 
                                     ***** INNEV PERIOD                         
  DO WHILE INDX LE INDX2-MAX                                                    
     WS-KVOI-INNEV = W01186-DC-KVOI-INNEV      (INDX)           +               
                     + W01186-DC-KVOI-PP-INNEV (INDX)           +               
                     + WS-KVOI-INNEV                                            
* TOTAL ORDER HITS FOR PRESENT PERIOD                                           
     WS-KVOT-SDC-INNEV = W01186-DC-KVOT-INNEV  (INDX)           +               
                     + W01186-DC-KVOT-PP-INNEV (INDX)           +               
                     + W01186-DC-KVOT-REF-INNEV(INDX)           +               
                     + WS-KVOT-SDC-INNEV                                        
* MISSED ORDER HITS FOR PRESENT PERIOD                                          
     WS-KVOT-MISS-INNEV = W01186-DC-KVOT-CDC-INNEV(INDX)        +               
                         + WS-KVOT-MISS-INNEV                                   
     INDX = INDX + 1                                                            
  END-DO                                                                        
  T1-KVOI-INNEV = WS-KVOI-INNEV                                                 
  T1-KVOT-SDC-INNEV = WS-KVOT-SDC-INNEV                                         
  T1-KVOT-MISS-INNEV = WS-KVOT-MISS-INNEV                                       
                                     ***** INNEV AAR                            
                                     ***** VECKOR AVSLUTAD PERIOD               
  IF SW-NY-PERIOD = NEJ                                                         
     INDX2-MAX = WS-TIVV - 1                                                    
  ELSE                                                                          
     INDX2-MAX = W-DAGENS-VV                                                    
  END-IF                                                                        
  IF SW-NYTT-AR = JA                                                            
     INDX2-MAX = 0                                                              
  END-IF                                                                        
                                                                                
  INDX = 1                                                                      
  DO WHILE INDX LE INDX2-MAX                                                    
     WS-KVOI-IAAR = W01186-DC-KVOI-RULL(INDX)                  +                
                  + WS-KVOI-IAAR                                                
     INDX = INDX + 1                                                            
  END-DO                                                                        
  T1-KVOI-IAAR = WS-KVOI-INNEV + WS-KVOI-IAAR                                   
*                                                                               
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
CB-GET-ORDER-HIT-PREV. PROC                                                     
                                                                                
  WS-KVOT-SDC-RULL  = 0                                                         
  WS-KVOT-MISS-RULL = 0                                                         
  INDX2             = WS-FORSTA-V(12)                                           
  DO WHILE INDX2 LE WS-SISTA-V(12)                                              
                                                                                
* TOTAL ORDER HITS FOR PREVIOUS PERIOD                                          
     WS-KVOT-SDC-RULL  = W01186-DC-KVOT-RULL(INDX2)            +                
                         + W01186-DC-KVOT-REF-RULL(INDX2)      +                
                         + WS-KVOT-SDC-RULL                                     
                                                                                
* MISSED ORDER HITS FOR PREVIOUS PERIOD                                         
     WS-KVOT-MISS-RULL  = W01186-DC-KVOT-CDC-RULL(INDX2)       +                
                         + WS-KVOT-MISS-RULL                                    
                                                                                
     INDX2 = INDX2 + 1                                                          
  END-DO                                                                        
  T1-KVOT-SDC-RULL = WS-KVOT-SDC-RULL                                           
  T1-KVOT-MISS-RULL = WS-KVOT-MISS-RULL                                         
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
D-SKRIV-W27120-UPPG. PROC                                                       
  T1-KDFREKKL            = W27120-KDFREKKL                                      
