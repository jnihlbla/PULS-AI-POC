NEWPAGE                                                                         
E-NOLLA-W01186-UPPG. PROC                                                       
  T1-KVOI-FOREG(1)       = +0                                                   
  T1-KVOI-FOREG(2)       = +0                                                   
  T1-KVOI-CDC-RULL       = +0                                                   
  T1-KVOI-RULL           = +0                                                   
  T1-KVOT-CDC-RULL       = +0                                                   
  T1-KVOT-SDC-RULL       = +0                                                   
  T1-KVOT-SDC-INNEV      = +0                                                   
  T1-KVOT-RULL           = +0                                                   
  T1-KVOI-INNEV          = +0                                                   
  T1-KVOT-MISS-INNEV     = +0                                                   
  T1-KVOT-MISS-RULL      = +0                                                   
  T1-KVOI-IAAR           = 0                                                    
  T1-TIINLINL            = +0                                                   
  INDX = 1                                                                      
  DO WHILE INDX LE INDX-MAX                                                     
    T1-KVOI-RP(INDX)     = 0                                                    
    INDX = INDX + 1                                                             
  END-DO                                                                        
  T1-TIREFEFT            = +0                                                   
END-PROC                                                                        
