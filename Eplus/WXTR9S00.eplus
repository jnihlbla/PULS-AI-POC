NEWPAGE                                                                         
F-NOLLA-W27120-UPPG. PROC                                                       
  T1-KDFREKKL            = ' '                                                  
  T1-KDPRISKL            = ' '                                                  
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
S-BERAKNA-ANTAL-VECKOR. PROC                                                    
                                                                                
 DAT-I-TIDATUM = +0                                                             
 DAT-KDDATFORM = 'IDAG'                                                         
 CALL WDATKONV USING (DAT-KDDATFORM,  +                                         
                      DAT-I-TIDATUM,  +                                         
                      DAT-O-TIDATUM,  +                                         
                      DAT-KDSVAR)                                               
                                                                                
 W-AA-FORRA = DAT-TIAA - 1                                                      
 W-VV-FORRA = +53                                                               
                                                                                
 W-DAGENS-AARP    =  DAT-TIAARP                                                 
                                                                                
 DAT-I-TIDATUM = W-AAVV-FORRA                                                   
 DAT-KDDATFORM = 'AAVV'                                                         
 CALL WDATKONV USING (DAT-KDDATFORM,  +                                         
                      DAT-I-TIDATUM,  +                                         
                      DAT-O-TIDATUM,  +                                         
                      DAT-KDSVAR)                                               
                                                                                
 IF DAT-KDSVAR = 'F'                                                            
   W-ANTAL-VECKOR = +52                                                         
 ELSE                                                                           
   W-ANTAL-VECKOR = +53                                                         
 END-IF                                                                         
                                                                                
END-PROC                                                                        
                                                                                
S1-GET-WEEKS-IN-PERIOD. PROC                                                    
                                                                                
 INDX = 1                                                                       
                                                                                
 WS-TIAAPER = W-DAGENS-AARP                                                     
 IF TIAA = 00                                                                   
    TIAA = 99                                                                   
 ELSE                                                                           
    TIAA = TIAA - 1                                                             
 END-IF                                                                         
                                                                                
 DAT-I-TIDATUM = TIAAPER                                                        
 DAT-KDDATFORM = 'AARP'                                                         
 CALL WDATKONV USING (DAT-KDDATFORM,  +                                         
                      DAT-I-TIDATUM,  +                                         
                      DAT-O-TIDATUM,  +                                         
                      DAT-KDSVAR)                                               
                                                                                
 IF PER = 1                                                                     
    WS-FORSTA-V(INDX) = 1                                                       
 ELSE                                                                           
    WS-FORSTA-V(INDX) = DAT-TIVV                                                
 END-IF                                                                         
                                                                                
 DO WHILE INDX LE INDX-MAX                                                      
    PER = PER + 1                                                               
    IF PER GT INDX-MAX                                                          
      TIAA = TIAA + 1                                                           
      PER = 1                                                                   
    END-IF                                                                      
                                                                                
    DAT-I-TIDATUM = TIAAPER                                                     
    CALL WDATKONV USING (DAT-KDDATFORM,  +                                      
                         DAT-I-TIDATUM,  +                                      
                         DAT-O-TIDATUM,  +                                      
                         DAT-KDSVAR)                                            
                                                                                
    IF PER             =  1                                                     
      WS-SISTA-V(INDX) = W-ANTAL-VECKOR                                         
    ELSE                                                                        
      WS-SISTA-V(INDX) = DAT-TIVV - 1                                           
    END-IF                                                                      
                                                                                
    INDX  = INDX + 1                                                            
                                                                                
    IF INDX LE INDX-MAX                                                         
      IF PER =  1                                                               
        WS-FORSTA-V(INDX) = 1                                                   
      ELSE                                                                      
        WS-FORSTA-V(INDX) = DAT-TIVV                                            
      END-IF                                                                    
    END-IF                                                                      
 END-DO                                                                         
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
