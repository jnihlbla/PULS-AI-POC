*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    -- CHECKED BY WY2000                                                       
                                                                                
*******  HÄR BÖRJAR JOBB-STEGEN *********************                           
                                                                                
*----------------------------------------------------------------------*        
*  STEG 1                                                                       
* SORTERA LAGERBANDEN PÅ IDARTNR OCH IDDC                                       
* MATCHA LAGERBANDEN OCH TAG FRAM GAMMALT OCH NYTT KVLS OCH KVEFRS              
*        KVAKS-PAV, KVAKS-SDC OCH PRAVCOST SAMT ARTNR O IDDC                    
*----------------------------------------------------------------------*        
                                                                                
SORT W56049D1 TO TPFILTO USING (I1-IDARTNR I1-IDDC) SIZE 400000                 
                                                                                
SORT W56049D2 TO TPFILTN USING (I2-IDARTNR I2-IDDC) SIZE 400000                 
                                                                                
JOB INPUT (TPFILTN KEY (TN-IDARTNR TN-IDDC)    +                                
           TPFILTO KEY (TO-IDARTNR TO-IDDC))                                    
                                                                                
IF MATCHED                                                                      
 T1-IDARTNR     = TN-IDARTNR                                                    
 T1-BEART       = ' '                                                           
 T1-IDDC        = TN-IDDC                                                       
 T1-KDPSLLOC    = 0                                                             
 T1-KVLS-O      = TO-KVLS                                                       
 T1-KVLS-N      = TN-KVLS                                                       
 T1-KVEFRS-O    = TO-KVEFRS                                                     
 T1-KVEFRS-N    = TN-KVEFRS                                                     
 T1-KVAKS-PAV-O = TO-KVAKS-PAV                                                  
 T1-KVAKS-PAV-N = TN-KVAKS-PAV                                                  
 T1-KVAKS-NDC-O = TO-KVAKS-SDC                                                  
 T1-KVAKS-NDC-N = TN-KVAKS-SDC                                                  
 T1-PRAVCOST-O  = TO-PRAVCOST                                                   
 T1-PRAVCOST-N  = TN-PRAVCOST                                                   
 PUT TPFIL1                                                                     
ELSE                                                                            
 IF TPFILTO                                                                     
   T1-IDARTNR     = TO-IDARTNR                                                  
   T1-BEART       = ' '                                                         
   T1-IDDC        = TO-IDDC                                                     
   T1-KDPSLLOC    = 0                                                           
   T1-KVLS-O      = TO-KVLS                                                     
   T1-KVLS-N      = 0                                                           
   T1-KVEFRS-O    = TO-KVEFRS                                                   
   T1-KVEFRS-N    = 0                                                           
   T1-KVAKS-PAV-O = TO-KVAKS-PAV                                                
   T1-KVAKS-PAV-N = 0                                                           
   T1-KVAKS-NDC-O = TO-KVAKS-SDC                                                
   T1-KVAKS-NDC-N = 0                                                           
   T1-PRAVCOST-O  = TO-PRAVCOST                                                 
   T1-PRAVCOST-N  = 0                                                           
   PUT TPFIL1                                                                   
 ELSE                                                                           
   T1-IDARTNR     = TN-IDARTNR                                                  
   T1-BEART       = ' '                                                         
   T1-IDDC        = TN-IDDC                                                     
   T1-KDPSLLOC    = 0                                                           
   T1-KVLS-O      = 0                                                           
   T1-KVLS-N      = TN-KVLS                                                     
   T1-KVEFRS-O    = 0                                                           
   T1-KVEFRS-N    = TN-KVEFRS                                                   
   T1-KVAKS-PAV-O = 0                                                           
   T1-KVAKS-PAV-N = TN-KVAKS-PAV                                                
   T1-KVAKS-NDC-O = 0                                                           
   T1-KVAKS-NDC-N = TN-KVAKS-SDC                                                
   T1-PRAVCOST-O  = 0                                                           
   T1-PRAVCOST-N  = TN-PRAVCOST                                                 
   PUT TPFIL1                                                                   
 END-IF                                                                         
END-IF                                                                          
                                                                                
*----------------------------------------------------------------------*        
*  STEG 2                                                                       
* MATCHA TEMPFIL1 MED ARTIKELREGEXTRAKT FÖR ATT HÄMTA                           
*     LOKALT PRODUKTSLAG, MEN FÖRST EN SORT                                     
*----------------------------------------------------------------------*        
                                                                                
SORT TPFIL1  TO TPFIL1  USING (T1-IDARTNR) SIZE 400000                          
                                                                                
JOB INPUT (W56049D3 KEY (I3-CLAG-IDARTNR) +                                     
           TPFIL1  KEY (T1-IDARTNR))                                            
IF MATCHED                                                                      
   T2-POST        = T1-POST                                                     
   T2-KDPSLLOC    = I3-CLAG-KDPSLLOC                                            
   PUT TPFIL2                                                                   
ELSE                                                                            
 IF TPFIL1                                                                      
   T2-POST        = T1-POST                                                     
   T2-KDPSLLOC    = 0                                                           
   PUT TPFIL2                                                                   
 END-IF                                                                         
END-IF                                                                          
                                                                                
*----------------------------------------------------------------------*        
*  STEG 3                                                                       
* MATCHA TEMPFIL2 MED BENÄMNINGSFIL FÖR ATT HÄMTA ARTIKELBENÄMNING,             
*       OM US-BENÄMNING FINNS HÄMTAS DENNA ANNARS TAS ENGELSK BENÄMNING         
*----------------------------------------------------------------------*        
                                                                                
SORT TPFIL2  TO TPFIL2  USING (T2-IDARTNR) SIZE 400000                          
                                                                                
JOB INPUT (W56049D4 KEY (BEN-IDARTNR)  +                                        
           TPFIL2  KEY (T2-IDARTNR))                                            
IF MATCHED                                                                      
   T3-POST        = T2-POST                                                     
   IF BEN-BEART(10) NE '                         '                              
     T3-BEART     = BEN-BEART(10)                                               
   ELSE                                                                         
     T3-BEART     = BEN-BEART(04)                                               
   END-IF                                                                       
   PUT TPFIL3                                                                   
ELSE                                                                            
 IF TPFIL2                                                                      
   T3-POST        = T2-POST                                                     
   T3-BEART       = '                         '                                 
   PUT TPFIL3                                                                   
 END-IF                                                                         
END-IF                                                                          
                                                                                
*----------------------------------------------------------------------*        
*  STEG 4                                                                       
* PLOCKA FRAM LV-POSTERS OCH LAB-POSTERS SALDON PÅ TEMPFIL 4,                   
* (LV-POSTER = L02, L05 OCH L09, LAB-POSTER = A03 - A19-TRANSAR)                
*----------------------------------------------------------------------*        
                                                                                
JOB INPUT W56049D5                                                              
                                                                                
 CASE LAB-TRANS-IDPTYP                                                          
                                                                                
   WHEN 'L02'                                                                   
     T4-IDPTYP         = L02-IDPTYP                                             
     T4-IDARTNR        = L02-IDARTNR                                            
     T4-IDDC           = L02-IDDC-REC                                           
     T4-LS-RECIP       = 0                                                      
     T4-LS-SALES       = L02-KVLEVART                                           
     T4-LS-JUST        = 0                                                      
     T4-IDARTNR        = L02-IDARTNR                                            
     PUT TPFIL4                                                                 
                                                                                
   WHEN 'A03'                                                                   
     T4-IDPTYP         = A03-IDPTYP                                             
     T4-IDARTNR        = A03-IDARTNR                                            
     T4-IDDC           = A03-IDDC-REC                                           
     IF A03-KDEKOHT = 'T10' 'T40' 'T50' 'I20'                                   
       T4-LS-RECIP     = A03-KVANTMOT                                           
       T4-LS-SALES     = 0                                                      
       T4-LS-JUST      = 0                                                      
       PUT TPFIL4                                                               
     END-IF                                                                     
     IF A03-KDEKOHT = 'T30'                                                     
       IF A03-KDANMORS NE '60' '61'                                             
         T4-IDDC       = A03-IDDC-SEND                                          
         T4-LS-RECIP   = 0                                                      
         T4-LS-SALES   = 0                                                      
         T4-LS-JUST    = A03-KVLEVART - A03-KVANTMOT - A03-KVSKROT              
         PUT TPFIL4                                                             
       END-IF                                                                   
       T4-IDDC         = A03-IDDC-REC                                           
       T4-LS-RECIP     = A03-KVANTMOT                                           
       T4-LS-SALES     = 0                                                      
       T4-LS-JUST      = 0                                                      
       PUT TPFIL4                                                               
     END-IF                                                                     
                                                                                
   WHEN 'L05'                                                                   
     T4-IDPTYP         = L05-IDPTYP                                             
     T4-IDARTNR        = L05-IDARTNR                                            
     T4-IDDC           = L05-IDDC-REC                                           
     T4-LS-RECIP       = 0                                                      
     T4-LS-SALES       = 0                                                      
     IF L05-KDANMORS = '00' '20'                                                
       T4-LS-JUST      = L05-KVKREANT                                           
     ELSE                                                                       
       T4-LS-JUST      = L05-KVKREANT * -1                                      
     END-IF                                                                     
     PUT TPFIL4                                                                 
                                                                                
   WHEN 'A06'                                                                   
     T4-IDPTYP         = A06-IDPTYP                                             
     T4-IDARTNR        = A06-IDARTNR                                            
     T4-IDDC           = A06-IDDC-REC                                           
     T4-LS-RECIP       = 0                                                      
     T4-LS-SALES       = 0                                                      
     T4-LS-JUST        = A06-KVRETINL                                           
     PUT TPFIL4                                                                 
                                                                                
   WHEN 'A07'                                                                   
     T4-IDPTYP         = A07-IDPTYP                                             
     T4-IDARTNR        = A07-IDARTNR                                            
     T4-IDDC           = A07-IDDC-SEND                                          
     T4-LS-RECIP       = 0                                                      
     T4-LS-SALES       = 0                                                      
     T4-LS-JUST        = A07-KVLEVART * -1                                      
     PUT TPFIL4                                                                 
                                                                                
   WHEN 'A08'                                                                   
     T4-IDPTYP         = A08-IDPTYP                                             
     T4-IDARTNR        = A08-IDARTNR                                            
     T4-IDDC           = A08-IDDC-REC                                           
     T4-LS-RECIP       = 0                                                      
     T4-LS-SALES       = 0                                                      
     T4-LS-JUST        = A08-KVJUSTKV                                           
     PUT TPFIL4                                                                 
                                                                                
   WHEN 'A09'                                                                   
     T4-IDPTYP         = A09-IDPTYP                                             
     T4-IDARTNR        = A09-IDARTNR                                            
     T4-LS-RECIP       = 0                                                      
     T4-LS-SALES       = 0                                                      
     IF A09-KDEKOHT = 'T20'                                                     
       T4-IDDC         = A09-IDDC-SEND                                          
       T4-LS-JUST      = A09-KVLEVART * -1                                      
       PUT TPFIL4                                                               
     END-IF                                                                     
     IF A09-KDEKOHT = 'T30' 'T40'                                               
       T4-IDDC         = A09-IDDC-SEND                                          
       T4-LS-JUST      = A09-KVLEVART * -1                                      
       PUT TPFIL4                                                               
     END-IF                                                                     
                                                                                
   WHEN 'L09'                                                                   
     IF L09-KDEKOHT = 'T40'                                                     
       T4-IDPTYP       = L09-IDPTYP                                             
       T4-IDARTNR      = L09-IDARTNR                                            
       T4-IDDC         = L09-IDDC-SEND                                          
       T4-LS-RECIP     = 0                                                      
       T4-LS-SALES     = 0                                                      
       T4-LS-JUST      = L09-KVLEVART * -1                                      
       PUT TPFIL4                                                               
     END-IF                                                                     
                                                                                
   WHEN 'A11'                                                                   
     T4-IDPTYP         = A11-IDPTYP                                             
     T4-IDARTNR        = A11-IDARTNR                                            
     T4-IDDC           = A11-IDDC-REC                                           
     T4-LS-RECIP       = A11-KVANTMOT                                           
     T4-LS-SALES       = 0                                                      
     T4-LS-JUST        = 0                                                      
     PUT TPFIL4                                                                 
                                                                                
   WHEN 'A12'                                                                   
     T4-IDPTYP         = A12-IDPTYP                                             
     T4-IDARTNR        = A12-IDARTNR                                            
     T4-IDDC           = A12-IDDC-REC                                           
     T4-LS-RECIP       = 0                                                      
     T4-LS-SALES       = 0                                                      
     T4-LS-JUST        = A12-KVJUSTKV                                           
     PUT TPFIL4                                                                 
                                                                                
   WHEN 'A13'                                                                   
     T4-IDPTYP         = A13-IDPTYP                                             
     T4-IDARTNR        = A13-IDARTNR                                            
     T4-IDDC           = A13-IDDC-REC                                           
     T4-LS-RECIP       = A13-KVLEVART                                           
     T4-LS-SALES       = A13-KVLEVART                                           
     T4-LS-JUST        = 0                                                      
     PUT TPFIL4                                                                 
                                                                                
   WHEN 'A14'                                                                   
     T4-IDPTYP         = A14-IDPTYP                                             
     T4-IDARTNR        = A14-IDARTNR                                            
     T4-IDDC           = A14-IDDC-REC                                           
     T4-LS-RECIP       = 0                                                      
     T4-LS-SALES       = 0                                                      
     T4-LS-JUST        = A14-KVRETUR                                            
     PUT TPFIL4                                                                 
                                                                                
   WHEN 'A15'                                                                   
     T4-IDPTYP         = A15-IDPTYP                                             
     T4-IDARTNR        = A15-IDARTNR                                            
     IF A15-KDEKOHT = 'O31' 'O72'                                               
       T4-IDDC         = A15-IDDC-SEND                                          
     ELSE                                                                       
       T4-IDDC         = A15-IDDC-REC                                           
     END-IF                                                                     
     T4-LS-RECIP       = 0                                                      
     T4-LS-SALES       = 0                                                      
     T4-LS-JUST        = A15-KVLEVART * -1                                      
     PUT TPFIL4                                                                 
                                                                                
   WHEN 'A18'                                                                   
     T4-IDPTYP         = A18-IDPTYP                                             
     T4-IDARTNR        = A18-IDARTNR                                            
     T4-IDDC           = A18-IDDC-REC                                           
     T4-LS-RECIP       = 0                                                      
     T4-LS-SALES       = 0                                                      
     T4-LS-JUST        = A18-KVANTMOT                                           
     PUT TPFIL4                                                                 
                                                                                
   WHEN 'A19'                                                                   
     T4-IDPTYP         = A19-IDPTYP                                             
     T4-IDARTNR        = A19-IDARTNR                                            
     T4-IDDC           = A19-IDDC-REC                                           
     T4-LS-RECIP       = 0                                                      
     T4-LS-SALES       = 0                                                      
     T4-LS-JUST        = A19-KVJUSTKV                                           
     PUT TPFIL4                                                                 
                                                                                
END-CASE                                                                        
*----------------------------------------------------------------------*        
*  STEG 5                                                                       
* SORTERA LAB-TRANSARNA PÅ IDDC OCH ARTIKELNUMMER (TEMP4)                       
* OCH SUMMERA PÅ DESSA BEGREPP                                                  
*----------------------------------------------------------------------*        
                                                                                
SORT TPFIL4 TO TPFIL4 USING (T4-IDDC T4-IDARTNR) SIZE 500000                    
                                                                                
JOB INPUT TPFIL4 START 5-INIT FINISH 5-FIN                                      
                                                                                
   IF T5-IDARTNR NE T4-IDARTNR OR  +                                            
     T5-IDDC NE T4-IDDC                                                         
     IF T5-IDARTNR NE 0                                                         
       PUT TPFIL5                                                               
     END-IF                                                                     
     T5-POST      = T4-POST                                                     
   ELSE                                                                         
     T5-LS-SALES  = T5-LS-SALES + T4-LS-SALES                                   
     T5-LS-RECIP  = T5-LS-RECIP + T4-LS-RECIP                                   
     T5-LS-JUST   = T5-LS-JUST  + T4-LS-JUST                                    
   END-IF                                                                       
                                                                                
5-INIT. PROC                                                                    
   T5-LS-SALES    = 0                                                           
   T5-LS-RECIP    = 0                                                           
   T5-LS-JUST     = 0                                                           
   T5-IDARTNR     = 0                                                           
   T5-IDDC        = '  '                                                        
END-PROC                                                                        
                                                                                
5-FIN. PROC                                                                     
   PUT TPFIL5                                                                   
END-PROC                                                                        
*----------------------------------------------------------------------*        
*  STEG 6                                                                       
* SORTERA ART-TRANSARNA PÅ IDDC OCH ARTIKELNUMMER (TEMP3)                       
* SORTERA LAB-TRANSARNA PÅ IDDC OCH ARTIKELNUMMER (TEMP5)                       
* MATCHA FILERNA OCH SKAPA LISTA                                                
*----------------------------------------------------------------------*        
                                                                                
SORT TPFIL3 TO TPFIL3 USING (T3-IDDC T3-IDARTNR) SIZE 400000                    
                                                                                
SORT TPFIL5 TO TPFIL5 USING (T5-IDDC T5-IDARTNR) SIZE 70000                     
                                                                                
JOB INPUT (TPFIL3 KEY (T3-IDDC T3-IDARTNR)    +                                 
           TPFIL5 KEY (T5-IDDC T5-IDARTNR))                                     
                                                                                
IF MATCHED                                                                      
    W-IDARTNR   = T3-IDARTNR                                                    
    W-IDDC      = T3-IDDC                                                       
    W-BEART     = T3-BEART                                                      
    W-LPC       = T3-KDPSLLOC                                                   
    W-LS-O      = T3-KVLS-O + T3-KVEFRS-O                                       
    W-LS-N      = T3-KVLS-N + T3-KVEFRS-N                                       
    W-SALES     = T5-LS-SALES                                                   
    W-RECIP     = T5-LS-RECIP                                                   
    W-JUST      = T5-LS-JUST                                                    
    W-DIFF      = T3-KVLS-O + T3-KVEFRS-O - T3-KVLS-N - T3-KVEFRS-N +           
                - T5-LS-SALES + T5-LS-RECIP + T5-LS-JUST                        
    W-PRAVCOST  = T3-PRAVCOST-N                                                 
    W-SUAVCOST  = T3-PRAVCOST-N * (T3-KVLS-N + T3-KVEFRS-N)                     
    PERFORM SKRIV-LISTA                                                         
ELSE                                                                            
  IF TPFIL3                                                                     
    W-IDARTNR   = T3-IDARTNR                                                    
    W-IDDC      = T3-IDDC                                                       
    W-BEART     = T3-BEART                                                      
    W-LPC       = T3-KDPSLLOC                                                   
    W-LS-O      = T3-KVLS-O + T3-KVEFRS-O                                       
    W-LS-N      = T3-KVLS-N + T3-KVEFRS-N                                       
    W-SALES     = 0                                                             
    W-RECIP     = 0                                                             
    W-JUST      = 0                                                             
    W-DIFF      = T3-KVLS-O + T3-KVEFRS-O - T3-KVLS-N - T3-KVEFRS-N             
    W-PRAVCOST  = T3-PRAVCOST-N                                                 
    W-SUAVCOST  = T3-PRAVCOST-N * (T3-KVLS-N + T3-KVEFRS-N)                     
    PERFORM SKRIV-LISTA                                                         
  ELSE                                                                          
    W-IDARTNR   = T5-IDARTNR                                                    
    W-IDDC      = '  '                                                          
    W-BEART     = ' '                                                           
    W-LPC       = 0                                                             
    W-LS-O      = 0                                                             
    W-LS-N      = 0                                                             
    W-SALES     = T5-LS-SALES                                                   
    W-RECIP     = T5-LS-RECIP                                                   
    W-JUST      = T5-LS-JUST                                                    
    W-DIFF      = T5-LS-RECIP - T5-LS-SALES + T5-LS-JUST                        
    W-PRAVCOST  = 0                                                             
    W-SUAVCOST  = 0                                                             
    PERFORM SKRIV-LISTA                                                         
  END-IF                                                                        
END-IF                                                                          
                                                                                
SKRIV-LISTA. PROC                                                               
      IF T3-IDDC = NDC-US-RU                                                    
        W-TOT41-LS-O  = W-TOT41-LS-O  + W-LS-O                                  
        W-TOT41-RECIP = W-TOT41-RECIP + W-RECIP                                 
        W-TOT41-SALES = W-TOT41-SALES + W-SALES                                 
        W-TOT41-JUST  = W-TOT41-JUST  + W-JUST                                  
        W-TOT41-LS-N  = W-TOT41-LS-N  + W-LS-N                                  
        W-TOT41-DIFF  = W-TOT41-DIFF  + W-DIFF                                  
        W-TOT41-SUAVC = W-TOT41-SUAVC + W-SUAVCOST                              
        PRINT LISTA41                                                           
      ELSE-IF T3-IDDC = NDC-US-BAT                                              
        W-TOT92-LS-O  = W-TOT92-LS-O  + W-LS-O                                  
        W-TOT92-RECIP = W-TOT92-RECIP + W-RECIP                                 
        W-TOT92-SALES = W-TOT92-SALES + W-SALES                                 
        W-TOT92-JUST  = W-TOT92-JUST  + W-JUST                                  
        W-TOT92-LS-N  = W-TOT92-LS-N  + W-LS-N                                  
        W-TOT92-DIFF  = W-TOT92-DIFF  + W-DIFF                                  
        W-TOT92-SUAVC = W-TOT92-SUAVC + W-SUAVCOST                              
        PRINT LISTA42                                                           
      ELSE-IF T3-IDDC = NDC-US-LA                                               
        W-TOT43-LS-O  = W-TOT43-LS-O  + W-LS-O                                  
        W-TOT43-RECIP = W-TOT43-RECIP + W-RECIP                                 
        W-TOT43-SALES = W-TOT43-SALES + W-SALES                                 
        W-TOT43-JUST  = W-TOT43-JUST  + W-JUST                                  
        W-TOT43-LS-N  = W-TOT43-LS-N  + W-LS-N                                  
        W-TOT43-DIFF  = W-TOT43-DIFF  + W-DIFF                                  
        W-TOT43-SUAVC = W-TOT43-SUAVC + W-SUAVCOST                              
        PRINT LISTA43                                                           
      ELSE-IF T3-IDDC = NDC-US-SE                                               
        W-TOT44-LS-O  = W-TOT44-LS-O  + W-LS-O                                  
        W-TOT44-RECIP = W-TOT44-RECIP + W-RECIP                                 
        W-TOT44-SALES = W-TOT44-SALES + W-SALES                                 
        W-TOT44-JUST  = W-TOT44-JUST  + W-JUST                                  
        W-TOT44-LS-N  = W-TOT44-LS-N  + W-LS-N                                  
        W-TOT44-DIFF  = W-TOT44-DIFF  + W-DIFF                                  
        W-TOT44-SUAVC = W-TOT44-SUAVC + W-SUAVCOST                              
        PRINT LISTA44                                                           
      ELSE-IF T3-IDDC = NDC-US-CH                                               
        W-TOT45-LS-O  = W-TOT45-LS-O  + W-LS-O                                  
        W-TOT45-RECIP = W-TOT45-RECIP + W-RECIP                                 
        W-TOT45-SALES = W-TOT45-SALES + W-SALES                                 
        W-TOT45-JUST  = W-TOT45-JUST  + W-JUST                                  
        W-TOT45-LS-N  = W-TOT45-LS-N  + W-LS-N                                  
        W-TOT45-DIFF  = W-TOT45-DIFF  + W-DIFF                                  
        W-TOT45-SUAVC = W-TOT45-SUAVC + W-SUAVCOST                              
        PRINT LISTA45                                                           
      ELSE-IF T3-IDDC = NDC-US-JA                                               
        W-TOT46-LS-O  = W-TOT46-LS-O  + W-LS-O                                  
        W-TOT46-RECIP = W-TOT46-RECIP + W-RECIP                                 
        W-TOT46-SALES = W-TOT46-SALES + W-SALES                                 
        W-TOT46-JUST  = W-TOT46-JUST  + W-JUST                                  
        W-TOT46-LS-N  = W-TOT46-LS-N  + W-LS-N                                  
        W-TOT46-DIFF  = W-TOT46-DIFF  + W-DIFF                                  
        W-TOT46-SUAVC = W-TOT46-SUAVC + W-SUAVCOST                              
        PRINT LISTA46                                                           
      ELSE-IF T3-IDDC = NDC-CA                                                  
        W-TOT51-LS-O  = W-TOT51-LS-O  + W-LS-O                                  
        W-TOT51-RECIP = W-TOT51-RECIP + W-RECIP                                 
        W-TOT51-SALES = W-TOT51-SALES + W-SALES                                 
        W-TOT51-JUST  = W-TOT51-JUST  + W-JUST                                  
        W-TOT51-LS-N  = W-TOT51-LS-N  + W-LS-N                                  
        W-TOT51-DIFF  = W-TOT51-DIFF  + W-DIFF                                  
        W-TOT51-SUAVC = W-TOT51-SUAVC + W-SUAVCOST                              
        PRINT LISTA51                                                           
      ELSE-IF T3-IDDC = NDC-US-DA                                               
        W-TOT47-LS-O  = W-TOT47-LS-O  + W-LS-O                                  
        W-TOT47-RECIP = W-TOT47-RECIP + W-RECIP                                 
        W-TOT47-SALES = W-TOT47-SALES + W-SALES                                 
        W-TOT47-JUST  = W-TOT47-JUST  + W-JUST                                  
        W-TOT47-LS-N  = W-TOT47-LS-N  + W-LS-N                                  
        W-TOT47-DIFF  = W-TOT47-DIFF  + W-DIFF                                  
        W-TOT47-SUAVC = W-TOT47-SUAVC + W-SUAVCOST                              
        PRINT LISTA47                                                           
      END-IF                                                                    
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
