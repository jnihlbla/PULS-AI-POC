                W-SEM             +                                             
                W-SEM             +                                             
                W-TOT41-SUAVC     +                                             
                W-SEM             +                                             
                W-TOT41-DIFF      +                                             
                W-SEM                                                           
    END-IF                                                                      
  END-PROC                                                                      
                                                                                
BEFORE-LINE. PROC                                                               
 IF FIRST-LINE1 = 'J'                                                           
   DISPLAY '¤DAPW56050-001'                                                     
   DISPLAY '¤DAP41'                                                             
   DISPLAY 'DC;PART NUMBER;DESCRIPTION;LPC;OPEN BALANCE;QTY RECIEVED;' +        
           'SALE QTY;QTY ADJUSTMENT MONTHS;CLOSING BALANCE;'    +               
           'AVERAGE COST;EXTENDED VALUE;DIFF QTY;'                              
   FIRST-LINE1 = 'N'                                                            
 END-IF                                                                         
