        W-SEM              +                                                    
        W-BEART            +                                                    
        W-SEM              +                                                    
        W-LPC              +                                                    
        W-SEM              +                                                    
        W-LS-O             +                                                    
        W-SEM              +                                                    
        W-RECIP            +                                                    
        W-SEM              +                                                    
        W-SALES            +                                                    
        W-SEM              +                                                    
        W-JUST             +                                                    
        W-SEM              +                                                    
        W-LS-N             +                                                    
        W-SEM              +                                                    
        W-PRAVCOST         +                                                    
