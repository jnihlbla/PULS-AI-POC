NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* JOBSTEG 1 : LÄSER IN W37186D1                                 *               
*                                                               *               
*****************************************************************               
JOB INPUT W37186D1                                              +               
    START A-INIT                                                +               
NAME STEG-1-LÄSER-INFIL-SKRIVER-RAPPORT                                         
                                                                                
  W-IDPTYP         =  W371-IDPTYP                                               
  W-IDLOPNR        =  W371-IDLOPNR                                              
  W-IDDISTR-FOM    =  W371-IDDISTR-FOM                                          
  W-IDDISTR-TOM    =  W371-IDDISTR-TOM                                          
  W-IDKUNDNR-FOM   =  W371-IDKUNDNR-FOM                                         
  W-IDKUNDNR-TOM   =  W371-IDKUNDNR-TOM                                         
  W-IDSKYLT        =  W371-IDSKYLT                                              
  W-KVVECKOR       =  W371-KVVECKOR                                             
  W-IDFKNGRP-FOM   =  W371-IDFKNGRP-FOM                                         
  W-IDFKNGRP-TOM   =  W371-IDFKNGRP-TOM                                         
  W-IDDISTR-NYTT   =  W371-IDDISTR-NYTT                                         
                                                                                
  PRINT RAPPORT01                                                               
                                                                                
NEWPAGE                                                                         
A-INIT. PROC                                                                    
                                                                                
  W-IN-DATUM = SYSDATE                                                          
  W-UT-AA  =  W-IN-AA                                                           
  W-UT-MM  =  W-IN-MM                                                           
  W-UT-DD  =  W-IN-DD                                                           
                                                                                
END-PROC                                                                        
NEWPAGE                                                                         
*****************************************************************               
