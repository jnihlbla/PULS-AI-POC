*----------------------------------------------------------------------*        
*                UNDERLAG LISTOR TILL KEMIKALIEINSPEKTIONEN            *        
*  W11167D1   :  W910.W91042(0)             RUTIN W111Y1                        
*  W11167D2   :  W111.W100V1.W11184(0)      JOB W111J067 OCH W111J068  *        
*  W11167D3   :  W330.W330Y1.W33096(0)    ?(KOLLA BILD 3304 OCH 2107)  *        
*  W11167D4   :  W111.W111Y1.W11168(+1)                                         
*----------------------------------------------------------------------*        
NEWPAGE                                                                         
FILE W11167D1                                                                   
%W91042    'IN01-'                                                              
*                                                                               
FILE W11167D2                                                                   
%W11184    'IN02-'                                                              
*                                                                               
FILE W11167D3                                                                   
%W33096   'FSG-'                                                                
*                                                                               
FILE W11167D4 FB (79 27966)                                                     
%W11168   'UT-'                                                                 
*                                                                               
FILE TFIL01  FB (79 27966)  VIRTUAL                                             
%W11168   'T01-'                                                                
*                                                                               
W-VKFORSFG   W  9  P  3                                                         
*                                                                               
%WWPRODSL  'IN01-' WORK ''                                                      
*                                                                               
JOB INPUT(W11167D1 KEY IN01-IDARTNR W11167D2 KEY IN02-IDARTNR)                  
*                                                                               
 IF MATCHED                                                                     
    PERFORM S25-CHECK-IN01-KDPRODSL                                             
    IF IN01-KDPRODSL = KDPRODSL-CHEMICAL                                        
       T01-IDARTNR     = IN01-IDARTNR                                           
       T01-SVEBEN      = IN01-BEART(8)                                          
       T01-TIFINLV     = IN01-TIFINLV                                           
       T01-TIERSDAT    = IN01-TIERSDAT                                          
       T01-KDERS       = IN01-KDERS                                             
       T01-IDANMNR     = IN02-IDANMNR                                           
       T01-IDVARINF    = IN02-IDVARINF                                          
       T01-IDVARINF-SDS = IN02-IDVARINF-SDS                                     
       T01-VKFORSFG    = IN02-VKFORSFG                                          
       T01-SULEVANT    = 0                                                      
       PUT TFIL01                                                               
    END-IF                                                                      
 END-IF                                                                         
*                                                                               
%WWPRODSL 'IN01-' PROC ''                                                       
*                                                                               
JOB INPUT(TFIL01 KEY T01-IDARTNR W11167D3 KEY FSG-IDARTNR)                      
*                                                                               
 IF MATCHED                                                                     
***    FSG-IDDISTR = 778 SVERIGE (878 = DISTRIKT NORGE)                         
    IF FSG-IDDISTR = 778                                                        
       UT-IDARTNR       = T01-IDARTNR                                           
       UT-SVEBEN        = T01-SVEBEN                                            
       UT-TIFINLV       = T01-TIFINLV                                           
       UT-TIERSDAT      = T01-TIERSDAT                                          
       UT-KDERS         = T01-KDERS                                             
       UT-IDANMNR       = T01-IDANMNR                                           
       UT-IDVARINF      = T01-IDVARINF                                          
       UT-IDVARINF-SDS  = T01-IDVARINF-SDS                                      
       UT-VKFORSFG      = T01-VKFORSFG                                          
       UT-IDVARINF      = T01-IDVARINF                                          
       W-VKFORSFG       = FSG-SULEVANT * T01-VKFORSFG                           
       UT-VKFORSFG      = W-VKFORSFG                                            
       UT-SULEVANT      = FSG-SULEVANT                                          
       PUT W11167D4                                                             
    END-IF                                                                      
 ELSE                                                                           
    IF TFIL01                                                                   
       UT-IDARTNR       = T01-IDARTNR                                           
       UT-SVEBEN        = T01-SVEBEN                                            
       UT-TIFINLV       = T01-TIFINLV                                           
       UT-TIERSDAT      = T01-TIERSDAT                                          
       UT-KDERS         = T01-KDERS                                             
       UT-IDANMNR       = T01-IDANMNR                                           
       UT-IDVARINF      = T01-IDVARINF                                          
       UT-IDVARINF-SDS  = T01-IDVARINF-SDS                                      
       UT-VKFORSFG      = T01-VKFORSFG                                          
       UT-IDVARINF      = T01-IDVARINF                                          
       UT-VKFORSFG      = 0                                                     
       UT-SULEVANT      = 0                                                     
       PUT W11167D4                                                             
    END-IF                                                                      
 END-IF                                                                         
************************************************************************        
