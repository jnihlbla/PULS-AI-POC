                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6116400                                              *        
*                                                                      *        
*  FUNKTION   :  TAR FRAM AK-TRANSAR FÖR VECKORAPPORTEN                *        
*                                                                      *        
*  FÖRFATTARE :  KARL JOHAN HANSSON                                    *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W61164D1                                                                   
%W6111001  'IN-'                                                                
                                                                                
FILE W61164D2 FB (27 0)                                                         
%W51712    'UT-'                                                                
                                                                                
JA                      W  1 A VALUE 'J'                                        
NEJ                     W  1 A VALUE 'N'                                        
                                                                                
%WWDC99                                                                         
*    -- CHECKED BY WY2000                                                       
                                                                                
***************************                                                     
* STEG 1. SKAPA AK-POSTER *                                                     
***************************                                                     
                                                                                
JOB INPUT W61164D1                                                              
                                                                                
  IF IN-IDLOPNRM GT +0 AND IN-FLKLAR = NEJ                                      
    IF IN-KDINLSTA = '   ' 'FPK' 'AVI'                                          
      UT-IDARTNR        = IN-IDARTNR                                            
      IF IN-IDDC EQ CDC-TR                                                      
**  SUPPLY TERMINAL DC 12 LÄGGS PÅ DC 91 (SDC-NL)                               
        UT-IDDC         = SDC-NL-ET                                             
      ELSE                                                                      
        UT-IDDC         = IN-IDDC                                               
      END-IF                                                                    
      UT-KVAKS          = IN-KVINLART                                           
      UT-KVEFRS         = +0                                                    
      UT-KVLS           = +0                                                    
      UT-KVRESS         = +0                                                    
      UT-KVOKS          = +0                                                    
      PUT W61164D2                                                              
    END-IF                                                                      
  END-IF                                                                        
