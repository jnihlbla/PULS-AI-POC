*  SYSTEM     :  W02010  STEG 1 HTRS                                   *        
*                                                                      *        
*  FUNKTION   :  LÄSER KOLLIHISTORIK SLUTLEVERERADE ORDER              *        
*                OCH SKRIVER EN SUMMAPOST PER CLAGER,DISTR,KLASS       *        
*  OBS OBS OBS!!!! TILLAGT ÄVEN FRAKTKOD  IC ÄT NR 447 ANN W. 90/09/06 *        
*  FÖRFATTARE :  HGK 870202                                            *        
*                                                                      *        
*  ÄNDRINGAR  :                                                        *        
*      FEB  -93  ÄNDRINGAR INFÖR SPLITEN                               *        
*                I PGM'ET GJORDES EN TEST PÅ CLAGER, VAREFTER ARBETS-  *        
*                DAGAR BERÄKNADES. DÅ KODEN FÖR DENNA BERÄKNING VAR    *        
*                IDENTISK OAVSETT CLAGER, TOGS TESTEN BORT HELT OCH    *        
*                HÅLLET SAMT ATT DEN ENA SECTIONEN (PROC) TOGS BORT.   *        
*                DEN KVARVARANDE RENAMADES.                            *        
*                                                                      *        
*  INFIL :  W47962                                                     *        
*                                                                      *        
*  UTFILER    :  W02010                                                *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W02010D1                                                                   
%W479061E 'IN-'                                                                 
*                                                                               
NEWPAGE                                                                         
*                                                                               
*                                                                               
FILE W02010D2 FB(165 6105)                                                      
%W020101E 'UT-'                                                                 
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE TEMPFIL1 VIRTUAL FB(32 6208)                                               
*                                                                               
TEMP-NYCKEL          1   5   A                                                  
TEMP-KDCLAGER        1   1   P 0                                                
TEMP-IDDISTR         2   3   P 0                                                
TEMP-KDORDKL         5   1   P 0                                                
TEMP-KDFRAKT         6   2   P 0                                                
TEMP-IDPRODNR        8   4   P 0                                                
TEMP-TIORDREG       12   4   P 0                                                
TEMP-TIPACKN        16   4   P 0                                                
TEMP-TIFAKT         20   4   P 0                                                
TEMP-RELEDTID-PACK  24   3   P 1                                                
TEMP-RELEDTID-FAKT  27   3   P 1                                                
TEMP-RELEDTID-TOT   30   3   P 1                                                
*                                                                               
NEWPAGE                                                                         
ARBETSAREOR        W             16   A   VALUE 'ARBETSAREOR'                   
PROGRAMNAMN        W              6   A                                         
*                                                                               
NEWPAGE                                                                         
%WORKAREA 'W-'                                                                  
NEWPAGE                                                                         
*                                                                               
%WDATKORT 'RC2'                                                                 
*                                                                               
W1-KDCLAGER        W              1   P 0                                       
W1-IDDISTR         W              3   P 0                                       
W1-KDORDKL         W              1   P 0                                       
W1-KDFRAKT         W              2   P 0                                       
W1-IDPRODNR        W              4   P 0                                       
W1-TIORDREG        W              4   P 0                                       
W1-TIPACKN         W              4   P 0                                       
W1-TIFAKT          W              4   P 0                                       
W1-RELEDTID-PACK   W              3   P 1                                       
W1-RELEDTID-FAKT   W              3   P 1                                       
W1-RELEDTID-TOT    W              3   P 1                                       
W1-OK-POST         W              1   A      VALUE 'J'                          
*                                                                               
W2-NYCKEL          W              7   A                                         
W2-KDCLAGER        W2-NYCKEL      1   P 0                                       
W2-IDDISTR         W2-NYCKEL +1   3   P 0                                       
W2-KDORDKL         W2-NYCKEL +4   1   P 0                                       
W2-KDFRAKT         W2-NYCKEL +5   2   P 0                                       
W2-PACK-IX         W              3   P 0                                       
W2-FAKT-IX         W              3   P 0                                       
W2-TOT-IX          W              3   P 0                                       
W2-KVORDER         W              3   P 0                                       
W2-RELEDTID-PACK   W              3   P 1                                       
W2-RELEDTID-FAKT   W              3   P 1                                       
W2-RELEDTID-TOT    W              3   P 1                                       
*                                                                               
W2-KVORDER-PACK-AREA  W          48   A                                         
W2-KVORDER-PACK W2-KVORDER-PACK-AREA  4  P 0 OCCURS (12) INDEX PACK-IX          
*                                                                               
W2-KVORDER-FAKT-AREA  W          48   A                                         
W2-KVORDER-FAKT W2-KVORDER-FAKT-AREA  4  P 0 OCCURS (12) INDEX FAKT-IX          
*                                                                               
W2-KVORDER-TOT-AREA   W          48   A                                         
W2-KVORDER-TOT W2-KVORDER-TOT-AREA    4  P 0 OCCURS (12) INDEX TOT-IX           
                                                                                
%WY2000W1                                                                       
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT NULL NAME STEG1                                                       
*                                                                               
 GET W02010D1                                                                   
 PERFORM NOLLA1                                                                 
*                      ****** START HUVUDSLINGA ******                          
 DO WHILE NOT EOF W02010D1                                                      
*                                                                               
   PERFORM SPARA1                                                               
   DO WHILE NOT EOF W02010D1 AND IN-IDPRODNR = W1-IDPRODNR                      
*                                                                               
       TMP1-YYMMDD = IN-TIPACKN                                                 
       TMP2-YYMMDD = W1-TIPACKN                                                 
       PERFORM WY2000P1                                                         
       IF TMP1-YYMMDD > TMP2-YYMMDD                                             
         W1-TIPACKN = IN-TIPACKN                                                
       END-IF                                                                   
*                                                                               
       TMP1-YYMMDD = IN-TIFAKT                                                  
       TMP2-YYMMDD = W1-TIFAKT                                                  
       PERFORM WY2000P1                                                         
       IF TMP1-YYMMDD > TMP2-YYMMDD                                             
         W1-TIFAKT = IN-TIFAKT                                                  
       END-IF                                                                   
*                                                                               
     GET W02010D1                                                               
   END-DO                                                                       
*                                                                               
   PERFORM RAKNA-ARBDAG                                                         
   PERFORM SKRIV1                                                               
   PERFORM NOLLA1                                                               
*                                                                               
 END-DO                                                                         
 STOP                                                                           
*                       ****** SLUT HUVUDSLINGA ******                          
NEWPAGE                                                                         
NOLLA1. PROC                                                                    
W1-TIPACKN = 0                                                                  
W1-TIFAKT = 0                                                                   
END-PROC                                                                        
***                                                                             
SPARA1. PROC                                                                    
W1-KDCLAGER = IN-KDCLAGER                                                       
W1-IDDISTR = IN-IDDISTR                                                         
W1-KDORDKL = IN-KDORDKL                                                         
W1-KDFRAKT = IN-KDFRAKT                                                         
W1-IDPRODNR = IN-IDPRODNR                                                       
W1-TIORDREG = IN-TIORDREG                                                       
END-PROC                                                                        
***                                                                             
RAKNA-ARBDAG.  PROC                                                             
W-WORK-KDCALL = 001                                                             
W-WORK-IDDC   = CDC-SE                                                          
W-WORK-TIAAMMDD-FOM = W1-TIORDREG                                               
W-WORK-TIAAMMDD-TOM = W1-TIPACKN                                                
CALL WORKDAY USING(W-WORK-KDCALL W-WORK-DATE-AREA W-WORK-KDSVAR)                
*                                                                               
IF W1-TIORDREG = W1-TIPACKN                                                     
  W1-RELEDTID-PACK = 0                                                          
ELSE                                                                            
  W1-RELEDTID-PACK = W-WORK-KVWORKD  - 1                                        
END-IF                                                                          
*                                                                               
W-WORK-KDCALL = 001                                                             
W-WORK-IDDC   = CDC-SE                                                          
W-WORK-TIAAMMDD-FOM = W1-TIPACKN                                                
W-WORK-TIAAMMDD-TOM = W1-TIFAKT                                                 
CALL WORKDAY USING(W-WORK-KDCALL W-WORK-DATE-AREA W-WORK-KDSVAR)                
*                                                                               
IF W1-TIPACKN = W1-TIFAKT                                                       
  W1-RELEDTID-FAKT = 0                                                          
ELSE                                                                            
  W1-RELEDTID-FAKT = W-WORK-KVWORKD  - 1                                        
END-IF                                                                          
* FIX FÖR ATT NEGATIVA VÄRDEN KAN UPPTRÄDA                                      
IF W1-RELEDTID-PACK < 0                                                         
  W1-RELEDTID-PACK = 0                                                          
END-IF                                                                          
IF W1-RELEDTID-FAKT < 0                                                         
  W1-RELEDTID-FAKT = 0                                                          
END-IF                                                                          
*                                                                               
END-PROC                                                                        
***                                                                             
SKRIV1. PROC                                                                    
TEMP-KDCLAGER = W1-KDCLAGER                                                     
TEMP-IDDISTR = W1-IDDISTR                                                       
TEMP-KDORDKL = W1-KDORDKL                                                       
TEMP-KDFRAKT = W1-KDFRAKT                                                       
TEMP-IDPRODNR = W1-IDPRODNR                                                     
TEMP-TIORDREG = W1-TIORDREG                                                     
TEMP-TIPACKN = W1-TIPACKN                                                       
TEMP-TIFAKT = W1-TIFAKT                                                         
TEMP-RELEDTID-PACK = W1-RELEDTID-PACK                                           
TEMP-RELEDTID-FAKT = W1-RELEDTID-FAKT                                           
TEMP-RELEDTID-TOT = TEMP-RELEDTID-PACK + TEMP-RELEDTID-FAKT                     
PUT TEMPFIL1                                                                    
END-PROC                                                                        
NEWPAGE                                                                         
*                                                                               
***                                                                             
 NEWPAGE                                                                        
%WY2000P1                                                                       
***===================== START AKTIVITET 2 =============================        
JOB INPUT NULL START SÄTT-VECKONR NAME STEG2                                    
*                                                                               
 GET TEMPFIL1                                                                   
 PERFORM NOLLA2                                                                 
*                      ****** START HUVUDSLINGA ******                          
 DO WHILE NOT EOF TEMPFIL1                                                      
*                                                                               
   PERFORM SPARA2                                                               
*                                                                               
   DO WHILE NOT EOF TEMPFIL1 AND TEMP-NYCKEL = W2-NYCKEL                        
     PERFORM ACK-LEDTID                                                         
     PERFORM ACK-DAGKLASS-PACK                                                  
     PERFORM ACK-DAGKLASS-FAKT                                                  
     PERFORM ACK-DAGKLASS-TOT                                                   
*                                                                               
     GET TEMPFIL1                                                               
   END-DO                                                                       
*                                                                               
   PERFORM SKRIV2                                                               
   PERFORM NOLLA2                                                               
*                                                                               
 END-DO                                                                         
 STOP                                                                           
*                       ****** SLUT HUVUDSLINGA ******                          
NEWPAGE                                                                         
SÄTT-VECKONR.  PROC                                                             
PROGRAMNAMN = 'W02010'                                                          
CALL DATKORT USING (PROGRAMNAMN 'WDATUM' RC2DATUMKORT)                          
END-PROC                                                                        
*                                                                               
ACK-LEDTID.  PROC                                                               
W2-KVORDER = W2-KVORDER + 1                                                     
W2-RELEDTID-PACK = W2-RELEDTID-PACK + TEMP-RELEDTID-PACK                        
W2-RELEDTID-FAKT = W2-RELEDTID-FAKT + TEMP-RELEDTID-FAKT                        
*                                                                               
END-PROC                                                                        
***                                                                             
ACK-DAGKLASS-PACK.  PROC                                                        
  W2-PACK-IX = TEMP-RELEDTID-PACK                                               
*                                                                               
  IF W2-KDORDKL = 4                                                             
*                                                                               
    IF W2-PACK-IX < 5                                                           
      PACK-IX = 0                                                               
    ELSE                                                                        
      IF W2-PACK-IX > 14                                                        
        PACK-IX = 11 * 4                                                        
      ELSE                                                                      
        PACK-IX = (W2-PACK-IX - 4) * 4                                          
      END-IF                                                                    
    END-IF                                                                      
*                                                                               
  ELSE                                                                          
*                                                                               
    IF W2-PACK-IX > 10                                                          
      PACK-IX = 11 * 4                                                          
    ELSE                                                                        
      PACK-IX = W2-PACK-IX * 4                                                  
    END-IF                                                                      
  END-IF                                                                        
*                                                                               
  W2-KVORDER-PACK = W2-KVORDER-PACK + 1                                         
END-PROC                                                                        
***                                                                             
ACK-DAGKLASS-FAKT.  PROC                                                        
  W2-FAKT-IX = TEMP-RELEDTID-FAKT                                               
*                                                                               
  IF W2-KDORDKL = 4                                                             
*                                                                               
    IF W2-FAKT-IX < 5                                                           
      FAKT-IX = 0                                                               
    ELSE                                                                        
      IF W2-FAKT-IX > 14                                                        
        FAKT-IX = 11 * 4                                                        
      ELSE                                                                      
        FAKT-IX = (W2-FAKT-IX - 4) * 4                                          
      END-IF                                                                    
    END-IF                                                                      
*                                                                               
  ELSE                                                                          
*                                                                               
    IF W2-FAKT-IX > 10                                                          
      FAKT-IX = 11 * 4                                                          
    ELSE                                                                        
      FAKT-IX = W2-FAKT-IX * 4                                                  
    END-IF                                                                      
*                                                                               
  END-IF                                                                        
*                                                                               
  W2-KVORDER-FAKT = W2-KVORDER-FAKT + 1                                         
END-PROC                                                                        
***                                                                             
ACK-DAGKLASS-TOT.  PROC                                                         
  W2-TOT-IX = TEMP-RELEDTID-TOT                                                 
*                                                                               
  IF W2-KDORDKL = 4                                                             
*                                                                               
    IF W2-TOT-IX < 5                                                            
      TOT-IX = 0                                                                
    ELSE                                                                        
      IF W2-TOT-IX > 14                                                         
        TOT-IX = 11 * 4                                                         
      ELSE                                                                      
        TOT-IX = (W2-TOT-IX - 4) * 4                                            
      END-IF                                                                    
    END-IF                                                                      
*                                                                               
  ELSE                                                                          
*                                                                               
    IF W2-TOT-IX > 10                                                           
      TOT-IX = 11 * 4                                                           
    ELSE                                                                        
      TOT-IX = W2-TOT-IX * 4                                                    
    END-IF                                                                      
*                                                                               
  END-IF                                                                        
*                                                                               
  W2-KVORDER-TOT = W2-KVORDER-TOT + 1                                           
END-PROC                                                                        
NEWPAGE                                                                         
SKRIV2.  PROC                                                                   
UT-TIAA = RC2D-AAR                                                              
UT-TIVV = RC2D-VECKA                                                            
                                                                                
***  FIX FÖR ATT KLARA AV VECKA 53  ***                                         
*IF UT-TIAAVV = 9253                                                            
*  UT-TIAAVV = 9252                                                             
*END-IF                                                                         
***  FIX FÖR ATT KLARA AV VECKA 53  ***                                         
                                                                                
UT-KDCLAGER = W2-KDCLAGER                                                       
UT-IDDISTR = W2-IDDISTR                                                         
UT-KDORDKL = W2-KDORDKL                                                         
UT-KDFRAKT = W2-KDFRAKT                                                         
UT-RELEDTID-PACK = W2-RELEDTID-PACK                                             
UT-RELEDTID-FAKT = W2-RELEDTID-FAKT                                             
UT-KVORDER = W2-KVORDER                                                         
UT-KVORDER-PACK-AREA = W2-KVORDER-PACK-AREA                                     
UT-KVORDER-FAKT-AREA = W2-KVORDER-FAKT-AREA                                     
UT-KVORDER-TOT-AREA = W2-KVORDER-TOT-AREA                                       
PUT W02010D2                                                                    
END-PROC                                                                        
***                                                                             
NOLLA2.  PROC                                                                   
MOVE ZERO TO W2-KDCLAGER W2-IDDISTR W2-KDORDKL W2-KVORDER +                     
             W2-RELEDTID-PACK W2-RELEDTID-FAKT W2-KDFRAKT                       
PACK-IX = 0                                                                     
DO WHILE PACK-IX < 48                                                           
 W2-KVORDER-PACK = 0                                                            
 PACK-IX = PACK-IX + 4                                                          
END-DO                                                                          
FAKT-IX = 0                                                                     
DO WHILE FAKT-IX < 48                                                           
 W2-KVORDER-FAKT = 0                                                            
 FAKT-IX = FAKT-IX + 4                                                          
END-DO                                                                          
TOT-IX = 0                                                                      
DO WHILE TOT-IX < 48                                                            
 W2-KVORDER-TOT = 0                                                             
 TOT-IX = TOT-IX + 4                                                            
END-DO                                                                          
END-PROC                                                                        
***                                                                             
SPARA2.  PROC                                                                   
W2-KDCLAGER = TEMP-KDCLAGER                                                     
W2-IDDISTR = TEMP-IDDISTR                                                       
W2-KDORDKL = TEMP-KDORDKL                                                       
W2-KDFRAKT = TEMP-KDFRAKT                                                       
END-PROC                                                                        
*                                                                               
