*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5127300                                              *        
*                                                                      *        
*  FUNCTION   :  CREATES GIT REPORT TO SHOW ITEMS OLDER THAN 6 MONTHS  *        
*                                                                      *        
*  AUTHOR     :  SARASWATHY S                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
NEWPAGE                                                                         
FILE W51273D1                                                                   
*                                                                               
%W51272  'IN-'                                                                  
*                                                                               
NEWPAGE                                                                         
FILE W51273D2 VB (285 0)                                                        
*                                                                               
UT-HEAD                 1 174   A                                               
UT-IDFTG                1   2   N                                               
UT-SEP1                +3   1   A                                               
UT-IDARTNR             +4   9   N                                               
UT-SEP2               +13   1   A                                               
UT-DATRADAT           +14   8   N                                               
UT-SEP3               +22   1   A                                               
UT-IDDC               +23   2   A                                               
UT-SEP4               +25   1   A                                               
UT-IDLEVNR            +26   5   A                                               
UT-SEP5               +31   1   A                                               
UT-IDFAKT             +32   7   N                                               
UT-SEP6               +39   1   A                                               
UT-IDDISTR            +40   4   N                                               
UT-SEP7               +44   1   A                                               
UT-IDKUNDNR           +45   8   N                                               
UT-SEP8               +53   1   A                                               
UT-IDORDNR5           +54   5   N                                               
UT-SEP9               +59   1   A                                               
UT-KDFRAKT            +60   3   N                                               
UT-SEP10              +63   1   A                                               
UT-KDVALISO           +64   3   A                                               
UT-SEP11              +67   1   A                                               
UT-KVAVIS             +68   7   N                                               
UT-SEP12              +75   1   A                                               
UT-PRARTSTD-N         +76  11   N                                               
UT-DEC1               +87   1   A                                               
UT-PRARTSTD-D         +88   2   N                                               
UT-SEP13              +90   1   A                                               
UT-TOT-PRARTSTD-N     +91  11   N                                               
UT-DEC2              +102   1   A                                               
UT-TOT-PRARTSTD-D    +103   2   N                                               
*                                                                               
U01-HEAD                   W    174   A                                         
U01-COL1         U01-HEAD        12   A   VALUE 'COMPANY CODE'                  
U01-SEM1         U01-HEAD  +12    1   A   VALUE ';'                             
U01-COL2         U01-HEAD  +13   11   A   VALUE 'PART NUMBER'                   
U01-SEM2         U01-HEAD  +24    1   A   VALUE ';'                             
U01-COL3         U01-HEAD  +25    4   A   VALUE 'DATE'                          
U01-SEM3         U01-HEAD  +29    1   A   VALUE ';'                             
U01-COL4         U01-HEAD  +30    2   A   VALUE 'DC'                            
U01-SEM4         U01-HEAD  +32    1   A   VALUE ';'                             
U01-COL5         U01-HEAD  +33    8   A   VALUE 'SUPPLIER'                      
U01-SEM5         U01-HEAD  +41    1   A   VALUE ';'                             
U01-COL6         U01-HEAD  +42   14   A   VALUE 'INVOICE NUMBER'                
U01-SEM6         U01-HEAD  +56    1   A   VALUE ';'                             
U01-COL7         U01-HEAD  +57   15   A   VALUE 'DISTRICT NUMBER'               
U01-SEM7         U01-HEAD  +72    1   A   VALUE ';'                             
U01-COL8         U01-HEAD  +73   15   A   VALUE 'CUSTOMER NUMBER'               
U01-SEM8         U01-HEAD  +88    1   A   VALUE ';'                             
U01-COL9         U01-HEAD  +89   12   A   VALUE 'ORDER NUMBER'                  
U01-SEM9         U01-HEAD  +101   1   A   VALUE ';'                             
U01-COL10        U01-HEAD  +102  12   A   VALUE 'FREIGHT CODE'                  
U01-SEM10        U01-HEAD  +114   1   A   VALUE ';'                             
U01-COL11        U01-HEAD  +115  13   A   VALUE 'CURRENCY CODE'                 
U01-SEM11        U01-HEAD  +128   1   A   VALUE ';'                             
U01-COL12        U01-HEAD  +129   8   A   VALUE 'QUANTITY'                      
U01-SEM12        U01-HEAD  +137   1   A   VALUE ';'                             
U01-COL13        U01-HEAD  +138  14   A   VALUE 'STANDARD PRICE'                
U01-SEM13        U01-HEAD  +152   1   A   VALUE ';'                             
U01-COL14        U01-HEAD  +153  20   A   VALUE 'TOTAL STANDARD PRICE'          
U01-SEM14        U01-HEAD  +173   1   A   VALUE ';'                             
NEWPAGE                                                                         
*-----------------------------------------------------------------*             
****WORKING STORAGE SECTION                                                     
*-----------------------------------------------------------------*             
WRITE-FLAG                 W      1    A  VALUE 'Y'                             
*                                                                               
W-PRARTSTD-FMT                   W  13  N 2                                     
W-PRARTSTD-N1  W-PRARTSTD-FMT       11  N                                       
W-PRARTSTD-D1  W-PRARTSTD-FMT  +11   2  N                                       
*                                                                               
W-PRARTSTD-TOT                   W  13  N 2                                     
W-PRARTSTD-TN1 W-PRARTSTD-TOT       11  N                                       
W-PRARTSTD-TD1 W-PRARTSTD-TOT  +11   2  N                                       
*-----------------------------------------------------------------*             
* STEP 1. READ W51272 WITH IDFTG                                                
*-----------------------------------------------------------------*             
*                                                                               
JOB INPUT (W51273D1 KEY(IN-IDFTG)) START A-INIT                                 
                                                                                
   UT-HEAD             =  '  '                                                  
   UT-IDFTG            =  IN-IDFTG                                              
   UT-SEP1             =  ';'                                                   
   UT-IDARTNR          =  IN-IDARTNR                                            
   UT-SEP2             =  ';'                                                   
   UT-DATRADAT         =  IN-DATRADAT                                           
   UT-SEP3             =  ';'                                                   
   UT-IDDC             =  IN-IDDC                                               
   UT-SEP4             =  ';'                                                   
   UT-IDLEVNR          =  IN-IDLEVNR                                            
   UT-SEP5             =  ';'                                                   
   UT-IDFAKT           =  IN-IDFAKT                                             
   UT-SEP6             =  ';'                                                   
   UT-IDDISTR          =  IN-IDDISTR                                            
   UT-SEP7             =  ';'                                                   
   UT-IDKUNDNR         =  IN-IDKUNDNR                                           
   UT-SEP8             =  ';'                                                   
   UT-IDORDNR5         =  IN-IDORDNR5                                           
   UT-SEP9             =  ';'                                                   
   UT-KDFRAKT          =  IN-KDFRAKT                                            
   UT-SEP10            =  ';'                                                   
   UT-KDVALISO         =  IN-KDVALISO                                           
   UT-SEP11            =  ';'                                                   
   UT-KVAVIS           =  IN-KVAVIS                                             
   UT-SEP12            =  ';'                                                   
   W-PRARTSTD-FMT      =  IN-PRARTSTD                                           
   UT-PRARTSTD-N       =  W-PRARTSTD-N1                                         
   UT-DEC1             =  '.'                                                   
   UT-PRARTSTD-D       =  W-PRARTSTD-D1                                         
   UT-SEP13            =  ';'                                                   
   W-PRARTSTD-TOT      =  IN-TOT-PRARTSTD                                       
   UT-TOT-PRARTSTD-N   =  W-PRARTSTD-TN1                                        
   UT-DEC2             =  '.'                                                   
   UT-TOT-PRARTSTD-D   =  W-PRARTSTD-TD1                                        
   PUT W51273D2                                                                 
   *                                                                            
    A-INIT. PROC                                                                
      IF WRITE-FLAG = 'Y'                                                       
          UT-HEAD   = U01-HEAD                                                  
          PUT W51273D2                                                          
          WRITE-FLAG = 'N'                                                      
      END-IF                                                                    
    END-PROC                                                                    
