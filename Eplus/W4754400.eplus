NEWPAGE                                                                         
*                                                                               
  JOB INPUT  W47544D1   START  A-INIT                            +              
                        FINISH Z-FINIT                           +              
                                                  NAME   STEG02                 
    IF IN-IDFAKT NE SPAR-IDFAKT                                                 
      IF IN-IDPTYP = 'CAR'                                                      
        IF W01-SUORDV-FAKT-SUM NE 0                                             
          W01-ASTERISK    = '*'                                                 
          W01-IDFAKT      = SPAR-IDFAKT                                         
          W01-TIFAKT      = SPAR-TIFAKT                                         
          W01-SUORDV-FAKT = W01-SUORDV-FAKT-SUM                                 
          TMP1-YYMMDD     = W01-TIFAKT                                          
          PERFORM WY2000P1                                                      
          W-Y2K-TIFAKT    = TMP1-YYMMDD                                         
          PRINT RAPPORT02                                                       
          W01-SUORDV-FAKT-SUM = 0                                               
        END-IF                                                                  
        W01-ASTERISK    = ' '                                                   
        W01-IDFAKT      = IN-IDFAKT                                             
        W01-TIFAKT      = IN-TIFAKT                                             
        W01-SUORDV-FAKT = IN-SUORDV-FAKT                                        
        TMP1-YYMMDD     = W01-TIFAKT                                            
        PERFORM WY2000P1                                                        
        W-Y2K-TIFAKT    = TMP1-YYMMDD                                           
        PRINT RAPPORT02                                                         
      END-IF                                                                    
      IF IN-IDPTYP = 'CA2'                                                      
        IF RECORD-COUNT = 1                                                     
          W01-SUORDV-FAKT-SUM = W01-SUORDV-FAKT-SUM + IN-SUFAKT                 
        ELSE                                                                    
          IF W01-SUORDV-FAKT-SUM NE 0                                           
            W01-ASTERISK    = '*'                                               
            W01-IDFAKT      = SPAR-IDFAKT                                       
            W01-TIFAKT      = SPAR-TIFAKT                                       
            W01-SUORDV-FAKT = W01-SUORDV-FAKT-SUM                               
            TMP1-YYMMDD     = W01-TIFAKT                                        
            PERFORM WY2000P1                                                    
            W-Y2K-TIFAKT    = TMP1-YYMMDD                                       
            PRINT RAPPORT02                                                     
            W01-SUORDV-FAKT-SUM = 0                                             
          END-IF                                                                
          W01-SUORDV-FAKT-SUM = W01-SUORDV-FAKT-SUM + IN-SUFAKT                 
        END-IF                                                                  
      END-IF                                                                    
    ELSE                                                                        
      IF IN-IDPTYP = 'CA2'                                                      
        W01-SUORDV-FAKT-SUM = W01-SUORDV-FAKT-SUM + IN-SUFAKT                   
      END-IF                                                                    
    END-IF                                                                      
                                                                                
    IF IN-IDPTYP = 'CAR' 'CA2'                                                  
      SPAR-IDFAKT = IN-IDFAKT                                                   
      SPAR-TIFAKT = IN-TIFAKT                                                   
    END-IF                                                                      
                                                                                
*                                                                               
  A-INIT. PROC                                                                  
    SPAR-IDFAKT = 0                                                             
    SPAR-TIFAKT = 0                                                             
    W01-SUORDV-FAKT-SUM = 0                                                     
  END-PROC                                                                      
*                                                                               
  Z-FINIT. PROC                                                                 
    IF W01-SUORDV-FAKT-SUM NE 0                                                 
      W01-ASTERISK    = '*'                                                     
      W01-IDFAKT      = SPAR-IDFAKT                                             
      W01-TIFAKT      = SPAR-TIFAKT                                             
      W01-SUORDV-FAKT = W01-SUORDV-FAKT-SUM                                     
      W01-SUORDV-FAKT-SUM = 0                                                   
      TMP1-YYMMDD     = W01-TIFAKT                                              
      PERFORM WY2000P1                                                          
      W-Y2K-TIFAKT    = TMP1-YYMMDD                                             
      PRINT RAPPORT02                                                           
    END-IF                                                                      
  END-PROC                                                                      
*                                                                               
%WY2000P1                                                                       
*                                                                               
NEWPAGE                                                                         
