    TITLE 04                                                     +              
    COL   12 'MONTHLY REPORT PER SRA CODE - DISTRICT 8032'       +              
    COL   62 SYSDATE                                                            
*                                                                               
    TITLE 08                                                     +              
    COL   01 'SRA-CODE'                                          +              
    COL   14 'QUANTITY'                                          +              
    COL   28 'NET WEIGHT'                                        +              
    COL   46 'TOTAL AMOUNT'                                                     
*                                                                               
    LINE 01                                                      +              
              W01-KDSRA-NOLL                                     +              
              W01-KVLEVART                                       +              
              W01-VKLEV                                          +              
              W01-SUFAKT                                                        
*                                                                               
    LINE 02                                                      +              
              W02-KDSRA-ETT                                      +              
              W02-KVLEVART                                       +              
              W02-VKLEV                                          +              
              W02-SUFAKT                                                        
*                                                                               
    LINE 03                                                      +              
              W03-KDSRA-TVA                                      +              
              W03-KVLEVART                                       +              
              W03-VKLEV                                          +              
              W03-SUFAKT                                                        
