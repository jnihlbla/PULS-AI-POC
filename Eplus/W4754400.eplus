%WY2000W1                                                                       
 W-Y2K-TIFAKT      W   6  N                                                     
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT  W47544D1   FINISH Z-FINIT                           +              
                                                  NAME   STEG01                 
  IF IN-IDPTYP = 'CAR' 'CA2'                                                    
    IF IN-KDSRA = +0                                                            
      W01-KVLEVART = W01-KVLEVART + IN-KVLEVART                                 
      W01-VKLEV    = W01-VKLEV    + IN-VKLEV                                    
      W01-SUFAKT   = W01-SUFAKT   + IN-SUFAKT                                   
    END-IF                                                                      
                                                                                
    IF IN-KDSRA = +1                                                            
      W02-KVLEVART = W02-KVLEVART + IN-KVLEVART                                 
      W02-VKLEV    = W02-VKLEV    + IN-VKLEV                                    
      W02-SUFAKT   = W02-SUFAKT   + IN-SUFAKT                                   
    END-IF                                                                      
                                                                                
    IF IN-KDSRA = +2                                                            
      W03-KVLEVART = W03-KVLEVART + IN-KVLEVART                                 
      W03-VKLEV    = W03-VKLEV    + IN-VKLEV                                    
      W03-SUFAKT   = W03-SUFAKT   + IN-SUFAKT                                   
    END-IF                                                                      
                                                                                
    IF IN-KDSRA = +3                                                            
      W04-KVLEVART = W04-KVLEVART + IN-KVLEVART                                 
      W04-VKLEV    = W04-VKLEV    + IN-VKLEV                                    
      W04-SUFAKT   = W04-SUFAKT   + IN-SUFAKT                                   
    END-IF                                                                      
                                                                                
    IF IN-KDSRA = +4                                                            
      W05-KVLEVART = W05-KVLEVART + IN-KVLEVART                                 
      W05-VKLEV    = W05-VKLEV    + IN-VKLEV                                    
      W05-SUFAKT   = W05-SUFAKT   + IN-SUFAKT                                   
    END-IF                                                                      
                                                                                
    IF IN-KDSRA > +4                                                            
      W06-KVLEVART = W06-KVLEVART + IN-KVLEVART                                 
      W06-VKLEV    = W06-VKLEV    + IN-VKLEV                                    
      W06-SUFAKT   = W06-SUFAKT   + IN-SUFAKT                                   
    END-IF                                                                      
  END-IF                                                                        
NEWPAGE                                                                         
*                                                                               
  Z-FINIT. PROC                                                                 
    W07-KVLEVART-SUM = W01-KVLEVART +                            +              
                       W02-KVLEVART +                            +              
                       W03-KVLEVART +                            +              
                       W04-KVLEVART +                            +              
                       W05-KVLEVART +                            +              
                       W06-KVLEVART                                             
*                                                                               
    W07-VKLEV-SUM    = W01-VKLEV +                               +              
                       W02-VKLEV +                               +              
                       W03-VKLEV +                               +              
                       W04-VKLEV +                               +              
                       W05-VKLEV +                               +              
                       W06-VKLEV                                                
*                                                                               
    W07-SUFAKT-SUM   = W01-SUFAKT +                              +              
                       W02-SUFAKT +                              +              
                       W03-SUFAKT +                              +              
                       W04-SUFAKT +                              +              
                       W05-SUFAKT +                              +              
                       W06-SUFAKT                                               
                                                                                
    PRINT RAPPORT01                                                             
  END-PROC                                                                      
NEWPAGE                                                                         
*                                                                               
    REPORT RAPPORT01 PRINTER W47544D2                            +              
                     LINESIZE     120                            +              
                     PAGESIZE      41                            +              
                     NODATE                                      +              
                     NOHEADING                                   +              
                     NOADJUST                                    +              
                     NOSPREAD                                    +              
                     SUMSPACE       0                            +              
                     SPACE          8                                           
