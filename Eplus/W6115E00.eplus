                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6115E00                                              *        
*                                                                      *        
*  FUNCTION   :  TO CREATE A REPORT BASED ON DEPARTMENT AND TEAM       *        
*                THIS WILL BE FUTHER SENT FOR D&P                      *        
*                                                                      *        
*  AUTHOR     :  UMESH JAIN G                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W6115ED1                                                                   
*                                                                               
%W6115D01  'IN1-'                                                               
                                                                                
NEWPAGE                                                                         
FILE W6115ED2 VB (133 0)                                                        
WS-REC      1  133 A                                                            
*                                                                               
                                                                                
NEWPAGE                                                                         
%WDATKORT                                                                       
*                                                                               
NEWPAGE                                                                         
%WDATAREA                                                                       
*                                                                               
HEADER1                     W  133 A                                            
HEADER0A      HEADER1            8 A                                            
HEADER1A      HEADER1  +9       52 A                                            
HEADER1B      HEADER1  +62      46 A                                            
HEADER1C      HEADER1  +109     23 A                                            
                                                                                
HEADER3                     W  133 A                                            
                                                                                
HEADER4                     W  133 A                                            
HEADER4A      HEADER4           49 A                                            
HEADER4B      HEADER4  +50      34 A                                            
                                                                                
*                                                                               
REC                          W  133  A                                          
IDAVD                REC          5  A                                          
SEMI1                REC    +5    1  A    VALUE ';'                             
IDGRUPP              REC    +6    2  A                                          
SEMI2                REC    +8    1  A    VALUE ';'                             
KVRADER              REC    +9    5  N    MASK 'ZZZZ9'                          
SEMI3                REC    +14   1  A    VALUE ';'                             
TIGLT-NUM            REC    +15   3  N                                          
FILL1                REC    +18   1  A    VALUE ','                             
TIGLT-DEC            REC    +19   2  N                                          
SEMI4                REC    +21   1  A    VALUE ';'                             
KVART-MAAL-NUM       REC    +22   3  N                                          
FILL7                REC    +25   1  A    VALUE ','                             
KVART-MAAL-DEC       REC    +26   2  N                                          
SEMI5                REC    +28   1  A    VALUE ';'                             
VLARTNTO-NUM         REC    +29   5  N                                          
FILL9                REC    +34   1  A    VALUE ','                             
VLARTNTO-DEC         REC    +35   1  N                                          
SEMI6                REC    +36   1  A    VALUE ';'                             
SUBEL-NUM            REC    +37   9  N                                          
SEMI9                REC    +49   1  A    VALUE ';'                             
KVRADER-PRIO         REC    +50   5  N    MASK 'ZZZZ9'                          
SEMI7                REC    +55   1  A    VALUE ';'                             
TIGLT-PRIO-NUM       REC    +56   3  N                                          
FILL4                REC    +59   1  A    VALUE ','                             
TIGLT-PRIO-DEC       REC    +60   2  N                                          
SEMI8                REC    +62   1  A    VALUE ';'                             
KVART-MAAL-PRIO-NUM  REC    +63   3  N                                          
FILL8                REC    +66   1  A    VALUE ','                             
KVART-MAAL-PRIO-DEC  REC    +67   2  N                                          
*                                                                               
  TIGLT              W  5 N 2 MASK 'ZZ9.99'                                     
  TIGLT-PRIO         W  5 N 2 MASK 'ZZ9.99'                                     
  KVART-MAAL         W  5 N 2 MASK 'ZZ9.99'                                     
  KVART-MAAL-PRIO    W  5 N 2 MASK 'ZZ9.99'                                     
  VLARTNTO           W  6 N 1 MASK 'ZZZZ9.9'                                    
  SUBEL              W  9 N 2 MASK 'ZZZZZZ9.99'                                 
  W-TIGLT-MM         W  9 N                                                     
*                                                                               
  W-GLT                            W  5   N                                     
  W-GLT-HH           W-GLT            3   N                                     
  W-GLT-MM           W-GLT         +3 2   N                                     
*                                                                               
  W-TIGLT                          W  5   N   2                                 
  W-TIGLT-NUM        W-TIGLT          3   N                                     
  W-TIGLT-DEC        W-TIGLT       +3 2   N                                     
*                                                                               
  W-TIGLT-PRIO                     W  5   N   2                                 
  W-TIGLT-PRIO-NUM   W-TIGLT-PRIO     3   N                                     
  W-TIGLT-PRIO-DEC   W-TIGLT-PRIO  +3 2   N                                     
*                                                                               
  W-KVART-MAAL                     W  5   N   2                                 
  W-KVART-MAAL-NUM   W-KVART-MAAL     3   N                                     
  W-KVART-MAAL-DEC   W-KVART-MAAL  +3 2   N                                     
*                                                                               
  W-KVART-MAAL-PRIO                            W  5   N   2                     
  W-KVART-MAAL-PRIO-NUM  W-KVART-MAAL-PRIO        3   N                         
  W-KVART-MAAL-PRIO-DEC  W-KVART-MAAL-PRIO     +3 2   N                         
*                                                                               
  W-VLARTNTO                      W  6   N   1                                  
  W-VLARTNTO-NUM    W-VLARTNTO       5   N                                      
  W-VLARTNTO-DEC    W-VLARTNTO    +5 1   N                                      
*                                                                               
  W-SUBEL                         W  11  N   2                                  
  W-SUBEL-NUM       W-SUBEL          9   N                                      
  W-SUBEL-DEC       W-SUBEL       +9 2   N                                      
*                                                                               
*                                                                               
PROGRAM-NAMN       W  6  A  VALUE 'W6115E'                                      
                                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT  W6115ED1      +                                                      
           START A-INIT                                                         
                                                                                
                                                                                
      IDAVD                    = IN1-IDAVD                                      
      IDGRUPP                  = IN1-IDGRUPP                                    
      KVRADER                  = IN1-KVRADER                                    
      KVRADER-PRIO             = IN1-KVRADER-PRIO                               
      TIGLT                    = 0                                              
      TIGLT-PRIO               = 0                                              
                                                                                
      IF IN1-KVMIN > 0 AND IN1-KVRADER > 0                                      
         W-TIGLT-MM = IN1-KVMIN  / IN1-KVRADER                                  
         W-GLT-HH   = W-TIGLT-MM / 60                                           
         W-GLT-MM   = W-TIGLT-MM - (W-GLT-HH * 60)                              
         TIGLT      = W-GLT      / 100                                          
                                                                                
         IF IN1-KVMIN-PRIO = 0 OR IN1-KVRADER-PRIO = 0                          
            MOVE ZERO                TO TIGLT-PRIO                              
         ELSE                                                                   
            W-TIGLT-MM = IN1-KVMIN-PRIO / IN1-KVRADER-PRIO                      
            W-GLT-HH   = W-TIGLT-MM     / 60                                    
            W-GLT-MM   = W-TIGLT-MM     - (W-GLT-HH * 60)                       
            TIGLT-PRIO = W-GLT          / 100                                   
         END-IF                                                                 
      END-IF                                                                    
                                                                                
      IF IN1-KVRADER    > +0                                                    
        KVART-MAAL      = 100 * IN1-KVART-MAAL / IN1-KVRADER                    
      ELSE                                                                      
        KVART-MAAL      = +0                                                    
      END-IF                                                                    
                                                                                
      IF IN1-KVRADER-PRIO   > +0                                                
        KVART-MAAL-PRIO     = 100 * (IN1-KVART-MAAL-PRIO / +                    
                                  IN1-KVRADER-PRIO)                             
      ELSE                                                                      
        KVART-MAAL-PRIO     = +0                                                
      END-IF                                                                    
                                                                                
      VLARTNTO               = IN1-VLARTNTO                                     
      SUBEL                  = IN1-SUBEL                                        
                                                                                
      PERFORM S01-EDIT-NUMERIC-VALUES                                           
      WS-REC = REC                                                              
      PUT W6115ED2                                                              
                                                                                
 A-INIT. PROC                                                                   
                                                                                
  HEADER0A = SYSDATE                                                            
  HEADER1A = '      VCCS                             INLEVERANS '               
  HEADER1B = 'LAGUPPFÖLJNING                         VECKA'                     
  HEADER1C = '        W6115E-001'                                               
  WS-REC = HEADER1                                                              
  PUT W6115ED2                                                                  
                                                                                
  WS-REC = HEADER3                                                              
  PUT W6115ED2                                                                  
                                                                                
  HEADER4A = 'AVD;LAG;RADER;LEDTID-TOT;MÅL%;VOLYM;VÄRDE '                       
  HEADER4B = ';RADER-PRIO  ;LEDTID-PRIO;MÅL%PRIO'                               
  WS-REC = HEADER4                                                              
  PUT W6115ED2                                                                  
                                                                                
 END-PROC                                                                       
                                                                                
 S01-EDIT-NUMERIC-VALUES. PROC                                                  
                                                                                
  W-TIGLT             = TIGLT                                                   
  TIGLT-NUM           = W-TIGLT-NUM                                             
  TIGLT-DEC           = W-TIGLT-DEC                                             
*                                                                               
  W-TIGLT-PRIO        = TIGLT-PRIO                                              
  TIGLT-PRIO-NUM      = W-TIGLT-PRIO-NUM                                        
  TIGLT-PRIO-DEC      = W-TIGLT-PRIO-DEC                                        
*                                                                               
  W-KVART-MAAL        = KVART-MAAL                                              
  KVART-MAAL-NUM      = W-KVART-MAAL-NUM                                        
  KVART-MAAL-DEC      = W-KVART-MAAL-DEC                                        
*                                                                               
  W-KVART-MAAL-PRIO   = KVART-MAAL-PRIO                                         
  KVART-MAAL-PRIO-NUM = W-KVART-MAAL-PRIO-NUM                                   
  KVART-MAAL-PRIO-DEC = W-KVART-MAAL-PRIO-DEC                                   
*                                                                               
  W-VLARTNTO          = VLARTNTO                                                
  VLARTNTO-NUM        = W-VLARTNTO-NUM                                          
  VLARTNTO-DEC        = W-VLARTNTO-DEC                                          
                                                                                
*                                                                               
  W-SUBEL             = SUBEL                                                   
  SUBEL-NUM           = W-SUBEL-NUM                                             
                                                                                
 END-PROC                                                                       
*                                                                               
