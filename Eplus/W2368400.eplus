                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2368400                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR 2 INFILER FRÅN WDD9 OCH WDL2                  *        
*                                                                      *        
*  FÖRFATTARE :  NIHLBLAD JOHAN                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W23684D1                                                                   
*                                                                               
%W23680  'IN1-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W23684D2                                                                   
*                                                                               
%W23682  'IN2-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W23684D3 FB(79 0)                                                          
*                                                                               
%W23684  'UT-'                                                                  
                                                                                
%WDATKORT     'DAT-'                                                            
*                                                                               
  PROGRAM-NAMN              W          6         A  VALUE 'W23684'              
  DATUMKORT-ID              W          6         A  VALUE 'WDATUM'              
                                                                                
  WS-DATUM                  W          8         A                              
    WS-YEAR                 WS-DATUM        2      N                            
    WS-MONTH                WS-DATUM    +3  2      N                            
    WS-DAY                  WS-DATUM    +6  2      N                            
  WS-DATUM2                 W               6      A                            
    WS-YEAR2                WS-DATUM2       2      N                            
    WS-MONTH2               WS-DATUM2   +2  2      N                            
    WS-DAY2                 WS-DATUM2   +4  2      N                            
  WS-DATUM3                 W               6      N                            
    WS-YEAR3                WS-DATUM3       2      N                            
    WS-MONTH3               WS-DATUM3   +2  2      N                            
    WS-DAY3                 WS-DATUM3   +4  2      N                            
  WS-Y1Y2                   W          2           A                            
    WS-Y1                   WS-Y1Y2         1      A                            
    WS-Y2                   WS-Y1Y2     +1  1      A                            
  WS-CCYYMMDD               W            10        A                            
    WS-CC                   WS-CCYYMMDD     2      A                            
    WS-YY                   WS-CCYYMMDD +2  2      A                            
    WS-STRECK1              WS-CCYYMMDD +4  1      A                            
    WS-MM                   WS-CCYYMMDD +5  2      A                            
    WS-STRECK2              WS-CCYYMMDD +7  1      A                            
    WS-DD                   WS-CCYYMMDD +8  2      A                            
  WS-TID                    W            8         A                            
    WS-TIM                  WS-TID          2      A                            
    WS-MIN                  WS-TID      +3  2      A                            
    WS-SEK                  WS-TID      +6  2      A                            
  WS-TID2                   W            8         A                            
    WS-TIM1                 WS-TID2         1      A                            
    WS-TIM2                 WS-TID2     +1  1      A                            
    WS-KOMMA3               WS-TID2     +2  1      A                            
    WS-MIN1                 WS-TID2     +3  1      A                            
    WS-MIN2                 WS-TID2     +4  1      A                            
    WS-KOMMA4               WS-TID2     +5  1      A                            
    WS-SEK1                 WS-TID2     +6  1      A                            
    WS-SEK2                 WS-TID2     +7  1      A                            
  WS-TID3                   W            8         A                            
    WS-TIM3                 WS-TID3         2      A                            
    WS-KOMMA1               WS-TID3     +2  1      A                            
    WS-MIN3                 WS-TID3     +3  2      A                            
    WS-KOMMA2               WS-TID3     +5  1      A                            
    WS-SEK3                 WS-TID3     +6  2      A                            
  WS-TIAAMMDD               W               6      A                            
    WS-AA1                  WS-TIAAMMDD     2      N                            
    WS-MM1                  WS-TIAAMMDD +2  2      N                            
    WS-DD1                  WS-TIAAMMDD +4  2      N                            
  WS-DDMMAAAA               W              10      A                            
    WS-DD2                  WS-DDMMAAAA     2      A                            
    WS-SNESTR1              WS-DDMMAAAA +2  1      A                            
    WS-MM2                  WS-DDMMAAAA +3  2      A                            
    WS-SNESTR2              WS-DDMMAAAA +5  1      A                            
    WS-SS2                  WS-DDMMAAAA +6  2      A                            
    WS-AA2                  WS-DDMMAAAA +8  2      A                            
                                                                                
    DATUM1                   W  8 A                                             
    AA1     DATUM1              2 A                                             
    MM1     DATUM1 +3           2 A                                             
    DD1     DATUM1 +6           2 A                                             
                                                                                
    DATUM22                  W  6 A                                             
    AA22    DATUM22              2 A                                            
    MM22    DATUM22 +2           2 A                                            
    DD22    DATUM22 +4           2 A                                            
    DATUM   DATUM22              6 N                                            
                                                                                
 NUM-IDARTNR                  W  10 N 0 VALUE  0                                
     NUM-IDARTNR1  NUM-IDARTNR       1 N                                        
     NUM-IDARTNR2  NUM-IDARTNR    +1 1 N                                        
     NUM-IDARTNR3  NUM-IDARTNR    +2 1 N                                        
     NUM-IDARTNR4  NUM-IDARTNR    +3 1 N                                        
     NUM-IDARTNR5  NUM-IDARTNR    +4 1 N                                        
     NUM-IDARTNR6  NUM-IDARTNR    +5 1 N                                        
     NUM-IDARTNR7  NUM-IDARTNR    +6 1 N                                        
     NUM-IDARTNR8  NUM-IDARTNR    +7 1 N                                        
     NUM-IDARTNR9  NUM-IDARTNR    +8 1 N                                        
     NUM-IDARTNR10 NUM-IDARTNR    +9 1 N                                        
                                                                                
 ALFA-IDARTNR                  W  10 A  VALUE  ' '                              
     ALFA-IDARTNR1  ALFA-IDARTNR     1 A                                        
     ALFA-IDARTNR2  ALFA-IDARTNR  +1 1 A                                        
     ALFA-IDARTNR3  ALFA-IDARTNR  +2 1 A                                        
     ALFA-IDARTNR4  ALFA-IDARTNR  +3 1 A                                        
     ALFA-IDARTNR5  ALFA-IDARTNR  +4 1 A                                        
     ALFA-IDARTNR6  ALFA-IDARTNR  +5 1 A                                        
     ALFA-IDARTNR7  ALFA-IDARTNR  +6 1 A                                        
     ALFA-IDARTNR8  ALFA-IDARTNR  +7 1 A                                        
     ALFA-IDARTNR9  ALFA-IDARTNR  +8 1 A                                        
     ALFA-IDARTNR10 ALFA-IDARTNR  +9 1 A                                        
                                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
* STEG 1. FG                                                                    
*                                                                               
JOB INPUT (W23684D2 KEY (IN2-IDLOPNRM          +                                
                         IN2-IDARTNR           +                                
                         IN2-IDLEVNR)          +                                
           W23684D1 KEY (IN1-IDLOPNRM-PL       +                                
                         IN1-IDARTNR           +                                
                         IN1-IDLEVNR))+                                         
    START (A-INIT)                                                              
 IF MATCHED                                                                     
   NUM-IDARTNR  = 0                                                             
   ALFA-IDARTNR = ' '                                                           
     IF IN1-TIAAMMDD EQ IN2-TIAVIDAT                                            
***  IF IN1-TIAVRDAT-INL > DATUM                                                
***     CONTINUE                                                                
***  ELSE                                                                       
        UT-FILE-TYPE      = 'SPFU5 '                                            
        UT-PLANT          = 'BP2TW'                                             
        UT-IDLEVNR        = IN1-IDLEVNR                                         
        UT-SUP-UNIT       = 0                                                   
        NUM-IDARTNR       = IN1-IDARTNR                                         
        PERFORM S01-FIXA-ARTNR                                                  
        UT-PART-ID        = ALFA-IDARTNR                                        
        WS-TIAAMMDD       = IN1-TIAAMMDD                                        
        UT-DATUM-YYMMDD   = IN1-TIAAMMDD                                        
        WS-AA2 = WS-AA1                                                         
        WS-MM2 = WS-MM1                                                         
        WS-DD2 = WS-DD1                                                         
        UT-ORD-DATE       = WS-DDMMAAAA                                         
        UT-ORDERED        = IN1-KVAVROP                                         
**0427  UT-DELIVERED      = IN1-KVANTMOT-TOT                                    
        UT-DELIVERED      = IN1-KVANTMOT                                        
        UT-STAT           = IN1-STAT                                            
        UT-STAT-DATE      = WS-CCYYMMDD                                         
        UT-STAT-TIME      = WS-TID2                                             
        PUT W23684D3                                                            
***   END-IF                                                                    
     ELSE                                                                       
***   IF IN1-TIAVRDAT-INL <= DATUM                                              
        UT-FILE-TYPE      = 'SPFU5 '                                            
        UT-PLANT          = 'BP2TW'                                             
        UT-IDLEVNR        = IN1-IDLEVNR                                         
        UT-SUP-UNIT       = 0                                                   
        NUM-IDARTNR       = IN1-IDARTNR                                         
        PERFORM S01-FIXA-ARTNR                                                  
        UT-PART-ID        = ALFA-IDARTNR                                        
        WS-TIAAMMDD       = IN2-TIAVIDAT                                        
        UT-DATUM-YYMMDD   = IN2-TIAVIDAT                                        
        WS-AA2 = WS-AA1                                                         
        WS-MM2 = WS-MM1                                                         
        WS-DD2 = WS-DD1                                                         
        UT-ORD-DATE       = WS-DDMMAAAA                                         
        UT-ORDERED        = 0                                                   
        UT-DELIVERED      = IN1-KVANTMOT                                        
        UT-STAT           = IN1-STAT                                            
        UT-STAT-DATE      = WS-CCYYMMDD                                         
        UT-STAT-TIME      = WS-TID2                                             
        PUT W23684D3                                                            
***    END-IF                                                                   
     END-IF                                                                     
 ELSE                                                                           
   NUM-IDARTNR  = 0                                                             
   ALFA-IDARTNR = ' '                                                           
   IF W23684D1                                                                  
      IF IN1-TIAVRDAT-INL = DATUM                                               
        UT-FILE-TYPE        = 'SPFU5 '                                          
        UT-PLANT            = 'BP2TW'                                           
        UT-IDLEVNR          = IN1-IDLEVNR                                       
        UT-SUP-UNIT         = 0                                                 
        NUM-IDARTNR         = IN1-IDARTNR                                       
        PERFORM S01-FIXA-ARTNR                                                  
        UT-PART-ID          = ALFA-IDARTNR                                      
        WS-TIAAMMDD         = IN1-TIAAMMDD                                      
        UT-DATUM-YYMMDD     = IN1-TIAAMMDD                                      
        WS-AA2 = WS-AA1                                                         
        WS-MM2 = WS-MM1                                                         
        WS-DD2 = WS-DD1                                                         
        UT-ORD-DATE         = WS-DDMMAAAA                                       
        UT-ORDERED          = IN1-KVAVROP                                       
**0426  UT-DELIVERED        = IN1-KVANTMOT-TOT                                  
        UT-DELIVERED        = 0                                                 
        UT-STAT             = IN1-STAT                                          
        UT-STAT-DATE        = WS-CCYYMMDD                                       
        UT-STAT-TIME        = WS-TID2                                           
        PUT W23684D3                                                            
     END-IF                                                                     
** ELSE                                                                         
**    UT-FILE-TYPE      = 'SPFU5 '                                              
**    UT-PLANT          = 'BP2TW'                                               
**    UT-IDLEVNR        = IN2-IDLEVNR                                           
**    UT-SUP-UNIT       = 0                                                     
**    NUM-IDARTNR       = IN2-IDARTNR                                           
**    PERFORM S01-FIXA-ARTNR                                                    
**    UT-PART-ID        = ALFA-IDARTNR                                          
**    WS-TIAAMMDD       = IN2-TIAVIDAT                                          
**    UT-DATUM-YYMMDD   = IN2-TIAVIDAT                                          
**    WS-AA2 = WS-AA1                                                           
**    WS-MM2 = WS-MM1                                                           
**    WS-DD2 = WS-DD1                                                           
**    UT-ORD-DATE       = WS-DDMMAAAA                                           
**    UT-ORDERED        = IN2-KVAVIS                                            
**    UT-DELIVERED      = IN2-KVANTMOT                                          
**    UT-STAT           = 'A'                                                   
**    UT-STAT-DATE      = WS-CCYYMMDD                                           
**    UT-STAT-TIME      = WS-TID2                                               
**    PUT W23684D3                                                              
   END-IF                                                                       
 END-IF                                                                         
*                                                                               
A-INIT.  PROC                                                                   
                                                                                
    WS-DATUM               EQ SYSDATE                                           
    WS-TID2                EQ SYSTIME                                           
    DATUM1                 = SYSDATE                                            
    AA22 = AA1                                                                  
    MM22 = MM1                                                                  
    DD22 = DD1                                                                  
    WS-TID2                EQ SYSTIME                                           
    IF WS-TIM1 = ' '                                                            
       MOVE '0' TO WS-TIM1                                                      
    END-IF                                                                      
    IF WS-TIM1 = '0'                                                            
      IF WS-TIM2 = ' '                                                          
         MOVE '0' TO WS-TIM2                                                    
      END-IF                                                                    
    END-IF                                                                      
    IF WS-MIN1 = ' '                                                            
       MOVE '0' TO WS-MIN1                                                      
    END-IF                                                                      
    IF WS-MIN1 = '0'                                                            
      IF WS-MIN2 = ' '                                                          
         MOVE '0' TO WS-MIN2                                                    
      END-IF                                                                    
    END-IF                                                                      
    IF WS-SEK1 = ' '                                                            
       MOVE '0' TO WS-SEK1                                                      
    END-IF                                                                      
    IF WS-SEK1 = '0'                                                            
      IF WS-SEK2 = ' '                                                          
         MOVE '0' TO WS-SEK2                                                    
      END-IF                                                                    
    END-IF                                                                      
    WS-CC   = '20'                                                              
    WS-SS2  = '20'                                                              
    MOVE WS-YEAR TO WS-Y1Y2                                                     
    IF WS-Y1 = ' '                                                              
       MOVE '0' TO WS-Y1                                                        
    END-IF                                                                      
    MOVE WS-Y1Y2 TO WS-YY                                                       
    WS-MM   = WS-MONTH                                                          
    WS-DD   = WS-DAY                                                            
    MOVE WS-Y1Y2 TO WS-YEAR2                                                    
    WS-MONTH2 = WS-MONTH                                                        
    WS-DAY2 = WS-DAY                                                            
    MOVE WS-Y1Y2 TO WS-YEAR3                                                    
    WS-MONTH3 = WS-MONTH                                                        
    WS-DAY3 = WS-DAY                                                            
    WS-STRECK1 = '-'                                                            
    WS-STRECK2 = '-'                                                            
    WS-SNESTR1 = '/'                                                            
    WS-SNESTR2 = '/'                                                            
    WS-KOMMA3 = ':'                                                             
    WS-KOMMA4 = ':'                                                             
END-PROC                                                                        
  S01-FIXA-ARTNR. PROC                                                          
    IF NUM-IDARTNR1 = 0                                                         
      IF NUM-IDARTNR2 = 0                                                       
        IF NUM-IDARTNR3 = 0                                                     
          IF NUM-IDARTNR4 = 0                                                   
            IF NUM-IDARTNR5 = 0                                                 
              IF NUM-IDARTNR6 = 0                                               
                IF NUM-IDARTNR7 = 0                                             
                  IF NUM-IDARTNR8 = 0                                           
                    IF NUM-IDARTNR9 = 0                                         
                      IF NUM-IDARTNR10 = 0                                      
                         ALFA-IDARTNR = ' '                                     
                      ELSE                                                      
                         ALFA-IDARTNR1 = NUM-IDARTNR10                          
                      END-IF                                                    
                    ELSE                                                        
                       ALFA-IDARTNR1 = NUM-IDARTNR9                             
                       ALFA-IDARTNR2 = NUM-IDARTNR10                            
                    END-IF                                                      
                  ELSE                                                          
                     ALFA-IDARTNR1 = NUM-IDARTNR8                               
                     ALFA-IDARTNR2 = NUM-IDARTNR9                               
                     ALFA-IDARTNR3 = NUM-IDARTNR10                              
                  END-IF                                                        
                ELSE                                                            
                   ALFA-IDARTNR1 = NUM-IDARTNR7                                 
                   ALFA-IDARTNR2 = NUM-IDARTNR8                                 
                   ALFA-IDARTNR3 = NUM-IDARTNR9                                 
                   ALFA-IDARTNR4 = NUM-IDARTNR10                                
                END-IF                                                          
              ELSE                                                              
                 ALFA-IDARTNR1 = NUM-IDARTNR6                                   
                 ALFA-IDARTNR2 = NUM-IDARTNR7                                   
                 ALFA-IDARTNR3 = NUM-IDARTNR8                                   
                 ALFA-IDARTNR4 = NUM-IDARTNR9                                   
                 ALFA-IDARTNR5 = NUM-IDARTNR10                                  
              END-IF                                                            
            ELSE                                                                
               ALFA-IDARTNR1 = NUM-IDARTNR5                                     
               ALFA-IDARTNR2 = NUM-IDARTNR6                                     
               ALFA-IDARTNR3 = NUM-IDARTNR7                                     
               ALFA-IDARTNR4 = NUM-IDARTNR8                                     
               ALFA-IDARTNR5 = NUM-IDARTNR9                                     
               ALFA-IDARTNR6 = NUM-IDARTNR10                                    
            END-IF                                                              
          ELSE                                                                  
             ALFA-IDARTNR1 = NUM-IDARTNR4                                       
             ALFA-IDARTNR2 = NUM-IDARTNR5                                       
             ALFA-IDARTNR3 = NUM-IDARTNR6                                       
             ALFA-IDARTNR4 = NUM-IDARTNR7                                       
             ALFA-IDARTNR5 = NUM-IDARTNR8                                       
             ALFA-IDARTNR6 = NUM-IDARTNR9                                       
             ALFA-IDARTNR7 = NUM-IDARTNR10                                      
          END-IF                                                                
        ELSE                                                                    
           ALFA-IDARTNR1 = NUM-IDARTNR3                                         
           ALFA-IDARTNR2 = NUM-IDARTNR4                                         
           ALFA-IDARTNR3 = NUM-IDARTNR5                                         
           ALFA-IDARTNR4 = NUM-IDARTNR6                                         
           ALFA-IDARTNR5 = NUM-IDARTNR7                                         
           ALFA-IDARTNR6 = NUM-IDARTNR8                                         
           ALFA-IDARTNR7 = NUM-IDARTNR9                                         
           ALFA-IDARTNR8 = NUM-IDARTNR10                                        
        END-IF                                                                  
      ELSE                                                                      
         ALFA-IDARTNR1 = NUM-IDARTNR2                                           
         ALFA-IDARTNR2 = NUM-IDARTNR3                                           
         ALFA-IDARTNR3 = NUM-IDARTNR4                                           
         ALFA-IDARTNR4 = NUM-IDARTNR5                                           
         ALFA-IDARTNR5 = NUM-IDARTNR6                                           
         ALFA-IDARTNR6 = NUM-IDARTNR7                                           
         ALFA-IDARTNR7 = NUM-IDARTNR8                                           
         ALFA-IDARTNR8 = NUM-IDARTNR9                                           
         ALFA-IDARTNR9 = NUM-IDARTNR10                                          
      END-IF                                                                    
    ELSE                                                                        
       ALFA-IDARTNR1 = NUM-IDARTNR1                                             
       ALFA-IDARTNR2 = NUM-IDARTNR2                                             
       ALFA-IDARTNR3 = NUM-IDARTNR3                                             
       ALFA-IDARTNR4 = NUM-IDARTNR4                                             
       ALFA-IDARTNR5 = NUM-IDARTNR5                                             
       ALFA-IDARTNR6 = NUM-IDARTNR6                                             
       ALFA-IDARTNR7 = NUM-IDARTNR7                                             
       ALFA-IDARTNR8 = NUM-IDARTNR8                                             
       ALFA-IDARTNR9 = NUM-IDARTNR9                                             
       ALFA-IDARTNR10 = NUM-IDARTNR10                                           
    END-IF                                                                      
  END-PROC                                                                      
                                                                                
