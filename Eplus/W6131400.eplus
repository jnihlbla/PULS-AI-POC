                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6131400                                              *        
*                                                                      *        
*  FUNKTION   :  RÄKNAR FRAM ANTALET SVS-FÖRPACKNINGAR/TYP AV FÖRPACKN.*        
*                                                                      *        
*  FÖRFATTARE :  KENT JEBSEN                                           *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W61314D1                                                                   
%W6131301  'DB-'                                                                
                                                                                
FILE W61314D2                                                                   
%W6131201  'IN-'                                                                
                                                                                
FILE W61314D3 FB(39 0)                                                          
%W6131401  'UT-'                                                                
                                                                                
FILE W61314D4 FB(39 0)                                                          
%W6131401  'D4-'                                                                
                                                                                
FILE W61314D5 VB(60 0)                                                          
LISTA           1   60 A                                                        
LISTA1    LISTA     41 A                                                        
LISTA2    LISTA +41  2 N                                                        
LISTA3    LISTA +43 13 A                                                        
FP-KOD    LISTA     12 A                                                        
FP-BLANK  LISTA      8 A                                                        
KDFORP    LISTA +8   4 A                                                        
MELLAN1   LISTA +12 1 A                                                         
LIST-ST   LISTA +13 7 A                                                         
KVANT-ST  LISTA +13 7 N                                                         
MELLAN2   LISTA +20 1 A                                                         
LIST-28   LISTA +21 7 A                                                         
KVANT-28  LISTA +21 7 N                                                         
MELLAN3   LISTA +28 1 A                                                         
LIST-GR   LISTA +29 7 A                                                         
KVANT-GR  LISTA +29 7 N                                                         
MELLAN4   LISTA +36 1 A                                                         
LIST-MA   LISTA +37 7 A                                                         
KVANT-MA  LISTA +37 7 N                                                         
MELLAN5   LISTA +44 1 A                                                         
LIST-SA   LISTA +45 7 A                                                         
KVANT-SA  LISTA +45 7 N                                                         
MELLAN6   LISTA +52 1 A                                                         
SLASK     LISTA +53 3 A                                                         
                                                                                
%WDATAREA                                                                       
NEWPAGE                                                                         
                                                                                
JA              W 1 A VALUE 'J'                                                 
NEJ             W 1 A VALUE 'N'                                                 
*                                                                               
WDATKONV        W 8 A VALUE 'WDATKONV'                                          
                                                                                
DAGENS-DATUM             W 6 N                                                  
                                                                                
DATUM                    W 8 A                                                  
D-AA         DATUM         2 N                                                  
D-1          DATUM +2      1 A                                                  
D-MM         DATUM +3      2 N                                                  
D-2          DATUM +5      1 A                                                  
D-DD         DATUM +6      2 N                                                  
*                                                                               
DATUM-FIX                W 6 N                                                  
D-AA-FIX  DATUM-FIX        2 N                                                  
D-MM-FIX  DATUM-FIX +2     2 N                                                  
D-DD-FIX  DATUM-FIX +4     2 N                                                  
                                                                                
WS-FLSKRIV               W 1 A                                                  
WS-VECKA                 W 2 N                                                  
WS-KDFORP                W 4 A                                                  
WS-KVANTAL               W 7 N                                                  
WS-KVANTAL-ST            W 7 N                                                  
WS-KVANTAL-28            W 7 N                                                  
WS-KVANTAL-GR            W 7 N                                                  
WS-KVANTAL-MA            W 7 N                                                  
WS-KVANTAL-SA            W 7 N                                                  
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. RÄKNAR FRAM ANTALET FÖRPACKNINGAR AV OLIKA TYPER SOM                  
*         UTFÖRTS PÅ SVS UNDER DEN GÅNGNA VECKAN.                               
*                                                                               
JOB INPUT (W61314D1 KEY(DB-BEFT) W61314D2 KEY(IN-BEFT)) +                       
            FINISH Z-FINIT                                                      
IF MATCHED                                                                      
  D4-KDFORP     = '0000'                                                        
  D4-KVANTAL-ST = 0                                                             
  D4-KVANTAL-28 = 0                                                             
  D4-KVANTAL-GR = 0                                                             
  D4-KVANTAL-MA = 0                                                             
  D4-KVANTAL-SA = 0                                                             
  WS-FLSKRIV = NEJ                                                              
  IF DB-FLFPOMR-SVS = JA                                                        
    IF DB-FLSATSIN = JA                                                         
      WS-KVANTAL = IN-KVINLART                                                  
    ELSE                                                                        
      IF IN-KVINLART < IN-KVAVIS-KIT                                            
        WS-KVANTAL = 0                                                          
      ELSE                                                                      
        WS-KVANTAL = IN-KVINLART - IN-KVAVIS-KIT                                
      END-IF                                                                    
    END-IF                                                                      
    IF DB-REFPCDC > 0                                                           
      WS-KVANTAL = WS-KVANTAL * ((100 - DB-REFPCDC) / 100)                      
    END-IF                                                                      
    IF IN-KVQPACK-1 > 0                                                         
      WS-KVANTAL = WS-KVANTAL / IN-KVQPACK-1                                    
    END-IF                                                                      
    IF DB-FLFPGRP-ST = JA                                                       
      IF IN-KDFORP NE '0000'                                                    
        D4-KVANTAL-ST = WS-KVANTAL                                              
        WS-FLSKRIV = JA                                                         
      END-IF                                                                    
      WS-KVANTAL-ST = WS-KVANTAL-ST + WS-KVANTAL                                
    END-IF                                                                      
    IF DB-FLFPGRP-28 = JA                                                       
      IF IN-KDFORP NE '0000'                                                    
        D4-KVANTAL-28 = WS-KVANTAL                                              
        WS-FLSKRIV = JA                                                         
      END-IF                                                                    
      WS-KVANTAL-28 = WS-KVANTAL-28 + WS-KVANTAL                                
    END-IF                                                                      
    IF DB-FLFPGRP-GR = JA                                                       
      IF IN-KDFORP NE '0000'                                                    
        D4-KVANTAL-GR = WS-KVANTAL                                              
        WS-FLSKRIV = JA                                                         
      END-IF                                                                    
      WS-KVANTAL-GR = WS-KVANTAL-GR + WS-KVANTAL                                
    END-IF                                                                      
    IF DB-FLFPGRP-MA = JA                                                       
      IF IN-KDFORP NE '0000'                                                    
        D4-KVANTAL-MA = WS-KVANTAL                                              
        WS-FLSKRIV = JA                                                         
      END-IF                                                                    
      WS-KVANTAL-MA = WS-KVANTAL-MA + WS-KVANTAL                                
    END-IF                                                                      
    IF DB-FLFPGRP-SA = JA                                                       
      IF IN-KDFORP NE '0000'                                                    
        D4-KVANTAL-SA = WS-KVANTAL                                              
        WS-FLSKRIV = JA                                                         
      END-IF                                                                    
      WS-KVANTAL-SA = WS-KVANTAL-SA + WS-KVANTAL                                
    END-IF                                                                      
    IF WS-FLSKRIV = JA                                                          
      D4-KDFORP = IN-KDFORP                                                     
      PUT W61314D4                                                              
      UT-W6131401 = D4-W6131401                                                 
      PUT W61314D3                                                              
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
                                                                                
Z-FINIT. PROC                                                                   
   D4-KDFORP     = '0000'                                                       
   D4-KVANTAL-ST = WS-KVANTAL-ST                                                
   D4-KVANTAL-28 = WS-KVANTAL-28                                                
   D4-KVANTAL-GR = WS-KVANTAL-GR                                                
   D4-KVANTAL-MA = WS-KVANTAL-MA                                                
   D4-KVANTAL-SA = WS-KVANTAL-SA                                                
   PUT W61314D4                                                                 
   UT-W6131401 = D4-W6131401                                                    
   PUT W61314D3                                                                 
END-PROC                                                                        
                                                                                
SORT W61314D4 TO W61314D4 USING (D4-KDFORP)                                     
                                                                                
JOB INPUT W61314D4 START A-INIT FINISH Z-FINIT                                  
                                                                                
IF RECORD-COUNT = 1                                                             
  WS-KDFORP     = '    '                                                        
  WS-KVANTAL-ST = D4-KVANTAL-ST                                                 
  WS-KVANTAL-28 = D4-KVANTAL-28                                                 
  WS-KVANTAL-GR = D4-KVANTAL-GR                                                 
  WS-KVANTAL-MA = D4-KVANTAL-MA                                                 
  WS-KVANTAL-SA = D4-KVANTAL-SA                                                 
ELSE                                                                            
  IF WS-KDFORP = D4-KDFORP                                                      
    WS-KVANTAL-ST = WS-KVANTAL-ST + D4-KVANTAL-ST                               
    WS-KVANTAL-28 = WS-KVANTAL-28 + D4-KVANTAL-28                               
    WS-KVANTAL-GR = WS-KVANTAL-GR + D4-KVANTAL-GR                               
    WS-KVANTAL-MA = WS-KVANTAL-MA + D4-KVANTAL-MA                               
    WS-KVANTAL-SA = WS-KVANTAL-SA + D4-KVANTAL-SA                               
  ELSE                                                                          
    KDFORP   = WS-KDFORP                                                        
    KVANT-ST = WS-KVANTAL-ST                                                    
    KVANT-28 = WS-KVANTAL-28                                                    
    KVANT-GR = WS-KVANTAL-GR                                                    
    KVANT-MA = WS-KVANTAL-MA                                                    
    KVANT-SA = WS-KVANTAL-SA                                                    
    PUT W61314D5                                                                
    WS-KDFORP     = D4-KDFORP                                                   
    WS-KVANTAL-ST = D4-KVANTAL-ST                                               
    WS-KVANTAL-28 = D4-KVANTAL-28                                               
    WS-KVANTAL-GR = D4-KVANTAL-GR                                               
    WS-KVANTAL-MA = D4-KVANTAL-MA                                               
    WS-KVANTAL-SA = D4-KVANTAL-SA                                               
  END-IF                                                                        
END-IF                                                                          
                                                                                
A-INIT. PROC                                                                    
                                                                                
  DATUM         = SYSDATE                                                       
  D-AA-FIX      = D-AA                                                          
  D-MM-FIX      = D-MM                                                          
  D-DD-FIX      = D-DD                                                          
  DAGENS-DATUM  = DATUM-FIX                                                     
                                                                                
  DAT-KDDATFORM = 'AAMMDD'                                                      
  DAT-I-TIDATUM = DAGENS-DATUM                                                  
                                                                                
  CALL WDATKONV USING (DAT-KDDATFORM, +                                         
                       DAT-I-TIDATUM, +                                         
                       DAT-O-TIDATUM, +                                         
                       DAT-KDSVAR)                                              
                                                                                
  IF DAT-KDSVAR = ' '                                                           
    WS-VECKA      = DAT-TIVV                                                    
  ELSE                                                                          
    DISPLAY 'FEL FRÅN DATKONV'                                                  
    STOP EXECUTE                                                                
  END-IF                                                                        
                                                                                
   LISTA1      = 'W61314-001 ANTAL SVS-FÖRPACKNINGAR VECKA '                    
   LISTA2      = WS-VECKA                                                       
   LISTA3      = '             '                                                
   PUT W61314D5                                                                 
                                                                                
   FP-KOD  = 'VARAV FP-KOD'                                                     
   MELLAN1 = ';'                                                                
   LIST-ST = 'STYCK  '                                                          
   MELLAN2 = ';'                                                                
   LIST-28 = '28     '                                                          
   MELLAN3 = ';'                                                                
   LIST-GR = 'GROV   '                                                          
   MELLAN4 = ';'                                                                
   LIST-MA = 'MASKIN '                                                          
   MELLAN5 = ';'                                                                
   LIST-SA = 'SATS   '                                                          
   MELLAN6 = ';'                                                                
   SLASK    = '   '                                                             
   PUT W61314D5                                                                 
   FP-BLANK = '        '                                                        
END-PROC                                                                        
                                                                                
Z-FINIT. PROC                                                                   
   KDFORP   = WS-KDFORP                                                         
   KVANT-ST = WS-KVANTAL-ST                                                     
   KVANT-28 = WS-KVANTAL-28                                                     
   KVANT-GR = WS-KVANTAL-GR                                                     
   KVANT-MA = WS-KVANTAL-MA                                                     
   KVANT-SA = WS-KVANTAL-SA                                                     
   PUT W61314D5                                                                 
END-PROC                                                                        
