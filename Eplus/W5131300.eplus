*----------------------------------------------------------------------*        
FILE W51313D1                                                                   
*                                                                               
%W51310   'INV-'                                                                
INV-AAAA    6 4 N                                                               
                                                                                
FILE TPFIL1   FB(28 0)                                                          
%W51310   'TP1-'                                                                
TP1-AAAA    6 4 N                                                               
                                                                                
FILE TPFIL2   FB(28 0)                                                          
%W51310   'TP2-'                                                                
TP2-AAAA    6 4 N                                                               
                                                                                
                                                                                
FILE W51313D3 PRINTER FB (126 0)                                                
 UT-POST          W 125 A                                                       
*UT-POST UT-FILE  W 125 A                                                       
*                                                                               
FILE W51313D4 FB (60 0)                                                         
%W51315  'DAP-'                                                                 
*                                                                               
*                                                                               
********************************************************                        
* ARBETS-AREOR                                         *                        
********************************************************                        
*                                                                               
PROGRAM-NAMN           W   8   A        VALUE 'W5131300'                        
DATUMKORT-ID           W   6   A        VALUE 'WDATUM'                          
%WDATKORT                                                                       
W-RUBRIK1                 W 125   A                                             
W-RUB1-LINE01 W-RUBRIK1           8   A VALUE 'W51313-0'                        
W-RUB1-IDDC   W-RUBRIK1    +8     2   A                                         
W-RUB1-LINE02 W-RUBRIK1    +19    8   A VALUE 'VCCS'                            
W-RUB1-LINE03 W-RUBRIK1    +39   22   A VALUE 'WEEKLY REPORT PER AREA'          
W-RUB1-LINE04 W-RUBRIK1    +90    3   A VALUE 'DC:'                             
W-RUB1-IDDC1  W-RUBRIK1    +93    2   A                                         
W-RUB1-LINE05 W-RUBRIK1    +100   5   A VALUE 'DATE:'                           
W-RUB1-DATE   W-RUBRIK1    +105   6   N                                         
W-RUB1-LINE06 W-RUBRIK1    +112   5   A VALUE 'WEEK:'                           
W-RUB1-WEEK   W-RUBRIK1    +118   2   N                                         
                                                                                
W-RUBRIK2                 W 125   A                                             
W-RUB2-LINE01 W-RUBRIK2         111   A VALUE             +                     
  '                  ADJUSTED (STDPRICE) IN TKR           +                     
   DIFF IN % OF         DIFFERENCE AGAINST LAST YEAR       '                    
                                                                                
W-RUBRIK3                 W 125   A                                             
W-RUB3-LINE01 W-RUBRIK3         104   A VALUE                   +               
  'AREA         THIS WEEK   WEEK AVERAGE      THIS YEAR         +               
                         SALES            TKR              %    '               
                                                                                
W-LINE1                        W 125   A                                        
L1-ADLAGOMR            W-LINE1     2   A                                        
L1-KVADJ-THIS-UP       W-LINE1 +4   11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L1-KVADJ-AVE-UP        W-LINE1 +19  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L1-KVADJ-YEAR-UP       W-LINE1 +34  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L1-SALES-DIFF-UP       W-LINE1 +49  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L1-KVADJ-DIFF-UP       W-LINE1 +64  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L1-KVADJ-DIFF-UP-PROC  W-LINE1 +79  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
                                                                                
W-LINE2                        W 125   A                                        
L2-TEXT                W-LINE2     4   A VALUE '    '                           
L2-KVADJ-THIS-DW       W-LINE2 +4   11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L2-KVADJ-AVE-DW        W-LINE2 +19  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L2-KVADJ-YEAR-DW       W-LINE2 +34  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L2-SALES-DIFF-DW       W-LINE2 +49  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L2-KVADJ-DIFF-DW       W-LINE2 +64  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L2-KVADJ-DIFF-DW-PROC  W-LINE2 +79  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
                                                                                
W-LINE3                        W 125   A                                        
L3-TEXT                W-LINE3     4   A VALUE '    '                           
L3-KVADJ-THIS-NET      W-LINE3 +4   11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L3-KVADJ-AVE-NET       W-LINE3 +19  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L3-KVADJ-YEAR-NET      W-LINE3 +34  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L3-SALES-DIFF-NET      W-LINE3 +49  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L3-KVADJ-DIFF-NET      W-LINE3 +64  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
L3-KVADJ-DIFF-NET-PROC W-LINE3 +79  11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'         
                                                                                
PR-NIVA                W   4   A                                                
WS-PR-ADLAGOMR         W   2   A                                                
PR-ADLAGOMR            W   4   A                                                
PR-KVADJ-THIS-UP       W   11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'                  
PR-KVADJ-AVE-UP        W   11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'                  
PR-KVADJ-YEAR-UP       W   11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'                  
PR-SALES-DIFF-UP       W   11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'                  
PR-KVADJ-DIFF-UP       W   11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'                  
PR-KVADJ-DIFF-UP-PROC  W   11 N 2 VALUE 0 MASK 'ZZZZZZZZ9,99-'                  
                                                                                
                                                                                
                                                                                
                                                                                
WS-AAAAVV            W   6  N                                                   
WS-AAAA WS-AAAAVV        4  N                                                   
                                                                                
* ÅRETS DATUM                                                                   
W-AKT-AAAAVV           W   6  N                                                 
AKT-AA  W-AKT-AAAAVV       2  N                                                 
AKT-AAR W-AKT-AAAAVV  +2   2  N                                                 
AKT-VV  W-AKT-AAAAVV  +4   2  N                                                 
AKT-AAAA W-AKT-AAAAVV      4  N                                                 
                                                                                
** DATUM FÖRRA ÅRET                                                             
W-AAAAVV-F              W   6  N                                                
AKT-AA-F   W-AAAAVV-F       2  N                                                
AKT-AAR-F  W-AAAAVV-F  +2   2  N                                                
AKT-VV-F   W-AAAAVV-F  +4   2  N                                                
AKT-AAAA-F W-AAAAVV-F       4  N                                                
                                                                                
W-IDDC           W  2   A                                                       
W-IDPTYP         W  3   A                                                       
W-DAVVREG        W  6   N                                                       
W-ADLAGOMR       W  2   N                                                       
                                                                                
W-DATUM              W   6  N                                                   
W-AA     W-DATUM         2  N                                                   
W-MANAD  W-DATUM     +2  2  N                                                   
W-DAG    W-DATUM     +4  2  N                                                   
                                                                                
W-ANTAL-POSTER       W  6   N VALUE 0                                           
W-ANTAL-POSTER-002   W  6   N VALUE 0                                           
W-ANTAL-POSTER-003   W  6   N VALUE 0                                           
                                                                                
W-KVADJ-THIS-UP  W   6 P  2 VALUE 0                                             
W-KVADJ-THIS-DW  W   6 P  2 VALUE 0                                             
W-KVADJ-THIS-NET W   6 P  2 VALUE 0                                             
                                                                                
W-KVADJ-AVE-UP   W   6 P  2 VALUE 0                                             
W-KVADJ-AVE-DW   W   6 P  2 VALUE 0                                             
W-KVADJ-AVE-NET  W   6 P  2 VALUE 0                                             
                                                                                
W-KVADJ-YEAR-UP  W   6 P  2 VALUE 0                                             
W-KVADJ-YEAR-DW  W   6 P  2 VALUE 0                                             
W-KVADJ-YEAR-NET W   6 P  2 VALUE 0                                             
                                                                                
W-KVADJ-LAST-UP  W   6 P  2 VALUE 0                                             
W-KVADJ-LAST-DW  W   6 P  2 VALUE 0                                             
W-KVADJ-LAST-NET W   6 P  2 VALUE 0                                             
                                                                                
W-KVADJ-DIFF-UP  W   6 P  2 VALUE 0                                             
W-KVADJ-DIFF-DW  W   6 P  2 VALUE 0                                             
W-KVADJ-DIFF-NET W   6 P  2 VALUE 0                                             
                                                                                
W-SALES-DIFF-UP  W   6 P  2 VALUE 0                                             
W-SALES-DIFF-DW  W   6 P  2 VALUE 0                                             
W-SALES-DIFF-NET W   6 P  2 VALUE 0                                             
                                                                                
W-KVADJ-DIFF-UP-PROC  W   6 P  2 VALUE 0                                        
W-KVADJ-DIFF-NET-PROC W   6 P  2 VALUE 0                                        
W-KVADJ-DIFF-DW-PROC  W   6 P  2 VALUE 0                                        
                                                                                
W-KVADJ-THIS-UP-TOT  W   6 P  2 VALUE 0                                         
W-KVADJ-THIS-DW-TOT  W   6 P  2 VALUE 0                                         
W-KVADJ-THIS-NET-TOT W   6 P  2 VALUE 0                                         
                                                                                
W-KVADJ-AVE-UP-TOT   W   6 P  2 VALUE 0                                         
W-KVADJ-AVE-DW-TOT   W   6 P  2 VALUE 0                                         
W-KVADJ-AVE-NET-TOT  W   6 P  2 VALUE 0                                         
                                                                                
W-KVADJ-YEAR-UP-TOT  W   6 P  2 VALUE 0                                         
W-KVADJ-YEAR-DW-TOT  W   6 P  2 VALUE 0                                         
W-KVADJ-YEAR-NET-TOT W   6 P  2 VALUE 0                                         
                                                                                
W-SALES-DIFF-UP-TOT  W   6 P  2 VALUE 0                                         
W-SALES-DIFF-DW-TOT  W   6 P  2 VALUE 0                                         
W-SALES-DIFF-NET-TOT W   6 P  2 VALUE 0                                         
                                                                                
W-KVADJ-DIFF-UP-TOT  W   6 P  2 VALUE 0                                         
W-KVADJ-DIFF-DW-TOT  W   6 P  2 VALUE 0                                         
W-KVADJ-DIFF-NET-TOT W   6 P  2 VALUE 0                                         
                                                                                
W-KVADJ-DIFF-UP-PROC-T  W   6 P  2 VALUE 0                                      
W-KVADJ-DIFF-NET-PROC-T W   6 P  2 VALUE 0                                      
W-KVADJ-DIFF-DW-PROC-T  W   6 P  2 VALUE 0                                      
                                                                                
W-KVADJ-LAST-UP-TOT     W   6 P  2 VALUE 0                                      
W-KVADJ-LAST-NET-TOT    W   6 P  2 VALUE 0                                      
W-KVADJ-LAST-DW-TOT     W   6 P  2 VALUE 0                                      
                                                                                
W-SUARTFSG         W   6 P  2                                                   
W-SUARTFSG-LAST    W   6 P  2                                                   
W-SUARTFSG-TOT     W   6 P  2                                                   
                                                                                
W-FORSTA-POST  W 1 A                                                            
                                                                                
*------------*                                                                  
*  JOB1 SORT *                                                                  
*------------*                                                                  
                                                                                
SORT W51313D1 TO TPFIL1 USING (INV-DAVVREG INV-IDDC INV-ADLAGOMR +              
                         INV-IDPTYP)                                            
                                                                                
*-------------------------------------------------------------*                 
*  JOB2 HITTA ALLA POSTER IFRÅN FÖRRA ÅRET OCH VECKA FRAM TILL NU               
*  OCH SEDAN IHOP ALLA ÅRETS POSTER                                             
*  SKAPA TP2FIL                                               *                 
*-------------------------------------------------------------*                 
JOB INPUT TPFIL1  START A-INIT                                                  
** FÖRRA ÅRETS POSTER                                                           
 IF TP1-IDDC NE '11'                                                            
  IF TP1-AAAA  EQ AKT-AAAA-F                                                    
    IF TP1-DAVVREG <=  W-AAAAVV-F                                               
      TP2-W51310 EQ TP1-W51310                                                  
      PUT TPFIL2                                                                
    END-IF                                                                      
  ELSE                                                                          
** ÅRETS POSTER                                                                 
    IF TP1-AAAA  EQ AKT-AAAA                                                    
      IF TP1-DAVVREG <=  W-AKT-AAAAVV                                           
        TP2-W51310 EQ TP1-W51310                                                
        PUT TPFIL2                                                              
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
 END-IF                                                                         
A-INIT. PROC                                                                    
                                                                                
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                      
  AKT-AA       =   20                                                           
  AKT-AAR      =   D-AAR                                                        
  AKT-VV       =   D-VECKA                                                      
                                                                                
  AKT-AA-F     =   20                                                           
  AKT-AAR-F    =   AKT-AAR - 1                                                  
  AKT-VV-F     =   D-VECKA                                                      
                                                                                
  W-RUB1-WEEK  =   AKT-VV                                                       
  W-AA         =   D-AAR                                                        
  W-MANAD      =   D-MAANAD                                                     
  W-DAG        =   D-DAG                                                        
  W-RUB1-DATE  =   W-DATUM                                                      
                                                                                
  DISPLAY 'ÅRETS ' W-AKT-AAAAVV                                                 
  DISPLAY 'FÖRRA ' W-AAAAVV-F                                                   
END-PROC                                                                        
*------------*                                                                  
*  JOB3 SORT *                                                                  
*------------*                                                                  
                                                                                
 SORT TPFIL2 TO TPFIL2 USING (TP2-IDDC TP2-ADLAGOMR TP2-DAVVREG +               
                          TP2-IDPTYP)                                           
*-------------------------------------------------------*                       
*  JOB5 SUMMERAR IHOP POSTER                                                    
*-------------------------------------------------------*                       
 JOB INPUT TPFIL2 START AA-INIT FINISH Z-FIN                                    
                                                                                
   IF W-FORSTA-POST = 'J'                                                       
     W-IDPTYP      = TP2-IDPTYP                                                 
     W-IDDC        = TP2-IDDC                                                   
     W-DAVVREG     = TP2-DAVVREG                                                
     WS-AAAAVV     = TP2-DAVVREG                                                
     W-ADLAGOMR       = TP2-ADLAGOMR                                            
     WS-PR-ADLAGOMR   = TP2-ADLAGOMR                                            
     W-RUB1-IDDC     EQ W-IDDC                                                  
     W-RUB1-IDDC1    EQ W-IDDC                                                  
     PERFORM B-KOLLA-IDPTYP                                                     
     W-FORSTA-POST = 'N'                                                        
   ELSE                                                                         
     IF W-IDDC EQ TP2-IDDC AND TP2-AAAA EQ WS-AAAA AND +                        
        W-ADLAGOMR EQ TP2-ADLAGOMR                                              
        PERFORM B-KOLLA-IDPTYP                                                  
     ELSE                                                                       
      IF TP2-AAAA NE AKT-AAAA                                                   
        PERFORM E-SUMMERA-RADER                                                 
                                                                                
        WS-PR-ADLAGOMR  EQ W-ADLAGOMR                                           
        DAP-ADLAGOMR    EQ W-ADLAGOMR                                           
                                                                                
        PERFORM D-SKRIV-RADER                                                   
        PERFORM DA-SKRIV-RADER-DAP                                              
* NYA RUBRIKER                                                                  
        IF W-IDDC NE TP2-IDDC                                                   
* BERÄKNA TOTALER                                                               
          PERFORM EA-SUMMERA-TOTALER                                            
          WS-PR-ADLAGOMR = '  '                                                 
          PR-ADLAGOMR = 'TOT '                                                  
          DAP-ADLAGOMR = 'TOT '                                                 
          PERFORM D-SKRIV-RADER                                                 
          PERFORM DA-SKRIV-RADER-DAP                                            
                                                                                
          W-RUB1-IDDC  EQ TP2-IDDC                                              
          W-RUB1-IDDC1 EQ TP2-IDDC                                              
        END-IF                                                                  
        PERFORM C-NOLLA                                                         
      ELSE                                                                      
        IF TP2-ADLAGOMR NE W-ADLAGOMR                                           
          PERFORM E-SUMMERA-RADER                                               
          WS-PR-ADLAGOMR   EQ W-ADLAGOMR                                        
          DAP-ADLAGOMR     EQ W-ADLAGOMR                                        
          PERFORM D-SKRIV-RADER                                                 
          PERFORM DA-SKRIV-RADER-DAP                                            
          IF W-IDDC NE TP2-IDDC                                                 
* BERÄKNA TOTALER                                                               
            PERFORM EA-SUMMERA-TOTALER                                          
            WS-PR-ADLAGOMR = '  '                                               
            PR-ADLAGOMR = 'TOT '                                                
            DAP-ADLAGOMR = 'TOT '                                               
                                                                                
            PERFORM D-SKRIV-RADER                                               
            PERFORM DA-SKRIV-RADER-DAP                                          
                                                                                
            W-RUB1-IDDC  EQ TP2-IDDC                                            
            W-RUB1-IDDC1 EQ TP2-IDDC                                            
          END-IF                                                                
          PERFORM C-NOLLA                                                       
        ELSE                                                                    
          PERFORM B-KOLLA-IDPTYP                                                
        END-IF                                                                  
      END-IF                                                                    
     END-IF                                                                     
   END-IF                                                                       
                                                                                
 AA-INIT. PROC                                                                  
   W-IDPTYP      = '000'                                                        
   W-IDDC        = '  '                                                         
   W-DAVVREG     = 0                                                            
   W-ADLAGOMR    = 0                                                            
   W-ANTAL-POSTER = 0                                                           
   W-FORSTA-POST = 'J'                                                          
 END-PROC                                                                       
                                                                                
 B-KOLLA-IDPTYP. PROC                                                           
   IF TP2-IDPTYP = '001'                                                        
    IF AKT-AAAA-F   = TP2-AAAA                                                  
     W-SUARTFSG-LAST  = W-SUARTFSG-LAST + TP2-SUARTSTD                          
    ELSE                                                                        
     W-SUARTFSG              = W-SUARTFSG     + TP2-SUARTSTD                    
     W-SUARTFSG-TOT          = W-SUARTFSG-TOT + TP2-SUARTSTD                    
    END-IF                                                                      
   END-IF                                                                       
                                                                                
   IF TP2-IDPTYP = '002'                                                        
    IF AKT-AAAA-F = TP2-AAAA                                                    
       W-KVADJ-LAST-UP       = W-KVADJ-LAST-UP  + TP2-SUARTSTD                  
       W-KVADJ-LAST-NET      = W-KVADJ-LAST-NET + TP2-SUARTSTD                  
       W-KVADJ-LAST-UP-TOT = W-KVADJ-LAST-UP-TOT  + TP2-SUARTSTD                
       W-KVADJ-LAST-NET-TOT = W-KVADJ-LAST-NET-TOT + TP2-SUARTSTD               
    ELSE                                                                        
     IF W-AKT-AAAAVV EQ TP2-DAVVREG                                             
       W-KVADJ-THIS-UP      = W-KVADJ-THIS-UP      + TP2-SUARTSTD               
       W-KVADJ-THIS-NET     = W-KVADJ-THIS-NET     + TP2-SUARTSTD               
       W-KVADJ-THIS-UP-TOT  = W-KVADJ-THIS-UP-TOT  + TP2-SUARTSTD               
       W-KVADJ-THIS-NET-TOT = W-KVADJ-THIS-NET-TOT + TP2-SUARTSTD               
     END-IF                                                                     
                                                                                
     W-KVADJ-AVE-UP         = W-KVADJ-AVE-UP   + TP2-SUARTSTD                   
     W-KVADJ-AVE-NET        = W-KVADJ-AVE-NET  + TP2-SUARTSTD                   
     W-KVADJ-YEAR-UP        = W-KVADJ-YEAR-UP  + TP2-SUARTSTD                   
     W-KVADJ-YEAR-NET       = W-KVADJ-YEAR-NET + TP2-SUARTSTD                   
                                                                                
     W-KVADJ-AVE-UP-TOT     = W-KVADJ-AVE-UP-TOT   + TP2-SUARTSTD               
     W-KVADJ-AVE-NET-TOT    = W-KVADJ-AVE-NET-TOT  + TP2-SUARTSTD               
     W-KVADJ-YEAR-UP-TOT    = W-KVADJ-YEAR-UP-TOT  + TP2-SUARTSTD               
     W-KVADJ-YEAR-NET-TOT   = W-KVADJ-YEAR-NET-TOT + TP2-SUARTSTD               
    END-IF                                                                      
   END-IF                                                                       
                                                                                
   IF TP2-IDPTYP = '003'                                                        
    IF AKT-AAAA-F = TP2-AAAA                                                    
       W-KVADJ-LAST-DW       = W-KVADJ-LAST-DW  + TP2-SUARTSTD                  
       W-KVADJ-LAST-NET      = W-KVADJ-LAST-NET - TP2-SUARTSTD                  
       W-KVADJ-LAST-DW-TOT = W-KVADJ-LAST-DW-TOT  + TP2-SUARTSTD                
       W-KVADJ-LAST-NET-TOT = W-KVADJ-LAST-NET-TOT - TP2-SUARTSTD               
    ELSE                                                                        
     IF W-AKT-AAAAVV EQ TP2-DAVVREG                                             
       W-KVADJ-THIS-DW       = W-KVADJ-THIS-DW  + TP2-SUARTSTD                  
       W-KVADJ-THIS-NET      = W-KVADJ-THIS-NET - TP2-SUARTSTD                  
       W-KVADJ-THIS-DW-TOT = W-KVADJ-THIS-DW-TOT  + TP2-SUARTSTD                
       W-KVADJ-THIS-NET-TOT = W-KVADJ-THIS-NET-TOT - TP2-SUARTSTD               
     END-IF                                                                     
                                                                                
     W-KVADJ-AVE-DW         = W-KVADJ-AVE-DW   + TP2-SUARTSTD                   
     W-KVADJ-AVE-NET        = W-KVADJ-AVE-NET  - TP2-SUARTSTD                   
     W-KVADJ-YEAR-DW        = W-KVADJ-YEAR-DW  + TP2-SUARTSTD                   
     W-KVADJ-YEAR-NET       = W-KVADJ-YEAR-NET - TP2-SUARTSTD                   
                                                                                
     W-KVADJ-AVE-DW-TOT     = W-KVADJ-AVE-DW-TOT   + TP2-SUARTSTD               
     W-KVADJ-AVE-NET-TOT    = W-KVADJ-AVE-NET-TOT  - TP2-SUARTSTD               
     W-KVADJ-YEAR-DW-TOT    = W-KVADJ-YEAR-DW-TOT  + TP2-SUARTSTD               
     W-KVADJ-YEAR-NET-TOT   = W-KVADJ-YEAR-NET-TOT - TP2-SUARTSTD               
    END-IF                                                                      
   END-IF                                                                       
                                                                                
 END-PROC                                                                       
 C-NOLLA. PROC                                                                  
   W-KVADJ-THIS-UP   = 0                                                        
   W-KVADJ-AVE-UP    = 0                                                        
   W-KVADJ-YEAR-UP   = 0                                                        
                                                                                
   W-KVADJ-THIS-NET  = 0                                                        
   W-KVADJ-AVE-NET   = 0                                                        
   W-KVADJ-YEAR-NET  = 0                                                        
                                                                                
   W-KVADJ-THIS-DW   = 0                                                        
   W-KVADJ-AVE-DW    = 0                                                        
   W-KVADJ-YEAR-DW   = 0                                                        
                                                                                
   W-KVADJ-LAST-UP   = 0                                                        
   W-KVADJ-LAST-NET  = 0                                                        
   W-KVADJ-LAST-DW   = 0                                                        
                                                                                
   W-SALES-DIFF-UP   = 0                                                        
   W-SALES-DIFF-NET  = 0                                                        
   W-SALES-DIFF-DW   = 0                                                        
                                                                                
   W-SUARTFSG-LAST   = 0                                                        
   W-SUARTFSG        = 0                                                        
                                                                                
                                                                                
   IF TP2-IDDC NE W-IDDC                                                        
     W-KVADJ-THIS-UP-TOT  = 0                                                   
     W-KVADJ-THIS-DW-TOT  = 0                                                   
     W-KVADJ-THIS-NET-TOT = 0                                                   
                                                                                
     W-KVADJ-AVE-UP-TOT   = 0                                                   
     W-KVADJ-AVE-DW-TOT   = 0                                                   
     W-KVADJ-AVE-NET-TOT  = 0                                                   
                                                                                
     W-KVADJ-YEAR-UP-TOT  = 0                                                   
     W-KVADJ-YEAR-DW-TOT  = 0                                                   
     W-KVADJ-YEAR-NET-TOT = 0                                                   
                                                                                
     W-KVADJ-LAST-UP-TOT  = 0                                                   
     W-KVADJ-LAST-NET-TOT = 0                                                   
     W-KVADJ-LAST-DW-TOT  = 0                                                   
                                                                                
     W-KVADJ-DIFF-UP-TOT  = 0                                                   
     W-KVADJ-DIFF-NET-TOT = 0                                                   
     W-KVADJ-DIFF-DW-TOT  = 0                                                   
                                                                                
     W-SUARTFSG-TOT       = 0                                                   
   END-IF                                                                       
                                                                                
   IF TP2-IDPTYP = '001'                                                        
    IF AKT-AAAA-F = TP2-AAAA                                                    
     W-SUARTFSG-LAST = TP2-SUARTSTD                                             
    ELSE                                                                        
     W-SUARTFSG      = TP2-SUARTSTD                                             
     W-SUARTFSG-TOT  = W-SUARTFSG-TOT + TP2-SUARTSTD                            
    END-IF                                                                      
*    W-ANTAL-POSTER    = 0                                                      
   END-IF                                                                       
                                                                                
   IF TP2-IDPTYP = '002'                                                        
    IF AKT-AAAA-F = TP2-AAAA                                                    
     W-KVADJ-LAST-UP   = TP2-SUARTSTD                                           
     W-KVADJ-LAST-NET  = TP2-SUARTSTD                                           
     W-KVADJ-LAST-UP-TOT   = W-KVADJ-LAST-UP-TOT  + TP2-SUARTSTD                
     W-KVADJ-LAST-NET-TOT  = W-KVADJ-LAST-NET-TOT + TP2-SUARTSTD                
    ELSE                                                                        
     W-KVADJ-THIS-UP   = TP2-SUARTSTD                                           
     W-KVADJ-AVE-UP    = TP2-SUARTSTD                                           
     W-KVADJ-YEAR-UP   = TP2-SUARTSTD                                           
     W-KVADJ-THIS-NET  = TP2-SUARTSTD                                           
     W-KVADJ-AVE-NET   = TP2-SUARTSTD                                           
     W-KVADJ-YEAR-NET  = TP2-SUARTSTD                                           
                                                                                
     W-KVADJ-THIS-UP-TOT  = W-KVADJ-THIS-UP-TOT  + TP2-SUARTSTD                 
     W-KVADJ-AVE-UP-TOT   = W-KVADJ-AVE-UP-TOT   + TP2-SUARTSTD                 
     W-KVADJ-YEAR-UP-TOT  = W-KVADJ-YEAR-UP-TOT  + TP2-SUARTSTD                 
     W-KVADJ-THIS-NET-TOT = W-KVADJ-THIS-NET-TOT + TP2-SUARTSTD                 
     W-KVADJ-AVE-NET-TOT  = W-KVADJ-AVE-NET-TOT  + TP2-SUARTSTD                 
     W-KVADJ-YEAR-NET-TOT = W-KVADJ-YEAR-NET-TOT + TP2-SUARTSTD                 
    END-IF                                                                      
   END-IF                                                                       
                                                                                
   IF TP2-IDPTYP = '003'                                                        
    IF AKT-AAAA-F = TP2-AAAA                                                    
     W-KVADJ-LAST-DW   = TP2-SUARTSTD                                           
     W-KVADJ-LAST-NET  = TP2-SUARTSTD                                           
                                                                                
     W-KVADJ-LAST-DW-TOT   = W-KVADJ-LAST-UP-TOT  + TP2-SUARTSTD                
     W-KVADJ-LAST-NET-TOT  = W-KVADJ-LAST-NET-TOT - TP2-SUARTSTD                
                                                                                
    ELSE                                                                        
     W-KVADJ-THIS-DW   = TP2-SUARTSTD                                           
     W-KVADJ-AVE-DW    = TP2-SUARTSTD                                           
     W-KVADJ-YEAR-DW   = TP2-SUARTSTD                                           
     W-KVADJ-THIS-NET  = TP2-SUARTSTD                                           
     W-KVADJ-AVE-NET   = TP2-SUARTSTD                                           
     W-KVADJ-YEAR-NET  = TP2-SUARTSTD                                           
                                                                                
     W-KVADJ-THIS-DW-TOT  = W-KVADJ-THIS-DW-TOT  + TP2-SUARTSTD                 
     W-KVADJ-AVE-DW-TOT   = W-KVADJ-AVE-DW-TOT   + TP2-SUARTSTD                 
     W-KVADJ-YEAR-DW-TOT  = W-KVADJ-YEAR-DW-TOT  + TP2-SUARTSTD                 
                                                                                
     W-KVADJ-THIS-NET-TOT = W-KVADJ-THIS-NET-TOT - TP2-SUARTSTD                 
     W-KVADJ-AVE-NET-TOT  = W-KVADJ-AVE-NET-TOT  - TP2-SUARTSTD                 
     W-KVADJ-YEAR-NET-TOT = W-KVADJ-YEAR-NET-TOT - TP2-SUARTSTD                 
    END-IF                                                                      
   END-IF                                                                       
   W-IDDC       EQ TP2-IDDC                                                     
   W-RUB1-IDDC  EQ TP2-IDDC                                                     
   W-RUB1-IDDC1 EQ TP2-IDDC                                                     
   WS-AAAAVV  EQ TP2-DAVVREG                                                    
   W-DAVVREG  EQ TP2-DAVVREG                                                    
   W-ADLAGOMR EQ TP2-ADLAGOMR                                                   
   W-IDPTYP   EQ TP2-IDPTYP                                                     
                                                                                
 END-PROC                                                                       
 D-SKRIV-RADER. PROC                                                            
     PR-NIVA                = '  UP'                                            
     IF WS-PR-ADLAGOMR NE '  '                                                  
       PR-ADLAGOMR          = WS-PR-ADLAGOMR                                    
     END-IF                                                                     
     PR-KVADJ-THIS-UP       = L1-KVADJ-THIS-UP / 1000                           
     PR-KVADJ-AVE-UP        = L1-KVADJ-AVE-UP / 1000                            
     PR-KVADJ-YEAR-UP       = L1-KVADJ-YEAR-UP / 1000                           
     PR-SALES-DIFF-UP       = L1-SALES-DIFF-UP                                  
     PR-KVADJ-DIFF-UP       = L1-KVADJ-DIFF-UP  / 1000                          
     PR-KVADJ-DIFF-UP-PROC  = L1-KVADJ-DIFF-UP-PROC                             
                                                                                
     PRINT RAPPORT01                                                            
                                                                                
     PR-NIVA                = 'DOWN'                                            
     PR-ADLAGOMR            = '    '                                            
     PR-KVADJ-THIS-UP       = L2-KVADJ-THIS-DW / 1000                           
     PR-KVADJ-AVE-UP        = L2-KVADJ-AVE-DW / 1000                            
     PR-KVADJ-YEAR-UP       = L2-KVADJ-YEAR-DW / 1000                           
     PR-SALES-DIFF-UP       = L2-SALES-DIFF-DW                                  
     PR-KVADJ-DIFF-UP       = L2-KVADJ-DIFF-DW / 1000                           
     PR-KVADJ-DIFF-UP-PROC  = L2-KVADJ-DIFF-DW-PROC                             
                                                                                
     PRINT RAPPORT01                                                            
                                                                                
     PR-NIVA                = ' NET'                                            
     PR-ADLAGOMR            = '    '                                            
     PR-KVADJ-THIS-UP       = L3-KVADJ-THIS-NET / 1000                          
     PR-KVADJ-AVE-UP        = L3-KVADJ-AVE-NET / 1000                           
     PR-KVADJ-YEAR-UP       = L3-KVADJ-YEAR-NET / 1000                          
     PR-SALES-DIFF-UP       = L3-SALES-DIFF-NET                                 
     PR-KVADJ-DIFF-UP       = L3-KVADJ-DIFF-NET / 1000                          
     PR-KVADJ-DIFF-UP-PROC  = L3-KVADJ-DIFF-NET-PROC                            
                                                                                
     PRINT RAPPORT01                                                            
                                                                                
                                                                                
 END-PROC                                                                       
                                                                                
 DA-SKRIV-RADER-DAP. PROC                                                       
     DAP-TIVV EQ AKT-VV                                                         
     DAP-IDDC EQ W-RUB1-IDDC                                                    
     IF DAP-ADLAGOMR NE 'TOT'                                                   
       DAP-ADLAGOMR           = WS-PR-ADLAGOMR                                  
     END-IF                                                                     
                                                                                
     DAP-IDAFPRCD           = 'LINE'                                            
     DAP-BETEXT             = '  UP'                                            
*    DAP-ADLAGOMR           = WS-PR-ADLAGOMR                                    
     DAP-SUARTSTD-WEEK      = L1-KVADJ-THIS-UP / 1000                           
     DAP-SUARTSTD-WEEKAVG   = L1-KVADJ-AVE-UP / 1000                            
     DAP-SUARTSTD-TOT       = L1-KVADJ-YEAR-UP / 1000                           
     DAP-REDIFF             = L1-SALES-DIFF-UP                                  
     DAP-SUARTSTD-DIFF      = L1-KVADJ-DIFF-UP / 1000                           
     DAP-REDIFF-LYEAR       = L1-KVADJ-DIFF-UP-PROC                             
                                                                                
     PUT W51313D4                                                               
                                                                                
     DAP-BETEXT             = 'DOWN'                                            
     DAP-ADLAGOMR           = '    '                                            
     DAP-SUARTSTD-WEEK      = L2-KVADJ-THIS-DW / 1000                           
     DAP-SUARTSTD-WEEKAVG   = L2-KVADJ-AVE-DW / 1000                            
     DAP-SUARTSTD-TOT       = L2-KVADJ-YEAR-DW / 1000                           
     DAP-REDIFF             = L2-SALES-DIFF-DW                                  
     DAP-SUARTSTD-DIFF      = L2-KVADJ-DIFF-DW / 1000                           
     DAP-REDIFF-LYEAR       = L2-KVADJ-DIFF-DW-PROC                             
                                                                                
     PUT W51313D4                                                               
                                                                                
     DAP-BETEXT             = ' NET'                                            
     DAP-ADLAGOMR           = '    '                                            
     DAP-SUARTSTD-WEEK      = L3-KVADJ-THIS-NET / 1000                          
     DAP-SUARTSTD-WEEKAVG   = L3-KVADJ-AVE-NET / 1000                           
     DAP-SUARTSTD-TOT       = L3-KVADJ-YEAR-NET / 1000                          
     DAP-REDIFF             = L3-SALES-DIFF-NET                                 
     DAP-SUARTSTD-DIFF      = L3-KVADJ-DIFF-NET / 1000                          
     DAP-REDIFF-LYEAR       = L3-KVADJ-DIFF-NET-PROC                            
                                                                                
     PUT W51313D4                                                               
                                                                                
                                                                                
 END-PROC                                                                       
 E-SUMMERA-RADER. PROC                                                          
   L1-KVADJ-THIS-UP  = W-KVADJ-THIS-UP                                          
   L2-KVADJ-THIS-DW  = W-KVADJ-THIS-DW                                          
   L3-KVADJ-THIS-NET = W-KVADJ-THIS-NET                                         
                                                                                
   L1-KVADJ-YEAR-UP  = W-KVADJ-YEAR-UP                                          
   L2-KVADJ-YEAR-DW  = W-KVADJ-YEAR-DW                                          
   L3-KVADJ-YEAR-NET = W-KVADJ-YEAR-NET                                         
                                                                                
  IF W-KVADJ-AVE-UP NE 0                                                        
   L1-KVADJ-AVE-UP     = W-KVADJ-AVE-UP   / AKT-VV                              
  ELSE                                                                          
   L1-KVADJ-AVE-UP     = 0                                                      
  END-IF                                                                        
  IF W-KVADJ-AVE-DW  NE 0                                                       
   L2-KVADJ-AVE-DW     = W-KVADJ-AVE-DW   / AKT-VV                              
  ELSE                                                                          
   L2-KVADJ-AVE-DW     = 0                                                      
  END-IF                                                                        
  IF W-KVADJ-AVE-NET NE 0                                                       
   L3-KVADJ-AVE-NET    = W-KVADJ-AVE-NET  / AKT-VV                              
  ELSE                                                                          
   L3-KVADJ-AVE-NET    = 0                                                      
  END-IF                                                                        
                                                                                
* PROCENT AV FÖRSÄLJNINGEN                                                      
  IF W-KVADJ-YEAR-UP NE 0 AND W-SUARTFSG NE 0                                   
   L1-SALES-DIFF-UP  = (W-KVADJ-YEAR-UP / W-SUARTFSG) * 100                     
  ELSE                                                                          
   L1-SALES-DIFF-UP  =  0                                                       
  END-IF                                                                        
  IF W-KVADJ-YEAR-DW NE 0 AND W-SUARTFSG NE 0                                   
   L2-SALES-DIFF-DW  = (W-KVADJ-YEAR-DW / W-SUARTFSG) * 100                     
  ELSE                                                                          
   L2-SALES-DIFF-DW  = 0                                                        
  END-IF                                                                        
  IF W-KVADJ-YEAR-NET NE 0 AND W-SUARTFSG NE 0                                  
   L3-SALES-DIFF-NET = (W-KVADJ-YEAR-NET / W-SUARTFSG) * 100                    
  ELSE                                                                          
   L3-SALES-DIFF-NET = 0                                                        
  END-IF                                                                        
                                                                                
*** DIFF MELLAN INVENTERAT I ÅR O FÖRRA ÅRET                                    
  L1-KVADJ-DIFF-UP  = W-KVADJ-YEAR-UP  - W-KVADJ-LAST-UP                        
  L2-KVADJ-DIFF-DW  = W-KVADJ-YEAR-DW  - W-KVADJ-LAST-DW                        
  L3-KVADJ-DIFF-NET = W-KVADJ-YEAR-NET - W-KVADJ-LAST-NET                       
                                                                                
*  SKILLNADEN MELLAN INV I ÅR OCH FÖRRA ÅRET I PROCENT                          
  IF W-KVADJ-YEAR-UP  NE 0  AND W-KVADJ-LAST-UP  NE 0                           
   L1-KVADJ-DIFF-UP-PROC = 100 *                             +                  
     (W-KVADJ-YEAR-UP  - W-KVADJ-LAST-UP) / W-KVADJ-LAST-UP                     
  ELSE                                                                          
   L1-KVADJ-DIFF-UP-PROC = 0                                                    
  END-IF                                                                        
  IF W-KVADJ-YEAR-DW  NE 0  AND W-KVADJ-LAST-DW  NE 0                           
   L2-KVADJ-DIFF-DW-PROC = 100 *                             +                  
     (W-KVADJ-YEAR-DW   - W-KVADJ-LAST-DW ) / W-KVADJ-LAST-DW                   
  ELSE                                                                          
   L2-KVADJ-DIFF-DW-PROC = 0                                                    
  END-IF                                                                        
  IF W-KVADJ-YEAR-NET NE 0  AND W-KVADJ-LAST-NET NE 0                           
   L3-KVADJ-DIFF-NET-PROC = 100 *                            +                  
     (W-KVADJ-YEAR-NET  - W-KVADJ-LAST-NET) / W-KVADJ-LAST-NET                  
  ELSE                                                                          
   L3-KVADJ-DIFF-NET-PROC = 0                                                   
  END-IF                                                                        
 END-PROC                                                                       
                                                                                
 EA-SUMMERA-TOTALER. PROC                                                       
  WS-PR-ADLAGOMR = '  '                                                         
  PR-ADLAGOMR EQ 'TOT '                                                         
  DAP-ADLAGOMR EQ 'TOT '                                                        
  L1-KVADJ-THIS-UP  = W-KVADJ-THIS-UP-TOT                                       
  L2-KVADJ-THIS-DW  = W-KVADJ-THIS-DW-TOT                                       
  L3-KVADJ-THIS-NET = W-KVADJ-THIS-NET-TOT                                      
                                                                                
  L1-KVADJ-YEAR-UP  = W-KVADJ-YEAR-UP-TOT                                       
  L2-KVADJ-YEAR-DW  = W-KVADJ-YEAR-DW-TOT                                       
  L3-KVADJ-YEAR-NET = W-KVADJ-YEAR-NET-TOT                                      
                                                                                
  IF W-KVADJ-AVE-UP-TOT NE 0                                                    
    L1-KVADJ-AVE-UP         = W-KVADJ-AVE-UP-TOT   / AKT-VV                     
  ELSE                                                                          
    L1-KVADJ-AVE-UP         = 0                                                 
  END-IF                                                                        
  IF W-KVADJ-AVE-DW-TOT NE 0                                                    
    L2-KVADJ-AVE-DW         = W-KVADJ-AVE-DW-TOT   / AKT-VV                     
  ELSE                                                                          
    L2-KVADJ-AVE-DW         = 0                                                 
  END-IF                                                                        
  IF W-KVADJ-AVE-NET-TOT NE 0                                                   
    L3-KVADJ-AVE-NET         = W-KVADJ-AVE-NET-TOT  / AKT-VV                    
  ELSE                                                                          
    L3-KVADJ-AVE-NET         = 0                                                
  END-IF                                                                        
* BERÄKNA DIFF MELLAN INV OCH FÖRSÄLNINGEN                                      
   IF W-KVADJ-YEAR-UP-TOT NE 0 AND W-SUARTFSG-TOT NE 0                          
    L1-SALES-DIFF-UP            =                               +               
       (W-KVADJ-YEAR-UP-TOT / W-SUARTFSG-TOT) * 100                             
   ELSE                                                                         
    L1-SALES-DIFF-UP      =  0                                                  
   END-IF                                                                       
                                                                                
   IF W-KVADJ-YEAR-DW-TOT NE 0 AND W-SUARTFSG-TOT NE 0                          
    L2-SALES-DIFF-DW           =                                +               
       (W-KVADJ-YEAR-DW-TOT / W-SUARTFSG-TOT) * 100                             
   ELSE                                                                         
    L2-SALES-DIFF-DW      = 0                                                   
   END-IF                                                                       
                                                                                
   IF W-KVADJ-YEAR-NET-TOT NE 0 AND W-SUARTFSG-TOT NE 0                         
    L3-SALES-DIFF-NET          =                                +               
       (W-KVADJ-YEAR-NET-TOT / W-SUARTFSG-TOT) * 100                            
   ELSE                                                                         
    L3-SALES-DIFF-NET     = 0                                                   
   END-IF                                                                       
                                                                                
* DIFF MELLAN INVENTERAT I ÅR O FÖRRA ÅRET TOTALT                               
   L1-KVADJ-DIFF-UP      =                                   +                  
    W-KVADJ-YEAR-UP-TOT  - W-KVADJ-LAST-UP-TOT                                  
   L2-KVADJ-DIFF-DW      =                                   +                  
    W-KVADJ-YEAR-DW-TOT  - W-KVADJ-LAST-DW-TOT                                  
   L3-KVADJ-DIFF-NET     =                                   +                  
    W-KVADJ-YEAR-NET-TOT - W-KVADJ-LAST-NET-TOT                                 
***                                                                             
*  SKILLNADEN MELLAN INV I ÅR OCH FÖRRA ÅRET I PROCENT TOTALT                   
   IF W-KVADJ-YEAR-UP-TOT NE 0 AND W-KVADJ-LAST-UP-TOT NE 0                     
    L1-KVADJ-DIFF-UP-PROC         = 100 *                       +               
    (W-KVADJ-YEAR-UP-TOT - W-KVADJ-LAST-UP-TOT)               +                 
                        / W-KVADJ-LAST-UP-TOT                                   
   ELSE                                                                         
    L1-KVADJ-DIFF-UP-PROC   = 0                                                 
   END-IF                                                                       
                                                                                
   IF W-KVADJ-YEAR-DW-TOT NE 0 AND W-KVADJ-LAST-DW-TOT NE 0                     
    L2-KVADJ-DIFF-DW-PROC         = 100 *                       +               
    (W-KVADJ-YEAR-DW-TOT - W-KVADJ-LAST-DW-TOT)               +                 
                         / W-KVADJ-LAST-DW-TOT                                  
   ELSE                                                                         
    L2-KVADJ-DIFF-DW-PROC   = 0                                                 
   END-IF                                                                       
                                                                                
   IF W-KVADJ-YEAR-NET-TOT NE 0 AND W-KVADJ-LAST-NET-TOT NE 0                   
    L3-KVADJ-DIFF-NET-PROC         = 100 *                      +               
    (W-KVADJ-YEAR-NET-TOT - W-KVADJ-LAST-NET-TOT)             +                 
                         / W-KVADJ-LAST-NET-TOT                                 
   ELSE                                                                         
    L3-KVADJ-DIFF-NET-PROC   = 0                                                
   END-IF                                                                       
 END-PROC                                                                       
 Z-FIN. PROC                                                                    
       L1-KVADJ-THIS-UP  = W-KVADJ-THIS-UP                                      
       L2-KVADJ-THIS-DW  = W-KVADJ-THIS-DW                                      
       L3-KVADJ-THIS-NET = W-KVADJ-THIS-NET                                     
                                                                                
       L1-KVADJ-YEAR-UP  = W-KVADJ-YEAR-UP                                      
       L2-KVADJ-YEAR-DW  = W-KVADJ-YEAR-DW                                      
       L3-KVADJ-YEAR-NET = W-KVADJ-YEAR-NET                                     
                                                                                
      IF W-KVADJ-THIS-UP  NE 0                                                  
       L1-KVADJ-AVE-UP     = W-KVADJ-AVE-UP   / AKT-VV                          
      ELSE                                                                      
       L1-KVADJ-AVE-UP     = 0                                                  
      END-IF                                                                    
      IF W-KVADJ-THIS-DW  NE 0                                                  
       L2-KVADJ-AVE-DW     = W-KVADJ-AVE-DW   / AKT-VV                          
      ELSE                                                                      
       L2-KVADJ-AVE-DW     = 0                                                  
      END-IF                                                                    
      IF W-KVADJ-THIS-NET NE 0                                                  
       L3-KVADJ-AVE-NET    = W-KVADJ-AVE-NET  / AKT-VV                          
      ELSE                                                                      
       L3-KVADJ-AVE-NET    = 0                                                  
      END-IF                                                                    
                                                                                
      L1-KVADJ-DIFF-UP  = W-KVADJ-YEAR-UP  - W-KVADJ-LAST-UP                    
      L2-KVADJ-DIFF-DW  = W-KVADJ-YEAR-DW  - W-KVADJ-LAST-DW                    
      L3-KVADJ-DIFF-NET = W-KVADJ-YEAR-NET - W-KVADJ-LAST-NET                   
                                                                                
* PROCENT AV FÖRSÄLJNINGEN                                                      
       IF W-KVADJ-YEAR-UP NE 0 AND W-SUARTFSG NE 0                              
        L1-SALES-DIFF-UP  = (W-KVADJ-YEAR-UP / W-SUARTFSG) * 100                
       ELSE                                                                     
        L1-SALES-DIFF-UP  =  0                                                  
       END-IF                                                                   
       IF W-KVADJ-YEAR-DW NE 0 AND W-SUARTFSG NE 0                              
        L2-SALES-DIFF-DW  = (W-KVADJ-YEAR-DW / W-SUARTFSG) * 100                
       ELSE                                                                     
        L2-SALES-DIFF-DW  = 0                                                   
       END-IF                                                                   
       IF W-KVADJ-YEAR-NET NE 0 AND W-SUARTFSG NE 0                             
        L3-SALES-DIFF-NET = (W-KVADJ-YEAR-NET / W-SUARTFSG) * 100               
       ELSE                                                                     
        L3-SALES-DIFF-NET = 0                                                   
       END-IF                                                                   
                                                                                
*  SKILLNADEN MELLAN INV I ÅR OCH FÖRRA ÅRET I PROCENT                          
       IF W-KVADJ-YEAR-UP  NE 0  AND W-KVADJ-LAST-UP  NE 0                      
        L1-KVADJ-DIFF-UP-PROC = 100 *                             +             
          (W-KVADJ-YEAR-UP  - W-KVADJ-LAST-UP) / W-KVADJ-LAST-UP                
       ELSE                                                                     
        L1-KVADJ-DIFF-UP-PROC = 0                                               
       END-IF                                                                   
       IF W-KVADJ-YEAR-DW  NE 0  AND W-KVADJ-LAST-DW  NE 0                      
        L2-KVADJ-DIFF-DW-PROC = 100 *                             +             
          (W-KVADJ-YEAR-DW   - W-KVADJ-LAST-DW ) / W-KVADJ-LAST-DW              
       ELSE                                                                     
        L2-KVADJ-DIFF-DW-PROC = 0                                               
       END-IF                                                                   
       IF W-KVADJ-YEAR-NET NE 0  AND W-KVADJ-LAST-NET NE 0                      
        L3-KVADJ-DIFF-NET-PROC = 100 *                            +             
          (W-KVADJ-YEAR-NET  - W-KVADJ-LAST-NET) / W-KVADJ-LAST-NET             
       ELSE                                                                     
        L3-KVADJ-DIFF-NET-PROC = 0                                              
       END-IF                                                                   
       PR-ADLAGOMR = W-ADLAGOMR                                                 
       DAP-ADLAGOMR = W-ADLAGOMR                                                
                                                                                
       PERFORM D-SKRIV-RADER                                                    
       PERFORM DA-SKRIV-RADER-DAP                                               
*                                                                               
***********************************************                                 
* TOTALERNA                                   *                                 
***********************************************                                 
       L1-KVADJ-THIS-UP  = W-KVADJ-THIS-UP-TOT                                  
       L2-KVADJ-THIS-DW  = W-KVADJ-THIS-DW-TOT                                  
       L3-KVADJ-THIS-NET = W-KVADJ-THIS-NET-TOT                                 
                                                                                
       L1-KVADJ-YEAR-UP  = W-KVADJ-YEAR-UP-TOT                                  
       L2-KVADJ-YEAR-DW  = W-KVADJ-YEAR-DW-TOT                                  
       L3-KVADJ-YEAR-NET = W-KVADJ-YEAR-NET-TOT                                 
                                                                                
       IF W-KVADJ-AVE-NET-TOT NE 0                                              
         L1-KVADJ-AVE-UP         = W-KVADJ-AVE-UP-TOT   / AKT-VV                
         L2-KVADJ-AVE-DW         = W-KVADJ-AVE-DW-TOT   / AKT-VV                
         L3-KVADJ-AVE-NET        = W-KVADJ-AVE-NET-TOT  / AKT-VV                
       END-IF                                                                   
                                                                                
       IF W-KVADJ-YEAR-UP-TOT NE 0 AND W-SUARTFSG-TOT NE 0                      
        L1-SALES-DIFF-UP      =                                      +          
           (W-KVADJ-YEAR-UP-TOT / W-SUARTFSG-TOT) * 100                         
       ELSE                                                                     
        L1-SALES-DIFF-UP      =  0                                              
       END-IF                                                                   
                                                                                
       IF W-KVADJ-YEAR-DW-TOT NE 0 AND W-SUARTFSG-TOT NE 0                      
        L2-SALES-DIFF-DW      =                                     +           
           (W-KVADJ-YEAR-DW-TOT / W-SUARTFSG-TOT) * 100                         
       ELSE                                                                     
        L2-SALES-DIFF-DW      = 0                                               
       END-IF                                                                   
                                                                                
       IF W-KVADJ-YEAR-NET-TOT NE 0 AND W-SUARTFSG-TOT NE 0                     
        L3-SALES-DIFF-NET     =                                     +           
           (W-KVADJ-YEAR-NET-TOT / W-SUARTFSG-TOT) * 100                        
       ELSE                                                                     
        L3-SALES-DIFF-NET     = 0                                               
       END-IF                                                                   
* DIFF MELLAN INVENTERAT I ÅR O FÖRRA ÅRET TOTALT                               
                                                                                
      L1-KVADJ-DIFF-UP      =                                   +               
          W-KVADJ-YEAR-UP-TOT  - W-KVADJ-LAST-UP-TOT                            
      L2-KVADJ-DIFF-DW      =                                   +               
          W-KVADJ-YEAR-DW-TOT  - W-KVADJ-LAST-DW-TOT                            
      L3-KVADJ-DIFF-NET     =                                   +               
          W-KVADJ-YEAR-NET-TOT - W-KVADJ-LAST-NET-TOT                           
                                                                                
*  SKILLNADEN MELLAN INV I ÅR OCH FÖRRA ÅRET I PROCENT                          
                                                                                
       IF W-KVADJ-YEAR-UP-TOT NE 0 AND W-KVADJ-LAST-UP-TOT NE 0                 
        L1-KVADJ-DIFF-UP-PROC   = 100 *                             +           
          (W-KVADJ-YEAR-UP-TOT - W-KVADJ-LAST-UP-TOT)               +           
                               / W-KVADJ-LAST-UP-TOT                            
       ELSE                                                                     
        L1-KVADJ-DIFF-UP-PROC   = 0                                             
       END-IF                                                                   
                                                                                
       IF W-KVADJ-YEAR-DW-TOT NE 0 AND W-KVADJ-LAST-DW-TOT NE 0                 
        L2-KVADJ-DIFF-DW-PROC   = 100 *                             +           
          (W-KVADJ-YEAR-DW-TOT - W-KVADJ-LAST-DW-TOT)               +           
                               / W-KVADJ-LAST-DW-TOT                            
       ELSE                                                                     
        L2-KVADJ-DIFF-DW-PROC   = 0                                             
       END-IF                                                                   
                                                                                
       IF W-KVADJ-YEAR-NET-TOT NE 0 AND W-KVADJ-LAST-NET-TOT NE 0               
        L3-KVADJ-DIFF-NET-PROC   = 100 *                            +           
          (W-KVADJ-YEAR-NET-TOT - W-KVADJ-LAST-NET-TOT)             +           
                                / W-KVADJ-LAST-NET-TOT                          
       ELSE                                                                     
        L3-KVADJ-DIFF-NET-PROC   = 0                                            
       END-IF                                                                   
                                                                                
      WS-PR-ADLAGOMR = '  '                                                     
      PR-ADLAGOMR EQ 'TOT '                                                     
      DAP-ADLAGOMR EQ 'TOT'                                                     
      PERFORM D-SKRIV-RADER                                                     
      PERFORM DA-SKRIV-RADER-DAP                                                
 END-PROC                                                                       
***********************************************                                 
* RAPPORTEN                                   *                                 
***********************************************                                 
  REPORT RAPPORT01         +                                                    
         SUMSPACE 0        +                                                    
         PRINTER W51313D3  +                                                    
         LINESIZE 125      +                                                    
         NOHEADING         +                                                    
         NOADJUST          +                                                    
         PAGESIZE 999      +                                                    
         NOPAGE            +                                                    
         NODATE                                                                 
                                                                                
  CONTROL FINAL NOPRINT W-RUB1-IDDC  NEWPAGE                                    
                                                                                
  TITLE 1 COL 1 W-RUBRIK1                                                       
  TITLE 2 COL 1 W-RUBRIK2                                                       
  TITLE 3 COL 1 W-RUBRIK3                                                       
                                                                                
  LINE COL 1  PR-ADLAGOMR              +                                        
       COL 5  PR-NIVA                  +                                        
       COL 10 PR-KVADJ-THIS-UP         +                                        
       COL 25 PR-KVADJ-AVE-UP          +                                        
       COL 40 PR-KVADJ-YEAR-UP         +                                        
       COL 55 PR-SALES-DIFF-UP         +                                        
       COL 70 PR-KVADJ-DIFF-UP         +                                        
       COL 85 PR-KVADJ-DIFF-UP-PROC                                             
                                                                                
