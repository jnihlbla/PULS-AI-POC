*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5127500                                              *        
*                                                                      *        
*  FUNCTION   :  COMBINES THE KVRESS EXTRACT FROM W01184 AND W01160    *        
*                CREATES A KVRESS REPORT                               *        
*                                                                      *        
*  AUTHOR     :  SARASWATHY S                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W51275D1                                                                   
%W51274  'IN1-'                                                                 
*                                                                               
FILE W51275D2                                                                   
%W51274  'IN2-'                                                                 
*                                                                               
FILE W51275D3                                                                   
%W01160  'IN3-'                                                                 
*                                                                               
FILE TPFIL1 FB(16 0)                                                            
  TP-IDARTNR   1  5  P                                                          
  TP-IDDC      6  2  A                                                          
  TP-KVRESS    8  4  P  0                                                       
  TP-PRARTSTD 12  5  P  2                                                       
*                                                                               
FILE W51275D4  VB(45 0)                                                         
UTAREA      1 45 A                                                              
************************************************************************        
UT-A     W 45 A                                                                 
UT-IDARTNR   UT-A  +1    9  N  VALUE 0                                          
FILL01       UT-A  +10   1  A  VALUE ';'                                        
UT-IDDC      UT-A  +11   2  A                                                   
FILL02       UT-A  +13   1  A  VALUE ';'                                        
FILL03       UT-A  +14   1  A                                                   
UT-KVRESS    UT-A  +15   7  N  VALUE 0                                          
FILL04       UT-A  +22   1  A  VALUE ';'                                        
FILL05       UT-A  +23   1  A                                                   
UT-PRARTSTN  UT-A  +24   7  N  VALUE 0                                          
FILL06       UT-A  +31   1  A  VALUE '.'                                        
UT-PRARTSTD  UT-A  +32   2  N  VALUE 0                                          
*                                                                               
UT-B     W 45 A                                                                 
UTB-IDARTNR  UT-B  +1    9  A  VALUE 'PART NO'                                  
UTB-FILL01   UT-B  +10   1  A  VALUE ';'                                        
UTB-IDDC     UT-B  +11   2  A  VALUE 'DC'                                       
UTB-FILL02   UT-B  +13   1  A  VALUE ';'                                        
UTB-KVRESS   UT-B  +14   8  A  VALUE 'QUANTITY'                                 
UTB-FILL03   UT-B  +22   1  A  VALUE ';'                                        
UTB-PRARTSTD UT-B  +23   9  A  VALUE 'STD PRICE'                                
*                                                                               
W-PREV-IDDC      W   2 A                                                        
W-PREV-IDARTNR   W   9 N                                                        
W-PREV-PRARTSTD  W   5 P 2                                                      
W-PRARTSTD       W   5 P 2                                                      
W-PSTD-FMT                      W  9  N 2                                       
W-PSTD-N        W-PSTD-FMT        7  N                                          
W-PSTD-D        W-PSTD-FMT     +7 2  N                                          
*                                                                               
************************************************************************        
SORT W51275D1 TO W51275D1 USING (IN1-IDARTNR) SIZE 9000000                      
SORT W51275D2 TO W51275D2 USING (IN2-IDARTNR) SIZE 9000000                      
SORT W51275D3 TO W51275D3 USING (IN3-CLAG-IDARTNR) SIZE 9000000                 
************************************************************************        
JOB INPUT (W51275D1 KEY(IN1-IDARTNR) +                                          
           W51275D3 KEY(IN3-CLAG-IDARTNR))                                      
IF MATCHED                                                                      
        TP-IDARTNR           = IN1-IDARTNR                                      
        TP-IDDC              = IN1-IDDC                                         
        TP-KVRESS            = IN1-KVRESS                                       
        TP-PRARTSTD          = IN3-CLAG-PRARTSTD                                
        W-PREV-PRARTSTD      = IN3-CLAG-PRARTSTD                                
        W-PREV-IDARTNR       = IN1-IDARTNR                                      
        W-PREV-IDDC          = IN1-IDDC                                         
        IF TP-KVRESS NE 0                                                       
           PUT TPFIL1                                                           
        END-IF                                                                  
ELSE                                                                            
  IF W51275D1                                                                   
    TP-IDARTNR           = IN1-IDARTNR                                          
    TP-IDDC              = IN1-IDDC                                             
    TP-KVRESS            = IN1-KVRESS                                           
    IF IN1-IDARTNR  = W-PREV-IDARTNR AND +                                      
       IN1-IDDC     = W-PREV-IDDC                                               
       TP-PRARTSTD  = W-PREV-PRARTSTD                                           
    END-IF                                                                      
    PUT TPFIL1                                                                  
  END-IF                                                                        
END-IF                                                                          
************************************************************************        
*JOB READS AND MERGES TPFIL AND W51275D1                                        
************************************************************************        
JOB INPUT ((TPFIL1  KEY(TP-IDARTNR TP-KVRESS)) +                                
          (W51275D2 KEY(IN2-IDARTNR IN2-KVRESS))) START A-START                 
IF MATCHED                                                                      
        UT-IDARTNR           = TP-IDARTNR                                       
        UT-IDDC              = TP-IDDC                                          
        UT-KVRESS            = TP-KVRESS                                        
        IF TP-KVRESS < 0                                                        
           MOVE '-' TO FILL03                                                   
        ELSE                                                                    
           MOVE ' ' TO FILL03                                                   
        END-IF                                                                  
        W-PRARTSTD           = TP-PRARTSTD                                      
        IF TP-PRARTSTD < 0                                                      
           MOVE '-' TO FILL05                                                   
        ELSE                                                                    
           MOVE ' ' TO FILL05                                                   
        END-IF                                                                  
        W-PSTD-FMT           = W-PRARTSTD                                       
        UT-PRARTSTN          = W-PSTD-N                                         
        UT-PRARTSTD          = W-PSTD-D                                         
        UTAREA               = UT-A                                             
        IF UT-KVRESS NE 0                                                       
           PUT W51275D4                                                         
        END-IF                                                                  
  ELSE                                                                          
    IF W51275D2                                                                 
        UT-IDARTNR           = IN2-IDARTNR                                      
        UT-IDDC              = IN2-IDDC                                         
        UT-KVRESS            = IN2-KVRESS                                       
        IF IN2-KVRESS < 0                                                       
           MOVE '-' TO FILL03                                                   
        ELSE                                                                    
           MOVE ' ' TO FILL03                                                   
        END-IF                                                                  
        W-PRARTSTD           = IN2-PRARTSTD                                     
        IF IN2-PRARTSTD < 0                                                     
           MOVE '-' TO FILL05                                                   
        ELSE                                                                    
           MOVE ' ' TO FILL05                                                   
        END-IF                                                                  
        W-PSTD-FMT           = W-PRARTSTD                                       
        UT-PRARTSTN          = W-PSTD-N                                         
        UT-PRARTSTD          = W-PSTD-D                                         
        UTAREA               = UT-A                                             
        IF UT-KVRESS NE 0                                                       
           PUT W51275D4                                                         
        END-IF                                                                  
    ELSE                                                                        
       IF TPFIL1                                                                
        UT-IDARTNR           = TP-IDARTNR                                       
        UT-IDDC              = TP-IDDC                                          
        UT-KVRESS            = TP-KVRESS                                        
        IF TP-KVRESS < 0                                                        
           MOVE '-' TO FILL03                                                   
        ELSE                                                                    
           MOVE ' ' TO FILL03                                                   
        END-IF                                                                  
        W-PRARTSTD           = TP-PRARTSTD                                      
        IF TP-PRARTSTD < 0                                                      
           MOVE '-' TO FILL05                                                   
        ELSE                                                                    
           MOVE ' ' TO FILL05                                                   
        END-IF                                                                  
        W-PSTD-FMT           = W-PRARTSTD                                       
        UT-PRARTSTN          = W-PSTD-N                                         
        UT-PRARTSTD          = W-PSTD-D                                         
        UTAREA               = UT-A                                             
        IF UT-KVRESS NE 0                                                       
           PUT W51275D4                                                         
        END-IF                                                                  
       END-IF                                                                   
   END-IF                                                                       
END-IF                                                                          
A-START. PROC                                                                   
  UTAREA   = UT-B                                                               
  PUT W51275D4                                                                  
END-PROC.                                                                       
