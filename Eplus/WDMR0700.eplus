                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  WDMR0700                                              *        
*                                                                      *        
*  FUNKTION   :  SORTERA OCH PLOCCKA BORT DUBLETTER                    *        
*                JOB-STEP                                              *        
*                                                                      *        
*  FÖRFATTARE :  ODD OLSEN                                             *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE WDMR07D1                                                                   
*                                                                               
  IN-POST              1 80 A                                                   
                                                                                
*    -- CHECKED BY WY2000                                                       
  IN-JOB               1 17 A                                                   
  IN-PGM              18 22 A                                                   
  IN-SORT-POST         1 40 A                                                   
                                                                                
NEWPAGE                                                                         
FILE TEMP FB(80 23440) VIRTUAL                                                  
*                                                                               
  TEMP-POST            1 80 A                                                   
  TEMP-JOB             1 17 A                                                   
                                                                                
NEWPAGE                                                                         
FILE WDMR07D2 FB(80 23440)                                                      
*                                                                               
  UT-POST              1 80 A                                                   
  UT-JOB               1 17 A                                                   
                                                                                
NEWPAGE                                                                         
*                                                                               
* ARBETSAREA                                                                    
*                                                                               
  SPAR-POST            W 80 A                                                   
NEWPAGE                                                                         
*                                                                               
* SORT                                                                          
*                                                                               
SORT WDMR07D1 TO +                                                              
     TEMP USING (IN-SORT-POST)                                                  
                                                                                
NEWPAGE                                                                         
*                                                                               
* BEARBETA                                                                      
*                                                                               
JOB INPUT(TEMP)                                                                 
                                                                                
    IF TEMP-POST ^= SPAR-POST                                                   
      PUT WDMR07D2 FROM TEMP                                                    
      SPAR-POST = TEMP-POST                                                     
    END-IF                                                                      
                                                                                
    GOTO JOB                                                                    
                                                                                
STOP                                                                            
