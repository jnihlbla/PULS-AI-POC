                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6131900                                              *        
*                                                                      *        
*  FUNKTION   :  SUMMERAR UTIFRÅN VECKOFILER IHOP VAD SOM PACKATS PÅ   *        
*                SVS UNDER SENASTE PERIODEN.                           *        
*                                                                      *        
*  FÖRFATTARE :  RAHUL REDDY                                           *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W61319D1                                                                   
%W6131801  'IN1-'                                                               
                                                                                
FILE W61319D2 FB(39 0)                                                          
%W6131801  'IN-'                                                                
                                                                                
FILE W61319D3 FB(39 0)                                                          
%W6131801  'UT-'                                                                
                                                                                
FILE W61319D4 PRINTER VB(43 0)                                                  
*                                                                               
                                                                                
NEWPAGE                                                                         
*                                                                               
KDFORP            W 4 A                                                         
WS-IDDC           W 2 A                                                         
KVANT-ST          W 7 N                                                         
KVANT-28          W 7 N                                                         
KVANT-GR          W 7 N                                                         
KVANT-MA          W 7 N                                                         
WS-RP             W 4 A                                                         
*                                                                               
WS-KDFORP                W 4 A                                                  
WS-PREV-IDDC             W 2 A                                                  
WS-KVANTAL               W 7 N                                                  
WS-KVANTAL-ST            W 7 N                                                  
WS-KVANTAL-28            W 7 N                                                  
WS-KVANTAL-GR            W 7 N                                                  
WS-KVANTAL-MA            W 7 N                                                  
*                                                                               
%WDATAREA                                                                       
                                                                                
NEWPAGE                                                                         
                                                                                
WDATKONV        W 8 A VALUE 'WDATKONV'                                          
                                                                                
DAGENS-DATUM             W 6 N                                                  
                                                                                
DATUM                    W 8 A                                                  
D-AA         DATUM         2 N                                                  
D-1          DATUM +2      1 A                                                  
D-MM         DATUM +3      2 N                                                  
D-2          DATUM +5      1 A                                                  
D-DD         DATUM +6      2 N                                                  
*                                                                               
                                                                                
DATUM-FIX                W 6 N                                                  
D-AA-FIX  DATUM-FIX        2 N                                                  
D-MM-FIX  DATUM-FIX +2     2 N                                                  
D-DD-FIX  DATUM-FIX +4     2 N                                                  
                                                                                
*                                                                               
* STEG 1. SUMMERAR IHOP VAD SOM PACKATS PÅ SVS SENASTE PERIODEN                 
*                                                                               
SORT W61319D1 TO W61319D2 USING (IN1-IDDC, IN1-KDFORP)                          
                                                                                
JOB INPUT W61319D2 START A-INIT FINISH Z-FINIT                                  
                                                                                
IF RECORD-COUNT = 1                                                             
  WS-KDFORP     = IN-KDFORP                                                     
  WS-IDDC       = IN-IDDC                                                       
  WS-KVANTAL-ST = IN-KVANTAL-ST                                                 
  WS-KVANTAL-28 = IN-KVANTAL-28                                                 
  WS-KVANTAL-GR = IN-KVANTAL-GR                                                 
  WS-KVANTAL-MA = IN-KVANTAL-MA                                                 
ELSE                                                                            
  IF (WS-IDDC = IN-IDDC AND WS-KDFORP = IN-KDFORP)                              
    WS-KVANTAL-ST = WS-KVANTAL-ST + IN-KVANTAL-ST                               
    WS-KVANTAL-28 = WS-KVANTAL-28 + IN-KVANTAL-28                               
    WS-KVANTAL-GR = WS-KVANTAL-GR + IN-KVANTAL-GR                               
    WS-KVANTAL-MA = WS-KVANTAL-MA + IN-KVANTAL-MA                               
  ELSE                                                                          
    UT-KDFORP     = WS-KDFORP                                                   
    UT-IDDC       = WS-IDDC                                                     
    UT-KVANTAL-ST = WS-KVANTAL-ST                                               
    UT-KVANTAL-28 = WS-KVANTAL-28                                               
    UT-KVANTAL-GR = WS-KVANTAL-GR                                               
    UT-KVANTAL-MA = WS-KVANTAL-MA                                               
    PUT W61319D3                                                                
    IF WS-KDFORP = '0000'                                                       
      KDFORP     = '    '                                                       
    ELSE                                                                        
      KDFORP     = WS-KDFORP                                                    
    END-IF                                                                      
    KVANT-ST = WS-KVANTAL-ST                                                    
    KVANT-28 = WS-KVANTAL-28                                                    
    KVANT-GR = WS-KVANTAL-GR                                                    
    KVANT-MA = WS-KVANTAL-MA                                                    
    PRINT REPORT01                                                              
    WS-KDFORP     = IN-KDFORP                                                   
    WS-IDDC       = IN-IDDC                                                     
    WS-KVANTAL-ST = IN-KVANTAL-ST                                               
    WS-KVANTAL-28 = IN-KVANTAL-28                                               
    WS-KVANTAL-GR = IN-KVANTAL-GR                                               
    WS-KVANTAL-MA = IN-KVANTAL-MA                                               
  END-IF                                                                        
END-IF                                                                          
                                                                                
A-INIT. PROC                                                                    
                                                                                
* INITIERAR COPYTEXT                                                            
  UT-KVANTAL-ST = 0                                                             
  UT-KVANTAL-28 = 0                                                             
  UT-KVANTAL-GR = 0                                                             
  UT-KVANTAL-MA = 0                                                             
                                                                                
  DATUM         = SYSDATE                                                       
  D-AA-FIX      = D-AA                                                          
  D-MM-FIX      = D-MM                                                          
  D-DD-FIX      = D-DD                                                          
  DAGENS-DATUM  = DATUM-FIX                                                     
                                                                                
  DAT-KDDATFORM = 'AAMMDD'                                                      
  DAT-I-TIDATUM = DAGENS-DATUM                                                  
                                                                                
  CALL WDATKONV USING (DAT-KDDATFORM, +                                         
                       DAT-I-TIDATUM, +                                         
                       DAT-O-TIDATUM, +                                         
                       DAT-KDSVAR)                                              
                                                                                
  IF DAT-KDSVAR = ' '                                                           
    WS-RP         = DAT-TIAARP-GRP                                              
  ELSE                                                                          
    DISPLAY 'FEL FRÅN DATKONV'                                                  
    STOP EXECUTE                                                                
  END-IF                                                                        
                                                                                
END-PROC                                                                        
                                                                                
Z-FINIT. PROC                                                                   
                                                                                
  IF RECORD-COUNT >= 1                                                          
    UT-KDFORP     = WS-KDFORP                                                   
    UT-KVANTAL-ST = WS-KVANTAL-ST                                               
    UT-KVANTAL-28 = WS-KVANTAL-28                                               
    UT-KVANTAL-GR = WS-KVANTAL-GR                                               
    UT-KVANTAL-MA = WS-KVANTAL-MA                                               
    PUT W61319D3                                                                
                                                                                
    IF WS-KDFORP = '0000'                                                       
      KDFORP     = '    '                                                       
    ELSE                                                                        
      KDFORP     = WS-KDFORP                                                    
    END-IF                                                                      
    KVANT-ST = WS-KVANTAL-ST                                                    
    KVANT-28 = WS-KVANTAL-28                                                    
    KVANT-GR = WS-KVANTAL-GR                                                    
    KVANT-MA = WS-KVANTAL-MA                                                    
    PRINT REPORT01                                                              
  END-IF                                                                        
                                                                                
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
REPORT REPORT01 PRINTER W61319D4 LINESIZE 38      +                             
                                 NOHEADING        +                             
                                 NOADJUST         +                             
                                 NODATE           +                             
                                 NOSPREAD         +                             
                                 SPACE 0                                        
LINE    1   WS-IDDC    +                                                        
            KDFORP     +                                                        
            KVANT-ST   +                                                        
            KVANT-28   +                                                        
            KVANT-GR   +                                                        
            KVANT-MA   +                                                        
            WS-RP                                                               
BEFORE-LINE. PROC                                                               
  IF WS-IDDC NE WS-PREV-IDDC                                                    
    DISPLAY '¤DAPW61319-001'                                                    
    DISPLAY '¤DAP' WS-IDDC                                                      
    WS-PREV-IDDC = WS-IDDC                                                      
  END-IF                                                                        
END-PROC                                                                        
