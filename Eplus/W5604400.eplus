                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W560   INVENTERING - NDC                              *        
*                                                                      *        
*  FUNKTION   :  SKAPAR LISTA W56044-0XX INVENTERINGSJUSTERINGAR       *        
*                                                                      *        
*  FÖRFATTARE :  BOO HAMMARIN, GDC-GROUP                               *        
*               ("KOPIA" AV PGM W5135500)                              *        
*                                                                      *        
*  INFIL      :  W560.W560D1.W5604R(+0)                                *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W56044D1 VB(59 27998)                                                      
                                                                                
%W51322R1 'IN-'                                                                 
                                                                                
NEWPAGE                                                                         
                                                                                
FILE W56044D2 PRINTER VB(125   0)                                               
NEWPAGE                                                                         
                                                                                
%WDATKORT                                                                       
NEWPAGE                                                                         
                                                                                
  W-PAGE       W  10  A    VALUE '  PAGE  '                                     
                                                                                
  W-PGMNAMN    W  6   A    VALUE 'W56044'                                       
  W-WDATUM     W  6   A    VALUE 'WDATUM'                                       
  W-PREV-IDDC  W  2   A                                                         
  W-IDDC       W  2   A                                                         
  W-KDVALISO   W  3   A                                                         
  W-SEM        W  1   A    VALUE ';'                                            
                                                                                
                                                                                
  W-DATUM          W  6   N                                                     
  W-MM   W-DATUM       2  N                                                     
  W-DD   W-DATUM   +2  2  N                                                     
  W-AAR  W-DATUM   +4  2  N                                                     
                                                                                
  W-AAVV       W  4   A                                                         
  W-AA W-AAVV  2      N                                                         
  W-VV W-AAVV  +2 2   N                                                         
                                                                                
  W-VARDEPV    W  9   N 2 VALUE 0                                               
  W-VARDE      W  9   N 2  HEADING('     ADJ.VALUE')  MASK BWZ                  
                                                                                
  W-TIM-INV    W  6   N 0  VALUE 0                                              
                                                                                
  W-KVJUSTKV-E   W  7   N 0  MASK '------9'                                     
  W-VARDE-E      W  9   N 2  MASK '------9.99'                                  
  W-ADLAGOMR-E   W  2   N 0  MASK 'Z9'                                          
  W-IDARTNR-E    W  9   N    MASK 'ZZZZZZZZ9'                                   
  W-BENAEMNING-E W 15   A                                                       
  W-JUST-DATUM-E W  7   N    MASK 'ZZZZZZ9'                                     
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
SORT W56044D1 TO W56044D1 USING (IN-IDDC, IN-IDARTNR)                           
JOB INPUT W56044D1 START INIT-PROC                                              
                                                                                
  IF IN-IDLISTA EQ 02                                                           
                                                                                
    W-VARDE           = IN-KVJUSTKV * IN-PRAVCOST                               
    W-IDDC            = IN-IDDC                                                 
                                                                                
    W-ADLAGOMR-E      = IN-ADLAGOMR                                             
    W-VARDE-E         = IN-KVJUSTKV * IN-PRAVCOST                               
    W-KVJUSTKV-E      = IN-KVJUSTKV                                             
    W-IDARTNR-E       = IN-IDARTNR                                              
    W-BENAEMNING-E    = IN-BEART-ENG                                            
    W-JUST-DATUM-E    = IN-TIM-INV                                              
                                                                                
    IF W-VARDE GE 500  OR W-VARDE LE -500                                       
                                                                                
        W-VARDEPV = W-VARDE                                                     
                                                                                
        IF W-IDDC = NDC-CA                                                      
           W-KDVALISO = 'CAD'                                                   
        ELSE                                                                    
           W-KDVALISO = 'USD'                                                   
        END-IF                                                                  
        PRINT RAPPORTDAP                                                        
    END-IF                                                                      
  END-IF                                                                        
NEWPAGE                                                                         
                                                                                
INIT-PROC. PROC                                                                 
    CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                           
    W-AAR  = D-AAR                                                              
    W-MM   = D-MAANAD                                                           
    W-DD   = D-DAG                                                              
    W-AA   = D-AAR                                                              
    W-VV   = D-VECKA                                                            
END-PROC                                                                        
NEWPAGE                                                                         
***********************                                                         
*  RAPPORT NDC                                                                  
***********************                                                         
                                                                                
NEWPAGE                                                                         
**************************                                                      
** LISTADAP FOR ALL NDC-NA                                                      
**************************                                                      
                                                                                
  REPORT RAPPORTDAP             +                                               
         PRINTER W56044D2       +                                               
         PAGESIZE 32767         +                                               
         LINESIZE 120           +                                               
         SPACE 0                +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NODATE                 +                                               
         NOADJUST                                                               
                                                                                
LINE  1  W-IDARTNR-E        +                                                   
         W-SEM              +                                                   
         W-BENAEMNING-E     +                                                   
         W-SEM              +                                                   
         W-JUST-DATUM-E     +                                                   
         W-SEM              +                                                   
         W-ADLAGOMR-E       +                                                   
         W-SEM              +                                                   
         W-KVJUSTKV-E       +                                                   
         W-SEM              +                                                   
         W-VARDE-E          +                                                   
         W-SEM                                                                  
*                                                                               
BEFORE-LINE. PROC                                                               
 IF W-IDDC NE W-PREV-IDDC   +                                                   
 AND W-IDDC NE ' '                                                              
   DISPLAY '¤DAPW56044'                                                         
   DISPLAY '¤DAP' W-IDDC                                                        
   DISPLAY 'PARTNO;DESCRIPTION;ADJ.DATE;AREA;ADJ.QTY;ADJ.VALUE;'                
   W-PREV-IDDC = W-IDDC                                                         
 END-IF                                                                         
END-PROC                                                                        
