                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2713D00                                              *        
*                                                                      *        
*  FÖRFATTARE :  ARUP DATTA                                            *        
*                                                                      *        
*  DATUM      :  160909                                                *        
*                                                                      *        
*  FUNKTION   :  PROGRAM CREATES REPORT FOR UNNORMAL FORECAST OF       *        
*                LOCALLY SOURCED PARTS (KVPB-REF)                      *        
*                (THIS IS A CUSTOMIZED COPY OF W2713900)               *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE W2713DD1                                                                   
*                                                                               
%W27138       'IN-'                                                             
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W2713DD2 VB (75 0) PRINTER                                                 
*                                                                               
*                                                                               
  UT-IDANSK            W  3  N                                                  
  UT-IDARTNR           W  9  N      MASK 'ZZZZZZZZ9'                            
  UT-IDDC              W  2  A                                                  
  UT-KVPB-REF          W  4  P  1   MASK 'ZZZZZ9.9-'                            
  UT-NY-KVPB-REF       W  4  P  1   MASK 'ZZZZZ9.9-'                            
                                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
  JA                        W   1  A   VALUE 'J'                                
  NEJ                       W   1  A   VALUE 'N'                                
  W-SEM1                    W   1  A   VALUE ';'                                
  SW-FIRST                  S   1  A   VALUE 'J'                                
*                                                                               
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT W2713DD1 +                                                          
      NAME   STEG01                                                             
                                                                                
     UT-IDANSK           = IN-IDANSK                                            
     UT-IDARTNR          = IN-IDARTNR                                           
     UT-IDDC             = IN-IDDC                                              
     UT-KVPB-REF         = IN-KVPB-REF                                          
     UT-NY-KVPB-REF      = IN-NY-KVPB-REF                                       
                                                                                
        PRINT RAPPORT01                                                         
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    REPORT SECTION                              *              
*----------------------------------------------------------------*              
*                                                                               
    REPORT RAPPORT01 PRINTER W2713DD2                            +              
                     LINESIZE      70                            +              
                     NODATE                                      +              
                     NOHEADING                                   +              
                     NOADJUST                                    +              
                     NOSPREAD                                    +              
                     SPACE          0                                           
    SEQUENCE  UT-IDANSK UT-IDARTNR                                              
*                                                                               
    LINE 01                         +                                           
              UT-IDANSK             +                                           
              W-SEM1                +                                           
              UT-IDARTNR            +                                           
              W-SEM1                +                                           
              UT-IDDC               +                                           
              W-SEM1                +                                           
              UT-KVPB-REF           +                                           
              W-SEM1                +                                           
              UT-NY-KVPB-REF        +                                           
              W-SEM1                                                            
                                                                                
*                                                                               
BEFORE-LINE. PROC                                                               
 IF SW-FIRST = JA                                                               
   DISPLAY '¤DAPW2713D-001'                                                     
   DISPLAY '¤DAPW2713D'                                                         
   DISPLAY 'PURCHASE PLANNER;PART NUMBER;DC;OLD FORECAST;NEW FORECAST;'         
   SW-FIRST = NEJ                                                               
 END-IF                                                                         
END-PROC                                                                        
