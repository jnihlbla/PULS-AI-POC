*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6112800                                              *        
*                                                                      *        
*  FUNKTION   :  MATCH TWO FILES WITH NETWEIGHT INFO FROM KDP AND      *        
*                CREATE AN OUTPUT FILE WITH TODAYS CHANGES FOR WDK611. *        
*                                                                      *        
*  FÖRFATTARE :  HÅKAN BOHLIN                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W61128D1                                                                   
*                                                                               
%W61108  'IN1-'                                                                 
                                                                                
FILE W61128D2                                                                   
*                                                                               
%W61108  'IN2-'                                                                 
                                                                                
FILE W61128D3 FB(16 0)                                                          
*                                                                               
%W61128  'OUT1-'                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
                                                                                
JOB INPUT (W61128D1 KEY IN1-IDARTNR W61128D2 KEY IN2-IDARTNR)                   
IF MATCHED                                                                      
  IF IN1-KDUVKNTO = '0' '3' '4'                                                 
    IF IN1-KDUVKNTO = '3'                                                       
      IF IN1-VKART-NTO NE IN2-VKART-NTO                                         
         OUT1-IDARTNR   = IN1-IDARTNR                                           
         OUT1-VKART-NTO = IN1-VKART-NTO                                         
         PUT W61128D3                                                           
      END-IF                                                                    
    ELSE                                                                        
      OUT1-IDARTNR   = IN1-IDARTNR                                              
      OUT1-VKART-NTO = IN1-VKART-NTO                                            
      PUT W61128D3                                                              
    END-IF                                                                      
  END-IF                                                                        
ELSE                                                                            
  IF W61128D1                                                                   
    IF IN1-KDUVKNTO = '0' '3' '4'                                               
       OUT1-IDARTNR   = IN1-IDARTNR                                             
       OUT1-VKART-NTO = IN1-VKART-NTO                                           
       PUT W61128D3                                                             
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
