                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W0200800                                              *        
*                SRS, SERVICEGRADREDOVISNINGSSYSTEMET                  *        
*               (SERVICE (DEGREE) REPORT SYSTEM)                       *        
*                                                                      *        
*  FÖRFATTARE :  STEFANO GIOBBI                                        *        
*                                                                      *        
*  DATUM      :  950727                                                *        
*                                                                      *        
*  FUNKTION   :  PROGRAMMET KOMPLETTERAR INKOMMANDE POSTER CLEARING-   *        
*                ORSAK.                                                *        
*                                                                      *        
*                INFILERNA MATCHAS PÅ IDDC-PRIM/IDDC OCH IDARTNR.      *        
*                                                                      *        
*                PROGRAMMET SKAPAR EN FIL:                             *        
*                  W02031 IN FIL KOMPLETTERAD MED CLEARINGORSAK        *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE W02008D1                                                                   
*   FIL FRÅN W011P084 - WDK7 NEDLÄST                                            
%W01184                                                                         
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W02008D2                                                                   
*   FIL FRÅN W020P007 - SRS-INFO                                                
%W02009        'IN30-'                                                          
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W02008D3   FB (30 0)                                                       
*     SRS-INFO KOMPLETTERAD MED CLEARINGORSAK PLUS ATT EN FIKTIV SDC-           
*     POST SKAPAS FÖR VARJE CDC-POST DÄR NÅGON FORM AV BRIST KONSTA-            
*     TERATS.                                                                   
%W02009        'UT09-'                                                          
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT (W02008D1 KEY (SLAG-IDDC                             +              
                           SLAG-IDARTNR)                         +              
             W02008D2 KEY (IN30-IDDC-PRIM                        +              
                           IN30-IDARTNR))                        +              
                                                 NAME   STEG01                  
    IF MATCHED                                                                  
      UT09-IDDC     = IN30-IDDC                                                 
      UT09-IDDISTR  = IN30-IDDISTR                                              
      UT09-IDKUNDNR = IN30-IDKUNDNR                                             
      UT09-IDARTNR  = IN30-IDARTNR                                              
      UT09-KDORDKL  = IN30-KDORDKL                                              
      UT09-IDDC-PRIM = IN30-IDDC-PRIM                                           
      UT09-KDPRODSL = IN30-KDPRODSL                                             
      UT09-REINKORD = IN30-REINKORD                                             
      UT09-REFYSAVV = IN30-REFYSAVV                                             
      UT09-REAVBRAD = IN30-REAVBRAD                                             
      UT09-RELAGERB = 0                                                         
      UT09-RESORTB  = 0                                                         
      UT09-KVBEART  = IN30-KVBEART                                              
      PUT W02008D3                                                              
                                                                                
      UT09-IDDC     = IN30-IDDC-PRIM                                            
      UT09-REINKORD = 0                                                         
      UT09-REFYSAVV = 0                                                         
      UT09-REAVBRAD = 0                                                         
      IF SLAG-KDREFSTA = 'A' OR        +                                        
        (SLAG-KDREFSTA = 'P' AND       +                                        
         SLAG-KVLS     > 0 )                                                    
        IF IN30-REINKORD < 0 . *  OM REINKORD ÄR NEGATIV ÄR DET FRÅGAN          
          UT09-RELAGERB = -1 . *  OM EN ANNULLATION & DÄRFÖR MÅSTE ÄVEN         
          UT09-RESORTB  = 0  . *  RELAGERB JUSTERAS TILLBAKA. EN POST           
          PUT W02008D3       . *  MED POSITIV REINKORD FINNS OCH                
        ELSE                 . *  RELAGERB SÄTTS PÅ NYTT.                       
          IF IN30-REINKORD > 0                                                  
            UT09-RELAGERB = 1                                                   
            UT09-RESORTB = 0                                                    
            PUT W02008D3                                                        
          END-IF                                                                
        END-IF                                                                  
      ELSE                                                                      
        IF SLAG-KDREFSTA = 'P'                                                  
          IF IN30-REINKORD < 0 . * OM REINKORD ÄR NEGATIV ÄR DET FRÅGAN         
            UT09-RELAGERB = 0  . * OM EN ANNULLATION & DÄRFÖR MÅSTE ÄVEN        
            UT09-RESORTB  = -1 . * RESORTB JUSTERAS TILLBAKA. EN POST           
            PUT W02008D3       . * MED POSTIV REINKORD FINNS OCH                
          ELSE                 . * RESORTB SÄTTS PÅ NYTT.                       
            IF IN30-REINKORD > 0                                                
              UT09-RELAGERB = 0                                                 
              UT09-RESORTB = 1                                                  
              PUT W02008D3                                                      
            END-IF                                                              
          END-IF                                                                
        END-IF                                                                  
      END-IF                                                                    
    ELSE                                                                        
      IF W02008D2                                                               
        UT09-IDDC     = IN30-IDDC                                               
        UT09-IDDISTR  = IN30-IDDISTR                                            
        UT09-IDKUNDNR = IN30-IDKUNDNR                                           
        UT09-IDARTNR  = IN30-IDARTNR                                            
        UT09-KDORDKL  = IN30-KDORDKL                                            
        UT09-IDDC-PRIM = IN30-IDDC-PRIM                                         
        UT09-KDPRODSL = IN30-KDPRODSL                                           
        UT09-REINKORD = IN30-REINKORD                                           
        UT09-REFYSAVV = IN30-REFYSAVV                                           
        UT09-REAVBRAD = IN30-REAVBRAD                                           
        UT09-RELAGERB = 0                                                       
        UT09-RESORTB  = 0                                                       
        UT09-KVBEART  = IN30-KVBEART                                            
        PUT W02008D3                                                            
                                                                                
        UT09-IDDC     = IN30-IDDC-PRIM                                          
        UT09-REINKORD = 0                                                       
        UT09-REFYSAVV = 0                                                       
        UT09-REAVBRAD = 0                                                       
        IF IN30-REINKORD < 0                                                    
          UT09-RELAGERB = 0    . * OM REINKORD ÄR NEGATIV ÄR DET FRÅGAN         
          UT09-RESORTB  = -1   . * OM EN ANNULLATION & DÄRFÖR MÅSTE ÄVEN        
          PUT W02008D3         . * RESORTB JUSTERAS TILLBAKA. EN POST           
        ELSE                   . * MED POSTIV REINKORD FINNS OCH                
          IF IN30-REINKORD > 0 . * RESORTB SÄTTS PÅ NYTT.                       
            UT09-RELAGERB = 0                                                   
            UT09-RESORTB  = 1                                                   
            PUT W02008D3                                                        
          END-IF                                                                
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
                                                                                
NEWPAGE                                                                         
