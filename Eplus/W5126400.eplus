*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5126400                                              *        
*                                                                      *        
*  FUNKTION   :  NEW AUDIT LIST TO BE GENERATED AND IT SHOULD NOT HAVE *        
*                GIT INFO                                              *        
*                                                                      *        
*  FÖRFATTARE :  BARSHARANI BISHOYE DECEMBER 2018                     *         
*  1460641    :  CORRECT OF STOCK REPORTS                              *        
*----------------------------------------------------------------------*        
                                                                                
FILE W51264D1                                                                   
*                                                                               
%W51261  'LB-'                                                                  
*                                                                               
NEWPAGE                                                                         
FILE TPFIL2   FB(53 0)                                                          
*                                                                               
%W51261  'T2-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE TPFIL3   FB(53 0)                                                          
*                                                                               
%W51261  'T3-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE W51264D2 FB(28 0)                                                          
*                                                                               
%W51264  'UT1-'                                                                 
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W51264D3 PRINTER VB(142 0)                                                 
*                                                                               
UT2-IDARTNR       W   9   N   0 MASK 'ZZZZZZZZ9'  VALUE 0                       
UT2-PRARTSTD      W   9   N   2 MASK 'ZZZZZZ9.99' VALUE 0                       
UT2-KDPRODSL      W   3   N   0 MASK 'ZZ9'        VALUE 0                       
UT2-KVANTAL       W   9   N   0 MASK '--------9'  VALUE 0                       
UT2-TIFINLV       W   5   N                       VALUE 0                       
UT2-KDERS         W   2   N                       VALUE 0                       
UT2-KVPB          W   7   N   1 MASK 'ZZZZZ9.9'   VALUE 0                       
UT2-KDKG          W   1   N   0                   VALUE 0                       
UT2-SEMICOLON     W   1   A                       VALUE ';'                     
*                                                                               
FILE W51264D4 FB(28 0)                                                          
*                                                                               
%W51264B 'UT3-'                                                                 
*                                                                               
NEWPAGE                                                                         
*                                                                               
****WORKING STORAGE SECTION                                                     
WS-KVANTAL-F      W   9   P 0 VALUE 0                                           
WS-KVANTAL-R      W   9   P 0 VALUE 0                                           
FIRST-LINE        S   1   A  VALUE 'J'                                          
                                                                                
*-----------------------------------------------------------------*             
* STEG 1  SORT FILE ON PART NUMBER                                *             
*                                                                 *             
*-----------------------------------------------------------------*             
SORT W51264D1 TO TPFIL2 USING (LB-IDARTNR LB-IDDC) SIZE 900000                  
                                                                                
JOB INPUT (TPFIL2 KEY(T2-IDARTNR))                                              
   IF T2-KVLS   < 0                                                             
      T2-KVLS   = 0                                                             
   END-IF                                                                       
   IF T2-KVEFRS < 0                                                             
      T2-KVEFRS = 0                                                             
   END-IF                                                                       
   IF T2-KVAKS  < 0                                                             
      T2-KVAKS  = 0                                                             
   END-IF                                                                       
   UT1-IDARTNR    = T2-IDARTNR                                                  
   UT1-PRARTSTD   = T2-PRARTSTD                                                 
   UT1-KDPRODSL   = T2-KDPRODSL                                                 
   UT1-TIFINLV    = T2-TIFINLV                                                  
   UT1-KDERS      = T2-KDERS                                                    
   UT1-KDKG       = T2-KDKG                                                     
   UT1-KVANTAL    = 0                                                           
   UT1-KVPB       = T2-KVPB-SEP + T2-KVPB-SATS                                  
                                                                                
   WS-KVANTAL-F    = 0                                                          
   UT1-IDDC        = T2-IDDC                                                    
   WS-KVANTAL-F  = WS-KVANTAL-F + T2-KVLS + T2-KVEFRS + T2-KVAKS                
   IF WS-KVANTAL-F >= 0                                                         
      UT1-KVANTAL     = WS-KVANTAL-F                                            
   ELSE                                                                         
      UT1-KVANTAL     = 0                                                       
   END-IF                                                                       
   PUT W51264D2                                                                 
*                                                                               
NEWPAGE                                                                         
                                                                                
*-----------------------------------------------------------------*             
* STEG 2 SORT FILE ON THE PART NUMBER                             *             
*        WRITE ONLY WHEN ALL SALES ARE NOT ZERO                   *             
*-----------------------------------------------------------------*             
SORT TPFIL2 TO TPFIL3 USING (T2-IDARTNR T2-IDDC) SIZE 900000                    
                                                                                
JOB INPUT (TPFIL3 KEY(T3-IDARTNR))                                              
   IF FIRST-DUP TPFIL3  OR NOT DUPLICATE TPFIL3                                 
     WS-KVANTAL-R   = 0                                                         
     UT2-IDARTNR    = T3-IDARTNR                                                
     UT3-IDARTNR    = T3-IDARTNR                                                
     UT2-PRARTSTD   = T3-PRARTSTD                                               
     UT3-PRARTSTD   = T3-PRARTSTD                                               
     UT2-KDPRODSL   = T3-KDPRODSL                                               
     UT3-KDPRODSL   = T3-KDPRODSL                                               
     UT2-TIFINLV    = T3-TIFINLV                                                
     UT3-TIFINLV    = T3-TIFINLV                                                
     UT2-KDERS      = T3-KDERS                                                  
     UT3-KDERS      = T3-KDERS                                                  
     UT2-KDKG       = T3-KDKG                                                   
     UT3-KDKG       = T3-KDKG                                                   
     UT2-KVANTAL    = 0                                                         
     UT3-KVANTAL    = 0                                                         
     UT2-KVPB       = T3-KVPB-SEP + T3-KVPB-SATS                                
     UT3-KVPB       = T3-KVPB-SEP + T3-KVPB-SATS                                
   END-IF                                                                       
   IF T3-KVLS   < 0                                                             
     T3-KVLS   = 0                                                              
   END-IF                                                                       
   IF T3-KVEFRS < 0                                                             
     T3-KVEFRS = 0                                                              
   END-IF                                                                       
   IF T3-KVAKS  < 0                                                             
     T3-KVAKS  = 0                                                              
   END-IF                                                                       
   WS-KVANTAL-R  = WS-KVANTAL-R + T3-KVLS + T3-KVEFRS + T3-KVAKS                
   UT2-SEMICOLON = ';'                                                          
*                                                                               
   IF LAST-DUP  TPFIL3 OR NOT DUPLICATE TPFIL3                                  
    IF WS-KVANTAL-R > 0                                                         
     UT2-KVANTAL  = WS-KVANTAL-R                                                
     UT3-KVANTAL  = WS-KVANTAL-R                                                
     PRINT REPORT1                                                              
    ELSE                                                                        
     UT2-KVANTAL  = 0                                                           
     UT3-KVANTAL  = 0                                                           
    END-IF                                                                      
    PUT W51264D4                                                                
   END-IF                                                                       
 NEWPAGE                                                                        
   REPORT   REPORT1              +                                              
            PRINTER W51264D3     +                                              
            PAGESIZE 32000       +                                              
            LINESIZE 137         +                                              
            SPACE 0              +                                              
            NOHEADING            +                                              
            NOSPREAD             +                                              
            NOADJUST             +                                              
            NOPAGE               +                                              
            NODATE                                                              
   LINE 1   UT2-IDARTNR          +                                              
            UT2-SEMICOLON        +                                              
            UT2-PRARTSTD         +                                              
            UT2-SEMICOLON        +                                              
            UT2-KDPRODSL         +                                              
            UT2-SEMICOLON        +                                              
            UT2-KVANTAL          +                                              
            UT2-SEMICOLON        +                                              
            UT2-TIFINLV          +                                              
            UT2-SEMICOLON        +                                              
            UT2-KDERS            +                                              
            UT2-SEMICOLON        +                                              
            UT2-KVPB             +                                              
            UT2-SEMICOLON        +                                              
            UT2-KDKG                                                            
*                                                                               
BEFORE-LINE. PROC                                                               
  IF FIRST-LINE = 'J'                                                           
    DISPLAY 'PART NUMBER;STANDARD PRICE;PRODUCT GROUP;' +                       
            'QUANTITY;PUBLICATION WEEK;' +                                      
            'SUPERSESSION CODE;PERIOD REQUIREMENTS;TURNOVER CODE'               
    FIRST-LINE  = 'N'                                                           
  END-IF                                                                        
END-PROC                                                                        
