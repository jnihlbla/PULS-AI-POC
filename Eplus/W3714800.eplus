*****************************************************************               
*                                                               *               
* STEG 2  SORTERA BYTESFILEN PER IDDC IDDISTR IDBYTRAP          *               
*                                                               *               
*****************************************************************               
                                                                                
SORT W37148D1 TO TPFIL1 USING (IN4B-IDDC IN4B-IDDISTR +                         
                                         IN4B-FLBYTGAR)                         
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* STEG 4  LÄSER TPFIL1                                          *               
*                                                               *               
*****************************************************************               
                                                                                
                                                                                
JOB INPUT(TPFIL1) START INIT-PROC                                               
                                                                                
    W-UT-FIX-1-SE   = W-AAR                                                     
    W-UT-FIX-2-SE   = '-'                                                       
    W-UT-FIX-3-SE   = W-MM                                                      
    W-UT-FIX-4-SE   = '-'                                                       
    W-UT-FIX-5-SE   = W-DD                                                      
    W-UT-FIX-1-GB   = W-DD                                                      
    W-UT-FIX-2-GB   = '-'                                                       
    W-UT-FIX-3-GB   = W-MM                                                      
    W-UT-FIX-4-GB   = '-'                                                       
    W-UT-FIX-5-GB   = W-AAR                                                     
    W-UT-FIX-1-US   = W-MM                                                      
    W-UT-FIX-2-US   = '-'                                                       
    W-UT-FIX-3-US   = W-DD                                                      
    W-UT-FIX-4-US   = '-'                                                       
    W-UT-FIX-5-US   = W-AAR                                                     
  IF T4B-IDDC = CDC-SE                                                          
     W-IDDISTR     = T4B-IDDISTR                                                
     W-KVRETUR     = T4B-KVRETUR                                                
     IF T4B-FLBYTGAR = 'N'                                                      
        W-SUM         = W-KVRETUR                                               
        W-SUM-W       = 0                                                       
     ELSE                                                                       
        W-SUM-W       = W-KVRETUR                                               
        W-SUM         = 0                                                       
     END-IF                                                                     
     PRINT LISTA11                                                              
  END-IF                                                                        
  IF T4B-IDDC = SDC-NL-ET                                                       
     W-IDDISTR     = T4B-IDDISTR                                                
     W-KVRETUR     = T4B-KVRETUR                                                
     IF T4B-FLBYTGAR = 'N'                                                      
        W-SUM2        = W-KVRETUR                                               
        W-SUM2-W      = 0                                                       
     ELSE                                                                       
        W-SUM2-W      = W-KVRETUR                                               
        W-SUM2        = 0                                                       
     END-IF                                                                     
     PRINT LISTA91                                                              
  END-IF                                                                        
  IF T4B-IDDC = NDC-US-RU                                                       
     W-IDDISTR     = T4B-IDDISTR                                                
     W-KVRETUR     = T4B-KVRETUR                                                
     IF T4B-FLBYTGAR = 'N'                                                      
        W-SUM3        = W-KVRETUR                                               
        W-SUM7        = 0                                                       
     ELSE                                                                       
        W-SUM7        = W-KVRETUR                                               
        W-SUM3        = 0                                                       
     END-IF                                                                     
*    PRINT LISTA41                                                              
  END-IF                                                                        
  IF T4B-IDDC = NDC-US-LA                                                       
     W-IDDISTR     = T4B-IDDISTR                                                
     W-KVRETUR     = T4B-KVRETUR                                                
     IF T4B-FLBYTGAR = 'N'                                                      
        W-SUM6        = W-KVRETUR                                               
        W-SUM9        = 0                                                       
     ELSE                                                                       
        W-SUM9        = W-KVRETUR                                               
        W-SUM6        = 0                                                       
     END-IF                                                                     
*    PRINT LISTA43                                                              
  END-IF                                                                        
  IF T4B-IDDC = NDC-CA                                                          
     W-IDDISTR     = T4B-IDDISTR                                                
     W-KVRETUR     = T4B-KVRETUR                                                
     IF T4B-FLBYTGAR = 'N'                                                      
        W-SUM4        = W-KVRETUR                                               
        W-SUM10       = 0                                                       
     ELSE                                                                       
        W-SUM10       = W-KVRETUR                                               
        W-SUM4        = 0                                                       
     END-IF                                                                     
*    PRINT LISTA51                                                              
  END-IF                                                                        
  IF T4B-IDDC = NDC-JP-61                                                       
     W-IDDISTR     = T4B-IDDISTR                                                
     W-KVRETUR     = T4B-KVRETUR                                                
     IF T4B-FLBYTGAR = 'N'                                                      
        W-SUM11       = W-KVRETUR                                               
        W-SUM12       = 0                                                       
     ELSE                                                                       
        W-SUM12       = W-KVRETUR                                               
        W-SUM11       = 0                                                       
     END-IF                                                                     
     PRINT LISTA61                                                              
  END-IF                                                                        
  IF T4B-IDDC = NDC-AU                                                          
     W-IDDISTR     = T4B-IDDISTR                                                
     W-KVRETUR     = T4B-KVRETUR                                                
     IF T4B-FLBYTGAR = 'N'                                                      
        W-SUM13       = W-KVRETUR                                               
        W-SUM14       = 0                                                       
     ELSE                                                                       
        W-SUM14       = W-KVRETUR                                               
        W-SUM13       = 0                                                       
     END-IF                                                                     
     PRINT LISTA62                                                              
  END-IF                                                                        
NEWPAGE                                                                         
INIT-PROC. PROC                                                                 
    CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                           
    W-AAR  = D-AAR                                                              
    W-MM   = D-MAANAD                                                           
    W-DD   = D-DAG                                                              
                                                                                
END-PROC                                                                        
