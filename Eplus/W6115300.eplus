*                                                                               
*                                                                               
PROGRAM-NAMN       W  6  A  VALUE 'W61153'                                      
DATUMKORT-ID       W  6  A  VALUE 'WDATUM'                                      
WS-PREV-IDDC       W  2  A                                                      
WS-IDDC            W  2  A                                                      
WS-KVRADER         W  5  N  MASK 'ZZZZ9'                                        
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
NEWPAGE                                                                         
*                                                                               
*** HÄMTAR AKTUELLA VALUTA-KURSER FÖR USA, CANADA, AUSTR. O JAPAN               
*                                                                               
JOB INPUT W61153D6                                                              
  IF      KURS-SAP-KDVALISO = 'CAD'                                             
     WS-KURS-CAD    = KURS-SAP-PRKURS                                           
  ELSE-IF KURS-SAP-KDVALISO = 'USD'                                             
     WS-KURS-USD    = KURS-SAP-PRKURS                                           
  ELSE-IF KURS-SAP-KDVALISO = 'JPY'                                             
     WS-KURS-JPY    = KURS-SAP-PRKURS                                           
  ELSE-IF KURS-SAP-KDVALISO = 'AUD'                                             
     WS-KURS-AUD    = KURS-SAP-PRKURS                                           
  END-IF                                                                        
                                                                                
JOB INPUT (W61153D1 KEY (IN1-IDDC IN1-KDINLUPF)   +                             
           W61153D2 KEY (IN2-IDDC IN2-KDINLUPF))  +                             
           START A-INIT                                                         
                                                                                
   IF MATCHED                                                                   
      IF IN1-KDINLUPF          = ' '                                            
          IF IN2-IDPTYP        = 'TOT'                                          
             KDINLUPF          = 'TOT '                                         
          ELSE                                                                  
             IF IN2-IDPTYP     = 'CDC'                                          
                KDINLUPF       = 'CDC '                                         
             ELSE                                                               
                IF IN2-IDPTYP  = 'SVS'                                          
                   KDINLUPF    = 'SVS '                                         
                END-IF                                                          
             END-IF                                                             
          END-IF                                                                
      ELSE                                                                      
          KDINLUPF             = IN1-KDINLUPF                                   
      END-IF                                                                    
                                                                                
      IDLEVNR                  = IN2-IDLEVNR                                    
      IF IDLEVNR-1-2 = '99'                                                     
        IDLEVNR-1-2  = '57'                                                     
      END-IF                                                                    
      VLARTNTO                 = IN2-VLARTNTO                                   
      KVART                    = IN2-KVART                                      
      KVART-DAG                = IN2-KVART-DAG                                  
      KVART-KVALL              = IN2-KVART-KVALL                                
      KVRADER                  = IN2-KVRADER                                    
      KVRADER-DAG              = IN2-KVRADER-DAG                                
      KVRADER-KVALL            = IN2-KVRADER-KVALL                              
      SUBEL-GLT                = IN2-SUBEL                                      
      IF IN2-SUBEL > +0                                                         
        SUBEL-GLT-PRIO-PROC    = 100 * IN2-SUBEL-PRIO / IN2-SUBEL               
      ELSE                                                                      
        SUBEL-GLT-PRIO-PROC    = +0                                             
      END-IF                                                                    
      IF IN2-KVRADER > +0                                                       
        KVRADER-GLT-PRIO-PROC  = 100 * IN2-KVRADER-PRIO / IN2-KVRADER           
      ELSE                                                                      
        KVRADER-GLT-PRIO-PROC  = +0                                             
      END-IF                                                                    
      TIGLT                    = IN2-TIGLT                                      
      TIGLT-DAG                = IN2-TIGLT-DAG                                  
      TIGLT-KVALL              = IN2-TIGLT-KVALL                                
      TIGLT-PRIO               = IN2-TIGLT-PRIO                                 
      TIGLT-PRIO-DAG           = IN2-TIGLT-PRIO-DAG                             
      TIGLT-PRIO-KVALL         = IN2-TIGLT-PRIO-KVALL                           
      IF IN2-KVRADER    > +0                                                    
        KVART-MAAL             = 100 * IN2-KVART-MAAL / IN2-KVRADER             
      ELSE                                                                      
        KVART-MAAL             = +0                                             
      END-IF                                                                    
      IF IN2-KVRADER-PRIO    > +0                                               
        KVART-MAAL-PRIO        = 100 * (IN2-KVART-MAAL-PRIO / +                 
                                  IN2-KVRADER-PRIO)                             
      ELSE                                                                      
        KVART-MAAL-PRIO        = +0                                             
      END-IF                                                                    
      UT-IDDC              = IN1-IDDC                                           
      UT-TIAAVV            = W-AAVV                                             
      UT-KDINLUPF          = KDINLUPF                                           
      UT-KVART             = IN1-KVART                                          
      UT-KVKOLLI           = IN1-KVKOLLI                                        
      UT-KVKOLLI-PRIO      = IN1-KVKOLLI-PRIO                                   
      PERFORM S23-CHECK-IN1-IDDC                                                
      IF IN1-IDDC      = NDC-US                                                 
        UT-SUBEL           = IN1-SUBEL / WS-KURS-USD                            
        UT-SUBEL-PRIO      = IN1-SUBEL-PRIO / WS-KURS-USD                       
        UT-SUBEL-GLT       = SUBEL-GLT / WS-KURS-USD                            
        UT-SUBEL-PRIO-GLT  = IN2-SUBEL-PRIO / WS-KURS-USD                       
      ELSE-IF IN1-IDDC = NDC-CA                                                 
        UT-SUBEL           = IN1-SUBEL / WS-KURS-CAD                            
        UT-SUBEL-PRIO      = IN1-SUBEL-PRIO / WS-KURS-CAD                       
        UT-SUBEL-GLT       = SUBEL-GLT / WS-KURS-CAD                            
        UT-SUBEL-PRIO-GLT  = IN2-SUBEL-PRIO / WS-KURS-CAD                       
      ELSE-IF IN1-IDDC = NDC-JP                                                 
        UT-SUBEL           = IN1-SUBEL / WS-KURS-JPY                            
        UT-SUBEL-PRIO      = IN1-SUBEL-PRIO / WS-KURS-JPY                       
        UT-SUBEL-GLT       = SUBEL-GLT / WS-KURS-JPY                            
        UT-SUBEL-PRIO-GLT  = IN2-SUBEL-PRIO / WS-KURS-JPY                       
      ELSE-IF IN1-IDDC = NDC-AU                                                 
        UT-SUBEL           = IN1-SUBEL / WS-KURS-AUD                            
        UT-SUBEL-PRIO      = IN1-SUBEL-PRIO / WS-KURS-AUD                       
        UT-SUBEL-GLT       = SUBEL-GLT / WS-KURS-AUD                            
        UT-SUBEL-PRIO-GLT  = IN2-SUBEL-PRIO / WS-KURS-AUD                       
      ELSE                                                                      
        UT-SUBEL           = IN1-SUBEL                                          
        UT-SUBEL-PRIO      = IN1-SUBEL-PRIO                                     
        UT-SUBEL-GLT       = SUBEL-GLT                                          
        UT-SUBEL-PRIO-GLT  = IN2-SUBEL-PRIO                                     
      END-IF                                                                    
      UT-KVRADER-GLT       = KVRADER                                            
      UT-KVRADER-PRIO-GLT  = IN2-KVRADER-PRIO                                   
      UT-TIGLT             = TIGLT                                              
      UT-TIGLT-PRIO        = TIGLT-PRIO                                         
      WS-KVRADER           = IN1-KVRADER                                        
      WS-IDDC              = IN1-IDDC                                           
                                                                                
      IF IN1-IDDC = NDC-CN AND KDINLUPF = 'TOT '                                
         PRINT CN-LISTB                                                         
      END-IF                                                                    
** TEMPORÄR FULING FÖR ATT KUNNA KÖRA CDC I VIOS (W4XS03/05)                    
      IF KDINLUPF = 'TOT '                                                      
         IF IN1-IDDC      = NDC-US                                              
            UT-KDINLUPF = 'TOT4'                                                
         ELSE-IF IN1-IDDC = NDC-CA                                              
            UT-KDINLUPF = 'TOT5'                                                
         ELSE-IF IN1-IDDC = NDC-JP                                              
            UT-KDINLUPF = 'TOTJ'                                                
         ELSE-IF IN1-IDDC = NDC-AU                                              
            UT-KDINLUPF = 'TOTA'                                                
         ELSE-IF IN1-IDDC = NDC-CN                                              
            UT-KDINLUPF = 'TOTC'                                                
         END-IF                                                                 
      END-IF                                                                    
                                                                                
      PUT W61153D3                                                              
                                                                                
      IF IN1-IDDC = CDC-SE                                                      
         PERFORM EDIT-NUMERIC-VALUES                                            
         WS-REC = REC                                                           
         PUT W61153D4                                                           
      ELSE                                                                      
        IF IN1-IDDC = CDC-TR                                                    
           PRINT ST-LISTA                                                       
        ELSE-IF IN1-IDDC = NDC-CN                                               
           PRINT CN-LISTA                                                       
        END-IF                                                                  
      END-IF                                                                    
   ELSE                                                                         
      IF W61153D1                                                               
        CONTINUE                                                                
*         KDINLUPF              = IN1-KDINLUPF                                  
*         IDLEVNR               = ' '                                           
*         VLARTNTO              = 0                                             
*         KVART                 = 0                                             
*         KVART-DAG             = 0                                             
*         KVART-KVALL           = 0                                             
*         KVRADER               = 0                                             
*         KVRADER-DAG           = 0                                             
*         KVRADER-KVALL         = 0                                             
*         SUBEL-GLT             = 0                                             
*         SUBEL-GLT-PRIO-PROC   = 0                                             
*         KVRADER-GLT-PRIO-PROC = 0                                             
*         TIGLT                 = 0                                             
*         TIGLT-DAG             = 0                                             
*         TIGLT-KVALL           = 0                                             
*         TIGLT-PRIO            = 0                                             
*         TIGLT-PRIO-DAG        = 0                                             
*         TIGLT-PRIO-KVALL      = 0                                             
*         KVART-MAAL            = 0                                             
*         KVART-MAAL-PRIO       = 0                                             
*         UT-IDDC               = IN1-IDDC                                      
*         UT-TIAAVV             = W-AAVV                                        
*         UT-KDINLUPF           = KDINLUPF                                      
*         UT-KVART              = IN1-KVART                                     
*         UT-KVKOLLI            = IN1-KVKOLLI                                   
*         UT-KVKOLLI-PRIO       = IN1-KVKOLLI-PRIO                              
*         PERFORM S23-CHECK-IN1-IDDC                                            
*         IF IN1-IDDC      = NDC-US                                             
*           UT-SUBEL            = IN1-SUBEL / WS-KURS-USD                       
*           UT-SUBEL-PRIO       = IN1-SUBEL-PRIO / WS-KURS-USD                  
*         ELSE-IF IN1-IDDC = NDC-CA                                             
*           UT-SUBEL            = IN1-SUBEL / WS-KURS-CAD                       
*           UT-SUBEL-PRIO       = IN1-SUBEL-PRIO / WS-KURS-CAD                  
*         ELSE-IF IN1-IDDC = NDC-JP                                             
*           UT-SUBEL            = IN1-SUBEL / WS-KURS-JPY                       
*           UT-SUBEL-PRIO       = IN1-SUBEL-PRIO / WS-KURS-JPY                  
*         ELSE-IF IN1-IDDC = NDC-AU                                             
*           UT-SUBEL            = IN1-SUBEL / WS-KURS-AUD                       
*           UT-SUBEL-PRIO       = IN1-SUBEL-PRIO / WS-KURS-AUD                  
*         ELSE                                                                  
*           UT-SUBEL            = IN1-SUBEL                                     
*           UT-SUBEL-PRIO       = IN1-SUBEL-PRIO                                
*         END-IF                                                                
*         UT-KVRADER-GLT        = 0                                             
*         UT-KVRADER-PRIO-GLT   = 0                                             
*         UT-SUBEL-GLT          = 0                                             
*         UT-SUBEL-PRIO-GLT     = 0                                             
*         UT-TIGLT              = 0                                             
*         UT-TIGLT-PRIO         = 0                                             
                                                                                
** TEMPORÄR FULING FÖR ATT KUNNA KÖRA CDC I VIOS (W4XS03/05)                    
*         IF KDINLUPF = 'TOT '                                                  
*            IF      IN1-IDDC = NDC-US                                          
*               UT-KDINLUPF = 'TOT4'                                            
*            ELSE-IF IN1-IDDC = NDC-CA                                          
*               UT-KDINLUPF = 'TOT5'                                            
*            ELSE-IF IN1-IDDC = NDC-JP                                          
*               UT-KDINLUPF = 'TOTJ'                                            
*            ELSE-IF IN1-IDDC = NDC-AU                                          
*               UT-KDINLUPF = 'TOTA'                                            
*            END-IF                                                             
*         END-IF                                                                
                                                                                
*         PUT W61153D3                                                          
*                                                                               
*         IF IN1-IDDC = CDC-SE                                                  
*            PRINT CDC-LISTA                                                    
*         ELSE                                                                  
*           IF IN1-IDDC = CDC-TR                                                
*              PRINT ST-LISTA                                                   
*           END-IF                                                              
*         END-IF                                                                
      ELSE                                                                      
          KDINLUPF             = IN2-KDINLUPF                                   
          IDLEVNR              = IN2-IDLEVNR                                    
          IF IDLEVNR-1-2 = '99'                                                 
            IDLEVNR-1-2  = '57'                                                 
          END-IF                                                                
          VLARTNTO             = IN2-VLARTNTO                                   
          KVART                = IN2-KVART                                      
          KVART-DAG            = IN2-KVART-DAG                                  
          KVART-KVALL          = IN2-KVART-KVALL                                
          KVRADER              = IN2-KVRADER                                    
          KVRADER-DAG          = IN2-KVRADER-DAG                                
          KVRADER-KVALL        = IN2-KVRADER-KVALL                              
          SUBEL-GLT            = IN2-SUBEL                                      
          IF IN2-SUBEL > +0                                                     
            SUBEL-GLT-PRIO-PROC  = (IN2-SUBEL-PRIO / IN2-SUBEL) * 100           
          ELSE                                                                  
            SUBEL-GLT-PRIO-PROC  = +0                                           
          END-IF                                                                
          IF IN2-KVRADER > +0                                                   
            KVRADER-GLT-PRIO-PROC =                       +                     
            (IN2-KVRADER-PRIO / IN2-KVRADER) * 100                              
          ELSE                                                                  
            KVRADER-GLT-PRIO-PROC = +0                                          
          END-IF                                                                
          TIGLT                = IN2-TIGLT                                      
          TIGLT-DAG            = IN2-TIGLT-DAG                                  
          TIGLT-KVALL          = IN2-TIGLT-KVALL                                
          TIGLT-PRIO           = IN2-TIGLT-PRIO                                 
          TIGLT-PRIO-DAG       = IN2-TIGLT-PRIO-DAG                             
          TIGLT-PRIO-KVALL     = IN2-TIGLT-PRIO-KVALL                           
          IF IN2-KVRADER    > +0                                                
            KVART-MAAL         = (IN2-KVART-MAAL / IN2-KVRADER) * 100           
          ELSE                                                                  
            KVART-MAAL = +0                                                     
          END-IF                                                                
          IF IN2-KVRADER-PRIO    > +0                                           
            KVART-MAAL-PRIO    = (IN2-KVART-MAAL-PRIO / +                       
                                  IN2-KVRADER-PRIO) * 100                       
          ELSE                                                                  
            KVART-MAAL-PRIO = +0                                                
          END-IF                                                                
          UT-IDDC              = IN2-IDDC                                       
          UT-TIAAVV            = W-AAVV                                         
          UT-KDINLUPF          = KDINLUPF                                       
          UT-KVART             = 0                                              
          UT-KVKOLLI           = 0                                              
          UT-KVKOLLI-PRIO      = 0                                              
          UT-SUBEL             = 0                                              
          UT-SUBEL-PRIO        = 0                                              
          UT-KVRADER-GLT       = KVRADER                                        
          UT-KVRADER-PRIO-GLT  = IN2-KVRADER-PRIO                               
          PERFORM S23-CHECK-IN2-IDDC                                            
          IF IN2-IDDC      = NDC-US                                             
            UT-SUBEL-GLT       = SUBEL-GLT / WS-KURS-USD                        
            UT-SUBEL-PRIO-GLT  = IN2-SUBEL-PRIO / WS-KURS-USD                   
          ELSE-IF IN2-IDDC = NDC-CA                                             
            UT-SUBEL-GLT       = SUBEL-GLT / WS-KURS-CAD                        
            UT-SUBEL-PRIO-GLT  = IN2-SUBEL-PRIO / WS-KURS-CAD                   
          ELSE-IF IN2-IDDC = NDC-JP                                             
            UT-SUBEL-GLT       = SUBEL-GLT / WS-KURS-JPY                        
            UT-SUBEL-PRIO-GLT  = IN2-SUBEL-PRIO / WS-KURS-JPY                   
          ELSE-IF IN2-IDDC = NDC-AU                                             
            UT-SUBEL-GLT       = SUBEL-GLT / WS-KURS-AUD                        
            UT-SUBEL-PRIO-GLT  = IN2-SUBEL-PRIO / WS-KURS-AUD                   
          ELSE                                                                  
            UT-SUBEL-GLT       = SUBEL-GLT                                      
            UT-SUBEL-PRIO-GLT  = IN2-SUBEL-PRIO                                 
          END-IF                                                                
          UT-TIGLT             = TIGLT                                          
          UT-TIGLT-PRIO        = TIGLT-PRIO                                     
          WS-KVRADER           = IN1-KVRADER                                    
          WS-IDDC              = IN2-IDDC                                       
                                                                                
          IF IN2-IDDC = NDC-CN AND KDINLUPF = 'TOT '                            
             PRINT CN-LISTB                                                     
          END-IF                                                                
** TEMPORÄR FULING FÖR ATT KUNNA KÖRA CDC I VIOS (W4XS03/05)                    
          IF KDINLUPF = 'TOT '                                                  
             IF IN2-IDDC      = NDC-US                                          
                UT-KDINLUPF = 'TOT4'                                            
             ELSE-IF IN2-IDDC = NDC-CA                                          
                UT-KDINLUPF = 'TOT5'                                            
             ELSE-IF IN2-IDDC = NDC-JP                                          
                UT-KDINLUPF = 'TOTJ'                                            
             ELSE-IF IN2-IDDC = NDC-AU                                          
                UT-KDINLUPF = 'TOTA'                                            
             ELSE-IF IN2-IDDC = NDC-CN                                          
                UT-KDINLUPF = 'TOTC'                                            
             END-IF                                                             
          END-IF                                                                
                                                                                
          PUT W61153D3                                                          
                                                                                
          IF IN2-IDDC = CDC-SE                                                  
             PERFORM EDIT-NUMERIC-VALUES                                        
             WS-REC = REC                                                       
             PUT W61153D4                                                       
          ELSE                                                                  
            IF IN2-IDDC = CDC-TR                                                
               PRINT ST-LISTA                                                   
            ELSE-IF IN2-IDDC = NDC-CN                                           
               PRINT CN-LISTA                                                   
            END-IF                                                              
          END-IF                                                                
      END-IF                                                                    
  END-IF                                                                        
                                                                                
 A-INIT. PROC                                                                   
                                                                                
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                      
  W-AA           = D-AAR                                                        
  W-MM           = D-MAANAD                                                     
  W-DD           = D-DAG                                                        
                                                                                
  DAT-KDDATFORM  = 'AAMMDD'                                                     
  DAT-I-TIDATUM  = W-DATUM                                                      
                                                                                
                                                                                
  CALL WDATKONV USING (DAT-KDDATFORM              +                             
                      DAT-I-TIDATUM               +                             
                      DAT-O-TIDATUM               +                             
                      DAT-KDSVAR)                                               
                                                                                
  IF DAT-KDSVAR = 'F'                                                           
    RETURN-CODE = RKOD-16                                                       
    STOP EXECUTE                                                                
  ELSE                                                                          
    W-AAVV-ALFA = DAT-TIAAVV-GRP                                                
  END-IF                                                                        
                                                                                
  HEADER0A = SYSDATE                                                            
  HEADER1A = '     VCCS               '                                         
  HEADER1B = 'AK BELÄGGNINGS/GENOMLOPPSTIDS LISTA 2   W61153-001'               
  WS-REC = HEADER1                                                              
  PUT W61153D4                                                                  
                                                                                
  WS-REC = HEADER3                                                              
  PUT W61153D4                                                                  
                                                                                
  HEADER4A = ';    ; PARTIER; ; ;RADER;    ;VÄRDE;PRIO;PRIO;'                   
  HEADER4B = ';GLT TOTAL;;  ;GLT PRIO;    ;MÅL  ;MÅL ;VOLYM;'                   
  WS-REC = HEADER4                                                              
  PUT W61153D4                                                                  
                                                                                
  HEADER5A = 'OMRÅDE;TOT  ;DAG;KVÄLL  ;TOT  ;DAG;KVÄLL;(SEK);'                  
  HEADER5B = '%RAD;%VÄRD ;TOT   ;DAG ;KVÄLL;TOT   ;DAG ;'                       
  HEADER5C = 'KVÄLL   ;%   ;PRIO%   ;M3   ;AVD'                                 
  WS-REC = HEADER5                                                              
  PUT W61153D4                                                                  
                                                                                
  SEMI1 = ';'                                                                   
  SEMI2 = ';'                                                                   
  SEMI3 = ';'                                                                   
  SEMI4 = ';'                                                                   
  SEMI5 = ';'                                                                   
  SEMI6 = ';'                                                                   
  SEMI7 = ';'                                                                   
  SEMI8 = ';'                                                                   
  SEMI9 = ';'                                                                   
  SEMI10 = ';'                                                                  
  SEMI11 = ';'                                                                  
  SEMI12 = ';'                                                                  
  SEMI13 = ';'                                                                  
  SEMI14 = ';'                                                                  
  SEMI15 = ';'                                                                  
  SEMI16 = ';'                                                                  
  SEMI17 = ';'                                                                  
  SEMI18 = ';'                                                                  
  SEMI19 = ';'                                                                  
                                                                                
 END-PROC                                                                       
                                                                                
*    --- S23-CHECK-IN1-IDDC (MACRO PROCEDURE)                                   
%WWDC02 'IN1-'                                                                  
*                                                                               
*    --- S23-CHECK-IN2-IDDC (MACRO PROCEDURE)                                   
%WWDC02 'IN2-'                                                                  
*                                                                               
 EDIT-NUMERIC-VALUES. PROC                                                      
                                                                                
  W-TIGLT          = TIGLT                                                      
  TIGLT-NUM        = W-TIGLT-NUM                                                
  TIGLT-DEC        = W-TIGLT-DEC                                                
                                                                                
  W-TIGLT-DAG      = TIGLT-DAG                                                  
  TIGLT-DAG-NUM    = W-TIGLT-DAG-NUM                                            
  TIGLT-DAG-DEC    = W-TIGLT-DAG-DEC                                            
                                                                                
  W-TIGLT-KVALL    = TIGLT-KVALL                                                
  TIGLT-KVALL-NUM  = W-TIGLT-KVALL-NUM                                          
  TIGLT-KVALL-DEC  = W-TIGLT-KVALL-DEC                                          
                                                                                
  W-TIGLT-PRIO     = TIGLT-PRIO                                                 
  TIGLT-PRIO-NUM   = W-TIGLT-PRIO-NUM                                           
  TIGLT-PRIO-DEC   = W-TIGLT-PRIO-DEC                                           
                                                                                
  W-TIGLT-PRIO-DAG = TIGLT-PRIO-DAG                                             
  TIGLT-PRIO-DAG-NUM  = W-TIGLT-PRIO-DAG-NUM                                    
  TIGLT-PRIO-DAG-DEC  = W-TIGLT-PRIO-DAG-DEC                                    
                                                                                
  W-TIGLT-PRIO-KVALL = TIGLT-PRIO-KVALL                                         
  TIGLT-PRIO-KVALL-NUM = W-TIGLT-PRIO-KVALL-NUM                                 
  TIGLT-PRIO-KVALL-DEC = W-TIGLT-PRIO-KVALL-DEC                                 
                                                                                
  W-KVART-MAAL       = KVART-MAAL                                               
  KVART-MAAL-NUM     = W-KVART-MAAL-NUM                                         
  KVART-MAAL-DEC     = W-KVART-MAAL-DEC                                         
                                                                                
  W-KVART-MAAL-PRIO  = KVART-MAAL-PRIO                                          
  KVART-MAAL-PRIO-NUM = W-KVART-MAAL-PRIO-NUM                                   
  KVART-MAAL-PRIO-DEC = W-KVART-MAAL-PRIO-DEC                                   
                                                                                
  W-VLARTNTO         = VLARTNTO                                                 
  VLARTNTO-NUM       = W-VLARTNTO-NUM                                           
  VLARTNTO-DEC       = W-VLARTNTO-DEC                                           
                                                                                
 END-PROC                                                                       
