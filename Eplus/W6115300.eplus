*--------------------------*                                                    
* REPORT W61153-002        *                                                    
*--------------------------*                                                    
  REPORT ST-LISTA          +                                                    
         LINESIZE 120      +                                                    
         PRINTER W61153D5  +                                                    
         TITLESKIP 1       +                                                    
         DTLCTL FIRST      +                                                    
         SUMCTL NONE       +                                                    
         NOADJUST          +                                                    
         NOHEADING         +                                                    
         PAGESIZE 38       +                                                    
         SPACE 1                                                                
  TITLE 1  COL  24 'VOLVO CAR AFTERSALES'                      +                
           COL  51 'AK  WORK LOAD/FLOW TIME  LIST 2'           +                
           COL  87 'W61153-002'                                                 
  TITLE 2  COL  24 'WEEKLY LISTING'                       +                     
           COL  51 'PRODUCED   VOL    WFT'                                      
  TITLE 4  COL  44 'VALUE    PRIO   PRIO    WFT'          +                     
           COL  76 'WFT    AIM   AIM PRIO'                                      
  TITLE 5  COL  25 'AREA LOTS  LINES'                     +                     
           COL  44 '(SEK)   %LINES %VALUE  TOTAL'         +                     
           COL  75 'PRIO      %       %'                                        
  LINE 1   COL  25 KDINLUPF               +                                     
           COL  30 KVART                  +                                     
           COL  36 KVRADER                +                                     
           COL  42 SUBEL-GLT              +                                     
           COL  53 KVRADER-GLT-PRIO-PROC  +                                     
           COL  60 SUBEL-GLT-PRIO-PROC    +                                     
           COL  66 TIGLT                  +                                     
           COL  74 TIGLT-PRIO             +                                     
           COL  82 KVART-MAAL             +                                     
           COL  90 KVART-MAAL-PRIO                                              
*                                                                               
*--------------------------*                                                    
* REPORT W61153-003        *                                                    
*--------------------------*                                                    
  REPORT CN-LISTA          +                                                    
         LINESIZE 120      +                                                    
         PRINTER W61153D7  +                                                    
         NOADJUST          +                                                    
         NOHEADING         +                                                    
         NODATE            +                                                    
         NOSPREAD          +                                                    
         SPACE 0                                                                
  LINE 1 WS-IDDC                +                                               
         KDINLUPF               +                                               
         KVART                  +                                               
         KVRADER                +                                               
         KVRADER-GLT-PRIO-PROC  +                                               
         SUBEL-GLT-PRIO-PROC    +                                               
         TIGLT                  +                                               
         TIGLT-PRIO             +                                               
         KVART-MAAL             +                                               
         KVART-MAAL-PRIO        +                                               
         VLARTNTO               +                                               
         W-AAVV                                                                 
BEFORE-LINE. PROC                                                               
  IF WS-IDDC NE WS-PREV-IDDC                                                    
    DISPLAY '¤DAPW61153-003'                                                    
    DISPLAY '¤DAP' WS-IDDC                                                      
    WS-PREV-IDDC = WS-IDDC                                                      
  END-IF                                                                        
END-PROC                                                                        
