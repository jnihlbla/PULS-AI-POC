FILE W51281D1                                                                   
%W51281  'IN-'                                                                  
                                                                                
FILE W51281D2                                                                   
%W01160                                                                         
                                                                                
*---------------------------------------------*                                 
*TEMPFIL FÖR SORTADE ARTIKELFILER             *                                 
*---------------------------------------------*                                 
FILE TPFIL1 FB(66 0)                                                            
%W51281  'T1-'                                                                  
                                                                                
*---------------------------------------------*                                 
* TEMPFIL MED DIVERSE LISTTRANSAR, EJ SUMMERADE                                 
*---------------------------------------------*                                 
FILE TPFIL2 FB(21 0)                                                            
T2-AREA            1 21 A                                                       
T2-IDDC            1  2 A                                                       
T2-KDTRADP         3  4 A                                                       
T2-KDPRODSL        7  2 P                                                       
T2-SUNETT          9 10 P 2                                                     
                                                                                
*---------------------------------------------*                                 
* TEMPFIL MED DIVERSE LISTTRANSAR, EJ DETAIL                                    
*---------------------------------------------*                                 
FILE TPFIL3 FB(68 0)                                                            
%W51281  'T3-'                                                                  
T3-KDPRODSL       67 2 P                                                        
*                                                                               
****** EXCELENS UTFIL                                                           
FILE W51281D3 PRINTER VB(57   0)                                                
                                                                                
****** EXCELENS 2:A TOM X:TE RAD                                                
UT-IDDC          W   2  A                                                       
UT-KDPRODSL      W   2  A                                                       
UT-KDTRADP       W   4  A                                                       
UT-TEXT          W   30 A                                                       
UT-SUMMA-N       W   11 N                                                       
UT-SUMMA-D       W   2  N                                                       
                                                                                
****** EXCELENS UTFIL                                                           
FILE W51281D4 PRINTER VB(127  0)                                                
                                                                                
UT1-IDPTYP          W 3  A                                                      
UT1-IDFAKT          W 7  N                                                      
UT1-IDARTNR         W 9  N                                                      
UT1-IDDC            W 2  A                                                      
UT1-KDPRODSL        W 2  N                                                      
UT1-DAREGDAT        W 8  N                                                      
UT1-KVAVIS          W 7  N                                                      
UT1-PRARTNTO-N      W 11 N                                                      
UT1-PRARTNTO-D      W 2  N                                                      
UT1-PRKURS-N        W 6  N                                                      
UT1-PRKURS-D        W 5  N                                                      
UT1-PRARTNTO-SEK-N  W 11 N                                                      
UT1-PRARTNTO-SEK-D  W 2  N                                                      
UT1-SUNTO-TOT-N     W 13 N                                                      
UT1-SUNTO-TOT-D     W 2  N                                                      
                                                                                
****** EXCELENS FÖRSTA RAD                                                      
RUB-DATUM        W   6  N                                                       
RUB-MÅNAD        W   2  N                                                       
                                                                                
%WDATKORT                                                                       
                                                                                
*-------------*                                                                 
* ARBETSAREOR *                                                                 
*-------------*                                                                 
W-PREV-KDTRADP   W   4 A                                                        
W-PREV-KDTRADP1  W   4 A                                                        
W-KDVALISO       W   3 A                                                        
W-IDDC           W   2 A                                                        
W-KDPRODSL       W   2 N                                                        
W-KDTRADP        W   4 A                                                        
W-SUNETT         W   8 P 2  MASK ('ZZZZZZZZZZZ99.99-')                          
W-PRARTNTO-M     W   8 P 2  MASK ('ZZZZZZZZZZZ99.99')                           
W-PRKURS-M       W   6 P 5  MASK ('ZZZZZ9.99999')                               
W-KVANTAL        W   5 P 0                                                      
IX               W   2 P 0                                                      
W-SEM            W   1 A    VALUE ';'                                           
W-DECIMAL        W   1 A    VALUE '.'                                           
                                                                                
W-SUNETT-FMT                     W  13  N 2                                     
W-SUNETT-N       W-SUNETT-FMT       11  N                                       
W-SUNETT-D       W-SUNETT-FMT +11   2   N                                       
                                                                                
W-PRARTNTO-FMT                   W  13  N 2                                     
W-PRARTNTO-N     W-PRARTNTO-FMT     11  N                                       
W-PRARTNTO-D     W-PRARTNTO-FMT +11  2  N                                       
                                                                                
W-SUNTO-TOT                      W  13  N 2                                     
W-SUNTO-TOT-N  W-SUNTO-TOT          11  N                                       
W-SUNTO-TOT-D  W-SUNTO-TOT      +11  2  N                                       
                                                                                
W-PRARTNTO-SEK                    W  13  N 2                                    
W-PRARTNTO-SEK-N  W-PRARTNTO-SEK     11  N                                      
W-PRARTNTO-SEK-D  W-PRARTNTO-SEK +11  2  N                                      
                                                                                
W-PRKURS-FMT                      W  11  N 5                                    
W-PRKURS-N      W-PRKURS-FMT          6  N                                      
W-PRKURS-D      W-PRKURS-FMT     +6   5  N                                      
                                                                                
PROGRAM-NAMN     W   6   A  VALUE 'W51281'                                      
DATUMKORT-ID     W   6   A  VALUE 'WDATUM'                                      
                                                                                
W-AAMMDD         W   6   N                                                      
W-AA   W-AAMMDD      2   N                                                      
W-MM   W-AAMMDD  +2  2   N                                                      
W-DD   W-AAMMDD  +4  2   N                                                      
                                                                                
BEPRODSL                W 27  A    OCCURS 98                                    
BEPRODSL-PS  BEPRODSL      2  A                                                 
BEPRODSL-TXT BEPRODSL +3  24  A                                                 
                                                                                
NEWPAGE                                                                         
*---------------------------------------------------------------*               
* STEG 1.SORTERA  ARTIKELSALDOPOSTER ALLA DC PER ARTIKELNUMMER  *               
*---------------------------------------------------------------*               
SORT W51281D1 TO TPFIL1 USING(IN-IDARTNR)  SIZE 900000                          
                                                                                
*---------------------------------------------------------------*               
* STEG 2. MATCHA SORTERAD FIL MED ARTIKELINFO O SKRIV TPFIL2    *               
*---------------------------------------------------------------*               
                                                                                
JOB INPUT (W51281D2 KEY (CLAG-IDARTNR) TPFIL1 KEY (T1-IDARTNR)) +               
          START A-INIT                                                          
                                                                                
IF MATCHED                                                                      
  T2-IDDC       = T1-IDDC                                                       
  T2-KDPRODSL   = CLAG-KDPRODSL                                                 
  T2-KDTRADP    = T1-KDTRADP                                                    
  T2-SUNETT     = T1-SUNTO-TOT                                                  
  IF T2-SUNETT NE 0                                                             
    PUT TPFIL2                                                                  
  END-IF                                                                        
                                                                                
  T3-IDPTYP     = T1-IDPTYP                                                     
  T3-IDDC       = T1-IDDC                                                       
  T3-IDARTNR    = T1-IDARTNR                                                    
  T3-KDPRODSL   = CLAG-KDPRODSL                                                 
  T3-DAREGDAT   = T1-DAREGDAT                                                   
  T3-KVAVIS     = T1-KVAVIS                                                     
  T3-PRARTNTO   = T1-PRARTNTO                                                   
  T3-PRKURS     = T1-PRKURS                                                     
  T3-PRARTNTO-SEK = T1-PRARTNTO-SEK                                             
  T3-SUNTO-TOT = T1-SUNTO-TOT                                                   
  T3-KDTRADP    = T1-KDTRADP                                                    
  T3-KDVALISO   = T1-KDVALISO                                                   
  T3-IDFAKT     = T1-IDFAKT                                                     
  IF T3-SUNTO-TOT NE 0                                                          
    PUT TPFIL3                                                                  
  END-IF                                                                        
END-IF                                                                          
                                                                                
A-INIT. PROC                                                                    
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                      
  W-AA       = D-AAR                                                            
  W-MM       = D-MAANAD                                                         
  W-DD       = D-DAG                                                            
  RUB-DATUM  = W-AAMMDD                                                         
  RUB-MÅNAD  = W-MM                                                             
                                                                                
****  INITIERA TABELLER ******                                                  
  BEPRODSL(01) =       '11 SPARE PARTS VCC'                                     
