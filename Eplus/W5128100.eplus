*--------------------------------------------------------*                      
* STEG 3 SORTERA TPFIL2 TILL TPFIL2 PER DC OCH PRODSL                           
*        OCH SUMMERA SAMT SKRIV EXCELFIL                                        
*--------------------------------------------------------*                      
                                                                                
SORT TPFIL2 TO TPFIL2 USING (T2-IDDC T2-KDPRODSL T2-KDTRADP) +                  
                             SIZE 200000                                        
JOB INPUT NULL                                                                  
                                                                                
  GET TPFIL2                                                                    
  IF NOT EOF TPFIL2                                                             
    W-IDDC             = T2-IDDC                                                
    W-KDPRODSL         = T2-KDPRODSL                                            
    W-KDTRADP          = T2-KDTRADP                                             
    W-SUNETT           = 0                                                      
    DO WHILE NOT EOF TPFIL2                                                     
      IF T2-IDDC = W-IDDC AND T2-KDPRODSL = W-KDPRODSL +                        
      AND T2-KDTRADP = W-KDTRADP                                                
        W-SUNETT = W-SUNETT + T2-SUNETT                                         
      ELSE                                                                      
        PERFORM SKRIV-EXCELPOST-1                                               
        PRINT REPORT01                                                          
        W-IDDC             = T2-IDDC                                            
        W-KDPRODSL         = T2-KDPRODSL                                        
        W-KDTRADP          = T2-KDTRADP                                         
        W-SUNETT           = T2-SUNETT                                          
      END-IF                                                                    
      GET TPFIL2                                                                
    END-DO                                                                      
  END-IF                                                                        
  PERFORM SKRIV-EXCELPOST-1                                                     
  IF W-KDTRADP NE ' '                                                           
    PRINT REPORT01                                                              
  END-IF                                                                        
                                                                                
  STOP                                                                          
                                                                                
SKRIV-EXCELPOST-1. PROC                                                         
                                                                                
  UT-IDDC     = W-IDDC                                                          
  UT-KDPRODSL = W-KDPRODSL                                                      
  UT-KDTRADP  = W-KDTRADP                                                       
  UT-TEXT     = 'OTHERS'                                                        
  IX = 1                                                                        
  DO WHILE IX LE 98                                                             
    IF BEPRODSL-PS(IX) EQ UT-KDPRODSL                                           
      UT-TEXT     = BEPRODSL-TXT(IX)                                            
      IX = 99                                                                   
    END-IF                                                                      
    IX = IX + 1                                                                 
  END-DO                                                                        
  W-SUNETT-FMT  = W-SUNETT                                                      
  UT-SUMMA-N    = W-SUNETT-N                                                    
  UT-SUMMA-D    = W-SUNETT-D                                                    
END-PROC                                                                        
                                                                                
************************************************************************        
*** LIST FOR NON VCC - SENT TO D&P                                              
************************************************************************        
  REPORT   REPORT01             +                                               
           PRINTER W51281D3     +                                               
           LINESIZE 52          +                                               
           SPACE 0              +                                               
           NOHEADING            +                                               
           NOSPREAD             +                                               
           NOADJUST             +                                               
           PAGESIZE 32767       +                                               
           NODATE                                                               
LINE  1  UT-IDDC              +                                                 
         W-SEM                +                                                 
         UT-KDPRODSL          +                                                 
         W-SEM                +                                                 
         UT-TEXT              +                                                 
         W-SEM                +                                                 
         UT-SUMMA-N           +                                                 
         W-DECIMAL            +                                                 
         UT-SUMMA-D           +                                                 
         W-SEM                                                                  
*                                                                               
BEFORE-LINE. PROC                                                               
 IF W-KDTRADP NE W-PREV-KDTRADP                                                 
   DISPLAY '¤DAPW51281-001'                                                     
   DISPLAY '¤DAP' W-KDTRADP                                                     
   DISPLAY 'DATE' RUB-DATUM ';PERIOD' RUB-MÅNAD ';'                             
   W-PREV-KDTRADP = W-KDTRADP                                                   
 END-IF                                                                         
END-PROC                                                                        
*--------------------------------------------------------*                      
* STEG 4 SORTERA TPFIL3 TILL TPFIL3 PER DC OCH IDARTNR                          
*--------------------------------------------------------*                      
                                                                                
SORT TPFIL3 TO TPFIL3 USING (T3-IDDC T3-IDARTNR T3-KDTRADP) +                   
                             SIZE 200000                                        
JOB INPUT TPFIL3                                                                
                                                                                
  W-KDTRADP      = T3-KDTRADP                                                   
  W-KDVALISO     = T3-KDVALISO                                                  
                                                                                
  UT1-IDPTYP     = T3-IDPTYP                                                    
  UT1-IDDC       = T3-IDDC                                                      
  UT1-IDARTNR    = T3-IDARTNR                                                   
  UT1-KDPRODSL   = T3-KDPRODSL                                                  
  UT1-DAREGDAT   = T3-DAREGDAT                                                  
  UT1-KVAVIS     = T3-KVAVIS                                                    
  UT1-IDFAKT     = T3-IDFAKT                                                    
                                                                                
  W-PRARTNTO-FMT = T3-PRARTNTO                                                  
  UT1-PRARTNTO-N = W-PRARTNTO-N                                                 
  UT1-PRARTNTO-D = W-PRARTNTO-D                                                 
                                                                                
  W-PRKURS-FMT   = T3-PRKURS                                                    
  UT1-PRKURS-N   = W-PRKURS-N                                                   
  UT1-PRKURS-D   = W-PRKURS-D                                                   
                                                                                
  W-PRARTNTO-SEK   = T3-PRARTNTO-SEK                                            
  UT1-PRARTNTO-SEK-N = W-PRARTNTO-SEK-N                                         
  UT1-PRARTNTO-SEK-D = W-PRARTNTO-SEK-D                                         
                                                                                
  W-SUNTO-TOT     = T3-SUNTO-TOT                                                
  UT1-SUNTO-TOT-N = W-SUNTO-TOT-N                                               
  UT1-SUNTO-TOT-D = W-SUNTO-TOT-D                                               
                                                                                
  PRINT REPORT02                                                                
                                                                                
************************************************************************        
*** LIST FOR NON VCC - SENT TO D&P - PART LEVEL                                 
************************************************************************        
  REPORT   REPORT02             +                                               
           PRINTER W51281D4     +                                               
           LINESIZE 120         +                                               
           SPACE 0              +                                               
           NOHEADING            +                                               
           NOSPREAD             +                                               
           NOADJUST             +                                               
           PAGESIZE 32767       +                                               
           NODATE                                                               
LINE  1  UT1-IDPTYP             +                                               
         W-SEM                  +                                               
         UT1-IDFAKT             +                                               
         W-SEM                  +                                               
         UT1-IDARTNR            +                                               
         W-SEM                  +                                               
         UT1-IDDC               +                                               
         W-SEM                  +                                               
         UT1-KDPRODSL           +                                               
         W-SEM                  +                                               
         UT1-DAREGDAT           +                                               
         W-SEM                  +                                               
         UT1-KVAVIS             +                                               
         W-SEM                  +                                               
         UT1-PRARTNTO-N         +                                               
         W-DECIMAL              +                                               
         UT1-PRARTNTO-D         +                                               
         W-SEM                  +                                               
         UT1-PRARTNTO-SEK-N     +                                               
         W-DECIMAL              +                                               
         UT1-PRARTNTO-SEK-D     +                                               
         W-SEM                  +                                               
         UT1-PRKURS-N           +                                               
         W-DECIMAL              +                                               
         UT1-PRKURS-D           +                                               
         W-SEM                  +                                               
         UT1-SUNTO-TOT-N        +                                               
         W-DECIMAL              +                                               
         UT1-SUNTO-TOT-D        +                                               
         W-SEM                                                                  
*                                                                               
BEFORE-LINE. PROC                                                               
 IF W-KDTRADP NE W-PREV-KDTRADP1                                                
   DISPLAY '¤DAPW51281A-001'                                                    
   DISPLAY '¤DAP' W-KDTRADP                                                     
   DISPLAY 'TYPE;INVOICE NO.;PART NO.;DC;PRODUCT GRP;    +                      
            DATE;QTY;PRICE SEK;                          +                      
            SUM SEK;CURRENCY RATE;SUM ' W-KDVALISO ';'                          
   W-PREV-KDTRADP1 = W-KDTRADP                                                  
 END-IF                                                                         
END-PROC                                                                        
