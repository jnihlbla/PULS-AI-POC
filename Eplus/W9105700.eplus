                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W910 FILER TILL ANDRA SYSTEM                          *        
*                                                                      *        
*  FUNKTION   :  MATCHAR GENERATION 0 COH -1 AV FIL W91055             *        
*                OCH SKICKAR DET FÖRÄNDRADE DATAT TILL VR.             *        
*                                                                      *        
*  FÖRFATTARE :  JOHAN NIHLBLAD                                        *        
*                                                                      *        
*  INFILER    :  W91055 (+0)                                           *        
*                W91055 (-1)                                           *        
*                                                                      *        
*  UTFILER    :  W91057                                                *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W91057D1                                                                   
%W91055  'NY-'                                                                  
*                                                                               
FILE W91057D2                                                                   
%W91055  'GL-'                                                                  
*                                                                               
NEWPAGE                                                                         
FILE W91057D3 FB (205 0)                                                        
%W91055 'UT-'                                                                   
*                                                                               
JOB INPUT (W91057D1 KEY(NY-IDARTNR) W91057D2 KEY(GL-IDARTNR))                   
*                                                                               
IF MATCHED                                                                      
   IF NY-W91055-CTX NE GL-W91055-CTX                                            
      PERFORM S01-SKRIV-UTPOST                                                  
   END-IF                                                                       
ELSE                                                                            
   IF W91057D1                                                                  
      PERFORM S01-SKRIV-UTPOST                                                  
   END-IF                                                                       
END-IF                                                                          
                                                                                
S01-SKRIV-UTPOST.  PROC                                                         
                                                                                
  UT-IDARTNR       = NY-IDARTNR                                                 
  UT-BEARTEXT      = NY-BEARTEXT                                                
  UT-BEARTEXT-RC   = NY-BEARTEXT-RC                                             
  PUT W91057D3                                                                  
END-PROC                                                                        
*                                                                               
