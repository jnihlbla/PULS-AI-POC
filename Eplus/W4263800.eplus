*  PROGRAM    :  W4263800                                              *        
*                                                                      *        
*  FUNKTION   :  KONTROLLRAPPORT EJ BEHANDLADE AV EKONOMI              *        
*                VID REDOVISNINGSPERIOD                                *        
*                                                                      *        
*  FÖRFATTARE :  INGER NILSSON                                         *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W42638D1                                                                   
*                                                                               
%W4265201 'IN-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W42638D2  PRINTER VB (125 0)                                               
                                                                                
FILE W42638D3  PRINTER VB (125 0)                                               
                                                                                
W-IDKR                 W 5 N MASK ('ZZZZ9')                                     
W-IDARTNR              W 5 P                                                    
W-IDLKTO               W 4 P                                                    
W-KDPRODSL             W 2 P                                                    
W-KVART                W 5 P                                                    
W-TOT-VARDE            W 7 P 2                                                  
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
NEWPAGE                                                                         
*                                                                               
* STEG 1. KONTROLLRAPPORTER EJ BEHANDLADE AV EKONOMI                            
*                                                                               
JOB INPUT W42638D1                                                              
                                                                                
   W-KVART     = IN-KVART-RET + IN-KVART-SKROT - IN-KVART-SJUST                 
   W-TOT-VARDE = W-KVART * IN-PRARTSTD                                          
   W-IDKR      = IN-IDKR                                                        
   W-IDARTNR   = IN-IDARTNR                                                     
   W-KDPRODSL  = IN-KDPRODSL                                                    
   W-IDLKTO    = IN-IDLKTO                                                      
                                                                                
   IF IN-IDDC = CDC-SE                                                          
     PRINT LISTA-CDC                                                            
   ELSE                                                                         
     IF IN-IDDC = CDC-TR                                                        
       PRINT LISTA-ST                                                           
     END-IF                                                                     
   END-IF                                                                       
NEWPAGE                                                                         
*                                                                               
REPORT   LISTA-CDC         +                                                    
         PRINTER W42638D2  +                                                    
         PAGESIZE 32000    +                                                    
         LINESIZE 120      +                                                    
         NODATE            +                                                    
         NOPAGE            +                                                    
         NOADJUST                                                               
*                                                                               
SEQUENCE W-IDLKTO W-KDPRODSL                                                    
*                                                                               
CONTROL  W-IDLKTO NOPRINT +                                                     
         W-KDPRODSL                                                             
*                                                                               
SUM      W-TOT-VARDE                                                            
*                                                                               
TITLE 01 '¤DAPW42638-001'                                                       
TITLE 02 '¤DAPW42638'                                                           
TITLE 03 'VOLVO CAR CORP., AFTERSALES         W42638-001' +                     
         '                  DATUM ' SYSDATE                                     
TITLE 05 'KONTROLLRAPPORT EJ BEHANDLADE AV EKONOMI CDC'                         
*                                                                               
HEADING  W-IDKR             ('KR-NR')                                           
HEADING  W-IDARTNR          ('ARTNR')                                           
HEADING  W-IDLKTO           ('LKONTO')                                          
HEADING  W-KDPRODSL         ('PKOD')                                            
HEADING  W-KVART            ('RETUR')                                           
HEADING  IN-PRARTSTD        ('STDPRIS')                                         
HEADING  W-TOT-VARDE        ('TOTAL')                                           
*                                                                               
LINE     W-IDKR W-IDARTNR W-IDLKTO W-KDPRODSL W-KVART IN-PRARTSTD +             
         W-TOT-VARDE                                                            
********************************************************************            
REPORT   LISTA-ST          +                                                    
         PRINTER W42638D3  +                                                    
         PAGESIZE 32000    +                                                    
         LINESIZE 120      +                                                    
         NODATE            +                                                    
         NOPAGE            +                                                    
         NOADJUST                                                               
*                                                                               
*SEQUENCE W-IDLKTO W-KDPRODSL                                                   
*                                                                               
CONTROL  W-IDLKTO NOPRINT +                                                     
         W-KDPRODSL                                                             
*                                                                               
SUM      W-TOT-VARDE                                                            
*                                                                               
TITLE 01 '¤DAPW42638-002'                                                       
TITLE 02 '¤DAPW42638'                                                           
TITLE 03 'VOLVO CAR CORP., AFTERSALES         W42638-002' +                     
         '                  DATUM ' SYSDATE                                     
TITLE 05 'KONTROLLRAPPORT EJ BEHANDLADE AV EKONOMI ST'                          
*                                                                               
HEADING  W-IDKR             ('KR-NR')                                           
HEADING  W-IDARTNR          ('ARTNR')                                           
HEADING  W-IDLKTO           ('LKONTO')                                          
HEADING  W-KDPRODSL         ('PKOD')                                            
HEADING  W-KVART            ('RETUR')                                           
HEADING  IN-PRARTSTD        ('STDPRIS')                                         
HEADING  W-TOT-VARDE        ('TOTAL')                                           
*                                                                               
LINE     W-IDKR W-IDARTNR W-IDLKTO W-KDPRODSL W-KVART IN-PRARTSTD +             
         W-TOT-VARDE                                                            
