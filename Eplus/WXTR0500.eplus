*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT  WXTR05D1                                                  +        
                                                 NAME   STEG01                  
                                                                                
     IF IN-IDDC = '41' THRU '49' '51'                                           
       IF IN-KVEFRS-OPACK = 0 AND +                                             
          IN-KVEFRS-PACK  = 0 AND +                                             
          IN-KVEFRS-SKEPP = 0                                                   
         SPAR-OKS-VAL    =    IN-KVBEART-Q    * IN-PRAVCOST                     
         SPAR-EFR-OP-VAL =    0                                                 
         SPAR-EFR-P-VAL  =    0                                                 
         SPAR-EFR-S-VAL  =    0                                                 
         SPAR-VKARTNTO   =    IN-KVBEART-Q    * IN-VKARTNTO                     
         SPAR-VLARTNTO   =    IN-KVBEART-Q    * IN-VLARTNTO                     
       ELSE                                                                     
         SPAR-OKS-VAL    =    0                                                 
         SPAR-EFR-OP-VAL =    IN-KVEFRS-OPACK * IN-PRAVCOST                     
         SPAR-EFR-P-VAL  =    IN-KVEFRS-PACK  * IN-PRAVCOST                     
         SPAR-EFR-S-VAL  =    IN-KVEFRS-SKEPP * IN-PRAVCOST                     
         SPAR-VKARTNTO   =   (IN-KVEFRS-OPACK + IN-KVEFRS-PACK         +        
                              + IN-KVEFRS-SKEPP)                       +        
                           *  IN-VKARTNTO                                       
         SPAR-VLARTNTO   =   (IN-KVEFRS-OPACK + IN-KVEFRS-PACK         +        
                              + IN-KVEFRS-SKEPP)                       +        
                           *  IN-VLARTNTO                                       
       END-IF                                                                   
     ELSE                                                                       
       IF IN-KVEFRS-OPACK = 0 AND +                                             
          IN-KVEFRS-PACK  = 0 AND +                                             
          IN-KVEFRS-SKEPP = 0                                                   
         SPAR-OKS-VAL    =    IN-KVBEART-Q    * IN-PRARTSTD                     
         SPAR-EFR-OP-VAL =    0                                                 
         SPAR-EFR-P-VAL  =    0                                                 
         SPAR-EFR-S-VAL  =    0                                                 
         SPAR-VKARTNTO   =    IN-KVBEART-Q    * IN-VKARTNTO                     
         SPAR-VLARTNTO   =    IN-KVBEART-Q    * IN-VLARTNTO                     
       ELSE                                                                     
         SPAR-OKS-VAL    =    0                                                 
         SPAR-EFR-OP-VAL =    IN-KVEFRS-OPACK * IN-PRARTSTD                     
         SPAR-EFR-P-VAL  =    IN-KVEFRS-PACK  * IN-PRARTSTD                     
         SPAR-EFR-S-VAL  =    IN-KVEFRS-SKEPP * IN-PRARTSTD                     
         SPAR-VKARTNTO   =   (IN-KVEFRS-OPACK + IN-KVEFRS-PACK         +        
                              + IN-KVEFRS-SKEPP)                       +        
                           *  IN-VKARTNTO                                       
         SPAR-VLARTNTO   =   (IN-KVEFRS-OPACK + IN-KVEFRS-PACK         +        
                              + IN-KVEFRS-SKEPP)                       +        
                           *  IN-VLARTNTO                                       
       END-IF                                                                   
     END-IF                                                                     
     SPAR-OKS-EFOP-VAL =   SPAR-OKS-VAL   + SPAR-EFR-OP-VAL                     
     SPAR-TOTAL-VAL    =   SPAR-OKS-VAL   + SPAR-EFR-OP-VAL      +              
                         + SPAR-EFR-P-VAL + SPAR-EFR-S-VAL                      
                                                                                
     IF IN-KVBEART-Q    > 0 OR                                   +              
        IN-KVEFRS-OPACK > 0                                                     
       SPAR-BACKLOG-LINES = 1                                                   
     ELSE                                                                       
       SPAR-BACKLOG-LINES = 0                                                   
     END-IF                                                                     
                                                                                
     T1-IDDC            = IN-IDDC                                               
     T1-IDPRC           = IN-IDPRC                                              
     T1-KDORDKL         = IN-KDORDKL                                            
     T1-IDDISTR         = IN-IDDISTR                                            
     T1-OKS-VAL         = SPAR-OKS-VAL                                          
     T1-EFR-OP-VAL      = SPAR-EFR-OP-VAL                                       
     T1-EFR-P-VAL       = SPAR-EFR-P-VAL                                        
     T1-EFR-S-VAL       = SPAR-EFR-S-VAL                                        
     T1-OKS-EFOP-VAL    = SPAR-OKS-EFOP-VAL                                     
     T1-TOTAL-VAL       = SPAR-TOTAL-VAL                                        
     T1-BACKLOG-LINES   = SPAR-BACKLOG-LINES                                    
     T1-VKARTNTO        = IN-VKARTNTO                                           
     T1-VLARTNTO        = IN-VLARTNTO                                           
                                                                                
     PUT   WXTR05D4                                                             
                                                                                
     T2-IDDC            = IN-IDDC                                               
     T2-IDPRC           = IN-IDPRC                                              
     T2-KDORDKL         = IN-KDORDKL                                            
     T2-IDDISTR         = IN-IDDISTR                                            
     T2-OKS-VAL         = SPAR-OKS-VAL                                          
     T2-EFR-OP-VAL      = SPAR-EFR-OP-VAL                                       
     T2-EFR-P-VAL       = SPAR-EFR-P-VAL                                        
     T2-EFR-S-VAL       = SPAR-EFR-S-VAL                                        
     T2-OKS-EFOP-VAL    = SPAR-OKS-EFOP-VAL                                     
     T2-TOTAL-VAL       = SPAR-TOTAL-VAL                                        
     T2-BACKLOG-LINES   = SPAR-BACKLOG-LINES                                    
     T2-VKARTNTO        = IN-VKARTNTO                                           
     T2-VLARTNTO        = IN-VLARTNTO                                           
                                                                                
     PUT   WXTR05D6                                                             
                                                                                
NEWPAGE                                                                         
                                                                                
  JOB INPUT WXTR05D6                                             +              
                                                 START  A-INIT   +              
                                          FINISH S01-SKRIV-FIL   +              
                                         NAME STEG02                            
                                                                                
     IF RECORD-COUNT     = 1                                                    
       W-TOTAL-LINES     = 0                                                    
       W-OKS-VAL         = 0                                                    
       W-EFR-OP-VAL      = 0                                                    
       W-EFR-P-VAL       = 0                                                    
       W-EFR-S-VAL       = 0                                                    
       W-OKS-EFOP-VAL    = 0                                                    
       W-TOTAL-VAL       = 0                                                    
       W-BACKLOG-LINES   = 0                                                    
       W-VKARTNTO        = 0                                                    
       W-VLARTNTO        = 0                                                    
       TEST-IDDC         = T2-IDDC                                              
       TEST-IDPRC        = T2-IDPRC                                             
       TEST-KDORDKL      = T2-KDORDKL                                           
       TEST-IDDISTR      = T2-IDDISTR                                           
     END-IF                                                                     
                                                                                
     IF TEST-IDDC        = T2-IDDC    AND                        +              
        TEST-IDPRC       = T2-IDPRC   AND                        +              
        TEST-KDORDKL     = T2-KDORDKL AND                        +              
        TEST-IDDISTR     = T2-IDDISTR                                           
       W-TOTAL-LINES     = W-TOTAL-LINES   + 1                                  
       W-OKS-VAL         = W-OKS-VAL       + T2-OKS-VAL                         
       W-EFR-OP-VAL      = W-EFR-OP-VAL    + T2-EFR-OP-VAL                      
       W-EFR-P-VAL       = W-EFR-P-VAL     + T2-EFR-P-VAL                       
       W-EFR-S-VAL       = W-EFR-S-VAL     + T2-EFR-S-VAL                       
       W-OKS-EFOP-VAL    = W-OKS-EFOP-VAL  + T2-OKS-EFOP-VAL                    
       W-TOTAL-VAL       = W-TOTAL-VAL     + T2-TOTAL-VAL                       
       W-BACKLOG-LINES   = W-BACKLOG-LINES + T2-BACKLOG-LINES                   
       W-VKARTNTO        = W-VKARTNTO      + T2-VKARTNTO                        
       W-VLARTNTO        = W-VLARTNTO      + T2-VLARTNTO                        
     ELSE                                                                       
                                                                                
       PERFORM S01-SKRIV-FIL                                                    
                                                                                
       W-TOTAL-LINES     = 1                                                    
       W-OKS-VAL         = T2-OKS-VAL                                           
       W-EFR-OP-VAL      = T2-EFR-OP-VAL                                        
       W-EFR-P-VAL       = T2-EFR-P-VAL                                         
       W-EFR-S-VAL       = T2-EFR-S-VAL                                         
       W-OKS-EFOP-VAL    = T2-OKS-EFOP-VAL                                      
       W-TOTAL-VAL       = T2-TOTAL-VAL                                         
       W-BACKLOG-LINES   = T2-BACKLOG-LINES                                     
       W-VKARTNTO        = T2-VKARTNTO                                          
       W-VLARTNTO        = T2-VLARTNTO                                          
                                                                                
       TEST-IDDC         = T2-IDDC                                              
       TEST-IDPRC        = T2-IDPRC                                             
       TEST-KDORDKL      = T2-KDORDKL                                           
       TEST-IDDISTR      = T2-IDDISTR                                           
     END-IF                                                                     
                                                                                
  NEWPAGE                                                                       
                                                                                
NEWPAGE                                                                         
                                                                                
  A-INIT.  PROC                                                                 
                                                                                
      DAT-KDDATFORM = 'IDAG  '                                                  
                                                                                
      CALL WDATKONV USING (DAT-KDDATFORM                         +              
                           DAT-I-TIDATUM                         +              
                           DAT-O-TIDATUM                         +              
                           DAT-KDSVAR    )                                      
                                                                                
      IF DAT-KDSVAR = FEL                                                       
         DISPLAY '        '                                                     
         DISPLAY '        '                                                     
         DISPLAY '        '                                                     
         DISPLAY ' FEL FRÅN DATKONV!!!!'                                        
         DISPLAY '        '                                                     
         DISPLAY '        '                                                     
         DISPLAY '        '                                                     
         RETURN-CODE = RKOD-16                                                  
         STOP EXECUTE                                                           
      END-IF                                                                    
                                                                                
    END-PROC                                                                    
                                                                                
  S01-SKRIV-FIL. PROC                                                           
                                                                                
    UT-TIAAVV        = DAT-TIAAVV-GRP                                           
    UT-IDDC          = TEST-IDDC                                                
    UT-IDPRC         = TEST-IDPRC                                               
    UT-KDORDKL       = TEST-KDORDKL                                             
    UT-IDDISTR       = TEST-IDDISTR                                             
    UT-TOTAL-LINES   = W-TOTAL-LINES                                            
    UT-OKS-VAL       = W-OKS-VAL                                                
    UT-EFR-OP-VAL    = W-EFR-OP-VAL                                             
    UT-EFR-P-VAL     = W-EFR-P-VAL                                              
    UT-EFR-S-VAL     = W-EFR-S-VAL                                              
    UT-OKS-EFOP-VAL  = W-OKS-EFOP-VAL                                           
    UT-TOTAL-VAL     = W-TOTAL-VAL                                              
    UT-BACKLOG-LINES = W-BACKLOG-LINES                                          
    UT-VKARTNTO      = W-VKARTNTO                                               
    UT-VLARTNTO      = W-VLARTNTO                                               
                                                                                
    PUT WXTR05D3                                                                
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  SORT WXTR05D4 TO WXTR05D4 USING (T1-IDDC                       +              
                                   T1-IDDISTR)                   +              
                                                 NAME   STEG04                  
                                                                                
NEWPAGE                                                                         
                                                                                
  JOB INPUT (WXTR05D2 KEY (TAB-IDDC                              +              
                           TAB-IDDISTR)                          +              
             WXTR05D4 KEY (T1-IDDC                               +              
                           T1-IDDISTR ))                         +              
                                                 NAME   STEG05                  
   IF MATCHED                                                                   
     PR-BELAND         = TAB-BELAND                                             
     PR-SORTFALT       = 1                                                      
     PR-IDDC           = T1-IDDC                                                
     PR-IDPRC          = T1-IDPRC                                               
     PR-KDORDKL        = T1-KDORDKL                                             
     PR-IDDISTR        = T1-IDDISTR                                             
     PR-OKS-VAL        = T1-OKS-VAL                                             
     PR-EFR-OP-VAL     = T1-EFR-OP-VAL                                          
     PR-EFR-P-VAL      = T1-EFR-P-VAL                                           
     PR-OKS-EFOP-VAL   = T1-OKS-EFOP-VAL                                        
     PR-TOTAL-VAL      = T1-TOTAL-VAL                                           
     PR-BACKLOG-LINES  = T1-BACKLOG-LINES                                       
     PR-TOTAL-LINES    = 1                                                      
     IF T1-IDDC = '41' THRU '49' '51'                                           
       IF T1-IDDC = '41' THRU '49'                                              
         PR-VKARTNTO     = T1-VKARTNTO           * CONV-KG-TO-LB                
         PR-VLARTNTO     = T1-VLARTNTO / 1000000 * CONV-M3-TO-FT3               
         PR-CURRENCY     = USD                                                  
         PR-WEIGHT-UNITS = POUNDS                                               
         PR-VOLUME-UNITS = FT3                                                  
       ELSE                                                                     
         PR-VKARTNTO     = T1-VKARTNTO           * CONV-KG-TO-LB                
         PR-VLARTNTO     = T1-VLARTNTO / 1000000 * CONV-M3-TO-FT3               
*        PR-VKARTNTO     = T1-VKARTNTO                                          
*        PR-VLARTNTO     = T1-VLARTNTO / 1000                                   
         PR-CURRENCY     = CAD                                                  
         PR-WEIGHT-UNITS = POUNDS                                               
         PR-VOLUME-UNITS = FT3                                                  
*        PR-WEIGHT-UNITS = KILOS                                                
*        PR-VOLUME-UNITS = LITERS                                               
       END-IF                                                                   
     ELSE                                                                       
       PR-VKARTNTO     = T1-VKARTNTO                                            
       PR-VLARTNTO     = T1-VLARTNTO / 1000                                     
       PR-CURRENCY     = SEK                                                    
       PR-WEIGHT-UNITS = KILOS                                                  
       PR-VOLUME-UNITS = LITERS                                                 
     END-IF                                                                     
     PRINT RAPPORT01                                                            
   ELSE                                                                         
     IF WXTR05D4                                                                
       PR-BELAND         = 'MISC'                                               
       PR-SORTFALT       = 9                                                    
       PR-IDDC           = T1-IDDC                                              
       PR-IDPRC          = T1-IDPRC                                             
       PR-KDORDKL        = T1-KDORDKL                                           
       PR-IDDISTR        = T1-IDDISTR                                           
       PR-OKS-VAL        = T1-OKS-VAL                                           
       PR-EFR-OP-VAL     = T1-EFR-OP-VAL                                        
       PR-EFR-P-VAL      = T1-EFR-P-VAL                                         
       PR-OKS-EFOP-VAL   = T1-OKS-EFOP-VAL                                      
       PR-TOTAL-VAL      = T1-TOTAL-VAL                                         
       PR-BACKLOG-LINES  = T1-BACKLOG-LINES                                     
       PR-TOTAL-LINES    = 1                                                    
       IF T1-IDDC = '41' THRU '49' '51'                                         
         IF T1-IDDC = '41' THRU '49'                                            
           PR-VKARTNTO     = T1-VKARTNTO           * CONV-KG-TO-LB              
           PR-VLARTNTO     = T1-VLARTNTO / 1000000 * CONV-M3-TO-FT3             
           PR-CURRENCY     = USD                                                
           PR-WEIGHT-UNITS = POUNDS                                             
           PR-VOLUME-UNITS = FT3                                                
         ELSE                                                                   
           PR-VKARTNTO     = T1-VKARTNTO           * CONV-KG-TO-LB              
           PR-VLARTNTO     = T1-VLARTNTO / 1000000 * CONV-M3-TO-FT3             
*          PR-VKARTNTO     = T1-VKARTNTO                                        
*          PR-VLARTNTO     = T1-VLARTNTO / 1000                                 
           PR-CURRENCY     = CAD                                                
           PR-WEIGHT-UNITS = POUNDS                                             
           PR-VOLUME-UNITS = FT3                                                
*          PR-WEIGHT-UNITS = KILOS                                              
*          PR-VOLUME-UNITS = LITERS                                             
         END-IF                                                                 
       ELSE                                                                     
         PR-VKARTNTO     = T1-VKARTNTO                                          
         PR-VLARTNTO     = T1-VLARTNTO / 1000                                   
         PR-CURRENCY     = SEK                                                  
         PR-WEIGHT-UNITS = KILOS                                                
         PR-VOLUME-UNITS = LITERS                                               
       END-IF                                                                   
       PRINT RAPPORT01                                                          
     END-IF                                                                     
   END-IF                                                                       
                                                                                
