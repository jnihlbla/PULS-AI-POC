NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE W47533D1                                                                   
*                                                                               
%W4753201    'IN-'                                                              
NEWPAGE                                                                         
                                                                                
FILE W47533D2 PRINTER                                                           
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
 W01-IDFAKT        W   7  N     MASK 'ZZZZZZ9'                                  
 W01-IDDISTR       W   4  N     MASK 'ZZZ9'                                     
 W01-IDKUNDNR      W   6  N     MASK 'ZZZZZ9'                                   
 W01-IDORDNR7      W   7  N     MASK 'ZZZZZZ9'                                  
 W01-IDPRODNR      W   7  N     MASK 'ZZZZZZ9'                                  
 W01-IDKOLLI       W   5  N     MASK 'ZZZZ9'                                    
 W01-TIFAKT        W   6  N     MASK 'ZZZZZ9'                                   
 W01-KDORDKL       W   1  N                                                     
                                                                                
%WY2000W1                                                                       
 W-Y2K-TIFAKT      W   6  N                                                     
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT  W47533D1                                            +              
                                                  NAME   STEG01                 
    W01-IDDISTR   = IN-IDDISTR                                                  
    W01-IDKUNDNR  = IN-IDKUNDNR                                                 
    W01-IDFAKT    = IN-IDFAKT                                                   
    W01-TIFAKT    = IN-TIFAKT                                                   
    W01-IDORDNR7  = IN-IDORDNR7                                                 
    W01-IDPRODNR  = IN-IDPRODNR                                                 
    W01-IDKOLLI   = IN-IDKOLLI                                                  
    W01-KDORDKL   = IN-KDORDKL                                                  
                                                                                
    TMP1-YYMMDD   = W01-TIFAKT                                                  
    PERFORM WY2000P1                                                            
    W-Y2K-TIFAKT  = TMP1-YYMMDD                                                 
                                                                                
    PRINT RAPPORT01                                                             
%WY2000P1                                                                       
NEWPAGE                                                                         
*                                                                               
    REPORT RAPPORT01 PRINTER W47533D2                            +              
                     LINESIZE     120                            +              
                     PAGESIZE      41                            +              
                     NODATE                                      +              
                     NOADJUST                                    +              
                     NOSPREAD                                    +              
                     SUMSPACE       0                            +              
                     SPACE          3                                           
*                                                                               
    SEQUENCE W01-IDDISTR                                         +              
             W01-IDKUNDNR                                        +              
             W-Y2K-TIFAKT                                          +            
             W01-IDFAKT                                          +              
             W01-IDORDNR7                                                       
*                                                                               
    CONTROL FINAL NOPRINT                                        +              
    W01-IDDISTR NOPRINT                                          +              
    W01-IDKUNDNR NOPRINT                                                        
*                                                                               
    TITLE 01                                                     +              
    COL   02 'VOLVO CAR PARTS               W47533-001'                         
*                                                                               
    TITLE 04                                                     +              
    COL   12 'FAKTURERADE KOLLIN - ÄNNU EJ VALDA TILL TULLEN'    +              
    COL   62 SYSDATE                                                            
    HEADING   W01-IDDISTR      'DISTR'                                          
    HEADING   W01-IDKUNDNR     'KUND'                                           
    HEADING   W01-IDFAKT       'FAKTURA'                                        
    HEADING   W01-TIFAKT       'FAKTDAT'                                        
    HEADING   W01-IDORDNR7     'ORDER'                                          
    HEADING   W01-IDPRODNR     'PRODNR'                                         
    HEADING   W01-IDKOLLI      'KOLLI'                                          
    HEADING   W01-KDORDKL      'KLASS'                                          
*                                                                               
    LINE 01                                                      +              
              W01-IDDISTR                                        +              
              W01-IDKUNDNR                                       +              
              W01-IDFAKT                                         +              
              W01-TIFAKT                                         +              
              W01-IDORDNR7                                       +              
              W01-IDPRODNR                                       +              
              W01-IDKOLLI                                        +              
              W01-KDORDKL                                                       
