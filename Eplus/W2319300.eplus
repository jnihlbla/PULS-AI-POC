%W23192    'IN-'                                                                
*                                                                               
FILE W23193D3 FB(754 0)                                                         
*                                                                               
%W23192    'UT-'                                                                
UT-ALLT    1  754  A                                                            
                                                                                
NEWPAGE                                                                         
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*                                                                               
* STEG 1.                                                                       
JOB INPUT (W23193D1 KEY (CLAG-IDARTNR) +                                        
           W23193D2 KEY (IN-IDARTNR))                                           
                                                                                
     IF MATCHED                                                                 
        UT-ALLT         =  IN-ALLT                                              
        UT-KDPRODSL     =  CLAG-KDPRODSL                                        
