                                                                                
FILE W85007D1                                                                   
%W850010E  'D1-'                                                                
FILLERD1    1 107 A                                                             
CONSTD1     180  9 A                                                            
D1-FLYTT    158 11 A                                                            
NEWPAGE                                                                         
***                                                                             
FILE W85007D2                                                                   
%W850013E  'D2-'                                                                
D2-FYLL1   42 30 A                                                              
D2-FYLL2   93 16 A                                                              
D2-FYLL3   119 42 A                                                             
NEWPAGE                                                                         
***                                                                             
FILE W85007D3 FB (245 6125)                                                     
%W850012E 'UT-'                                                                 
FILLERUT 1 107 A                                                                
CONSTUT  180  9 A                                                               
UT-FYLL1 58 30 A                                                                
UT-FYLL2 188 16 A                                                               
UT-FYLL3 204 42 A                                                               
NEWPAGE                                                                         
***                                                                             
A3  W 6 N 0                                                                     
A4  W 6 N 0                                                                     
A5  W 6 N 0                                                                     
                                                                                
*    -- CHECKED BY WY2000                                                       
***                                                                             
JOB INPUT (W85007D1 KEY(D1-PARTNO) W85007D2 KEY(D2-PARTNO)) +                   
          FINISH RAPPORT                                                        
IF MATCHED                                                                      
  UT-FYLL1 = D2-FYLL1                                                           
  UT-FYLL2 = D2-FYLL2                                                           
  UT-FYLL3 = D2-FYLL3                                                           
  UT-RECTYP = D2-RECTYP                                                         
  UT-DISTNO1 = D2-DISTNO01                                                      
  UT-DISTNO2 = D2-DISTNO02                                                      
  UT-PARTNO = D2-PARTNO                                                         
  UT-BENAME = D2-BENAME                                                         
  UT-PRICE = D2-PRICE                                                           
  UT-KDVSOP1X = D2-KDVSOP1A                                                     
  UT-KDVSOP2X = D2-KDVSOP2A                                                     
  UT-KDVSOP3X = D2-KDVSOP3A                                                     
  UT-PRODGRP = D2-PRODGRP                                                       
  UT-KVHAND = D2-KVHAND                                                         
  UT-KVORDER = D2-KVORDER                                                       
  UT-KVFCAST = D2-KVFCAST                                                       
  UT-KVVRM = D2-KVVRM                                                           
  UT-KVVRA = D2-KVVRA                                                           
  UT-FSGIAR = D1-FSGIAR                                                         
  UT-FSGFAR = D1-FSGFAR                                                         
  A5 = A5 + 1                                                                   
  PUT W85007D3                                                                  
ELSE                                                                            
IF W85007D1                                                                     
  IF D1-KVHAND NOT NUMERIC OR D1-KVHAND < 0                                     
    D1-KVHAND = 0                                                               
  END-IF                                                                        
  IF D1-KVORDER NOT NUMERIC OR D1-KVORDER < 0                                   
    D1-KVORDER = 0                                                              
  END-IF                                                                        
  IF D1-KVFCAST NOT NUMERIC OR D1-KVFCAST < 0                                   
    D1-KVFCAST = 0                                                              
  END-IF                                                                        
  PERFORM DÖDTEST                                                               
  PERFORM VOLYMLÖS                                                              
  FILLERUT = FILLERD1                                                           
  CONSTUT = CONSTD1                                                             
  UT-TILEAD = D1-TILED                                                          
  UT-KVTEOR = D1-KVTEOR                                                         
  UT-INF1 = D1-INF1                                                             
  UT-INF2 = D1-INF2                                                             
  UT-VINF1 = D1-FLYTT                                                           
  UT-FSGIAR = D1-FSGIAR                                                         
  UT-FSGFAR = D1-FSGFAR                                                         
  PUT W85007D3                                                                  
END-IF                                                                          
END-IF                                                                          
* HÄR SLÄNGS DÖDA ARTIKLAR                                                      
DÖDTEST. PROC                                                                   
  IF D1-KVHAND = 0 AND D1-KVORDER = 0                                           
    A4 = A4 + 1                                                                 
    GOTO JOB                                                                    
  END-IF                                                                        
END-PROC                                                                        
* HÄR BEHANDLAS ARTIKLAR UTAN VOLYM                                             
VOLYMLÖS. PROC                                                                  
  IF D1-IDFELKOD = 2 AND D1-KVHAND >= 1                                         
    UT-KVVRM = D1-KVVSOPM * D1-VRC                                              
    UT-KVVRA = D1-KVVSOPA * D1-VRC                                              
    UT-KVVSOPM = D1-KVHAND                                                      
    UT-KVVSOPA = D1-KVHAND                                                      
    UT-KVREALM = D1-KVHAND                                                      
    UT-KVREALA = D1-KVHAND                                                      
    UT-KVPRESEN = D1-KVHAND                                                     
  END-IF                                                                        
  IF D1-IDFELKOD = 2                                                            
    IF D1-KVHAND < 1 AND D1-KVORDER < 1                                         
      UT-KVVSOPM = 1                                                            
      UT-KVVSOPA = 1                                                            
    END-IF                                                                      
  END-IF                                                                        
  IF D1-IDFELKOD = 2                                                            
    UT-ADVSOP21 = 010                                                           
    UT-ADVSOP22 = 010                                                           
    UT-ADVSOP23 = 010                                                           
    UT-ADVSOP24 = 010                                                           
    UT-KVEQUIP1 = 99999                                                         
    UT-KVEQUIP2 = 99999                                                         
    UT-KVEQUIP3 = 99999                                                         
    UT-KVEQUIP4 = 99999                                                         
    UT-KVFRAME1 = 0                                                             
    UT-KVFRAME2 = 0                                                             
    UT-KVFRAME3 = 0                                                             
    UT-KVFRAME4 = 0                                                             
    UT-KDLEVEL1 = 1                                                             
    UT-KDLEVEL2 = 1                                                             
    UT-KDLEVEL3 = 1                                                             
    UT-KDLEVEL4 = 1                                                             
    UT-RECTYP = 012                                                             
    A3 = A3 + 1                                                                 
  END-IF                                                                        
END-PROC                                                                        
***                                                                             
RAPPORT. PROC                                                                   
  DISPLAY NEWPAGE COL 3, 'V.S.O.P', COL 50, 'MERGED OUTPUT FILE +               
                  CONTROL LIST', COL 95, SYSDATE                                
  DISPLAY SKIP 5  COL 3, 'LIVING PARTS', COL 55, A3                             
  DISPLAY SKIP 2  COL 3, 'DEAD PARTS', COL 55, A4                               
  DISPLAY SKIP 2  COL 3, 'ANALYSED PARTS', COL 55, A5                           
END-PROC                                                                        
