                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W3711B00                                              *        
*                                                                      *        
*  FUNKTION   :  TAB DELIMITER                                         *        
*                                                                      *        
*  FÖRFATTARE :  SRINADH NADIMPALLI                                    *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE INFIL01                                                                    
%W37112X                                                                        
*                                                                               
FILE UTFIL01   VB(172 FULLTRK)                                                  
UT-REC                                  1   172   A                             
UT-RAPP-IDDISTR                         1     4   N                             
UT-RAPP-IDBYTRAP                        6     7   N                             
UT-RAPP-ADBYTANK                       14    10   A                             
UT-RAPP-FLBYTGAR                       25     1   A                             
UT-RAPP-FLBYGODK                       27     1   A                             
UT-RAPP-IDFAKT                         29     7   N                             
UT-RAPP-IDKUNDNR                       37     6   N                             
UT-RAPP-IDDC                           44     2   A                             
UT-RAPP-IDUSER                         47     8   A                             
UT-RAPP-KDBYTBEK                       56     1   A                             
UT-RAPP-KDBYTSTA-AVL                   58     1   A                             
UT-RAPP-KDBYTSTA-RAPP                  60     1   A                             
UT-RAPP-KVRETUR-TOT                    62     7   N                             
UT-RAPP-DAANKDAG                       70     8   N                             
UT-RAPP-DAREGDAT                       79     8   N                             
UT-RAPP-DAREGDAT-GODK                  88     8   N                             
UT-OBJ-IDBYTRAD                        97     5   N                             
UT-OBJ-IDARTNR-OBJ                    103     8   N                             
UT-OBJ-IDTABNR                        112     3   N                             
UT-OBJ-BERADREF                       116    10   A                             
UT-OBJ-IDORDER                        127     7   N                             
UT-OBJ-KDBYTREF                       135     3   A                             
UT-OBJ-KDBYTSTA-AVL                   139     1   A                             
UT-OBJ-KDBYTSTA-OBJ                   141     1   A                             
UT-OBJ-KVRETUR-GODK                   143     7   N                             
UT-OBJ-KVRETUR-URSP                   151     7   N                             
UT-OBJ-IDBYTRAP-9KOMPL                159     7   N                             
UT-OBJ-FLSKROT                        167     1   A                             
*                                                                               
FILE LISTDD  PRINTER                                                            
*                                                                               
    W-FLD                   W     0014  N 4                                     
    W-FLD-INTEGER   W-FLD         0010  N                                       
    W-FLD-DECIMAL   W-FLD +10     0004  A                                       
    W-ED                    W     0015  A                                       
    W-ED-INTSIGN   W-ED           0001  A  OCCURS 10 INDEX SIGN-X               
    W-ED-INTEGER    W-ED          0010  A                                       
    W-ED-DECDOT     W-ED   +10    0001  A                                       
    W-ED-DECIMAL    W-ED   +11    0004  A                                       
    W-ED-DECSIGN    W-ED-DECIMAL 0001   A  OCCURS 4     INDEX SIGN-XX           
*                                                                               
    W-CONC-I                W     0254  A                                       
    W-CONC-ISIGN    W-CONC-I      0001  A  OCCURS 254 -                         
                             INDEX (INX, INX-STOP)                              
    W-CONC-U                W     4096  A                                       
    W-CONC-USIGN    W-CONC-U      0001  A  OCCURS 4096  INDEX UTX               
*                                                                               
    W-FLDAV                 W     0001  A    VALUE '	'                          
    W-DECAV                 W     0001  A    VALUE ','                          
*                                                                               
JOB INPUT INFIL01                                                               
               PERFORM MAIN-SECTION                                             
*                                                                               
MAIN-SECTION. PROC                                                              
               W-FLDAV = '	'                                                    
               MOVE ' ' TO W-CONC-U FILL ' '                                    
               UTX = 1                                                          
               MOVE RAPP-IDDISTR TO W-CONC-I                                    
               INX = 4                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-IDBYTRAP TO W-CONC-I                                   
               INX = 7                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-ADBYTANK TO W-CONC-I                                   
               INX = 10                                                         
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-FLBYTGAR TO W-CONC-I                                   
               INX = 1                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-FLBYGODK TO W-CONC-I                                   
               INX = 1                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-IDFAKT TO W-CONC-I                                     
               INX = 7                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-IDKUNDNR TO W-CONC-I                                   
               INX = 6                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-IDDC TO W-CONC-I                                       
               INX = 2                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-IDUSER TO W-CONC-I                                     
               INX = 8                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-KDBYTBEK TO W-CONC-I                                   
               INX = 1                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-KDBYTSTA-AVL TO W-CONC-I                               
               INX = 1                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-KDBYTSTA-RAPP TO W-CONC-I                              
               INX = 1                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-KVRETUR-TOT TO W-CONC-I                                
               INX = 7                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-DAANKDAG TO W-CONC-I                                   
               INX = 8                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-DAREGDAT TO W-CONC-I                                   
               INX = 8                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE RAPP-DAREGDAT-GODK TO W-CONC-I                              
               INX = 8                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE OBJ-IDBYTRAD TO W-CONC-I                                    
               INX = 5                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE OBJ-IDARTNR-OBJ TO W-CONC-I                                 
               INX = 8                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE OBJ-IDTABNR TO W-CONC-I                                     
               INX = 3                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE OBJ-BERADREF TO W-CONC-I                                    
               INX = 10                                                         
               PERFORM CONCATENATE-CHAR                                         
               MOVE OBJ-IDORDER TO W-CONC-I                                     
               INX = 7                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE OBJ-KDBYTREF TO W-CONC-I                                    
               INX = 3                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE OBJ-KDBYTSTA-AVL TO W-CONC-I                                
               INX = 1                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE OBJ-KDBYTSTA-OBJ TO W-CONC-I                                
               INX = 1                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE OBJ-KVRETUR-GODK TO W-CONC-I                                
               INX = 7                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE OBJ-KVRETUR-URSP TO W-CONC-I                                
               INX = 7                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE OBJ-IDBYTRAP-9KOMPL TO W-CONC-I                             
               INX = 7                                                          
               PERFORM CONCATENATE-CHAR                                         
               W-FLDAV = ' '                                                    
               MOVE OBJ-FLSKROT TO W-CONC-I                                     
               INX = 1                                                          
               PERFORM CONCATENATE-CHAR                                         
               UT-REC = W-CONC-U                                                
               RECORD-LENGTH(UTFIL01) = UTX - 1                                 
               PUT UTFIL01                                                      
END-PROC                                                                        
CONCATENATE-CHAR. PROC                                                          
               PERFORM PACK-TO-OUTPUT                                           
               IF W-FLDAV ^= ' '                                                
                 W-CONC-USIGN (UTX) = W-FLDAV                                   
                 UTX = UTX + 1                                                  
               END-IF                                                           
END-PROC                                                                        
*                                                                               
CONCATENATE-NUM. PROC                                                           
               INX = 18                                                         
               PERFORM PACK-TO-OUTPUT                                           
               IF W-FLDAV ^= ' '                                                
                 W-CONC-USIGN (UTX) = W-FLDAV                                   
                 UTX = UTX + 1                                                  
               END-IF                                                           
END-PROC                                                                        
*                                                                               
PACK-TO-OUTPUT. PROC                                                            
               DO WHILE INX > 0 AND W-CONC-ISIGN (INX) = ' '                    
                 INX = INX - 1                                                  
               END-DO                                                           
               INX-STOP = INX                                                   
               INX = 1                                                          
               DO WHILE INX < INX-STOP AND W-CONC-ISIGN (INX) = ' '             
                  INX = INX + 1                                                 
               END-DO                                                           
               DO WHILE INX <= INX-STOP                                         
                 W-CONC-USIGN (UTX) = W-CONC-ISIGN (INX)                        
                 INX = INX + 1                                                  
                 UTX = UTX + 1                                                  
               END-DO                                                           
END-PROC                                                                        
*                                                                               
EDIT-NUM. PROC                                                                  
               W-ED-DECDOT = W-DECAV                                            
               W-ED-INTEGER = W-FLD-INTEGER                                     
               SIGN-X = 0                                                       
               DO WHILE SIGN-X < 10 AND W-ED-INTSIGN (SIGN-X) < '1'             
                 IF W-ED-INTSIGN (SIGN-X) = '0'                                 
                   W-ED-INTSIGN (SIGN-X) = ' '                                  
                 END-IF                                                         
                 SIGN-X = SIGN-X + 1                                            
               END-DO                                                           
               IF W-FLD < 0                                                     
                 SIGN-X = SIGN-X - 1                                            
                 W-ED-INTSIGN (SIGN-X) = '-'                                    
               END-IF                                                           
               W-ED-DECIMAL = W-FLD-DECIMAL OR X'000000F0'                      
               SIGN-XX = 4                                                      
               DO WHILE SIGN-XX > 0 AND W-ED-DECSIGN (SIGN-XX) = '0'            
                 W-ED-DECSIGN (SIGN-XX) = ' '                                   
                 SIGN-XX = SIGN-XX - 1                                          
               END-DO                                                           
               IF W-ED-DECIMAL = ' '                                            
                 W-ED-DECDOT = ' '                                              
               END-IF                                                           
END-PROC                                                                        
