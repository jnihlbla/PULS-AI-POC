                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5124400                                              *        
*                                                                      *        
*  FUNKTION   :  LAGERVÄRDESRAPPORT UTAN "SLATT"                       *        
*                ANVÄNDER DATUMKORT                                    *        
*                                                                      *        
*  FÖRFATTARE :  RONNY STENHOLM                                        *        
*                                                                      *        
*  INDATA .... : W512.W500R1.W51238(+0)                                *        
*                                                                      *        
*  LISTA  .... : W51244-001                                            *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W51244D1                                                                   
*                                                                               
%W51239  'IN-'                                                                  
*                                                                               
*--------------------------*                                                    
* DATUMKORT                *                                                    
*--------------------------*                                                    
*                                                                               
PROGRAM-NAMN           W   8   A        VALUE 'W5124400'                        
DATUMKORT-ID           W   6   A        VALUE 'WDATUM'                          
%WDATKORT                                                                       
*                                                                               
AKT-TIAAVVDD           W                 6  N  MASK '99/99/99'                  
AKT-AAR                AKT-TIAAVVDD      2  N                                   
AKT-MAANAD             AKT-TIAAVVDD +2   2  N                                   
AKT-DAG                AKT-TIAAVVDD +4   2  N                                   
*                                                                               
IX                     W   3   N                                                
W-KDPRODSL             W   3   P                                                
W-KDVALISO             W   3   A                                                
W-SUARTVLV-INK         W   7   P 2                                              
W-SUARTVLV-PR          W   7   P 2                                              
W-DIFF                 W   9   N 2  MASK ( A '-.---.---,99')                    
NEWPAGE                                                                         
FILE W51244D2  PRINTER FB (121 121)                                             
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. LAGERVÄRDESRAPPORT PRINTNING                                          
                                                                                
JOB INPUT (W51244D1) START INIT                                                 
                                                                                
  W-KDPRODSL = IN-KDPRODSL                                                      
                                                                                
  IX = 1                                                                        
  DO WHILE IX < 6                                                               
    IF IN-SUARTVLV-PR(IX) GT +0                                                 
****                                              RÄKNAR UT NUVÄRDET **         
      W-SUARTVLV-INK  = IN-KVANTMOT(IX) * IN-PRINK / IN-RETULF                  
      W-SUARTVLV-PR   = IN-SUARTVLV-PR(IX)                                      
      W-KDVALISO      = IN-KDVALISO(IX)                                         
      W-DIFF          = W-SUARTVLV-PR - W-SUARTVLV-INK                          
      PRINT LISTAN                                                              
    END-IF                                                                      
    IX = IX + 1                                                                 
  END-DO                                                                        
                                                                                
INIT. PROC                                                                      
                                                                                
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                      
  AKT-AAR       =       D-AAR                                                   
  AKT-MAANAD    =       D-MAANAD                                                
  AKT-DAG       =       D-DAG                                                   
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
REPORT LISTAN  PRINTER W51244D2 LINESIZE 120 SUMCTL HIAR SUMMARY   +            
               NODATE NOADJUST                                                  
                                                                                
SEQUENCE W-KDPRODSL                                      +                      
         W-KDVALISO                                                             
                                                                                
CONTROL  FINAL NOPRINT                                   +                      
         W-KDPRODSL NEWPAGE                              +                      
         W-KDVALISO                                                             
                                                                                
SUM W-SUARTVLV-INK                                       +                      
    W-SUARTVLV-PR                                        +                      
    W-DIFF                                                                      
                                                                                
    TITLE 1  COL  4  'VCCS'                              +                      
             COL  27 'W51244-001'                        +                      
             COL  45 'VARULAGERVÄRDERING (EXKL "SLATT")' +                      
             COL  95 AKT-TIAAVVDD                                               
                                                                                
    TITLE 2  COL  01 '   '                                                      
                                                                                
    TITLE 3  COL  27 'JÄMFÖRELSE MELLAN INKÖPSPRIS EXKL HEMT.FAKTOR +           
                     (NUVÄRDE) OCH'                                             
                                                                                
    TITLE 4  COL  27 'UTL. BESTÄLLNINGSPRIS * VALUTAFAKTOR +                    
                     (ANSKAFFNINGSVÄRDE)'                                       
                                                                                
HEADING  W-KDPRODSL ('        PKOD       ')                                     
HEADING  W-KDVALISO ('    VALUTA    ')                                          
HEADING  W-SUARTVLV-INK  ('           NUVÄRDE')                                 
HEADING  W-SUARTVLV-PR ('     ANSKAFFNINGSV')                                   
HEADING  W-DIFF  ('     DIFFERENS')                                             
LINE  1  W-KDPRODSL W-KDVALISO W-SUARTVLV-INK       +                           
         W-SUARTVLV-PR      W-DIFF                                              
                                                                                
  BEFORE-BREAK. PROC                                                            
    IF LEVEL = 3                                                                
       DISPLAY  ' '                                                             
       DISPLAY  COL 001 'TOTALT'                            +                   
             COL 051 W-SUARTVLV-INK                         +                   
             COL 075 W-SUARTVLV-PR                          +                   
             COL 099 W-DIFF                                                     
    END-IF                                                                      
  END-PROC                                                                      
