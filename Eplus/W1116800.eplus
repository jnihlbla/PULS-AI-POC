*----------------------------------------------------------------------*        
*  W11168D1   :  W111.W111Y1.W11168  FRÅN FÖREGÅENDE JOB                        
*----------------------------------------------------------------------*        
NEWPAGE                                                                         
FILE W11168D1                                                                   
%W11168    'IN-'                                                                
*                                                                               
FILE W11168D2  VB (75 27900)                                                    
%W1116A    'UT1-'                                                               
*                                                                               
FILE W11168D3  VB (75 27900)                                                    
%W1116A    'UT2-'                                                               
*                                                                               
FILE W11168D4  VB (81 27864)                                                    
%W1116C    'UT3-'                                                               
*                                                                               
NEWPAGE                                                                         
%WDATKORT 'DATKORT-'                                                            
                                                                                
PROGRAM-NAMN      W   6   A   VALUE 'W01186'                                    
DATUMKORT-ID      W   6   A   VALUE 'WDATUM'                                    
                                                                                
INNEV-AAVV        W                4  N                                         
INNEV-AA          INNEV-AAVV       2  N                                         
INNEV-VV          INNEV-AAVV  +2   2  N                                         
FOREG-AAVV        W                4  N                                         
FOREG-AA          FOREG-AAVV       2  N                                         
FOREG-VV          FOREG-AAVV  +2   2  N                                         
FORE2-AAVV        W                4  N                                         
FORE2-AA          FORE2-AAVV       2  N                                         
FORE2-VV          FORE2-AAVV  +2   2  N                                         
*                                                                               
RUBA1                     W 71 A                                                
RUBA1-IDARTNR    RUBA1       9 A VALUE ' '                                      
RUBA1-SEM1       RUBA1 +9    1 A VALUE ';'                                      
RUBA1-SVEBEN     RUBA1 +10  25 A VALUE ' '                                      
RUBA1-SEM2       RUBA1 +35   1 A VALUE ';'                                      
RUBA1-IDANMNR    RUBA1 +36   6 A VALUE 'A-'                                     
RUBA1-SEM3       RUBA1 +42   1 A VALUE ';'                                      
RUBA1-IDVARINF   RUBA1 +43   4 A VALUE 'VARU'                                   
RUBA1-SEM4       RUBA1 +47   1 A VALUE ';'                                      
RUBA1-VIKT       RUBA1 +48  11 A VALUE '  '                                     
RUBA1-SEM5       RUBA1 +58   1 A VALUE ';'                                      
RUBA1-SULEVANT   RUBA1 +59   9 A VALUE 'ANTAL'                                  
RUBA1-SEM6       RUBA1 +68   1 A VALUE ';'                                      
RUBA1-KDERS      RUBA1 +69   2 A VALUE '  '                                     
*                                                                               
RUBA2                     W 71 A                                                
RUBA2-IDARTNR    RUBA2       9 A VALUE 'ARTIKELNR'                              
RUBA2-SEM1       RUBA2 +9    1 A VALUE ';'                                      
RUBA2-SVEBEN     RUBA2 +10  25 A VALUE 'BENÄMNING'                              
RUBA2-SEM2       RUBA2 +35   1 A VALUE ';'                                      
RUBA2-IDANMNR    RUBA2 +36   6 A VALUE 'NUMMER'                                 
RUBA2-SEM3       RUBA2 +42   1 A VALUE ';'                                      
RUBA2-IDVARINF   RUBA2 +43   4 A VALUE 'INFO'                                   
RUBA2-SEM4       RUBA2 +47   1 A VALUE ';'                                      
RUBA2-VIKT       RUBA2 +48  11 A VALUE 'VIKT'                                   
RUBA2-SEM5       RUBA2 +58   1 A VALUE ';'                                      
RUBA2-FOREG-20   RUBA2 +59   2 A VALUE '20'                                     
RUBA2-FOREG-AA   RUBA2 +61   2 N                                                
RUBA2-FOREG      RUBA2 +63   5 A VALUE '    '                                   
RUBA2-SEM6       RUBA2 +68   1 A VALUE ';'                                      
RUBA2-KDERS      RUBA2 +69   2 A VALUE 'EK'                                     
*                                                                               
RUBC1                     W 77 A                                                
RUBC1-IDARTNR    RUBC1       9 A VALUE ' '                                      
RUBC1-SEM1       RUBC1 +9    1 A VALUE ';'                                      
RUBC1-SVEBEN     RUBC1 +10  25 A VALUE ' '                                      
RUBC1-SEM2       RUBC1 +35   1 A VALUE ';'                                      
RUBC1-IDANMNR    RUBC1 +36   6 A VALUE 'A-'                                     
RUBC1-SEM3       RUBC1 +42   1 A VALUE ';'                                      
RUBC1-IDVARINF   RUBC1 +43   4 A VALUE 'VARU'                                   
RUBC1-SEM4       RUBC1 +47   1 A VALUE ';'                                      
RUBC1-VIKT       RUBC1 +48  11 A VALUE '  '                                     
RUBC1-SEM5       RUBC1 +58   1 A VALUE ';'                                      
RUBC1-SULEVANT   RUBC1 +59   9 A VALUE 'ANTAL'                                  
RUBC1-SEM6       RUBC1 +68   1 A VALUE ';'                                      
RUBC1-TIERSDAT   RUBC1 +69   5 A VALUE 'ERS-'                                   
RUBC1-SEM7       RUBC1 +74   1 A VALUE ';'                                      
RUBC1-KDERS      RUBC1 +75   2 A VALUE '  '                                     
*                                                                               
RUBC2                     W 77 A                                                
RUBC2-IDARTNR    RUBC2       9 A VALUE 'ARTIKELNR'                              
RUBC2-SEM1       RUBC2 +9    1 A VALUE ';'                                      
RUBC2-SVEBEN     RUBC2 +10  25 A VALUE 'BENÄMNING'                              
RUBC2-SEM2       RUBC2 +35   1 A VALUE ';'                                      
RUBC2-IDANMNR    RUBC2 +36   6 A VALUE 'NUMMER'                                 
RUBC2-SEM3       RUBC2 +42   1 A VALUE ';'                                      
RUBC2-IDVARINF   RUBC2 +43   4 A VALUE 'INFO'                                   
RUBC2-SEM4       RUBC2 +47   1 A VALUE ';'                                      
RUBC2-VIKT       RUBC2 +48  11 A VALUE 'VIKT'                                   
RUBC2-SEM5       RUBC2 +58   1 A VALUE ';'                                      
RUBC2-FOREG-20   RUBC2 +59   2 A VALUE '20'                                     
RUBC2-FOREG-AA   RUBC2 +61   2 N                                                
RUBC2-FOREG      RUBC2 +63   5 A VALUE '    '                                   
RUBC2-SEM6       RUBC2 +68   1 A VALUE ';'                                      
RUBC2-TIERSDAT   RUBC2 +69   5 A VALUE 'DATUM'                                  
RUBC2-SEM7       RUBC2 +74   1 A VALUE ';'                                      
RUBC2-KDERS      RUBC2 +75   2 A VALUE 'EK'                                     
*                                                                               
 HELP-DATE                W  5 N                                                
 HELP-YY   HELP-DATE         2 N                                                
 HELP-WW   HELP-DATE +2      2 N                                                
 HELP-DAY  HELP-DATE +4      1 N                                                
*                                                                               
  WS-VKFORSFG             W  9 N 3                                              
  WS-HELTAL  WS-VKFORSFG     6 N                                                
  WS-DECIMAL WS-VKFORSFG  +6 3 N                                                
*                                                                               
JOB INPUT(W11168D1 KEY IN-IDARTNR)  +                                           
  START(A-INIT)                                                                 
*                                                                               
   HELP-DATE = IN-TIFINLV                                                       
   IF HELP-YY = FOREG-AA                                                        
      IF IN-KDERS > 20                                                          
         IF IN-SULEVANT = 0                                                     
            HELP-DATE = IN-TIERSDAT                                             
            IF HELP-YY = FORE2-AA FOREG-AA                                      
               PERFORM C-LISTA3                                                 
            END-IF                                                              
         ELSE                                                                   
            IF IN-IDVARINF-SDS = '2000' '2001' '2101' '2601' '2602'             
               PERFORM B-LISTA2                                                 
            ELSE                                                                
               PERFORM A-LISTA1                                                 
            END-IF                                                              
         END-IF                                                                 
      ELSE                                                                      
         IF IN-IDVARINF-SDS = '2000' '2001' '2101' '2601' '2602'                
            PERFORM B-LISTA2                                                    
         ELSE                                                                   
            PERFORM A-LISTA1                                                    
         END-IF                                                                 
      END-IF                                                                    
   ELSE                                                                         
      IF IN-KDERS > 20                                                          
         IF IN-SULEVANT = 0                                                     
            HELP-DATE = IN-TIERSDAT                                             
            IF HELP-YY = FORE2-AA FOREG-AA                                      
               PERFORM C-LISTA3                                                 
            END-IF                                                              
         ELSE                                                                   
            IF IN-IDVARINF-SDS = '2000' '2001' '2101' '2601' '2602'             
               PERFORM B-LISTA2                                                 
            ELSE                                                                
               PERFORM A-LISTA1                                                 
            END-IF                                                              
         END-IF                                                                 
      ELSE                                                                      
         IF IN-IDVARINF-SDS = '2000' '2001' '2101' '2601' '2602'                
            PERFORM B-LISTA2                                                    
         ELSE                                                                   
            PERFORM A-LISTA1                                                    
         END-IF                                                                 
      END-IF                                                                    
   END-IF                                                                       
*                                                                               
A-LISTA1. PROC                                                                  
*                                                                               
   IF IN-VKFORSFG <  100.000                                                    
   ELSE                                                                         
      IF IN-VKFORSFG = 0                                                        
      ELSE                                                                      
         UT1-IDARTNR       = IN-IDARTNR                                         
         UT1-SVEBEN        = IN-SVEBEN                                          
         UT1-IDANMNR       = IN-IDANMNR                                         
         UT1-IDVARINF      = IN-IDVARINF                                        
*        UT1-IDVARINF-SDS  = IN-IDVARINF-SDS                                    
         UT1-SULEVANT      = IN-SULEVANT                                        
         WS-VKFORSFG       = IN-VKFORSFG                                        
         UT1-HELTAL        = WS-HELTAL                                          
         UT1-PUNKT         = '.'                                                
         UT1-DECIMAL       = WS-DECIMAL                                         
         UT1-KDERS         = IN-KDERS                                           
         UT1-FILLER01      = ';'                                                
         UT1-FILLER02      = ';'                                                
         UT1-FILLER03      = ';'                                                
         UT1-FILLER04      = ';'                                                
         UT1-FILLER05      = ';'                                                
         UT1-FILLER06      = ';'                                                
                                                                                
         PUT W11168D2                                                           
     END-IF                                                                     
  END-IF                                                                        
*                                                                               
END-PROC                                                                        
*                                                                               
B-LISTA2. PROC                                                                  
*                                                                               
      IF IN-VKFORSFG = 0                                                        
      ELSE                                                                      
         UT2-IDARTNR       = IN-IDARTNR                                         
         UT2-SVEBEN        = IN-SVEBEN                                          
         UT2-IDANMNR       = IN-IDANMNR                                         
         UT2-IDVARINF      = IN-IDVARINF                                        
*        UT2-IDVARINF-SDS  = IN-IDVARINF-SDS                                    
         UT2-SULEVANT      = IN-SULEVANT                                        
         WS-VKFORSFG       = IN-VKFORSFG                                        
         UT2-HELTAL        = WS-HELTAL                                          
         UT2-PUNKT         = '.'                                                
         UT2-DECIMAL       = WS-DECIMAL                                         
         UT2-KDERS         = IN-KDERS                                           
         UT2-FILLER01      = ';'                                                
         UT2-FILLER02      = ';'                                                
         UT2-FILLER03      = ';'                                                
         UT2-FILLER04      = ';'                                                
         UT2-FILLER05      = ';'                                                
         UT2-FILLER06      = ';'                                                
                                                                                
         PUT W11168D3                                                           
     END-IF                                                                     
*                                                                               
END-PROC                                                                        
*                                                                               
C-LISTA3. PROC                                                                  
*                                                                               
      UT3-IDARTNR       = IN-IDARTNR                                            
      UT3-SVEBEN        = IN-SVEBEN                                             
      UT3-IDANMNR       = IN-IDANMNR                                            
      UT3-IDVARINF      = IN-IDVARINF                                           
*     UT3-IDVARINF-SDS  = IN-IDVARINF-SDS                                       
      WS-VKFORSFG       = IN-VKFORSFG                                           
      UT3-HELTAL        = WS-HELTAL                                             
      UT3-PUNKT         = '.'                                                   
      UT3-DECIMAL       = WS-DECIMAL                                            
      UT3-SULEVANT      = IN-SULEVANT                                           
      UT3-TIERSDAT      = IN-TIERSDAT                                           
      UT3-KDERS         = IN-KDERS                                              
      UT3-FILLER01      = ';'                                                   
      UT3-FILLER02      = ';'                                                   
      UT3-FILLER03      = ';'                                                   
      UT3-FILLER04      = ';'                                                   
      UT3-FILLER05      = ';'                                                   
      UT3-FILLER06      = ';'                                                   
      UT3-FILLER07      = ';'                                                   
                                                                                
      PUT W11168D4                                                              
*                                                                               
END-PROC                                                                        
*                                                                               
                                                                                
A-INIT. PROC                                                                    
  CALL DATKORT  USING (PROGRAM-NAMN +                                           
                       DATUMKORT-ID +                                           
                       DATKORT-DATUMKORT)                                       
  INNEV-AA      = DATKORT-D-AAR                                                 
  FOREG-AA      = DATKORT-D-AAR - 1                                             
  FORE2-AA      = DATKORT-D-AAR - 2                                             
  RUBA2-FOREG-AA   = FOREG-AA                                                   
  RUBC2-FOREG-AA   = FOREG-AA                                                   
*                                                                               
  UT1-W1116A       = RUBA1                                                      
      PUT W11168D2                                                              
  UT1-W1116A       = RUBA2                                                      
      PUT W11168D2                                                              
  UT2-W1116A       = RUBA1                                                      
      PUT W11168D3                                                              
  UT2-W1116A       = RUBA2                                                      
      PUT W11168D3                                                              
  UT3-W1116C       = RUBC1                                                      
      PUT W11168D4                                                              
  UT3-W1116C       = RUBC2                                                      
      PUT W11168D4                                                              
  END-PROC                                                                      
************************************************************************        
