**********************************************************************          
*                                                                    *          
* PROGRAM ............ : W56056                                      *          
*                                                                    *          
* SKRIVET AV ......... : ANDERS HENRIKSSON                           *          
*                                                                    *          
* DATUM .............. : 161012                                      *          
*                                                                    *          
* FUNKTION .. : TAR FRAM SALDON DAGLIGEN                             *          
*                                                                    *          
* INDATA .... : W011.W01160(+0) EXTRAKT WDK6                         *          
*               W011.W01184(+0) EXTRAKT WDK7 (NDC NA)                *          
*                                                                    *          
* UTDATA..... : W56056                                               *          
*                                                                    *          
**********************************************************************          
*                                                                               
* INFIL W011.W01160(+0) ARTIKEL EXTRAKTFIL WDK6                                 
FILE W56056D1                                                                   
%W01160 'IN60-'                                                                 
                                                                                
* ARTIKELEXTRAKT WDK7 NDC NA W01184(+0)                                         
FILE W56056D2                                                                   
%W01184  'IN84-'                                                                
                                                                                
* ARTIKELEXTRAKTFIL WDK7 SORTERAD PÅ ARTIKELNR OCH IDDC                         
FILE TPFIL1 FB(483 0)                                                           
%W01184 'T1-'                                                                   
                                                                                
* DAG FIL MED SALDON                                                            
FILE W56056D3 FB(291 0)                                                         
%W56056   'UT56-'                                                               
                                                                                
                                                                                
*****************************************************************               
*                                                               *               
* STEG 1  SORTERA K7-LAGERBANDET PER IDARTNR OCH IDDC           *               
*                                                               *               
*****************************************************************               
                                                                                
SORT W56056D2 TO TPFIL1 USING (IN84-SLAG-IDARTNR IN84-SLAG-IDDC) +              
                 SIZE 300000                                                    
                                                                                
*****************************************************************               
*                                                               *               
* STEG 2  MATCHA TPFIL1 K7-LAGERBAND(IN84-) MED K6-LAGERBAND,   *               
*         OCH SKAPA EN UTPOST PER K7-LAGERBANDSPOST             *               
*                                                               *               
*****************************************************************               
                                                                                
JOB INPUT(W56056D1 KEY (IN60-CLAG-IDARTNR)                      +               
            TPFIL1 KEY (T1-SLAG-IDARTNR))                                       
                                                                                
IF MATCHED                                                                      
  UT56-IDARTNR      = IN60-CLAG-IDARTNR                                         
  UT56-IDDC         = T1-SLAG-IDDC                                              
  UT56-KDSORT       = IN60-CLAG-KDSORT                                          
  UT56-PRAVCOST     = T1-SLAG-PRAVCOST                                          
  UT56-KVLS         = T1-SLAG-KVLS                                              
  UT56-KVOKS-DAG    = T1-SLAG-KVOKS-DAG                                         
  UT56-KVOKS-BULK   = T1-SLAG-KVOKS-BULK                                        
  UT56-KVEFRS       = T1-SLAG-KVEFRS                                            
  UT56-KVROS-DAG    = T1-SLAG-KVROS-DAG                                         
  UT56-KVROS-BULK   = T1-SLAG-KVROS-BULK                                        
  UT56-KVAKS-PAV    = T1-SLAG-KVAKS-PAV                                         
  UT56-KVAKS-SDC    = T1-SLAG-KVAKS-SDC                                         
  UT56-KVSPARR-KVAL = T1-SLAG-KVSPARR-KVAL                                      
  UT56-KVUTRS       = T1-SLAG-KVUTRS                                            
  IF IN60-CLAG-KDERS > 0                                                        
    IF T1-SLAG-KVLS > 0                                                         
      PUT W56056D3                                                              
    END-IF                                                                      
  ELSE                                                                          
    IF T1-SLAG-KVLS > 0                                                         
      PUT W56056D3                                                              
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
