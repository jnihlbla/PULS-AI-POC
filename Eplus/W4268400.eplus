                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4268400                                              *        
*                                                                      *        
*  FUNKTION   :  PROGRAM SOM SKRIVER UT ALLA ARTIKLAR MED SPÄRRKOD =20 *        
*                PÅ LISTA                                              *        
*                                                                      *        
*  FÖRFATTARE :  EVA LUNDELL                                           *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W42684D1                                                                   
*                                                                               
%W4268301 'AKT-'                                                                
                                                                                
                                                                                
                                                                                
FILE W42684D2 PRINTER FB (121 121)                                              
NEWPAGE                                                                         
***********WORKING STORAGE**********                                            
WS-IDARTNR     W  9  N  MASK 'ZZZZZZZZ9'                                        
WS-IDANSK      W  3  P                                                          
WS-IDANSK-TEST W  1  P                                                          
W-PROCURER     W  3  A                                                          
WS-KDLEVSP     W  4  N  MASK 'ZZZ9'                                             
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
  JOB INPUT W42684D1                                                            
                                                                                
       WS-IDARTNR  = AKT-IDARTNR                                                
       WS-KDLEVSP  = AKT-KDLEVSP                                                
       WS-IDANSK-TEST = AKT-IDANSK / 100                                        
       IF WS-IDANSK-TEST = +5                                                   
           W-PROCURER = '5XX'                                                   
           PRINT LISTA-001                                                      
       ELSE                                                                     
           IF WS-IDANSK-TEST = +6                                               
               W-PROCURER = '6XX'                                               
               PRINT LISTA-001                                                  
           ELSE                                                                 
               IF WS-IDANSK-TEST = +7                                           
                   W-PROCURER = '7XX'                                           
                   PRINT LISTA-001                                              
               ELSE                                                             
                   IF WS-IDANSK-TEST = +8                                       
                       W-PROCURER = '8XX'                                       
                       PRINT LISTA-001                                          
                   ELSE                                                         
                       IF WS-IDANSK = +9                                        
                           PRINT LISTA-001                                      
                           W-PROCURER = '9XX'                                   
                       ELSE                                                     
                           W-PROCURER = 'XXX'                                   
                           PRINT LISTA-001                                      
                       END-IF                                                   
                   END-IF                                                       
               END-IF                                                           
           END-IF                                                               
       END-IF                                                                   
NEWPAGE                                                                         
                                                                                
REPORT LISTA-001  LINESIZE 120 SPACE 4  PRINTER W42684D2      +                 
                  NODATE NOADJUST                                               
                                                                                
SEQUENCE W-PROCURER WS-IDARTNR                                                  
CONTROL W-PROCURER RENUM NOPRINT                                                
TITLE 01    'VOLVO CAR AFTERSALES AB              W42684-001' +                 
            COL 55 'PROCURER = ' W-PROCURER                   +                 
            COL 89 'DATUM' SYSDATE                                              
TITLE 02    'PARTS WHITH DELIVERY BLOCKING CODE > 0 '                           
                                                                                
HEADING    WS-IDARTNR  ('PART NUMBER')                                          
HEADING    WS-KDLEVSP ('SPÄRRKOD')                                              
HEADING    AKT-TEARTNOT ('DATUM/NOTERING')                                      
                                                                                
LINE 01     WS-IDARTNR WS-KDLEVSP AKT-TEARTNOT                                  
*                                                                               
NEWPAGE                                                                         
