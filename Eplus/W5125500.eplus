                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W512                                                  *        
*                                                                      *        
*  FUNCTION   :  STORAGE VALUE ANALYSIS  (COPY OF W57050)              *        
*                                                                      *        
*  AUTHOR     :  SARASWATHY                                            *        
*                                                                      *        
*  INFILER    :  W512.W512M1.W51254                                    *        
*                                                                      *        
*  UTDATA     :  EXCELFIL W51255,W51256                                *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W51255D1                                                                   
%W51254  'IN-'                                                                  
                                                                                
*---------------------------------------------*                                 
*TEMP FILE FOR SORTED ARTICLE FILES           *                                 
*---------------------------------------------*                                 
FILE TPFIL1 FB(43 0)                                                            
%W51254  'T1-'                                                                  
                                                                                
*---------------------------------------------*                                 
* TEMPFIL                                     *                                 
*---------------------------------------------*                                 
FILE TPFIL2 FB(39 0)                                                            
T2-IDDC-REC        1  2 A                                                       
T2-IDDC-SEND       4  2 A                                                       
T2-SUNETT-SEK      7  7 P 2                                                     
T2-SUNETT         15  7 P 2                                                     
T2-KDVALISO       23  3 A                                                       
T2-KDPRODSL       27  3 A                                                       
T2-IDFAKT         30 10 A                                                       
                                                                                
****** UTFIL                                                                    
FILE W51255D2 VB(100 0)                                                         
UTAREA         1 95 A                                                           
                                                                                
******                                                                          
UT-AREA        W 95 A                                                           
UT-IDDC-REC  UT-AREA     2  A                                                   
FILL01       UT-AREA +2  1  A  VALUE ';'                                        
UT-IDDC-SEND UT-AREA +3  2  A                                                   
FILL02       UT-AREA +5  1  A  VALUE ';'                                        
UT-KDPRODSL  UT-AREA +6  3  A                                                   
FILL03       UT-AREA +9  1  A  VALUE ';'                                        
UT-TEXT      UT-AREA +10 30 A                                                   
FILL04       UT-AREA +40 1  A  VALUE ';'                                        
UT-SUMMA-N1  UT-AREA +41 11 N                                                   
DECI1        UT-AREA +52 1  A  VALUE '.'                                        
UT-SUMMA-D1  UT-AREA +53 2  N                                                   
FILL05       UT-AREA +55 4  A  VALUE ';SEK'                                     
FILL06       UT-AREA +59 1  A  VALUE ';'                                        
UT-SUMMA-N2  UT-AREA +60 11 N                                                   
DECI2        UT-AREA +71 1  A  VALUE '.'                                        
UT-SUMMA-D2  UT-AREA +72 2  N                                                   
FILL07       UT-AREA +74 1  A  VALUE ';'                                        
UT-FILL08    UT-AREA +75 4  A                                                   
FILL08       UT-AREA +79 1  A  VALUE ';'                                        
                                                                                
****** UTFIL                                                                    
FILE W51255D3 VB(100 0)                                                         
UTAREA2        1 95 A                                                           
                                                                                
UT-HEAD2       W 95 A                                                           
UH2-IDDC-REC  UT-HEAD2     12  A  VALUE 'RECEIVING DC'                          
FILL09        UT-HEAD2 +13  1  A  VALUE ';'                                     
UH2-IDDC-SEND UT-HEAD2 +14 10  A  VALUE 'SENDING DC'                            
FILL10        UT-HEAD2 +24  1  A  VALUE ';'                                     
UH2-IDFAKT    UT-HEAD2 +25 14  A  VALUE 'INVOICE NUMBER'                        
FILL11        UT-HEAD2 +39  1  A  VALUE ';'                                     
UH2-KDPRODSL  UT-HEAD2 +40 14  A  VALUE 'PRODUCT GROUP'                         
FILL12        UT-HEAD2 +54  1  A  VALUE ';'                                     
UH2-NETPRS    UT-HEAD2 +55 16  A  VALUE 'NET PRICE IN SEK'                      
FILL13        UT-HEAD2 +71  1  A  VALUE ';'                                     
FILL14        UT-HEAD2 +72  1  A  VALUE ';'                                     
UH2-NETPR     UT-HEAD2 +73 20  A  VALUE 'NET PRICE IN CNY/USD'                  
FILL15        UT-HEAD2 +93  1  A  VALUE ';'                                     
**                                                                              
UT-AREA2       W 95 A                                                           
UT2-IDDC-REC  UT-AREA2      2  A                                                
FILL16        UT-AREA2 +3   1  A  VALUE ';'                                     
UT2-IDDC-SEND UT-AREA2 +4   2  A                                                
FILL17        UT-AREA2 +6   1  A  VALUE ';'                                     
UT2-IDFAKT    UT-AREA2 +7  10  A                                                
FILL18        UT-AREA2 +17  1  A  VALUE ';'                                     
UT2-KDPRODSL  UT-AREA2 +18  3  A                                                
FILL19        UT-AREA2 +21  1  A  VALUE ';'                                     
UT2-SUMMA-N1  UT-AREA2 +22 11  N                                                
DECI3         UT-AREA2 +33  1  A  VALUE '.'                                     
UT2-SUMMA-D1  UT-AREA2 +34  2  N                                                
FILL20        UT-AREA2 +36  4  A  VALUE ';SEK'                                  
FILL21        UT-AREA2 +40  1  A  VALUE ';'                                     
UT2-SUMMA-N2  UT-AREA2 +41 11  N                                                
DECI4         UT-AREA2 +52  1  A  VALUE '.'                                     
UT2-SUMMA-D2  UT-AREA2 +53  2  N                                                
FILL22        UT-AREA2 +55  1  A  VALUE ';'                                     
UT2-FILL08    UT-AREA2 +56  4  A                                                
FILL23        UT-AREA2 +60  1  A  VALUE ';'                                     
****** WORKING STORAGE                                                          
W-EXCEL-RUB1             W  23  A                                               
RUB-TEXT    W-EXCEL-RUB1     6  A VALUE 'DATE  '                                
RUB-DATUM   W-EXCEL-RUB1 +6  6  N                                               
RUB-FILL01  W-EXCEL-RUB1 +12 1  A VALUE ';'                                     
RUB-FILL02  W-EXCEL-RUB1 +13 7  A VALUE 'PERIOD '                               
RUB-MÅNAD   W-EXCEL-RUB1 +20 2  N                                               
RUB-FILL03  W-EXCEL-RUB1 +22 1  A VALUE ';'                                     
                                                                                
%WDATKORT                                                                       
                                                                                
*-------------*                                                                 
* WORK SPACE  *                                                                 
*-------------*                                                                 
W-IDDC-REC       W   2 A                                                        
W-IDDC-SEND      W   2 A                                                        
W-KDPRODSL       W   3 A                                                        
W-SUNETT-SEK     W   8 P 2  MASK ('ZZZZZZZZZZZ99.99-')                          
W-SUNETT         W   8 P 2  MASK ('ZZZZZZZZZZZ99.99-')                          
W-KDVALISO       W   3 A                                                        
W-KVANTAL        W   5   P   0                                                  
IX               W   2   P   0                                                  
                                                                                
W-SUNETT-FMT1                    W  13  N 2                                     
W-SUNETT-N1      W-SUNETT-FMT1      11  N                                       
W-SUNETT-D1      W-SUNETT-FMT1 +11   2  N                                       
                                                                                
W-SUNETT-FMT2                    W  13  N 2                                     
W-SUNETT-N2      W-SUNETT-FMT2      11  N                                       
W-SUNETT-D2      W-SUNETT-FMT2 +11   2  N                                       
                                                                                
W-SUNETT-FMT3                    W  13  N 2                                     
W-SUNETT-N3      W-SUNETT-FMT3      11  N                                       
W-SUNETT-D3      W-SUNETT-FMT3 +11   2  N                                       
                                                                                
PROGRAM-NAMN     W   6   A  VALUE 'W51255'                                      
DATUMKORT-ID     W   6   A  VALUE 'WDATUM'                                      
                                                                                
W-AAMMDD         W   6   N                                                      
W-AA   W-AAMMDD      2   N                                                      
W-MM   W-AAMMDD  +2  2   N                                                      
W-DD   W-AAMMDD  +4  2   N                                                      
                                                                                
BEPRODSL                W 27  A    OCCURS 38                                    
BEPRODSL-PS  BEPRODSL      2  A                                                 
BEPRODSL-TXT BEPRODSL +3  24  A                                                 
                                                                                
NEWPAGE                                                                         
                                                                                
*---------------------------------------------------------------*               
* STEP 1.SORT WITH DC                                           *               
*---------------------------------------------------------------*               
SORT W51255D1 TO TPFIL1 USING                                  +                
         (IN-IDDC-REC IN-IDDC-SEND IN-KDVALISO)                +                
         SIZE 900000                                                            
                                                                                
JOB INPUT (TPFIL1 KEY (T1-IDDC-REC T1-IDDC-SEND)) +                             
          START A-INIT                                                          
  T2-IDDC-REC     = T1-IDDC-REC                                                 
  T2-IDDC-SEND    = T1-IDDC-SEND                                                
  T2-KDPRODSL     = '10'                                                        
  T2-SUNETT-SEK   = T1-PRARTNTO-SEK                                             
  T2-SUNETT       = T1-PRARTNTO                                                 
  T2-KDVALISO     = T1-KDVALISO                                                 
  T2-IDFAKT       = T1-IDVERGL                                                  
  IF T2-SUNETT-SEK NE 0                                                         
    PUT TPFIL2                                                                  
  END-IF                                                                        
                                                                                
A-INIT. PROC                                                                    
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                      
  W-AA       = D-AAR                                                            
  W-MM       = D-MAANAD                                                         
  W-DD       = D-DAG                                                            
  RUB-DATUM  = W-AAMMDD                                                         
  RUB-MÅNAD  = W-MM                                                             
                                                                                
END-PROC                                                                        
                                                                                
*--------------------------------------------------------*                      
* STEP 2 SORT                                                                   
*--------------------------------------------------------*                      
                                                                                
JOB INPUT NULL                                                                  
  PERFORM A-INIT-EXCEL                                                          
  GET TPFIL2                                                                    
  IF NOT EOF TPFIL2                                                             
    W-IDDC-REC         = T2-IDDC-REC                                            
    W-IDDC-SEND        = T2-IDDC-SEND                                           
    W-KDPRODSL         = T2-KDPRODSL                                            
    W-KDVALISO         = T2-KDVALISO                                            
    W-SUNETT-SEK       = 0                                                      
    W-SUNETT           = 0                                                      
    DO WHILE NOT EOF TPFIL2                                                     
      IF  T2-IDDC-REC  = W-IDDC-REC AND T2-KDVALISO = W-KDVALISO  +             
      AND T2-IDDC-SEND = W-IDDC-SEND                                            
        W-SUNETT-SEK = W-SUNETT-SEK + T2-SUNETT-SEK                             
        W-SUNETT     = W-SUNETT     + T2-SUNETT                                 
      ELSE                                                                      
        PERFORM SKRIV-EXCELPOST                                                 
        W-IDDC-REC         = T2-IDDC-REC                                        
        W-IDDC-SEND        = T2-IDDC-SEND                                       
        W-KDPRODSL         = T2-KDPRODSL                                        
        W-KDVALISO         = T2-KDVALISO                                        
        W-SUNETT-SEK       = T2-SUNETT-SEK                                      
        W-SUNETT           = T2-SUNETT                                          
      END-IF                                                                    
      GET TPFIL2                                                                
    END-DO                                                                      
  END-IF                                                                        
  PERFORM SKRIV-EXCELPOST                                                       
                                                                                
  STOP                                                                          
                                                                                
A-INIT-EXCEL. PROC                                                              
  UTAREA      = W-EXCEL-RUB1                                                    
  PUT W51255D2                                                                  
END-PROC                                                                        
                                                                                
SKRIV-EXCELPOST. PROC                                                           
  UT-IDDC-REC   = W-IDDC-REC                                                    
  UT-IDDC-SEND  = W-IDDC-SEND                                                   
  UT-KDPRODSL   = W-KDPRODSL                                                    
  UT-TEXT       = 'SURCHAGES'                                                   
  W-SUNETT-FMT1 = W-SUNETT-SEK                                                  
  UT-SUMMA-N1   = W-SUNETT-N1                                                   
  UT-SUMMA-D1   = W-SUNETT-D1                                                   
  W-SUNETT-FMT2 = W-SUNETT                                                      
  UT-SUMMA-N2   = W-SUNETT-N2                                                   
  UT-SUMMA-D2   = W-SUNETT-D2                                                   
  IF W-KDVALISO = 'CNY'                                                         
    UT-FILL08   = 'CNY'                                                         
  END-IF                                                                        
  IF W-KDVALISO = 'USD'                                                         
    UT-FILL08   = 'USD'                                                         
  END-IF                                                                        
  UTAREA        = UT-AREA                                                       
  PUT W51255D2                                                                  
END-PROC                                                                        
************************************************************                    
JOB INPUT NULL                                                                  
  PERFORM A-INIT-EXCEL2                                                         
  GET TPFIL2                                                                    
  IF NOT EOF TPFIL2                                                             
    DO WHILE NOT EOF TPFIL2                                                     
       UT2-IDDC-REC   = T2-IDDC-REC                                             
       UT2-IDDC-SEND  = T2-IDDC-SEND                                            
       UT2-KDPRODSL   = T2-KDPRODSL                                             
       UT2-IDFAKT     = T2-IDFAKT                                               
       W-SUNETT-FMT1  = T2-SUNETT-SEK                                           
       UT2-SUMMA-N1   = W-SUNETT-N1                                             
       UT2-SUMMA-D1   = W-SUNETT-D1                                             
       W-SUNETT-FMT2  = T2-SUNETT                                               
       UT2-SUMMA-N2   = W-SUNETT-N2                                             
       UT2-SUMMA-D2   = W-SUNETT-D2                                             
      IF T2-KDVALISO  = 'CNY'                                                   
        UT2-FILL08    = 'CNY'                                                   
      END-IF                                                                    
      IF T2-KDVALISO  = 'USD'                                                   
        UT2-FILL08    = 'USD'                                                   
      END-IF                                                                    
      UTAREA2         = UT-AREA2                                                
      PUT W51255D3                                                              
      GET TPFIL2                                                                
    END-DO                                                                      
  END-IF                                                                        
                                                                                
  STOP                                                                          
                                                                                
A-INIT-EXCEL2. PROC                                                             
  UTAREA2      = W-EXCEL-RUB1                                                   
  PUT W51255D3                                                                  
  UTAREA2      = UT-HEAD2                                                       
  PUT W51255D3                                                                  
END-PROC                                                                        
                                                                                
