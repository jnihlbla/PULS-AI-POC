*--------------------------------------------------                             
*  STEG 4    SKAPA FIL FÖR PC BEHANDLING                                        
*--------------------------------------------------                             
                                                                                
SORT TPFIL4 TO TPFIL4 USING (T4-IDDC) SIZE 500000                               
                                                                                
JOB INPUT NULL FINISH T4-AVSLUTA                                                
  GET TPFIL4                                                                    
  IF NOT EOF TPFIL4                                                             
    FX-IDDC         = T4-IDDC                                                   
    TSUM-STD        = 0                                                         
    TSUM-STD-TOT    = 0                                                         
    DO WHILE NOT EOF TPFIL4                                                     
      IF FX-IDDC NQ T4-IDDC                                                     
        IF FX-IDDC = SDC-NL SDC-ES SDC-IT +                                     
                     SDC-AT NDC-JP-61 NDC-AU SDC-NL-ET                          
          FX-KDSORT   = '1'                                                     
        ELSE                                                                    
          FX-KDSORT   = '2'                                                     
        END-IF                                                                  
        FX-SUSTD      = TSUM-STD                                                
        FX-SUSTD-TOT  = TSUM-STD-TOT                                            
        DF-POST       = FX-FILE                                                 
        PUT W51393DF                                                            
                                                                                
        FX-IDDC       = T4-IDDC                                                 
        TSUM-STD      = T4-SUSTD                                                
        TSUM-STD-TOT  = T4-SUSTD-TOT                                            
      ELSE                                                                      
        TSUM-STD      = TSUM-STD     + T4-SUSTD                                 
        TSUM-STD-TOT  = TSUM-STD-TOT + T4-SUSTD-TOT                             
      END-IF                                                                    
      GET TPFIL4                                                                
    END-DO                                                                      
  END-IF                                                                        
STOP                                                                            
                                                                                
T4-AVSLUTA. PROC                                                                
  FX-SUSTD          = TSUM-STD                                                  
  FX-SUSTD-TOT      = TSUM-STD-TOT                                              
  DF-POST           = FX-FILE                                                   
  PUT W51393DF                                                                  
END-PROC                                                                        
                                                                                
****************************************************                            
* STEG 5                                                                        
* SORTERAR TEMPFIL3 OCH SKAPAR SUMMERAD (PER DC)                                
* RAD PÅ UTFIL TILL DAP (WEBBEN)                                                
*****************************************************                           
                                                                                
SORT TPFIL3 TO TPFIL3 USING (TP3-IDDC TP3-ADLAGOMR)                             
                                                                                
JOB  INPUT (TPFIL3) START A5-INIT FINISH Z5-FINIT                               
                                                                                
IF UT-IDDC     = TP3-IDDC AND +                                                 
   UT-ADLAGOMR = TP3-ADLAGOMR                                                   
   UT-SUART-REM     = UT-SUART-REM + TP3-SUART-REM                              
   UT-SUART-TOT     = UT-SUART-TOT + TP3-SUART-TOT                              
ELSE                                                                            
   IF UT-IDDC NE '  '                                                           
     PUT W51393DW                                                               
   END-IF                                                                       
                                                                                
   UT-IDAFPRCD      = TP3-IDAFPRCD                                              
   UT-IDDC          = TP3-IDDC                                                  
   UT-ADLAGOMR      = TP3-ADLAGOMR                                              
   UT-SUART-REM     = TP3-SUART-REM                                             
   UT-SUART-TOT     = TP3-SUART-TOT                                             
   UT-DAAAVV        = TP3-DAAAVV                                                
END-IF                                                                          
                                                                                
A5-INIT. PROC                                                                   
   UT-IDDC          = '  '                                                      
   UT-IDAFPRCD      = ' '                                                       
   UT-ADLAGOMR      = 0                                                         
   UT-SUART-REM     = 0                                                         
   UT-SUART-TOT     = 0                                                         
END-PROC                                                                        
                                                                                
Z5-FINIT. PROC                                                                  
   PUT W51393DW                                                                 
END-PROC                                                                        
NEWPAGE                                                                         
**** D&P REPORT FOR DC 4X                                                       
SORT TPFIL5 TO TPFIL5 USING (T5-IDDC, T5-SUM-OMR)                               
JOB INPUT TPFIL5 FINISH Z-FINIT                                                 
                                                                                
  IF T5-IDDC    = WS-IDDC-PREV AND +                                            
     T5-SUM-OMR = WS-OMR-PREV                                                   
    WS-SUM-ANT     = T5-SUM-ANT + WS-SUM-ANT                                    
    WS-SUM-STD     = T5-SUM-STD + WS-SUM-STD                                    
    WS-SUM-ANT-TOT = T5-SUM-ANT-TOT + WS-SUM-ANT-TOT                            
    WS-SUM-STD-TOT = T5-SUM-STD-TOT + WS-SUM-STD-TOT                            
  ELSE                                                                          
    IF WS-FIRST-REC = 'N'                                                       
       W-SUM-OMR     = WS-SUM-OMR                                               
       W-SUM-ANT     = WS-SUM-ANT                                               
       W-SUM-STD     = WS-SUM-STD                                               
       W-SUM-OMR-TOT = WS-SUM-OMR-TOT                                           
       W-SUM-ANT-TOT = WS-SUM-ANT-TOT                                           
       W-SUM-STD-TOT = WS-SUM-STD-TOT                                           
       PRINT RAPPORT4X                                                          
    END-IF                                                                      
    WS-IDDC-PREV   = T5-IDDC                                                    
    WS-OMR-PREV    = T5-SUM-OMR                                                 
    WS-SUM-OMR     = T5-SUM-OMR                                                 
    WS-SUM-ANT     = T5-SUM-ANT                                                 
    WS-SUM-STD     = T5-SUM-STD                                                 
    WS-SUM-OMR-TOT = T5-SUM-OMR-TOT                                             
    WS-SUM-ANT-TOT = T5-SUM-ANT-TOT                                             
    WS-SUM-STD-TOT = T5-SUM-STD-TOT                                             
    WS-FIRST-REC   = 'N'                                                        
  END-IF                                                                        
                                                                                
  Z-FINIT. PROC                                                                 
    IF WS-FIRST-REC = 'N'                                                       
       W-SUM-OMR     = WS-SUM-OMR                                               
       W-SUM-ANT     = WS-SUM-ANT                                               
       W-SUM-STD     = WS-SUM-STD                                               
       W-SUM-OMR-TOT = WS-SUM-OMR-TOT                                           
       W-SUM-ANT-TOT = WS-SUM-ANT-TOT                                           
       W-SUM-STD-TOT = WS-SUM-STD-TOT                                           
       PRINT RAPPORT4X                                                          
    END-IF                                                                      
  END-PROC                                                                      
************************************************************************        
*** LIST FOR NDC-US DC 4X - SENT TO D&P                                         
************************************************************************        
REPORT   RAPPORT4X            +                                                 
         PRINTER W51393DH     +                                                 
         LINESIZE 120         +                                                 
         SPACE 0              +                                                 
         NOHEADING            +                                                 
         NOSPREAD             +                                                 
         NOADJUST             +                                                 
         PAGESIZE 32767       +                                                 
         NODATE                                                                 
LINE  1  W-SUM-OMR            +                                                 
         W-SEM1               +                                                 
         W-SUM-ANT            +                                                 
         W-SEM1               +                                                 
         W-SUM-STD            +                                                 
         W-SEM1               +                                                 
         W-SUM-OMR-TOT        +                                                 
         W-SEM1               +                                                 
         W-SUM-ANT-TOT        +                                                 
         W-SEM1               +                                                 
         W-SUM-STD-TOT        +                                                 
         W-SEM1                                                                 
*                                                                               
BEFORE-LINE. PROC                                                               
 IF WS-IDDC-PREV NE W-PREV-IDDC                                                 
   DISPLAY '¤DAPSELECTION-REG'                                                  
   DISPLAY '¤DAP' WS-IDDC-PREV                                                  
   DISPLAY 'REMAINS AREA;REMAINS QTY;REMAINS SUM.STD;' +                        
           'TOTAL STOCK VAL AREA; TOTAL STOCK VAL QTY;TOTAL STOCK' +            
           'VAL SUM.STD;'                                                       
   W-PREV-IDDC = WS-IDDC-PREV                                                   
 END-IF                                                                         
END-PROC                                                                        
