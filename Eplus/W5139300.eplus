W-SUM-STD-TOT    W 11  N 2 MASK '--------9.99'                                  
W-SEM1           W  1  A   VALUE ';'                                            
W-PREV-IDDC      W  2  A                                                        
                                                                                
W-PGMNAMN   W  6  A  VALUE 'W51393'                                             
W-WDATUM    W  6  A  VALUE 'WDATUM'                                             
                                                                                
W-DATUM                W  6   N                                                 
W-AAR     W-DATUM         2   N                                                 
W-MM      W-DATUM    +2   2   N                                                 
W-DD      W-DATUM    +4   2   N                                                 
                                                                                
WEB-DAAAVV             W  6   N                                                 
