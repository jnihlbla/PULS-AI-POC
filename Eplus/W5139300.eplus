WEB-AA WEB-DAAAVV     +2  2   N                                                 
WEB-VV WEB-DAAAVV     +4  2   N                                                 
                                                                                
%WDATKORT                                                                       
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    --- TO CHECK IF "WEB DC"                                                   
*                                                                               
%WL10WBDC                                                                       
*                                                                               
NEWPAGE                                                                         
                                                                                
*-----------------------------------------------------------------*             
* STEG 1 LÄSER IN URVALSREGISTER FÖR ALLA DC:N,                                 
* SELEKTERAR ALLA ICKE DC=11 POSTER OCH SORTERAR PER ARTNR OCH DC               
*-----------------------------------------------------------------*             
                                                                                
SORT W51393D2 TO TPFIL1 USING (I2-IDARTNR I2-IDDC) SIZE 350000 +                
                          BEFORE SORT-INIT                                      
 SORT-INIT. PROC                                                                
  IF I2-IDDC NE CDC-SE                                                          
    SELECT                                                                      
  END-IF                                                                        
 END-PROC                                                                       
                                                                                
*-----------------------------------------------------------*                   
* STEG 2                                                                        
* MATCHAR SUPPORTLAGERBAND MED URVALSFIL OCH SKAPAR TEMPFIL                     
*-----------------------------------------------------------*                   
JOB INPUT(W51393D1 KEY (I1-SLAG-IDARTNR I1-SLAG-IDDC) +                         
          TPFIL1   KEY (T1-IDARTNR T1-IDDC))                                    
                                                                                
IF MATCHED                                                                      
    TP-IDARTNR    = I1-SLAG-IDARTNR                                             
    TP-IDDC       = I1-SLAG-IDDC                                                
    TP-ADLAGOMR   = I1-SLAG-ADLAGOMR                                            
    TP-QTY        = 1                                                           
    TP-LS         = I1-SLAG-KVLS + I1-SLAG-KVAKS-SDC + +                        
                    I1-SLAG-KVAKS-PAV + I1-SLAG-KVEFRS                          
    TP-LS-TOT     = I1-SLAG-KVLS + I1-SLAG-KVAKS-SDC + +                        
                    I1-SLAG-KVAKS-PAV + I1-SLAG-KVEFRS                          
    TP-KDPRODSL   = T1-KDPRODSL                                                 
    PUT TPFIL2                                                                  
ELSE                                                                            
  IF W51393D1                                                                   
    TP-IDARTNR    = I1-SLAG-IDARTNR                                             
    TP-IDDC       = I1-SLAG-IDDC                                                
    TP-ADLAGOMR   = I1-SLAG-ADLAGOMR                                            
    TP-QTY        = 0                                                           
    TP-LS         = 0                                                           
    TP-LS-TOT     = I1-SLAG-KVLS + I1-SLAG-KVAKS-SDC + +                        
                    I1-SLAG-KVEFRS                                              
    PUT TPFIL2                                                                  
  END-IF                                                                        
END-IF                                                                          
                                                                                
NEWPAGE                                                                         
*-------------------------------------------------------*                       
* STEG 3                                                                        
* SORTERAR TPFIL2 OCH MATCHAR DENNA MED ARTIKEL-                                
* INFORMATION FÖR ATT HÄMTA STANDARDPRIS                                        
*-------------------------------------------------------*                       
                                                                                
SORT TPFIL2 TO TPFIL2 USING (TP-IDARTNR) SIZE 650000                            
                                                                                
JOB INPUT(W51393D3  KEY (LB-CLAG-IDARTNR )  +                                   
          TPFIL2    KEY (TP-IDARTNR )) START INIT3-PROC                         
                                                                                
IF MATCHED                                                                      
    SUM-OMR     = TP-ADLAGOMR                                                   
    SUM-OMR-TOT = TP-ADLAGOMR                                                   
    SUM-STD-TOT = LB-CLAG-PRARTSTD * TP-LS-TOT                                  
    SUM-ANT-TOT = 1                                                             
    IF TP-QTY   = 1                                                             
      SUM-ANT   = 1                                                             
      SUM-STD   = LB-CLAG-PRARTSTD * TP-LS                                      
      PERFORM PRINTA-LISTRAD                                                    
    ELSE                                                                        
      SUM-ANT   = 0                                                             
      SUM-STD   = 0                                                             
      IF SUM-STD-TOT NE 0                                                       
        PERFORM PRINTA-LISTRAD                                                  
      END-IF                                                                    
    END-IF                                                                      
END-IF                                                                          
                                                                                
PRINTA-LISTRAD. PROC                                                            
                                                                                
    O-IDDC             = TP-IDDC                                                
    IF TP-IDDC = SDC-NL-ET                                                      
            PRINT RAPPORT91-ET                                                  
    ELSE-IF TP-IDDC = SDC-NL                                                    
            PRINT  RAPPORT21                                                    
    ELSE-IF TP-IDDC = SDC-ES                                                    
            PRINT RAPPORT24                                                     
    ELSE-IF TP-IDDC = SDC-IT                                                    
            PRINT RAPPORT25                                                     
    ELSE-IF TP-IDDC = SDC-AT                                                    
            PRINT RAPPORT26                                                     
    ELSE-IF TP-IDDC = NDC-JP-61                                                 
            PRINT RAPPORT61                                                     
    ELSE-IF TP-IDDC = NDC-AU                                                    
            PRINT RAPPORT62                                                     
    END-IF                                                                      
                                                                                
    PERFORM S23-CHECK-TP-IDDC                                                   
    IF TP-IDDC = NDC-US                                                         
       PERFORM X-CHECK-IF-WEBDC                                                 
       IF WBDC-FLWEBDC = 'N'                                                    
          T5-IDDC        = TP-IDDC                                              
          T5-SUM-OMR     = SUM-OMR                                              
          T5-SUM-ANT     = SUM-ANT                                              
          T5-SUM-STD     = SUM-STD                                              
          T5-SUM-OMR-TOT = SUM-OMR-TOT                                          
          T5-SUM-ANT-TOT = SUM-ANT-TOT                                          
          T5-SUM-STD-TOT = SUM-STD-TOT                                          
          PUT TPFIL5                                                            
       END-IF                                                                   
    END-IF                                                                      
**** WEB-FILEN                                                                  
    PERFORM  SKAPA-UTPOST-WEB-FIL                                               
                                                                                
**** ONDEMANDFILEN                                                              
    PRINT RAPPORT06                                                             
                                                                                
**** PC EXCEL-FILEN                                                             
    T4-SUSTD      = SUM-STD                                                     
    T4-SUSTD-TOT  = SUM-STD-TOT                                                 
    T4-IDDC       = O-IDDC                                                      
    PUT TPFIL4                                                                  
END-PROC                                                                        
*    --- S23-CHECK-TP-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'TP-'                                                                   
*                                                                               
NEWPAGE                                                                         
X-CHECK-IF-WEBDC. PROC                                                          
   WBDC-IDDC = TP-IDDC                                                          
   CALL WL10WBDC USING WBDC-AREA                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
                                                                                
INIT3-PROC. PROC                                                                
   CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                            
                                                                                
   W-AAR  = D-AAR                                                               
   W-MM   = D-MAANAD                                                            
   W-DD   = D-DAG                                                               
                                                                                
   WEB-AA = D-AAR                                                               
   WEB-VV = D-VECKA                                                             
   WEB-SS = 20                                                                  
END-PROC                                                                        
                                                                                
SKAPA-UTPOST-WEB-FIL. PROC                                                      
  TP3-IDAFPRCD    = '1'                                                         
  TP3-IDDC        = TP-IDDC                                                     
  TP3-ADLAGOMR    = TP-ADLAGOMR                                                 
  TP3-SUART-REM   = SUM-ANT                                                     
  TP3-SUART-TOT   = SUM-ANT-TOT                                                 
  TP3-DAAAVV      = WEB-DAAAVV                                                  
  PUT TPFIL3                                                                    
END-PROC                                                                        
                                                                                
