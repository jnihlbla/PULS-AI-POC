 W-IDDC          W  2  A                                                        
 W-DC  W-IDDC +1    1  N                                                        
NEWPAGE                                                                         
******************************************************************              
* STEG 1. MATCHA LAB-ARTIKELFIL W56081 MED LAB-LAGERBAND FÖR                    
*         ATT FÅ MÅNADSSKIFTETS KORREKTA SALDON.                                
*         DESSA SALDON JÄMFÖRS MED SALDO PÅ MÅNADSFILER W56050                  
******************************************************************              
                                                                                
JOB INPUT (W56082D1 KEY (IN1-IDARTNR) +                                         
           W56082D2 KEY (LAB-IDARTNR))                                          
    IF MATCHED                                                                  
        TP1-KVLS    (1)     = 0                                                 
        TP1-KVLS    (2)     = 0                                                 
        TP1-KVLS    (3)     = 0                                                 
        TP1-KVLS    (4)     = 0                                                 
        TP1-KVLS    (5)     = 0                                                 
        TP1-KVLS    (6)     = 0                                                 
        TP1-KVLS    (7)     = 0                                                 
        TP1-KVEFRS  (1)     = 0                                                 
        TP1-KVEFRS  (2)     = 0                                                 
        TP1-KVEFRS  (3)     = 0                                                 
        TP1-KVEFRS  (4)     = 0                                                 
        TP1-KVEFRS  (5)     = 0                                                 
        TP1-KVEFRS  (6)     = 0                                                 
        TP1-KVEFRS  (7)     = 0                                                 
        TP1-PRAVCOST(1)     = 0                                                 
        TP1-PRAVCOST(2)     = 0                                                 
        TP1-PRAVCOST(3)     = 0                                                 
        TP1-PRAVCOST(4)     = 0                                                 
        TP1-PRAVCOST(5)     = 0                                                 
        TP1-PRAVCOST(6)     = 0                                                 
        TP1-PRAVCOST(7)     = 0                                                 
      IF LAB-IDDC EQ IN1-IDDC(1) IN1-IDDC(2) IN1-IDDC(3) IN1-IDDC(4)   +        
                     IN1-IDDC(5) IN1-IDDC(6) IN1-IDDC(7)               +        
      AND LAB-IDDC NQ '  '                                                      
        W-IDDC              = LAB-IDDC                                          
        TP1-KVLS    (W-DC)  = LAB-KVLS                                          
        TP1-KVEFRS  (W-DC)  = LAB-KVEFRS                                        
        TP1-PRAVCOST(W-DC)  = LAB-PRAVCOST                                      
        TP1-IDARTNR         = IN1-IDARTNR                                       
      END-IF                                                                    
      IF LAST-DUP W56082D2 OR NOT DUPLICATE W56082D2                            
        IF TP1-IDARTNR = IN1-IDARTNR                                            
          TP1-KDPSLLOC      = IN1-KDPSLLOC                                      
          TP1-PRARTNTO      = IN1-PRARTNTO                                      
          TP1-BEART-ENG     = ' '                                               
          PUT TEMP1                                                             
        END-IF                                                                  
        TP1-KVLS    (1)     = 0                                                 
        TP1-KVLS    (2)     = 0                                                 
        TP1-KVLS    (3)     = 0                                                 
        TP1-KVLS    (4)     = 0                                                 
        TP1-KVLS    (5)     = 0                                                 
        TP1-KVLS    (6)     = 0                                                 
        TP1-KVLS    (7)     = 0                                                 
        TP1-KVEFRS  (1)     = 0                                                 
        TP1-KVEFRS  (2)     = 0                                                 
        TP1-KVEFRS  (3)     = 0                                                 
        TP1-KVEFRS  (4)     = 0                                                 
        TP1-KVEFRS  (5)     = 0                                                 
        TP1-KVEFRS  (6)     = 0                                                 
        TP1-KVEFRS  (7)     = 0                                                 
        TP1-PRAVCOST(1)     = 0                                                 
        TP1-PRAVCOST(2)     = 0                                                 
        TP1-PRAVCOST(3)     = 0                                                 
        TP1-PRAVCOST(4)     = 0                                                 
        TP1-PRAVCOST(5)     = 0                                                 
        TP1-PRAVCOST(6)     = 0                                                 
        TP1-PRAVCOST(7)     = 0                                                 
      END-IF                                                                    
    END-IF                                                                      
*                                                                               
******************************************************************              
* STEG 2. MATCHA TEMPFILEN MED W01174 FÖR ATT FÅ BENÄMNING PÅ ART*              
******************************************************************              
                                                                                
JOB INPUT (W56082D4 KEY (LB2-IDARTNR) +                                         
          TEMP1     KEY (TP1-IDARTNR))                                          
    IF MATCHED                                                                  
      TP2-W56082  = TP1-W56082                                                  
      IF LB2-BEART(10) = '                         '                            
        TP2-BEART-ENG   = LB2-BEART(04)                                         
      ELSE                                                                      
        TP2-BEART-ENG   = LB2-BEART(10)                                         
      END-IF                                                                    
      PUT TEMP2                                                                 
    END-IF                                                                      
                                                                                
***************************************************                             
* STEG 3. HÄMTAS KURS                  *                                        
***************************************************                             
                                                                                
 JOB INPUT W56082D5                                                             
   IF PRIS-KDVALISO  = 'USD'                                                    
     WS-PRKURS  = PRIS-PRKURS                                                   
   END-IF                                                                       
                                                                                
***************************************************                             
* STEG 4. SKRIV UT LISTAN              *                                        
***************************************************                             
                                                                                
JOB INPUT TEMP2                                                                 
                                                                                
   WS-IDARTNR         = TP2-IDARTNR                                             
   WS-ANTAL41         = TP2-KVLS(1) + TP2-KVEFRS(1)                             
   WS-ANTAL92         = TP2-KVLS(2) + TP2-KVEFRS(2)                             
   WS-ANTAL43         = TP2-KVLS(3) + TP2-KVEFRS(3)                             
   WS-ANTAL44         = TP2-KVLS(4) + TP2-KVEFRS(4)                             
   WS-ANTAL45         = TP2-KVLS(5) + TP2-KVEFRS(5)                             
   WS-ANTAL46         = TP2-KVLS(6) + TP2-KVEFRS(6)                             
   WS-ANTAL47         = TP2-KVLS(7) + TP2-KVEFRS(7)                             
   WS-PRAVCOST41      = TP2-PRAVCOST(1)                                         
   WS-PRAVCOST92      = TP2-PRAVCOST(2)                                         
   WS-PRAVCOST43      = TP2-PRAVCOST(3)                                         
   WS-PRAVCOST44      = TP2-PRAVCOST(4)                                         
   WS-PRAVCOST44      = TP2-PRAVCOST(4)                                         
   WS-PRAVCOST45      = TP2-PRAVCOST(5)                                         
   WS-PRAVCOST46      = TP2-PRAVCOST(6)                                         
   WS-PRAVCOST47      = TP2-PRAVCOST(7)                                         
   WS-SUMMA41         = WS-ANTAL41 * TP2-PRAVCOST(1)                            
   WS-SUMMA92         = WS-ANTAL92 * TP2-PRAVCOST(2)                            
   WS-SUMMA43         = WS-ANTAL43 * TP2-PRAVCOST(3)                            
   WS-SUMMA44         = WS-ANTAL44 * TP2-PRAVCOST(4)                            
   WS-SUMMA45         = WS-ANTAL45 * TP2-PRAVCOST(5)                            
   WS-SUMMA46         = WS-ANTAL46 * TP2-PRAVCOST(6)                            
   WS-SUMMA47         = WS-ANTAL47 * TP2-PRAVCOST(7)                            
   WS-TOTAL-ANTAL     = WS-ANTAL41 + WS-ANTAL92 + WS-ANTAL43          +         
                        + WS-ANTAL44 + WS-ANTAL45 + WS-ANTAL46        +         
                        + WS-ANTAL47                                            
   WS-TOTAL-SUMMA     = WS-SUMMA41 + WS-SUMMA92 + WS-SUMMA43          +         
                        + WS-SUMMA44 + WS-SUMMA45 + WS-SUMMA46        +         
                        + WS-SUMMA47                                            
   IF WS-TOTAL-ANTAL NE 0                                                       
     WS-PRARTAVG      = WS-TOTAL-SUMMA / WS-TOTAL-ANTAL                         
   ELSE                                                                         
     WS-PRARTAVG      = 0                                                       
   END-IF                                                                       
                                                                                
   IF WS-PRKURS GT 0                                                            
     WS-TOTAL-NTO       = WS-TOTAL-ANTAL * TP2-PRARTNTO / WS-PRKURS             
   ELSE                                                                         
     WS-TOTAL-NTO       = 0                                                     
   END-IF                                                                       
                                                                                
   WS-DIFF-CHANGE     = WS-TOTAL-NTO - WS-TOTAL-SUMMA                           
                                                                                
   W-TOT-ANTAL41      = WS-ANTAL41                                              
   W-TOT-ANTAL92      = WS-ANTAL92                                              
   W-TOT-ANTAL43      = WS-ANTAL43                                              
   W-TOT-ANTAL44      = WS-ANTAL44                                              
   W-TOT-ANTAL45      = WS-ANTAL45                                              
   W-TOT-ANTAL46      = WS-ANTAL46                                              
   W-TOT-ANTAL47      = WS-ANTAL47                                              
   W-TOT-SUMMA41      = WS-SUMMA41                                              
   W-TOT-SUMMA92      = WS-SUMMA92                                              
   W-TOT-SUMMA43      = WS-SUMMA43                                              
   W-TOT-SUMMA44      = WS-SUMMA44                                              
   W-TOT-SUMMA45      = WS-SUMMA45                                              
   W-TOT-SUMMA46      = WS-SUMMA46                                              
   W-TOT-SUMMA47      = WS-SUMMA47                                              
   W-TOTTOT-ANTAL     = WS-TOTAL-ANTAL                                          
   W-TOTTOT-SUMMA     = WS-TOTAL-SUMMA                                          
   W-TOTTOT-NTO       = WS-TOTAL-NTO                                            
   W-DIFFTOT          = WS-DIFF-CHANGE                                          
                                                                                
  PRINT RAPPORT01                                                               
                                                                                
NEWPAGE                                                                         
REPORT RAPPORT01                   +                                            
       PRINTER W56082D6            +                                            
       LINESIZE 389                +                                            
       SPACE 0                     +                                            
       NOHEADING                   +                                            
       NOSPREAD                    +                                            
       NOADJUST                    +                                            
       PAGESIZE 32767              +                                            
       NODATE                                                                   
                                                                                
SEQUENCE TP2-KDPSLLOC WS-IDARTNR                                                
CONTROL  FINAL NOPRINT                                                          
SUM      W-TOT-ANTAL41             +                                            
         W-TOT-ANTAL92             +                                            
         W-TOT-ANTAL43             +                                            
         W-TOT-ANTAL44             +                                            
         W-TOT-ANTAL45             +                                            
         W-TOT-ANTAL46             +                                            
         W-TOT-ANTAL47             +                                            
         W-TOT-SUMMA41             +                                            
         W-TOT-SUMMA92             +                                            
         W-TOT-SUMMA43             +                                            
         W-TOT-SUMMA44             +                                            
         W-TOT-SUMMA45             +                                            
         W-TOT-SUMMA46             +                                            
         W-TOT-SUMMA47             +                                            
         W-TOTTOT-ANTAL            +                                            
         W-TOTTOT-SUMMA            +                                            
         W-TOTTOT-NTO              +                                            
         W-DIFFTOT                                                              
                                                                                
                                                                                
LINE  1   WS-IDARTNR        +                                                   
          W-SEM             +                                                   
          TP2-KDPSLLOC      +                                                   
          W-SEM             +                                                   
          WS-ANTAL41        +                                                   
          W-SEM             +                                                   
          WS-PRAVCOST41     +                                                   
          W-SEM             +                                                   
          WS-SUMMA41        +                                                   
          W-SEM             +                                                   
          WS-ANTAL92        +                                                   
          W-SEM             +                                                   
          WS-PRAVCOST92     +                                                   
          W-SEM             +                                                   
          WS-SUMMA92        +                                                   
          W-SEM             +                                                   
          WS-ANTAL43        +                                                   
          W-SEM             +                                                   
          WS-PRAVCOST43     +                                                   
          W-SEM             +                                                   
          WS-SUMMA43        +                                                   
          W-SEM             +                                                   
          WS-ANTAL44        +                                                   
          W-SEM             +                                                   
          WS-PRAVCOST44     +                                                   
          W-SEM             +                                                   
          WS-SUMMA44        +                                                   
          W-SEM             +                                                   
          WS-ANTAL45        +                                                   
          W-SEM             +                                                   
          WS-PRAVCOST45     +                                                   
          W-SEM             +                                                   
          WS-SUMMA45        +                                                   
          W-SEM             +                                                   
          WS-ANTAL46        +                                                   
          W-SEM             +                                                   
          WS-PRAVCOST46     +                                                   
          W-SEM             +                                                   
          WS-SUMMA46        +                                                   
          W-SEM             +                                                   
          WS-ANTAL47        +                                                   
          W-SEM             +                                                   
          WS-PRAVCOST47     +                                                   
          W-SEM             +                                                   
          WS-SUMMA47        +                                                   
          W-SEM             +                                                   
          WS-TOTAL-ANTAL    +                                                   
          W-SEM             +                                                   
          WS-TOTAL-SUMMA    +                                                   
          W-SEM             +                                                   
          WS-PRARTAVG       +                                                   
          W-SEM             +                                                   
          WS-TOTAL-NTO      +                                                   
          W-SEM             +                                                   
          WS-DIFF-CHANGE    +                                                   
          W-SEM             +                                                   
          TP2-BEART-ENG     +                                                   
          W-SEM                                                                 
                                                                                
  BEFORE-BREAK. PROC                                                            
    IF LEVEL = 1                                                                
     DISPLAY  ' '                                                               
     DISPLAY  'GRAND TOTAL:' +                                                  
              W-SEM          +                                                  
              W-SEM          +                                                  
              W-TOT-ANTAL41  +                                                  
              W-SEM          +                                                  
              W-SEM          +                                                  
              W-TOT-SUMMA41  +                                                  
              W-SEM          +                                                  
              W-TOT-ANTAL92  +                                                  
              W-SEM          +                                                  
              W-SEM          +                                                  
              W-TOT-SUMMA92  +                                                  
              W-SEM          +                                                  
              W-TOT-ANTAL43  +                                                  
              W-SEM          +                                                  
