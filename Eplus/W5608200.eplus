              W-SEM          +                                                  
              W-DIFFTOT      +                                                  
              W-SEM                                                             
    END-IF                                                                      
                                                                                
    IF LEVEL = 2                                                                
     DISPLAY  ' '                                                               
     DISPLAY  'GRAND TOTAL'  +                                                  
              W-TOT-ANTAL41  +                                                  
              W-TOT-SUMMA41  +                                                  
              W-TOT-ANTAL92  +                                                  
              W-TOT-SUMMA92  +                                                  
