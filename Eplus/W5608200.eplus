%W33592  'PRIS-'                                                                
                                                                                
FILE W56082D6  PRINTER VB (450 0)                                               
                                                                                
NEWPAGE                                                                         
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*************************************                                           
* WORKINGSTORAGE-FÄLT FÖR RAPPORTEN *                                           
*************************************                                           
WS-PRKURS      W 6 P 5 MASK   'ZZZZZ9.99999'                                    
WS-PRARTAVG    W 7 N 2 MASK   'ZZZZ9.99-'                                       
WS-TOTAL-NTO   W 9 N 2 MASK   'ZZZZZZ9.99-'                                     
                                                                                
WS-PRAVCOST41  W 7 N 2 MASK   'ZZZZ9.99'                                        
WS-PRAVCOST92  W 7 N 2 MASK   'ZZZZ9.99'                                        
WS-PRAVCOST43  W 7 N 2 MASK   'ZZZZ9.99'                                        
WS-PRAVCOST44  W 7 N 2 MASK   'ZZZZ9.99'                                        
WS-PRAVCOST45  W 7 N 2 MASK   'ZZZZ9.99'                                        
WS-PRAVCOST46  W 7 N 2 MASK   'ZZZZ9.99'                                        
WS-PRAVCOST47  W 7 N 2 MASK   'ZZZZ9.99'                                        
                                                                                
WS-ANTAL41     W 7 N 0 MASK   'ZZZZZZ9-'                                        
WS-ANTAL92     W 7 N 0 MASK   'ZZZZZZ9-'                                        
WS-ANTAL43     W 7 N 0 MASK   'ZZZZZZ9-'                                        
WS-ANTAL44     W 7 N 0 MASK   'ZZZZZZ9-'                                        
WS-ANTAL45     W 7 N 0 MASK   'ZZZZZZ9-'                                        
WS-ANTAL46     W 7 N 0 MASK   'ZZZZZZ9-'                                        
WS-ANTAL47     W 7 N 0 MASK   'ZZZZZZ9-'                                        
                                                                                
WS-SUMMA41     W 9 N 2 MASK   'ZZZZZZ9.99-'                                     
WS-SUMMA92     W 9 N 2 MASK   'ZZZZZZ9.99-'                                     
WS-SUMMA43     W 9 N 2 MASK   'ZZZZZZ9.99-'                                     
WS-SUMMA44     W 9 N 2 MASK   'ZZZZZZ9.99-'                                     
WS-SUMMA45     W 9 N 2 MASK   'ZZZZZZ9.99-'                                     
WS-SUMMA46     W 9 N 2 MASK   'ZZZZZZ9.99-'                                     
WS-SUMMA47     W 9 N 2 MASK   'ZZZZZZ9.99-'                                     
                                                                                
WS-TOTAL-ANTAL W 9 N 0 MASK   'ZZZZZZZZ9-'                                      
WS-TOTAL-SUMMA W 9 N 2 MASK   'ZZZZZZ9.99-'                                     
WS-DIFF-CHANGE W 9 N 2 MASK   'ZZZZZZ9.99-'                                     
                                                                                
WS-IDARTNR     W 9 N MASK 'ZZZZZZZZ9'                                           
                                                                                
 W-SEM           W  1  A                         VALUE ';'                      
 FIRST-LINE1     S  1  A                         VALUE 'J'                      
 W-TOT-ANTAL41   W  7  N 0   MASK 'ZZZZZZ9-'     VALUE 0                        
 W-TOT-ANTAL92   W  7  N 0   MASK 'ZZZZZZ9-'     VALUE 0                        
 W-TOT-ANTAL43   W  7  N 0   MASK 'ZZZZZZ9-'     VALUE 0                        
 W-TOT-ANTAL44   W  7  N 0   MASK 'ZZZZZZ9-'     VALUE 0                        
 W-TOT-ANTAL45   W  7  N 0   MASK 'ZZZZZZ9-'     VALUE 0                        
 W-TOT-ANTAL46   W  7  N 0   MASK 'ZZZZZZ9-'     VALUE 0                        
 W-TOT-ANTAL47   W  7  N 0   MASK 'ZZZZZZ9-'     VALUE 0                        
 W-TOT-SUMMA41   W  9  N 2   MASK 'ZZZZZZ9.99-'  VALUE 0                        
 W-TOT-SUMMA92   W  9  N 2   MASK 'ZZZZZZ9.99-'  VALUE 0                        
 W-TOT-SUMMA43   W  9  N 2   MASK 'ZZZZZZ9.99-'  VALUE 0                        
 W-TOT-SUMMA44   W  9  N 2   MASK 'ZZZZZZ9.99-'  VALUE 0                        
 W-TOT-SUMMA45   W  9  N 2   MASK 'ZZZZZZ9.99-'  VALUE 0                        
 W-TOT-SUMMA46   W  9  N 2   MASK 'ZZZZZZ9.99-'  VALUE 0                        
 W-TOT-SUMMA47   W  9  N 2   MASK 'ZZZZZZ9.99-'  VALUE 0                        
 W-TOTTOT-ANTAL  W  7  N 0   MASK 'ZZZZZZ9-'     VALUE 0                        
 W-TOTTOT-SUMMA  W  9  N 2   MASK 'ZZZZZZ9.99-'  VALUE 0                        
 W-TOTTOT-NTO    W  9  N 2   MASK 'ZZZZZZ9.99-'  VALUE 0                        
