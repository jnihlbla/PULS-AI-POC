              W-SEM          +                                                  
              W-SEM          +                                                  
              W-TOT-SUMMA44  +                                                  
              W-SEM          +                                                  
              W-TOT-ANTAL45  +                                                  
              W-SEM          +                                                  
              W-SEM          +                                                  
              W-TOT-SUMMA45  +                                                  
              W-SEM          +                                                  
              W-TOT-ANTAL46  +                                                  
              W-SEM          +                                                  
              W-SEM          +                                                  
              W-TOT-SUMMA46  +                                                  
              W-SEM          +                                                  
              W-TOT-SUMMA47  +                                                  
              W-SEM          +                                                  
              W-SEM          +                                                  
              W-TOT-SUMMA47  +                                                  
              W-SEM          +                                                  
              W-TOTTOT-ANTAL +                                                  
