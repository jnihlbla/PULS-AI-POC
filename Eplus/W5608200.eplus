              W-TOTTOT-NTO   +                                                  
              W-DIFFTOT                                                         
    END-IF                                                                      
  END-PROC                                                                      
                                                                                
BEFORE-LINE. PROC                                                               
 IF FIRST-LINE1 = 'J'                                                           
   DISPLAY '¤DAPW56082-001'                                                     
   DISPLAY '¤DAPW56082'                                                         
   DISPLAY '   AVERAGE VS REPLACEMENT COST         ' +                          
         'CURRENT EXCHANGE RATE USD: ' WS-PRKURS                                
   DISPLAY 'PART NUMBER;LPC;ON HAND;RUTHERFORD ' +                              
         'AVERAGE COST;EXTENDED VALUE;ON HAND;BATTERY AVERAGE COST;'  +         
         'EXTENDED VALUE;ON HAND;ONTARIO AVERAGE COST;' +                       
         'EXTENDED VALUE;ON HAND;SEATTLE AVERAGE COST;' +                       
         'EXTENDED VALUE;ON HAND;CHICAGO AVERAGE COST;' +                       
         'EXTENDED VALUE;ON HAND;JACKSONVILLE AVERAGE COST;' +                  
         'EXTENDED VALUE;TOTAL HAND;TOTAL COST;AVERAGE EXTENDED VALUE;'+        
         'REPLACE QTY ONHAND;INVENTOR COST;INVENTORY;DIFFERENCE;' +             
         'NET PRICE;DESCRIPTION;'                                               
   FIRST-LINE1 = 'N'                                                            
 END-IF                                                                         
END-PROC                                                                        
