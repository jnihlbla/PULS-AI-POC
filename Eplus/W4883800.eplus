                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4883800                                              *        
*                                                                      *        
*  FUNKTION   :  HIGHBAY ERROR-LIST COMPARE CENTRAL REGISTER           *        
*                                                                      *        
*  FÖRFATTARE :  MARTIEN HOMPES                                        *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W48838D1                                                                   
*                                                                               
%W48837  'IN1-'                                                                 
                                                                                
NEWPAGE                                                                         
* WORKING STORAGE                                                               
*                                                                               
* WORK FIELDS FOR LIST                                                          
*                                                                               
    WS-IDARTNR        IN1-IDARTNR           5 P MASK 'ZZZZZZZZ9'                
    WS-KVBUFF-F-LOK   IN1-KVBUFF-F-LOK      4 P MASK (BWZ 'ZZZZZZ9')            
    WS-KVBUFF-OF-LOK  IN1-KVBUFF-OF-LOK     4 P MASK (BWZ 'ZZZZZZ9')            
*                                                                               
FILE W48838D2 PRINTER                                                           
*                                                                               
* WORK FIELDS CALCULATE                                                         
*                                                                               
    WS-AVVIKELSE-F                       W  7 N MASK (BWZ, 'ZZZZZZ9')           
    WS-AVVIKELSE-OF                      W  7 N MASK (BWZ, 'ZZZZZZ9')           
*                                                                               
* WORK FIELDS MESSAGE                                                           
*                                                                               
    WS-FEL                               W 40 A                                 
    WS-KORR                              W 20 A                                 
                                                                                
*                                                                               
* WORK FIELDS CONTROL                                                           
*                                                                               
    WS-NEW-ID                            W 1  A                                 
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. COMPARE HIGHBAY WITH CENTRAL REGISTER                                 
*                                                                               
JOB INPUT (W48838D1) NAME AKT01                                                 
                                                                                
     WS-FEL            =   ' '                                                  
     WS-KORR           =   ' '                                                  
     WS-AVVIKELSE-F    =   0                                                    
     WS-AVVIKELSE-OF   =   0                                                    
     WS-NEW-ID         =   'N'                                                  
                                                                                
  IF IN1-IDPTYP = '001'                                                         
     WS-FEL            =   'SALDOAVVIKELSE'                                     
     WS-KORR           =   'KORRIGERAT'                                         
     WS-AVVIKELSE-F    =   IN1-KVBUFF-F-LOK  - IN1-KVBUFF-F-CEN                 
     WS-AVVIKELSE-OF   =   IN1-KVBUFF-OF-LOK - IN1-KVBUFF-OF-CEN                
     WS-NEW-ID         =   'Y'                                                  
   END-IF                                                                       
                                                                                
  IF IN1-IDPTYP = '002'                                                         
     WS-FEL            =   'SAKNAS I CENTRALT REGISTER'                         
     WS-NEW-ID         =   'Y'                                                  
   END-IF                                                                       
                                                                                
  IF IN1-IDPTYP = '003'                                                         
     WS-FEL            =   'SAKNAS I LOKALT REGISTER'                           
     WS-NEW-ID         =   'Y'                                                  
   END-IF                                                                       
                                                                                
  IF IN1-IDPTYP = '004'                                                         
     WS-FEL            =   IN1-W48837                                           
     WS-NEW-ID         =   'Y'                                                  
   END-IF                                                                       
                                                                                
  IF IN1-IDPTYP = '005'                                                         
     WS-FEL            =   'SÄNDNINGEN FRÅN PDP:N GICK EJ BRA '                 
     WS-KORR           =   ' ** RING 2100 ** '                                  
     WS-NEW-ID         =   'Y'                                                  
   END-IF                                                                       
                                                                                
   IF WS-NEW-ID = 'N'                                                           
     WS-FEL            =   'NY FELTYP'                                          
   END-IF                                                                       
                                                                                
  PRINT W48838-001                                                              
                                                                                
NEWPAGE                                                                         
REPORT W48838-001 LINESIZE 122 DTLCTL FIRST NOADJUST NODATE +                   
       PRINTER W48838D2                                                         
SEQUENCE IN1-IDARTNR                                                            
CONTROL                                                                         
TITLE 1  'VOLVO CAR AFTERSALES  W48838-001' +                                   
         COL 40 'FELLISTA - AVSTÄMNING CENTRALT REGISTER' +                     
         'DATUM:' SYSDATE                                                       
*                                                                               
HEADING  WS-IDARTNR         ('ARTIKELNR')                                       
HEADING  WS-KVBUFF-F-LOK    ('B-SALDO'              +                           
                             'FÖRÄDLAT')                                        
HEADING  WS-AVVIKELSE-F     ('AVVIKELSE')                                       
HEADING  WS-KVBUFF-OF-LOK   ('B-SALDO'              +                           
                             'OFÖRÄDLAT')                                       
HEADING  WS-AVVIKELSE-OF    ('AVVIKELSE')                                       
HEADING  WS-FEL             (' ')                                               
HEADING  WS-KORR            (' ')                                               
SKIP 1                                                                          
*                                                                               
LINE 1                       WS-IDARTNR             +                           
                             WS-KVBUFF-F-LOK        +                           
                             WS-AVVIKELSE-F         +                           
                             WS-KVBUFF-OF-LOK       +                           
                             WS-AVVIKELSE-OF        +                           
                             WS-FEL                 +                           
                             WS-KORR                                            
