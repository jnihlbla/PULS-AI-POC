                                                                                
*--------------------------------------------------------------------*          
*                                                                    *          
* BESTÄLLT AV ........ :                                             *          
*                                                                    *          
* DATUM .............. :                                             *          
*                                                                    *          
* ENGÅNGSJOBB (JA/NEJ) :                                             *          
*                                                                    *          
* UPPGIFT ... : LISTA ÖVER PRIMÄRKONTROLLSFREKVENS                   *          
*                                                                    *          
*                                                                    *          
*                                                                    *          
*--------------------------------------------------------------------*          
*                                                                               
FILE W42682D1                                                                   
%W4266801   'IN-'                                                               
FILLER      1 208 A                                                             
*                                                                               
FILE W42682D2                                                                   
%W91042  'W910-'                                                                
*                                                                               
FILE UTFIL FB (15 0) VIRTUAL RETAIN                                             
UT-IDARTNR   1 5 P 0                                                            
UT-KDKVAKTL  6 4 A                                                              
UT-KVSPEC   10 1 N 0                                                            
UT-FLPRIM   11 1 A                                                              
UT-FLNY     12 1 A                                                              
UT-KVKR     13 1 N 0                                                            
UT-IDDC     14 2 A                                                              
*                                                                               
FILE W42682D3 PRINTER FB (121 121)                                              
*                                                                               
FILE W42682D4 PRINTER FB (121 121)                                              
*                                                                               
NEWPAGE                                                                         
%WDATAREA                                                                       
NEWPAGE                                                                         
*                                                                               
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
WDATKONV                W  8  A VALUE 'WDATKONV'                                
*                                                                               
FELTEXT                 W  80  A                                                
JA                      W   1  A VALUE 'J'                                      
NEJ                     W   1  A VALUE 'N'                                      
SKRIV-POST              W   1  A VALUE 'N'                                      
WS-IDARTNR              W   8  N                                                
WS-TIREGDAT             W   7  N                                                
WS-ANTPRIM-CDC          W   5  N MASK 'ZZZZZ'                                   
WS-ANTNY-CDC            W   5  N MASK 'ZZZZZ'                                   
WS-ANTSPEC-CDC          W   5  N MASK 'ZZZZZ'                                   
WS-ANTKR-CDC            W   5  N MASK 'ZZZZZ'                                   
WS-ANTERS-CDC           W   5  N MASK 'ZZZZZ'                                   
WS-ANTPRIM-ST           W   5  N MASK 'ZZZZZ'                                   
WS-ANTNY-ST             W   5  N MASK 'ZZZZZ'                                   
WS-ANTSPEC-ST           W   5  N MASK 'ZZZZZ'                                   
WS-ANTKR-ST             W   5  N MASK 'ZZZZZ'                                   
WS-ANTERS-ST            W   5  N MASK 'ZZZZZ'                                   
WS-DIFF                 W   2  N 0                                              
*                                                                               
          WS-IDLOPNRM   W   8  N                                                
WS-DAT    WS-IDLOPNRM       3  N                                                
WS-NR     WS-IDLOPNRM  +3   4  N                                                
WS-SIF    WS-IDLOPNRM  +7   1  N                                                
FIL-TIRP                W   4  N                                                
*                                                                               
           WS-TIRP      W   4  N                                                
WS-TIAA    WS-TIRP          2  N                                                
WS-TIPP    WS-TIRP     +2   2  N                                                
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
JOB INPUT W42682D1 START A-INIT                                                 
IF IN-IDPTYP = '101'                                                            
   IF SKRIV-POST = JA                                                           
     PUT UTFIL                                                                  
     UT-KVKR = +0                                                               
     UT-KVSPEC = +0                                                             
   END-IF                                                                       
   IF IN-FLKVAUTV-KVAL = JA AND IN-KDKVASTA-PRI NE '0'                          
     WS-IDLOPNRM = IN-IDLOPNRM                                                  
     IF WS-NR < +5000                                                           
       UT-IDDC     = CDC-SE                                                     
     ELSE                                                                       
       UT-IDDC     = CDC-TR                                                     
     END-IF                                                                     
     UT-IDARTNR  = IN-IDARTNR                                                   
     UT-KDKVAKTL = IN-KDKVAKTL                                                  
     IF IN-FLSKPSAK = JA                                                        
       UT-FLPRIM   = JA                                                         
       UT-FLNY     = NEJ                                                        
     ELSE                                                                       
       UT-FLNY     = JA                                                         
       UT-FLPRIM   = NEJ                                                        
     END-IF                                                                     
     UT-KVSPEC   = +0                                                           
     UT-KVKR     = +0                                                           
     PERFORM B-KOLLA-DAT                                                        
     IF FIL-TIRP = WS-TIRP                                                      
       MOVE JA TO SKRIV-POST                                                    
     END-IF                                                                     
   ELSE                                                                         
     UT-IDARTNR  = IN-IDARTNR                                                   
     UT-KDKVAKTL = IN-KDKVAKTL                                                  
     UT-FLPRIM   = NEJ                                                          
     UT-FLNY     = NEJ                                                          
     UT-KVSPEC   = +0                                                           
     UT-KVKR     = +0                                                           
     PERFORM B-KOLLA-DAT                                                        
     MOVE NEJ TO SKRIV-POST                                                     
   END-IF                                                                       
ELSE                                                                            
  IF IN-IDPTYP = '111'                                                          
    IF SKRIV-POST = JA                                                          
      UT-KVKR   = UT-KVKR + +1                                                  
    ELSE                                                                        
     UT-KVKR   = +1                                                             
     IF FIL-TIRP = WS-TIRP                                                      
       MOVE JA TO SKRIV-POST                                                    
     END-IF                                                                     
    END-IF                                                                      
  ELSE                                                                          
    IF IN-IDPTYP = '112'                                                        
      IF SKRIV-POST = JA                                                        
        UT-KVSPEC = UT-KVSPEC + +1                                              
      ELSE                                                                      
       UT-KVSPEC = +1                                                           
       IF FIL-TIRP = WS-TIRP                                                    
         MOVE JA TO SKRIV-POST                                                  
       END-IF                                                                   
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
*                                                                               
A-INIT. PROC                                                                    
                                                                                
  DAT-KDDATFORM = 'IDAG  '                                                      
                                                                                
  CALL WDATKONV USING (DAT-KDDATFORM, +                                         
                       DAT-I-TIDATUM, +                                         
                       DAT-O-TIDATUM, +                                         
                       DAT-KDSVAR)                                              
                                                                                
  IF DAT-KDSVAR = ' '                                                           
    MOVE  DAT-TIAARP-GRP  TO WS-TIRP                                            
  ELSE                                                                          
    MOVE 'FEL FRÅN DATKONV I SECTION A-INIT' TO FELTEXT                         
    STOP EXECUTE                                                                
  END-IF                                                                        
                                                                                
  WS-DIFF = WS-TIPP - +3                                                        
  IF WS-DIFF < +1                                                               
    IF WS-TIAA = 00                                                             
      WS-TIAA  = 99                                                             
    ELSE                                                                        
      WS-TIAA  = WS-TIAA - +1                                                   
    END-IF                                                                      
    WS-TIPP = +12 + WS-DIFF                                                     
  ELSE                                                                          
    WS-TIPP = WS-DIFF                                                           
  END-IF                                                                        
END-PROC                                                                        
*                                                                               
B-KOLLA-DAT. PROC                                                               
                                                                                
  DAT-KDDATFORM = 'AAMMDD'                                                      
  DAT-I-TIDATUM = IN-TIREGDAT                                                   
                                                                                
  CALL WDATKONV USING (DAT-KDDATFORM, +                                         
                       DAT-I-TIDATUM, +                                         
                       DAT-O-TIDATUM, +                                         
                       DAT-KDSVAR)                                              
                                                                                
  IF DAT-KDSVAR = ' '                                                           
    MOVE  DAT-TIAARP-GRP  TO FIL-TIRP                                           
  ELSE                                                                          
    MOVE 'FEL FRÅN DATKONV I SECTION B-KOLLA' TO FELTEXT                        
    STOP EXECUTE                                                                
  END-IF                                                                        
                                                                                
END-PROC                                                                        
*                                                                               
SORT UTFIL TO UTFIL USING UT-IDARTNR                                            
*                                                                               
JOB INPUT (W42682D2  KEY (W910-IDARTNR) +                                       
           UTFIL   KEY (UT-IDARTNR)) FINISH Z-FINIT                             
IF MATCHED                                                                      
  WS-IDARTNR = UT-IDARTNR                                                       
  IF UT-FLPRIM = JA                                                             
    IF UT-IDDC = CDC-SE                                                         
      WS-ANTPRIM-CDC = WS-ANTPRIM-CDC + 1                                       
    ELSE                                                                        
      WS-ANTPRIM-ST = WS-ANTPRIM-ST + 1                                         
    END-IF                                                                      
  END-IF                                                                        
  IF UT-FLNY   = JA                                                             
    IF UT-IDDC = CDC-SE                                                         
      WS-ANTNY-CDC = WS-ANTNY-CDC + 1                                           
    ELSE                                                                        
      WS-ANTNY-ST = WS-ANTNY-ST + 1                                             
    END-IF                                                                      
  END-IF                                                                        
  IF UT-KVSPEC > 0                                                              
    IF UT-IDDC = CDC-SE                                                         
      WS-ANTSPEC-CDC = WS-ANTSPEC-CDC + UT-KVSPEC                               
    ELSE                                                                        
      WS-ANTSPEC-ST = WS-ANTSPEC-ST + UT-KVSPEC                                 
    END-IF                                                                      
  END-IF                                                                        
  IF UT-KVKR > 0                                                                
    IF UT-IDDC  = CDC-SE                                                        
      WS-ANTKR-CDC = WS-ANTKR-CDC + UT-KVKR                                     
    ELSE                                                                        
      WS-ANTKR-ST = WS-ANTKR-ST + UT-KVKR                                       
    END-IF                                                                      
  END-IF                                                                        
  IF W910-KDERS > 0                                                             
    IF UT-IDDC = CDC-SE                                                         
      WS-ANTERS-CDC = WS-ANTERS-CDC + 1                                         
    ELSE                                                                        
      WS-ANTERS-ST = WS-ANTERS-ST + 1                                           
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
                                                                                
Z-FINIT. PROC                                                                   
                                                                                
PRINT W42682D3                                                                  
PRINT W42682D4                                                                  
END-PROC                                                                        
*                                                                               
REPORT W42682D3 LINESIZE 120 SPACE 4  PRINTER W42682D3                          
                                                                                
TITLE 01    'VOLVO CAR AFTERSALES AB              W42682-001'                   
TITLE 02    'PRIMÄRKONTROLLSTATISTIK CDC PERIOD ' WS-TIRP                       
                                                                                
HEADING     WS-ANTPRIM-CDC ('ANT SKIPLOT ')                                     
HEADING     WS-ANTNY-CDC   ('ANT NYA ART')                                      
HEADING     WS-ANTSPEC-CDC ('ANT SPEC')                                         
HEADING     WS-ANTKR-CDC   ('ANT KR')                                           
HEADING     WS-ANTERS-CDC  ('ANT ERS ART')                                      
                                                                                
LINE 01     WS-ANTPRIM-CDC WS-ANTNY-CDC WS-ANTSPEC-CDC WS-ANTKR-CDC +           
            WS-ANTERS-CDC                                                       
*                                                                               
*                                                                               
REPORT W42682D4 LINESIZE 120 SPACE 4  PRINTER W42682D4                          
                                                                                
TITLE 01    'VOLVO CAR AFTERSALES AB              W42682-002'                   
TITLE 02    'PRIMÄRKONTROLLSTATISTIK ST  PERIOD ' WS-TIRP                       
                                                                                
HEADING     WS-ANTPRIM-ST  ('ANT SKIPLOT')                                      
HEADING     WS-ANTNY-ST    ('ANT NYA ART')                                      
HEADING     WS-ANTSPEC-ST  ('ANT SPEC')                                         
HEADING     WS-ANTKR-ST    ('ANT KR')                                           
HEADING     WS-ANTERS-ST   ('ANT ERS ART')                                      
                                                                                
LINE 01     WS-ANTPRIM-ST WS-ANTNY-ST WS-ANTSPEC-ST WS-ANTKR-ST +               
            WS-ANTERS-ST                                                        
*                                                                               
