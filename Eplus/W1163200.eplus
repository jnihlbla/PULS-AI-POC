                                                                                
*----------------------------------------------------------------------*        
*  PROGRAM    :  W1163200                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR W91042(0) OCH W116.W11632(0)                           
*                SKAPAR NYTT REGISTER                                  *        
*                       FIL FÖRÄNDRAD KDERS                            *        
*                                                                      *        
*  FÖRFATTARE :  BODIL LINDAHL                                         *        
*                                                                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
*    -- CHECKED BY WY2000                                                       
*                                                                               
*--------------------------------------*                                        
*   W91042                             *                                        
* -------------------------------------*                                        
FILE W11632D1                                                                   
%W91042  'CLAG-'                                                                
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W11632 REGISTER IN                  *                                        
* -------------------------------------*                                        
FILE W11632D2                                                                   
REGIN-IDARTNR  1  9 N                                                           
REGIN-KDERS    10 2 N                                                           
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W11632 REGISER UT                   *                                        
* -------------------------------------*                                        
FILE W11632D3 FB (11 27995)                                                     
REGUT-IDARTNR  1  9 N                                                           
REGUT-KDERS    10 2 N                                                           
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W11633 ARTIKLAR FÖRÄNDRAD KDERS     *                                        
* -------------------------------------*                                        
FILE W11632D4 FB (12 27996)                                                     
%W11173    'UT-'                                                                
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  ARBETSFÄLT                          *                                        
* -------------------------------------*                                        
*                                                                               
 W-IDLOPNR    W 3 N VALUE 0                                                     
*                                                                               
%WWPRODSL  'CLAG-' WORK ''                                                      
*                                                                               
NEWPAGE                                                                         
*                                                                               
*------------------------------------------------------------------*            
* STEG 1. MATCHAR ARTIKELDATA                                      *            
*         SKRIVER UTFIL                                            *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT (W11632D1 KEY (CLAG-IDARTNR)                         +                
           W11632D2 KEY (REGIN-IDARTNR))                                        
                                                                                
 IF MATCHED                                                                     
    PERFORM S25-CHECK-CLAG-KDPRODSL                                             
    IF CLAG-KDPRODSL NE KDPRODSL-LYNK                                           
       IF CLAG-KDERS = REGIN-KDERS             +                                
       OR CLAG-KDERS-UTG = REGIN-KDERS                                          
          REGUT-IDARTNR  = REGIN-IDARTNR                                        
          REGUT-KDERS    = REGIN-KDERS                                          
          IF REGIN-KDERS > 0                                                    
             PUT W11632D3                                                       
          END-IF                                                                
       ELSE                                                                     
          UT-IDARTNR    = CLAG-IDARTNR                                          
          UT-KDERS-OLD  = REGIN-KDERS                                           
          UT-KDERS-NEW  = CLAG-KDERS                                            
          W-IDLOPNR     = W-IDLOPNR + 1                                         
          UT-IDLOPNR    = W-IDLOPNR                                             
          PUT W11632D4                                                          
                                                                                
          REGUT-IDARTNR = CLAG-IDARTNR                                          
          REGUT-KDERS   = CLAG-KDERS                                            
          PUT W11632D3                                                          
       END-IF                                                                   
    END-IF                                                                      
 ELSE                                                                           
    IF W11632D1                                                                 
       IF CLAG-KDERS > 0                                                        
          PERFORM S25-CHECK-CLAG-KDPRODSL                                       
          IF CLAG-KDPRODSL NE KDPRODSL-LYNK                                     
            UT-IDARTNR   = CLAG-IDARTNR                                         
            UT-KDERS-OLD = 0                                                    
            UT-KDERS-NEW = CLAG-KDERS                                           
            W-IDLOPNR    = W-IDLOPNR + 1                                        
            UT-IDLOPNR   = W-IDLOPNR                                            
            PUT W11632D4                                                        
                                                                                
            REGUT-IDARTNR = CLAG-IDARTNR                                        
            REGUT-KDERS   = CLAG-KDERS                                          
            PUT W11632D3                                                        
         END-IF                                                                 
       END-IF                                                                   
    END-IF                                                                      
 END-IF                                                                         
*                                                                               
%WWPRODSL 'CLAG-' PROC ''                                                       
*                                                                               
