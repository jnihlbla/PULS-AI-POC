                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W42845                                                *        
*                                                                      *        
*  FUNKTION   :  SUMMERAR OCH SORTERAR PERIODENS FAKTURERADE RADER     *        
*                SKAPAR FIL TILL KREDITERINGS UPPFÖLJNINGEN            *        
*                                                                      *        
*  FÖRFATTARE :  JAN-ERIK FRANTZEN                                     *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W42845D1                                                                   
%W47905F     'IN-'                                                              
*                                                                               
NEWPAGE                                                                         
FILE W42845D2 FB (38 0)                                                         
%W42845      'UT-'                                                              
*                                                                               
NEWPAGE                                                                         
*                                                                               
%WWPRODSL  'IN-' WORK ''                                                        
*                                                                               
%WDATAREA                                                                       
*                                                                               
WDATKONV        W  8   A   VALUE 'WDATKONV'                                     
*                                                                               
*---------------- LÄNKAREA FÖR DATUMKORT                                        
%WDATKORT     'DAT-'                                                            
*                                                                               
    JA                    W          1         A  VALUE 'J'                     
    NEJ                   W          1         A  VALUE 'N'                     
    PROGRAM-NAMN          W          6         A  VALUE 'W42845'                
    DATUMKORT-ID          W          6         A  VALUE 'WDATUM'                
    WS-TISEKEL            W          2         N                                
    WS-TIAARP             W          4         N                                
    WS-DATUM              W          6         N                                
    WS-AAR                WS-DATUM   2         N                                
    WS-MAANAD             WS-DATUM  +2  2      N                                
    WS-DAG                WS-DATUM  +4  2      N                                
    WS-IDARTNR            W          5         P    0                           
    WS-IDDISTR            W          3         P    0                           
    WS-IDKUNDNR           W          4         P    0                           
    WS-IDDC               W          2         A                                
    WS-IDDC-RET           W          2         A                                
    WS-IDFTG              W          2         N    0                           
    WS-KDORDKL            W          1         P    0                           
    WS-PRARTNTO           W          7         P    2                           
    WS-RAD-RAKNARE        W          5         P    0                           
    WS-KDFAKTYP           W          1         A                                
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
*SORT W42845D1 TO W42845D1 USING +                                              
*    (IN-IDDISTR, IN-IDKUNDNR, IN-IDDC-LEV, IN-KDORDKL, IN-IDARTNR)             
                                                                                
                                                                                
*JOB INPUT W42845D1 START A-INIT                                                
JOB INPUT NULL START A-INIT                                                     
  GET W42845D1                                                                  
  WS-IDARTNR     = +0                                                           
  WS-IDDC        = '  '                                                         
  WS-IDDC-RET    = '  '                                                         
  WS-KDFAKTYP    = ' '                                                          
  WS-IDFTG       = 0                                                            
  WS-IDDISTR     = +0                                                           
  WS-IDKUNDNR    = +0                                                           
  WS-KDORDKL     = +0                                                           
  WS-PRARTNTO    = +0                                                           
  WS-RAD-RAKNARE = +0                                                           
  DO WHILE NOT EOF W42845D1                                                     
     WS-IDARTNR  = IN-IDARTNR                                                   
     WS-IDDC     = IN-IDDC-LEV                                                  
     WS-IDDC-RET = IN-IDDC-RET                                                  
     WS-KDFAKTYP = IN-KDFAKTYP                                                  
     WS-IDFTG    = IN-IDFTG                                                     
     WS-IDDISTR  = IN-IDDISTR                                                   
     WS-IDKUNDNR = IN-IDKUNDNR                                                  
     WS-KDORDKL  = IN-KDORDKL                                                   
     DO WHILE NOT EOF W42845D1             AND   +                              
              IN-IDDISTR   = WS-IDDISTR    AND     +                            
              IN-IDKUNDNR  = WS-IDKUNDNR   AND     +                            
              IN-IDDC-LEV  = WS-IDDC       AND     +                            
              IN-KDORDKL   = WS-KDORDKL    AND     +                            
              IN-IDARTNR   = WS-IDARTNR                                         
        PERFORM S25-CHECK-IN-KDPRODSL                                           
        IF IN-FLDIRLEV = 'N'   AND  +                                           
           IN-KDPRODSL = KDPRODSL-VOLVO-BIMA                                    
           WS-RAD-RAKNARE = WS-RAD-RAKNARE + 1                                  
           WS-PRARTNTO = WS-PRARTNTO + (IN-PRARTNTO * IN-KVLEVART2)             
        END-IF                                                                  
        GET W42845D1                                                            
     END-DO                                                                     
     UT-IDDISTR     = WS-IDDISTR                                                
     UT-IDKUNDNR    = WS-IDKUNDNR                                               
     UT-IDDC        = WS-IDDC                                                   
     UT-IDDC-RET    = WS-IDDC-RET                                               
     UT-KDFAKTYP    = WS-KDFAKTYP                                               
     UT-IDFTG       = WS-IDFTG                                                  
     UT-KDORDKL     = WS-KDORDKL                                                
     UT-KVRADER     = WS-RAD-RAKNARE                                            
     UT-PRARTNTO    = WS-PRARTNTO                                               
     UT-TIFAKT-TISEKEL-PER = WS-TISEKEL                                         
     UT-TIFAKT-TIAAPP      = WS-TIAARP                                          
     PUT W42845D2                                                               
     WS-PRARTNTO    = +0                                                        
     WS-RAD-RAKNARE = +0                                                        
  END-DO                                                                        
STOP                                                                            
*                                                                               
                                                                                
*------------------------------------------------------*                        
* A-INIT    HÄMTAR DAGENS DATUM, INNEVARANDE PERIOD MM *                        
*------------------------------------------------------*                        
*                                                                               
 A-INIT.  PROC                                                                  
*                                                                               
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DAT-DATUMKORT)                  
*                                                                               
  WS-AAR    = DAT-D-AAR                                                         
  WS-MAANAD = DAT-D-MAANAD                                                      
  WS-DAG    = DAT-D-DAG                                                         
* WS-AAR    = 96                                                                
* WS-MAANAD = 05                                                                
* WS-DAG    = 04                                                                
  DISPLAY ' DAGENS DATUM : ' WS-DATUM                                           
*                                                                               
  DAT-I-TIDATUM = WS-DATUM                                                      
  DAT-KDDATFORM = 'AAMMDD'                                                      
  CALL WDATKONV USING (DAT-KDDATFORM DAT-I-TIDATUM DAT-O-TIDATUM +              
                       DAT-KDSVAR)                                              
*                                                                               
  IF DAT-KDSVAR NE ' '                                                          
     DISPLAY ' *************************** '                                    
     DISPLAY ' FEL VID ANROP TILL WDATKONV '                                    
     DISPLAY ' *************************** '                                    
     STOP EXECUTE                                                               
  END-IF                                                                        
  WS-TISEKEL          = DAT-TISEKEL                                             
  WS-TIAARP           = DAT-TIAARP                                              
  DISPLAY ' INNEVARANDE SEKEL  ' WS-TISEKEL                                     
  DISPLAY ' INNEVARANDE PERIOD ' WS-TIAARP                                      
                                                                                
 END-PROC                                                                       
*                                                                               
%WWPRODSL 'IN-' PROC ''                                                         
*                                                                               
*SORT W42845D2 TO W42845D2 USING +                                              
*    (UT-IDDISTR, UT-IDKUNDNR, UT-IDDC, UT-KDORDKL)                             
*                                                                               
