                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2247600                                              *        
*                                                                      *        
*  FUNKTION   :  REPORT - EXCEL VIA DISTRIBUTION PRINT                 *        
*                PART UPDATED WITH STOP DATE FOR ALARM 223             *        
*                                                                      *        
*  FÖRFATTARE :  STENING INGER                                         *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W22476D1                                                                   
%W01184  'IN-'                                                                  
                                                                                
FILE W22476D2                                                                   
%W01160  'IN-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE W224TMP FB(18 18) VIRTUAL                                                  
*                                                                               
%W22165    'TMP-'                                                               
NEWPAGE                                                                         
*                                                                               
FILE W22476D3 VB(39 0)                                                          
UT-AREA-CN                    1 35 A                                            
                                                                                
FILE W22476D4 VB(39 0)                                                          
UT-AREA-US                    1 35 A                                            
                                                                                
W-HEAD                         W 35 A                                           
W-HEAD-IDDC          W-HEAD       2 A                                           
W-HEAD-SEM1          W-HEAD   +3  1 A                                           
W-HEAD-IDANSK        W-HEAD   +4  7 A                                           
W-HEAD-SEM2          W-HEAD  +11  1 A                                           
W-HEAD-IDLEVNR       W-HEAD  +12  5 A                                           
W-HEAD-SEM3          W-HEAD  +17  1 A                                           
W-HEAD-TISTODAT-LARM W-HEAD  +18  9 A                                           
W-HEAD-SEM4          W-HEAD  +27  1 A                                           
W-HEAD-IDARTNR       W-HEAD  +28  7 A                                           
                                                                                
W-LINE                         W 30 A                                           
W-LINE-IDDC          W-LINE       2 A                                           
W-LINE-SEM1          W-LINE   +3  1 A                                           
W-LINE-IDANSK        W-LINE   +4  3 N                                           
W-LINE-SEM2          W-LINE   +7  1 A                                           
W-LINE-IDLEVNR       W-LINE   +8  5 A                                           
W-LINE-SEM3          W-LINE  +13  1 A                                           
W-LINE-TISTODAT-LARM W-LINE  +14  6 N                                           
W-LINE-SEM4          W-LINE  +20  1 A                                           
W-LINE-IDARTNR       W-LINE  +21  9 N                                           
*                                                                               
*-------------*                                                                 
* ARBETSAREOR *                                                                 
*-------------*                                                                 
WS-HEAD-CN                     W  1 A VALUE 'Y'                                 
WS-HEAD-US                     W  1 A VALUE 'Y'                                 
*                                                                               
* STEG 1 SELECT PART WITH STOP DATE ALARM AND SUP.CODE < 21                     
*                                                                               
JOB INPUT (W22476D1 KEY (IN-SLAG-IDARTNR) +                                     
           W22476D2 KEY (IN-CLAG-IDARTNR))                                      
                                                                                
  IF MATCHED                                                                    
     IF IN-SLAG-TISTODAT-LARM > +0                                              
        IF IN-CLAG-KDERS < 21                                                   
           TMP-IDDC            = IN-SLAG-IDDC                                   
           TMP-IDANSK          = IN-SLAG-IDANSK                                 
           TMP-IDLEVNR         = IN-SLAG-IDLEVNR                                
           TMP-TISTODAT-LARM   = IN-SLAG-TISTODAT-LARM                          
           TMP-IDARTNR         = IN-SLAG-IDARTNR                                
           PUT W224TMP                                                          
        END-IF                                                                  
     END-IF                                                                     
  END-IF                                                                        
*                                                                               
* STEG 2 SORT W224TMP                                                           
*                                                                               
SORT W224TMP TO +                                                               
     W224TMP USING (TMP-IDDC TMP-IDANSK TMP-IDLEVNR +                           
                    TMP-TISTODAT-LARM TMP-IDARTNR)                              
*                                                                               
* STEG 3 CREATE OUTPUT FILE - EXCEL                                             
*                                                                               
JOB INPUT W224TMP                                                               
                                                                                
  W-LINE-IDDC          = TMP-IDDC                                               
  W-LINE-IDANSK        = TMP-IDANSK                                             
  W-LINE-IDLEVNR       = TMP-IDLEVNR                                            
  W-LINE-TISTODAT-LARM = TMP-TISTODAT-LARM                                      
  W-LINE-IDARTNR       = TMP-IDARTNR                                            
  W-LINE-SEM1          = ';'                                                    
  W-LINE-SEM2          = ';'                                                    
  W-LINE-SEM3          = ';'                                                    
  W-LINE-SEM4          = ';'                                                    
  IF W-LINE-IDDC > '70' AND W-LINE-IDDC < '80'                                  
     PERFORM S01-WRITE-HEAD                                                     
     UT-AREA-CN        = W-LINE                                                 
     PUT W22476D3                                                               
  ELSE                                                                          
     IF W-LINE-IDDC > '40' AND W-LINE-IDDC < '50'                               
        PERFORM S01-WRITE-HEAD                                                  
        UT-AREA-US     = W-LINE                                                 
        PUT W22476D4                                                            
     END-IF                                                                     
  END-IF                                                                        
                                                                                
S01-WRITE-HEAD. PROC                                                            
  W-HEAD-IDDC          = 'DC'                                                   
  W-HEAD-IDANSK        = 'PROC NO'                                              
  W-HEAD-IDLEVNR       = 'SUPPL'                                                
  W-HEAD-TISTODAT-LARM = 'STOP DATE'                                            
  W-HEAD-IDARTNR       = 'PART NO'                                              
  W-HEAD-SEM1          = ';'                                                    
  W-HEAD-SEM2          = ';'                                                    
  W-HEAD-SEM3          = ';'                                                    
  W-HEAD-SEM4          = ';'                                                    
  IF WS-HEAD-CN = 'Y'                                                           
     UT-AREA-CN = W-HEAD                                                        
     PUT W22476D3                                                               
     WS-HEAD-CN = 'N'                                                           
  END-IF                                                                        
  IF WS-HEAD-US = 'Y'                                                           
     UT-AREA-US = W-HEAD                                                        
     PUT W22476D4                                                               
     WS-HEAD-US = 'N'                                                           
  END-IF                                                                        
END-PROC                                                                        
