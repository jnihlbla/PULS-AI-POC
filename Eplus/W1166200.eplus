                                                                                
*----------------------------------------------------------------------*        
*  PROGRAM    :  W1166200                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR W01160(0) OCH W116.W11662(0)                           
*                SKAPAR NYTT REGISTER                                  *        
*                       FIL FÖRÄNDRAD KDERS                            *        
*                                                                      *        
*  FÖRFATTARE :  BODIL LINDAHL                                         *        
*                                                                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
*    -- CHECKED BY WY2000                                                       
*                                                                               
*--------------------------------------*                                        
*   W01160                             *                                        
* -------------------------------------*                                        
FILE W11662D1                                                                   
%W01160                                                                         
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W11662 REGISTER IN                  *                                        
* -------------------------------------*                                        
FILE W11662D2                                                                   
REGIN-IDARTNR  1  9 N                                                           
REGIN-KDERS    10 2 N                                                           
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W11662 REGISER UT                   *                                        
* -------------------------------------*                                        
FILE W11662D3 FB (11 27995)                                                     
REGUT-IDARTNR  1  9 N                                                           
REGUT-KDERS    10 2 N                                                           
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W11663 ARTIKLAR FÖRÄNDRAD KDERS     *                                        
* -------------------------------------*                                        
FILE W11662D4 FB (12 27996)                                                     
%W11173    'UT-'                                                                
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  ARBETSFÄLT                          *                                        
* -------------------------------------*                                        
*                                                                               
 W-IDLOPNR    W 3 N VALUE 0                                                     
*                                                                               
*    --- VALID KDPRODSL                                                         
%WWPRODSL  'CLAG-' WORK ''                                                      
*                                                                               
NEWPAGE                                                                         
*                                                                               
*------------------------------------------------------------------*            
* STEG 1. MATCHAR ARTIKELDATA                                      *            
*         SKRIVER UTFIL                                            *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT (W11662D1 KEY (CLAG-IDARTNR)                         +                
           W11662D2 KEY (REGIN-IDARTNR))                                        
                                                                                
 IF MATCHED                                                                     
    PERFORM S25-CHECK-CLAG-KDPRODSL                                             
    IF CLAG-KDPRODSL NE KDPRODSL-LYNK                                           
       IF CLAG-KDERS     = REGIN-KDERS            +                             
       OR CLAG-KDERS-UTG = REGIN-KDERS                                          
          REGUT-IDARTNR  = REGIN-IDARTNR                                        
          REGUT-KDERS    = REGIN-KDERS                                          
          IF REGIN-KDERS > 0                                                    
             PUT W11662D3                                                       
          END-IF                                                                
       ELSE                                                                     
          UT-IDARTNR    = CLAG-IDARTNR                                          
          UT-KDERS-OLD  = REGIN-KDERS                                           
          UT-KDERS-NEW  = CLAG-KDERS                                            
          W-IDLOPNR     = W-IDLOPNR + 1                                         
          UT-IDLOPNR    = W-IDLOPNR                                             
          PUT W11662D4                                                          
                                                                                
          REGUT-IDARTNR = CLAG-IDARTNR                                          
          REGUT-KDERS   = CLAG-KDERS                                            
          PUT W11662D3                                                          
       END-IF                                                                   
    END-IF                                                                      
 ELSE                                                                           
    IF W11662D1                                                                 
       IF CLAG-KDERS > 0                                                        
          PERFORM S25-CHECK-CLAG-KDPRODSL                                       
          IF CLAG-KDPRODSL NE KDPRODSL-LYNK                                     
             UT-IDARTNR   = CLAG-IDARTNR                                        
             UT-KDERS-OLD = 0                                                   
             UT-KDERS-NEW = CLAG-KDERS                                          
             W-IDLOPNR    = W-IDLOPNR + 1                                       
             UT-IDLOPNR   = W-IDLOPNR                                           
             PUT W11662D4                                                       
                                                                                
             REGUT-IDARTNR = CLAG-IDARTNR                                       
             REGUT-KDERS   = CLAG-KDERS                                         
             PUT W11662D3                                                       
          END-IF                                                                
       END-IF                                                                   
    END-IF                                                                      
 END-IF                                                                         
*                                                                               
%WWPRODSL 'CLAG-' PROC ''                                                       
*                                                                               
