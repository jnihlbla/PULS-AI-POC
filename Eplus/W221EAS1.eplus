                                                                                
*                                                                               
 FILE INFIL01                            . * INFIL                              
*                                                                               
   DD-KORT  15    2  A                                                          
*                                                                               
 FILE UTFILD3                            . * UTFIL                              
 FILE UTFILD4                            . * UTFIL                              
 FILE UTFILD5                            . * UTFIL                              
 FILE UTFILD6                            . * UTFIL                              
 FILE UTFILD7                            . * UTFIL                              
 FILE UTFILD8                            . * UTFIL                              
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
*-------------*                                                                 
* JOB         *                                                                 
*-------------*                                                                 
 JOB INPUT(NULL)                                                                
 GET INFIL01                            . * READ RECORDS                        
*                                                                               
 IF EOF INFIL01                                                                 
    STOP                                                                        
 END-IF                                                                         
*                                                                               
 IF DD-KORT = 'D3'                                                              
    PUT UTFILD3 FROM INFIL01                                                    
    GO TO JOB                                                                   
 END-IF                                                                         
 IF DD-KORT = 'D4'                                                              
    PUT UTFILD4 FROM INFIL01                                                    
    GO TO JOB                                                                   
 END-IF                                                                         
 IF DD-KORT = 'D5'                                                              
    PUT UTFILD5 FROM INFIL01                                                    
    GO TO JOB                                                                   
 END-IF                                                                         
 IF DD-KORT = 'D6'                                                              
    PUT UTFILD6 FROM INFIL01                                                    
    GO TO JOB                                                                   
 END-IF                                                                         
 IF DD-KORT = 'D7'                                                              
    PUT UTFILD7 FROM INFIL01                                                    
    GO TO JOB                                                                   
 END-IF                                                                         
 IF DD-KORT = 'D8'                                                              
    PUT UTFILD8 FROM INFIL01                                                    
    GO TO JOB                                                                   
 END-IF                                                                         
*                                                                               
