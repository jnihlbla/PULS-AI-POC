  BEPRODSL(37) =       '047             '                                       
  BEPRODSL(38) =       '048             '                                       
  BEPRODSL(39) =       '049             '                                       
  BEPRODSL(40) =       '050             '                                       
  BEPRODSL(41) =       '051PARTS POLESTAR'                                      
  BEPRODSL(42) =       '052              '                                      
  BEPRODSL(43) =       '053CHEMICAL POLES'                                      
  BEPRODSL(44) =       '054EXCHANGE POLESTAR'                                   
  BEPRODSL(45) =       '055ACCESSORIES POL'                                     
  BEPRODSL(46) =       '056AUDIO POLESTAR'                                      
  BEPRODSL(47) =       '057TELEPHONES POLE'                                     
  BEPRODSL(48) =       '058TOOLS POLESTAR'                                      
