NEWPAGE                                                                         
                                                                                
SKAPA-STD-UTFALLS-TRANS. PROC                                                   
  IF TRANS-VV LE AKT-VV AND TRANS-AAR = AKT-AAR                                 
    T1-STD-VECKA-UPP       = 0                                                  
    T1-STD-VECKA-NED       = 0                                                  
    T1-STD-VECKA-TOT       = 0                                                  
    T1-STD-ACK-UPP         = 0                                                  
    T1-STD-ACK-NED         = 0                                                  
    T1-STD-ACK-TOT         = 0                                                  
    T1-STD-FJOL-UPP        = 0                                                  
    T1-STD-FJOL-NED        = 0                                                  
    T1-STD-FJOL-TOT        = 0                                                  
    T1-STD-ACK-UTF         = RW1-SUARTSTD                                       
    PERFORM SKRIV-TPFIL1                                                        
  END-IF                                                                        
END-PROC                                                                        
                                                                                
SKAPA-GJORDA-INV-TRANS. PROC                                                    
  T1-STD-VECKA-UPP         = 0                                                  
  T1-STD-VECKA-NED         = 0                                                  
  T1-STD-VECKA-TOT         = 0                                                  
  T1-STD-ACK-UPP           = 0                                                  
  T1-STD-ACK-NED           = 0                                                  
  T1-STD-ACK-TOT           = 0                                                  
  T1-STD-FJOL-UPP          = 0                                                  
  T1-STD-FJOL-NED          = 0                                                  
  T1-STD-FJOL-TOT          = 0                                                  
  T1-STD-ACK-UTF           = 0                                                  
  IF RW2-DAVVREG EQ AKT-DAVVREG                                                 
    IF RW2-KDWRTYP = 0421                                                       
      T1-STD-VECKA-UPP     = RW2-SUARTSTD                                       
      T1-STD-VECKA-TOT     = RW2-SUARTSTD                                       
    ELSE                                                                        
      T1-STD-VECKA-NED     = RW2-SUARTSTD                                       
      T1-STD-VECKA-TOT     = RW2-SUARTSTD * -1                                  
    END-IF                                                                      
    PERFORM SKRIV-TPFIL1                                                        
    T1-STD-VECKA-UPP       = 0                                                  
    T1-STD-VECKA-NED       = 0                                                  
    T1-STD-VECKA-TOT       = 0                                                  
  END-IF                                                                        
                                                                                
  IF TRANS-VV LE AKT-VV AND TRANS-AAR = AKT-AAR                                 
    IF RW2-KDWRTYP = 0421                                                       
      T1-STD-ACK-UPP       = RW2-SUARTSTD                                       
      T1-STD-ACK-TOT       = RW2-SUARTSTD                                       
    ELSE                                                                        
      T1-STD-ACK-NED       = RW2-SUARTSTD                                       
      T1-STD-ACK-TOT       = RW2-SUARTSTD * -1                                  
    END-IF                                                                      
    PERFORM SKRIV-TPFIL1                                                        
  END-IF                                                                        
                                                                                
  IF TRANS-VV LE AKT-VV AND TRANS-AAR = F-AAR                                   
    IF RW2-KDWRTYP = 0421                                                       
      T1-STD-FJOL-UPP      = RW2-SUARTSTD                                       
      T1-STD-FJOL-TOT      = RW2-SUARTSTD                                       
    ELSE                                                                        
      T1-STD-FJOL-NED      = RW2-SUARTSTD                                       
      T1-STD-FJOL-TOT      = RW2-SUARTSTD * -1                                  
    END-IF                                                                      
    PERFORM SKRIV-TPFIL1                                                        
  END-IF                                                                        
END-PROC                                                                        
                                                                                
SKRIV-TPFIL1. PROC                                                              
  T1-IDDC       = RW1-IDDC                                                      
  T1-KDPRODSL   = RW1-KDPRODSL                                                  
                                                                                
*** TOTAL FÖR ALLA DC                                                           
  T1-IDDC     = '99'                                                            
  PUT TPFIL1                                                                    
                                                                                
*** TOTAL FÖR ALLA PS                                                           
  T1-IDDC     = RW1-IDDC                                                        
  T1-KDPRODSL = 900                                                             
  PUT TPFIL1                                                                    
                                                                                
*** TOTAL-TOTAL FÖR ALLA PS O DC                                                
  T1-IDDC     = '99'                                                            
  T1-KDPRODSL = 900                                                             
  PUT TPFIL1                                                                    
                                                                                
*** SUMMERA VCC, CARPAC, RENAULT                                                
  IF RW1-KDPRODSL EQ 11 THRU 29                                                 
    IF RW1-KDPRODSL EQ 11 THRU 19                                               
*** TOTAL FÖR VCC                                                               
      T1-KDPRODSL = 910                                                         
    ELSE-IF RW1-KDPRODSL EQ 21 THRU 29                                          
*** TOTAL FÖR CARPAC                                                            
      T1-KDPRODSL = 920                                                         
    END-IF                                                                      
    T1-IDDC       = RW1-IDDC                                                    
    PUT TPFIL1                                                                  
                                                                                
*** TOTAL FÖR ALLA DC - VCC, CARPAC, RENAULT                                    
    T1-IDDC       = '99'                                                        
    PUT TPFIL1                                                                  
  END-IF                                                                        
  IF RW1-KDPRODSL EQ 71 THRU 74                                                 
*** TOTAL FÖR BIMA                                                              
      T1-KDPRODSL = 970                                                         
    PUT TPFIL1                                                                  
  END-IF                                                                        
END-PROC                                                                        
NEWPAGE                                                                         
*--------------------------------------------------------*                      
* JOBSTEG 2 SORTERA TPFIL1 TILL TPFIL1 PER DC OCH PRODSL                        
*--------------------------------------------------------*                      
                                                                                
SORT TPFIL1 TO TPFIL1 USING (T1-IDDC T1-KDPRODSL) SIZE 200000                   
                                                                                
NEWPAGE                                                                         
*-------------------------------------------*                                   
* JOBSTEG 3 SUMMERA TPFIL1 PER DC O PRODSL                                      
*-------------------------------------------*                                   
                                                                                
JOB INPUT NULL                                                                  
   PERFORM SKAPA-XCEL-HEADER                                                    
   GET TPFIL1                                                                   
   IF NOT EOF TPFIL1                                                            
     W2-IDDC            = T1-IDDC                                               
     W2-KDPRODSL        = T1-KDPRODSL                                           
     W2-STD-VECKA-UPP   = 0                                                     
     W2-STD-VECKA-NED   = 0                                                     
     W2-STD-VECKA-TOT   = 0                                                     
     W2-STD-ACK-UPP     = 0                                                     
     W2-STD-ACK-NED     = 0                                                     
     W2-STD-ACK-TOT     = 0                                                     
     W2-STD-FJOL-UPP    = 0                                                     
     W2-STD-FJOL-NED    = 0                                                     
     W2-STD-FJOL-TOT    = 0                                                     
     W2-STD-ACK-UTF     = 0                                                     
     DO WHILE NOT EOF TPFIL1                                                    
       IF T1-IDDC     = W2-IDDC AND                            +                
          T1-KDPRODSL = W2-KDPRODSL                                             
         W2-STD-VECKA-UPP = W2-STD-VECKA-UPP + T1-STD-VECKA-UPP                 
         W2-STD-VECKA-NED = W2-STD-VECKA-NED + T1-STD-VECKA-NED                 
         W2-STD-VECKA-TOT = W2-STD-VECKA-TOT + T1-STD-VECKA-TOT                 
         W2-STD-ACK-UPP   = W2-STD-ACK-UPP   + T1-STD-ACK-UPP                   
         W2-STD-ACK-NED   = W2-STD-ACK-NED   + T1-STD-ACK-NED                   
         W2-STD-ACK-TOT   = W2-STD-ACK-TOT   + T1-STD-ACK-TOT                   
         W2-STD-FJOL-UPP  = W2-STD-FJOL-UPP  + T1-STD-FJOL-UPP                  
         W2-STD-FJOL-NED  = W2-STD-FJOL-NED  + T1-STD-FJOL-NED                  
         W2-STD-FJOL-TOT  = W2-STD-FJOL-TOT  + T1-STD-FJOL-TOT                  
         W2-STD-ACK-UTF   = W2-STD-ACK-UTF   + T1-STD-ACK-UTF                   
       ELSE                                                                     
         PERFORM SKAPA-LISTOR-FILER                                             
                                                                                
         W2-IDDC            = T1-IDDC                                           
         W2-KDPRODSL        = T1-KDPRODSL                                       
         W2-STD-VECKA-UPP   = T1-STD-VECKA-UPP                                  
         W2-STD-ACK-UPP     = T1-STD-ACK-UPP                                    
         W2-STD-FJOL-UPP    = T1-STD-FJOL-UPP                                   
         W2-STD-VECKA-NED   = T1-STD-VECKA-NED                                  
         W2-STD-ACK-NED     = T1-STD-ACK-NED                                    
         W2-STD-FJOL-NED    = T1-STD-FJOL-NED                                   
         W2-STD-VECKA-TOT   = T1-STD-VECKA-TOT                                  
         W2-STD-ACK-TOT     = T1-STD-ACK-TOT                                    
         W2-STD-FJOL-TOT    = T1-STD-FJOL-TOT                                   
         W2-STD-ACK-UTF     = T1-STD-ACK-UTF                                    
       END-IF                                                                   
       GET TPFIL1                                                               
     END-DO                                                                     
     PERFORM SKAPA-LISTOR-FILER                                                 
   END-IF                                                                       
  STOP                                                                          
                                                                                
SKAPA-XCEL-HEADER. PROC                                                         
******SKAPA HEADER RECORD FÖR PC EXCELFIL                                       
  W-DAT    = AKT-VV                                                             
  XL-HEADER = W-WEEK                                                            
  PUT W51738DD                                                                  
END-PROC                                                                        
                                                                                
SKAPA-LISTOR-FILER. PROC                                                        
   PERFORM HAMTA-BEPRODSL                                                       
   PERFORM SKAPA-PC-EXCEL-RAD                                                   
                                                                                
*----------------------------------------------------------*                    
*    HÄR SKAPAS LISTA IDDC 11 - 26, 61, 62 OCH TOTAL                            
*    TRE RADER ÅT GÅNGEN                                                        
*----------------------------------------------------------*                    
**    VECKA UPP RADEN   -----------------------------------*                    
   W-STD-VECKA   ROUNDED = W2-STD-VECKA-UPP / 1000                              
   W-STD-VSNITT  ROUNDED = W2-STD-ACK-UPP   / (1000 * AKT-VV)                   
   W-STD-ACK     ROUNDED = W2-STD-ACK-UPP   / 1000                              
   IF W2-STD-ACK-UTF NE 0                                                       
     W-STD-ACK-DIFFP ROUNDED =                                     +            
         100 * W2-STD-ACK-UPP / W2-STD-ACK-UTF                                  
   ELSE                                                                         
     W-STD-ACK-DIFFP = 0                                                        
   END-IF                                                                       
   W-STD-DIFF ROUNDED =                                            +            
      (W2-STD-ACK-UPP - W2-STD-FJOL-UPP) / 1000                                 
   IF W2-STD-ACK-UPP NE 0                                                       
     W-STD-DIFF-PROC ROUNDED =                                      +           
      100 * (W2-STD-ACK-UPP - W2-STD-FJOL-UPP) / W2-STD-FJOL-UPP                
   ELSE                                                                         
     W-STD-DIFF-PROC = 0                                                        
   END-IF                                                                       
   W-KOMM     = '   UP'                                                         
   PERFORM SKAPA-LISTRAD-O-UTPOST                                               
                                                                                
**    VECKA NED RADEN   -----------------------------------*                    
   W-BEPRODSL = ' '                                                             
   W-STD-VECKA   ROUNDED = W2-STD-VECKA-NED / 1000                              
   W-STD-VSNITT  ROUNDED = W2-STD-ACK-NED   / (1000 * AKT-VV)                   
   W-STD-ACK     ROUNDED = W2-STD-ACK-NED   / 1000                              
   IF W2-STD-ACK-UTF NE 0                                                       
     W-STD-ACK-DIFFP ROUNDED = 100 * W2-STD-ACK-NED               +             
          / W2-STD-ACK-UTF                                                      
   ELSE                                                                         
     W-STD-ACK-DIFFP = 0                                                        
   END-IF                                                                       
   W-STD-DIFF    ROUNDED =                                           +          
     (W2-STD-ACK-NED - W2-STD-FJOL-NED) / 1000                                  
   IF W2-STD-ACK-NED NE 0                                                       
     W-STD-DIFF-PROC ROUNDED =                                     +            
       100 * (W2-STD-ACK-NED - W2-STD-FJOL-NED) / W2-STD-FJOL-NED               
   ELSE                                                                         
     W-STD-DIFF-PROC = 0                                                        
   END-IF                                                                       
   W-KOMM = ' DOWN'                                                             
   PERFORM SKAPA-LISTRAD-O-UTPOST                                               
                                                                                
**    VECKA TOT RADEN   -----------------------------------*                    
   W-STD-VECKA   ROUNDED = W2-STD-VECKA-TOT / 1000                              
   W-STD-VSNITT  ROUNDED = W2-STD-ACK-TOT   / (1000 * AKT-VV)                   
   W-STD-ACK     ROUNDED = W2-STD-ACK-TOT   / 1000                              
   IF W2-STD-ACK-UTF NE 0                                                       
     W-STD-ACK-DIFFP ROUNDED = 100 * W2-STD-ACK-TOT / W2-STD-ACK-UTF            
   ELSE                                                                         
     W-STD-ACK-DIFFP = 0                                                        
   END-IF                                                                       
   W-STD-DIFF ROUNDED = (W2-STD-ACK-TOT - W2-STD-FJOL-TOT) / 1000               
   IF W2-STD-ACK-TOT NE 0                                                       
     W-STD-DIFF-PROC ROUNDED = 100 *                              +             
               (W2-STD-ACK-TOT - W2-STD-FJOL-TOT)                 +             
               / W2-STD-FJOL-TOT                                                
   ELSE                                                                         
     W-STD-DIFF-PROC = 0                                                        
   END-IF                                                                       
   W-KOMM      = '  NET'                                                        
   PERFORM SKAPA-LISTRAD-O-UTPOST                                               
END-PROC                                                                        
                                                                                
SKAPA-LISTRAD-O-UTPOST. PROC                                                    
  IF W2-IDDC = NDC-JP                                                           
  END-IF                                                                        
  IF W2-IDDC  = SDC-ES                                                          
          PRINT RAPPORT24                                                       
  ELSE-IF W2-IDDC  = SDC-AT                                                     
          PRINT RAPPORT26                                                       
  ELSE-IF W2-IDDC  = NDC-JP                                                     
  UT1-BEPRODSL         = W-BEPRODSL                                             
  UT1-KOMM             = W-KOMM                                                 
  UT1-STD-VECKA        = W-STD-VECKA                                            
  UT1-STD-VSNITT       = W-STD-VSNITT                                           
  UT1-STD-ACK          = W-STD-ACK                                              
  UT1-STD-ACK-DIFFP    = W-STD-ACK-DIFFP                                        
  UT1-STD-DIFF         = W-STD-DIFF                                             
  UT1-STD-DIFF-PROC    = W-STD-DIFF-PROC                                        
          PRINT RAPPORT61                                                       
  ELSE-IF W2-IDDC  = NDC-AU                                                     
          PRINT RAPPORT62                                                       
  END-IF                                                                        
                                                                                
  IF W2-IDDC       = '99'                                                       
    WS-IDDC        = 'TO'                                                       
    W-TOTAL        = 'TOTAL'                                                    
  ELSE                                                                          
    WS-IDDC        = W2-IDDC                                                    
    W-TOTAL        = '     '                                                    
  END-IF                                                                        
  PERFORM SKAPA-UTPOST-WEBFIL                                                   
  PRINT RAPPORT01-OND                                                           
END-PROC                                                                        
                                                                                
SKAPA-UTPOST-WEBFIL. PROC                                                       
  UT-IDAFPRCD            = '1'                                                  
  UT-IDDC                = WS-IDDC                                              
  UT-TIVV                = AKT-VV                                               
  UT-BEPRODSL            = W-BEPRODSL                                           
  UT-BETEXT              = W-KOMM                                               
  UT-SUARTSTD-WEEK       = W-STD-VECKA                                          
  UT-SUARTSTD-WEEKAVG    = W-STD-VSNITT                                         
  UT-SUARTSTD-TOT        = W-STD-ACK                                            
  UT-REDIFF              = W-STD-ACK-DIFFP                                      
  UT-SUARTSTD-DIFF       = W-STD-DIFF                                           
  UT-REDIFF-LYEAR        = W-STD-DIFF-PROC                                      
  PUT W51738DW                                                                  
END-PROC                                                                        
                                                                                
HAMTA-BEPRODSL. PROC                                                            
  W-BEPRODSL  = 'ÖVRIGA'                                                        
  IX = 1                                                                        
  DO WHILE IX LE 98                                                             
    IF W2-KDPRODSL EQ BEPRODSL-PS(IX)                                           
      W-BEPRODSL  = BEPRODSL-TXT(IX)                                            
      IX = 99                                                                   
    END-IF                                                                      
    IX = IX + 1                                                                 
  END-DO                                                                        
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
SKAPA-PC-EXCEL-RAD. PROC                                                        
  XL-PS            = W-BEPRODSL                                                 
  XL-IDDC          = W2-IDDC                                                    
  XL-UP-WK ROUNDED = W2-STD-VECKA-UPP / 1000                                    
  XL-DN-WK ROUNDED = W2-STD-VECKA-NED / 1000                                    
  XL-UP-YR ROUNDED = W2-STD-ACK-UPP   / 1000                                    
  XL-DN-YR ROUNDED = W2-STD-ACK-NED   / 1000                                    
  XL-SL-YR ROUNDED = W2-STD-ACK-UTF   / 1000                                    
  XL-HEADER        = XLFILE                                                     
  PUT W51738DD                                                                  
END-PROC                                                                        
NEWPAGE                                                                         
