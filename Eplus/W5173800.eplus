  BEPRODSL(82) =       '920          '                                          
  BEPRODSL(83) =       '930CHEMICALS LOC'                                       
  BEPRODSL(84) =       '940EXCHANGE LOC'                                        
  BEPRODSL(85) =       '950ACCESSORIES LOC'                                     
  BEPRODSL(86) =       '960RADIO LOC'                                           
  BEPRODSL(87) =       '970TELEPHONES LOC'                                      
