*                ÖVER GJORDA INVENTERINGAR                             *        
*                                                                      *        
*  FÖRFATTARE :  KJ HANSSON                                            *        
*                                                                      *        
*  INFIL      :  W51741                                                *        
*                                                                      *        
*  LISTOR:    D2, W517O1     FIL TILL ONDEMAND, ALLA DC                *        
*             DD, W51742     EXCEL TILL MAIL VIA DAP                   *        
*             DW, W51738     FIL TILL DAP, ALLA WEB-LDC                *        
*             D4, W51738-021 ENDAST LISTAN FÖR SDC 21 HOLLAND          *        
*             D6, W51738-024 ENDAST LISTAN FÖR SDC 24 SPANIEN          *        
*             D7, W51738-025 ENDAST LISTAN FÖR SDC 25 ITALIEN          *        
*             D8, W51738-026 ENDAST LISTAN FÖR SDC 26 ÖSTERRIKE        *        
*             D9, W51738-061 ENDAST LISTAN FÖR NDC 61 JAPAN            *        
*             DA, W51738-062 ENDAST LISTAN FÖR NDC 62 AUSTRALIEN       *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W51738D1                                                                   
%W517RW1   'RW1-'                                                               
%W517RW2   'RW2-'                                                               
NEWPAGE                                                                         
                                                                                
* TEMPFIL MED DIVERSE LISTTRANSAR, EJ SUMMERADE                                 
FILE TPFIL1 FB(74 0)                                                            
T1-AREA            1 74 A                                                       
