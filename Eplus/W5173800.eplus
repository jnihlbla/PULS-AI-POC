T1-STD-VECKA-UPP   5 7 P 2                                                      
T1-STD-ACK-UPP    12 7 P 2                                                      
T1-STD-FJOL-UPP   19 7 P 2                                                      
T1-STD-VECKA-NED  26 7 P 2                                                      
T1-STD-ACK-NED    33 7 P 2                                                      
T1-STD-FJOL-NED   40 7 P 2                                                      
T1-STD-VECKA-TOT  47 7 P 2                                                      
T1-STD-ACK-TOT    54 7 P 2                                                      
T1-STD-FJOL-TOT   61 7 P 2                                                      
T1-STD-ACK-UTF    68 7 P 2                                                      
                                                                                
* ARBETSAREA FÖR SUMMERADE T1-POSTER                                            
W2-IDDC           W  2 A                                                        
W2-KDPRODSL       W  2 P                                                        
W2-STD-VECKA-UPP  W  7 P 2                                                      
W2-STD-ACK-UPP    W  7 P 2                                                      
W2-STD-FJOL-UPP   W  7 P 2                                                      
W2-STD-VECKA-NED  W  7 P 2                                                      
W2-STD-ACK-NED    W  7 P 2                                                      
W2-STD-FJOL-NED   W  7 P 2                                                      
W2-STD-VECKA-TOT  W  7 P 2                                                      
W2-STD-ACK-TOT    W  7 P 2                                                      
W2-STD-FJOL-TOT   W  7 P 2                                                      
W2-STD-ACK-UTF    W  7 P 2                                                      
                                                                                
