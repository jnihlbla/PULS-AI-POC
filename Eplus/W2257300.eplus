                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2257300                                              *        
*                                                                      *        
*  FUNKTION   :  SECURITE LIST TO PURCHASE PLANNING                    *        
*                                                                      *        
*  FÖRFATTARE :  STENING INGER                                         *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W22573D1                                                                   
%W2250201  'IN-'                                                                
                                                                                
FILE W22573D2 PRINTER VB(125 0)                                                 
                                                                                
%WDATKORT                                                                       
*                                                                               
PROGRAM-NAMN       W  6  A  VALUE 'W22573'                                      
DATUMKORT-ID       W  6  A  VALUE 'WDATUM'                                      
                                                                                
W-IDANSK    W  3 N   MASK 'ZZ9'         HEADING ('PURCHASE' 'PLANNER')          
W-REINKORD  W  8 N 0 MASK 'ZZZZZZZ9'    HEADING ('INCOMING' 'LINES')            
W-REAVBRAD  W 10 N 2 MASK 'ZZZZZZZ9,99' HEADING ('BOOKED' 'LINES')              
W-SERVICE   W  5 N 2 MASK 'ZZ9,99'      HEADING ('SERVICE' '%')                 
*                                                                               
JOB INPUT W22573D1 START A-INIT                                                 
*                                                                               
   W-IDANSK   = IN-IDANSK                                                       
   W-REINKORD = IN-REINKORD                                                     
   W-REAVBRAD = IN-REAVBRAD                                                     
                                                                                
   PRINT LISTA                                                                  
                                                                                
A-INIT.  PROC                                                                   
CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                        
END-PROC                                                                        
                                                                                
REPORT LISTA              +                                                     
       PRINTER W22573D2   +                                                     
       LINESIZE 120       +                                                     
       PAGESIZE 1000      +                                                     
       SPACE 5            +                                                     
       SUMMARY            +                                                     
       NOADJUST           +                                                     
       NOSPREAD           +                                                     
       NODATE                                                                   
                                                                                
CONTROL FINAL W-IDANSK                                                          
                                                                                
TITLE 01 COL 01 'SERVICE CDC'   +                                               
         COL 50 'W22573-001'    +                                               
         COL 65 'DATE'          +                                               
         COL 70 D-AAR           +                                               
         COL 73 D-MAANAD        +                                               
         COL 76 D-DAG                                                           
LINE  01   +                                                                    
W-IDANSK   +                                                                    
W-REINKORD +                                                                    
W-REAVBRAD +                                                                    
W-SERVICE                                                                       
                                                                                
BEFORE-BREAK. PROC                                                              
W-SERVICE = 100 * (W-REAVBRAD / W-REINKORD) + 0.005                             
END-PROC                                                                        
                                                                                
