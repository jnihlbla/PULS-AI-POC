                                                                                
******************************************************************              
*                                                                               
* PROGRAM     : W5517700.                                                       
*                                                                               
* FUNKTION    : AVSTÄMNINGSLISTOR FÖR PRISSÄTTNING AV KALKYLPÅLÄGG              
*               DETTA PROGRAM ÄR EN SPECIAL FÖR SVANTESSON                      
*               ATT KÖRAS DÅ OCH DÅ EFTER ÅRSSLUT                               
*                                                                               
*      INFILER  W55177D1 FILER MED PÅLÄGG AVSEDD FÖR SPIS                       
*               SAMT DAGSFÄRSKT FRÅN FILEN PARTINFO                             
*                                                                               
*               W55177D3  CREATE .CSV LIST AND SEND TO DAP                      
*                                                                               
* FÖRFATTARE  : ARUP DATTA                                                      
*                                                                               
******************************************************************              
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE W55177D1                                                                   
IN-IDARTNR           1  5 P 0                                                   
IN-KDPRODSL         176 2 P                                                     
IN-FOR              411 4 A                                                     
IN-FORP             412 3 N                                                     
IN-FORPA            412 3 A                                                     
IN-KVAKS-CDC        427 4 P 0                                                   
IN-KVAKS-PAV        431 4 P 0                                                   
IN-KVEFRS           459 4 P 0                                                   
IN-KVLS             477 4 P 0                                                   
IN-PB-SEP           501 4 P 1                                                   
IN-PB-SATS          505 4 P 1                                                   
IN-PB-TPO           509 4 P 1                                                   
IN-PB-NDC           513 4 P 1                                                   
IN-PB-SDC           517 4 P 1                                                   
IN-PRDIRLON         577 4 P 3                                                   
IN-PRDMTRL          581 5 P 3                                                   
IN-PROVRPAL         593 4 P 3                                                   
                                                                                
FILE W55177D2                                                                   
I2-IDARTNR           1  5 P 0                                                   
I2-KVBEHOVAR         19 4 P 0                                                   
                                                                                
**** TEMPORARY FIL                                                              
FILE TPFIL1 FB(53 0)                                                            
T1-IDARTNR           1  5 P 0                                                   
T1-FPTYP             6  2 P 0                                                   
T1-KDPRODSL          8  2 P 0                                                   
T1-PRDIRLON          10 4 P 3                                                   
T1-PRDMTRL           14 5 P 3                                                   
T1-PROVRPAL          19 4 P 3                                                   
T1-PRDIRLON-NY       23 4 P 3                                                   
T1-PRDMTRL-NY        27 5 P 3                                                   
T1-PROVRPAL-NY       32 4 P 3                                                   
T1-KVBEHOVAR         36 4 P 0                                                   
T1-FILLER1           40 4 P 1                                                   
T1-AK-LS-EFR         44 5 P 0                                                   
T1-FILLER2           49 5 P 0                                                   
                                                                                
**** EXCEL-FIL, MAIL VIA DAP                                                    
FILE W55177D3 PRINTER VB(159 0)                                                 
                                                                                
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
W-FPTYP                             W  3 N     MASK ('ZZ9')                     
W-PRDIRLON                          W 11 N 2   MASK ('ZZZZZZZZ9.99')            
W-PRDIRLON-HEL W-PRDIRLON              9 N 0                                    
W-PRDIRLON-DEC W-PRDIRLON           +9 2 N                                      
W-PRDIRLON-NY                       W 11 N 2   MASK ('ZZZZZZZZ9.99')            
W-PRDIRLON-HEL-NY W-PRDIRLON-NY        9 N 0                                    
W-PRDIRLON-DEC-NY W-PRDIRLON-NY     +9 2 N                                      
W-PRDMTRL                           W 11 N 2   MASK ('ZZZZZZZZ9.99')            
W-PRDMTRL-HEL  W-PRDMTRL               9 N 0                                    
W-PRDMTRL-DEC  W-PRDMTRL            +9 2 N                                      
W-PRDMTRL-NY                        W 11 N 2   MASK ('ZZZZZZZZ9.99')            
W-PRDMTRL-HEL-NY  W-PRDMTRL-NY         9 N 0                                    
W-PRDMTRL-DEC-NY  W-PRDMTRL-NY      +9 2 N                                      
W-KVBEHOVAR-TOT                     W 11 N 0   MASK ('ZZZZZZZZZZ9')             
W-DM-PROC                           W  5 N 0   MASK ('----9')                   
W-DL-PROC                           W  5 N 0   MASK ('----9')                   
W-FILL-01                           W  1 A     VALUE ';'                        
                                                                                
*                                                                               
W-DATUM                             W  8 A                                      
JA                                  W  1 A     VALUE 'J'                        
NEJ                                 W  1 A     VALUE 'N'                        
FIRST-REC                           W  1 A     VALUE 'J'                        
FIRST-LINE                          W  1 A     VALUE 'J'                        
                                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - *                   
*  STEG 1  SKAPA TPFIL1                                                         
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - *                   
                                                                                
JOB INPUT (W55177D1 KEY IN-IDARTNR W55177D2 KEY I2-IDARTNR) +                   
           START A-INIT NAME AKT002                                             
                                                                                
  IF MATCHED                                                                    
    IF IN-PRDIRLON NQ 0 OR IN-PRDMTRL NQ 0 OR IN-PROVRPAL NQ 0                  
      T1-IDARTNR           = IN-IDARTNR                                         
      IF IN-FORPA NUMERIC                                                       
        T1-FPTYP           = IN-FORP                                            
      ELSE                                                                      
        T1-FPTYP           = 0                                                  
      END-IF                                                                    
      T1-KDPRODSL          = IN-KDPRODSL                                        
      T1-PRDIRLON          = IN-PRDIRLON                                        
      T1-PRDMTRL           = IN-PRDMTRL                                         
      T1-PROVRPAL          = IN-PROVRPAL                                        
      T1-PRDIRLON-NY       = IN-PRDIRLON                                        
      T1-PRDMTRL-NY        = IN-PRDMTRL                                         
      T1-PROVRPAL-NY       = IN-PROVRPAL                                        
      T1-KVBEHOVAR = 12 * (IN-PB-SEP + IN-PB-SATS + IN-PB-SDC + +               
                           IN-PB-NDC + IN-PB-TPO)                               
      T1-AK-LS-EFR         = IN-KVLS + IN-KVEFRS + IN-KVAKS-PAV +   +           
                             IN-KVAKS-CDC                                       
      W-DL-PROC            = +0                                                 
      W-DM-PROC            = +0                                                 
      PUT TPFIL1                                                                
    END-IF                                                                      
  END-IF                                                                        
                                                                                
A-INIT.  PROC                                                                   
    MOVE SYSDATE TO W-DATUM                                                     
END-PROC                                                                        
                                                                                
SORT TPFIL1 TO TPFIL1 USING (T1-FPTYP)                                          
                                                                                
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - *                   
*  STEG 2                                                                       
*  SKAPA LISTA W55177D3   ÖVER:                                                 
*  KALKYLPÅLÄGG SUMMERAT PER         FÖRPACKNINGSTYP                            
*  BERÄKNAT PÅ PERIODBEHOV.                                                     
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - *                   
                                                                                
JOB INPUT TPFIL1 START A-INIT FINISH Z-FINIT NAME AKT004                        
                                                                                
   IF FIRST-REC    = JA                                                         
      W-FPTYP         = T1-FPTYP                                                
      FIRST-REC       = NEJ                                                     
   END-IF                                                                       
                                                                                
   IF W-FPTYP NE T1-FPTYP                                                       
      PRINT LISTA1                                                              
                                                                                
      W-PRDIRLON      = +0                                                      
      W-PRDMTRL       = +0                                                      
      W-PRDIRLON-NY   = +0                                                      
      W-PRDMTRL-NY    = +0                                                      
      W-DM-PROC       = +0                                                      
      W-DL-PROC       = +0                                                      
      W-KVBEHOVAR-TOT = +0                                                      
   END-IF                                                                       
                                                                                
   W-FPTYP            = T1-FPTYP                                                
   W-PRDIRLON         = W-PRDIRLON + (T1-PRDIRLON * T1-KVBEHOVAR)               
   W-PRDIRLON-NY      = 0                                                       
   W-PRDMTRL          = W-PRDMTRL  + (T1-PRDMTRL  * T1-KVBEHOVAR)               
   W-PRDMTRL-NY       = 0                                                       
                                                                                
   W-KVBEHOVAR-TOT    = W-KVBEHOVAR-TOT + T1-KVBEHOVAR                          
                                                                                
A-INIT.  PROC                                                                   
   FIRST-REC       = JA                                                         
   W-PRDIRLON      = +0                                                         
   W-PRDMTRL       = +0                                                         
   W-PRDIRLON-NY   = +0                                                         
   W-PRDMTRL-NY    = +0                                                         
   W-DM-PROC       = +0                                                         
   W-DL-PROC       = +0                                                         
   W-KVBEHOVAR-TOT = +0                                                         
END-PROC                                                                        
                                                                                
Z-FINIT. PROC                                                                   
   W-DL-PROC       = +0                                                         
   W-DM-PROC       = +0                                                         
   PRINT LISTA1                                                                 
END-PROC                                                                        
                                                                                
*******                                                                         
NEWPAGE                                                                         
*******                                                                         
REPORT     LISTA1               +                                               
           PRINTER W55177D3     +                                               
           LINESIZE 154         +                                               
           PAGESIZE 32767       +                                               
           SPACE 0              +                                               
           SKIP  0              +                                               
           TITLESKIP 0          +                                               
           NOHEADING            +                                               
           NOSPREAD             +                                               
           NOADJUST             +                                               
           NODATE                                                               
                                                                                
 LINE 1    W-FPTYP               W-FILL-01 +                                    
           W-PRDIRLON-NY         W-FILL-01 +                                    
           W-PRDIRLON            W-FILL-01 +                                    
           W-DL-PROC             W-FILL-01 +                                    
           W-PRDMTRL-NY          W-FILL-01 +                                    
           W-PRDMTRL             W-FILL-01 +                                    
           W-DM-PROC             W-FILL-01 +                                    
           W-KVBEHOVAR-TOT       W-FILL-01                                      
*                                                                               
BEFORE-LINE. PROC                                                               
 IF FIRST-LINE = 'J'                                                            
   DISPLAY '¤DAPW55177-001'                                                     
   DISPLAY '¤DAPW55177'                                                         
   DISPLAY 'PACKAGING TYPE;SUM SALARY NEXT YEAR;SUM SALARY THIS YEAR;+          
            CHANGE SALARY (%);SUM MATERIAL NEXT YEAR;SUM MATERIAL THIS+         
             YEAR;CHANGE MATERIAL (%);YEARLY DEMAND;'                           
   FIRST-LINE  = 'N'                                                            
 END-IF                                                                         
END-PROC                                                                        
