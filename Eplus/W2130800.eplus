*OUTFILE AREA                                                                   
**** EXCEL-FIL, MAIL VIA DAP                                                    
FILE W21308D8  VB(258 0)                                                        
UTAREA         1 256 A                                                          
*                                                                               
UT-AREA           W  256  A                                                     
UT-IDLEVNR        UT-AREA        5  A                                           
WS-SEMIKOLON1     UT-AREA +5     1  A  VALUE ';'                                
UT-BELEV          UT-AREA +9    35  A                                           
WS-SEMIKOLON3     UT-AREA +44    1  A  VALUE ';'                                
UT-ADLEV-RAD1     UT-AREA +45   35  A                                           
WS-SEMIKOLON4     UT-AREA +80    1  A  VALUE ';'                                
UT-ADLEV-RAD2-VCC UT-AREA +81   42  A                                           
WS-SEMIKOLON5     UT-AREA +123   1  A  VALUE ';'                                
UT-ADLEV-ORT-VCC  UT-AREA +124  35  A                                           
WS-SEMIKOLON6     UT-AREA +159   1  A  VALUE ';'                                
UT-ADLEVLND       UT-AREA +160  20  A                                           
WS-SEMIKOLON7     UT-AREA +180   3  A  VALUE ';" '                              
UT-IDLEVTLF       UT-AREA +183  20  A                                           
WS-SEMIKOLON8     UT-AREA +203   3  A  VALUE ' ";'                              
UT-IDMAIL         UT-AREA +206  50  A                                           
*                                                                               
*                                                                               
*HEADER AREA                                                                    
UT-HEAD             W  156  A                                                   
UT-SUPPLIER-ID      UT-HEAD       11  A  VALUE 'SUPPLIER ID'                    
WS-SEMIKOLON10      UT-HEAD +11    1  A  VALUE ';'                              
UT-SUPPLIER-NAME    UT-HEAD +22   14  A  VALUE 'SUPPLIER NAME'                  
WS-SEMIKOLON12      UT-HEAD +36    1  A  VALUE ';'                              
UT-SUPPL-ADR-1      UT-HEAD +37   24  A VALUE 'SUPPLIER ADDRESS LINE 1'         
WS-SEMIKOLON13      UT-HEAD +61    1  A  VALUE ';'                              
UT-SUPPL-ADR-2      UT-HEAD +62   24  A VALUE 'SUPPLIER ADDRESS LINE 2'         
WS-SEMIKOLON14      UT-HEAD +86    1  A  VALUE ';'                              
UT-SUPPLIER-TOWN    UT-HEAD +87   14  A  VALUE 'SUPPLIER TOWN'                  
WS-SEMIKOLON15      UT-HEAD +101   1  A  VALUE ';'                              
UT-SUPPLIER-COUNTRY UT-HEAD +102  16  A  VALUE 'SUPPLIER COUNTRY'               
WS-SEMIKOLON16      UT-HEAD +118   1  A  VALUE ';'                              
UT-SUPPLIER-PHONE   UT-HEAD +119  14  A  VALUE 'SUPPLIER PHONE'                 
WS-SEMIKOLON17      UT-HEAD +133   1  A  VALUE ';'                              
UT-SUPPLIER-EMAIL   UT-HEAD +134  14  A  VALUE 'SUPPLIER EMAIL'                 
*                                                                               
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
WS-SOFTWARE                 W    2  A  VALUE 'SW'                               
WS-SEMIKOLON                W    1  A  VALUE ';'                                
FIRST-TIME-SW               W    1  A  VALUE 'J'                                
FIRST-TIME2-SW              W    1  A  VALUE 'J'                                
SKRIV-SW                    W    1  A  VALUE 'N'                                
JA                          W    1  A  VALUE 'J'                                
NEJ                         W    1  A  VALUE 'N'                                
PREVIOUS-IDLEVNR            W    5  A  VALUE '     '                            
K6-IDARTNR                  W    9  N                                           
K7-IDARTNR                  W    9  N                                           
WS-ANTAL                    W   8 A  VALUE 'WS-ANTAL'                           
ANTAL-CLAG-RADER            W   7 N  0                                          
ANTAL-SLAG-RADER            W   7 N  0                                          
107-COUNT                   W   1 N  0                                          
*                                                                               
WS-IDLEVNR            W    5  A                                                 
WS-BELEV              W   35  A                                                 
WS-ADLEV-RAD1         W   35  A                                                 
WS-ADLEV-RAD2-VCC     W   42  A                                                 
WS-ADLEV-ORT-VCC      W   46  A                                                 
WS-ADLEVLND           W   20  A                                                 
WS-IDLEVTLF           W   20  A                                                 
WS-IDMAIL             W   50  A                                                 
WS-IDLEVTLF-KLEV      W   20  A                                                 
*                                                                               
*                                                                               
*----------------------------------------------------------------*              
* STEG 1             JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
***                                                                             
*                                                                               
JOB INPUT W21308D1                                                              
    IF CLAG-KDSORT = WS-SOFTWARE                                                
      CONTINUE                                                                  
    ELSE                                                                        
      IF CLAG-KDERS LT 020                                                      
        TEMP1-CLAG-IDARTNR     = CLAG-IDARTNR                                   
        TEMP1-CLAG-IDLEVNR     = CLAG-IDLEVNR                                   
        PUT W21308D3                                                            
*       TEMPFIL1                                                                
      END-IF                                                                    
    END-IF                                                                      
*                                                                               
JOB INPUT W21308D2                                                              
  IF SLAG-IDDC = '41' '42' '43' '51'                                            
    IF SLAG-KVLS = 0        AND +                                               
       SLAG-KVAKS-SDC = 0 AND +                                                 
       SLAG-KVAKS-PAV = 0                                                       
      CONTINUE                                                                  
    ELSE                                                                        
      IF SLAG-KVPB-REF > 0                                                      
        IF SLAG-FLORDSP-EJRO = NEJ                                              
          TEMP2-SLAG-IDARTNR = SLAG-IDARTNR                                     
          TEMP2-SLAG-IDLEVNR = SLAG-IDLEVNR                                     
          TEMP2-SLAG-IDDC          = SLAG-IDDC                                  
          PUT W21308D4                                                          
*             TEMPFIL2                                                          
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
*                                                                               
*                                                                               
JOB INPUT (W21308D3 KEY(TEMP1-CLAG-IDARTNR)        +                            
           W21308D4 KEY(TEMP2-SLAG-IDARTNR))                                    
*                                                                               
IF MATCHED                                                                      
   K6K7-IDARTNR              = TEMP1-CLAG-IDARTNR                               
   IF TEMP1-CLAG-IDLEVNR = '9998 '                                              
      IF TEMP2-SLAG-IDDC = '41'                                                 
        K6K7-IDLEVNR         = TEMP2-SLAG-IDLEVNR                               
      END-IF                                                                    
   ELSE                                                                         
     K6K7-IDLEVNR            = TEMP1-CLAG-IDLEVNR                               
   END-IF                                                                       
   PUT W21308D5                                                                 
*     TEMPFIL3                                                                  
END-IF                                                                          
*                                                                               
*                                                                               
SORT W21308D5 TO +                                                              
     W21308D5 USING (K6K7-IDLEVNR)                                              
*                                                                               
*                                                                               
*INPUT FILE W213F1                                                              
*                                                                               
JOB INPUT W21308D6                                                              
*                                                                               
  IF FIRST-TIME2-SW = 'J'                                                       
    FIRST-TIME2-SW = 'N'                                                        
    SKRIV-SW = 'N'                                                              
  END-IF                                                                        
*                                                                               
  IF F1-IN-SEGMENT = 'WDF106'                                                   
        107-COUNT       = 0                                                     
*                                                                               
    IF SKRIV-SW = 'J'                                                           
      SKRIV-SW = 'N'                                                            
                                                                                
      PUT W21308D7                                                              
*       TEMPFIL4                                                                
                                                                                
      MOVE SPACE     TO F1S-IDLEVNR                                             
      MOVE SPACE     TO F1S-BELEV                                               
      MOVE SPACE     TO F1S-ADLEV-RAD1                                          
      MOVE SPACE     TO F1S-ADLEV-RAD2-VCC                                      
      MOVE SPACE     TO F1S-ADLEV-ORT-VCC                                       
      MOVE SPACE     TO F1S-ADLEVLND                                            
      MOVE SPACE     TO F1S-IDLEVTLF                                            
      MOVE SPACE     TO F1S-IDLEVTLF-KLEV                                       
      MOVE SPACE     TO F1S-IDMAIL                                              
    END-IF                                                                      
*                                                                               
    F1S-IDLEVNR        = F1-KFB-IDLEVNR                                         
    F1S-BELEV          = F106-BELEV                                             
    F1S-ADLEV-RAD1     = F106-ADLEV-RAD1                                        
    F1S-ADLEV-RAD2-VCC = F106-ADLEV-RAD2-VCC                                    
    F1S-ADLEV-ORT-VCC  = F106-ADLEV-ORT-VCC                                     
    F1S-ADLEVLND       = F106-ADLEVLND                                          
    F1S-IDLEVTLF       = F106-IDLEVTLF                                          
  ELSE                                                                          
    IF F1-IN-SEGMENT = 'WDF107'                                                 
      107-COUNT = 107-COUNT + 1                                                 
      IF 107-COUNT = 1                                                          
        F1S-IDLEVTLF-KLEV   = F107-IDLEVTLF-KLEV                                
        F1S-IDMAIL          = F107-IDMAIL                                       
        SKRIV-SW = 'J'                                                          
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
*                                                                               
*                                                                               
*                                                                               
SORT W21308D7 TO +                                                              
     W21308D7 USING (F1S-IDLEVNR)                                               
*                                                                               
*                                                                               
JOB INPUT (W21308D7 KEY(F1S-IDLEVNR)  +                                         
           W21308D5 KEY(K6K7-IDLEVNR))                                          
*                                                                               
*                                                                               
  IF FIRST-TIME-SW = 'J'                                                        
    UTAREA        = UT-HEAD                                                     
    PUT    W21308D8                                                             
    FIRST-TIME-SW = 'N'                                                         
    PREVIOUS-IDLEVNR    = '     '                                               
  END-IF                                                                        
*                                                                               
*                                                                               
IF MATCHED                                                                      
*                                                                               
  IF PREVIOUS-IDLEVNR = F1S-IDLEVNR                                             
    CONTINUE                                                                    
  ELSE                                                                          
    PREVIOUS-IDLEVNR    = F1S-IDLEVNR                                           
                                                                                
   UT-IDLEVNR           = F1S-IDLEVNR                                           
   UT-BELEV             = F1S-BELEV                                             
   UT-ADLEV-RAD1        = F1S-ADLEV-RAD1                                        
   UT-ADLEV-RAD2-VCC    = F1S-ADLEV-RAD2-VCC                                    
   UT-ADLEV-ORT-VCC     = F1S-ADLEV-ORT-VCC                                     
   UT-ADLEVLND          = F1S-ADLEVLND                                          
   IF F1S-IDLEVTLF-KLEV > '                    '                                
     UT-IDLEVTLF        = F1S-IDLEVTLF-KLEV                                     
   ELSE                                                                         
     UT-IDLEVTLF        = F1S-IDLEVTLF                                          
   END-IF                                                                       
   UT-IDMAIL            = F1S-IDMAIL                                            
*    IF F1S-IDLEVNR = 'AD6D6' 'AD0JW'                                           
*    DISPLAY 'F1S-IDLEVNR      =' F1S-IDLEVNR                                   
*    DISPLAY 'F1S-IDLEVTLF     =' F1S-IDLEVTLF                                  
*    DISPLAY 'F1S-IDLEVTLF-KLEV ' F1S-IDLEVTLF-KLEV                             
*    DISPLAY 'F1S-IDMAIL       =' F1S-IDMAIL                                    
*    DISPLAY 'UT-IDLEVTLF      =' UT-IDLEVTLF                                   
*    END-IF                                                                     
                                                                                
   UTAREA      =  UT-AREA                                                       
   PUT  W21308D8                                                                
  END-IF                                                                        
END-IF                                                                          
*                                                                               
NEWPAGE                                                                         
