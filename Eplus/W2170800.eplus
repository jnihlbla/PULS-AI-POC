NEWPAGE                                                                         
FILE W21708D1                                                                   
* CLAG                                                                          
%W01160  'IN1-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W21708D2                                                                   
* SLAG                                                                          
%W01184  'IN2-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE TEMP1 FB(19 0) VIRTUAL                                                     
TMP-IDARTNR  1 5 P                                                              
TMP-KVPB-REF 6 4 P 1                                                            
TMP-IDDC    10 2 A                                                              
TMP-KVLS    12 4 P 0                                                            
TMP-KVRESS  16 4 P 0                                                            
                                                                                
NEWPAGE                                                                         
FILE W21708D4                                                                   
%W01174  'IN3-'                                                                 
*                                                                               
                                                                                
NEWPAGE                                                                         
FILE W21708D5                                                                   
%W01173  'IN4-'                                                                 
*                                                                               
                                                                                
NEWPAGE                                                                         
FILE W21708D6                                                                   
%W01161  'IN5-'                                                                 
*                                                                               
                                                                                
NEWPAGE                                                                         
FILE W21708D7 FB(366 0)                                                         
%W21708  'UT-'                                                                  
*                                                                               
                                                                                
NEWPAGE                                                                         
*  HJÄLPFÄLT                                                                    
JA                      W   1 A    VALUE 'J'                                    
NEJ                     W   1 A    VALUE 'N'                                    
FIRST-INLEV             W   1 A    VALUE 'N'                                    
WS-BEART-SVE            W  25 A                                                 
WS-BEART-ENG            W  25 A                                                 
WS-KVPB-REF             W  4  P 1                                               
WS-KVBR-TOT             W  4  P 0                                               
WS-PRARTBES-PR          W  5  P 2                                               
WS-KVLS-SDC-LDC         W  4  P 0                                               
WS-KVLS-NDC             W  4  P 0                                               
WS-KVRESS-SDC-LDC       W  4  P 0                                               
WS-KVRESS-NDC           W  4  P 0                                               
WS-DAPRLIST             W  8  N                                                 
                                                                                
TODAYS-AAAAMMDD                      W  8  A                                    
TODAYS-AAAAMMDD-NUM TODAYS-AAAAMMDD     8  N                                    
NEWPAGE                                                                         
*  CHECK IDDC VALUES                                                            
%WWDC99                                                                         
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. FLYTTAR IDARTNR, KVPB-REF, LAGERSALDO OCH RESERVERAT ANTAL            
*         FRÅN W01184 TILL TEMPFIL                                              
*                                                                               
JOB INPUT W21708D2 START (A-INIT)                                               
                                                                                
    TMP-IDARTNR     =  IN2-SLAG-IDARTNR                                         
    TMP-KVPB-REF    =  IN2-SLAG-KVPB-REF                                        
    TMP-IDDC        =  IN2-SLAG-IDDC                                            
    TMP-KVLS        =  IN2-SLAG-KVLS                                            
    TMP-KVRESS      =  IN2-SLAG-KVRESS                                          
    PUT TEMP1                                                                   
                                                                                
A-INIT. PROC                                                                    
TODAYS-AAAAMMDD = SYSDATE                                                       
END-PROC                                                                        
NEWPAGE                                                                         
*                                                                               
* STEG 2. SORTERING AV TEMP1 PÅ IDARTNR                                         
*                                                                               
SORT TEMP1 TO TEMP1 USING (TMP-IDARTNR)                                         
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 3. SKRIVER UTFIL MED ARTIKELINFO IFRÅN W01160                            
*                                             W01173                            
*                                             W01174                            
*                                             W01184 (TEMP1)                    
JOB INPUT NULL                                                                  
                                                                                
  GET W21708D1                                                                  
  GET TEMP1                                                                     
  GET W21708D4                                                                  
  GET W21708D5                                                                  
  GET W21708D6                                                                  
  DO WHILE NOT EOF W21708D1                                                     
                                                                                
*   RÄKNA SAMMAN TOTALA KVPB-REF                                                
*   RÄKNA OCKSÅ FRAM SUMMA KVLS OCH KVRESS                                      
*                      FÖR DELS ALLA SDC+LDC OCH DELS ALLA NDC                  
*                      KINA LDC RÄKNAS MED SOM NDC.                             
                                                                                
    WS-KVPB-REF = 0                                                             
    WS-KVLS-SDC-LDC = 0                                                         
    WS-KVLS-NDC = 0                                                             
    WS-KVRESS-SDC-LDC = 0                                                       
    WS-KVRESS-NDC = 0                                                           
                                                                                
    DO WHILE (NOT EOF TEMP1) AND +                                              
             (TMP-IDARTNR <= IN1-CLAG-IDARTNR)                                  
      IF (TMP-IDARTNR = IN1-CLAG-IDARTNR) AND IN1-CLAG-KDERS = 0                
        WS-KVPB-REF = WS-KVPB-REF + TMP-KVPB-REF                                
      END-IF                                                                    
      PERFORM S23-CHECK-TMP-IDDC                                                
      IF TMP-IDDC EQ SDC LDC                                                    
        WS-KVLS-SDC-LDC   = WS-KVLS-SDC-LDC   + TMP-KVLS                        
        WS-KVRESS-SDC-LDC = WS-KVRESS-SDC-LDC + TMP-KVRESS                      
      END-IF                                                                    
      IF TMP-IDDC EQ NDC                                                        
        WS-KVLS-NDC   = WS-KVLS-NDC   + TMP-KVLS                                
        WS-KVRESS-NDC = WS-KVRESS-NDC + TMP-KVRESS                              
      END-IF                                                                    
      GET TEMP1                                                                 
    END-DO                                                                      
                                                                                
*   HÄMTA SVENSK OCH ENGELSK BENÄMNING IFRÅN W01174                             
                                                                                
    WS-BEART-SVE  = '  '                                                        
    WS-BEART-ENG  = '  '                                                        
    DO WHILE (NOT EOF W21708D4) AND +                                           
             (IN3-IDARTNR <= IN1-CLAG-IDARTNR)                                  
      IF (IN3-IDARTNR = IN1-CLAG-IDARTNR)                                       
        WS-BEART-SVE  = IN3-BEART(8)                                            
        WS-BEART-ENG  = IN3-BEART(4)                                            
      END-IF                                                                    
      GET W21708D4                                                              
    END-DO                                                                      
                                                                                
*   HÄMTA KVBR-TOT IFRÅN W01173                                                 
                                                                                
    WS-KVBR-TOT = 0                                                             
    DO WHILE (NOT EOF W21708D5) AND  +                                          
             (IN4-IDARTNR <= IN1-CLAG-IDARTNR)                                  
      IF (IN4-IDARTNR = IN1-CLAG-IDARTNR)                                       
        WS-KVBR-TOT = WS-KVBR-TOT + IN4-KVBR-TOT                                
      END-IF                                                                    
      GET W21708D5                                                              
    END-DO                                                                      
                                                                                
*   HÄMTA PARTBES-PR FRÅN W01161                                                
                                                                                
    WS-PRARTBES-PR           = +0                                               
    DO WHILE (NOT EOF W21708D6) AND  +                                          
             (IN5-PRL-IDARTNR <= IN1-CLAG-IDARTNR)                              
                                                                                
      IF (IN5-PRL-IDARTNR = IN1-CLAG-IDARTNR)                                   
        WS-DAPRLIST = 99999999 - TODAYS-AAAAMMDD-NUM                            
                                                                                
        IF IN5-PRL-DAPRLIST-9KOMPL >= WS-DAPRLIST                               
          IF WS-PRARTBES-PR = +0 OR FIRST-INLEV = NEJ                           
            IF WS-PRARTBES-PR = +0                                              
              WS-PRARTBES-PR = IN5-PRL-PRARTBES-PR                              
            END-IF                                                              
            IF IN5-PRL-SUINLEV-PR > +0                                          
              FIRST-INLEV    = JA                                               
              WS-PRARTBES-PR = IN5-PRL-PRARTBES-PR                              
            ELSE                                                                
              FIRST-INLEV    = NEJ                                              
            END-IF                                                              
          END-IF                                                                
        ELSE                                                                    
          WS-PRARTBES-PR     = IN1-CLAG-PRARTSTD                                
        END-IF                                                                  
      END-IF                                                                    
      GET W21708D6                                                              
    END-DO                                                                      
                                                                                
    IF IN1-CLAG-KDERS-UTG = 0                                                   
      PERFORM ASSIGN-VALUES-TO-FILE                                             
      PUT W21708D7                                                              
    END-IF                                                                      
                                                                                
    GET W21708D1                                                                
  END-DO                                                                        
  STOP                                                                          
                                                                                
ASSIGN-VALUES-TO-FILE. PROC                                                     
   UT-ADGANG          =   IN1-CLAG-ADGANG                                       
   UT-ADINPORT        =   IN1-CLAG-ADINPORT                                     
   UT-ADLAGOMR        =   IN1-CLAG-ADLAGOMR                                     
   UT-ADPLATS         =   IN1-CLAG-ADPLATS                                      
   UT-ADLAGOMR-SVS    =   IN1-CLAG-ADLAGOMR-SVS                                 
   UT-ADGANG-SVS      =   IN1-CLAG-ADGANG-SVS                                   
   UT-BEART-ENG       =   WS-BEART-ENG                                          
   UT-BEART-SVE       =   WS-BEART-SVE                                          
   UT-BEFT            =   IN1-CLAG-BEFT                                         
   UT-DAPBPLAN        =   IN1-CLAG-DAPBPLAN                                     
   UT-FLIART          =   IN1-CLAG-FLIART                                       
   UT-FLJIT           =   IN1-CLAG-FLJIT                                        
   UT-FLMANQ          =   IN1-CLAG-FLMANQ                                       
   UT-FLREFILL        =   IN1-CLAG-FLREFILL                                     
   UT-FLLSRDEL        =   IN1-CLAG-FLLSRDEL                                     
   UT-IDANSK          =   IN1-CLAG-IDANSK                                       
   UT-IDBERED         =   IN1-CLAG-IDBERED                                      
   UT-IDARTNR         =   IN1-CLAG-IDARTNR                                      
   UT-IDARTNR-EMBQ0   =   IN1-CLAG-IDARTNR-EMBQ0                                
   UT-IDARTNR-EMBQ1   =   IN1-CLAG-IDARTNR-EMBQ1                                
   UT-IDARTNR-EMBQ2   =   IN1-CLAG-IDARTNR-EMBQ2                                
   UT-IDARTNR-EMBQ3   =   IN1-CLAG-IDARTNR-EMBQ3                                
   UT-IDARTNR-EMBQ4   =   IN1-CLAG-IDARTNR-EMBQ4                                
   UT-IDFKNGRP        =   IN1-CLAG-IDFKNGRP                                     
   UT-IDINK           =   IN1-CLAG-IDINK                                        
   UT-IDKAT(1)        =   IN1-CLAG-IDKAT(1)                                     
   UT-IDKAT(2)        =   IN1-CLAG-IDKAT(2)                                     
   UT-IDKAT(3)        =   IN1-CLAG-IDKAT(3)                                     
   UT-IDLEVNR         =   IN1-CLAG-IDLEVNR                                      
   UT-IDPROJ          =   IN1-CLAG-IDPROJ                                       
   UT-KDAVT           =   IN1-CLAG-KDAVT                                        
   UT-KDERS           =   IN1-CLAG-KDERS                                        
   UT-KDFORP          =   IN1-CLAG-KDFORP                                       
   UT-KDFREKKL        =   IN1-CLAG-KDFREKKL                                     
   UT-KDLEVPLF        =   IN1-CLAG-KDLEVPLF                                     
   UT-KDPRISKL        =   IN1-CLAG-KDPRISKL                                     
   UT-KDPRODSL        =   IN1-CLAG-KDPRODSL                                     
   UT-KDSORT          =   IN1-CLAG-KDSORT                                       
   UT-KDUART          =   IN1-CLAG-KDUART                                       
   UT-KDVVKL          =   IN1-CLAG-KDVVKL                                       
   UT-KVAKS-CDC       =   IN1-CLAG-KVAKS-CDC                                    
   UT-KVAKS-PAV       =   IN1-CLAG-KVAKS-PAV                                    
   UT-KVAKS-T         =   IN1-CLAG-KVAKS-T                                      
   UT-KVBR-TOT        =   WS-KVBR-TOT                                           
   UT-KVLS-CDC        =   IN1-CLAG-KVLS                                         
   UT-KVLS-NDC        =   WS-KVLS-NDC                                           
   UT-KVLS-SDC-LDC    =   WS-KVLS-SDC-LDC                                       
   UT-KVMAD-SEP       =   IN1-CLAG-KVMAD-SEP                                    
   UT-KVMP            =   IN1-CLAG-KVMP                                         
   UT-KVPALL          =   IN1-CLAG-KVPALL                                       
   UT-KVPB-PLAN       =   IN1-CLAG-KVPB-PLAN                                    
   UT-KVPB-REF        =   WS-KVPB-REF                                           
   UT-KVPB-SATS       =   IN1-CLAG-KVPB-SATS                                    
   UT-KVPB-SEP        =   IN1-CLAG-KVPB-SEP                                     
   UT-KVPB-TPO        =   IN1-CLAG-KVPB-TPO                                     
   UT-KVQ             =   IN1-CLAG-KVQ                                          
   UT-KVQPACK-0       =   IN1-CLAG-KVQPACK-0                                    
   UT-KVQPACK-1       =   IN1-CLAG-KVQPACK-1                                    
   UT-KVQPACK-2       =   IN1-CLAG-KVQPACK-2                                    
   UT-KVQPACK-3       =   IN1-CLAG-KVQPACK-3                                    
   UT-KVQPACK-4       =   IN1-CLAG-KVQPACK-4                                    
   UT-KVRESS-CDC      =   IN1-CLAG-KVRESS                                       
   UT-KVRESS-NDC      =   WS-KVRESS-NDC                                         
   UT-KVRESS-SDC-LDC  =   WS-KVRESS-SDC-LDC                                     
   UT-KVROS           =   IN1-CLAG-KVROS                                        
   UT-KVSLAGER        =   IN1-CLAG-KVSLAGER                                     
   UT-KVSPANT         =   IN1-CLAG-KVSPANT                                      
   UT-KVSPARR-KVAL-CDC =  IN1-CLAG-KVSPARR-KVAL                                 
   UT-KVVECKOR-LT     =   IN1-CLAG-KVVECKOR-LT                                  
   IF WS-PRARTBES-PR = +0                                                       
      UT-PRARTBES     =   IN1-CLAG-PRARTSTD                                     
   ELSE                                                                         
      UT-PRARTBES     =   WS-PRARTBES-PR                                        
   END-IF                                                                       
   UT-PRARTSTD        =   IN1-CLAG-PRARTSTD                                     
   UT-PRDIRLON        =   IN1-CLAG-PRDIRLON                                     
   UT-PRDMTRL         =   IN1-CLAG-PRDMTRL                                      
   UT-REDIRLEV        =   IN1-CLAG-REDIRLEV                                     
   UT-RESLJUST        =   IN1-CLAG-RESLJUST                                     
   UT-TIDISPIN        =   IN1-CLAG-TIDISPIN                                     
   UT-TIFINLV         =   IN1-CLAG-TIFINLV                                      
   UT-TIPBDAT         =   IN1-CLAG-TIPBDAT                                      
   UT-TIREFSTO        =   IN1-CLAG-TIREFSTO                                     
   UT-TISLJUST        =   IN1-CLAG-TISLJUST                                     
   UT-TIURPROD        =   IN1-CLAG-TIURPROD                                     
   UT-IDLEVNR-SHIP    =   IN1-CLAG-IDLEVNR-SHIP                                 
   UT-VKART           =   IN1-CLAG-VKART                                        
   UT-VLARTNTO        =   IN1-CLAG-VLARTNTO                                     
   UT-KVEOQ           =   IN1-CLAG-KVEOQ                                        
   UT-KVULOAD         =   IN1-CLAG-KVULOAD                                      
   UT-FLNYBER         =   IN1-CLAG-FLNYBER                                      
   UT-KVVORKO         =   IN1-CLAG-KVVORKO                                      
   UT-KDARTURS        =   IN1-CLAG-KDARTURS                                     
   UT-KVPB-TREND      =   IN1-CLAG-KVPB-TREND                                   
   UT-KVVECKOR-TREND  =   IN1-CLAG-KVVECKOR-TREND                               
   UT-TIDATUM-TREND   =   IN1-CLAG-TIDATUM-TREND                                
   UT-TILEVDAG(01)    =   IN1-CLAG-TILEVDAG(01)                                 
   UT-TILEVDAG(02)    =   IN1-CLAG-TILEVDAG(02)                                 
   UT-TILEVDAG(03)    =   IN1-CLAG-TILEVDAG(03)                                 
   UT-TILEVDAG(04)    =   IN1-CLAG-TILEVDAG(04)                                 
   UT-TILEVDAG(05)    =   IN1-CLAG-TILEVDAG(05)                                 
   UT-KDOTFREK        =   IN1-CLAG-KDOTFREK                                     
END-PROC                                                                        
                                                                                
*    --- S23-CHECK-TMP-IDDC (MACRO PROCEDURE)                                   
%WWDC02 'TMP-'                                                                  
