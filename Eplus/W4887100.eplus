NEWPAGE                                                                         
FILE W48871D1                                                                   
*                                                                               
%W4887001  'IN-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W48871D2  PRINTER FB (121 121)                                             
                                                                                
W-IDARTNR    W 5 P                                                              
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
* STEG 1. LISTNING RENSADE POSTER                                               
*                                                                               
JOB INPUT W48871D1                                                              
                                                                                
  IF IN-IDDC     = CDC-SE                                                       
    IF IN-KVBUFF-F > +0 OR IN-KVBUFF-OF > +0 OR +                               
       IN-KVKOLLI-F > +0 OR IN-KVKOLLI-OF > +0                                  
      W-IDARTNR = IN-IDARTNR                                                    
      PRINT LISTA1                                                              
    END-IF                                                                      
  END-IF                                                                        
                                                                                
NEWPAGE                                                                         
REPORT LISTA1  PRINTER W48871D2 LINESIZE 120 DTLCTL FIRST                       
SEQUENCE IN-ADBUFFOMR W-IDARTNR                                                 
TITLE 1  'VOLVO CAR AFTERSALES, RENSADE POSTER FRÅN BUFFERTREGISTRET'           
HEADING IN-ADBUFFOMR 'BO'                                                       
HEADING IN-ADBUFFGANG 'GÅNG'                                                    
HEADING IN-ADBUFFPL   'PLATS'                                                   
HEADING W-IDARTNR 'ARTNR'                                                       
HEADING IN-KVBUFF-F 'FÖRÄDLAT'                                                  
HEADING IN-KVBUFF-OF 'OFÖRÄDLAT'                                                
HEADING IN-KVKOLLI-F 'KOLLI-F'                                                  
HEADING IN-KVKOLLI-OF 'KOLLI-OF'                                                
LINE  1 W-IDARTNR IN-KVBUFF-F IN-KVBUFF-OF IN-KVKOLLI-F IN-KVKOLLI-OF +         
        IN-ADBUFFOMR IN-ADBUFFGANG IN-ADBUFFPL                                  
