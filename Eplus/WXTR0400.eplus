*----------------------------------------------------------------------*        
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE WXTR04D1                                                                   
*                                                                               
%WXTR17   'IN-'                                                                 
*                                                                               
NEWPAGE                                                                         
*                                                                               
*                                                                               
FILE WXTR04D2                                                                   
*                                                                               
   TAB-IDDC             1   2  A                                                
   TAB-IDDISTR          *   4  N                                                
   TAB-BELAND           *  25  A                                                
   TAB-BEMARKET         *  25  A                                                
*                                                                               
FILE WXTR04D3   FB (37 0)                                                       
*     VISS PACK-INFO FÖR VECKOFIL                                               
   UT-IDDC            1    2  A                                                 
   UT-IDPRC           *    4  A                                                 
   UT-KDORDKL         *    1  P 0                                               
   UT-IDDISTR         *    3  P 0                                               
   UT-PACKED-STD      *    6  P 2                                               
   UT-PACKED-AVG      *    6  P 2                                               
   UT-PACKED-LINES    *    3  P 0                                               
   UT-VKARTNTO        *    4  P 3                                               
   UT-VLARTNTO        *    5  P 1                                               
   UT-PACKED-ORDERS   *    3  P 0                                               
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE WXTR04D4   FB (43 0)                                                       
*     INFO SOM SKALL PRINTAS                                                    
   PR-TIAAVV                1    4  A                                           
   PR-IDDC                  *    2  A                                           
   PR-IDPRC                 *    4  A                                           
   PR-KDORDKL               *    1  P   MASK ('9')                              
   PR-IDDISTR               *    3  P                                           
   PR-NOF-ORDERS            *    3  P 0 MASK('ZZ.ZZ9')                          
   PR-NOF-CASES             *    3  P 0 MASK('ZZ.ZZ9')                          
   PR-PACKED-LINES          *    3  P 0 MASK('ZZ.ZZ9')                          
   PR-PACKED-STD            *    5  P 2                                         
   PR-PACKED-AVG            *    5  P 2                                         
   PR-VKARTNTO              *    5  P 3 MASK('ZZZ.ZZ9,999')                     
   PR-VLARTNTO              *    5  P 1 MASK('ZZ.ZZZ.ZZ9,9')                    
*                                                                               
FILE WXTR04D5 FB (121 0)  PRINTER                                               
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
  JA                        W   1  A   VALUE 'J'                                
  NEJ                       W   1  A   VALUE 'N'                                
  FEL                       W   1  A   VALUE 'F'                                
  RKOD-16                   W   4  N   VALUE 16                                 
  FT3                       W  21  A   VALUE 'VOLUME IN CUBIC FEET.'            
  DM3                       W  21  A   VALUE 'VOLUME IN NET DM3.'               
  LITERS                    W  21  A   VALUE 'VOLUME IN LITERS.'                
  POUNDS                    W  21  A   VALUE 'WEIGHT IN POUNDS.'                
  KILOS                     W  21  A   VALUE 'WEIGHT IN KILOS.'                 
  NET-KG                    W  21  A   VALUE 'WEIGHT IN NET KG.'                
  USD                       W  22  A   VALUE 'VALUE IN USD.'                    
  CAD                       W  22  A   VALUE 'VALUE IN CAD.'                    
  CNY                       W  22  A   VALUE 'VALUE IN CNY.'                    
  STD-SEK                   W  22  A   VALUE 'VALUE IN STD SEK.'                
*                                                                               
  W-SORTFALT                W   1  N                                            
  W-BELAND                  W  25  A                                            
  W-PACKED-STD              W   6  P 2                                          
  W-PACKED-AVG              W   6  P 2                                          
  W-PACKED-VAL              W   5  P 2 MASK('Z.ZZZ.ZZ9,99')                     
  W-PACKED-LINES            W   3  P 0                                          
  W-VKARTNTO                W   4  P 3                                          
  W-VLARTNTO                W   5  P 1                                          
  W-NOF-ORDERS              W   3  P 0                                          
  W-NOF-CASES               W   3  P 0                                          
  W-WEIGHT-UNITS            W  21  A                                            
  W-VOLUME-UNITS            W  21  A                                            
  W-CURRENCY                W  22  A                                            
*                                                                               
  SPAR-IDDC                 W   2  A                                            
  SPAR-IDPRC                W   4  A                                            
  SPAR-IDDISTR              W   4  N                                            
  SPAR-IDKUNDNR             W   5  N                                            
  SPAR-KDORDKL              W   1  N                                            
  SPAR-IDORDER              W   7  N                                            
  SPAR-IDKOLLI              W   5  N                                            
*                                                                               
%WDATAREA                                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
%WWOMVAND                                                                       
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT  WXTR04D1                                            +              
                              START  A-INIT                      +              
                              FINISH Z-FINIT                     +              
                              NAME   STEG01                                     
     IF RECORD-COUNT   = 1                                                      
       SPAR-IDDC      = IN-IDDC                                                 
       SPAR-IDPRC     = IN-IDPRC                                                
       SPAR-KDORDKL   = IN-KDORDKL                                              
       SPAR-IDDISTR   = IN-IDDISTR                                              
       SPAR-IDORDER   = IN-IDORDER                                              
       SPAR-IDKUNDNR  = IN-IDKUNDNR                                             
       SPAR-IDKOLLI   = IN-IDKOLLI                                              
     END-IF                                                                     
                                                                                
     PERFORM S23-CHECK-IN-IDDC                                                  
     IF SPAR-IDDC     = IN-IDDC      AND                         +              
        SPAR-IDPRC    = IN-IDPRC     AND                         +              
        SPAR-KDORDKL  = IN-KDORDKL   AND                         +              
        SPAR-IDDISTR  = IN-IDDISTR                                              
                                                                                
       IF SPAR-IDORDER  NQ IN-IDORDER   OR                       +              
          SPAR-IDKUNDNR NQ IN-IDKUNDNR  OR                       +              
          SPAR-IDKOLLI  NQ IN-IDKOLLI                                           
         IF SPAR-IDORDER NQ IN-IDORDER                                          
           W-NOF-ORDERS  = W-NOF-ORDERS + 1                                     
           W-NOF-CASES   = W-NOF-CASES  + 1                                     
           SPAR-IDORDER  = IN-IDORDER                                           
           SPAR-IDKUNDNR = IN-IDKUNDNR                                          
           SPAR-IDKOLLI  = IN-IDKOLLI                                           
         ELSE                                                                   
           W-NOF-CASES   = W-NOF-CASES  + 1                                     
           SPAR-IDKUNDNR = IN-IDKUNDNR                                          
           SPAR-IDKOLLI  = IN-IDKOLLI                                           
         END-IF                                                                 
       END-IF                                                                   
                                                                                
       W-PACKED-LINES    =  W-PACKED-LINES  + 1                                 
       IF IN-IDDC = NDC    OR                                    +              
          IN-IDDC = LDC-CN                                                      
         W-PACKED-AVG    =  W-PACKED-AVG   +                     +              
                           (IN-KVLEVART    * IN-PRAVCOST)                       
       ELSE                                                                     
         W-PACKED-STD    =  W-PACKED-STD   +                     +              
                           (IN-KVLEVART    * IN-PRARTSTD)                       
       END-IF                                                                   
       W-VKARTNTO        =  W-VKARTNTO  +                        +              
                           (IN-VKARTNTO * IN-KVLEVART)                          
       W-VLARTNTO        =  W-VLARTNTO  +                        +              
                           (IN-VLARTNTO * IN-KVLEVART)                          
     ELSE                                                                       
       PERFORM S01-SKRIV-PRINTFIL                                               
       PERFORM S02-SKRIV-VECKOFIL                                               
                                                                                
       IF IN-IDDC = NDC    OR                                    +              
          IN-IDDC = LDC-CN                                                      
         W-PACKED-AVG    = IN-KVLEVART * IN-PRAVCOST                            
       ELSE                                                                     
         W-PACKED-STD    = IN-KVLEVART * IN-PRARTSTD                            
       END-IF                                                                   
       W-PACKED-LINES   = 1                                                     
       W-NOF-ORDERS     = 1                                                     
       W-NOF-CASES      = 1                                                     
       W-VKARTNTO       = IN-VKARTNTO * IN-KVLEVART                             
       W-VLARTNTO       = IN-VLARTNTO * IN-KVLEVART                             
                                                                                
       SPAR-IDDC        = IN-IDDC                                               
       SPAR-IDPRC       = IN-IDPRC                                              
       SPAR-IDDISTR     = IN-IDDISTR                                            
       SPAR-IDKUNDNR    = IN-IDKUNDNR                                           
       SPAR-KDORDKL     = IN-KDORDKL                                            
       SPAR-IDORDER     = IN-IDORDER                                            
       SPAR-IDKUNDNR    = IN-IDKUNDNR                                           
       SPAR-IDKOLLI     = IN-IDKOLLI                                            
     END-IF                                                                     
                                                                                
  A-INIT.  PROC                                                                 
                                                                                
      DAT-KDDATFORM = 'IDAG  '                                                  
                                                                                
      CALL WDATKONV USING (DAT-KDDATFORM                         +              
                           DAT-I-TIDATUM                         +              
                           DAT-O-TIDATUM                         +              
                           DAT-KDSVAR    )                                      
                                                                                
      IF DAT-KDSVAR = FEL                                                       
         RETURN-CODE = RKOD-16                                                  
         STOP EXECUTE                                                           
      END-IF                                                                    
                                                                                
      W-NOF-ORDERS           = 1                                                
      W-NOF-CASES            = 1                                                
      W-PACKED-LINES         = 0                                                
      W-PACKED-VAL           = 0                                                
      W-VKARTNTO             = 0                                                
      W-VLARTNTO             = 0                                                
      W-PACKED-AVG           = 0                                                
      W-PACKED-STD           = 0                                                
                                                                                
    END-PROC                                                                    
*    --- S23-CHECK-IN-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'IN-'                                                                   
*                                                                               
                                                                                
    Z-FINIT.  PROC                                                              
                                                                                
      PERFORM S01-SKRIV-PRINTFIL                                                
      PERFORM S02-SKRIV-VECKOFIL                                                
                                                                                
    END-PROC                                                                    
                                                                                
NEWPAGE                                                                         
                                                                                
  S01-SKRIV-PRINTFIL. PROC                                                      
                                                                                
     PR-TIAAVV        = DAT-TIAAVV-GRP                                          
     PR-IDDC          = SPAR-IDDC                                               
     PR-IDPRC         = SPAR-IDPRC                                              
     PR-KDORDKL       = SPAR-KDORDKL                                            
     PR-IDDISTR       = SPAR-IDDISTR                                            
     PR-NOF-ORDERS    = W-NOF-ORDERS                                            
     PR-NOF-CASES     = W-NOF-CASES                                             
     PR-PACKED-STD    = W-PACKED-STD                                            
     PR-PACKED-AVG    = W-PACKED-AVG                                            
     PR-PACKED-LINES  = W-PACKED-LINES                                          
     PR-VKARTNTO      = W-VKARTNTO                                              
     PR-VLARTNTO      = W-VLARTNTO                                              
                                                                                
     PUT WXTR04D4                                                               
                                                                                
  END-PROC                                                                      
                                                                                
  S02-SKRIV-VECKOFIL. PROC                                                      
                                                                                
     UT-IDDC          = SPAR-IDDC                                               
     UT-IDPRC         = SPAR-IDPRC                                              
     UT-KDORDKL       = SPAR-KDORDKL                                            
     UT-IDDISTR       = SPAR-IDDISTR                                            
     UT-PACKED-STD    = W-PACKED-STD                                            
     UT-PACKED-AVG    = W-PACKED-AVG                                            
     UT-PACKED-LINES  = W-PACKED-LINES                                          
     UT-VKARTNTO      = W-VKARTNTO                                              
     UT-VLARTNTO      = W-VLARTNTO                                              
     UT-PACKED-ORDERS = W-NOF-ORDERS                                            
                                                                                
     PUT WXTR04D3                                                               
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  SORT WXTR04D4 TO WXTR04D4 USING (PR-IDDC                       +              
                                   PR-IDDISTR)                   +              
                                                 NAME   STEG02                  
                                                                                
NEWPAGE                                                                         
                                                                                
  JOB INPUT (WXTR04D2 KEY (TAB-IDDC                              +              
                           TAB-IDDISTR)                          +              
             WXTR04D4 KEY (PR-IDDC                               +              
                           PR-IDDISTR))                          +              
                                                 NAME   STEG03                  
   IF MATCHED                                                                   
      W-BELAND          = TAB-BELAND                                            
      W-SORTFALT        = 1                                                     
      PERFORM S23-CHECK-PR-IDDC                                                 
      IF PR-IDDC = NDC-NA OR                                     +              
         PR-IDDC = NDC-CN OR                                     +              
         PR-IDDC = LDC-CN                                                       
        W-PACKED-VAL   = PR-PACKED-AVG                                          
        IF PR-IDDC = NDC-CA                                                     
          PR-VKARTNTO    = PR-VKARTNTO           * CONV-KG-TO-LB                
          PR-VLARTNTO    = PR-VLARTNTO / 1000000 * CONV-M3-TO-FT3               
*         PR-VLARTNTO    = PR-VLARTNTO / 1000                                   
          W-CURRENCY     = CAD                                                  
          W-WEIGHT-UNITS = POUNDS                                               
          W-VOLUME-UNITS = FT3                                                  
*         W-WEIGHT-UNITS = KILOS                                                
*         W-VOLUME-UNITS = LITERS                                               
        ELSE                                                                    
          IF PR-IDDC = NDC-US                                                   
            PR-VKARTNTO    = PR-VKARTNTO           * CONV-KG-TO-LB              
            PR-VLARTNTO    = PR-VLARTNTO / 1000000 * CONV-M3-TO-FT3             
            W-CURRENCY     = USD                                                
            W-WEIGHT-UNITS = POUNDS                                             
            W-VOLUME-UNITS = FT3                                                
          ELSE                                                                  
            PR-VKARTNTO    = PR-VKARTNTO                                        
            PR-VLARTNTO    = PR-VLARTNTO / 1000                                 
            W-CURRENCY     = CNY                                                
            W-WEIGHT-UNITS = NET-KG                                             
            W-VOLUME-UNITS = DM3                                                
          END-IF                                                                
        END-IF                                                                  
      ELSE                                                                      
        W-PACKED-VAL   = PR-PACKED-STD                                          
        PR-VLARTNTO    = PR-VLARTNTO / 1000                                     
        W-CURRENCY     = STD-SEK                                                
        W-WEIGHT-UNITS = KILOS                                                  
        W-VOLUME-UNITS = LITERS                                                 
      END-IF                                                                    
      PRINT RAPPORT01                                                           
   ELSE                                                                         
      IF WXTR04D4                                                               
         W-BELAND           = 'MISC'                                            
         W-SORTFALT         = 9                                                 
        PERFORM S23-CHECK-PR-IDDC                                               
        IF PR-IDDC = NDC-NA OR                                   +              
           PR-IDDC = NDC-CN OR                                   +              
           PR-IDDC = LDC-CN                                                     
          W-PACKED-VAL   = PR-PACKED-AVG                                        
          IF PR-IDDC = NDC-CA                                                   
            PR-VLARTNTO    = PR-VLARTNTO / 1000000 * CONV-M3-TO-FT3             
            PR-VKARTNTO    = PR-VKARTNTO           * CONV-KG-TO-LB              
*           PR-VLARTNTO    = PR-VLARTNTO / 1000                                 
            W-CURRENCY     = CAD                                                
            W-WEIGHT-UNITS = POUNDS                                             
            W-VOLUME-UNITS = FT3                                                
*           W-WEIGHT-UNITS = KILOS                                              
*           W-VOLUME-UNITS = LITERS                                             
          ELSE                                                                  
            IF PR-IDDC = NDC-CA                                                 
              PR-VLARTNTO    = PR-VLARTNTO / 1000000 * CONV-M3-TO-FT3           
              PR-VKARTNTO    = PR-VKARTNTO           * CONV-KG-TO-LB            
              W-CURRENCY     = USD                                              
              W-WEIGHT-UNITS = POUNDS                                           
              W-VOLUME-UNITS = FT3                                              
            ELSE                                                                
              PR-VKARTNTO    = PR-VKARTNTO                                      
              PR-VLARTNTO    = PR-VLARTNTO / 1000                               
              W-CURRENCY     = CNY                                              
              W-WEIGHT-UNITS = NET-KG                                           
              W-VOLUME-UNITS = DM3                                              
            END-IF                                                              
          END-IF                                                                
        ELSE                                                                    
          W-PACKED-VAL   = PR-PACKED-STD                                        
          PR-VLARTNTO    = PR-VLARTNTO / 1000                                   
          W-CURRENCY     = STD-SEK                                              
          W-WEIGHT-UNITS = KILOS                                                
          W-VOLUME-UNITS = LITERS                                               
        END-IF                                                                  
        PRINT RAPPORT01                                                         
      END-IF                                                                    
   END-IF                                                                       
                                                                                
*    --- S23-CHECK-PR-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'PR-'                                                                   
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    REPORT SECTION                              *              
*----------------------------------------------------------------*              
*                                                                               
    REPORT RAPPORT01 PRINTER WXTR04D5                            +              
                     SUMMARY                                     +              
                     LINESIZE     120                            +              
                     PAGESIZE      41                            +              
                     NODATE                                      +              
                     NOADJUST                                    +              
                     NOSPREAD                                    +              
                     SPACE          1                                           
*                                                                               
    SEQUENCE                                                     +              
              PR-IDDC                                            +              
              W-SORTFALT                                         +              
              PR-IDPRC                                           +              
              PR-KDORDKL                                         +              
              W-BELAND                                                          
*                                                                               
   CONTROL                                                       +              
              FINAL         NOPRINT                              +              
              PR-IDDC               NEWPAGE    RENUM             +              
              W-SORTFALT    NOPRINT                              +              
              PR-IDPRC                                           +              
              PR-KDORDKL                                         +              
              W-BELAND                                                          
*                                                                               
    TITLE 01                                                     +              
    COL   02 'VOLVO CAR CORP., AFTERSALES   WXTR04-001 '         +              
    COL   93  SYSDATE                                                           
*                                                                               
    TITLE 02                                                     +              
    COL   10 'PACKED LINES PER DC AND COUNTRY.'                                 
*                                                                               
    TITLE 03                                                     +              
    COL   10 W-CURRENCY                                          +              
             W-WEIGHT-UNITS                                      +              
             W-VOLUME-UNITS                                                     
*                                                                               
    TITLE 04                                                     +              
    COL   10 'TARGET:  DC' PR-IDDC                                              
*                                                                               
    HEADING   PR-IDPRC          ('PRC')                                         
    HEADING   PR-KDORDKL        ('CLASS')                                       
    HEADING   W-BELAND           'COUNTRY'                                      
    HEADING   PR-NOF-ORDERS     ('ORDERS')                                      
    HEADING   PR-NOF-CASES      ('CASES')                                       
    HEADING   PR-PACKED-LINES   ('LINES')                                       
    HEADING   W-PACKED-VAL       'VALUE'                                        
    HEADING   PR-VKARTNTO        'WEIGHT'                                       
    HEADING   PR-VLARTNTO        'VOLUME'                                       
*                                                                               
    LINE 01                                                       +             
            PR-IDPRC                                              +             
            PR-KDORDKL                                            +             
            W-BELAND                                              +             
            PR-NOF-ORDERS                                         +             
            PR-NOF-CASES                                          +             
            PR-PACKED-LINES                                       +             
            W-PACKED-VAL                                          +             
            PR-VKARTNTO                                           +             
            PR-VLARTNTO                                                         
                                                                                
NEWPAGE                                                                         
