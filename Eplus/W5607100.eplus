                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W513   INVENTERINGEN                                  *        
*                                                                      *        
*  FUNKTION   :  CREATES A D&P LIST PARTS-PHYS-DEV FOR PARTS PUNCHED   *        
*                WITH PHYSICAL DEVIATION. KDINVKAT 8                   *        
*                                                                      *        
*  AUTHOR     :  ARCHANA BHAT                                          *        
*                                                                      *        
*  INFIL      :  W5134N                                                *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W56071D1 FB(76 0)                                                          
                                                                                
%W51322N 'IN-'                                                                  
                                                                                
NEWPAGE                                                                         
                                                                                
FILE W56071D2 PRINTER VB(125 0)                                                 
                                                                                
  W-PGMNAMN    W  6   A    VALUE 'W56071'                                       
  W-PREV-IDDC  W  2   A                                                         
  W-IDARTNR    W  9   N 0 MASK 'ZZZZZZZZ9'                                      
  W-ADARTADR   W  9   N 0 MASK 'ZZZZZZZZ9'                                      
  W-KDPRODSL   W  3   N 0 MASK 'ZZ9'                                            
  W-ADJ-DATE   W  7   N 0 MASK 'ZZZZZZ9'                                        
  W-ADJ-QTY    W  7   N 0 MASK '------9'                                        
  W-AK-QTY     W  7   N 0 MASK '------9'                                        
  W-STOCK-QTY  W  7   N 0 MASK '------9'                                        
  W-EFR-QTY    W  7   N 0 MASK '------9'                                        
  W-INVEST-BAL W  7   N 0 MASK '------9'                                        
  W-BEART      W 25   A                                                         
  W-SEM        W  1   A   VALUE ';'                                             
                                                                                
*    -- CHECKED BY WY2000                                                       
SORT W56071D1 TO W56071D1 USING (IN-IDDC, IN-IDARTNR)                           
JOB INPUT W56071D1                                                              
                                                                                
  W-IDARTNR    = IN-IDARTNR                                                     
  W-ADARTADR   = IN-ADARTADR                                                    
  W-KDPRODSL   = IN-KDPSLLOC                                                    
  W-ADJ-DATE   = IN-TIJUSTDA                                                    
  W-ADJ-QTY    = IN-KVJUSTKV                                                    
  W-AK-QTY     = IN-KVAKS                                                       
  W-STOCK-QTY  = IN-KVLS                                                        
  W-EFR-QTY    = IN-KVEFRS                                                      
  W-INVEST-BAL = IN-KVUTRS                                                      
  W-BEART      = IN-BEART                                                       
  PRINT RAPPORT01                                                               
                                                                                
************************************************************************        
*** LIST FOR NDC-NA - SENT TO D&P                                               
************************************************************************        
REPORT   RAPPORT01            +                                                 
         PRINTER W56071D2     +                                                 
         LINESIZE 120         +                                                 
         SPACE 0              +                                                 
         NOHEADING            +                                                 
         NOSPREAD             +                                                 
         NOADJUST             +                                                 
         PAGESIZE 32767       +                                                 
         NODATE                                                                 
LINE  1  W-IDARTNR            +                                                 
         W-SEM                +                                                 
         W-ADARTADR           +                                                 
         W-SEM                +                                                 
         W-ADJ-DATE           +                                                 
         W-SEM                +                                                 
         W-ADJ-QTY            +                                                 
         W-SEM                +                                                 
         W-AK-QTY             +                                                 
         W-SEM                +                                                 
         W-STOCK-QTY          +                                                 
         W-SEM                +                                                 
         W-EFR-QTY            +                                                 
         W-SEM                +                                                 
         W-INVEST-BAL         +                                                 
         W-SEM                +                                                 
         W-KDPRODSL           +                                                 
         W-SEM                +                                                 
         W-BEART              +                                                 
         W-SEM                                                                  
*                                                                               
BEFORE-LINE. PROC                                                               
 IF IN-IDDC NE W-PREV-IDDC                                                      
   DISPLAY '¤DAPPARTS-DEV'                                                      
   DISPLAY '¤DAP' IN-IDDC                                                       
   DISPLAY 'PARTNO;PART ADDRESS;ADJ.DATE;ADJ.QTY;AK QTY;STOCK QTY;' +           
           'EFR QTY;INVEST.BALANCE;LPC;DESCRIPTION;'                            
   W-PREV-IDDC = IN-IDDC                                                        
 END-IF                                                                         
END-PROC                                                                        
