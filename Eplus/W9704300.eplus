                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W9704300                                              *        
*                                                                      *        
*  FUNKTION   :  CREATE SOP LOG REPORT OF "MANUAL SCHEDULE WORK"       *        
*                                                                      *        
*  FÖRFATTARE :  ANDRE KJELL                                           *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W97043D1                                                                   
*                                                                               
 DATEANDTIME 1  16 A                                                            
 TASKID     21   8 A                                                            
 JUSERID    30   8 A                                                            
 JUSERID3   30   3 A                                                            
 JUSERID4   30   4 A                                                            
 SOPMSG     39  60 A                                                            
 SOPMSGX    39  53 A                                                            
 SOPMSG7    39   7 A                                                            
 SOPMSG4    39   4 A                                                            
 SOPMSG3    39   3 A                                                            
 SOPMSG50-19 50  19 A                                                           
 SOPMSG58-10 58  10 A                                                           
                                                                                
NEWPAGE                                                                         
FILE W97043D2  PRINTER VB (90 0)                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
JOB INPUT (W97043D1)                                                            
                                                                                
* -- Use task/job number instead, if user id is missing                         
* -- (due to problems with finding an id)                                       
  IF JUSERID = '        '                                                       
    JUSERID = TASKID                                                            
  END-IF                                                                        
                                                                                
* -- Select only "Manually scheduled" events:                                   
* --   If not QASE sop id (V0SOPC1)                                             
* --   or QASE ims (IMG1xxxx, IMG2xxxx, IMPRMPP)                                
* --   or VCOM- (W0VCOM1) or Filemon-triggered (VXFRDLT) job                    
* --   or MQ (W0MQT01) job                                                      
* -- Also skip WPMC routine (always manual)                                     
* --      (jobs starting with WPMCxxx, WLIBxxx or FIMxxxx)                      
* -- Also skip symbol substitution messages (irrelevant)                        
* --   and process-not-found messages (misspelled query)                        
  IF  JUSERID  NE 'W0SOPC1'                           +                         
  AND JUSERID  NE 'IMPRMPP'                           +                         
  AND JUSERID4 NE 'IMG1'                              +                         
  AND JUSERID4 NE 'IMG2'                              +                         
  AND JUSERID  NE 'W0VCOM1', 'VXFRDLT'                +                         
  AND JUSERID  NE 'W0MQT01'                           +                         
  AND SOPMSG4  NE 'WPMC', 'WLIB' AND SOPMSG3 NE 'FIM' +                         
  AND SOPMSG7  NE 'SYMBOL '                           +                         
  AND SOPMSG58-10 NE 'NOT FOUND.'                                               
                                                                                
    PRINT W97043-001                                                            
  ELSE                                                                          
* -- Also report temp-jcl submitted jobs for "automatic" events                 
    IF  SOPMSG50-19 = 'SUBMITTED FROM TEMP'                                     
      PRINT W97043-001                                                          
    END-IF                                                                      
  END-IF                                                                        
                                                                                
NEWPAGE                                                                         
REPORT W97043-001 PRINTER W97043D2 +                                            
  LINESIZE 85 PAGESIZE 67 NOSPREAD +                                            
  SUMCTL NONE                                                                   
SEQUENCE DATEANDTIME JUSERID                                                    
CONTROL JUSERID                                                                 
                                                                                
TITLE 1  'VCC Customer Services - SOP Manual Scheduling Report'                 
HEADING  DATEANDTIME ('Access', 'Date & Time')                                  
HEADING  JUSERID  ('Requesting', 'Id or Task')                                  
HEADING  SOPMSGX   ('SOP message')                                              
LINE  1  DATEANDTIME JUSERID SOPMSGX                                            
