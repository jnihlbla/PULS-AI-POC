                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W1161900                                              *        
*                                                                      *        
*  FUNKTION   :  UPPDATERA FIL W11612 MED DATA FRÅN FIL W11610.        *        
*                                                                      *        
*  FÖRFATTARE :  ANDERSSON BERT                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W11610 PARTSINFO VIA VIPS TILL USA  *                                        
* -------------------------------------*                                        
FILE W11619D1                                                                   
*                                                                               
%W11610A '610-'                                                                 
                                                                                
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W11612 PARTSINFO VIA VIPS TILL CAN  *                                        
* -------------------------------------*                                        
FILE W11619D2                                                                   
*                                                                               
%W11610A '612-'                                                                 
                                                                                
NEWPAGE                                                                         
*--------------------------------------*                                        
*  UTFIL  KOMPLETTERAD PARTSINFO       *                                        
* -------------------------------------*                                        
FILE W11619D3 FB (311 0)                                                        
%W11610A   'UT-'                                                                
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  ARBETSFÄLT                          *                                        
* -------------------------------------*                                        
*                                                                               
 W-SPACE                  W  1 A   VALUE ' '                                    
*                                                                               
*                                                                               
NEWPAGE                                                                         
*                                                                               
*------------------------------------------------------------------*            
* STEG 1. MATCHAR W11610 MED W11612 OCH SKRIVER W11612(+1)         *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT (W11619D1 KEY(610-IDARTNR) W11619D2 KEY(612-IDARTNR))     +           
                                    START  A-INIT                               
                                                                                
    IF MATCHED                                                                  
       UT-W11610A     = 612-W11610A                                             
                                                                                
       UT-KDSTANAUTG  = 610-KDSTANAUTG                                          
       UT-FLOVRLAG    = 610-FLOVRLAG                                            
                                                                                
       PUT W11619D3                                                             
    ELSE                                                                        
      IF W11619D2                                                               
                                                                                
         UT-W11610A    = 612-W11610A                                            
                                                                                
         PUT W11619D3                                                           
      END-IF                                                                    
    END-IF                                                                      
*                                                                               
*                                                                               
NEWPAGE                                                                         
*                                                                               
 A-INIT.  PROC                                                                  
                                                                                
                                                                                
 END-PROC                                                                       
*                                                                               
