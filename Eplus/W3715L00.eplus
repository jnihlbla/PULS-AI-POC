                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W3715L00                                              *        
*                                                                      *        
*  FUNCTION   :  REPORT ORDER LIST                                     *        
*                MAIL TITLE:  W3715L-091 ORDERLIST                     *        
*                INPUT FILE W47993                                     *        
*                OUTPUT REPORT W3715L                                  *        
*  AUTHOR     :  SARASWATHY                                            *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W3715LD1                                                                   
*                                                                               
%W47993  'IN-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE W3715LD2 PRINTER VB (205 0)                                                
                                                                                
W-IDARTNR            W 9 N MASK 'ZZZZZZZZ9'                                     
W-TIORDREG           W 6 N MASK '999999'                                        
W-IDDISTR            W 4 N MASK 'ZZZ9'                                          
W-IDKUNDNR           W 6 N MASK 'ZZZZZ9'                                        
W-IDPRODNR           W 7 N MASK 'ZZZZZZ9'                                       
W-KVBEART-Q          W 6 N MASK 'ZZZZZ9'                                        
W-KVEFRS-OPACK       W 7 N MASK 'ZZZZZZ9'                                       
*                                                                               
*WORKING STORAGE                                                                
*                                                                               
W-SEM1               W   1  A   VALUE ';'                                       
W-SEM2               W   1  A   VALUE ';'                                       
W-SEM3               W   1  A   VALUE ';'                                       
W-SEM4               W   1  A   VALUE ';'                                       
W-SEM5               W   1  A   VALUE ';'                                       
W-SEM6               W   1  A   VALUE ';'                                       
W-SEM7               W   1  A   VALUE ';'                                       
*                                                                               
NEWPAGE                                                                         
%WDATKORT                                                                       
%WWDC99                                                                         
                                                                                
NEWPAGE                                                                         
W-PGMNAMN   W  6  A  VALUE 'W3715L'                                             
W-WDATUM    W  6  A  VALUE 'WDATUM'                                             
W-DATUM                W  6   N                                                 
W-AAR     W-DATUM         2   N                                                 
W-MM      W-DATUM    +2   2   N                                                 
W-DD      W-DATUM    +4   2   N                                                 
JA          W   1  A   VALUE 'J'                                                
NEJ         W   1  A   VALUE 'N'                                                
SW-FIRST    S   1  A   VALUE 'J'                                                
*                                                                               
*-------------------------------------                                          
* STEP 1. READ W3715LD1 W47993                                                  
*-------------------------------------                                          
JOB INPUT W3715LD1 START INIT-PROC                                              
IF IN-IDDC = SDC-NL-ET                                                          
 IF IN-IDPRC = '699E'                                                           
    W-IDARTNR = IN-IDARTNR                                                      
    W-TIORDREG = IN-TIORDREG                                                    
    W-IDDISTR  = IN-IDDISTR                                                     
    W-IDKUNDNR = IN-IDKUNDNR                                                    
    W-IDPRODNR = IN-IDPRODNR                                                    
    W-KVBEART-Q = IN-KVBEART-Q                                                  
    W-KVEFRS-OPACK = IN-KVEFRS-OPACK                                            
   PRINT RPT                                                                    
 END-IF                                                                         
END-IF                                                                          
INIT-PROC. PROC                                                                 
   CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                            
                                                                                
   W-AAR = D-AAR                                                                
   W-MM  = D-MAANAD                                                             
   W-DD  = D-DAG                                                                
END-PROC                                                                        
*-------------------------------------                                          
NEWPAGE                                                                         
*-------------------------------------                                          
  REPORT    RPT              +                                                  
            PRINTER W3715LD2 +                                                  
            PAGESIZE 30000   +                                                  
            LINESIZE 199     +                                                  
            SPACE 0          +                                                  
            NODATE           +                                                  
            NOPAGE           +                                                  
            NOADJUST         +                                                  
            NOHEADING        +                                                  
            TITLESKIP 1      +                                                  
            NOSPREAD                                                            
*                                                                               
LINE     W-IDARTNR        +                                                     
         W-SEM1           +                                                     
         W-TIORDREG       +                                                     
         W-SEM1           +                                                     
         W-IDDISTR        +                                                     
         W-SEM1           +                                                     
         W-IDKUNDNR       +                                                     
         W-SEM1           +                                                     
         W-IDPRODNR       +                                                     
         W-SEM1           +                                                     
         W-KVBEART-Q      +                                                     
         W-SEM1           +                                                     
         W-KVEFRS-OPACK   +                                                     
         W-SEM1                                                                 
*                                                                               
BEFORE-LINE. PROC                                                               
 IF SW-FIRST = JA                                                               
    DISPLAY '¤DAPW3715L-091'                                                    
    DISPLAY '¤DAPW3715L'                                                        
    DISPLAY 'VOLVO CAR PARTS  W3715L-091  ORDER LIST     DATE:' W-DATUM         
    DISPLAY '   PARTNR; REGTIME; DIST; CUST; PRODNR; UNPRINT Q; +               
                PRINT Q;'                                                       
    SW-FIRST = NEJ                                                              
  END-IF                                                                        
END-PROC                                                                        
*                                                                               
