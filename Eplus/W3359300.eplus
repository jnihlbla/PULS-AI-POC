                                                                                
*----------------------------------------------------------------------*        
*  PROGRAM    :  W3359300                                              *        
*                                                                      *        
*  FUNKTION   :  1. W33585-FIL(ARTRAD-FIL) OCH W33592(VALUTAFIL)       *        
*                   OCH BERÄKNAR BESTÄLNNINGSPRIS TILL TPFIL3          *        
*                2. MATCHAR W01160-FIL OCH TPFIL3 OCH RÄKNAR UT        *        
*                   SJÄLVKOST TILL UTFIL W33593.                       *        
*                                                                      *        
*  FÖRFATTARE :  ELEONOR ÖSTRÖM                                        *        
*                                                                      *        
*  DATUM      :  JAN 03                                                *        
*                                                                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
*----------------------------------------------*                                
*  W33585 FÄRSKASTE PRISRAD PER ART & IDLEVNR  *                                
*         (FLERA SAMMA ART MED OLIKA IDLEVNR)  *                                
*         (FRÅN W33585 SOM SORTERAT W01161-FIL *                                
*          PÅ DATUM.)                          *                                
* ---------------------------------------------*                                
FILE W33593D1                                                                   
%W33585   'ART-'                                                                
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W33192-FIL VALUTAKURSINFO           *                                        
* -------------------------------------*                                        
FILE W33593D2                                                                   
%W33592   '9304-'                                                               
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  W01160-FIL ARTIKELFIL               *                                        
* -------------------------------------*                                        
FILE W33593D3                                                                   
%W01160   'I4-'                                                                 
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  UTFIL TOTALFIL                      *                                        
* -------------------------------------*                                        
FILE W33593D4 FB (167 0)                                                        
%W33593    'UT-'                                                                
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  TEMPFILER                           *                                        
* -------------------------------------*                                        
*                                                                               
FILE TPFIL1  FB (47 0)                                                          
%W33585    'T1-'                                                                
*                                                                               
FILE TPFIL2  FB (15 0)                                                          
%W33592    'T2-'                                                                
*                                                                               
FILE TPFIL3 FB (53 0)                                                           
T3-IDARTNR          1  5 P 0                                                    
T3-IDLEVNR-PR       6  5 A                                                      
T3-DAPRLIST-9KOMPL 11  8 N                                                      
T3-PRARTBEL-PR     19  7 P 5                                                    
T3-FLHUVLEV        26  1 A                                                      
T3-KDVALISO        27  3 A                                                      
T3-RETULF          30  4 P 4                                                    
T3-PRKURS          34  6 P 5                                                    
T3-REVALUTA        40  4 P 0                                                    
T3-PRARTBES        44  5 P 2                                                    
T3-IDLEVNR-MOTSV   49  5 A                                                      
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  PARAMETRAR TILL WDATKONV            *                                        
* -------------------------------------*                                        
%WDATAREA                                                                       
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  ARBETSFÄLT                          *                                        
* -------------------------------------*                                        
*                                                                               
IX           W  2 N                                                             
W-PRARTBES   W  7 P 5                                                           
                                                                                
NEWPAGE                                                                         
*------------------------------------------------------------------*            
* STEG 1. SORTERAR W33593D1 ART/LEVFIL PÅ KDVALISO                 *            
* -----------------------------------------------------------------*            
                                                                                
SORT W33593D1 TO TPFIL1   USING (ART-KDVALISO) SIZE 200000                      
                                                                                
*------------------------------------------------------------------*            
* STEG 2. SORTERAR W33593D2 VALUTAFIL  PÅ KDVALISO                 *            
* -----------------------------------------------------------------*            
                                                                                
SORT W33593D2 TO TPFIL2 USING (9304-KDVALISO) SIZE 1000                         
                                                                                
*------------------------------------------------------------------*            
* STEG 3. MATCHAR TEMPFIL2 OCH TEMPFIL1 PÅ KDVALISO                *            
* -----------------------------------------------------------------*            
JOB INPUT(TPFIL2 KEY (T2-KDVALISO)                                  +           
          TPFIL1 KEY (T1-KDVALISO))                                             
                                                                                
IF MATCHED                                                                      
   T3-IDARTNR         = T1-IDARTNR                                              
   T3-IDLEVNR-PR      = T1-IDLEVNR-PR                                           
   T3-DAPRLIST-9KOMPL = T1-DAPRLIST-9KOMPL                                      
   T3-PRARTBEL-PR     = T1-PRARTBEL-PR                                          
   T3-FLHUVLEV        = T1-FLHUVLEV                                             
   T3-KDVALISO        = T1-KDVALISO                                             
   T3-RETULF          = T1-RETULF                                               
   T3-PRKURS          = T2-PRKURS                                               
   T3-REVALUTA        = T2-REVALUTA                                             
   T3-IDLEVNR-MOTSV   = T1-IDLEVNR-MOTSV                                        
                                                                                
  IF T1-FLHUVLEV = 'J'                                                          
    W-PRARTBES ROUNDED = T1-PRARTBEL-PR * T1-RETULF * T2-PRKURS                 
                                                                                
  ELSE                                                                          
    W-PRARTBES ROUNDED = T1-PRARTBEL-PR * T2-PRKURS                             
  END-IF                                                                        
                                                                                
  T3-PRARTBES ROUNDED = W-PRARTBES                                              
  IF T3-PRARTBES = 0                                                            
    IF W-PRARTBES > 0                                                           
      T3-PRARTBES = 0.01                                                        
    END-IF                                                                      
  END-IF                                                                        
                                                                                
  PUT TPFIL3                                                                    
END-IF                                                                          
*                                                                               
NEWPAGE                                                                         
                                                                                
*------------------------------------------------------------------*            
*STEG 4. SORTERAR TPFIL3 PÅ ART-NR OCH DATUM                       *            
*------------------------------------------------------------------*            
                                                                                
SORT TPFIL3 TO TPFIL3 USING (T3-IDARTNR, T3-DAPRLIST-9KOMPL D)     +            
                                        SIZE 200000                             
*------------------------------------------------------------------*            
*STEG 5. MATCHAR IHOP ART-FIL(W01160) T4 MED RADFIL(W01161) T3     *            
*------------------------------------------------------------------*            
                                                                                
JOB INPUT(W33593D3 KEY (I4-CLAG-IDARTNR)                          +             
            TPFIL3 KEY (T3-IDARTNR)) START A-INIT                               
                                                                                
 IF MATCHED                                                                     
    IF FIRST-DUP TPFIL3 OR NOT DUPLICATE TPFIL3                                 
      PERFORM FYLL-I-HUVUD-OCH-NOLLA-RADER                                      
      IF NOT DUPLICATE TPFIL3                                                   
        UT-KVAL = IX                                                            
        IF I4-CLAG-KDERS-UTG = 0                                                
          PUT W33593D4                                                          
        END-IF                                                                  
      END-IF                                                                    
    ELSE                                                                        
      PERFORM FYLL-I-RADER                                                      
      IF LAST-DUP TPFIL3                                                        
        UT-KVAL = IX                                                            
        IF I4-CLAG-KDERS-UTG = 0                                                
          PUT W33593D4                                                          
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
 ELSE                                                                           
   IF W33593D3                                                                  
     PERFORM FYLL-I-HUVUD-OMATCHAD-OCH-NOLLA-RADER                              
        UT-KVAL = 0                                                             
        IF I4-CLAG-KDERS-UTG = 0                                                
          PUT W33593D4                                                          
        END-IF                                                                  
   ELSE                                                                         
 ***  FEL! FINNS RAD MEN INGET HUVUD                                            
 ***  DISPLAY T3-IDARTNR                                                        
   END-IF                                                                       
 END-IF                                                                         
                                                                                
A-INIT. PROC                                                                    
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
 FYLL-I-RADER. PROC                                                             
  IX = IX + 1                                                                   
  UT-IDLEVNR     (IX)   = T3-IDLEVNR-PR                                         
  UT-IDLEVNR-MOTSV (IX) = T3-IDLEVNR-MOTSV                                      
  UT-PRARTBES-PR (IX)   = T3-PRARTBES                                           
 END-PROC                                                                       
NEWPAGE                                                                         
                                                                                
 FYLL-I-HUVUD-OCH-NOLLA-RADER. PROC                                             
  UT-IDARTNR       = I4-CLAG-IDARTNR                                            
  UT-IDLEVNR-HUV   = I4-CLAG-IDLEVNR                                            
  UT-PRHANTK = I4-CLAG-PRDIRLON + I4-CLAG-PRDMTRL + I4-CLAG-PROVRPAL            
  IF I4-CLAG-IDLEVNR = 'AFGE9'  'AFKGY'                                         
    UT-PRARTSJK      = I4-CLAG-PRARTSJK                                         
  ELSE                                                                          
    UT-PRARTSJK        = T3-PRARTBES + UT-PRHANTK                               
  END-IF                                                                        
  UT-PRARTBES          = T3-PRARTBES                                            
  UT-IDLEVNR     (1)   = T3-IDLEVNR-PR                                          
  UT-IDLEVNR-MOTSV (1)   = T3-IDLEVNR-MOTSV                                     
  UT-PRARTBES-PR (1)   = T3-PRARTBES                                            
  UT-PRARTSTD      = I4-CLAG-PRARTSTD                                           
  UT-KDPRODSL      = I4-CLAG-KDPRODSL                                           
                                                                                
  IX = 2                                                                        
                                                                                
  DO WHILE IX < 10                                                              
    UT-IDLEVNR       (IX) = '     '                                             
    UT-IDLEVNR-MOTSV (IX) = '     '                                             
    UT-PRARTBES-PR (IX)   = +0                                                  
    IX = IX + 1                                                                 
  END-DO                                                                        
                                                                                
  IX = 1                                                                        
                                                                                
 END-PROC                                                                       
 FYLL-I-HUVUD-OMATCHAD-OCH-NOLLA-RADER. PROC                                    
  UT-IDARTNR       = I4-CLAG-IDARTNR                                            
  UT-IDLEVNR-HUV   = I4-CLAG-IDLEVNR                                            
  UT-PRHANTK = I4-CLAG-PRDIRLON + I4-CLAG-PRDMTRL + I4-CLAG-PROVRPAL            
  UT-PRARTSJK      = I4-CLAG-PRARTSJK                                           
  UT-PRARTBES      = I4-CLAG-PRARTSTD                                           
  UT-PRARTSTD      = I4-CLAG-PRARTSTD                                           
  UT-KDPRODSL      = I4-CLAG-KDPRODSL                                           
                                                                                
  IX = 1                                                                        
                                                                                
  DO WHILE IX < 10                                                              
    UT-IDLEVNR       (IX) = '     '                                             
    UT-IDLEVNR-MOTSV (IX) = '     '                                             
    UT-PRARTBES-PR   (IX) = +0                                                  
    IX = IX + 1                                                                 
  END-DO                                                                        
                                                                                
 END-PROC                                                                       
                                                                                
