                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2613700                                              *        
*                                                                      *        
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2613700                                              *        
*                                                                      *        
*  FUNKTION   :  FRÅN INFIL W26140, INNEHÅLLANDE LISTPOSTER            *        
*                SORTERAS + SKAPAS LISTA :                             *        
*                W26137-001 ARTIKLAR MED LAGER - ERS.MÄRKT ELLER       *        
*                PROGNOS = 0     ENDAST KARANTÄNARTIKLAR               *        
*                                                                      *        
*  FÖRFATTARE :  ANNELI WAHLSTRÖM                                      *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     SDC...      PAH...............       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W26137D1                                                                   
*------------------*                                                            
* COPYTEXT         *                                                            
*------------------*                                                            
%W2613601  'IN-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W26137D2  PRINTER FB (121 0)                                               
                                                                                
*------------------*                                                            
* ARBETSAREOR      *                                                            
*------------------*                                                            
W-IDANSK          W                 3 N                     +                   
                             HEADING (' ' 'ANSK')                               
W-IDLEVNR         W                 5 A                      +                  
                             HEADING (' ' 'LEVNR')                              
W-IDARTNR         W                 9 N   MASK 'ZZZZZZZZ9'   +                  
                             HEADING (' ' 'ARTIKELNR')                          
W-KVDISP          W                 7 N   MASK 'ZZZZZZ9'     +                  
                             HEADING (' ' ' DISP-OKS')                          
W-KVAKS           W                 7 N   MASK 'ZZZZZZ9'     +                  
                             HEADING (' ' '     AK')                            
W-KVBR            W                 7 N   MASK 'ZZZZZZ9'     +                  
                             HEADING (' ' '     BR')                            
W-SUTPO-TOT       W                 7 N   MASK 'ZZZZZZ9'     +                  
                             HEADING (' ' '    TPO')                            
W-KVPB-TOT        W                 7 N 1 MASK 'ZZZZZ9.9'    +                  
                             HEADING (' ' '     TOT PB')                        
W-VARDE           W                10 N 2 MASK 'ZZZZZZZ9.99' +                  
                             HEADING ('    VÄRDE  ' '  DISP + AK')              
W-KVBUFF          W                 7 N   MASK 'ZZZZZZ9'     +                  
                             HEADING ('KARAN' 'TÄN  ')                          
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
* STEG 1. LÄSER INFIL                                                           
*                                                                               
JOB INPUT (W26137D1 +                                                           
          )                                                                     
                                                                                
  W-IDANSK    = IN-IDANSK                                                       
  W-IDLEVNR   = IN-IDLEVNR                                                      
  W-IDARTNR   = IN-IDARTNR                                                      
  W-KVBR      = IN-KVBR                                                         
  W-KVBUFF    = IN-KVBUFF                                                       
  W-SUTPO-TOT = IN-SUTPO-TOT (1)                                                
  W-KVAKS     = IN-KVAKS (1)                                                    
  PERFORM RAKNA-TOTALER                                                         
  IF W-KVDISP > 0                                                               
     PRINT W26137-001                                                           
  END-IF                                                                        
                                                                                
*------------------*                                                            
*  TOTALER         *                                                            
*------------------*                                                            
RAKNA-TOTALER. PROC.                                                            
W-KVDISP        = IN-KVLS       (1) -                           +               
                 (IN-KVRESS     (1) +                           +               
                  IN-KVOKS-BULK (1) +                           +               
                  IN-KVOKS-DAG  (1) +                           +               
                  IN-KVOKS-VOR  (1) )                                           
W-KVPB-TOT      = IN-KVPB-SEP   (1) +                           +               
                  IN-KVPB-SATS  (1)                                             
W-VARDE ROUNDED = (W-KVDISP         +                           +               
                   IN-KVAKS    (1)) *                           +               
                   IN-PRARTSTD                                                  
END-PROC                                                                        
NEWPAGE                                                                         
*------------------*                                                            
*  REPORT          *                                                            
*------------------*                                                            
NEWPAGE                                                                         
REPORT W26137-001  PRINTER W26137D2 NOADJUST NOSPREAD   +                       
                   LINESIZE 120 NODATE DTLCTL FIRST                             
SEQUENCE W-IDANSK                              +                                
         W-IDLEVNR                             +                                
         W-IDARTNR                                                              
CONTROL  FINAL NOPRINT                         +                                
         W-IDANSK   NEWPAGE NOPRINT            +                                
         W-IDLEVNR  NOPRINT                    +                                
         W-IDARTNR  NOPRINT                                                     
TITLE 1  COL 2   'VOLVO CAR CS    '                              +              
         COL 20  'W26137-001'                                    +              
         COL 32  'ART MED LAGER MEN MED PB= 0 EL EK > 0 (EJ X9)' +              
         COL 81  'ANSK'                                          +              
         COL 86  W-IDANSK                                        +              
         COL 93  'DATUM' -2 SYSDATE                                             
TITLE 2  COL 32  'ARTIKLAR MED KARANTÄN'                                        
                                                                                
HEADING  IN-BEART-SVE  (' ' 'BENÄMNING               ')                         
HEADING  IN-KDERS      (' ' '    EK')                                           
LINE  1  W-IDANSK        -2            +                                        
         W-IDLEVNR       -2            +                                        
         W-IDARTNR       -2            +                                        
         IN-BEART-SVE    -4            +                                        
         W-KVBUFF        -2            +                                        
         W-KVDISP        -3            +                                        
         W-KVAKS         -3            +                                        
         W-KVBR          -3            +                                        
         IN-KDERS        -4            +                                        
         W-KVPB-TOT      -2            +                                        
         W-VARDE                                                                
