                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W512                                                  *        
*                                                                      *        
*  FUNKTION   :  SKAPAR FIL MED KURSER FÖR VARULAGERVÄRDERINGEN.       *        
*                                                                      *        
*  FÖRFATTARE :  ROYNA LUND        DATUM : APRIL-93                    *        
*                                                                      *        
*  INFILER    :  W512.W500R1.W51237(+0)   KURSER FRÅN TIDIGARE         *        
*                                         PERIODER                     *        
*                WIN.KURSPV.A11079        KURSER FÖR AKTUELL PERIOD    *        
*                                         FRÅN VOLVO DATA              *        
*                                                                      *        
*  UTFILER    :  W512.W500R1.W51237(+1)   KURSER FÖR AKTUELL OCH       *        
*                                         TIDIGARE PERIODER            *        
*----------------------------------------------------------------------*        
*----------------------------------*                                            
* KURSER FÖR TIDIGARE PERIODER     *                                            
*----------------------------------*                                            
                                                                                
FILE W51236D1                                                                   
                                                                                
%W51237   'REGIN-'                                                              
                                                                                
NEWPAGE                                                                         
*----------------------------------*                                            
* DAGSKURSER FÖR AKTUELL PERIOD    *                                            
*----------------------------------*                                            
                                                                                
FILE W51236D2                                                                   
                                                                                
  NYA-DAGSKURSER                   1    42    A                                 
    NYA-DATUM-FOM                  1     6    N                                 
    NYA-KDVALISO                   7     3    A                                 
    NYA-OMRÄKNINGSTAL             10     3    N                                 
    NYA-FILLERX1                  13    10    A                                 
    NYA-SÄLJKURS                  23    10    N   6                             
    NYA-FILLERX2                  33     9    A                                 
                                                                                
NEWPAGE                                                                         
*----------------------------------*                                            
* MELLANLAGRINGSFILER              *                                            
*----------------------------------*                                            
                                                                                
FILE TPFIL1  FB(33 0)                                                           
                                                                                
%W51237   'TEMP1-'                                                              
                                                                                
NEWPAGE                                                                         
FILE TPFIL2  FB(33 0)                                                           
                                                                                
%W51237   'TEMP2-'                                                              
                                                                                
NEWPAGE                                                                         
*----------------------------------------*                                      
* KURSER FÖR TIDIGARE OCH AKTUELL PERIOD *                                      
*----------------------------------------*                                      
                                                                                
FILE W51236D3  FB(33 0)                                                         
%W51237   'REGUT-'                                                              
                                                                                
NEWPAGE                                                                         
                                                                                
*-----------------------*                                                       
* COPYTEXT FÖR WDATKONV *                                                       
*-----------------------*                                                       
                                                                                
%WDATAREA                                                                       
NEWPAGE                                                                         
                                                                                
*-------------*                                                                 
* ARBETSAREOR *                                                                 
*-------------*                                                                 
                                                                                
PROGRAM-NAMN   W   6   A   VALUE 'W51236'                                       
WS-DATUM       W   6   N                                                        
                                                                                
%WY2000W1                                                                       
                                                                                
NEWPAGE                                                                         
                                                                                
*----------------------------------------*                                      
* JOBSTEG 1 LÄSER IN TVÅ FILER PÅ TPFIL1 *                                      
*----------------------------------------*                                      
                                                                                
JOB INPUT NULL                                                                  
                                                                                
* KURSER FÖR TIDIGARE PERIODER     *                                            
                                                                                
   GET W51236D1                                                                 
   DO WHILE NOT EOF W51236D1                                                    
      MOVE REGIN-W51237 TO TEMP1-W51237                                         
      PUT TPFIL1                                                                
      GET W51236D1                                                              
   END-DO                                                                       
                                                                                
* DAGSKURSER FÖR AKTUELL PERIOD    *                                            
                                                                                
   GET W51236D2                                                                 
   DO WHILE NOT EOF W51236D2                                                    
      IF NYA-KDVALISO = 'ATS' 'AUD' 'BEF' 'CAD' 'CHF' +                         
                        'CLP' 'CSK' 'DEM' 'DKK' 'ESP' +                         
                        'FIM' 'FRF' 'GBP' 'HKD' 'HUF' +                         
                        'IEP' 'INR' 'ITL' 'JPY' 'KRW' +                         
                        'LBP' 'MYR' 'NLG' 'NOK' 'PEI' +                         
                        'PLN' 'PTE' 'SAR' 'SGD' 'SKK' +                         
                        'THB' 'TRL' 'TWD' 'USD' 'YUN' +                         
                        'EUR' 'MXN' 'CZK' 'CNY' 'AED' +                         
                        'TRY' 'BRL'                                             
       TEMP1-KDVALISO       = NYA-KDVALISO                                      
       TEMP1-FILLERX1       = ' '                                               
       TEMP1-DATUM-FOM      = NYA-DATUM-FOM + 20000000                          
       TEMP1-FILLERX2       = ' '                                               
       TEMP1-DATUM-TOM      = 20991231                                          
       TEMP1-FILLERX3       = ' '                                               
       TEMP1-PRKURS ROUNDED = NYA-SÄLJKURS / NYA-OMRÄKNINGSTAL                  
       PUT TPFIL1                                                               
     END-IF                                                                     
     GET W51236D2                                                               
   END-DO                                                                       
STOP                                                                            
NEWPAGE                                                                         
                                                                                
*----------------------------------*                                            
* SORT1                            *                                            
* SORTERAR IHOP                    *                                            
* DAGSKURSER FÖR AKTUELL PERIOD    *                                            
* KURSER FÖR TIDIGARE PERIODER     *                                            
*----------------------------------*                                            
                                                                                
SORT TPFIL1 TO TPFIL2 USING (TEMP1-KDVALISO    +                                
                             TEMP1-DATUM-FOM D )                                
                                                                                
*----------------------------------*                                            
* JOB2                             *                                            
* DAGSKURSER FÖR AKTUELL PERIOD    *                                            
* KURSER FÖR TIDIGARE PERIODER     *                                            
*----------------------------------*                                            
                                                                                
JOB INPUT(TPFIL2)   START(A-INIT)                                               
                                                                                
   IF REGUT-KDVALISO = TEMP2-KDVALISO                                           
      IF TEMP2-DATUM-TOM = 20991231                                             
                                                                                
*** ALLA TRANSAR UTOM SENASTE SKALL HÄR BYTA UT SIN DATUM-TOM                   
*** FRÅN 20991231 TILL ''DAGEN FÖRE FÖREG. TRANS-FOM''                          
*** DÄRFÖR TVÅ ANROP PÅ DATKONV MED SUBTRAKTION MED 1 EMELLAN                   
                                                                                
         MOVE 'AAMMDD'     TO DAT-KDDATFORM                                     
         DAT-I-TIDATUM      = REGUT-DATUM-FOM                                   
                                                                                
         CALL WDATKONV USING (DAT-KDDATFORM +                                   
                              DAT-I-TIDATUM +                                   
                              DAT-O-TIDATUM +                                   
                              DAT-KDSVAR)                                       
         IF DAT-KDSVAR      = ' '                                               
            WS-DATUM        = DAT-TIAADDD - 1                                   
         ELSE                                                                   
            DISPLAY 'ANROP PÅ SUBPGM WDATAREA FELAKTIGT       '                 
            DISPLAY 'DATUM I FIL MED KURSER FRÅN VD FELAKTIGT '                 
            DISPLAY 'KURSDATUM ' REGUT-DATUM-TOM                                
         END-IF                                                                 
                                                                                
         MOVE 'AADDD '     TO DAT-KDDATFORM                                     
         DAT-I-TIDATUM      = WS-DATUM                                          
                                                                                
         CALL WDATKONV USING (DAT-KDDATFORM +                                   
                              DAT-I-TIDATUM +                                   
                              DAT-O-TIDATUM +                                   
                              DAT-KDSVAR)                                       
         IF DAT-KDSVAR      = ' '                                               
            REGUT-W51237         = TEMP2-W51237                                 
            IF DAT-TIAAMMDD GT 500000                                           
              REGUT-DATUM-TOM    = 19000000 + DAT-TIAAMMDD                      
            ELSE                                                                
              REGUT-DATUM-TOM    = 20000000 + DAT-TIAAMMDD                      
            END-IF                                                              
         ELSE                                                                   
            DISPLAY 'ANROP PÅ SUBPGM WDATAREA FELAKTIGT       '                 
            DISPLAY 'DATUM I FIL MED KURSER FRÅN VD FELAKTIGT '                 
            DISPLAY 'KURSDATUM ' REGUT-DATUM-TOM                                
         END-IF                                                                 
                                                                                
      ELSE                                                                      
        REGUT-W51237             = TEMP2-W51237                                 
      END-IF                                                                    
   ELSE                                                                         
     REGUT-W51237                = TEMP2-W51237                                 
   END-IF                                                                       
   PUT W51236D3                                                                 
                                                                                
A-INIT.  PROC                                                                   
                                                                                
   REGUT-KDVALISO = 'XXX'                                                       
                                                                                
END-PROC                                                                        
