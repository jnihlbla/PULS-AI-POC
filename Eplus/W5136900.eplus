W-SUM-VAL-T            W  11  N 2  MASK '--------9.99'                          
W-SUM-VAL-D            W  11  N 2  MASK '--------9.99'                          
W-SUM-VAL-U            W  11  N 2  MASK '--------9.99'                          
W-SUM-QTY-T            W  6   N 0  MASK 'ZZZZZ9'                                
W-SUM-QTY-D            W  6   N 0  MASK 'ZZZZZ9'                                
W-SUM-QTY-U            W  6   N 0  MASK 'ZZZZZ9'                                
W-SUM-QTY-Z            W  6   N 0  MASK 'ZZZZZ9'                                
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    --- TO CHECK IF "WEB DC"                                                   
*                                                                               
%WL10WBDC                                                                       
*                                                                               
NEWPAGE                                                                         
                                                                                
SORT W51369D1 TO TEMPFIL2 USING (IN-IDARTNR)                                    
                                                                                
JOB INPUT (W51369D2 KEY (IN2-IDARTNR)  +                                        
           TEMPFIL2 KEY (TEMP-IDARTNR))                                         
                                                                                
IF MATCHED                                                                      
  TE-IDDC       = TEMP-IDDC                                                     
  TE-IDARTNR    = TEMP-IDARTNR                                                  
  TE-KVJUSTKV   = TEMP-KVJUSTKV                                                 
  TE-KDJUSTYP   = TEMP-KDJUSTYP                                                 
  TE-FLAUTLSJ   = TEMP-FLAUTLSJ                                                 
  TE-PRARTSTD   = IN2-PRARTSTD                                                  
  PUT TEMPFIL1                                                                  
END-IF                                                                          
*-------------------------------------------------------                        
SORT TEMPFIL1 TO TEMPFIL1 USING (TE-IDDC TE-KDJUSTYP)                           
*-------------------------------------------------------                        
                                                                                
*-------------------------------------------------------                        
JOB INPUT TEMPFIL1 START INIT-PROC                                              
*-------------------------------------------------------                        
                                                                                
 IF TE-KDJUSTYP NE 6 0                                                          
   VÄRDE = TE-KVJUSTKV * TE-PRARTSTD                                            
   W-JUSTYP   = TE-KDJUSTYP                                                     
                                                                                
   T6-VAL-T = TE-KVJUSTKV * TE-PRARTSTD                                         
   T6-JUSTYP = TE-KDJUSTYP                                                      
                                                                                
****  FÖR ATT FÅ MED AUTOMATJUSTERINGEN PÅ LISTAN      **                       
   W-JUSTYP-N = TE-KDJUSTYP                                                     
   IF TE-FLAUTLSJ EQ 'J'                                                        
     W-JUSTYP-A = 'A'                                                           
   ELSE                                                                         
     W-JUSTYP-A = ' '                                                           
   END-IF                                                                       
                                                                                
   IF VÄRDE < 0                                                                 
      ANTAL1 = 1                                                                
      VÄRDE1 = VÄRDE                                                            
      ANTAL2 = 0                                                                
      VÄRDE2 = 0                                                                
      ANTAL3 = 0                                                                
   ELSE                                                                         
     IF VÄRDE > 0                                                               
       VÄRDE1 = 0                                                               
       ANTAL1 = 0                                                               
       VÄRDE2 = VÄRDE                                                           
       ANTAL2 = 1                                                               
       ANTAL3 = 0                                                               
     ELSE                                                                       
       VÄRDE1 = 0                                                               
       ANTAL1 = 0                                                               
       VÄRDE2 = 0                                                               
       ANTAL2 = 0                                                               
       ANTAL3 = 1                                                               
     END-IF                                                                     
   END-IF                                                                       
                                                                                
   ANTAL = 1                                                                    
                                                                                
   IF T6-VAL-T < 0                                                              
      T6-QTY-D = 1                                                              
      T6-VAL-D = T6-VAL-T                                                       
      T6-QTY-U = 0                                                              
      T6-VAL-U = 0                                                              
      T6-QTY-Z = 0                                                              
   ELSE                                                                         
     IF VÄRDE > 0                                                               
       T6-QTY-D = 0                                                             
       T6-VAL-D = 0                                                             
       T6-QTY-U = 1                                                             
       T6-VAL-U = T6-VAL-T                                                      
       T6-QTY-Z = 0                                                             
     ELSE                                                                       
       T6-QTY-D = 0                                                             
       T6-VAL-D = 0                                                             
       T6-QTY-U = 0                                                             
       T6-VAL-U = 0                                                             
       T6-QTY-Z = 1                                                             
     END-IF                                                                     
   END-IF                                                                       
                                                                                
   T6-QTY-T = 1                                                                 
                                                                                
   IF TE-KDJUSTYP NE 6                                                          
       W-IDDC       = TE-IDDC                                                   
       IF TE-IDDC = SDC-NL-ET                                                   
         PRINT RAPPORT02-91                                                     
       ELSE-IF TE-IDDC = SDC-NL                                                 
         PRINT RAPPORT02                                                        
       ELSE-IF TE-IDDC = SDC-ES                                                 
         PRINT RAPPORT04                                                        
       ELSE-IF TE-IDDC = SDC-IT                                                 
         PRINT RAPPORT05                                                        
       ELSE-IF TE-IDDC = SDC-AT                                                 
         PRINT RAPPORT06                                                        
       ELSE-IF TE-IDDC = NDC-JP-61                                              
         PRINT RAPPORT07                                                        
       ELSE-IF TE-IDDC = NDC-AU                                                 
         PRINT RAPPORT08                                                        
       ELSE-IF TE-IDDC = LDC-GB-3A                                              
         PRINT RAPPORT12                                                        
       END-IF                                                                   
                                                                                
       PERFORM S23-CHECK-TE-IDDC                                                
       IF TE-IDDC = NDC-US                                                      
          PERFORM X-CHECK-IF-WEBDC                                              
          IF WBDC-FLWEBDC = 'N'                                                 
             T6-IDDC = TE-IDDC                                                  
             PUT TEMPFIL6                                                       
          END-IF                                                                
       END-IF                                                                   
                                                                                
       PRINT RAPPORT01                                                          
                                                                                
       PERFORM SKAPA-UTFIL-WEB                                                  
   END-IF                                                                       
 END-IF                                                                         
                                                                                
*    --- S23-CHECK-TE-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'TE-'                                                                   
*                                                                               
NEWPAGE                                                                         
X-CHECK-IF-WEBDC. PROC                                                          
   WBDC-IDDC = TE-IDDC                                                          
   CALL WL10WBDC USING WBDC-AREA                                                
END-PROC                                                                        
NEWPAGE                                                                         
INIT-PROC. PROC                                                                 
   CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                            
                                                                                
   W-AAR = D-AAR                                                                
   W-MM  = D-MAANAD                                                             
   W-DD  = D-DAG                                                                
                                                                                
   DAT-KDDATFORM = 'AAMMDD'                                                     
   DAT-I-TIDATUM = W-DATUM                                                      
   CALL WDATKONV USING +                                                        
         (DAT-KDDATFORM DAT-I-TIDATUM DAT-O-TIDATUM DAT-KDSVAR)                 
   W-TIRP = DAT-TIRP                                                            
   T6-TIRP = DAT-TIRP                                                           
END-PROC                                                                        
SKAPA-UTFIL-WEB. PROC                                                           
  TP4-IDAFPRCD      = '1'                                                       
  TP4-IDDC          = TE-IDDC                                                   
  TP4-TIRP          = W-TIRP                                                    
  TP4-KDJUSTYP      = W-JUSTYP                                                  
  TP4-KVJUSTKV-TOT  = ANTAL                                                     
  TP4-KVJUSTKV-NEG  = ANTAL1                                                    
  TP4-KVJUSTKV-POS  = ANTAL2                                                    
  TP4-KVJUSTKV-ZERO = ANTAL3                                                    
  PUT TEMPFIL4                                                                  
                                                                                
  TP5-IDAFPRCD      = '1'                                                       
  TP5-IDDC          = TE-IDDC                                                   
  TP5-TIRP          = W-TIRP                                                    
  TP5-KDJUSTYP      = W-JUSTYP                                                  
  TP5-KVJUSTKV-TOT  = ANTAL                                                     
  TP5-KVJUSTKV-NEG  = ANTAL1                                                    
  TP5-KVJUSTKV-POS  = ANTAL2                                                    
  TP5-KVJUSTKV-ZERO = ANTAL3                                                    
  IF VÄRDE < 0                                                                  
* DISPLAY ' MINUS DC ' TE-IDDC ' JUSTTYP ' W-JUSTYP +                           
*    ' PRIS ' TE-PRARTSTD  ' ANTAL ' TE-KVJUSTKV                                
    TP5-SUARTSTD-TOT  = (TE-KVJUSTKV * TE-PRARTSTD) * - 1                       
    TP5-SUARTSTD-NEG  = (TE-KVJUSTKV * TE-PRARTSTD) * - 1                       
    TP5-SUARTSTD-POS  = 0                                                       
*   DISPLAY 'VÄRDET ' TP5-SUARTSTD-NEG                                          
  ELSE                                                                          
    IF VÄRDE > 0                                                                
*   DISPLAY ' PLUS  DC ' TE-IDDC ' JUSTTYP ' W-JUSTYP   +                       
*    ' PRIS ' TE-PRARTSTD  ' ANTAL ' TE-KVJUSTKV                                
      TP5-SUARTSTD-TOT  =  TE-KVJUSTKV * TE-PRARTSTD                            
      TP5-SUARTSTD-POS  =  TE-KVJUSTKV * TE-PRARTSTD                            
      TP5-SUARTSTD-NEG  =  0                                                    
*     DISPLAY 'VÄRDET ' TP5-SUARTSTD-POS                                        
    ELSE                                                                        
      TP5-SUARTSTD-TOT  =  0                                                    
      TP5-SUARTSTD-POS  =  0                                                    
      TP5-SUARTSTD-NEG  =  0                                                    
    END-IF                                                                      
  END-IF                                                                        
                                                                                
                                                                                
  PUT TEMPFIL5                                                                  
END-PROC                                                                        
                                                                                
