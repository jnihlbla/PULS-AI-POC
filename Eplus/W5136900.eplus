BEFORE-LINE. PROC                                                               
 IF WS-T6-IDDC NE W-PREV-IDDC                                                   
   DISPLAY '¤DAPACCUMULATED-ADJ'                                                
   DISPLAY '¤DAP' WS-T6-IDDC                                                    
   DISPLAY 'PERIOD;ADJ.TYPE;TOTAL ADJ.QTY;TOTAL NET VALUE;' +                   
           'DOWN ADJ.QTY;DOWN ADJ VALUE;UP ADJ.QTY;UP ADJ.VALUE;' +             
           'ZERO ADJ.QTY;'                                                      
   W-PREV-IDDC = WS-T6-IDDC                                                     
 END-IF                                                                         
