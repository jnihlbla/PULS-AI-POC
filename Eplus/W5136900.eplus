***XTRA RAD FÖR SKAPANDE AV FIL TILL DAP                                        
*****************************************************                           
                                                                                
SORT TEMPFIL4 TO TEMPFIL4 USING (TP4-IDDC TP4-KDJUSTYP)                         
                                                                                
**********************************************************                      
* TAR IN TEMPFIL4 OCH SUMMERAR PÅ KDJUSTYP                 *                    
**********************************************************                      
JOB  INPUT (TEMPFIL4) START A-INIT FINISH Z-FINIT                               
IF RECORD-COUNT = 1                                                             
     UT-IDAFPRCD      =  TP4-IDAFPRCD                                           
     UT-IDDC          =  TP4-IDDC                                               
     UT-TIRP          =  TP4-TIRP                                               
     UT-KDJUSTYP      =  TP4-KDJUSTYP                                           
END-IF                                                                          
IF UT-IDDC     = TP4-IDDC AND +                                                 
   UT-KDJUSTYP = TP4-KDJUSTYP                                                   
     UT-KVJUSTKV-TOT  = UT-KVJUSTKV-TOT + TP4-KVJUSTKV-TOT                      
     UT-KVJUSTKV-NEG  = UT-KVJUSTKV-NEG + TP4-KVJUSTKV-NEG                      
     UT-KVJUSTKV-POS  = UT-KVJUSTKV-POS + TP4-KVJUSTKV-POS                      
     UT-KVJUSTKV-ZERO = UT-KVJUSTKV-ZERO + TP4-KVJUSTKV-ZERO                    
ELSE                                                                            
   PUT W51369DW                                                                 
   UT-IDAFPRCD      =  TP4-IDAFPRCD                                             
   UT-IDDC          =  TP4-IDDC                                                 
   UT-TIRP          =  TP4-TIRP                                                 
   UT-KDJUSTYP      =  TP4-KDJUSTYP                                             
   UT-KVJUSTKV-TOT  =  TP4-KVJUSTKV-TOT                                         
   UT-KVJUSTKV-NEG  =  TP4-KVJUSTKV-NEG                                         
   UT-KVJUSTKV-POS  =  TP4-KVJUSTKV-POS                                         
   UT-KVJUSTKV-ZERO =  TP4-KVJUSTKV-ZERO                                        
END-IF                                                                          
A-INIT. PROC                                                                    
     UT-KVJUSTKV-TOT  =  0                                                      
     UT-KVJUSTKV-NEG  =  0                                                      
     UT-KVJUSTKV-POS  =  0                                                      
     UT-KVJUSTKV-ZERO =  0                                                      
END-PROC                                                                        
                                                                                
Z-FINIT. PROC                                                                   
   PUT W51369DW                                                                 
END-PROC                                                                        
****************************************************                            
***XTRA RAD FÖR SKAPANDE AV FIL TILL DAP MANAGEMNET                             
*****************************************************                           
                                                                                
SORT TEMPFIL5 TO TEMPFIL5 USING (TP5-IDDC TP5-KDJUSTYP)                         
                                                                                
**********************************************************                      
* TAR IN TEMPFIL5 OCH SUMMERAR PÅ KDJUSTYP                 *                    
**********************************************************                      
JOB  INPUT (TEMPFIL5) START AA-INIT FINISH ZZ-FINIT                             
IF RECORD-COUNT = 1                                                             
     UT6-IDAFPRCD     =  TP5-IDAFPRCD                                           
     UT6-IDDC         =  TP5-IDDC                                               
     UT6-TIRP         =  TP5-TIRP                                               
     UT6-KDJUSTYP     =  TP5-KDJUSTYP                                           
END-IF                                                                          
IF UT6-IDDC    = TP5-IDDC AND +                                                 
   UT6-KDJUSTYP = TP5-KDJUSTYP                                                  
     UT6-KVJUSTKV-TOT = UT6-KVJUSTKV-TOT + TP5-KVJUSTKV-TOT                     
     UT6-KVJUSTKV-NEG = UT6-KVJUSTKV-NEG + TP5-KVJUSTKV-NEG                     
     UT6-KVJUSTKV-POS = UT6-KVJUSTKV-POS + TP5-KVJUSTKV-POS                     
     UT6-SUARTSTD-TOT = UT6-SUARTSTD-TOT + TP5-SUARTSTD-TOT                     
     UT6-SUARTSTD-NEG = UT6-SUARTSTD-NEG + TP5-SUARTSTD-NEG                     
     UT6-SUARTSTD-POS = UT6-SUARTSTD-POS + TP5-SUARTSTD-POS                     
     UT6-KVJUSTKV-ZERO = UT6-KVJUSTKV-ZERO + TP5-KVJUSTKV-ZERO                  
ELSE                                                                            
   PUT  W51369DX                                                                
   UT6-IDAFPRCD     =  TP5-IDAFPRCD                                             
   UT6-IDDC         =  TP5-IDDC                                                 
   UT6-TIRP         =  TP5-TIRP                                                 
   UT6-KDJUSTYP     =  TP5-KDJUSTYP                                             
   UT6-KVJUSTKV-TOT =  TP5-KVJUSTKV-TOT                                         
   UT6-KVJUSTKV-NEG =  TP5-KVJUSTKV-NEG                                         
   UT6-KVJUSTKV-POS =  TP5-KVJUSTKV-POS                                         
   UT6-SUARTSTD-TOT =  TP5-SUARTSTD-TOT                                         
   UT6-SUARTSTD-NEG =  TP5-SUARTSTD-NEG                                         
   UT6-SUARTSTD-POS =  TP5-SUARTSTD-POS                                         
   UT6-KVJUSTKV-ZERO = TP5-KVJUSTKV-ZERO                                        
END-IF                                                                          
AA-INIT. PROC                                                                   
     UT6-KVJUSTKV-TOT =  0                                                      
     UT6-KVJUSTKV-NEG =  0                                                      
     UT6-KVJUSTKV-POS =  0                                                      
     UT6-KVJUSTKV-ZERO = 0                                                      
     UT6-SUARTSTD-TOT =  0                                                      
     UT6-SUARTSTD-NEG =  0                                                      
     UT6-SUARTSTD-POS =  0                                                      
END-PROC                                                                        
                                                                                
ZZ-FINIT. PROC                                                                  
   PUT W51369DX                                                                 
END-PROC                                                                        
SORT TEMPFIL6 TO TEMPFIL6 USING (T6-IDDC, T6-JUSTYP)                            
JOB INPUT TEMPFIL6 FINISH Z-FINIT                                               
                                                                                
  IF T6-IDDC    = WS-T6-IDDC AND +                                              
     T6-JUSTYP  = WS-T6-JUSTYP                                                  
    WS-SUM-QTY-D   = T6-QTY-D  + WS-SUM-QTY-D                                   
    WS-SUM-QTY-U   = T6-QTY-U  + WS-SUM-QTY-U                                   
    WS-SUM-QTY-T   = T6-QTY-T  + WS-SUM-QTY-T                                   
    WS-SUM-QTY-Z   = T6-QTY-Z  + WS-SUM-QTY-Z                                   
    WS-SUM-VAL-D   = T6-VAL-D  + WS-SUM-VAL-D                                   
    WS-SUM-VAL-U   = T6-VAL-U  + WS-SUM-VAL-U                                   
    WS-SUM-VAL-T   = T6-VAL-T  + WS-SUM-VAL-T                                   
  ELSE                                                                          
    IF WS-FIRST-REC = 'N'                                                       
       W-SUM-QTY-D   = WS-SUM-QTY-D                                             
       W-SUM-QTY-U   = WS-SUM-QTY-U                                             
       W-SUM-QTY-T   = WS-SUM-QTY-T                                             
       W-SUM-QTY-Z   = WS-SUM-QTY-Z                                             
       W-SUM-VAL-D   = WS-SUM-VAL-D                                             
       W-SUM-VAL-U   = WS-SUM-VAL-U                                             
       W-SUM-VAL-T   = WS-SUM-VAL-T                                             
       W-JUSTYP-E    = WS-T6-JUSTYP                                             
       W-TIRP-E      = WS-T6-TIRP                                               
       PRINT RAPPORT13                                                          
    END-IF                                                                      
    WS-T6-IDDC     = T6-IDDC                                                    
    WS-T6-JUSTYP   = T6-JUSTYP                                                  
    WS-SUM-QTY-D   = T6-QTY-D                                                   
    WS-SUM-QTY-U   = T6-QTY-U                                                   
    WS-SUM-QTY-T   = T6-QTY-T                                                   
    WS-SUM-QTY-Z   = T6-QTY-Z                                                   
    WS-SUM-VAL-D   = T6-VAL-D                                                   
    WS-SUM-VAL-U   = T6-VAL-U                                                   
    WS-SUM-VAL-T   = T6-VAL-T                                                   
    WS-T6-TIRP     = T6-TIRP                                                    
    WS-FIRST-REC   = 'N'                                                        
  END-IF                                                                        
                                                                                
  Z-FINIT. PROC                                                                 
    IF WS-FIRST-REC = 'N'                                                       
       W-SUM-QTY-D   = WS-SUM-QTY-D                                             
       W-SUM-QTY-U   = WS-SUM-QTY-U                                             
       W-SUM-QTY-T   = WS-SUM-QTY-T                                             
       W-SUM-QTY-Z   = WS-SUM-QTY-Z                                             
       W-SUM-VAL-D   = WS-SUM-VAL-D                                             
       W-SUM-VAL-U   = WS-SUM-VAL-U                                             
       W-SUM-VAL-T   = WS-SUM-VAL-T                                             
       W-JUSTYP-E    = WS-T6-JUSTYP                                             
       W-TIRP-E      = WS-T6-TIRP                                               
       PRINT RAPPORT13                                                          
    END-IF                                                                      
  END-PROC                                                                      
