                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W91054                                                *        
*                                                                      *        
*  FUNKTION   :  KOMPLETTERAR FILEN W91052 MED IDLEVNR-DDGS FRÅN       *        
* W91056 (WDF2A-EXTRAKT)*                                                       
*                                                                      *        
*  FÖRFATTARE :  G KJELLSON                                            *        
*                                                                      *        
*  INFILER    :  W910.W91054.W91052 (ARTIKELINFO TILL VR)              *        
*             :  W910.W91056        (WDF2A-EXTRAKT)                    *        
*                                                                      *        
*  UTFILER    :  W910.W91054.W91054                                    *        
*                                                                      *        
*  ÄNDRING             DATUM    AVD                                    *        
*                                                                      *        
*                                                                      *        
*  --------------      ------   ------                                 *        
*  --------------      ------   ------                                 *        
*                                                                      *        
************************************************************************        
FILE W91052D1.               * INFIL ARTIKELINFO                                
%W91054 'IN-'                                                                   
*                                                                               
FILE W91052D2.               * WDF2A-EXTRAKT                                    
%WDF2A1                                                                         
*                                                                               
*                                                                               
FILE W91052D3 FB(227 28602). * UTFIL                                            
%W91054   'UT-'                                                                 
*                                                                               
*                                                                               
***                                                                             
*                                                                               
JOB INPUT (W91052D2 KEY (SEQA-IDARTNR) +                                        
           W91052D1 KEY (IN-IDARTNR))                                           
                                                                                
  IF MATCHED                                                                    
                                                                                
     IN-IDLEVNR-DDGS = SEQA-IDLEVNR                                             
     PUT W91052D3 FROM W91052D1                                                 
                                                                                
  ELSE                                                                          
     IF W91052D1                                                                
        PUT W91052D3 FROM W91052D1                                              
     END-IF                                                                     
  END-IF                                                                        
