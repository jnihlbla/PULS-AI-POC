                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4252500                                              *        
*                                                                      *        
*  FUNKTION   :  LÄSER FIL MED SU-TRANSAR OCH TAR BORT DUBLETTER PÅ    *        
*                686-TRANSAR (=SU7-TRANSAR)                            *        
*                DET SKAPAS FLERA SU7-TRANSAR OM DET FINNS BÅDE VANLIGA*        
*                OCH DIREKTLEVERANSRADER PÅ SAMMA ORDERNR/FAKTURA.     *        
*                VR-SYSTEMET ACCEPTERAR ENDAST EN SU7 PER DISTRIKT,    *        
*                FAKTURA OCH ORDERNR.                                  *        
*                                                                      *        
*  FÖRFATTARE :  ELAINE CURTSSON                                       *        
*                                                                      *        
*  DATUM      :  SEPTEMBER 92                                                   
*                                                                      *        
*                                                                      *        
*  HAR MED FÖLJANDE COPYTEXTER SOM KOMMENTARER FÖR ATT DETTA PROGRAMMET*        
*  SKA HITTAS OM MAN GÖR SCAN EFTER W425-COPYTEXTER. OM MAN ÄNDRAR              
*  NÅGON AV DESSA COPYTEXTER MÅSTE EV POSTLÄNGD ÄNDRAS FÖR INFILEN              
*  W42525D1.                                                                    
*                                                                               
*  W425685                                                                      
*  W425686                                                                      
*  W425687                                                                      
*  W425688                                                                      
*  W425SU1                                                                      
*  W425SU2                                                                      
*  W425SU3                                                                      
*  W425SU4                                                                      
*  W425SU5                                                                      
*  W425SUA                                                                      
*  W425SUC                                                                      
*  W425SUD                                                                      
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
*--------------------------------------*                                        
*   FIL MED SU-TRANSAR                 *                                        
* -------------------------------------*                                        
*                                                                               
FILE W42525D1                                                                   
IN-IDPTYP     1     3  A                                                        
IN-POST       1   199  A                                                        
SU1-POST      1   114  A                                                        
SU2-POST      1   114  A                                                        
SU3-POST      1   114  A                                                        
SU4-POST      1   114  A                                                        
SU5-POST      1   114  A                                                        
SUA-POST      1   114  A                                                        
SUC-POST      1   114  A                                                        
SUD-POST      1   114  A                                                        
685-POST      1    59  A                                                        
686-POST      1    58  A                                                        
687-POST      1   199  A                                                        
688-POST      1    56  A                                                        
*                                                                               
*                                                                               
*---------------------------------------*                                       
* UTFIL MED EV. BORTTAGNA 686-POSTER    *                                       
* --------------------------------------*                                       
*                                                                               
FILE W42525D2 VB (203 0)                                                        
UT-POST       1   199  A                                                        
*                                                                               
*--------------------------------------*                                        
*  TEMPFIL1                            *                                        
* -------------------------------------*                                        
FILE TEMPFIL1         FB(67 0)                                                  
%W425686R 'TEMP1-'                                                              
TEMP1-IDLOPNR  59  9 P 0                                                        
*                                                                               
*--------------------------------------*                                        
*  TEMPFILA                            *                                        
* -------------------------------------*                                        
FILE TEMPFILA         FB(67 0)                                                  
%W425686R 'TEMPA-'                                                              
TEMPA-IDLOPNR  59  9 P 0                                                        
*                                                                               
*--------------------------------------*                                        
*  TEMPFIL2                            *                                        
* -------------------------------------*                                        
FILE TEMPFIL2         FB(208 0)                                                 
TEMP2-AREA      1   199  A                                                      
TEMP2-IDPTYP    1     3  A                                                      
TEMP2-IDLOPNR 200     9  P 0                                                    
*                                                                               
*--------------------------------------*                                        
*  TEMPFIL3                            *                                        
* -------------------------------------*                                        
FILE TEMPFIL3         FB(208 0)                                                 
TEMP3-AREA      1   199  A                                                      
TEMP3-IDPTYP    1     3  A                                                      
TEMP3-IDLOPNR 200     9  P 0                                                    
*                                                                               
NEWPAGE                                                                         
*                                                                               
*--------------------------------------*                                        
*  ARBETSFÄLT                          *                                        
* -------------------------------------*                                        
*                                                                               
FOERSTA-POSTEN   W  1  A                                                        
TEMPFILA-TOM     W  1  A                                                        
JA               W  1  A   VALUE 'J'                                            
NEJ              W  1  A   VALUE 'N'                                            
WS-IDLOPNR       W  9  P 0 VALUE 0                                              
*                                                                               
%W425686W 'SPAR-'                                                               
SPAR-IDLOPNR     W  9  P 0                                                      
*                                                                               
SU1-AREA      W   114  A                                                        
SU2-AREA      W   114  A                                                        
SU3-AREA      W   114  A                                                        
SU4-AREA      W   114  A                                                        
SU5-AREA      W   114  A                                                        
SUA-AREA      W   114  A                                                        
SUC-AREA      W   114  A                                                        
SUD-AREA      W   114  A                                                        
685-AREA      W    59  A                                                        
686-AREA      W    58  A                                                        
687-AREA      W   199  A                                                        
688-AREA      W    56  A                                                        
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*------------------------------------------------------------------*            
* STEG 1. LÄSER INFIL. SÅLLAR UT 686-POSTER OCH SKRIVER DEM PÅ     *            
*         TEMPFIL.                                                 *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT W42525D1                                                              
                                                                                
  IF IN-IDPTYP = '686'                                                          
     WS-IDLOPNR    = WS-IDLOPNR + 1                                             
     TEMP1-W425686 = 686-POST                                                   
     TEMP1-IDLOPNR = WS-IDLOPNR                                                 
     PUT TEMPFIL1                                                               
  ELSE                                                                          
     WS-IDLOPNR    = WS-IDLOPNR + 1                                             
     TEMP2-IDLOPNR = WS-IDLOPNR                                                 
     PERFORM FLYTTA-TILL-TEMPFIL2                                               
     PUT TEMPFIL2                                                               
  END-IF                                                                        
                                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
FLYTTA-TILL-TEMPFIL2.  PROC                                                     
*                                                                               
  IF IN-IDPTYP = '685'                                                          
     TEMP2-AREA  = 685-POST                                                     
  END-IF                                                                        
  IF IN-IDPTYP = '687'                                                          
     TEMP2-AREA  = 687-POST                                                     
  END-IF                                                                        
  IF IN-IDPTYP = '688'                                                          
     TEMP2-AREA  = 688-POST                                                     
  END-IF                                                                        
  IF IN-IDPTYP = 'SU1'                                                          
     TEMP2-AREA  = SU1-POST                                                     
  END-IF                                                                        
  IF IN-IDPTYP = 'SU2'                                                          
     TEMP2-AREA  = SU2-POST                                                     
  END-IF                                                                        
  IF IN-IDPTYP = 'SU3'                                                          
     TEMP2-AREA  = SU3-POST                                                     
  END-IF                                                                        
  IF IN-IDPTYP = 'SU4'                                                          
     TEMP2-AREA  = SU4-POST                                                     
  END-IF                                                                        
  IF IN-IDPTYP = 'SU5'                                                          
     TEMP2-AREA  = SU5-POST                                                     
  END-IF                                                                        
  IF IN-IDPTYP = 'SUA'                                                          
     TEMP2-AREA  = SUA-POST                                                     
  END-IF                                                                        
  IF IN-IDPTYP = 'SUC'                                                          
     TEMP2-AREA  = SUC-POST                                                     
  END-IF                                                                        
  IF IN-IDPTYP = 'SUD'                                                          
     TEMP2-AREA  = SUD-POST                                                     
  END-IF                                                                        
*                                                                               
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*------------------------------------------------------------------*            
* STEG 2. SORTERAR TEMPFIL1 (686-POSTER)                           *            
*                                                                  *            
* -----------------------------------------------------------------*            
*                                                                               
SORT TEMPFIL1 TO +                                                              
     TEMPFILA USING (TEMP1-IDDISTR, TEMP1-IDDC, TEMP1-IDFAKT,         +         
                     TEMP1-IDKUNDRF)                                            
*                                                                               
NEWPAGE                                                                         
*                                                                               
*------------------------------------------------------------------*            
* STEG 3. LÄSER TEMPFILA. OM DET FINNS FLERA 686-POSTER MED SAMMA  *            
*         IDENTITET SKA EN AV DESSA POSTER SKRIVAS. KVANTITETER    *            
*         FRÅN DE 686-POSTER SOM TAS BORT SKA ADDERAS IN I DEN     *            
*         686-POST SOM BLIR KVAR. SKRIVER TILL TEMPFIL3.           *            
*         LÄSER TEMPFIL2 OCH SKRIVER TILL TEMPFIL3.                *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT NULL                                                                  
                                                                                
  PERFORM FOERSTA-POSTEN                                                        
  GET TEMPFILA                                                                  
  IF EOF TEMPFILA                                                               
     TEMPFILA-TOM = JA                                                          
  ELSE                                                                          
     TEMPFILA-TOM = NEJ                                                         
  END-IF                                                                        
  DO WHILE NOT EOF TEMPFILA                                                     
     IF SPAR-IDDISTR        = TEMPA-IDDISTR                           +         
        AND SPAR-IDDC       = TEMPA-IDDC                              +         
        AND SPAR-IDFAKT     = TEMPA-IDFAKT                            +         
        AND SPAR-KDFAKTYP   = TEMPA-KDFAKTYP                          +         
        AND SPAR-IDKUNDRF   = TEMPA-IDKUNDRF                          +         
        AND SPAR-KDORDKL    = TEMPA-KDORDKL                                     
         SPAR-KVRAD-UPD = SPAR-KVRAD-UPD + TEMPA-KVRAD-UPD                      
         SPAR-KVKOLLIO  = SPAR-KVKOLLIO  + TEMPA-KVKOLLIO                       
         SPAR-VLORDBTO  = SPAR-VLORDBTO  + TEMPA-VLORDBTO                       
         SPAR-VKORDBTO  = SPAR-VKORDBTO  + TEMPA-VKORDBTO                       
     ELSE                                                                       
         IF FOERSTA-POSTEN = NEJ                                                
           TEMP3-AREA    = SPAR-W425686                                         
           TEMP3-IDLOPNR = SPAR-IDLOPNR                                         
           PUT TEMPFIL3                                                         
         ELSE                                                                   
           FOERSTA-POSTEN = NEJ                                                 
         END-IF                                                                 
         SPAR-W425686 = TEMPA-W425686                                           
         SPAR-IDLOPNR = TEMPA-IDLOPNR                                           
     END-IF                                                                     
     GET TEMPFILA                                                               
  END-DO                                                                        
  IF TEMPFILA-TOM = NEJ                                                         
     PERFORM SISTA-POSTEN                                                       
  END-IF                                                                        
                                                                                
  GET TEMPFIL2                                                                  
  DO WHILE NOT EOF TEMPFIL2                                                     
     TEMP3-AREA    = TEMP2-AREA                                                 
     TEMP3-IDLOPNR = TEMP2-IDLOPNR                                              
     PUT TEMPFIL3                                                               
     GET TEMPFIL2                                                               
  END-DO                                                                        
  STOP                                                                          
*                                                                               
NEWPAGE                                                                         
*                                                                               
FOERSTA-POSTEN.  PROC                                                           
                                                                                
  SPAR-IDDISTR  = 0                                                             
  SPAR-IDDC     = '  '                                                          
  SPAR-IDFAKT   = 0                                                             
  SPAR-KDORDKL  = 0                                                             
  SPAR-KDFAKTYP = ' '                                                           
  SPAR-IDKUNDRF = '          '                                                  
                                                                                
  FOERSTA-POSTEN = JA                                                           
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
SISTA-POSTEN.  PROC                                                             
                                                                                
  TEMP3-AREA    = SPAR-W425686                                                  
  TEMP3-IDLOPNR = SPAR-IDLOPNR                                                  
  PUT TEMPFIL3                                                                  
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
*------------------------------------------------------------------*            
* STEG 4. SORTERING AV TEMPFIL3 I LOPNR-ORDNING                    *            
* -----------------------------------------------------------------*            
*                                                                               
SORT TEMPFIL3 TO +                                                              
     TEMPFIL3 USING TEMP3-IDLOPNR                                               
*                                                                               
*------------------------------------------------------------------*            
* STEG 5. LÄSER TEMPFIL3 OCH SKRIVER UTFIL W42525D2                *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT TEMPFIL3                                                              
                                                                                
  PERFORM FLYTTA-TILL-UTFIL                                                     
  PUT W42525D2                                                                  
                                                                                
*                                                                               
FLYTTA-TILL-UTFIL.  PROC                                                        
*                                                                               
  IF TEMP3-IDPTYP = '685'                                                       
     685-AREA = TEMP3-AREA                                                      
     UT-POST  = 685-AREA                                                        
  END-IF                                                                        
  IF TEMP3-IDPTYP = '686'                                                       
     686-AREA = TEMP3-AREA                                                      
     UT-POST  = 686-AREA                                                        
  END-IF                                                                        
  IF TEMP3-IDPTYP = '687'                                                       
     687-AREA = TEMP3-AREA                                                      
     UT-POST  = 687-AREA                                                        
  END-IF                                                                        
  IF TEMP3-IDPTYP = '688'                                                       
     688-AREA = TEMP3-AREA                                                      
     UT-POST  = 688-AREA                                                        
  END-IF                                                                        
  IF TEMP3-IDPTYP = 'SU1'                                                       
     SU1-AREA = TEMP3-AREA                                                      
     UT-POST  = SU1-AREA                                                        
  END-IF                                                                        
  IF TEMP3-IDPTYP = 'SU2'                                                       
     SU2-AREA = TEMP3-AREA                                                      
     UT-POST  = SU2-AREA                                                        
  END-IF                                                                        
  IF TEMP3-IDPTYP = 'SU3'                                                       
     SU3-AREA = TEMP3-AREA                                                      
     UT-POST  = SU3-AREA                                                        
  END-IF                                                                        
  IF TEMP3-IDPTYP = 'SU4'                                                       
     SU4-AREA = TEMP3-AREA                                                      
     UT-POST  = SU4-AREA                                                        
  END-IF                                                                        
  IF TEMP3-IDPTYP = 'SU5'                                                       
     SU5-AREA = TEMP3-AREA                                                      
     UT-POST  = SU5-AREA                                                        
  END-IF                                                                        
  IF TEMP3-IDPTYP = 'SUA'                                                       
     SUA-AREA = TEMP3-AREA                                                      
     UT-POST  = SUA-AREA                                                        
  END-IF                                                                        
  IF TEMP3-IDPTYP = 'SUC'                                                       
     SUC-AREA = TEMP3-AREA                                                      
     UT-POST  = SUC-AREA                                                        
  END-IF                                                                        
  IF TEMP3-IDPTYP = 'SUD'                                                       
     SUD-AREA = TEMP3-AREA                                                      
     UT-POST  = SUD-AREA                                                        
  END-IF                                                                        
*                                                                               
END-PROC                                                                        
*                                                                               
