  NDC-KDEMBKOD-0    = CDC-KDEMBKOD-0                                            
  NDC-KDEMBKOD-1    = CDC-KDEMBKOD-1                                            
  NDC-KDEMBKOD-2    = CDC-KDEMBKOD-2                                            
  NDC-KDERS         = CDC-KDERS                                                 
  NDC-KDERS-UTG     = CDC-KDERS-UTG                                             
  NDC-KDFARLIG      = CDC-KDFARLIG                                              
  NDC-KDGK          = CDC-KDGK                                                  
  NDC-KDPRODSL      = CDC-KDPRODSL                                              
  NDC-KDSORT        = CDC-KDSORT                                                
  NDC-KDSPEEMB      = CDC-KDSPEEMB                                              
  NDC-KDSRA         = CDC-KDSRA                                                 
  NDC-KDUART        = CDC-KDUART                                                
  NDC-KDVVKL        = CDC-KDVVKL                                                
  NDC-KDYTBEH       = CDC-KDYTBEH                                               
  NDC-KDPSLLOC      = CDC-KDPSLLOC                                              
  NDC-KVPALL        = CDC-KVPALL                                                
  NDC-KVQPACK-0     = CDC-KVQPACK-0                                             
  NDC-KVQPACK-1     = CDC-KVQPACK-1                                             
  NDC-KVQPACK-2     = CDC-KVQPACK-2                                             
  NDC-KVQPACK-3     = CDC-KVQPACK-3                                             
  NDC-KVQPACK-4     = CDC-KVQPACK-4                                             
  NDC-PRARTBES      = CDC-PRARTBES                                              
  NDC-PRARTBTO-EXP  = CDC-PRARTBTO-EXP                                          
  NDC-PRARTSJK      = CDC-PRARTSJK                                              
  NDC-PRARTSTD      = CDC-PRARTSTD                                              
  NDC-PRINK         = CDC-PRINK                                                 
  NDC-TIERSDAT      = CDC-TIERSDAT                                              
  NDC-TIFINLV       = CDC-TIFINLV                                               
  NDC-VKART         = CDC-VKART                                                 
  NDC-VLARTNTO      = CDC-VLARTNTO                                              
  NDC-KVPB-REF-US   = CDC-KVPB-REF-US                                           
                                                                                
  WS-IDDC = T2-IDDC                                                             
  PERFORM S23-CHECK-T2-IDDC                                                     
  IF T2-IDDC = NDC-NA                                                           
     WS-KR-VIKT     = ((CDC-VKART * 17.00) / 1000) + 0.5                        
     WS-KR-VOLYM    = ((CDC-VLARTNTO * 17.00 * 167) / 1000000)   +              
                         + 0.5                                                  
  ELSE                                                                          
    IF T2-IDDC = NDC-JP                                                         
       WS-KR-VIKT     = ((CDC-VKART * 18.10) / 1000) + 0.5                      
       WS-KR-VOLYM    = ((CDC-VLARTNTO * 18.10 * 167) / 1000000)   +            
                        + 0.5                                                   
    ELSE                                                                        
      IF T2-IDDC = NDC-AU                                                       
         WS-KR-VIKT     = ((CDC-VKART * 21.40) / 1000) + 0.5                    
         WS-KR-VOLYM    = ((CDC-VLARTNTO * 21.40 * 167) / 1000000) +            
                        + 0.5                                                   
      ELSE                                                                      
        IF T2-IDDC = NDC-CN                                                     
           WS-KR-VIKT   = ((CDC-VKART * 10.00) / 1000) + 0.5                    
           WS-KR-VOLYM  = ((CDC-VLARTNTO * 10.00 * 167) / 1000000) +            
                          + 0.5                                                 
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
  IF WS-KR-VIKT > WS-KR-VOLYM                                                   
     NDC-PRAIRCO = WS-KR-VIKT                                                   
  ELSE                                                                          
     NDC-PRAIRCO = WS-KR-VOLYM                                                  
  END-IF                                                                        
*                                                                               
END-PROC                                                                        
