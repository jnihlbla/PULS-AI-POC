************************************************************************        
*                                                                      *        
* PARAMETRAR TILL WDATKONV                                             *        
*                                                                      *        
************************************************************************        
*                                                                               
%WDATAREA                                                                       
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
************************************************************************        
*                                                                      *        
* JOBSTEG 1  MATCHAR NDC-FILER OCH SKRIVER WXTR9ND5 (TEMP1)            *        
*                                                                      *        
************************************************************************        
JOB INPUT (WXTR9ND2  KEY (W01184-SLAG-IDARTNR              +                    
                          W01184-SLAG-IDDC    )            +                    
           WXTR9ND3  KEY (W01186-DC-IDARTNR                +                    
                          W01186-DC-IDDC      )            +                    
           WXTR9ND4  KEY (W27120-IDARTNR                   +                    
                          W27120-IDDC         ))           +                    
START A-INIT                                               +                    
NAME STEG1-MATCHAR-O-SKRIVER                                                    
                                                                                
  IF MATCHED WXTR9ND2 WXTR9ND3 WXTR9ND4                                         
    T1-IDARTNR EQ W01184-SLAG-IDARTNR                                           
    T1-IDDC    EQ W01184-SLAG-IDDC                                              
    PERFORM B-SKRIV-W01184-UPPG                                                 
    PERFORM C-SKRIV-W01186-UPPG                                                 
    PERFORM D-SKRIV-W27120-UPPG                                                 
    PUT WXTR9ND5                                                                
  ELSE                                                                          
    IF MATCHED WXTR9ND2 WXTR9ND3                                                
      T1-IDARTNR EQ W01184-SLAG-IDARTNR                                         
      T1-IDDC    EQ W01184-SLAG-IDDC                                            
      PERFORM B-SKRIV-W01184-UPPG                                               
      PERFORM C-SKRIV-W01186-UPPG                                               
      PERFORM F-NOLLA-W27120-UPPG                                               
      PUT WXTR9ND5                                                              
    ELSE                                                                        
      IF MATCHED WXTR9ND2 WXTR9ND4                                              
        T1-IDARTNR EQ W01184-SLAG-IDARTNR                                       
        T1-IDDC    EQ W01184-SLAG-IDDC                                          
        PERFORM B-SKRIV-W01184-UPPG                                             
        PERFORM E-NOLLA-W01186-UPPG                                             
        PERFORM D-SKRIV-W27120-UPPG                                             
        PUT WXTR9ND5                                                            
      ELSE                                                                      
        IF WXTR9ND2                                                             
          T1-IDARTNR EQ W01184-SLAG-IDARTNR                                     
          T1-IDDC    EQ W01184-SLAG-IDDC                                        
          PERFORM B-SKRIV-W01184-UPPG                                           
          PERFORM E-NOLLA-W01186-UPPG                                           
          PERFORM F-NOLLA-W27120-UPPG                                           
          PUT WXTR9ND5                                                          
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
A-INIT. PROC                                                                    
                                                                                
  PERFORM E-NOLLA-W01186-UPPG                                                   
  PERFORM F-NOLLA-W27120-UPPG                                                   
  PERFORM S-BERAKNA-ANTAL-VECKOR                                                
  PERFORM S1-GET-WEEKS-IN-PERIOD                                                
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
B-SKRIV-W01184-UPPG. PROC                                                       
  T1-ADLAGOMR            = W01184-SLAG-ADLAGOMR                                 
  T1-ADGANG              = W01184-SLAG-ADGANG                                   
  T1-ADPLATS             = W01184-SLAG-ADPLATS                                  
  T1-DAPUBL              = W01184-SLAG-DAPUBL                                   
  T1-FLREFBEO            = W01184-SLAG-FLREFBEO                                 
  T1-FLSKROT-BEORD       = W01184-SLAG-FLSKROT-BEORD                            
  T1-TISPARR-KVAL        = W01184-SLAG-TISPARR-KVAL                             
  T1-ADLAGOMR-CD         = W01184-SLAG-ADLAGOMR-CD                              
  T1-FLCDREL             = W01184-SLAG-FLCDREL                                  
  T1-FLWILSON            = W01184-SLAG-FLWILSON                                 
  T1-FLORDSP             = W01184-SLAG-FLORDSP                                  
  T1-FLORDSP-EJRO        = W01184-SLAG-FLORDSP-EJRO                             
  T1-FLSPBULK            = W01184-SLAG-FLSPBULK                                 
  T1-IDLEVNR-NDC         = W01184-SLAG-IDLEVNR                                  
  T1-KDLEVSP             = W01184-SLAG-KDLEVSP                                  
  T1-KDREFSTA            = W01184-SLAG-KDREFSTA                                 
  T1-KVAKS-PAV           = W01184-SLAG-KVAKS-PAV                                
  T1-KVAKS-SDC           = W01184-SLAG-KVAKS-SDC                                
  T1-KVBEART             = W01184-SLAG-KVBEART                                  
  T1-KVEFRS              = W01184-SLAG-KVEFRS                                   
  T1-KVINVS              = W01184-SLAG-KVINVS                                   
  T1-KVLS                = W01184-SLAG-KVLS                                     
  T1-KVOKS-BULK          = W01184-SLAG-KVOKS-BULK                               
  T1-KVOKS-DAG           = W01184-SLAG-KVOKS-DAG                                
  T1-KVPB-REF            = W01184-SLAG-KVPB-REF                                 
  T1-KVREFBER            = W01184-SLAG-KVREFBER                                 
  T1-KVREFOVL            = W01184-SLAG-KVREFOVL                                 
  T1-KVREFPKT            = W01184-SLAG-KVREFPKT                                 
  T1-KVRETUR-BEORD       = W01184-SLAG-KVRETUR-BEORD                            
  T1-KVRESS              = W01184-SLAG-KVRESS                                   
  T1-KVROS-BULK          = W01184-SLAG-KVROS-BULK                               
  T1-KVROS-DAG           = W01184-SLAG-KVROS-DAG                                
  T1-KVSKROT             = W01184-SLAG-KVSKROT                                  
  T1-KVUTRS              = W01184-SLAG-KVUTRS                                   
  T1-PRAVCOST            = W01184-SLAG-PRAVCOST                                 
  T1-TIINVDAT            = W01184-SLAG-TIINVDAT                                 
  T1-TIORDREG            = W01184-SLAG-TIORDREG                                 
  T1-TIREFMPB            = W01184-SLAG-TIREFMPB                                 
  T1-TIREFPAF            = W01184-SLAG-TIREFPAF                                 
  T1-TIREFPKT            = W01184-SLAG-TIREFPKT                                 
  T1-TIREFSTA            = W01184-SLAG-TIREFSTA                                 
  T1-TIREFSTO            = W01184-SLAG-TIREFSTO                                 
  T1-TIRETUR-BEORD       = W01184-SLAG-TIRETUR-BEORD                            
  T1-TISKROT             = W01184-SLAG-TISKROT                                  
  T1-TISKROT-BEORD       = W01184-SLAG-TISKROT-BEORD                            
  T1-TISPARR-KVAL        = W01184-SLAG-TISPARR-KVAL                             
  T1-ADLAGOMR-CD         = W01184-SLAG-ADLAGOMR-CD                              
  T1-FLCDREL             = W01184-SLAG-FLCDREL                                  
  T1-KVDAGAR-CDBEH       = W01184-SLAG-KVDAGAR-CDBEH                            
  T1-PRMATRL             = W01184-SLAG-PRMATRL                                  
  T1-KDMATRPR            = W01184-SLAG-KDMATRPR                                 
  T1-KVPALL-CN           = W01184-SLAG-KVPALL                                   
  T1-KVULOAD             = W01184-SLAG-KVULOAD                                  
  T1-KVSLAGER            = W01184-SLAG-KVSLAGER                                 
  T1-TIMANSEC            = W01184-SLAG-TIMANSEC                                 
  T1-KVEOQ               = W01184-SLAG-KVEOQ                                    
  T1-KDOPPLAN            = W01184-SLAG-KDOPPLAN                                 
  T1-KDLEVPLF            = W01184-SLAG-KDLEVPLF                                 
  T1-FLJIT-CN            = W01184-SLAG-FLJIT                                    
  T1-KDLPSP              = W01184-SLAG-KDLPSP                                   
  T1-TILPSP              = W01184-SLAG-TILPSP                                   
  T1-KVPB-PLAN           = W01184-SLAG-KVPB-PLAN                                
  T1-DAPBPLAN            = W01184-SLAG-DAPBPLAN                                 
  T1-DASEASON            = W01184-SLAG-DASEASON                                 
  T1-KVPB-JUST1          = W01184-SLAG-KVPB-JUST1                               
  T1-TIPBJUST-1          = W01184-SLAG-TIPBJUST-1                               
  T1-KVPB-JUST2          = W01184-SLAG-KVPB-JUST2                               
  T1-TIPBJUST-2          = W01184-SLAG-TIPBJUST-2                               
  T1-KVPB-TREND          = W01184-SLAG-KVPB-TREND                               
  T1-KVVECKOR-TREND      = W01184-SLAG-KVVECKOR-TREND                           
  T1-TIDATUM-TREND       = W01184-SLAG-TIDATUM-TREND                            
  T1-KVPBREOI            = W01184-SLAG-KVPBREOI                                 
  T1-TIPBREOI            = W01184-SLAG-TIPBREOI                                 
  T1-KDAVT               = W01184-SLAG-KDAVT                                    
  T1-TIREFSTO-LOC        = W01184-SLAG-TIREFSTO-LOC                             
  T1-IDANSK-CN           = W01184-SLAG-IDANSK                                   
  T1-IDINK-CN            = W01184-SLAG-IDINK                                    
  T1-IDLEVNR-SHIP        = W01184-SLAG-IDLEVNR-SHIP                             
  T1-IDLEVNR-FRAM        = W01184-SLAG-IDLEVNR-FRAM                             
  T1-IDLEVNR-SHIP-FRAM   = W01184-SLAG-IDLEVNR-SHIP-FRAM                        
  T1-TILEVDAT            = W01184-SLAG-TILEVDAT                                 
  T1-IDPLANGR-AG         = W01184-SLAG-IDPLANGR-AG                              
  T1-KVDAGAR-INLEV       = W01184-SLAG-KVDAGAR-INLEV                            
  T1-KVVECKOR-LT         = W01184-SLAG-KVVECKOR-LT                              
  T1-TIMANLED            = W01184-SLAG-TIMANLED                                 
  T1-KVSLUTKP            = W01184-SLAG-KVSLUTKP                                 
  T1-TISLUTKP            = W01184-SLAG-TISLUTKP                                 
  T1-TIERSDAT-VIPS       = W01184-SLAG-TIERSDAT-VIPS                            
  T1-KVSPANT             = W01184-SLAG-KVSPANT                                  
  T1-VKART-CN            = W01184-SLAG-VKART                                    
  T1-VLARTNTO-CN         = W01184-SLAG-VLARTNTO                                 
  T1-KDARTURS-CN         = W01184-SLAG-KDARTURS                                 
  T1-FLREFILL            = W01184-SLAG-FLREFILL                                 
  T1-FLREFNYO            = W01184-SLAG-FLREFNYO                                 
  T1-IDPSN-DC            = W01184-SLAG-IDPSN-DC                                 
  IX = 1                                                                        
                                                                                
  WS-FLSEASON = 'N'                                                             
  DO WHILE IX < 13                                                              
    IF W01184-SLAG-RESEASON(IX) = 1.00                                          
       CONTINUE                                                                 
    ELSE                                                                        
       WS-FLSEASON = 'J'                                                        
    END-IF                                                                      
    T1-RESEASON (IX)      = W01184-SLAG-RESEASON(IX)                            
    T1-RESEASON-PLAN (IX) = W01184-SLAG-RESEASON-PLAN(IX)                       
    IF IX < 6                                                                   
      T1-TILEVDAG(IX)     = W01184-SLAG-TILEVDAG(IX)                            
    END-IF                                                                      
    IX = IX + 1                                                                 
  END-DO                                                                        
  T1-FLSEASON            = WS-FLSEASON                                          
                                                                                
  WS-IDDC = T1-IDDC                                                             
  T1-IDPERSON-BUY        = W01184-SLAG-IDPERSON-BUY                             
  T1-FLFLYG              = W01184-SLAG-FLFLYG                                   
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
C-SKRIV-W01186-UPPG. PROC                                                       
  T1-TIREFEFT            = W01186-DC-TIREFEFT                                   
                                                                                
  INDX = 1                                                                      
  T1-KVOI-CDC-RULL       = +0                                                   
  T1-KVOI-RULL           = +0                                                   
  T1-KVOT-CDC-RULL       = +0                                                   
  T1-KVOT-RULL           = +0                                                   
  T1-KVOT-REF-RULL       = +0                                                   
                                                                                
  DO WHILE INDX LE W-ANTAL-VECKOR                                               
   T1-KVOI-CDC-RULL = T1-KVOI-CDC-RULL + W01186-DC-KVOI-CDC-RULL(INDX)          
   T1-KVOI-RULL     = T1-KVOI-RULL     + W01186-DC-KVOI-RULL(INDX)              
   T1-KVOT-CDC-RULL = T1-KVOT-CDC-RULL + W01186-DC-KVOT-CDC-RULL(INDX)          
   T1-KVOT-RULL     = T1-KVOT-RULL     + W01186-DC-KVOT-RULL(INDX)              
   T1-KVOT-REF-RULL = T1-KVOT-REF-RULL + W01186-DC-KVOT-REF-RULL(INDX)          
   INDX = INDX + 1                                                              
  END-DO                                                                        
                                                                                
  PERFORM CA-SKRIV-NYA-W01186-UPPG                                              
                                                                                
  PERFORM CB-GET-ORDER-HIT-PREV                                                 
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
CA-SKRIV-NYA-W01186-UPPG. PROC                                                  
                                                                                
  INDX = 1                                                                      
  DO WHILE INDX LE INDX-MAX                                                     
     W-KVOI-TOT-NUV(INDX) = 0                                                   
     W-KVOI-TOT-NUV-REF(INDX) = 0                                               
     W-KVVIPER-NUV (INDX) = 0                                                   
     W-KVOI-TOT-FORRA(INDX) = 0                                                 
     W-KVOI-TOT-FORRA-REF(INDX) = 0                                             
     W-KVVIPER-FORRA(INDX) = 0                                                  
     INDX = INDX + 1                                                            
  END-DO                                                                        
  W-PER-FORRA = 0                                                               
  W-PER-NUV   = 0                                                               
                                     ***** FÖREG TVÅ ÅR                         
  INDX  = 1                                                                     
  INDX2 = 1                                                                     
  WS-KVOI-TOT-1          = +0                                                   
  WS-KVOI-TOT-2          = +0                                                   
  T1-KVOI-FOREG(1)       = +0                                                   
  T1-KVOI-FOREG(2)       = +0                                                   
  DO WHILE INDX LE 2                                                            
     DO WHILE INDX2 LE INDX-MAX                                                 
        IF INDX = 1                                                             
           WS-KVOI-TOT-1 = WS-KVOI-TOT-1 +                                      
                         + W01186-DC-KVOI ((INDX)(INDX2))                       
        ELSE                                                                    
           WS-KVOI-TOT-2 = WS-KVOI-TOT-2 +                                      
                         + W01186-DC-KVOI ((INDX)(INDX2))                       
        END-IF                                                                  
        INDX2 = INDX2 + 1                                                       
     END-DO                                                                     
     INDX = INDX + 1                                                            
     INDX2 = 1                                                                  
  END-DO                                                                        
  T1-KVOI-FOREG(1) = WS-KVOI-TOT-1                                              
  T1-KVOI-FOREG(2) = WS-KVOI-TOT-2                                              
                                     ***** DAGENS-DATUM                         
  DAT-I-TIDATUM = 0                                                             
  DAT-KDDATFORM = 'IDAG'                                                        
  CALL WDATKONV USING (DAT-KDDATFORM,  +                                        
                       DAT-I-TIDATUM,  +                                        
                       DAT-O-TIDATUM,  +                                        
                       DAT-KDSVAR)                                              
                                                                                
  W-AAR            =  DAT-TIAA                                                  
  W-VV             =  DAT-TIVV                                                  
  W-DAGENS-AA      =  DAT-TIAA                                                  
  W-DAGENS-AAR     =  DAT-TIAA                                                  
  W-DAGENS-VV      =  DAT-TIVV                                                  
  W-DAGENS-RP      =  DAT-TIRP                                                  
                                     ***** FÖRSTA VECKAN NUV PERIOD             
  DAT-I-TIDATUM = W-DAGENS-AARP                                                 
  DAT-KDDATFORM = 'AARP  '                                                      
  CALL WDATKONV USING (DAT-KDDATFORM,  +                                        
                       DAT-I-TIDATUM,  +                                        
                       DAT-O-TIDATUM,  +                                        
                       DAT-KDSVAR)                                              
  WS-TIAA          =  DAT-TIAA                                                  
  WS-TIVV          =  DAT-TIVV                                                  
                                     ***** KONTROLL OM NY PERIOD                
  IF W01186-DC-TIVV(1) = WS-TIVV                                                
     SW-NY-PERIOD = NEJ                                                         
     INDX2-MAX = WS-TIVV - 1                                                    
  ELSE                                                                          
     SW-NY-PERIOD = JA                                                          
     INDX2-MAX = W-DAGENS-VV                                                    
  END-IF                                                                        
  IF W01186-DC-TIVV(1) < WS-TIVV                                                
     SW-NYTT-AR = JA                                                            
  ELSE                                                                          
     SW-NYTT-AR = NEJ                                                           
  END-IF                                                                        
                                                                                
  INDX   = 1                                                                    
  W-VV   = 1                                                                    
  DO WHILE INDX LE INDX2-MAX                                                    
     DAT-I-TIDATUM = W-AAVV                                                     
     DAT-KDDATFORM = 'AAVV  '                                                   
     CALL WDATKONV USING (DAT-KDDATFORM,  +                                     
                          DAT-I-TIDATUM,  +                                     
                          DAT-O-TIDATUM,  +                                     
                          DAT-KDSVAR)                                           
     INDX-PER = DAT-TIRP                                                        
     W-KVOI-TOT-NUV(INDX-PER) = W-KVOI-TOT-NUV(INDX-PER)          +             
                         + W01186-DC-KVOI-RULL(INDX)                            
     W-KVOI-TOT-NUV-REF(INDX-PER) = W-KVOI-TOT-NUV-REF(INDX-PER)   +            
                         + W01186-DC-KVOI-REF-RULL(INDX)                        
     W-KVVIPER-NUV(INDX-PER) = DAT-KVVIPER                                      
     INDX = INDX + 1                                                            
     W-VV = W-VV + 1                                                            
  END-DO                                                                        
                                                                                
  W-PER-NUV = INDX-PER                                                          
  INDX  = 1                                                                     
  INDX2 = INDX-PER + 1                                                          
  INDX2-MAX = 5                                                                 
  W-PER-FORRA = INDX-PER + 1                                                    
                                                                                
  DO WHILE INDX2 LE INDX-MAX                                                    
     W-KVOI-TOT-FORRA (INDX2) =                               +                 
          + W01186-DC-KVOI ((INDX)(INDX2))                                      
     W-KVOI-TOT-FORRA-REF (INDX2) =                               +             
          + W01186-DC-KVOI-REFILL ((INDX)(INDX2))                               
     W-KVVIPER-FORRA(INDX2) = W01186-DC-KVVIPER((INDX)(INDX2))                  
     INDX2 = INDX2 + 1                                                          
  END-DO                                                                        
                                                                                
  INDX-T1 = 1                                                                   
  INDX = W-PER-FORRA                                                            
  DO WHILE INDX LE INDX-MAX                                                     
    IF W-KVOI-TOT-FORRA(INDX) = 0                                               
****   T1-KVOI-RP(INDX-T1) = 0                                                  
       TX-KVOI-RP(INDX-T1) = 0                                                  
    ELSE                                                                        
****   T1-KVOI-RP(INDX-T1) = (W-KVOI-TOT-FORRA(INDX)           +                
****                  / W-KVVIPER-FORRA(INDX) * 4.33) + 0.5                     
       TX-KVOI-RP(INDX-T1) = (W-KVOI-TOT-FORRA(INDX)           +                
                      / W-KVVIPER-FORRA(INDX) * 4.33) + 0.5                     
    END-IF                                                                      
    IF W-KVOI-TOT-FORRA-REF(INDX) = 0                                           
       TX-KVOI-RP-REF(INDX-T1) = 0                                              
    ELSE                                                                        
       TX-KVOI-RP-REF(INDX-T1) = (W-KVOI-TOT-FORRA-REF(INDX)   +                
                      / W-KVVIPER-FORRA(INDX) * 4.33) + 0.5                     
    END-IF                                                                      
    INDX    = INDX + 1                                                          
    INDX-T1 = INDX-T1 + 1                                                       
  END-DO                                                                        
                                                                                
  IF W-PER-NUV = 0                                                              
  ELSE                                                                          
     INDX = 1                                                                   
     DO WHILE INDX LE W-PER-NUV                                                 
       IF W-KVOI-TOT-NUV(INDX) = 0                                              
*****     T1-KVOI-RP(INDX-T1) = 0                                               
          TX-KVOI-RP(INDX-T1) = 0                                               
       ELSE                                                                     
****      T1-KVOI-RP(INDX-T1) = (W-KVOI-TOT-NUV(INDX)          +                
****                  / W-KVVIPER-NUV(INDX) * 4.33) + 0.5                       
          TX-KVOI-RP(INDX-T1) = (W-KVOI-TOT-NUV(INDX)          +                
                      / W-KVVIPER-NUV(INDX) * 4.33) + 0.5                       
       END-IF                                                                   
       IF W-KVOI-TOT-NUV-REF(INDX) = 0                                          
          TX-KVOI-RP-REF(INDX-T1) = 0                                           
       ELSE                                                                     
          TX-KVOI-RP-REF(INDX-T1) = (W-KVOI-TOT-NUV-REF(INDX)  +                
                      / W-KVVIPER-NUV(INDX) * 4.33) + 0.5                       
       END-IF                                                                   
       INDX    = INDX + 1                                                       
       INDX-T1 = INDX-T1 + 1                                                    
     END-DO                                                                     
  END-IF                                                                        
************                                                                    
  T1-KVOI-RP(12) = TX-KVOI-RP(1)                                                
  T1-KVOI-RP(11) = TX-KVOI-RP(2)                                                
  T1-KVOI-RP(10) = TX-KVOI-RP(3)                                                
  T1-KVOI-RP(9)  = TX-KVOI-RP(4)                                                
  T1-KVOI-RP(8)  = TX-KVOI-RP(5)                                                
  T1-KVOI-RP(7)  = TX-KVOI-RP(6)                                                
  T1-KVOI-RP(6)  = TX-KVOI-RP(7)                                                
  T1-KVOI-RP(5)  = TX-KVOI-RP(8)                                                
  T1-KVOI-RP(4)  = TX-KVOI-RP(9)                                                
  T1-KVOI-RP(3)  = TX-KVOI-RP(10)                                               
  T1-KVOI-RP(2)  = TX-KVOI-RP(11)                                               
  T1-KVOI-RP(1)  = TX-KVOI-RP(12)                                               
  T1-KVOI-REF-RP(12) = TX-KVOI-RP-REF(1)                                        
  T1-KVOI-REF-RP(11) = TX-KVOI-RP-REF(2)                                        
  T1-KVOI-REF-RP(10) = TX-KVOI-RP-REF(3)                                        
  T1-KVOI-REF-RP(9)  = TX-KVOI-RP-REF(4)                                        
  T1-KVOI-REF-RP(8)  = TX-KVOI-RP-REF(5)                                        
  T1-KVOI-REF-RP(7)  = TX-KVOI-RP-REF(6)                                        
  T1-KVOI-REF-RP(6)  = TX-KVOI-RP-REF(7)                                        
  T1-KVOI-REF-RP(5)  = TX-KVOI-RP-REF(8)                                        
  T1-KVOI-REF-RP(4)  = TX-KVOI-RP-REF(9)                                        
  T1-KVOI-REF-RP(3)  = TX-KVOI-RP-REF(10)                                       
  T1-KVOI-REF-RP(2)  = TX-KVOI-RP-REF(11)                                       
  T1-KVOI-REF-RP(1)  = TX-KVOI-RP-REF(12)                                       
************                                                                    
                                                                                
  WS-KVOI-INNEV = 0                                                             
  WS-KVOI-IAAR  = 0                                                             
  WS-KVOT-NDC-INNEV = 0                                                         
  WS-KVOT-MISS-INNEV = 0                                                        
  INDX = 1                                                                      
  INDX2-MAX = 5                                                                 
                                     ***** INNEV PERIOD                         
  DO WHILE INDX LE INDX2-MAX                                                    
     WS-KVOI-INNEV = W01186-DC-KVOI-INNEV      (INDX)            +              
                     + W01186-DC-KVOI-PP-INNEV (INDX)            +              
                     + WS-KVOI-INNEV                                            
* TOTAL ORDER HITS FOR PRESENT PERIOD                                           
     WS-KVOT-NDC-INNEV = W01186-DC-KVOT-INNEV  (INDX)            +              
                     + W01186-DC-KVOT-PP-INNEV (INDX)            +              
                     + W01186-DC-KVOT-REF-INNEV(INDX)            +              
                     + WS-KVOT-NDC-INNEV                                        
* MISSED ORDER HITS FOR PRESENT PERIOD                                          
     WS-KVOT-MISS-INNEV = W01186-DC-KVOT-CDC-INNEV(INDX)         +              
                         + WS-KVOT-MISS-INNEV                                   
     INDX = INDX + 1                                                            
  END-DO                                                                        
  T1-KVOI-INNEV = WS-KVOI-INNEV                                                 
  T1-KVOT-NDC-INNEV = WS-KVOT-NDC-INNEV                                         
  T1-KVOT-MISS-INNEV = WS-KVOT-MISS-INNEV                                       
                                     ***** INNEV AAR                            
                                     ***** VECKOR AVSLUTAD PERIOD               
  IF SW-NY-PERIOD = NEJ                                                         
     INDX2-MAX = WS-TIVV - 1                                                    
  ELSE                                                                          
     INDX2-MAX = W-DAGENS-VV                                                    
  END-IF                                                                        
  IF SW-NYTT-AR = JA                                                            
     INDX2-MAX = 0                                                              
  END-IF                                                                        
                                                                                
  INDX = 1                                                                      
  DO WHILE INDX LE INDX2-MAX                                                    
     WS-KVOI-IAAR = W01186-DC-KVOI-RULL(INDX)                  +                
                  + WS-KVOI-IAAR                                                
     INDX = INDX + 1                                                            
  END-DO                                                                        
  T1-KVOI-IAAR = WS-KVOI-INNEV + WS-KVOI-IAAR                                   
*                                                                               
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
CB-GET-ORDER-HIT-PREV. PROC                                                     
                                                                                
  WS-KVOT-NDC-RULL  = 0                                                         
  WS-KVOT-MISS-RULL = 0                                                         
  INDX2             = WS-FORSTA-V(12)                                           
  DO WHILE INDX2 LE WS-SISTA-V(12)                                              
                                                                                
* TOTAL ORDER HITS FOR PREVIOUS PERIOD                                          
     WS-KVOT-NDC-RULL  = W01186-DC-KVOT-RULL(INDX2)            +                
                         + W01186-DC-KVOT-REF-RULL(INDX2)      +                
                         + WS-KVOT-NDC-RULL                                     
                                                                                
* MISSED ORDER HITS FOR PREVIOUS PERIOD                                         
     WS-KVOT-MISS-RULL  = W01186-DC-KVOT-CDC-RULL(INDX2)       +                
                         + WS-KVOT-MISS-RULL                                    
                                                                                
     INDX2 = INDX2 + 1                                                          
  END-DO                                                                        
  T1-KVOT-NDC-RULL = WS-KVOT-NDC-RULL                                           
  T1-KVOT-MISS-RULL = WS-KVOT-MISS-RULL                                         
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
D-SKRIV-W27120-UPPG. PROC                                                       
  T1-KDFREKKL            = W27120-KDFREKKL                                      
  T1-KDPRISKL            = W27120-KDPRISKL                                      
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
E-NOLLA-W01186-UPPG. PROC                                                       
  T1-TIREFEFT            = +0                                                   
  T1-KVOI-FOREG(1)       = +0                                                   
  T1-KVOI-FOREG(2)       = +0                                                   
  T1-KVOI-CDC-RULL       = +0                                                   
  T1-KVOI-RULL           = +0                                                   
  T1-KVOT-CDC-RULL       = +0                                                   
  T1-KVOT-NDC-RULL       = +0                                                   
  T1-KVOT-NDC-INNEV      = +0                                                   
  T1-KVOT-RULL           = +0                                                   
  T1-KVOT-REF-RULL       = +0                                                   
  T1-KVOT-MISS-INNEV     = +0                                                   
  T1-KVOT-MISS-RULL      = +0                                                   
  T1-KVOI-INNEV          = 0                                                    
  T1-KVOI-IAAR           = 0                                                    
  T1-TIINLINL            = 0                                                    
  INDX = 1                                                                      
  DO WHILE INDX LE INDX-MAX                                                     
    T1-KVOI-RP(INDX)     = 0                                                    
    T1-KVOI-REF-RP(INDX) = 0                                                    
    INDX = INDX + 1                                                             
  END-DO                                                                        
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
F-NOLLA-W27120-UPPG. PROC                                                       
  T1-KDFREKKL            = ' '                                                  
  T1-KDPRISKL            = ' '                                                  
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
S-BERAKNA-ANTAL-VECKOR. PROC                                                    
                                                                                
 DAT-I-TIDATUM = +0                                                             
 DAT-KDDATFORM = 'IDAG'                                                         
 CALL WDATKONV USING (DAT-KDDATFORM,  +                                         
                      DAT-I-TIDATUM,  +                                         
                      DAT-O-TIDATUM,  +                                         
                      DAT-KDSVAR)                                               
                                                                                
 W-AA-FORRA = DAT-TIAA - 1                                                      
 W-VV-FORRA = +53                                                               
                                                                                
 W-DAGENS-AARP    =  DAT-TIAARP                                                 
                                                                                
 DAT-I-TIDATUM = W-AAVV-FORRA                                                   
 DAT-KDDATFORM = 'AAVV'                                                         
 CALL WDATKONV USING (DAT-KDDATFORM,  +                                         
                      DAT-I-TIDATUM,  +                                         
                      DAT-O-TIDATUM,  +                                         
                      DAT-KDSVAR)                                               
                                                                                
 IF DAT-KDSVAR = 'F'                                                            
   W-ANTAL-VECKOR = +52                                                         
 ELSE                                                                           
   W-ANTAL-VECKOR = +53                                                         
 END-IF                                                                         
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
S1-GET-WEEKS-IN-PERIOD. PROC                                                    
                                                                                
 INDX = 1                                                                       
                                                                                
 WS-TIAAPER = W-DAGENS-AARP                                                     
 IF TIAA = 00                                                                   
    TIAA = 99                                                                   
 ELSE                                                                           
    TIAA = TIAA - 1                                                             
 END-IF                                                                         
                                                                                
 DAT-I-TIDATUM = TIAAPER                                                        
 DAT-KDDATFORM = 'AARP'                                                         
 CALL WDATKONV USING (DAT-KDDATFORM,  +                                         
                      DAT-I-TIDATUM,  +                                         
                      DAT-O-TIDATUM,  +                                         
                      DAT-KDSVAR)                                               
                                                                                
 IF PER = 1                                                                     
    WS-FORSTA-V(INDX) = 1                                                       
 ELSE                                                                           
    WS-FORSTA-V(INDX) = DAT-TIVV                                                
 END-IF                                                                         
                                                                                
 DO WHILE INDX LE INDX-MAX                                                      
    PER = PER + 1                                                               
    IF PER GT INDX-MAX                                                          
      TIAA = TIAA + 1                                                           
      PER = 1                                                                   
    END-IF                                                                      
                                                                                
    DAT-I-TIDATUM = TIAAPER                                                     
    CALL WDATKONV USING (DAT-KDDATFORM,  +                                      
                         DAT-I-TIDATUM,  +                                      
                         DAT-O-TIDATUM,  +                                      
                         DAT-KDSVAR)                                            
                                                                                
    IF PER             =  1                                                     
      WS-SISTA-V(INDX) = W-ANTAL-VECKOR                                         
    ELSE                                                                        
      WS-SISTA-V(INDX) = DAT-TIVV - 1                                           
    END-IF                                                                      
                                                                                
    INDX  = INDX + 1                                                            
                                                                                
    IF INDX LE INDX-MAX                                                         
      IF PER =  1                                                               
        WS-FORSTA-V(INDX) = 1                                                   
      ELSE                                                                      
        WS-FORSTA-V(INDX) = DAT-TIVV                                            
      END-IF                                                                    
    END-IF                                                                      
 END-DO                                                                         
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*    --- S23-CHECK-WS-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'WS-'                                                                   
                                                                                
NEWPAGE                                                                         
************************************************************************        
*                                                                      *        
* JOBSTEG 2  MATCHAR TEMP1 MOT WXTR89                                  *        
*                                                                      *        
************************************************************************        
JOB INPUT (WXTR9ND5  KEY (T1-IDARTNR T1-IDDC)              +                    
           WXTR9ND8  KEY (IN-IDARTNR IN-IDDC))             +                    
NAME STEG2-MATCHAR-O-SKRIVER                                                    
                                                                                
  IF MATCHED WXTR9ND5 WXTR9ND8                                                  
    PERFORM A-SKRIV-T1-UPPGIFTER                                                
    PERFORM B-SKRIV-REOSAEK                                                     
    PUT WXTR9ND7                                                                
  ELSE                                                                          
    IF WXTR9ND5                                                                 
      PERFORM A-SKRIV-T1-UPPGIFTER                                              
      T2-REOSAEK = 0                                                            
      PUT WXTR9ND7                                                              
    END-IF                                                                      
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
A-SKRIV-T1-UPPGIFTER. PROC                                                      
  T2-IDARTNR             = T1-IDARTNR                                           
  T2-IDDC                = T1-IDDC                                              
  T2-ADLAGOMR            = T1-ADLAGOMR                                          
  T2-ADGANG              = T1-ADGANG                                            
  T2-ADPLATS             = T1-ADPLATS                                           
  T2-DAPUBL              = T1-DAPUBL                                            
  T2-FLORDSP             = T1-FLORDSP                                           
  T2-FLORDSP-EJRO        = T1-FLORDSP-EJRO                                      
  T2-FLSPBULK            = T1-FLSPBULK                                          
  T2-FLREFBEO            = T1-FLREFBEO                                          
  T2-FLSKROT-BEORD       = T1-FLSKROT-BEORD                                     
  T2-TISPARR-KVAL        = T1-TISPARR-KVAL                                      
  T2-ADLAGOMR-CD         = T1-ADLAGOMR-CD                                       
  T2-FLCDREL             = T1-FLCDREL                                           
  T2-FLWILSON            = T1-FLWILSON                                          
  T2-FLFLYG              = T1-FLFLYG                                            
  T2-FLSEASON            = T1-FLSEASON                                          
  T2-FLREFILL            = T1-FLREFILL                                          
  T2-FLREFNYO            = T1-FLREFNYO                                          
  T2-IDPERSON-BUY        = T1-IDPERSON-BUY                                      
  T2-IDLEVNR-NDC         = T1-IDLEVNR-NDC                                       
  T2-KDLEVSP             = T1-KDLEVSP                                           
  T2-KDREFSTA            = T1-KDREFSTA                                          
  T2-KDFREKKL            = T1-KDFREKKL                                          
  T2-KDPRISKL            = T1-KDPRISKL                                          
  T2-KVAKS-PAV           = T1-KVAKS-PAV                                         
  T2-KVAKS-SDC           = T1-KVAKS-SDC                                         
  T2-KVBEART             = T1-KVBEART                                           
  T2-KVEFRS              = T1-KVEFRS                                            
  T2-KVINVS              = T1-KVINVS                                            
  T2-KVLS                = T1-KVLS                                              
  T2-KVOKS-BULK          = T1-KVOKS-BULK                                        
  T2-KVOKS-DAG           = T1-KVOKS-DAG                                         
  T2-KVROS-BULK          = T1-KVROS-BULK                                        
  T2-KVROS-DAG           = T1-KVROS-DAG                                         
  T2-KVPB-REF            = T1-KVPB-REF                                          
  T2-KVREFBER            = T1-KVREFBER                                          
  T2-KVREFOVL            = T1-KVREFOVL                                          
  T2-KVREFPKT            = T1-KVREFPKT                                          
  T2-KVRETUR-BEORD       = T1-KVRETUR-BEORD                                     
  T2-KVRESS              = T1-KVRESS                                            
  T2-KVSKROT             = T1-KVSKROT                                           
  T2-KVUTRS              = T1-KVUTRS                                            
  T2-PRAVCOST            = T1-PRAVCOST                                          
  T2-TIINVDAT            = T1-TIINVDAT                                          
  T2-TIORDREG            = T1-TIORDREG                                          
  T2-TIREFMPB            = T1-TIREFMPB                                          
  T2-TIREFPAF            = T1-TIREFPAF                                          
  T2-TIREFPKT            = T1-TIREFPKT                                          
  T2-TIREFSTA            = T1-TIREFSTA                                          
  T2-TIREFSTO            = T1-TIREFSTO                                          
  T2-TIRETUR-BEORD       = T1-TIRETUR-BEORD                                     
  T2-TISKROT             = T1-TISKROT                                           
  T2-TISKROT-BEORD       = T1-TISKROT-BEORD                                     
  T2-TISPARR-KVAL        = T1-TISPARR-KVAL                                      
  T2-ADLAGOMR-CD         = T1-ADLAGOMR-CD                                       
  T2-FLCDREL             = T1-FLCDREL                                           
  T2-KVDAGAR-CDBEH       = T1-KVDAGAR-CDBEH                                     
  T2-TIREFEFT            = T1-TIREFEFT                                          
  T2-PRMATRL             = T1-PRMATRL                                           
  T2-KDMATRPR            = T1-KDMATRPR                                          
  T2-KVPALL-CN           = T1-KVPALL-CN                                         
  T2-KVULOAD             = T1-KVULOAD                                           
  T2-KVSLAGER            = T1-KVSLAGER                                          
  T2-TIMANSEC            = T1-TIMANSEC                                          
  T2-KVEOQ               = T1-KVEOQ                                             
  T2-KDOPPLAN            = T1-KDOPPLAN                                          
  T2-KDLEVPLF            = T1-KDLEVPLF                                          
  T2-FLJIT-CN            = T1-FLJIT-CN                                          
  T2-KDLPSP              = T1-KDLPSP                                            
  T2-TILPSP              = T1-TILPSP                                            
  T2-KVPB-PLAN           = T1-KVPB-PLAN                                         
  T2-DAPBPLAN            = T1-DAPBPLAN                                          
  T2-DASEASON            = T1-DASEASON                                          
  T2-KVPB-JUST1          = T1-KVPB-JUST1                                        
  T2-TIPBJUST-1          = T1-TIPBJUST-1                                        
  T2-KVPB-JUST2          = T1-KVPB-JUST2                                        
  T2-TIPBJUST-2          = T1-TIPBJUST-2                                        
  T2-KVPB-TREND          = T1-KVPB-TREND                                        
  T2-KVVECKOR-TREND      = T1-KVVECKOR-TREND                                    
  T2-TIDATUM-TREND       = T1-TIDATUM-TREND                                     
  T2-KVPBREOI            = T1-KVPBREOI                                          
  T2-TIPBREOI            = T1-TIPBREOI                                          
  T2-KDAVT               = T1-KDAVT                                             
  T2-TIREFSTO-LOC        = T1-TIREFSTO-LOC                                      
  T2-IDANSK-CN           = T1-IDANSK-CN                                         
  T2-IDINK-CN            = T1-IDINK-CN                                          
  T2-IDLEVNR-SHIP        = T1-IDLEVNR-SHIP                                      
  T2-IDLEVNR-FRAM        = T1-IDLEVNR-FRAM                                      
  T2-IDLEVNR-SHIP-FRAM   = T1-IDLEVNR-SHIP-FRAM                                 
  T2-TILEVDAT            = T1-TILEVDAT                                          
  T2-IDPLANGR-AG         = T1-IDPLANGR-AG                                       
  T2-KVDAGAR-INLEV       = T1-KVDAGAR-INLEV                                     
  T2-KVVECKOR-LT         = T1-KVVECKOR-LT                                       
  T2-TIMANLED            = T1-TIMANLED                                          
  T2-KVSLUTKP            = T1-KVSLUTKP                                          
  T2-TISLUTKP            = T1-TISLUTKP                                          
  T2-TIERSDAT-VIPS       = T1-TIERSDAT-VIPS                                     
  T2-KVSPANT             = T1-KVSPANT                                           
  T2-VKART-CN            = T1-VKART-CN                                          
  T2-VLARTNTO-CN         = T1-VLARTNTO-CN                                       
  T2-KDARTURS-CN         = T1-KDARTURS-CN                                       
  T2-IDPSN-DC            = T1-IDPSN-DC                                          
                                                                                
  INDX = 1                                                                      
  DO WHILE INDX LE INDX-MAX                                                     
    T2-RESEASON(INDX)     = T1-RESEASON(INDX)                                   
    T2-RESEASON-PLAN (INDX) = T1-RESEASON-PLAN(INDX)                            
    IF INDX < 6                                                                 
      T2-TILEVDAG(INDX)     = T1-TILEVDAG(INDX)                                 
    END-IF                                                                      
    INDX = INDX + 1                                                             
  END-DO                                                                        
                                                                                
  T2-KVOI-FOREG(1)       = T1-KVOI-FOREG(1)                                     
  T2-KVOI-FOREG(2)       = T1-KVOI-FOREG(2)                                     
  T2-KVOI-CDC-RULL       = T1-KVOI-CDC-RULL                                     
  T2-KVOI-RULL           = T1-KVOI-RULL                                         
  T2-KVOT-CDC-RULL       = T1-KVOT-CDC-RULL                                     
  T2-KVOT-NDC-RULL       = T1-KVOT-NDC-RULL                                     
  T2-KVOT-NDC-INNEV      = T1-KVOT-NDC-INNEV                                    
  T2-KVOT-RULL           = T1-KVOT-RULL                                         
  T2-KVOT-REF-RULL       = T1-KVOT-REF-RULL                                     
  T2-KVOT-MISS-INNEV     = T1-KVOT-MISS-INNEV                                   
  T2-KVOT-MISS-RULL      = T1-KVOT-MISS-RULL                                    
  T2-KVOI-INNEV          = T1-KVOI-INNEV                                        
  T2-KVOI-IAAR           = T1-KVOI-IAAR                                         
  T2-TIINLINL            = T1-TIINLINL                                          
  INDX = 1                                                                      
  DO WHILE INDX LE INDX-MAX                                                     
    T2-KVOI-RP(INDX)     = T1-KVOI-RP(INDX)                                     
    T2-KVOI-REF-RP(INDX) = T1-KVOI-REF-RP(INDX)                                 
    INDX = INDX + 1                                                             
  END-DO                                                                        
END-PROC                                                                        
