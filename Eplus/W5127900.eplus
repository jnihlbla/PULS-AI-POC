                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5127900                                              *        
*                                                                      *        
*  FUNKTION   :  STOCK REPORT                                          *        
*                                                                      *        
*  FÖRFATTARE :  BARSHARANI BISHOYE                                    *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W51279D1                                                                   
*                                                                               
%W51261  'LB-'                                                                  
*                                                                               
FILE TPFIL1  FB(53 0)                                                           
*                                                                               
%W51261  'T1-'                                                                  
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W51279D2 PRINTER VB(150 0)                                                 
*                                                                               
UT-IDARTNR       W   9   N   0 MASK 'ZZZZZZZZ9'  VALUE 0                        
UT-IDDC          W   2   A                                                      
UT-PRARTSTD      W   9   N   2 MASK 'ZZZZZZ9.99' VALUE 0                        
UT-KDPRODSL      W   3   N   0 MASK 'ZZ9'        VALUE 0                        
UT-KVRESS        W   9   N   0 MASK '--------9'  VALUE 0                        
UT-KVAKS-PAV     W   9   N   0 MASK 'ZZZZZZZZ9'  VALUE 0                        
UT-KVLS          W   9   N   0 MASK 'ZZZZZZZZ9'  VALUE 0                        
UT-KVAKS         W   9   N   0 MASK 'ZZZZZZZZ9'  VALUE 0                        
UT-KVEFRS        W   9   N   0 MASK 'ZZZZZZZZ9'  VALUE 0                        
UT-KDERS         W   7   N   0 MASK 'ZZZZZZ9'    VALUE 0                        
UT-SEMICOLON     W   1   A                       VALUE ';'                      
*                                                                               
****WORKING STORAGE SECTION                                                     
FIRST-LINE        S   1   A  VALUE 'J'                                          
*-----------------------------------------------------------------*             
* STEG 1  SORT FILE ON PART NUMBER AND DC                         *             
*                                                                 *             
*-----------------------------------------------------------------*             
SORT W51279D1 TO TPFIL1 USING (LB-IDARTNR LB-IDDC) SIZE 2500000                 
JOB INPUT (TPFIL1 KEY(T1-IDARTNR))                                              
                                                                                
   UT-IDARTNR    = T1-IDARTNR                                                   
   UT-IDDC       = T1-IDDC                                                      
   UT-PRARTSTD   = T1-PRARTSTD                                                  
   UT-KDPRODSL   = T1-KDPRODSL                                                  
   UT-KDERS      = T1-KDERS                                                     
   UT-KVRESS     = T1-KVRESS                                                    
   UT-KVAKS-PAV  = T1-KVAKS-PAV                                                 
   UT-KVLS       = T1-KVLS                                                      
   UT-KVAKS      = T1-KVAKS                                                     
   UT-KVEFRS     = T1-KVEFRS                                                    
   IF T1-KVRESS        NE  0                                                    
     PRINT REPORT1                                                              
   ELSE                                                                         
     IF T1-KVAKS-PAV   NE  0                                                    
       PRINT REPORT1                                                            
     ELSE                                                                       
       IF T1-KVAKS     NE  0                                                    
         PRINT REPORT1                                                          
       ELSE                                                                     
         IF T1-KVEFRS  NE  0                                                    
           PRINT REPORT1                                                        
         ELSE                                                                   
           IF T1-KVLS  NE  0                                                    
             PRINT REPORT1                                                      
           END-IF                                                               
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
   END-IF                                                                       
 NEWPAGE                                                                        
   REPORT   REPORT1             +                                               
            PRINTER W51279D2    +                                               
            PAGESIZE 32000      +                                               
            LINESIZE 145        +                                               
            SPACE 0             +                                               
            NOHEADING           +                                               
            NOSPREAD            +                                               
            NOADJUST            +                                               
            NOPAGE              +                                               
            NODATE                                                              
   LINE 1   UT-IDARTNR          +                                               
            UT-SEMICOLON        +                                               
            UT-IDDC             +                                               
            UT-SEMICOLON        +                                               
            UT-PRARTSTD         +                                               
            UT-SEMICOLON        +                                               
            UT-KDPRODSL         +                                               
            UT-SEMICOLON        +                                               
            UT-KVAKS-PAV        +                                               
            UT-SEMICOLON        +                                               
            UT-KVAKS            +                                               
            UT-SEMICOLON        +                                               
            UT-KVLS             +                                               
            UT-SEMICOLON        +                                               
            UT-KVEFRS           +                                               
            UT-SEMICOLON        +                                               
            UT-KVRESS           +                                               
            UT-SEMICOLON        +                                               
            UT-KDERS                                                            
*                                                                               
BEFORE-LINE. PROC                                                               
  IF FIRST-LINE = 'J'                                                           
    DISPLAY '¤DAPW51279-001'                                                    
    DISPLAY '¤DAPW51279'                                                        
    DISPLAY 'PART NUMBER;DC;STANDARD PRICE;PRODUCT GROUP;'    +                 
            'QUANTITY-GIT;ADVICE BALANCE;STOCK BALANCE;'      +                 
            'NOT INVOICED QTY;QUANTITY-RESERVED;SUPERSESSION CODE;'             
                                                                                
    FIRST-LINE  = 'N'                                                           
  END-IF                                                                        
END-PROC                                                                        
