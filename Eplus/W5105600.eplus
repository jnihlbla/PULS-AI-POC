                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W510   ANALYSER                                       *        
*                                                                      *        
*  FUNKTION   :  LÄSER ALLA ARTIKLAR SOM HAR FORD-LEVERANTÖR SOM HUVUD-*        
*                LEVERANTÖR. FÖR ALLA DESSA ARTIKLAR SKAPA LISTA       *        
*                MED ANTAL PÅ ALLA DC:N SAMT SUMMA STANDARDPRIS.       *        
*                                                                      *        
*  FÖRFATTARE :  KARL JOHAN HANSSON                                    *        
*                                                                      *        
*  INFILER    :  W510.W510D4.W51053(+0) OCH W011.W01172(+0)            *        
*                                                                      *        
*  UTFILER    :  W51056, LISTA MED ALLA FORD-ARTIKLAR                  *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W51056D1                                                                   
%W51054   'I1-'                                                                 
                                                                                
FILE TPFIL1 FB(46 0)                                                            
%W51054   'T1-'                                                                 
                                                                                
FILE W51056D2                                                                   
%W011100  'I2-'                                                                 
                                                                                
FILE W51056D3 VB(50 0)                                                          
UT-AREA           1 46  A                                                       
UT-IDARTNR        2  9  N                                                       
UT-FILLER1       11  1  A                                                       
UT-IDLEVNR       12  5  A                                                       
UT-FILLER2       17  1  A                                                       
UT-KVANTAL       18  7  N                                                       
UT-FILLER3       25  1  A                                                       
UT-PRARTSTD-H    26  7  N                                                       
UT-PRARTSTD-K    33  1  A                                                       
UT-PRARTSTD-D    34  2  N                                                       
UT-FILLER4       36  1  A                                                       
UT-SUARTSTD-H    37  7  N                                                       
UT-SUARTSTD-K    44  1  A                                                       
UT-SUARTSTD-D    45  2  N                                                       
                                                                                
****  WORKAREA                                                                  
 W-ANTAL   W  5  P 0                                                            
 W-TAB     W  1  A  VALUE X'05'                                                 
                                                                                
 W-PRARTSTD      W  9  N  2                                                     
 W-PRARTSTD-H  W-PRARTSTD      7 N                                              
 W-PRARTSTD-D  W-PRARTSTD  +7  2 N                                              
                                                                                
 W-SUARTSTD      W  9  N  2                                                     
 W-SUARTSTD-H  W-SUARTSTD      7 N                                              
 W-SUARTSTD-D  W-SUARTSTD  +7  2 N                                              
NEWPAGE                                                                         
***************                                                                 
*  JOBBSTEG1  *                                                                 
***************                                                                 
                                                                                
SORT W51056D1 TO TPFIL1 USING (I1-IDARTNR) SIZE 800000                          
                                                                                
***************                                                                 
*  JOBBSTEG2  *                                                                 
***************                                                                 
                                                                                
JOB INPUT (W51056D2 KEY(I2-IDARTNR) TPFIL1 KEY(T1-IDARTNR)) +                   
          START A-INIT                                                          
 IF MATCHED                                                                     
   IF I2-IDLEVNR EQ  '0096A' '25744' 'BVT8A' '14315' '0146A' '6651C' +          
     '0115A' '26194' 'CC05A' '16105' '0132A' '3151A' 'FM00B' '18640' +          
     '0132D' '5461 ' 'TC12A' '2202A' '0132E' '5481 ' '0095A' '24039' +          
     '0097A'                                                                    
                                                                                
     IF FIRST-DUP TPFIL1 OR NOT DUPLICATE TPFIL1                                
       W-ANTAL = I2-KVAKS-CDC + I2-KVAKS-PAV + I2-KVLS + I2-KVEFRS + +          
                I2-KVAKS-T                                                      
     END-IF                                                                     
                                                                                
     W-ANTAL = W-ANTAL + T1-KVAKS + T1-KVAKS-PAV + T1-KVEFRS + T1-KVLS          
                                                                                
     IF LAST-DUP TPFIL1 OR NOT DUPLICATE TPFIL1                                 
       PERFORM SKRIV-UTPOST                                                     
     END-IF                                                                     
   END-IF                                                                       
 ELSE                                                                           
  IF W51056D2                                                                   
   IF I2-IDLEVNR EQ  '0096A' '25744' 'BVT8A' '14315' '0146A' '6651C' +          
     '0115A' '26194' 'CC05A' '16105' '0132A' '3151A' 'FM00B' '18640' +          
     '0132D' '5461 ' 'TC12A' '2202A' '0132E' '5481 ' '0095A' '24039' +          
     '0097A'                                                                    
      W-ANTAL =                                                      +          
        I2-KVAKS-T + I2-KVAKS-CDC + I2-KVAKS-PAV + I2-KVLS  + I2-KVEFRS         
      PERFORM SKRIV-UTPOST                                                      
   END-IF                                                                       
  END-IF                                                                        
 END-IF                                                                         
                                                                                
 A-INIT. PROC                                                                   
***  OBS MELLAN DELRUBRIKERNA FINNS AVGRÄNSARE X'05' (W-TAB)                    
   UT-AREA = 'ARTNR	LEVNR	ANTAL	STDPRIS	SUMMA STDPRIS'                          
   PUT W51056D3                                                                 
   UT-AREA = ' '                                                                
 END-PROC                                                                       
                                                                                
 SKRIV-UTPOST. PROC                                                             
   W-SUARTSTD        = W-ANTAL * I2-PRARTSTD                                    
   IF W-SUARTSTD NE 0                                                           
     UT-IDARTNR      = I2-IDARTNR                                               
     UT-FILLER1      = W-TAB                                                    
     UT-IDLEVNR      = I2-IDLEVNR                                               
     UT-FILLER2      = W-TAB                                                    
     W-PRARTSTD      = I2-PRARTSTD                                              
     UT-PRARTSTD-H   = W-PRARTSTD-H                                             
     UT-PRARTSTD-K   = ','                                                      
     UT-PRARTSTD-D   = W-PRARTSTD-D                                             
     UT-FILLER3      = W-TAB                                                    
     UT-KVANTAL      = W-ANTAL                                                  
     UT-FILLER4      = W-TAB                                                    
     UT-SUARTSTD-H   = W-SUARTSTD-H                                             
     UT-SUARTSTD-K   = ','                                                      
     UT-SUARTSTD-D   = W-SUARTSTD-D                                             
     PUT W51056D3                                                               
   END-IF                                                                       
 END-PROC                                                                       
