                                                                                
******************************************************************              
*                                                                               
* PROGRAM     : W5510500.                                                       
*                                                                               
* FUNKTION    : AVSTÄMNINGSLISTOR FÖR PRISSÄTTNING AV KALKYLPÅLÄGG              
*                                                                               
*          INFILER     W55105D1 FILER MED PÅLÄGG AVSEDD FÖR SPIS                
*                      W55105D2 ARTIKELINFO                                     
*                                                                               
*          W55105-010  KALKYLPÅLÄGG FÖRÄNDRAT MER ÄN 40 %                       
*                                                                               
* FÖRFATTARE  : INGER NILSSON                                                   
* DATUM       : 900920                                                          
*                                                                               
******************************************************************              
NEWPAGE                                                                         
FILE W55105D1                                                                   
%W55124   'IND1-'                                                               
NEWPAGE                                                                         
FILE W55105D2                                                                   
%W55159   'IN-'                                                                 
NEWPAGE                                                                         
FILE TEMPFIL1 FB(19 0)                                                          
%W55124   'T1-'                                                                 
                                                                                
FILE TEMPFIL2 FB(54 0)                                                          
T2-IDARTNR           1  5 P 0                                                   
T2-BEFT              6  2 P 0                                                   
T2-KDVTH-NY          8  1 P 0                                                   
T2-KDPRODSL          9  2 P 0                                                   
T2-PRDIRLON          11 4 P 3                                                   
T2-PRDMTRL           15 5 P 3                                                   
T2-PROVRPAL          20 4 P 3                                                   
T2-PRDIRLON-NY       24 4 P 3                                                   
T2-PRDMTRL-NY        28 5 P 3                                                   
T2-PROVRPAL-NY       33 4 P 3                                                   
T2-KVBEHOVAR         37 4 P 0                                                   
T2-FILLER1           41 4 P 1                                                   
T2-AK-LS-EFR         45 5 P 0                                                   
T2-FILLER2           50 5 P 0                                                   
NEWPAGE                                                                         
FILE TEMPFIL3 FB(48 0)                                                          
T3-IDARTNR           1  5 P                                                     
T3-KDVTH             6  1 P 0                                                   
T3-KDVTH-NY          7  1 P 0                                                   
T3-PRDIRLON          8  4 P 3                                                   
T3-PRDMTRL           12 5 P 3                                                   
T3-PROVRPAL          17 4 P 3                                                   
T3-PRDIRLON-NY       21 4 P 3                                                   
T3-PRDMTRL-NY        25 5 P 3                                                   
T3-PROVRPAL-NY       30 4 P 3                                                   
T3-DL-PROC           34 5 P 3                                                   
T3-DM-PROC           39 5 P 3                                                   
T3-OVP-PROC          44 5 P 3                                                   
NEWPAGE                                                                         
FILE W55105D3 PRINTER VB(200 0)                                                 
                                                                                
NEWPAGE                                                                         
W-IDARTNR                        W  9 N 0   MASK 'ZZZZZZZZ9'                    
W-IDLEVNR                        W  5 A                                         
W-BEFT                           W  3 N     MASK ('ZZ9')                        
W-KDVTH-NY                       W  1 N                                         
W-KDPRODSL                       W  3 N     MASK ('ZZ9')                        
W-PRDIRLON                       W 11 N 3   MASK 'ZZZZZZZ9.999'                 
W-PRDMTRL                        W 11 N 3   MASK 'ZZZZZZZ9.999'                 
W-PROVRPAL                       W 11 N 3   MASK 'ZZZZZZZ9.999'                 
W-PRDIRLON-NY                    W 11 N 3   MASK 'ZZZZZZZ9.999'                 
W-PRDMTRL-NY                     W 11 N 3   MASK 'ZZZZZZZ9.999'                 
W-PROVRPAL-NY                    W 11 N 3   MASK 'ZZZZZZZ9.999'                 
W-AK-LS-EFR                      W  9 N 0                                       
W-KVBEHOVAR-TOT                  W  9 N 0                                       
W-DM-PROC                        W  5 N 0   MASK ('----9')                      
W-DL-PROC                        W  5 N 0   MASK ('----9')                      
W-OVP-PROC                       W  5 N 0   MASK ('----9')                      
W-PALAGG-TOT                     W 11 N 3                                       
W-PALAGG-NY-TOT                  W 11 N 3                                       
W-PALAGG-TOT-PROC                W 13 N 0   MASK ('------------9')              
W-DATUM                          W  8 A                                         
JA                               W  1 A     VALUE 'J'                           
NEJ                              W  1 A     VALUE 'N'                           
W-FIRST-TIME                     W  1 A     VALUE 'J'                           
W-SEM1                           W  1 A     VALUE ';'                           
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - -   *                 
*  STEG 1   SORTERA INPOSTERNA (KALKYLPÅLÄGGSPOSTER FÖR W551B1)                 
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - -   *                 
                                                                                
SORT W55105D1 TO TEMPFIL1 USING (IND1-IDARTNR)                                  
                                                                                
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - *                   
*  STEG 2   MATCHA PÅLÄGGSPOSTER OCH ARTIKELINFO                                
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - *                   
                                                                                
JOB INPUT (TEMPFIL1 KEY T1-IDARTNR W55105D2 KEY IN-IDARTNR) +                   
           START A-INIT NAME AKT002                                             
                                                                                
    IF MATCHED                                                                  
       T2-IDARTNR           = IN-IDARTNR                                        
       T2-BEFT              = IN-BEFT                                           
       T2-KDVTH-NY          = T1-KDVTH                                          
       T2-KDPRODSL          = IN-KDPRODSL                                       
       T2-PRDIRLON          = IN-PRDIRLON                                       
       T2-PRDMTRL           = IN-PRDMTRL                                        
       T2-PROVRPAL          = IN-PROVRPAL                                       
       T2-PRDIRLON-NY       = T1-PRDIRLON                                       
       T2-PRDMTRL-NY        = T1-PRDMTRL                                        
       T2-PROVRPAL-NY       = T1-PROVRPAL                                       
       T2-KVBEHOVAR         = IN-KVBEHOVAR                                      
       T2-AK-LS-EFR         = IN-KVLS                                           
       PUT TEMPFIL2                                                             
                                                                                
       IF IN-PRDIRLON = +0 OR T1-PRDIRLON = +0                                  
          W-DL-PROC = +0                                                        
       ELSE                                                                     
         W-DL-PROC  =                                         +                 
           ((T1-PRDIRLON - IN-PRDIRLON) * 100) / IN-PRDIRLON                    
       END-IF                                                                   
                                                                                
       IF IN-PRDMTRL = +0 OR T1-PRDMTRL = +0                                    
          W-DM-PROC = +0                                                        
       ELSE                                                                     
         W-DM-PROC  =                                         +                 
           ((T1-PRDMTRL - IN-PRDMTRL) * 100) / IN-PRDMTRL                       
       END-IF                                                                   
                                                                                
       IF IN-PROVRPAL = +0 OR T1-PROVRPAL = +0                                  
          W-OVP-PROC = +0                                                       
       ELSE                                                                     
         W-OVP-PROC =                                         +                 
           ((T1-PROVRPAL - IN-PROVRPAL) * 100) / IN-PROVRPAL                    
       END-IF                                                                   
                                                                                
       IF W-DL-PROC  > +40 +                                                    
       OR W-DM-PROC  > +40 +                                                    
       OR W-OVP-PROC > +40                                                      
          T3-IDARTNR           = IN-IDARTNR                                     
          T3-KDVTH             = IN-KDVTH                                       
          T3-KDVTH-NY          = T1-KDVTH                                       
          T3-PRDIRLON          = IN-PRDIRLON                                    
          T3-PRDIRLON-NY       = T1-PRDIRLON                                    
          T3-DL-PROC           = W-DL-PROC                                      
          T3-PRDMTRL           = IN-PRDMTRL                                     
          T3-PRDMTRL-NY        = T1-PRDMTRL                                     
          T3-DM-PROC           = W-DM-PROC                                      
          T3-PROVRPAL          = IN-PROVRPAL                                    
          T3-PROVRPAL-NY       = T1-PROVRPAL                                    
          T3-OVP-PROC          = W-OVP-PROC                                     
          PUT TEMPFIL3                                                          
       END-IF                                                                   
    END-IF                                                                      
A-INIT.  PROC                                                                   
    MOVE SYSDATE TO W-DATUM                                                     
END-PROC                                                                        
NEWPAGE                                                                         
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - *                   
*  STEG 3                                                                       
*  SKAPA LISTA W55105-010 ÖVER:                                                 
*  KALKYLPÅLÄGG SOM ÖKAT MER ÄN 40 %                                            
* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - *                   
                                                                                
JOB INPUT TEMPFIL3 NAME AKT003                                                  
                                                                                
   IF T3-PRDIRLON > +0 +                                                        
   OR T3-PRDMTRL    > +0 +                                                      
   OR T3-PROVRPAL > +0                                                          
     W-PALAGG-TOT-PROC =                                        +               
      (((T3-PRDIRLON-NY + T3-PRDMTRL-NY + T3-PROVRPAL-NY) +                     
      - (T3-PRDIRLON + T3-PRDMTRL + T3-PROVRPAL))               +               
        * 100) / (T3-PRDIRLON + T3-PRDMTRL + T3-PROVRPAL)                       
   ELSE                                                                         
      W-PALAGG-TOT-PROC  = +0                                                   
   END-IF                                                                       
                                                                                
   W-IDARTNR           = T3-IDARTNR                                             
   W-PRDIRLON          = T3-PRDIRLON                                            
   W-PRDIRLON-NY       = T3-PRDIRLON-NY                                         
   W-PRDMTRL           = T3-PRDMTRL                                             
   W-PRDMTRL-NY        = T3-PRDMTRL-NY                                          
   W-PROVRPAL          = T3-PROVRPAL                                            
   W-PROVRPAL-NY       = T3-PROVRPAL-NY                                         
   W-DL-PROC           = T3-DL-PROC                                             
   W-DM-PROC           = T3-DM-PROC                                             
   W-OVP-PROC          = T3-OVP-PROC                                            
   PRINT LISTA10                                                                
                                                                                
NEWPAGE                                                                         
  REPORT   LISTA10              +                                               
           PRINTER W55105D3     +                                               
           LINESIZE 195         +                                               
           SPACE 0              +                                               
           NOHEADING            +                                               
           NOSPREAD             +                                               
           NOADJUST             +                                               
           PAGESIZE 9999        +                                               
           NODATE                                                               
  LINE  1  W-IDARTNR            +                                               
           W-SEM1               +                                               
           W-PRDIRLON           +                                               
           W-SEM1               +                                               
           W-PRDIRLON-NY        +                                               
           W-SEM1               +                                               
           W-DL-PROC            +                                               
           W-SEM1               +                                               
           W-PRDMTRL            +                                               
           W-SEM1               +                                               
           W-PRDMTRL-NY         +                                               
           W-SEM1               +                                               
           W-DM-PROC            +                                               
           W-SEM1               +                                               
           W-PROVRPAL           +                                               
           W-SEM1               +                                               
           W-PROVRPAL-NY        +                                               
           W-SEM1               +                                               
           W-OVP-PROC           +                                               
           W-SEM1               +                                               
           W-PALAGG-TOT-PROC    +                                               
           W-SEM1                                                               
*                                                                               
BEFORE-LINE. PROC                                                               
 IF W-FIRST-TIME = 'J'                                                          
   DISPLAY '¤DAPW55105-010'                                                     
   DISPLAY '¤DAPW55105'                                                         
   DISPLAY 'PART NUMBER;SALARY THIS YEAR;SALARY NEXT YEAR;CHANGE'    +          
           ' SALARY(%);MATERIAL THIS YEAR;MATERIAL NEXT YEAR;CHANGE' +          
           ' MATERIAL(%);OTHER THIS YEAR;OTHER NEXT YEAR;CHANGE'     +          
           ' OTHER(%);TOTAL CHANGE(%);'                                         
   W-FIRST-TIME = 'N'                                                           
 END-IF                                                                         
END-PROC                                                                        
