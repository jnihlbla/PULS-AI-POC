         COL 031  'RESTORDER - RADER'              +                            
         COL 055  'SEKTION'                        +                            
         COL 067  W-RUB-SEKT-INTERVALL             +                            
         COL 076  W-SPAR-TESEKT                    +                            
         COL 092  'ANSKAFFARE'                     +                            
         COL 104  W-RUB-GRUPP-INTERVALL                                         
                                                                                
TITLE 3  '    '                                                                 
                                                                                
TITLE 4  COL 023 'R E S T O R D E R I N F O'       +                            
         COL 063 'A N K O M S T I N F O'                                        
                                                                                
TITLE 5  '    '                                                                 
                                                                                
TITLE 6  COL 002  'AN'                       +                                  
         COL 009  'ARTNR'                    +                                  
         COL 015  'LEVNR'                    +                                  
         COL 031  'VÄRDE'                    +                                  
         COL 038  'RADER'                    +                                  
         COL 046  'ANTAL'                    +                                  
         COL 053  'ÅÅVV'                     +                                  
         COL 071  'VÄRDE'                    +                                  
