         COL 097  'PÅ'                       +                                  
         COL 104  'AVS-V'                    +                                  
         COL 112  'ANTAL'                                                       
                                                                                
TITLE 7  COL 002  'SK'                       +                                  
         COL 078  'LAGER'                    +                                  
         COL 086  'MINAL'                    +                                  
         COL 096  'VÄG'                      +                                  
         COL 105  'ÅÅVV'                                                        
                                                                                
                                                                                
LINE 01  COL 001  W-SPAR-IDANSK                +                                
         COL 005  W-UT-IDARTNR                 +                                
         COL 015  W-UT-IDLEVNR                 +                                
         COL 023  W-UT-SUROBEL                 +                                
         COL 036  W-UT-KVRORAD                 +                                
         COL 044  W-UT-KVROS                   +                                
         COL 052  W-UT-TIRODAT-ORDER           +                                
         COL 063  W-UT-SUAKBEL                 +                                
         COL 076  W-UT-KVAKS-CDC               +                                
         COL 084  W-UT-KVAKS-T                 +                                
         COL 092  W-UT-KVAKS-PAV               +                                
         COL 105  W-UT-TIAVIDAT-1              +                                
         COL 110  W-UT-KVAVIS-1                                                 
                                                                                
AFTER-LINE. PROC                                                                
  IF IN-TIAVIDAT-LEVBESK-2 > 0                                                  
     DISPLAY COL 105 W-UT-TIAVIDAT-2 COL 110 W-UT-KVAVIS-2                      
     IF IN-TIAVIDAT-LEVBESK-3 > 0                                               
        DISPLAY COL 105 W-UT-TIAVIDAT-3 COL 110 W-UT-KVAVIS-3                   
     END-IF                                                                     
  END-IF                                                                        
  DISPLAY '   '                                                                 
END-PROC                                                                        
                                                                                
