*                                                                      *        
*  PROGRAM    :  W2252400                                              *        
*                                                                      *        
*  FUNKTION   :  SKAPAR RESTORDERLISTA RADER                           *        
*                                                                      *        
*  FÖRFATTARE :  STEFAN KIHLBERG                                       *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W22524D1                                                                   
*                                                                               
****************                                                                
* COPYTEXT     *                                                                
****************                                                                
%W22524    'IN-'                                                                
                                                                                
%W009W42   'SUB-'                                                               
                                                                                
FILE W22524D2  PRINTER FB (121 121)                                             
                                                                                
FILE W22524D3  PRINTER FB (121 121)                                             
                                                                                
FILE W22524D4  PRINTER FB (121 121)                                             
                                                                                
*****************                                                               
* ARBETSAREOR   *                                                               
*****************                                                               
                                                                                
W-FL-FIRST-ARTIKEL      W    1   A   VALUE 'J'                                  
                                                                                
W-SPAR-IDANSK           W    2   P                                              
W-SPAR-IDARTNR          W    5   P                                              
W-SPAR-TESEKT           W    8   A                                              
W-SPAR-GRUPP-INTERVALL  W    7   A                                              
W-SPAR-SEKT-INTERVALL   W    7   A                                              
                                                                                
W-RUB-IDANSK            W    3   N            MASK (D '999')                    
W-RUB-GRUPP-INTERVALL   W    7   A                                              
W-RUB-SEKT-INTERVALL    W    7   A                                              
                                                                                
                                                                                
W-UT-IDARTNR            W    9   N            MASK (B 'ZZZZZZZZ9')              
W-UT-IDLEVNR            W    5   A                                              
W-UT-SUROBEL            W    9   N  2         MASK (E 'ZZZZZZ9,99-')            
W-UT-KVRORAD            W    7   N            MASK (F 'ZZZZZZ9')                
W-UT-KVROS              W    7   N            MASK F                            
W-UT-TIRODAT-ORDER      W    5   N            MASK (C 'ZZZZ9')                  
W-UT-SUAKBEL            W    9   N  2         MASK E                            
W-UT-KVAKS-CDC          W    7   N            MASK F                            
W-UT-KVAKS-T            W    7   N            MASK F                            
W-UT-KVAKS-PAV          W    7   N            MASK F                            
W-UT-KVAVIS-1           W    7   N            MASK (H 'ZZZZZZZ')                
W-UT-KVAVIS-2           W    7   N            MASK H                            
W-UT-KVAVIS-3           W    7   N            MASK H                            
W-UT-TIAVIDAT-1         W    4   N            MASK (G 'ZZZZ')                   
W-UT-TIAVIDAT-2         W    4   N            MASK G                            
W-UT-TIAVIDAT-3         W    4   N            MASK G                            
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
                                                                                
*****************                                                               
* JOB           *                                                               
*****************                                                               
                                                                                
JOB INPUT W22524D1 +                                                            
                                                                                
                                                                                
  IF W-FL-FIRST-ARTIKEL = 'J'                                                   
     MOVE 'N' TO W-FL-FIRST-ARTIKEL                                             
     SUB-IDANSK         =  IN-IDANSK                                            
     W-SPAR-IDANSK      =  IN-IDANSK                                            
     W-RUB-IDANSK       =  IN-IDANSK                                            
     CALL W200ANSK USING SUB-W009W42                                            
     W-SPAR-TESEKT           = SUB-TESEKT                                       
     W-SPAR-GRUPP-INTERVALL  = SUB-GRUPP-INTERVALL                              
     W-RUB-GRUPP-INTERVALL   = SUB-GRUPP-INTERVALL                              
     W-SPAR-SEKT-INTERVALL   = SUB-SEKT-INTERVALL                               
     W-RUB-SEKT-INTERVALL    = SUB-SEKT-INTERVALL                               
  ELSE                                                                          
     IF W-SPAR-IDANSK NE    IN-IDANSK                                           
        SUB-IDANSK         =  IN-IDANSK                                         
        W-SPAR-IDANSK      =  IN-IDANSK                                         
        W-RUB-IDANSK       =  IN-IDANSK                                         
        CALL W200ANSK USING SUB-W009W42                                         
        W-SPAR-TESEKT           = SUB-TESEKT                                    
        W-SPAR-GRUPP-INTERVALL  = SUB-GRUPP-INTERVALL                           
        W-RUB-GRUPP-INTERVALL   = SUB-GRUPP-INTERVALL                           
        W-SPAR-SEKT-INTERVALL   = SUB-SEKT-INTERVALL                            
        W-RUB-SEKT-INTERVALL    = SUB-SEKT-INTERVALL                            
     END-IF                                                                     
  END-IF                                                                        
                                                                                
  IF IN-KVRORAD > 10 OR (IN-IDANSK = 800 THRU 899) OR                 +         
                        (IN-IDANSK = 930 THRU 999)                              
     IF IN-IDANSK < 050                                                         
        PERFORM FLYTTA-UTFALT                                                   
        PRINT SEKTION                                                           
        PRINT ANSK-GRUPP                                                        
        PRINT ANSKAFFARE                                                        
     END-IF                                                                     
     IF IN-IDANSK > 499                                                         
        PERFORM FLYTTA-UTFALT                                                   
        PRINT SEKTION                                                           
        PRINT ANSK-GRUPP                                                        
        PRINT ANSKAFFARE                                                        
     END-IF                                                                     
  END-IF                                                                        
                                                                                
  FLYTTA-UTFALT. PROC                                                           
                                                                                
  W-UT-IDARTNR            =     IN-IDARTNR                                      
  W-SPAR-IDARTNR          =     IN-IDARTNR                                      
  W-UT-IDLEVNR            =     IN-IDLEVNR                                      
  W-UT-SUROBEL            =     IN-SUROBEL                                      
  W-UT-KVRORAD            =     IN-KVRORAD                                      
  W-UT-KVROS              =     IN-KVROS                                        
  W-UT-TIRODAT-ORDER      =     IN-TIRODAT-ORDER                                
  W-UT-SUAKBEL            =     IN-SUAKBEL                                      
  W-UT-KVAKS-CDC          =     IN-KVAKS-CDC                                    
  W-UT-KVAKS-T            =     IN-KVAKS-T                                      
  W-UT-KVAKS-PAV          =     IN-KVAKS-PAV                                    
  W-UT-KVAVIS-1           =     IN-KVAVIS-LEVBESK-1                             
  W-UT-KVAVIS-2           =     IN-KVAVIS-LEVBESK-2                             
  W-UT-KVAVIS-3           =     IN-KVAVIS-LEVBESK-3                             
  W-UT-TIAVIDAT-1         =     IN-TIAVIDAT-LEVBESK-1                           
  W-UT-TIAVIDAT-2         =     IN-TIAVIDAT-LEVBESK-2                           
  W-UT-TIAVIDAT-3         =     IN-TIAVIDAT-LEVBESK-3                           
  END-PROC                                                                      
                                                                                
