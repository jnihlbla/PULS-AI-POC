*                                                                      *        
*  INFILER    : -W510.W510D4.W51053                                    *        
*               -W510.W510D4.W51054                                    *        
*               -W510.W500M1.W51058 (BACKNINGSFIL SALDO TILL MIDNATT)  *        
*               -W011.W01172        (ARTIKELREG-UPPGIFTER)             *        
*                                                                      *        
*  UTDATA     :  EXCELFIL W51205                                       *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W51204D1                                                                   
%W51054  '54-'                                                                  
                                                                                
FILE W51204D2                                                                   
%W011100 'LB-'                                                                  
                                                                                
*---------------------------------------------*                                 
*TEMPFIL FÖR SORTADE ARTIKELFILER             *                                 
*---------------------------------------------*                                 
FILE TPFIL1 FB(56 0)                                                            
%W51054  'T1-'                                                                  
                                                                                
*---------------------------------------------*                                 
* TEMPFIL MED DIVERSE LISTTRANSAR, EJ SUMMERADE                                 
*---------------------------------------------*                                 
FILE TPFIL2 FB(11 0)                                                            
T2-AREA            1 11 A                                                       
T2-IDDC            1 2 A                                                        
T2-KDPRODSL        3 2 P                                                        
T2-SUSTD           5 7 P 2                                                      
                                                                                
****** EXCELENS UTFIL                                                           
FILE W51204D3 VB(55 0)                                                          
UTAREA         1 55 A                                                           
                                                                                
****** EXCELENS 2:A TOM X:TE RAD                                                
UT-AREA        W 55 A                                                           
UT-IDDC     UT-AREA     2  A                                                    
FILL01      UT-AREA +2  1  A  VALUE ';'                                         
UT-KDPRODSL UT-AREA +3  2  A                                                    
FILL02      UT-AREA +5  1  A  VALUE ';'                                         
UT-TEXT     UT-AREA +6  30 A                                                    
FILL03      UT-AREA +36 1  A  VALUE ';'                                         
UT-SUMMA    UT-AREA +37 13 N 2                                                  
FILL04      UT-AREA +50 1  A  VALUE ';'                                         
                                                                                
****** EXCELENS FÖRSTA RAD                                                      
W-EXCEL-RUB1             W  23  A                                               
RUB-TEXT    W-EXCEL-RUB1     6  A VALUE 'DATUM '                                
RUB-DATUM   W-EXCEL-RUB1 +6  6  N                                               
RUB-FILL01  W-EXCEL-RUB1 +12 1  A VALUE ';'                                     
RUB-FILL02  W-EXCEL-RUB1 +13 7  A VALUE 'PERIOD '                               
RUB-MÅNAD   W-EXCEL-RUB1 +20 2  N                                               
RUB-FILL03  W-EXCEL-RUB1 +22 1  A VALUE ';'                                     
                                                                                
%WDATKORT                                                                       
                                                                                
*-------------*                                                                 
* ARBETSAREOR *                                                                 
*-------------*                                                                 
W-IDDC           W   2 A                                                        
W-KDPRODSL       W   2 N                                                        
W-SUSTD          W   8 P 2  MASK ('ZZZZZZZZZZZ99.99-')                          
W-KVANTAL        W   5   P   0                                                  
IX               W   2   P   0                                                  
                                                                                
PROGRAM-NAMN     W   6   A  VALUE 'W51204'                                      
DATUMKORT-ID     W   6   A  VALUE 'WDATUM'                                      
                                                                                
W-AAMMDD         W   6   N                                                      
W-AA   W-AAMMDD      2   N                                                      
W-MM   W-AAMMDD  +2  2   N                                                      
W-DD   W-AAMMDD  +4  2   N                                                      
                                                                                
BEPRODSL                W 27  A    OCCURS 98                                    
BEPRODSL-PS  BEPRODSL      2  A                                                 
BEPRODSL-TXT BEPRODSL +3  24  A                                                 
                                                                                
NEWPAGE                                                                         
*---------------------------------------------------------------*               
* STEG 1.SORTERA  ARTIKELSALDOPOSTER ALLA DC PER ARTIKELNUMMER  *               
*---------------------------------------------------------------*               
SORT W51204D1 TO TPFIL1 USING(54-IDARTNR)  SIZE 900000                          
                                                                                
*---------------------------------------------------------------*               
* STEG 2. MATCHA SORTERAD FIL MED ARTIKELINFO O SKRIV TPFIL2    *               
*---------------------------------------------------------------*               
                                                                                
JOB INPUT (W51204D2 KEY (LB-IDARTNR) TPFIL1 KEY (T1-IDARTNR)) +                 
          START A-INIT                                                          
                                                                                
IF MATCHED                                                                      
  T2-IDDC       = T1-IDDC                                                       
  T2-KDPRODSL   = LB-KDPRODSL                                                   
  W-KVANTAL     = T1-KVAKS + T1-KVAKS-PAV + T1-KVLS  + T1-KVEFRS                
  T2-SUSTD      = W-KVANTAL * LB-PRARTSTD                                       
  IF T2-SUSTD NE 0                                                              
    PUT TPFIL2                                                                  
    T2-IDDC     = '00'                                                          
    PUT TPFIL2                                                                  
  END-IF                                                                        
END-IF                                                                          
                                                                                
A-INIT. PROC                                                                    
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                      
  W-AA       = D-AAR                                                            
  W-MM       = D-MAANAD                                                         
  W-DD       = D-DAG                                                            
  RUB-DATUM  = W-AAMMDD                                                         
  RUB-MÅNAD  = W-MM                                                             
                                                                                
****  INITIERA TABELLER ******                                                  
  BEPRODSL(01) =       '11 SPARE PARTS VCC'                                     
  BEPRODSL(02) =       '12                '                                     
  BEPRODSL(03) =       '13 CHEMICALS VCCS'                                      
