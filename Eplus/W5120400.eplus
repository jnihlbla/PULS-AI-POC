*--------------------------------------------------------*                      
* STEG 3 SORTERA TPFIL2 TILL TPFIL2 PER DC OCH PRODSL                           
*        OCH SUMMERA SAMT SKRIV EXCELFIL                                        
*--------------------------------------------------------*                      
                                                                                
SORT TPFIL2 TO TPFIL2 USING (T2-IDDC T2-KDPRODSL) SIZE 200000                   
                                                                                
JOB INPUT NULL                                                                  
                                                                                
  PERFORM A-INIT-EXCEL                                                          
  GET TPFIL2                                                                    
  IF NOT EOF TPFIL2                                                             
    W-IDDC             = T2-IDDC                                                
    W-KDPRODSL         = T2-KDPRODSL                                            
    W-SUSTD            = 0                                                      
    DO WHILE NOT EOF TPFIL2                                                     
      IF T2-IDDC = W-IDDC AND T2-KDPRODSL = W-KDPRODSL                          
        W-SUSTD = W-SUSTD + T2-SUSTD                                            
      ELSE                                                                      
        PERFORM SKRIV-EXCELPOST                                                 
        W-IDDC             = T2-IDDC                                            
        W-KDPRODSL         = T2-KDPRODSL                                        
        W-SUSTD            = T2-SUSTD                                           
      END-IF                                                                    
      GET TPFIL2                                                                
    END-DO                                                                      
  END-IF                                                                        
  PERFORM SKRIV-EXCELPOST                                                       
                                                                                
  STOP                                                                          
                                                                                
A-INIT-EXCEL. PROC                                                              
  UTAREA      = W-EXCEL-RUB1                                                    
  PUT W51204D3                                                                  
END-PROC                                                                        
                                                                                
SKRIV-EXCELPOST. PROC                                                           
  UT-IDDC     = W-IDDC                                                          
  UT-KDPRODSL = W-KDPRODSL                                                      
  UT-TEXT     = 'OTHERS'                                                        
  IX = 1                                                                        
  DO WHILE IX LE 98                                                             
    IF BEPRODSL-PS(IX) EQ UT-KDPRODSL                                           
      UT-TEXT     = BEPRODSL-TXT(IX)                                            
      IX = 99                                                                   
    END-IF                                                                      
    IX = IX + 1                                                                 
  END-DO                                                                        
  UT-SUMMA    = W-SUSTD                                                         
  UTAREA      = UT-AREA                                                         
  PUT W51204D3                                                                  
END-PROC                                                                        
