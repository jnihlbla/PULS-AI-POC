*  FÖRFATTARE :  STEFANO GIOBBI                                        *        
*                                                                      *        
*  DATUM      :  950727                                                *        
*                                                                      *        
*  FUNKTION   :  PROGRAMMET KOMPLETTERAR INKOMMANDE POSTER MED DESS    *        
*                FÖRSTA NORMALT LEVERERANDE LAGER.                     *        
*                                                                      *        
*                INFILERNA MATCHAS PÅ DISTRIKT OCH KUND.               *        
*                                                                      *        
*                PROGRAMMET SKAPAR EN FIL:                             *        
*                  W02009 IN FIL KOMPLETTERAD MED IDDC-PRIM            *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE W02007D1                                                                   
*   FIL FRÅN W020P004 - WDB2 NEDLÄST                                            
%W02007        'IN07-'                                                          
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W02007D2                                                                   
*   FIL FRÅN W020P008 - SRS-INFO                                                
%W02008        'IN08-'                                                          
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W02007D3   FB (30 0)                                                       
*     SRS-INFO KOMPLETTERAD MED IDDC-PRIM                                       
*     INNEHÅLLER DE POSTER DÄR IDDC STÄMMER ÖVERRENS MED IDDC-PRIM              
%W02009        'UT09A-'                                                         
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W02007D4   FB (30 0)                                                       
*     SRS-INFO KOMPLETTERAD MED IDDC-PRIM                                       
*     INNEHÅLLER DE POSTER DÄR IDDC INTE !!!!!! ÄR SAMMA IDDC-PRIM              
%W02009        'UT09B-'                                                         
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT (W02007D1 KEY (IN07-IDDISTR                          +              
                           IN07-IDKUNDNR)                        +              
             W02007D2 KEY (IN08-IDDISTR                          +              
                           IN08-IDKUNDNR))                       +              
                                                 NAME   STEG01                  
    IF MATCHED                                                                  
      UT09A-IDDC      = IN08-IDDC                                               
      UT09A-IDDISTR   = IN08-IDDISTR                                            
      UT09A-IDKUNDNR  = IN08-IDKUNDNR                                           
      UT09A-IDARTNR   = IN08-IDARTNR                                            
      UT09A-KDORDKL   = IN08-KDORDKL                                            
      IF IN08-KDORDKL = 0                                                       
        UT09A-IDDC-PRIM = IN07-IDDC-VOR                                         
      ELSE                                                                      
        IF IN08-KDORDKL = 1                                                     
          UT09A-IDDC-PRIM = IN07-IDDC-DAY                                       
        ELSE                                                                    
          UT09A-IDDC-PRIM = IN07-IDDC-BULK                                      
        END-IF                                                                  
      END-IF                                                                    
      UT09A-KDPRODSL  = IN08-KDPRODSL                                           
      UT09A-REINKORD  = IN08-REINKORD                                           
      UT09A-REFYSAVV  = IN08-REFYSAVV                                           
      UT09A-REAVBRAD  = IN08-REAVBRAD                                           
      UT09A-RELAGERB  = 0                                                       
      UT09A-RESORTB   = 0                                                       
      UT09A-KVBEART   = IN08-KVBEART                                            
      IF UT09A-IDDC = UT09A-IDDC-PRIM                                           
        PUT W02007D3                                                            
      ELSE                                                                      
        PUT W02007D4 FROM W02007D3                                              
      END-IF                                                                    
    END-IF                                                                      
                                                                                
NEWPAGE                                                                         
