                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5604800                                              *        
*                                                                      *        
*  FUNKTION   :  SKRIVER LISTOR PÅ ARTIKLAR MED NEGATIVA SALDON,       *        
*                OCH/ELLER NEGATIV AVERAGE COST.                       *        
*                                                                      *        
*  FÖRFATTARE :  KARL JOHAN HANSSON                                    *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W56048D1                                                                   
*                                                                               
%W51052 'IN-'                                                                   
*                                                                               
NEWPAGE                                                                         
FILE W56048D2  PRINTER VB (125 0)                                               
                                                                                
PROGRAM-NAMN           W   8   A        VALUE 'W5604800'                        
DATUMKORT-ID           W   6   A        VALUE 'WDATUM'                          
%WDATKORT                                                                       
                                                                                
AKT-TIAAVVDD           W                 6  N  MASK '99/99/99'                  
AKT-MAANAD             AKT-TIAAVVDD      2  N                                   
AKT-DAG                AKT-TIAAVVDD +2   2  N                                   
AKT-AAR                AKT-TIAAVVDD +4   2  N                                   
*                                                                               
*                                                                               
W-SEM             W   1  A         VALUE ';'                                    
W-PREV-IDDC       W   2  A                                                      
W-IDDC            W   2  A                                                      
W-IDARTNR         W   9  N  0      MASK '--------9'                             
W-KVAKS-NDC       W   7  N  0      MASK '------9'                               
W-KVAKS-PAV       W   7  N  0      MASK '------9'                               
W-KVEFRS          W   7  N  0      MASK '------9'                               
W-KVLS            W   7  N  0      MASK '------9'                               
W-SUM-LAGERSALDO  W  10  N  0      MASK '---------9'                            
W-PRAVCOST        W   9  N  2      MASK '------9.99'                            
                                                                                
*                                                                               
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
******************************************************************              
* STEG 1. LÄSER EK-LAGERBAND, OM SALDO ÄR NEGATIVT ELLER OM PRAVCOST            
*         ÄR NEGATIV SKAPAS EN RAD PÅ LISTA PÅ RESP IDDC                        
******************************************************************              
                                                                                
SORT W56048D1 TO W56048D1 USING (IN-IDDC, IN-IDARTNR)                           
JOB INPUT (W56048D1) START INIT                                                 
                                                                                
   W-IDDC         = IN-IDDC                                                     
   W-IDARTNR      = IN-IDARTNR                                                  
   W-KVAKS-NDC    = IN-KVAKS-SDC                                                
   W-KVAKS-PAV    = IN-KVAKS-PAV                                                
   W-KVEFRS       = IN-KVEFRS                                                   
   W-KVLS         = IN-KVLS                                                     
   W-PRAVCOST     = IN-PRAVCOST                                                 
   W-SUM-LAGERSALDO = W-KVAKS-PAV + W-KVAKS-NDC + W-KVEFRS + W-KVLS             
   IF W-SUM-LAGERSALDO LT 0                                                     
     PRINT LISTADAP                                                             
   ELSE                                                                         
     IF W-PRAVCOST LT 0                                                         
       PRINT LISTADAP                                                           
     END-IF                                                                     
   END-IF                                                                       
                                                                                
INIT. PROC                                                                      
                                                                                
    CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                    
                                                                                
    AKT-AAR      =   D-AAR                                                      
    AKT-MAANAD   =   D-MAANAD                                                   
    AKT-DAG      =   D-DAG                                                      
                                                                                
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
NEWPAGE                                                                         
**************************                                                      
** LISTADAP FOR ALL NDC-NA                                                      
**************************                                                      
                                                                                
  REPORT LISTADAP               +                                               
         PRINTER W56048D2       +                                               
         PAGESIZE 32767         +                                               
         LINESIZE 120           +                                               
         SPACE 0                +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NODATE                 +                                               
         NOADJUST                                                               
                                                                                
LINE  1  W-IDARTNR          +                                                   
         W-SEM              +                                                   
         W-KVAKS-PAV        +                                                   
         W-SEM              +                                                   
         W-KVAKS-NDC        +                                                   
         W-SEM              +                                                   
         W-KVLS             +                                                   
         W-SEM              +                                                   
         W-KVEFRS           +                                                   
         W-SEM              +                                                   
         W-PRAVCOST         +                                                   
         W-SEM                                                                  
*                                                                               
BEFORE-LINE. PROC                                                               
 IF W-IDDC NE W-PREV-IDDC   +                                                   
 AND W-IDDC NE ' '                                                              
   DISPLAY '¤DAPW56048'                                                         
   DISPLAY '¤DAP' W-IDDC                                                        
   DISPLAY 'PARTNO;IN TRANSIT;RECEIVED;STOCK BALANCES;' +                       
           'PENDING FOR INVOICE;AVERAGE COST;'                                  
   W-PREV-IDDC = W-IDDC                                                         
 END-IF                                                                         
END-PROC                                                                        
