*                                                                               
FILE LISTDD  PRINTER                                                            
*                                                                               
    W-FLD                   W     0014  N 4                                     
    W-FLD-INTEGER   W-FLD         0010  N                                       
    W-FLD-DECIMAL   W-FLD +10     0004  A                                       
    W-ED                    W     0015  A                                       
    W-ED-INTSIGN   W-ED           0001  A  OCCURS 10 INDEX SIGN-X               
    W-ED-INTEGER    W-ED          0010  A                                       
    W-ED-DECDOT     W-ED   +10    0001  A                                       
    W-ED-DECIMAL    W-ED   +11    0004  A                                       
    W-ED-DECSIGN    W-ED-DECIMAL 0001   A  OCCURS 4     INDEX SIGN-XX           
*                                                                               
    W-CONC-I                W     0254  A                                       
    W-CONC-ISIGN    W-CONC-I      0001  A  OCCURS 254 -                         
                             INDEX (INX, INX-STOP)                              
    W-CONC-U                W     4096  A                                       
    W-CONC-USIGN    W-CONC-U      0001  A  OCCURS 4096  INDEX UTX               
*                                                                               
    W-FLDAV                 W     0001  A    VALUE '	'                          
    W-DECAV                 W     0001  A    VALUE ','                          
*                                                                               
JOB INPUT INFIL01                                                               
               PERFORM MAIN-SECTION                                             
*                                                                               
MAIN-SECTION. PROC                                                              
               W-FLDAV = '	'                                                    
               MOVE ' ' TO W-CONC-U FILL ' '                                    
               UTX = 1                                                          
               W-FLD = IDARTNR                                                  
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = KDPRODSL                                                 
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               MOVE DAPBPLAN TO W-CONC-I                                        
               INX = 8                                                          
               PERFORM CONCATENATE-CHAR                                         
               W-FLD = KVPB-PLAN                                                
               PERFORM EDIT-NUM                                                 
