               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = RESEASON                                                 
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               MOVE FL-OI-ID-EQ-TRANS-ID TO W-CONC-I                            
               INX = 1                                                          
               PERFORM CONCATENATE-CHAR                                         
               W-FLD = KVOI-PROG                                                
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = KVOI-REFILL                                              
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = KVOI-SATS                                                
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = TIAAPP                                                   
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               MOVE KDVALUES-USED TO W-CONC-I                                   
               INX = 8                                                          
               PERFORM CONCATENATE-CHAR                                         
               MOVE FLMASK-CALCULATED TO W-CONC-I                               
               INX = 1                                                          
               PERFORM CONCATENATE-CHAR                                         
               W-FLD = KVPB-PLAN-MASK                                           
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = KVPB-TOT-MASK                                            
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = PROGFEL-TOT-MASK                                         
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = KVUTJFEL-MASK                                            
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = KVMAD-TOT-MIN-MASK                                       
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = KVMAD-TOT-MASK                                           
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               MOVE FLMAN-CALCULATED TO W-CONC-I                                
               INX = 1                                                          
               PERFORM CONCATENATE-CHAR                                         
               W-FLD = KVPB-PLAN-MAN                                            
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = KVPB-TOT-MAN                                             
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = PROGFEL-TOT-MAN                                          
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = KVUTJFEL-MAN                                             
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLD = KVMAD-TOT-MIN-MAN                                        
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               W-FLDAV = ' '                                                    
               W-FLD = KVMAD-TOT-MAN                                            
               PERFORM EDIT-NUM                                                 
               MOVE W-ED TO W-CONC-I                                            
               PERFORM CONCATENATE-NUM                                          
               UT-REC = W-CONC-U                                                
               RECORD-LENGTH(UTFIL01) = UTX - 1                                 
               PUT UTFIL01                                                      
END-PROC                                                                        
CONCATENATE-CHAR. PROC                                                          
               PERFORM PACK-TO-OUTPUT                                           
               IF W-FLDAV ^= ' '                                                
                 W-CONC-USIGN (UTX) = W-FLDAV                                   
                 UTX = UTX + 1                                                  
               END-IF                                                           
END-PROC                                                                        
*                                                                               
CONCATENATE-NUM. PROC                                                           
               INX = 18                                                         
               PERFORM PACK-TO-OUTPUT                                           
               IF W-FLDAV ^= ' '                                                
                 W-CONC-USIGN (UTX) = W-FLDAV                                   
                 UTX = UTX + 1                                                  
               END-IF                                                           
END-PROC                                                                        
*                                                                               
PACK-TO-OUTPUT. PROC                                                            
               DO WHILE INX > 0 AND W-CONC-ISIGN (INX) = ' '                    
                 INX = INX - 1                                                  
               END-DO                                                           
               INX-STOP = INX                                                   
               INX = 1                                                          
               DO WHILE INX < INX-STOP AND W-CONC-ISIGN (INX) = ' '             
                  INX = INX + 1                                                 
               END-DO                                                           
               DO WHILE INX <= INX-STOP                                         
                 W-CONC-USIGN (UTX) = W-CONC-ISIGN (INX)                        
                 INX = INX + 1                                                  
                 UTX = UTX + 1                                                  
               END-DO                                                           
END-PROC                                                                        
*                                                                               
EDIT-NUM. PROC                                                                  
               W-ED-DECDOT = W-DECAV                                            
               W-ED-INTEGER = W-FLD-INTEGER                                     
               SIGN-X = 0                                                       
               DO WHILE SIGN-X < 10 AND W-ED-INTSIGN (SIGN-X) < '1'             
                 IF W-ED-INTSIGN (SIGN-X) = '0'                                 
                   W-ED-INTSIGN (SIGN-X) = ' '                                  
                 END-IF                                                         
                 SIGN-X = SIGN-X + 1                                            
               END-DO                                                           
               IF W-FLD < 0                                                     
                 SIGN-X = SIGN-X - 1                                            
                 W-ED-INTSIGN (SIGN-X) = '-'                                    
               END-IF                                                           
               W-ED-DECIMAL = W-FLD-DECIMAL OR X'000000F0'                      
               SIGN-XX = 4                                                      
               DO WHILE SIGN-XX > 0 AND W-ED-DECSIGN (SIGN-XX) = '0'            
                 W-ED-DECSIGN (SIGN-XX) = ' '                                   
                 SIGN-XX = SIGN-XX - 1                                          
               END-DO                                                           
               IF W-ED-DECIMAL = ' '                                            
                 W-ED-DECDOT = ' '                                              
               END-IF                                                           
END-PROC                                                                        
*                                                                               
