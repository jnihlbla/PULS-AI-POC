REPORT RAPPORT00 LINESIZE 79 PAGESIZE 999 PRINTER W23155D5 SPACE 1 +            
   NOADJUST NOPAGE SUMMARY SUMSPACE 1                                           
    SEQUENCE AG-GRUPP                                                           
    CONTROL  FINAL NOPRINT AG-GRUPP                                             
    SUM  W-FLRO-TAECK W-KVINORD-TOT W-KVAVBRAD-TOT W-FLRO DISP AK  +            
    ARSOMS ANTAL W-SVG-B W-SVG-T SLAGER-2 OLAGER OMSHAST                        
    TITLE 1  '          '                                                       
    TITLE 2  '            RAPPORT00'                                            
    TITLE 3  '                           ANALYS AV 57573-GRUPPEN'               
    TITLE 4  '                           ÅRSOMSÄTTNING           '              
    HEADING AG-GRUPP ('AG-' 'GRUPP')                                            
    HEADING DISP     ('SOH ' 'SLAGER')                                          
    HEADING AK       ('AK' 'ÖLAGER')                                            
    HEADING ARSOMS ('ARSOMS' 'OMSHAST')                                         
    HEADING ANTAL    ('ANTAL' 'ARTIKLAR')                                       
    HEADING W-SVG-B ('SERVG' '%LEVBESK' )                                       
    LINE 1   AG-GRUPP DISP AK ARSOMS  ANTAL W-SVG-B                             
    LINE 2   POS 2 SLAGER-2 POS 3 OLAGER POS 4 OMSHAST POS 6 W-SVG-T            
*                                                                               
   BEFORE-BREAK. PROC                                                           
***************************                                                     
      IF W-KVINORD-TOT  = 0                                                     
           W-SVG-BTO = 99.9                                                     
      ELSE                                                                      
         W-SVG-BTO ROUNDED  = W-KVAVBRAD-TOT  * 100 / W-KVINORD-TOT             
         IF W-SVG-BTO = 100                                                     
           W-SVG-BTO = 99.9                                                     
         END-IF                                                                 
         W-SVG-B     = W-SVG-BTO                                                
      END-IF                                                                    
      IF W-FLRO = 0                                                             
         W-SVG-T   = 99.9                                                       
      ELSE                                                                      
         W-SVG-TAECK = W-FLRO-TAECK * 100 / W-FLRO                              
         IF W-SVG-TAECK = 100                                                   
            W-SVG-TAECK = 99.9                                                  
         END-IF                                                                 
         W-SVG-T     = W-SVG-TAECK                                              
      END-IF                                                                    
************************                                                        
     TOTLV     = DISP + AK                                                      
     IF TOTLV     > 0                                                           
        OMSHAST = (ARSOMS / TOTLV)                                              
     END-IF                                                                     
     IF TOTLV     LE 0                                                          
        OMSHAST = 0                                                             
     END-IF                                                                     
     IF LEVEL = 2                                                               
***************************                                                     
      IF W-KVINORD-TOT  = 0                                                     
           W-SVG-BTO = 99.9                                                     
      ELSE                                                                      
         W-SVG-BTO ROUNDED  = W-KVAVBRAD-TOT  * 100 / W-KVINORD-TOT             
         IF W-SVG-BTO = 100                                                     
           W-SVG-BTO = 99.9                                                     
         END-IF                                                                 
         W-SVG-B     = W-SVG-BTO                                                
      END-IF                                                                    
      IF W-FLRO = 0                                                             
            W-SVG-TAECK = 99.9                                                  
      ELSE                                                                      
         W-SVG-TAECK = W-FLRO-TAECK * 100 / W-FLRO                              
         IF W-SVG-TAECK = 100                                                   
            W-SVG-TAECK = 99.9                                                  
         END-IF                                                                 
         W-SVG-T     = W-SVG-TAECK                                              
      END-IF                                                                    
************************                                                        
       IF TOTLV > 0                                                             
        OMSHAST = (ARSOMS / TOTLV)                                              
       END-IF                                                                   
       IF TOTLV     LE 0                                                        
          OMSHAST = 0                                                           
          END-IF                                                                
    DISPLAY SKIP 2 COL 28 '        '                                            
    DISPLAY SKIP 2 COL 28 'TOTALT AVDELNING 57573'                              
    DISPLAY SKIP 1 COL 28 '======================'                              
    DISPLAY SKIP 1 COL 28 '     '                                               
    DISPLAY SKIP 1 COL 5  'SOH:   ' DISP   COL 45 'AK:    ' AK                  
    DISPLAY SKIP 1 COL 5  'SLAGER:' SLAGER-2 COL 45 'ÖLAGER:' OLAGER            
    DISPLAY SKIP 1 COL 5  'ARSOMS:' ARSOMS  COL 45 'OMSHAST:  '  OMSHAST        
    DISPLAY SKIP 1 COL 5  'ANTAL ARTIKLAR TOTALT:' ANTAL                        
    DISPLAY SKIP 1 COL 5  'SERVG:                '  W-SVG-BTO +                 
    COL 45 '%LEVBESK:  ' W-SVG-T                                                
     END-IF                                                                     
   END-PROC                                                                     
*                                                                               
    AFTER-BREAK. PROC                                                           
     DISPLAY SKIP 1                                                             
    END-PROC                                                                    
NEWPAGE                                                                         
*                                                                               
