      IF W-KVINORD-TOT  = 0                                                     
           W-SVG-BTO = 99.9                                                     
      ELSE                                                                      
         W-SVG-BTO ROUNDED = W-KVAVBRAD-TOT  * 100 / W-KVINORD-TOT              
         IF W-SVG-BTO = 100                                                     
           W-SVG-BTO = 99.9                                                     
         END-IF                                                                 
         W-SVG-B     = W-SVG-BTO                                                
      END-IF                                                                    
      IF W-FLRO = 0                                                             
            W-SVG-TAECK = 99.9                                                  
      ELSE                                                                      
         W-SVG-TAECK = W-FLRO-TAECK * 100 / W-FLRO                              
         IF W-SVG-TAECK = 100                                                   
            W-SVG-TAECK = 99.9                                                  
         END-IF                                                                 
         W-SVG-T     = W-SVG-TAECK                                              
      END-IF                                                                    
************************                                                        
        IF TOTLV     > 0                                                        
           OMSHAST = (ARSOMS / TOTLV)                                           
        END-IF                                                                  
        IF TOTLV LE 0                                                           
           OMSHAST = 0                                                          
        END-IF                                                                  
