NEWPAGE                                                                         
************************************************************************        
* DEL 1  BÖRJAR MED ATT SUMMERA ORDERINGÅNG FÖR                                 
*        FÖR ANSKAFFARE 780 - 789 = EMBALLAGE                                   
************************************************************************        
*                                                                               
JOB INPUT (W23155D2 KEY IN2-IDARTNR W23155D4 KEY OI-IDARTNR)                    
*                                                                               
  IF MATCHED                                                                    
     IF IN2-IDANSK = 780 THRU 789                                               
        PERFORM OI-SUMMA                                                        
        OI-DF-IDARTNR = IN2-IDARTNR                                             
        OI-DF-KVANTAL = OITOT                                                   
        PUT W23155DF                                                            
     END-IF                                                                     
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
OI-SUMMA. PROC                                                                  
************************************************************************        
*  FÖR EMBALLAGE SKAPAS UNIK FIL MED OI ISTÄLLET FÖR FÖRSÄLJNING                
*  SENARE I PROGRAMMET                                                          
************************************************************************        
*                                                                               
  OITOT = 0                                                                     
*                                                                               
  OITOT = OI-KVOI-PROG (1) + OI-KVOI-DIV (1) + OI-KVOI-SATS (1) + +             
          OI-KVOI-NDC  (1) + OI-KVOI-SDC (1) + +                                
          OI-KVOI-PROG (2) + OI-KVOI-DIV (2) + OI-KVOI-SATS (2) + +             
          OI-KVOI-NDC  (2) + OI-KVOI-SDC (2) + +                                
          OI-KVOI-PROG (3) + OI-KVOI-DIV (3) + OI-KVOI-SATS (3) + +             
          OI-KVOI-NDC  (3) + OI-KVOI-SDC (3) + +                                
          OI-KVOI-PROG (4) + OI-KVOI-DIV (4) + OI-KVOI-SATS (4) + +             
          OI-KVOI-NDC  (4) + OI-KVOI-SDC (4) + +                                
          OI-KVOI-PROG (5) + OI-KVOI-DIV (5) + OI-KVOI-SATS (5) + +             
          OI-KVOI-NDC  (5) + OI-KVOI-SDC (5) + +                                
          OI-KVOI-PROG (6) + OI-KVOI-DIV (6) + OI-KVOI-SATS (6) + +             
          OI-KVOI-NDC  (6) + OI-KVOI-SDC (6) + +                                
          OI-KVOI-PROG (7) + OI-KVOI-DIV (7) + OI-KVOI-SATS (7) + +             
          OI-KVOI-NDC  (7) + OI-KVOI-SDC (7) + +                                
          OI-KVOI-PROG (8) + OI-KVOI-DIV (8) + OI-KVOI-SATS (8) + +             
          OI-KVOI-NDC  (8) + OI-KVOI-SDC (8) + +                                
          OI-KVOI-PROG (9) + OI-KVOI-DIV (9) + OI-KVOI-SATS (9) + +             
          OI-KVOI-NDC  (9) + OI-KVOI-SDC (9) + +                                
          OI-KVOI-PROG (10) + OI-KVOI-DIV(10) + OI-KVOI-SATS(10) + +            
          OI-KVOI-NDC  (10) + OI-KVOI-SDC(10) + +                               
          OI-KVOI-PROG (11) + OI-KVOI-DIV(11) + OI-KVOI-SATS(11) + +            
          OI-KVOI-NDC  (11) + OI-KVOI-SDC(11) + +                               
          OI-KVOI-PROG (12) + OI-KVOI-DIV(12) + OI-KVOI-SATS(12) + +            
          OI-KVOI-NDC  (12) + OI-KVOI-SDC(12)                                   
*                                                                               
 END-PROC                                                                       
*                                                                               
NEWPAGE                                                                         
***********************************************************************         
* DEL 2  FORTSÄTTER ATT SUMMERA FÖRSÄLJNING FRÅN ARTIKELSTATISTIK               
*        ALLA ARTIKLAR                                                          
***********************************************************************         
*                                                                               
JOB INPUT W23155D1  FINISH Z-FINIT                                              
  IF RECORD-COUNT = 1                                                           
     W-IDARTNR  = IN1-IDARTNR                                                   
  END-IF                                                                        
*                                                                               
  IF IN1-IDARTNR NE W-IDARTNR                                                   
     STAT-IDARTNR = W-IDARTNR                                                   
     STAT-KVANTAL = W-ARTOMS                                                    
     PUT W23155DG                                                               
     W-IDARTNR    = IN1-IDARTNR                                                 
     W-ARTOMS     = IN1-SULEVANT-RAAR                                           
  ELSE                                                                          
     W-ARTOMS  = W-ARTOMS + IN1-SULEVANT-RAAR                                   
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
  Z-FINIT. PROC                                                                 
*                                                                               
     STAT-IDARTNR = W-IDARTNR                                                   
     STAT-KVANTAL = W-ARTOMS                                                    
     PUT W23155DG                                                               
  END-PROC                                                                      
*                                                                               
NEWPAGE                                                                         
*                                                                               
***********************************************************************         
* DEL 3   SKAPA EN FIL SOM INNEHÅLLER IBLAND ORDERINGÅNG                        
*        IBLAND ARTIKELSTATISTIK                                                
***********************************************************************         
*                                                                               
JOB INPUT (W23155DG KEY STAT-IDARTNR W23155DF KEY OI-DF-IDARTNR)                
    IF MATCHED                                                                  
       PUT W23155DE FROM W23155DF                                               
    ELSE                                                                        
       IF W23155DF                                                              
          PUT W23155DE FROM W23155DF                                            
       ELSE                                                                     
          IF W23155DG                                                           
             PUT W23155DE FROM W23155DG                                         
          END-IF                                                                
       END-IF                                                                   
    END-IF                                                                      
*                                                                               
***********************************************************************         
* DEL 4   SKAPA YTTERLIGARE EN FIL MED SÄKERHETS-LAGER O MAXPUNKT               
***********************************************************************         
                                                                                
SORT W23155D3 TO TPFIL3 USING (D3-SLAG-IDARTNR)                                 
                                                                                
                                                                                
JOB INPUT (W23155D2 KEY IN2-IDARTNR TPFIL3 KEY T3-SLAG-IDARTNR) +               
                    START A-DEL5-INIT                                           
  IF MATCHED                                                                    
*** MATCHA IHOP W01177 OCH W01184-FILERNA, SUMMERA 84-ORNA                      
    EK-KVTOT-SDC  = EK-KVTOT-SDC +                               +              
      T3-SLAG-KVLS + T3-SLAG-KVAKS-SDC + T3-SLAG-KVAKS-PAV                      
    IF LAST-DUP TPFIL3 OR NOT DUPLICATE TPFIL3                                  
      EK-IDARTNR    = IN2-IDARTNR                                               
      EK-IDANSK     = IN2-IDANSK                                                
      EK-KVSLAGER   = IN2-KVSLAGER                                              
      EK-KVMP       = IN2-KVMP                                                  
      EK-AKTOT-CDC  = IN2-KVAKS-CDC + IN2-KVAKS-T + IN2-KVAKS-PAV               
      EK-KVLS       = IN2-KVLS                                                  
      EK-KVRESS     = IN2-KVRESS                                                
      EK-PRARTSTD   = IN2-PRARTSTD                                              
      PUT W23155DD                                                              
      EK-KVTOT-SDC  = 0                                                         
    END-IF                                                                      
  ELSE                                                                          
    IF W23155D2                                                                 
      EK-IDARTNR    = IN2-IDARTNR                                               
      EK-IDANSK     = IN2-IDANSK                                                
      EK-KVSLAGER   = IN2-KVSLAGER                                              
      EK-KVMP       = IN2-KVMP                                                  
      EK-AKTOT-CDC  = IN2-KVAKS-CDC + IN2-KVAKS-T + IN2-KVAKS-PAV               
      EK-KVTOT-SDC  = 0                                                         
      EK-KVLS       = IN2-KVLS                                                  
      EK-KVRESS     = IN2-KVRESS                                                
      EK-PRARTSTD   = IN2-PRARTSTD                                              
      PUT W23155DD                                                              
    END-IF                                                                      
  END-IF                                                                        
                                                                                
A-DEL5-INIT. PROC                                                               
  EK-KVTOT-SDC  = 0                                                             
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
***********************************************************************         
* DEL 5  - SORTERAR W22509 PÅ IDARTNR PÅ IN4-IDARTNR                            
*       - SORTERAR W22542 PÅ IDARTNR PÅ IN5-IDARTNR                             
*       - MATCHAR W23155DK W23155DL W23155D2(W01177)                            
*         HÄMTAR IDANSK SKAPAR TMPFIL                                           
*       - SORTERAR TMPFIL PÅ IDANSK                                             
*       - SUMMERAR KVAVBRAD KVINORD FLRO FLROTAEK / SAMTLIGA                    
*         ARTIKLAR PER ANSKAFFARE                                               
***********************************************************************         
*                                                                               
JOB INPUT W23155DI                                                              
   SORT W23155DI TO W23155DK USING IN4-IDARTNR                                  
                                                                                
JOB INPUT W23155DJ                                                              
   SORT W23155DJ TO W23155DL USING IN5-IDARTNR                                  
                                                                                
JOB INPUT (W23155D2  KEY IN2-IDARTNR                       +                    
           W23155DL  KEY SORT2-IDARTNR                     +                    
           W23155DK  KEY SORT1-IDARTNR)                                         
*                                                                               
  IF MATCHED W23155D2 W23155DK W23155DL                                         
     TMP-IDARTNR           = IN2-IDARTNR                                        
     TMP-IDANSK            = IN2-IDANSK                                         
     TMP-KVAVBRAD-CDC-1-2  = SORT1-KVAVBRAD-CDC-1-2(2)                          
     TMP-KVAVBRAD-CDC-3-4  = SORT1-KVAVBRAD-CDC-3-4(2)                          
     TMP-KVINORD-CDC-1-2   = SORT1-KVINORD-CDC-1-2(2)                           
     TMP-KVINORD-CDC-3-4   = SORT1-KVINORD-CDC-3-4(2)                           
     TMP-FLRO              = SORT2-FLRO                                         
     TMP-FLRO-TAECK        = SORT2-FLRO-TAECK                                   
     PUT W23155DM                                                               
  ELSE                                                                          
     IF MATCHED W23155D2 W23155DK                                               
        TMP-IDARTNR           = IN2-IDARTNR                                     
        TMP-IDANSK            = IN2-IDANSK                                      
        TMP-KVAVBRAD-CDC-1-2  = SORT1-KVAVBRAD-CDC-1-2(2)                       
        TMP-KVAVBRAD-CDC-3-4  = SORT1-KVAVBRAD-CDC-3-4(2)                       
        TMP-KVINORD-CDC-1-2   = SORT1-KVINORD-CDC-1-2(2)                        
        TMP-KVINORD-CDC-3-4   = SORT1-KVINORD-CDC-3-4(2)                        
        TMP-FLRO              = 0                                               
        TMP-FLRO-TAECK        = 0                                               
        PUT W23155DM                                                            
     ELSE                                                                       
        IF MATCHED W23155D2 W23155DL                                            
           TMP-IDARTNR           = IN2-IDARTNR                                  
           TMP-IDANSK            = IN2-IDANSK                                   
           TMP-KVAVBRAD-CDC-1-2  = 0                                            
           TMP-KVAVBRAD-CDC-3-4  = 0                                            
           TMP-KVINORD-CDC-1-2   = 0                                            
           TMP-KVINORD-CDC-3-4   = 0                                            
           TMP-FLRO              = SORT2-FLRO                                   
           TMP-FLRO-TAECK        = SORT2-FLRO-TAECK                             
           PUT W23155DM                                                         
        ELSE                                                                    
           IF W23155D2                                                          
              TMP-IDARTNR           = IN2-IDARTNR                               
              TMP-IDANSK            = IN2-IDANSK                                
              TMP-KVAVBRAD-CDC-1-2  = 0                                         
              TMP-KVAVBRAD-CDC-3-4  = 0                                         
              TMP-KVINORD-CDC-1-2   = 0                                         
              TMP-KVINORD-CDC-3-4   = 0                                         
              TMP-FLRO              = 0                                         
              TMP-FLRO-TAECK        = 0                                         
              PUT W23155DM                                                      
           END-IF                                                               
        END-IF                                                                  
     END-IF                                                                     
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
***********************************************************************         
* DEL 6  - TEMPFIL  W23155DM PÅ ANSKAFFARE                                      
***********************************************************************         
                                                                                
SORT W23155DM TO W23155DN USING TMP-IDANSK                                      
*                                                                               
JOB INPUT W23155DN       FINISH E-SLUT  +                                       
                         NAME STEG02                                            
*                                                                               
  IF SW1 = 0                                                                    
     SW1 = 1                                                                    
     PERFORM B-LAGRA                                                            
  END-IF                                                                        
                                                                                
  IF TMP2-IDANSK = W-SPAR-IDANSK                                                
     PERFORM D-SUMMERA-W23155DO                                                 
  ELSE                                                                          
     PERFORM C-SKRIV-W23155DO                                                   
     PERFORM B-LAGRA                                                            
  END-IF                                                                        
*                                                                               
B-LAGRA.  PROC                                                                  
   W-IDANSK             = TMP2-IDANSK                                           
   W-SPAR-IDANSK        = TMP2-IDANSK                                           
   W-KVAVBRAD-CDC-1-2   = TMP2-KVAVBRAD-CDC-1-2                                 
   W-KVAVBRAD-CDC-3-4   = TMP2-KVAVBRAD-CDC-3-4                                 
   W-KVINORD-CDC-1-2    = TMP2-KVINORD-CDC-1-2                                  
   W-KVINORD-CDC-3-4    = TMP2-KVINORD-CDC-3-4                                  
   W-FLRO               = TMP2-FLRO                                             
   W-FLRO-TAECK         = TMP2-FLRO-TAECK                                       
END-PROC                                                                        
*                                                                               
C-SKRIV-W23155DO.  PROC                                                         
   TMP3-IDANSK             = W-IDANSK                                           
   TMP3-KVAVBRAD-CDC-1-2   = W-KVAVBRAD-CDC-1-2                                 
   TMP3-KVAVBRAD-CDC-3-4   = W-KVAVBRAD-CDC-3-4                                 
   TMP3-KVINORD-CDC-1-2    = W-KVINORD-CDC-1-2                                  
   TMP3-KVINORD-CDC-3-4    = W-KVINORD-CDC-3-4                                  
   TMP3-FLRO               = W-FLRO                                             
   TMP3-FLRO-TAECK         = W-FLRO-TAECK                                       
   PUT W23155DO                                                                 
END-PROC                                                                        
*                                                                               
D-SUMMERA-W23155DO.  PROC                                                       
   W-KVAVBRAD-CDC-1-2   = W-KVAVBRAD-CDC-1-2 + TMP2-KVAVBRAD-CDC-1-2            
   W-KVAVBRAD-CDC-3-4   = W-KVAVBRAD-CDC-3-4 + TMP2-KVAVBRAD-CDC-3-4            
   W-KVINORD-CDC-1-2    = W-KVINORD-CDC-1-2  + TMP2-KVINORD-CDC-1-2             
   W-KVINORD-CDC-3-4    = W-KVINORD-CDC-3-4  + TMP2-KVINORD-CDC-3-4             
   W-FLRO               = W-FLRO + TMP2-FLRO                                    
   W-FLRO-TAECK         = W-FLRO-TAECK + TMP2-FLRO-TAECK                        
END-PROC                                                                        
*                                                                               
E-SLUT.  PROC                                                                   
   PERFORM C-SKRIV-W23155DO                                                     
END-PROC                                                                        
                                                                                
*                                                                               
***********************************************************************         
* DEL 7   SKAPA YTTERLIGARE EN FIL KOMPLETTRAD MED LAGERSALDO MM                
***********************************************************************         
*                                                                               
JOB INPUT (W23155DD KEY EK-IDARTNR W23155DE KEY DE-IDARTNR)                     
  IF MATCHED                                                                    
     PERFORM LIKA                                                               
  ELSE                                                                          
     IF  W23155DD                                                               
        PERFORM LB-ENSAM                                                        
     END-IF                                                                     
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
  LIKA.   PROC                                                                  
*                                                                               
   IF EK-IDANSK = 270 THRU 999                                                  
      PERFORM DISP-BER                                                          
        IF DISPA   > EK-KVMP                                                    
           U-DISP  = (EK-KVLS - EK-KVRESS ) * EK-PRARTSTD + 0.5                 
           U-AK     = EK-AKTOT-CDC * EK-PRARTSTD + 0.5                          
           U-SLAGER = EK-KVSLAGER * EK-PRARTSTD + 0.5                           
           U-ARSOMS = ((DE-RAAR-KVANTAL * EK-PRARTSTD) + 0.5)                   
           IF U-ARSOMS LE 0                                                     
              U-ARSOMS = 0                                                      
           END-IF                                                               
           U-OLAGER = (EK-KVLS - EK-KVRESS - EK-KVMP) * +                       
                      EK-PRARTSTD + 0.5                                         
           IF U-OLAGER LE 0                                                     
              U-OLAGER = 0                                                      
           END-IF                                                               
           PRINT RAPP1                                                          
        ELSE                                                                    
           IF DISPA   LE 0                                                      
              U-DISP = 0                                                        
              U-AK =  EK-AKTOT-CDC * EK-PRARTSTD + 0.5                          
              U-SLAGER = EK-KVSLAGER * EK-PRARTSTD + 0.5                        
              U-ARSOMS = ((DE-RAAR-KVANTAL * EK-PRARTSTD) + 0.5)                
              IF U-ARSOMS LE 0                                                  
                 U-ARSOMS = 0                                                   
              END-IF                                                            
              U-OLAGER = 0                                                      
              PRINT RAPP1                                                       
           ELSE                                                                 
              U-DISP = (EK-KVLS - EK-KVRESS) * EK-PRARTSTD + 0.5                
              U-AK = EK-AKTOT-CDC * EK-PRARTSTD + 0.5                           
              U-SLAGER = EK-KVSLAGER * EK-PRARTSTD + 0.5                        
              U-ARSOMS = ((DE-RAAR-KVANTAL * EK-PRARTSTD) + 0.5)                
              IF U-ARSOMS LE 0                                                  
                 U-ARSOMS = 0                                                   
              END-IF                                                            
              U-OLAGER = 0                                                      
           PRINT RAPP1                                                          
        END-IF                                                                  
       END-IF                                                                   
     END-IF                                                                     
  END-PROC                                                                      
NEWPAGE                                                                         
*                                                                               
  LB-ENSAM.   PROC                                                              
    IF EK-IDANSK = 270 THRU 999                                                 
       PERFORM DISP-BER                                                         
       IF DISPA > EK-KVMP                                                       
          U-DISP = (EK-KVLS - EK-KVRESS) +                                      
                 * EK-PRARTSTD + 0.5                                            
          U-AK = EK-AKTOT-CDC * EK-PRARTSTD + 0.5                               
          U-SLAGER = EK-KVSLAGER * EK-PRARTSTD + 0.5                            
          U-OLAGER = (EK-KVLS - EK-KVRESS - EK-KVMP) * +                        
                     EK-PRARTSTD + 0.5                                          
          IF U-OLAGER LE 0                                                      
             U-OLAGER = 0                                                       
          END-IF                                                                
          U-ARSOMS = 0                                                          
          PRINT RAPP1                                                           
      ELSE                                                                      
          IF DISPA LE 0                                                         
             U-DISP = 0                                                         
             U-AK   = EK-AKTOT-CDC * EK-PRARTSTD + 0.5                          
             U-SLAGER = EK-KVSLAGER * EK-PRARTSTD + 0.5                         
             U-OLAGER = 0                                                       
             U-ARSOMS = 0                                                       
             PRINT RAPP1                                                        
          ELSE                                                                  
             U-DISP = (EK-KVLS - EK-KVRESS) +                                   
                    * EK-PRARTSTD + 0.5                                         
             U-AK = EK-AKTOT-CDC * EK-PRARTSTD + 0.5                            
             U-SLAGER = EK-KVSLAGER * EK-PRARTSTD + 0.5                         
             U-OLAGER = 0                                                       
             U-ARSOMS =  0                                                      
             PRINT RAPP1                                                        
          END-IF                                                                
      END-IF                                                                    
     END-IF                                                                     
  END-PROC                                                                      
NEWPAGE                                                                         
*                                                                               
DISP-BER. PROC                                                                  
* BERÄKNA DISPONIBELT LAGER                                                     
   DISPA = EK-KVLS - EK-KVRESS + EK-AKTOT-CDC + EK-KVTOT-SDC                    
 END-PROC                                                                       
*                                                                               
************************************************************************        
REPORT RAPP1 SUMMARY SUMFILE W23155DH NOHEADING NODATE NOPAGE                   
    SEQUENCE EK-IDANSK EK-IDARTNR                                               
    CONTROL  FINAL NOPRINT EK-IDANSK NOPRINT                                    
    TITLE 1  '          '                                                       
    LINE 1   EK-IDANSK U-DISP U-AK U-ARSOMS U-SLAGER U-OLAGER                   
***********************************************************************         
NEWPAGE                                                                         
***********************************************************************         
* DEL 8   MATCHAR W23155DH (GAMLA FILEN) MED W23155DO (NYA FILEN)               
*        OCH SKAPAR EN SLUTFIL FÖR PRINTNING W23155DP                           
***********************************************************************         
*                                                                               
JOB INPUT (W23155DH  KEY UT-ANSK W23155DO KEY TMP3-IDANSK)                      
*                                                                               
  IF MATCHED                                                                    
     ANSK   = UT-ANSK                                                           
     ANTAL  = UT-ANTAL                                                          
     DISP   = UT-DISP                                                           
     AK     = UT-AK                                                             
     ARSOMS = UT-ARSOMS                                                         
     OLAGER = UT-OLAGER                                                         
     SLAGER-2 = UT-SLAGER                                                       
     KVAVBRAD-CDC-1-2 = TMP3-KVAVBRAD-CDC-1-2                                   
     KVAVBRAD-CDC-3-4 = TMP3-KVAVBRAD-CDC-3-4                                   
     KVINORD-CDC-1-2  = TMP3-KVINORD-CDC-1-2                                    
     KVINORD-CDC-3-4  = TMP3-KVINORD-CDC-3-4                                    
     FLRO             = TMP3-FLRO                                               
     FLRO-TAECK       = TMP3-FLRO-TAECK                                         
     PUT W23155DP                                                               
  ELSE                                                                          
     IF W23155DH                                                                
        ANSK   = UT-ANSK                                                        
        ANTAL  = UT-ANTAL                                                       
        DISP   = UT-DISP                                                        
        AK     = UT-AK                                                          
        ARSOMS = UT-ARSOMS                                                      
        OLAGER = UT-OLAGER                                                      
        SLAGER-2 = UT-SLAGER                                                    
        KVAVBRAD-CDC-1-2 = 0                                                    
        KVAVBRAD-CDC-3-4 = 0                                                    
        KVINORD-CDC-1-2  = 0                                                    
        KVINORD-CDC-3-4  = 0                                                    
        FLRO             = 0                                                    
        FLRO-TAECK       = 0                                                    
         PUT W23155DP                                                           
     END-IF                                                                     
  END-IF                                                                        
*                                                                               
NEWPAGE                                                                         
***********************************************************************         
* DEL 9   SKAPAR OCH PRINTAR MEMO-FIL                                           
***********************************************************************         
*                                                                               
JOB INPUT W23155DP                                                              
    IF ANSK = 270 THRU 999                                                      
       IF ANSK = 270 THRU 999                                                   
          AG-GRUPP = 000                                                        
          PERFORM SKAPA-UGRUPP                                                  
       END-IF                                                                   
       IF ANSK = 270 THRU 279                                                   
          AG-GRUPP = 600                                                        
       END-IF                                                                   
       IF ANSK = 400 THRU 599                                                   
          AG-GRUPP = 500                                                        
       END-IF                                                                   
       IF ANSK = 600 THRU 699                                                   
          AG-GRUPP = 600                                                        
       END-IF                                                                   
       IF ANSK = 900 THRU 999                                                   
          AG-GRUPP = 900                                                        
       END-IF                                                                   
       IF ANSK = 700 THRU 899                                                   
          AG-GRUPP = 700                                                        
       END-IF                                                                   
       IF ANSK = 800 THRU 899                                                   
          AG-GRUPP = 800                                                        
       END-IF                                                                   
                                                                                
      W-FLRO           =  0                                                     
      W-FLRO-TAECK     =  0                                                     
      W-KVINORD-TOT  = 0                                                        
      W-KVAVBRAD-TOT = 0                                                        
      W-FLRO           =  W-FLRO + FLRO                                         
      W-FLRO-TAECK     =  W-FLRO-TAECK + FLRO-TAECK                             
      W-KVINORD-TOT  = KVINORD-CDC-1-2 + KVINORD-CDC-3-4                        
      W-KVAVBRAD-TOT = KVAVBRAD-CDC-1-2 + KVAVBRAD-CDC-3-4                      
                                                                                
   END-IF                                                                       
                                                                                
   IF ANSK = 270 THRU 279  +                                                    
   OR ANSK = 400 THRU 999                                                       
      PRINT RAPPORT07                                                           
   END-IF                                                                       
   IF ANSK = 700 THRU 899                                                       
      PRINT RAPPORT00                                                           
   END-IF                                                                       
   IF ANSK = 400 THRU 599                                                       
      PRINT RAPPORT01                                                           
      PRINT RAPPORT10                                                           
   END-IF                                                                       
   IF ANSK = 700 THRU 799                                                       
      IF ANSK = 701 THRU 703 +                                                  
      OR ANSK = 780 THRU 789                                                    
         PRINT RAPPORT13                                                        
         PRINT RAPPORT14                                                        
      ELSE                                                                      
         PRINT RAPPORT02                                                        
         PRINT RAPPORT12                                                        
      END-IF                                                                    
   END-IF                                                                       
   IF ANSK = 270 THRU 279 +                                                     
   OR ANSK = 600 THRU 699                                                       
      PRINT RAPPORT03                                                           
      PRINT RAPPORT11                                                           
   END-IF                                                                       
   IF ANSK = 800 THRU 899                                                       
      PRINT RAPPORT04                                                           
   END-IF                                                                       
   IF ANSK = 270 THRU 279 400 THRU 699 900 THRU 999                             
       PRINT RAPPORT06                                                          
   END-IF                                                                       
   IF ANSK =  910 THRU 919                                                      
      PRINT RAPPORT05                                                           
   END-IF                                                                       
   IF ANSK =  900 THRU 909                                                      
      PRINT RAPPORT08                                                           
   END-IF                                                                       
   IF ANSK =  920 THRU 999                                                      
      PRINT RAPPORT09                                                           
   END-IF                                                                       
