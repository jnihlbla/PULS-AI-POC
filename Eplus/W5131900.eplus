*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5131900                                              *        
*                                                                      *        
*  FUNKTION   :  ÅRLIG RENSNING AV INVENT  MASTERFIL W513.W51312(+0)   *        
*                DET ÄLDSTA ÅRETS TRANSAR LÄGGS PÅ RENSNINGSFIL        *        
*                W513.RENS.W51312 MED NY GENERATION                    *        
*                RESTEN LÄGGS PÅ NY GENERATION W513.W51312(+1)         *        
*  FÖRFATTARE :                                                                 
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W51319D1                                                                   
%W51310 'IN1-'                                                                  
                                                                                
FILE W51319D2 FB(28 0)                                                          
%W51310 'UT1-'                                                                  
* NYTT REGISTER                                                                 
                                                                                
FILE W51319D3 FB(28 0)                                                          
%W51310 'UT2-'                                                                  
* RENSPOSTER                                                                    
                                                                                
***************************                                                     
*WORKING STORAGE          *                                                     
***************************                                                     
                                                                                
W-TIAAAAVV                W 6  N                                                
W-SEKEL      W-TIAAAAVV     2  N                                                
W-AAR        W-TIAAAAVV  +2 2  N                                                
W-VV         W-TIAAAAVV  +4 2  N                                                
                                                                                
W-TIDATUM             W 6  N                                                    
                                                                                
W-PGMNAMN       W 6 A VALUE 'W51319'                                            
W-WDATUM        W 6 A VALUE 'WDATUM'                                            
                                                                                
%WDATKORT                                                                       
                                                                                
NEWPAGE                                                                         
************************************************                                
* STEG 1. RENSAR MASTER                        *                                
************************************************                                
                                                                                
JOB INPUT W51319D1 START A-INIT                                                 
IF IN1-DAVVREG LT W-TIAAAAVV                                                    
***  RENS-POSTER                                                                
  UT2-W51310 EQ IN1-W51310                                                      
  PUT W51319D3                                                                  
ELSE                                                                            
** NYA REG-POSTER                                                               
  UT1-W51310 EQ IN1-W51310                                                      
  PUT W51319D2                                                                  
END-IF                                                                          
                                                                                
A-INIT. PROC                                                                    
  CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                             
  W-SEKEL      = 20                                                             
  W-AAR        = D-AAR                                                          
  W-VV         = 00                                                             
END-PROC                                                                        
