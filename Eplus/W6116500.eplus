                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6116500                                              *        
*                                                                      *        
*  FUNKTION   :  LISTAR ALLA ART.NR. DÄR CD-SALDO > LAGERSALDO         *        
*                                                                      *        
*  FÖRFATTARE :  NIHLBLAD JOHAN                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W61165D1                                                                   
*                                                                               
%W01160                                                                         
                                                                                
NEWPAGE                                                                         
FILE W61165D2  PRINTER FB (121 0)                                               
                                                                                
NEWPAGE                                                                         
WS-IDARTNR          W          5       P  MASK 'ZZZZZZZZZ' VALUE 0              
WS-KVLS             W          7       N   MASK '------9' VALUE 0               
WS-KVLS-CDTOT       W          7       N   MASK '------9' VALUE 0               
WS-OMR-1            W          2       P  MASK 'ZZ9'       VALUE 0              
WS-GANG-1           W          2       P  MASK 'ZZZ'       VALUE 0              
WS-PLATS-1          W          3       P  MASK 'ZZZZZ'     VALUE 0              
WS-TECKEN-1         W          1       A                                        
WS-KVLS-CD1         W          7       N   MASK '------9' VALUE 0               
WS-OMR-2            W          2       P  MASK 'ZZ9'       VALUE 0              
WS-GANG-2           W          2       P  MASK 'ZZZ'       VALUE 0              
WS-PLATS-2          W          3       P  MASK 'ZZZZZ'     VALUE 0              
WS-TECKEN-2         W          1       A                                        
WS-KVLS-CD2         W          7       N   MASK '------9' VALUE 0               
WS-OMR-3            W          2       P  MASK 'ZZ9'       VALUE 0              
WS-GANG-3           W          2       P  MASK 'ZZZ'       VALUE 0              
WS-PLATS-3          W          3       P  MASK 'ZZZZZ'     VALUE 0              
WS-TECKEN-3         W          1       A                                        
WS-KVLS-CD3         W          7       N   MASK '------9' VALUE 0               
WS-OMR-4            W          2       P  MASK 'ZZ9'       VALUE 0              
WS-GANG-4           W          2       P  MASK 'ZZZ'       VALUE 0              
WS-PLATS-4          W          3       P  MASK 'ZZZZZ'     VALUE 0              
WS-TECKEN-4         W          1       A                                        
WS-KVLS-CD4         W          7       N   MASK '------9' VALUE 0               
IX                  W          1       N                   VALUE 0              
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. SUMMERAR CD-SALDO OCH LÄGGER UT NÄR > LAGERSALDO                      
*                                                                               
JOB INPUT W61165D1                                                              
    IX = 1                                                                      
    MOVE ZERO TO WS-KVLS-CDTOT                                                  
    DO WHILE IX < 5                                                             
      WS-KVLS-CDTOT = CLAG-KVLS-CD(IX) + WS-KVLS-CDTOT                          
      IX = IX + 1                                                               
    END-DO                                                                      
    IF CLAG-FLCDART = 'J'                                                       
      IF WS-KVLS-CDTOT GT CLAG-KVLS                                             
        WS-OMR-1         = CLAG-ADLAGOMR-CD(1)                                  
        WS-GANG-1        = CLAG-ADGANG-CD(1)                                    
        WS-PLATS-1       = CLAG-ADPLATS-CD(1)                                   
        WS-KVLS-CD1      = CLAG-KVLS-CD(1)                                      
        WS-OMR-2         = CLAG-ADLAGOMR-CD(2)                                  
        WS-GANG-2        = CLAG-ADGANG-CD(2)                                    
        WS-PLATS-2       = CLAG-ADPLATS-CD(2)                                   
        WS-KVLS-CD2      = CLAG-KVLS-CD(2)                                      
        WS-OMR-3         = CLAG-ADLAGOMR-CD(3)                                  
        WS-GANG-3        = CLAG-ADGANG-CD(3)                                    
        WS-PLATS-3       = CLAG-ADPLATS-CD(3)                                   
        WS-KVLS-CD3      = CLAG-KVLS-CD(3)                                      
        WS-OMR-4         = CLAG-ADLAGOMR-CD(4)                                  
        WS-GANG-4        = CLAG-ADGANG-CD(4)                                    
        WS-PLATS-4       = CLAG-ADPLATS-CD(4)                                   
        WS-KVLS-CD4      = CLAG-KVLS-CD(4)                                      
        WS-IDARTNR = CLAG-IDARTNR                                               
        IF CLAG-KVLS-CD(1) LT 0                                                 
          WS-TECKEN-1 = '-'                                                     
        ELSE                                                                    
          WS-TECKEN-1 = ' '                                                     
        END-IF                                                                  
        IF CLAG-KVLS-CD(2) LT 0                                                 
          WS-TECKEN-2 = '-'                                                     
        ELSE                                                                    
          WS-TECKEN-2 = ' '                                                     
        END-IF                                                                  
        IF CLAG-KVLS-CD(3) LT 0                                                 
          WS-TECKEN-3 = '-'                                                     
        ELSE                                                                    
          WS-TECKEN-3 = ' '                                                     
        END-IF                                                                  
        IF CLAG-KVLS-CD(4) LT 0                                                 
          WS-TECKEN-4 = '-'                                                     
        ELSE                                                                    
          WS-TECKEN-4 = ' '                                                     
        END-IF                                                                  
        PRINT W61165-001                                                        
      END-IF                                                                    
    END-IF                                                                      
                                                                                
NEWPAGE                                                                         
REPORT W61165-001  PRINTER W61165D2 LINESIZE 120 DTLCTL FIRST +                 
       NOADJUST NOHEADING TITLESKIP 2 PAGESIZE 41 SPACE 2                       
                                                                                
TITLE 1  '                                                  +                   
          VCCS           W61165-001      '                                      
TITLE 2  '                                      +                               
          ARTIKELNUMMER DÄR CD-SALDO > LAGERSALDO '                             
TITLE 3  COL 4   'ART.NR.'               +                                      
         COL 14  'LAG.OMR-CD1'           +                                      
         COL 28  'SALDO-CD1'             +                                      
         COL 40  'LAG.OMR-CD2'           +                                      
         COL 54  'SALDO-CD2'             +                                      
         COL 66  'LAG.OMR-CD3'           +                                      
         COL 80  'SALDO-CD3'             +                                      
         COL 92  'LAG.OMR-CD4'           +                                      
         COL 106 'SALDO-CD4'                                                    
                                                                                
LINE  1  COL 4   WS-IDARTNR              +                                      
         COL 14  WS-OMR-1                +                                      
         COL 18  WS-GANG-1               +                                      
         COL 22  WS-PLATS-1              +                                      
         COL 27  WS-TECKEN-1             +                                      
         COL 28  WS-KVLS-CD1             +                                      
         COL 40  WS-OMR-2                +                                      
         COL 44  WS-GANG-2               +                                      
         COL 48  WS-PLATS-2              +                                      
         COL 53  WS-TECKEN-2             +                                      
         COL 54  WS-KVLS-CD2             +                                      
         COL 66  WS-OMR-3                +                                      
         COL 70  WS-GANG-3               +                                      
         COL 74  WS-PLATS-3              +                                      
         COL 79  WS-TECKEN-3             +                                      
         COL 80  WS-KVLS-CD3             +                                      
         COL 92  WS-OMR-4                +                                      
         COL 96  WS-GANG-4               +                                      
         COL 100 WS-PLATS-4              +                                      
         COL 105 WS-TECKEN-4             +                                      
         COL 106 WS-KVLS-CD4                                                    
