     TMP1-SUORDV-LOC     = E64-SUORDV-LOC                                       
     TMP1-SUORDV-LOCPREL = E64-SUORDV-LOCPREL                                   
     TMP1-VKORDBTO-KOLLI = E64-VKORDBTO-KOLLI                                   
     TMP1-VKORDNTO-KOLLI = E64-VKORDNTO-KOLLI                                   
     TMP1-IDFTG          = E64-IDFTG                                            
     TMP1-IDDC-RET       = E64-IDDC-RET                                         
     TMP1-IDSHIPM        = E64-IDSHIPM                                          
     TMP1-TISKEPPN       = E64-TISKEPPN                                         
                                                                                
     PUT TEMPFIL1                                                               
END-PROC                                                                        
NEWPAGE                                                                         
