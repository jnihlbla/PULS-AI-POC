                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6112500                                              *        
*                                                                      *        
*  FUNKTION   :  LOGGADE R34-TRANSAR                                   *        
*                LISTA ÖVER GJORDA R34-TRANSAR SENASTE VECKAN SOM FIL  *        
*                TILL ONDEMAND                                         *        
*                                                                      *        
*  FÖRFATTARE :  EVA LUNDELL                                           *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W61125D1                                                                   
*                                                                               
%W601R34A  'IN-'                                                                
*                                                                               
NEWPAGE                                                                         
FILE W61125D2  PRINTER FB (121 121)                                             
                                                                                
NEWPAGE                                                                         
                                                                                
FILE W61125D3 FB  (201 0)                                                       
UTAREA         1 200 A                                                          
*                                                                               
UT-AREA           W  200  A                                                     
UT-IDDC           UT-AREA       2  A                                            
W-SEMI-1          UT-AREA  +2   1  A VALUE ';'                                  
UT-IDARTNR        UT-AREA  +3   10 N                                            
W-SEMI-2          UT-AREA  +13  1  A  VALUE ';'                                 
UT-IDLEVNR        UT-AREA  +14  5  A                                            
W-SEMI-3          UT-AREA  +19  1  A VALUE ';'                                  
UT-KDRT           UT-AREA  +20  2  N                                            
W-SEMI-4          UT-AREA  +22  1  A VALUE ';'                                  
UT-IDAVINR        UT-AREA  +23  7  N                                            
W-SEMI-5          UT-AREA  +30  1  A VALUE ';'                                  
UT-TIAVIDAT       UT-AREA  +31  6  N                                            
W-SEMI-6          UT-AREA  +37  1  A VALUE ';'                                  
UT-KVAVIS         UT-AREA  +38  7  N                                            
W-SEMI-7          UT-AREA  +45  1  A VALUE ';'                                  
UT-IDKONTO        UT-AREA  +46  9  N                                            
W-SEMI-8          UT-AREA  +55  1  A VALUE ';'                                  
UT-IDARTNR-FROM   UT-AREA  +56  10 A                                            
W-SEMI-9          UT-AREA  +66  1  A VALUE ';'                                  
UT-SIGNON-USERID  UT-AREA  +67  8  A                                            
W-SEMI-10         UT-AREA  +75  1  A VALUE ';'                                  
UT-REPORTID       UT-AREA  +76  8  A VALUE 'W61124-0'                           
UT-IDDC1          UT-AREA  +84  2  A                                            
W-SEMI-11         UT-AREA  +86  1  A VALUE ';'                                  
UT-LEGSEL         UT-AREA  +87  4  A VALUE 'VCCS'                               
W-SEMI-12         UT-AREA  +91  1  A VALUE ';'                                  
UT-REPORTNM       UT-AREA  +92  17 A VALUE 'R34-TRANSACTIONS '                  
UT-REPORTNM1      UT-AREA  +109 19 A VALUE 'PERFORMED LAST WEEK'                
W-SEMI-13         UT-AREA  +128 1  A VALUE ';'                                  
UT-AAR            UT-AREA  +129 2  N                                            
UT-MM             UT-AREA  +131 2  N                                            
UT-DD             UT-AREA  +133 2  N                                            
                                                                                
*                                                                               
*HEADER AREA                                                                    
W-RUBRIK1                 W 195   A                                             
W-RUB1-LINE01 W-RUBRIK1          57   A                      +                  
  VALUE 'DISTRUBUTION_CENTER;PART_NUMBER;SUPPLIER;ACCOUNTING_TYPE;'             
W-RUB1-LINE02 W-RUBRIK1    +57   52   A                      +                  
  VALUE 'ADVICE_NOTE_NUMBER;ADVICE_NOTE_DATE;ADVICE_QUANTITY;'                  
W-RUB1-LINE03 W-RUBRIK1    +109  50   A                      +                  
  VALUE 'ACCOUNT_NUMBER;PART_NUMBER_FROM;USER_ID;REPORT_ID;'                    
W-RUB1-LINE04 W-RUBRIK1    +159  36   A                      +                  
  VALUE 'LEGAL_SELLER;REPORT_NAME;REPORT_DATE'                                  
NEWPAGE                                                                         
                                                                                
W-DATUM              W                   6  N                                   
W-AAR  W-DATUM                           2  N                                   
W-MM   W-DATUM                       +2  2  N                                   
W-DD   W-DATUM                       +4  2  N                                   
FIRST-TIME-SW          W    1  A  VALUE 'J'                                     
                                                                                
WS-IDPTYP        W   3  A                                                       
WS-IDDC          W   2  A                                                       
WS-IDARTNR       W   5  P  MASK 'ZZZZZZZZZ' VALUE 0                             
WS-IDLEVNR       W   5  A                                                       
WS-KDRT          W   2  P  MASK 'ZZZ' VALUE 0                                   
WS-IDAVINR       W   4  P  MASK 'ZZZZZZZ' VALUE 0                               
WS-TIAVIDAT      W   4  P  MASK 'ZZZZZZZ' VALUE 0                               
WS-KVAVIS        W   4  P  MASK 'ZZZZZZZ' VALUE 0                               
WS-IDKONTO       W   6  P  MASK 'ZZZZZZZZZZZ' VALUE 0                           
WS-IDARTNR-FROM  W   5  P  MASK 'ZZZZZZZZZ' VALUE 0                             
WS-SIGNON-USERID W   8  A                                                       
JA              W   1  A  VALUE 'J'                                             
NEJ             W   1  A  VALUE 'N'                                             
TITEL-PV        W  35  A  VALUE 'VOLVO CAR CORPORATION, AFTERSALES'             
TITEL-RUBRIK-S  W  38  A  VALUE 'GJORDA R34-TRANSAR UNDER VECKAN'               
TITEL-RUBRIK-GB W  38  A  VALUE 'R34-TRANSACTIONS PERFORMED LAST WEEK  '        
                                                                                
*--------------------------*                                                    
* DATUMKORT                *                                                    
*--------------------------*                                                    
                                                                                
PROGRAM-NAMN   W    8    A        VALUE 'W6112500'                              
DATUMKORT-ID   W    6    A        VALUE 'WDATUM'                                
                                                                                
%WDATKORT                                                                       
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
* STEG 1. LISTA ÖVER GJORDA R34-TRANSAR SENASTE VECKAN                          
*                                                                               
JOB INPUT W61125D1 START A-INIT FINISH Z-FINISH                                 
                                                                                
      WS-IDPTYP = IN-IDPTYP                                                     
      WS-IDDC   = IN-IDDC                                                       
      WS-IDLEVNR = IN-IDLEVNR                                                   
      WS-KDRT   = IN-KDRT                                                       
      WS-IDAVINR = IN-IDAVINR                                                   
      WS-KVAVIS = IN-KVAVIS                                                     
      WS-TIAVIDAT = IN-TIAVIDAT                                                 
      WS-IDARTNR = IN-IDARTNR                                                   
      WS-IDARTNR-FROM = IN-IDARTNR-FROM                                         
      WS-IDKONTO = IN-IDKONTO                                                   
      WS-SIGNON-USERID = IN-SIGNON-USERID                                       
                                                                                
      PRINT ONDEMAND                                                            
                                                                                
     IF FIRST-TIME-SW = 'J'                                                     
       UTAREA        = W-RUBRIK1                                                
       PUT    W61125D3                                                          
       FIRST-TIME-SW = 'N'                                                      
     END-IF                                                                     
                                                                                
      UT-IDDC   = IN-IDDC                                                       
      UT-IDDC1  = IN-IDDC                                                       
      UT-IDLEVNR = IN-IDLEVNR                                                   
      UT-KDRT   = IN-KDRT                                                       
      UT-IDAVINR = IN-IDAVINR                                                   
      UT-KVAVIS = IN-KVAVIS                                                     
      UT-TIAVIDAT = IN-TIAVIDAT                                                 
      UT-IDARTNR = IN-IDARTNR                                                   
      UT-IDARTNR-FROM = IN-IDARTNR-FROM                                         
      UT-IDKONTO = IN-IDKONTO                                                   
      UT-SIGNON-USERID = IN-SIGNON-USERID                                       
                                                                                
      UTAREA      =  UT-AREA                                                    
      PUT   W61125D3                                                            
                                                                                
A-INIT. PROC                                                                    
     CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                   
     W-AAR  = D-AAR                                                             
     W-MM   = D-MAANAD                                                          
     W-DD   = D-DAG                                                             
     UT-AAR  = D-AAR                                                            
     UT-MM   = D-MAANAD                                                         
     UT-DD   = D-DAG                                                            
END-PROC                                                                        
                                                                                
Z-FINISH.  PROC                                                                 
END-PROC                                                                        
NEWPAGE                                                                         
**************************************************************                  
*  FIL TILL ONDEMAND                                         *                  
**************************************************************                  
                                                                                
REPORT ONDEMAND PRINTER W61125D2 LINESIZE 120 NODATE NOADJUST +                 
       NOPAGE PAGESIZE 999                                                      
SEQUENCE WS-IDDC                                                                
CONTROL WS-IDDC NOPRINT NEWPAGE                                                 
TITLE 01 COL 1 'W61124-0'                               +                       
         COL 9 WS-IDDC                                  +                       
         COL 20 'VCCS'                                  +                       
         COL 40 'R34-TRANSACTIONS PERFORMED LAST WEEK'  +                       
         COL 90 'DC: '                                  +                       
         COL 94 WS-IDDC                                 +                       
         COL 100 'DATE: '                               +                       
         COL 106 W-DATUM                                                        
                                                                                
                                                                                
HEADING  WS-IDDC            ('DC')                                              
HEADING  WS-IDLEVNR         ('SUPP.')                                           
HEADING  WS-KDRT            (' AT')                                             
HEADING  WS-IDAVINR         ('ADVNO')                                           
HEADING  WS-TIAVIDAT        ('ADVDATE ')                                        
HEADING  WS-IDARTNR         ('  PARTNO')                                        
HEADING  WS-KVAVIS          ('ADVICED' 'QTY')                                   
HEADING  WS-IDKONTO         ('ACCOUNT')                                         
HEADING  WS-IDARTNR-FROM    ('FROM' 'PARTNO')                                   
HEADING  WS-SIGNON-USERID   ('USERID')                                          
LINE     WS-IDDC WS-IDLEVNR WS-KDRT WS-IDAVINR WS-TIAVIDAT +                    
         WS-IDARTNR WS-KVAVIS WS-IDKONTO WS-IDARTNR-FROM +                      
         WS-SIGNON-USERID                                                       
