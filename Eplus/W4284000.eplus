                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W42840                                                *        
*                                                                      *        
*  FUNKTION   :  SELEKTERAR UT KREDITERADE RADER UNDER PERIODEN        *        
*                FRÅN FIL W41842 OCH SKRIVER EN UTFIL.                 *        
*                                                                      *        
*  FÖRFATTARE :  JAN-ERIK FRANTZEN                                     *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     031028      SUSANNE OLSSON           9233                        *        
*     050823      SUSANNE OLSSON           9235  E-TRACKER 1572353     *        
*     051213      SUSANNE OLSSON           9235  E-TRACKER 2913019     *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W42840D1                                                                   
W41842-IDPTYP 1 3    A                                                          
WDA201-DATA   4 145  A                                                          
WDA211-DATA   4 288  A                                                          
WDA221-DATA   4 1051 A                                                          
*                                                                               
FILE W42840D2 FB (40 0)                                                         
%W42840      'UT-'                                                              
*                                                                               
NEWPAGE                                                                         
*                                                                               
%WDA201                                                                         
*                                                                               
%WDA211                                                                         
*                                                                               
*COPYTEXTER FÖR CALL                                                            
*                                                                               
%WDATAREA                                                                       
*                                                                               
WDATKONV        W  8   A   VALUE 'WDATKONV'                                     
*                                                                               
*---------------- LÄNKAREA FÖR DATUMKORT                                        
%WDATKORT     'DAT-'                                                            
*                                                                               
    JA                    W          1         A  VALUE 'J'                     
    NEJ                   W          1         A  VALUE 'N'                     
    PROGRAM-NAMN          W          6         A  VALUE 'W42840'                
    DATUMKORT-ID          W          6         A  VALUE 'WDATUM'                
    WS-TIAARP             W          4         N                                
    WS-DATUM              W          6         N                                
    WS-KVLEVANM           W          6         N                                
    WS-AAR                WS-DATUM   2         N                                
    WS-MAANAD             WS-DATUM  +2  2      N                                
    WS-DAG                WS-DATUM  +4  2      N                                
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
*                                                                               
* SELEKTERAR UT DATA FRÅN WDA2                                                  
*                                                                               
 JOB INPUT W42840D1 START A-INIT                                                
 IF W41842-IDPTYP                     = '201'                                   
   ANM-WDA201                        = WDA201-DATA                              
 ELSE                                                                           
   IF W41842-IDPTYP                  = '211'                                    
     LEV-WDA211                      = WDA211-DATA                              
     DAT-KDDATFORM                   = 'AAMMDD'                                 
     IF LEV-TIKNOTA > +0                                                        
       DAT-I-TIDATUM                 = LEV-TIKNOTA                              
       CALL WDATKONV USING (DAT-KDDATFORM +                                     
                           DAT-I-TIDATUM +                                      
                           DAT-O-TIDATUM +                                      
                           DAT-KDSVAR)                                          
       IF DAT-KDSVAR = ' '                                                      
         UT-TIKNOTA-TISEKEL-PER      = DAT-TISEKEL                              
         UT-TIKNOTA-TIAAPP           = DAT-TIAARP                               
       ELSE                                                                     
         DISPLAY 'FEL FRÅN DATKONV TIKNOTA = ' LEV-TIKNOTA                      
         UT-TIKNOTA-SAAPP            = '000000'                                 
       END-IF                                                                   
     ELSE                                                                       
       UT-TIKNOTA-SAAPP              = '000000'                                 
     END-IF                                                                     
*                                                                               
     IF LEV-TIFAKT > +0                                                         
       DAT-I-TIDATUM                   = LEV-TIFAKT                             
       CALL WDATKONV USING (DAT-KDDATFORM +                                     
                           DAT-I-TIDATUM +                                      
                           DAT-O-TIDATUM +                                      
                           DAT-KDSVAR)                                          
       IF DAT-KDSVAR = ' '                                                      
         UT-TIFAKT-TISEKEL-PER         = DAT-TISEKEL                            
         UT-TIFAKT-TIAAPP              = DAT-TIAARP                             
       ELSE                                                                     
         DISPLAY 'FEL FRÅN DATKONV TIFAKT = ' LEV-TIFAKT                        
         UT-TIFAKT-SAAPP               = '000000'                               
       END-IF                                                                   
     ELSE                                                                       
       UT-TIFAKT-SAAPP                 = '000000'                               
     END-IF                                                                     
   END-IF                                                                       
 END-IF                                                                         
*                                                                               
 IF W41842-IDPTYP                    = '211'                                    
    IF LEV-TIKNOTA > 0                                                          
      IF UT-TIKNOTA-TIAAPP = WS-TIAARP                                          
         UT-IDDISTR                  = ANM-IDDISTR                              
         UT-IDKUNDNR                 = ANM-IDKUNDNR                             
         UT-IDDC                     = LEV-IDDC                                 
         UT-IDDC-RET                 = LEV-IDDC-RET                             
         UT-IDFTG                    = ANM-IDFTG                                
         UT-KDORDKL                  = LEV-KDORDKL                              
         UT-KDANMORS                 = LEV-KDANMORS                             
         IF LEV-TIINLINL > 0                                                    
            WS-KVLEVANM  = LEV-KVRETINL + LEV-KVRETINL-SKR                      
         ELSE                                                                   
            WS-KVLEVANM  = LEV-KVLEVANM-BEKR                                    
         END-IF                                                                 
         UT-SUKRENOT = WS-KVLEVANM * LEV-PRARTBTO                               
         PUT W42840D2                                                           
      END-IF                                                                    
    END-IF                                                                      
 END-IF                                                                         
                                                                                
NEWPAGE                                                                         
*------------------------------------------------------*                        
* A-INIT    HÄMTAR DAGENS DATUM, INNEVARANDE PERIOD MM *                        
*------------------------------------------------------*                        
*                                                                               
 A-INIT.  PROC                                                                  
*                                                                               
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DAT-DATUMKORT)                  
*                                                                               
  WS-AAR    = DAT-D-AAR                                                         
  WS-MAANAD = DAT-D-MAANAD                                                      
  WS-DAG    = DAT-D-DAG                                                         
* WS-AAR    = 96                                                                
* WS-MAANAD = 06                                                                
* WS-DAG    = 29                                                                
  DISPLAY ' DAGENS DATUM : ' WS-DATUM                                           
*                                                                               
  DAT-I-TIDATUM = WS-DATUM                                                      
  DAT-KDDATFORM = 'AAMMDD'                                                      
  CALL WDATKONV USING (DAT-KDDATFORM DAT-I-TIDATUM DAT-O-TIDATUM +              
                       DAT-KDSVAR)                                              
*                                                                               
  IF DAT-KDSVAR NE ' '                                                          
     DISPLAY ' *************************** '                                    
     DISPLAY ' FEL VID ANROP TILL WDATKONV '                                    
     DISPLAY ' *************************** '                                    
     STOP EXECUTE                                                               
  END-IF                                                                        
  WS-TIAARP           = DAT-TIAARP                                              
  DISPLAY ' INNEVARANDE PERIOD ' WS-TIAARP                                      
 END-PROC                                                                       
                                                                                
*                                                                               
SORT W42840D2 TO W42840D2 USING +                                               
     (UT-IDDISTR, UT-IDKUNDNR, UT-IDDC, UT-KDORDKL, UT-KDANMORS)                
                                                                                
