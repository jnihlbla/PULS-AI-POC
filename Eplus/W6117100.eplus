                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6117100                                              *        
*                                                                      *        
*  FUNKTION   :  LISTA, VÄRDE OCH VIKT PER STATNR, FÖR ARTIKLAR        *        
*                INLEVERADE PÅ C2, SENASTE MÅNADEN                     *        
*                                                                      *        
*                LISTA TILL NEDERLÄNDSK TULL                           *        
*                                                                      *        
*                                                                      *        
*  FÖRFATTARE :  STEFAN KIHLBERG                                       *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W61171D1                                                                   
*                                                                               
%W61170  'IN-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE W61171D2  PRINTER FB (121 0)                                               
                                                                                
BRYT-IDSTATNR W   9   N                                                         
                                                                                
WS-DATUM             W   6   A                                                  
WS-AAR               WS-DATUM     2   A                                         
WS-MAN               WS-DATUM +2  2   A                                         
WS-DAG               WS-DATUM +4  2   A                                         
                                                                                
UT-DATUM             W   6   A                                                  
UT-AAR               W   2   A                                                  
UT-MAN               W   2   A                                                  
                                                                                
UT-IDSTATNR   W   9   N      MASK 'ZZZZZZZZ9'                                   
UT-SUARTBES   W  11   N   2  MASK 'ZZZZZZZZ9:99'                                
WS-VKARTTOT   W  17   N   3  MASK 'ZZZZZZZZZZZZZ9.999'                          
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
* STEG 1. LISTA                                                                 
*                                                                               
JOB INPUT W61171D1                                                              
                                                                                
                                                                                
BRYT-IDSTATNR = IN-IDSTATNR                                                     
                                                                                
WS-DATUM     =  IN-TIAAMMDD-GAELL                                               
                                                                                
UT-DATUM     =  WS-DATUM                                                        
UT-AAR       =  WS-AAR                                                          
UT-MAN       =  WS-MAN                                                          
                                                                                
UT-IDSTATNR =  IN-IDSTATNR                                                      
UT-SUARTBES =  IN-SUARTBES                                                      
WS-VKARTTOT =  IN-VKARTTOT / 1000                                               
                                                                                
  PRINT TULLISTA                                                                
                                                                                
                                                                                
NEWPAGE                                                                         
REPORT TULLISTA  PRINTER W61171D2    +                                          
                 SUMMARY             +                                          
                 LINESIZE 120        +                                          
                 DTLCTL FIRST        +                                          
                 SUMCTL DTLCOPY      +                                          
                 NOADJUST            +                                          
                 NOHEADING           +                                          
                 TITLESKIP 2         +                                          
                 SKIP 1                                                         
                                                                                
CONTROL BRYT-IDSTATNR                +                                          
        IN-KDARTURS                                                             
                                                                                
SUM     WS-VKARTTOT                   +                                         
        UT-SUARTBES                   +                                         
        IN-KVANTMOT                                                             
                                                                                
TITLE 1  ' '                                                                    
                                                                                
TITLE 2  COL 002  'VOLVO CAR AFTERSALES'           +                            
         COL 030  'W61171-001'                     +                            
         COL 050  'INCOMMING DELIVERYS TO BORN'    +                            
         COL 090  'DATE'                           +                            
         COL 097  UT-DATUM                                                      
                                                                                
TITLE 3  COL 030  '--------------------------------------------+                
                   ---'                                                         
                                                                                
TITLE 4  ' '                                                                    
                                                                                
TITLE 5  COL 030  'MONTHLY REPORT PER COSTUMTARIFF NUMBERS' +                   
         COL 071  UT-AAR                                    +                   
         COL 073  '-'                                       +                   
         COL 074  UT-MAN                                                        
                                                                                
TITLE 6  ' '                                                                    
                                                                                
TITLE 7  COL 018  'CUSTOM'                +                                     
         COL 033  'ORIGIN'                +                                     
         COL 052  'QUANTITY'              +                                     
         COL 072  'NET WEIGHT'            +                                     
         COL 101  'TOT AMOUNT'                                                  
                                                                                
TITLE 8  COL 018  'TARIFF'                +                                     
         COL 078  '(KG)'                  +                                     
         COL 106  '(SEK)'                                                       
                                                                                
LINE  1  COL 015   UT-IDSTATNR     +                                            
         COL 037   IN-KDARTURS     +                                            
         COL 048   IN-KVANTMOT     +                                            
         COL 063   WS-VKARTTOT     +                                            
         COL 096   UT-SUARTBES                                                  
                                                                                
AFTER-BREAK.  PROC                                                              
   IF LEVEL = 2                                                                 
      DISPLAY ' '                                                               
   END-IF                                                                       
END-PROC                                                                        
