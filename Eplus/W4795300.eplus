                                                                                
*******************************************************************             
* W4795300                                                        *             
* SORTERAR OCH MATCHAR W47952 OCH W47963                          *             
* SKRIVER W47953, ORDER I ARBETE, W47905B, W479057                *             
****** ************************************************************             
FILE W47953D1                                                                   
%W479052  'E52-'                                                                
NEWPAGE                                                                         
*                                                                               
FILE W47953D3                                                                   
%W479063 'E63-'                                                                 
NEWPAGE                                                                         
*                                                                               
FILE TEMPFIL1 VIRTUAL FB (188 0)                                                
%W479057  'TMP1-'                                                               
NEWPAGE                                                                         
*                                                                               
FILE W47953D5                                                                   
%W011100  'DLB-'                                                                
NEWPAGE                                                                         
*                                                                               
FILE TEMPFIL2 VIRTUAL FB (188 0)                                                
%W479057  'TMP2-'                                                               
NEWPAGE                                                                         
*                                                                               
FILE W47953D6 FB (167 0)                                                        
%W479053  'U53-'                                                                
NEWPAGE                                                                         
*                                                                               
FILE W47953D7 FB (56 0)                                                         
%W47905B 'U5B-'                                                                 
NEWPAGE                                                                         
*                                                                               
FILE W47953D8 FB (188 0)                                                        
%W479057  'U57-'                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
W-IDDISTR     W  3 P 0                                                          
W-IDKUNDNR    W  4 P 0                                                          
W-IDKUNDRF    W 10 A                                                            
W-IDPRODNR    W  4 P 0                                                          
W-IDRADNR-KO  W  3 P 0                                                          
*                                                                               
FL-SKRIV-POST   W  1 A                                                          
JA              W  1 A  VALUE 'J'                                               
NEJ             W  1 A  VALUE 'N'                                               
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT (W47953D1 KEY (E52-IDDISTR       +                                    
                         E52-IDKUNDNR      +                                    
                         E52-IDKUNDRF      +                                    
                         E52-IDPRODNR      +                                    
                         E52-IDPURAD)      +                                    
           W47953D3 KEY (E63-IDDISTR       +                                    
                         E63-IDKUNDNR      +                                    
                         E63-IDKUNDRF      +                                    
                         E63-IDPRODNR      +                                    
                         E63-IDRADNR-KO))                                       
                                                                                
IF MATCHED                                                                      
  IF E52-IDDISTR      = W-IDDISTR   AND  +                                      
     E52-IDKUNDNR     = W-IDKUNDNR  AND  +                                      
     E52-IDKUNDRF     = W-IDKUNDRF  AND  +                                      
     E52-IDPRODNR     = W-IDPRODNR  AND  +                                      
     E52-IDPURAD      = W-IDRADNR-KO                                            
    IF E63-IDFAKT = 0                                                           
      IF FL-SKRIV-POST = NEJ                                                    
        FL-SKRIV-POST = JA                                                      
        IF E63-KDKOLSTA GE 7                                                    
           TMP1-KVEFRS-SKEPP = E63-KVLEVART                                     
        ELSE                                                                    
           TMP1-KVEFRS-PACK = E63-KVLEVART                                      
        END-IF                                                                  
        PERFORM B-FLYTTA-OVRIGA-FALT                                            
      ELSE                                                                      
        IF E63-KDKOLSTA GE 7                                                    
           TMP1-KVEFRS-SKEPP = TMP1-KVEFRS-SKEPP + E63-KVLEVART                 
        ELSE                                                                    
           TMP1-KVEFRS-PACK = TMP1-KVEFRS-PACK + E63-KVLEVART                   
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
  ELSE                                                                          
    IF FL-SKRIV-POST = JA                                                       
       IF E63-KDKOLSTA GE 7                                                     
          TMP1-KVEFRS-OPACK = TMP1-KVAVBART - TMP1-KVEFRS-PACK         +        
                              - TMP1-KVEFRS-SKEPP                               
       ELSE                                                                     
          TMP1-KVEFRS-OPACK = TMP1-KVAVBART - TMP1-KVEFRS-PACK                  
       END-IF                                                                   
      PUT TEMPFIL1                                                              
      FL-SKRIV-POST = NEJ                                                       
    END-IF                                                                      
                                                                                
    W-IDDISTR     = E52-IDDISTR                                                 
    W-IDKUNDNR    = E52-IDKUNDNR                                                
    W-IDKUNDRF    = E52-IDKUNDRF                                                
    W-IDPRODNR    = E52-IDPRODNR                                                
    W-IDRADNR-KO  = E52-IDPURAD                                                 
                                                                                
    IF E63-IDFAKT = 0                                                           
      FL-SKRIV-POST   = JA                                                      
      IF E63-KDKOLSTA GE 7                                                      
         TMP1-KVEFRS-SKEPP = E63-KVLEVART                                       
         TMP1-KVEFRS-PACK  = 0                                                  
      ELSE                                                                      
         TMP1-KVEFRS-PACK  = E63-KVLEVART                                       
         TMP1-KVEFRS-SKEPP = 0                                                  
      END-IF                                                                    
      PERFORM B-FLYTTA-OVRIGA-FALT                                              
    END-IF                                                                      
  END-IF                                                                        
ELSE                                                                            
  IF FL-SKRIV-POST = JA                                                         
    TMP1-KVEFRS-OPACK = TMP1-KVAVBART - TMP1-KVEFRS-PACK                        
    PUT TEMPFIL1                                                                
    FL-SKRIV-POST = NEJ                                                         
  END-IF                                                                        
                                                                                
  IF W47953D1                                                                   
    IF E52-KVLEVART NE 0                                                        
      DISPLAY '***********************************************'                 
      DISPLAY 'KOLLI KOPPLING SAKNAS'                                           
      DISPLAY 'IDDISTR    >' E52-IDDISTR                                        
      DISPLAY 'IDKUNDNR   >' E52-IDKUNDNR                                       
      DISPLAY 'IDKUNDRF   >' E52-IDKUNDRF                                       
      DISPLAY 'IDPRODNR   >' E52-IDPRODNR                                       
      DISPLAY 'IDPURAD    >' E52-IDPURAD                                        
      DISPLAY 'KVLEVART   >' E52-KVLEVART                                       
      DISPLAY '***********************************************'                 
*RETURN-CODE = 999                                                              
*     STOP EXECUTE                                                              
    ELSE                                                                        
      IF E52-KDRADSTA < 4                                                       
        TMP1-KVEFRS-OPACK = E52-KVAVBART                                        
        TMP1-KVEFRS-PACK = 0                                                    
        TMP1-KVEFRS-SKEPP = 0                                                   
        PERFORM B-FLYTTA-OVRIGA-FALT                                            
        PUT TEMPFIL1                                                            
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
*                                                                               
NEWPAGE                                                                         
B-FLYTTA-OVRIGA-FALT. PROC                                                      
     TMP1-IDDISTR           = E52-IDDISTR                                       
     TMP1-IDKUNDNR          = E52-IDKUNDNR                                      
     TMP1-IDKUNDRF          = E52-IDKUNDRF                                      
     TMP1-FLOVRLEV          = E52-FLOVRLEV                                      
     TMP1-IDPRODNR          = E52-IDPRODNR                                      
     TMP1-IDDC              = E52-IDDC                                          
     TMP1-KDFAKTYP          = E52-KDFAKTYP                                      
     TMP1-KDFRAKT           = E52-KDFRAKT                                       
     TMP1-KDORDKL           = E52-KDORDKL                                       
     TMP1-KVORDRAD-PACK     = E52-KVORDRAD-PACK                                 
     TMP1-TIBEGPAC          = E52-TIBEGPAC                                      
     TMP1-TIUTSKR           = E52-TIUTSKR                                       
     TMP1-TIREF1            = E52-TIREF1                                        
     TMP1-TIORDREG          = E52-TIORDREG                                      
     TMP1-IDARTNR           = E52-IDARTNR                                       
     TMP1-REKSIFFR          = E52-REKSIFFR                                      
     TMP1-IDARTNR-ERS       = E52-IDARTNR-ERS                                   
     TMP1-ADLEVPL           = E52-ADLEVPL                                       
     TMP1-BERADREF          = E52-BERADREF                                      
     TMP1-FLKRED            = E52-FLKRED                                        
     MOVE SPACE        TO TMP1-LOW-VALUE1                                       
     TMP1-FLDIRLEV          = E52-FLDIRLEV                                      
     TMP1-FLRESTN           = E52-FLRESTN                                       
     TMP1-IDDIVORD          = E52-IDDIVORD                                      
     TMP1-IDPRODNR          = E52-IDPRODNR                                      
     TMP1-IDKUNDRF-RO       = E52-IDKUNDRF-RO                                   
     TMP1-KDORDTYP          = E52-KDORDTYP                                      
     TMP1-KDPRODSL          = E52-KDPRODSL                                      
     TMP1-IDKONTO           = E52-IDKONTO                                       
     TMP1-IDKST             = E52-IDKST                                         
     TMP1-KVAVBART          = E52-KVAVBART                                      
     TMP1-KVBEART           = E52-KVBEART                                       
     MOVE SPACE        TO TMP1-LOW-VALUE2                                       
     TMP1-PRARTNTO          = E52-PRARTNTO                                      
     TMP1-PRARTNTO-LOC      = E52-PRARTNTO-LOC                                  
     TMP1-PRARTNTO-LOCPREL  = E52-PRARTNTO-LOCPREL                              
     TMP1-KDVALISO          = E52-KDVALISO                                      
     TMP1-TIRODAT           = E52-TIRODAT                                       
     TMP1-VKARTNTO          = E52-VKARTNTO                                      
     TMP1-VLARTNTO          = E52-VLARTNTO                                      
     TMP1-KDKVBRYT          = E52-KDKVBRYT                                      
     TMP1-BEVOLREF          = E52-BEVOLREF                                      
     TMP1-KDRADSTA          = E52-KDRADSTA                                      
     TMP1-KVLEVART          = E52-KVLEVART                                      
     TMP1-IDLOPNR           = E52-IDLOPNR                                       
END-PROC                                                                        
NEWPAGE                                                                         
*                                                                               
SORT TEMPFIL1 TO TEMPFIL2   +                                                   
     USING (TMP1-IDARTNR)                                                       
                                                                                
*                                                                               
JOB INPUT (W47953D5 KEY (DLB-IDARTNR)    +                                      
           TEMPFIL2 KEY (TMP2-IDARTNR))                                         
                                                                                
IF MATCHED                                                                      
                                                                                
  PERFORM A-FYLL-W47953-POST                                                    
  PUT W47953D6                                                                  
                                                                                
  U5B-IDDISTR          = TMP2-IDDISTR                                           
  U5B-IDKUNDNR         = TMP2-IDKUNDNR                                          
  U5B-IDKUNDRF         = TMP2-IDKUNDRF                                          
  U5B-IDARTNR          = TMP2-IDARTNR                                           
  U5B-KVEFRS-PACK      = TMP2-KVEFRS-PACK                                       
  U5B-KVEFRS-OPACK     = TMP2-KVEFRS-OPACK                                      
  U5B-KVEFRS-SKEPP     = TMP2-KVEFRS-SKEPP                                      
  U5B-PRARTNTO         = TMP2-PRARTNTO                                          
  U5B-PRARTNTO-LOC     = TMP2-PRARTNTO-LOC                                      
  U5B-PRARTNTO-LOCPREL = TMP2-PRARTNTO-LOCPREL                                  
  U5B-KDVALISO         = TMP2-KDVALISO                                          
  U5B-IDLKTO           = DLB-IDLKTO                                             
  PUT W47953D7                                                                  
                                                                                
  U57-W479057  = TMP2-W479057                                                   
  U57-PRARTSTD = DLB-PRARTSTD                                                   
  U57-PRARTSJK = DLB-PRARTSJK                                                   
  PUT W47953D8                                                                  
END-IF                                                                          
*                                                                               
A-FYLL-W47953-POST.  PROC                                                       
                                                                                
  U53-IDDISTR           = TMP2-IDDISTR                                          
  U53-IDKUNDNR          = TMP2-IDKUNDNR                                         
  U53-IDKUNDRF          = TMP2-IDKUNDRF                                         
  U53-IDDC              = TMP2-IDDC                                             
  U53-KDFAKTYP          = TMP2-KDFAKTYP                                         
  U53-KDFRAKT           = TMP2-KDFRAKT                                          
  U53-KDORDKL           = TMP2-KDORDKL                                          
  U53-TIBEGPAC          = TMP2-TIBEGPAC                                         
  U53-TIUTSKR           = TMP2-TIUTSKR                                          
  U53-TIREF1            = TMP2-TIREF1                                           
  U53-TIORDREG          = TMP2-TIORDREG                                         
  U53-IDARTNR           = TMP2-IDARTNR                                          
  U53-REKSIFFR          = TMP2-REKSIFFR                                         
  U53-IDARTNR-ERS       = TMP2-IDARTNR-ERS                                      
  U53-ADLEVPL           = TMP2-ADLEVPL                                          
  U53-BERADREF          = TMP2-BERADREF                                         
  U53-FLKRED            = TMP2-FLKRED                                           
  U53-LOW-VALUE1        = TMP2-LOW-VALUE1                                       
  U53-FLDIRLEV          = TMP2-FLDIRLEV                                         
  U53-FLRESTN           = TMP2-FLRESTN                                          
  U53-IDDIVORD          = TMP2-IDDIVORD                                         
  U53-IDPRODNR          = TMP2-IDPRODNR                                         
  U53-IDKUNDRF-RO       = TMP2-IDKUNDRF-RO                                      
  U53-KDORDTYP          = TMP2-KDORDTYP                                         
  U53-KDPRODSL          = TMP2-KDPRODSL                                         
  U53-IDKONTO           = TMP2-IDKONTO                                          
  U53-IDKST             = TMP2-IDKST                                            
  U53-KVAVBART          = TMP2-KVAVBART                                         
  U53-KVBEART           = TMP2-KVBEART                                          
  U53-LOW-VALUE2        = TMP2-LOW-VALUE2                                       
  U53-KVEFRS-PACK       = TMP2-KVEFRS-PACK                                      
  U53-KVEFRS-OPACK      = TMP2-KVEFRS-OPACK                                     
  U53-KVEFRS-SKEPP      = TMP2-KVEFRS-SKEPP                                     
  U53-PRARTNTO          = TMP2-PRARTNTO                                         
  U53-PRARTNTO-LOC      = TMP2-PRARTNTO-LOC                                     
  U53-PRARTNTO-LOCPREL  = TMP2-PRARTNTO-LOCPREL                                 
  U53-KDVALISO          = TMP2-KDVALISO                                         
  U53-TIRODAT           = TMP2-TIRODAT                                          
  U53-VKARTNTO          = TMP2-VKARTNTO                                         
  U53-VLARTNTO          = TMP2-VLARTNTO                                         
  U53-KDKVBRYT          = TMP2-KDKVBRYT                                         
  U53-PRARTSTD          = DLB-PRARTSTD                                          
  U53-PRARTSJK          = DLB-PRARTSJK                                          
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
