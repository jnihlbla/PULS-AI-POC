                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5124200                                              *        
*                                                                      *        
*  FUNKTION   :  LAGERVÄRDESRAPPORT MED "SLATT"                        *        
*                ANVÄNDER DATUMKORT                                    *        
*                                                                      *        
*  FÖRFATTARE :  RONNY STENHOLM                                        *        
*                                                                      *        
*  INDATA .... : W512.W500M1.W51239(+0)                                *        
*                                                                      *        
*  LISTA  .... : W51242-001                                            *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W51242D1                                                                   
*                                                                               
%W51239  'IN-'                                                                  
*                                                                               
*--------------------------*                                                    
* DATUMKORT                *                                                    
*--------------------------*                                                    
*                                                                               
PROGRAM-NAMN           W   8   A        VALUE 'W5124200'                        
DATUMKORT-ID           W   6   A        VALUE 'WDATUM'                          
%WDATKORT                                                                       
*                                                                               
AKT-TIAAVVDD           W                 6  N  MASK '99/99/99'                  
AKT-AAR                AKT-TIAAVVDD      2  N                                   
AKT-MAANAD             AKT-TIAAVVDD +2   2  N                                   
AKT-DAG                AKT-TIAAVVDD +4   2  N                                   
*                                                                               
FILE W51242D2  PRINTER VB(130 0)                                                
UT-KDPRODSL             W   3   P                                               
UT-KDVALISO             W   3   A                                               
UT-SUARTVLV-INK         W  11   N 2 MASK 'ZZZZZZZZ9.99' VALUE 0                 
UT-SUARTVLV-PR          W  11   N 2 MASK 'ZZZZZZZZ9.99' VALUE 0                 
UT-DIFF                 W  11   N 2 MASK '--------9.99' VALUE 0                 
NEWPAGE                                                                         
FILE W51242D3  PRINTER VB(130 0)                                                
UT1-KDPRODSL             W   3   A  VALUE '   '                                 
UT1-KDVALISO             W   3   A                                              
UT1-SUARTVLV-INK         W  11   N 2  MASK 'ZZZZZZZZ9.99' VALUE 0               
UT1-SUARTVLV-PR          W  11   N 2  MASK 'ZZZZZZZZ9.99' VALUE 0               
UT1-DIFF                 W  11   N 2  MASK '--------9.99' VALUE 0               
NEWPAGE                                                                         
                                                                                
*    -- CHECKED BY WY2000                                                       
W-SEM1            W   1  A   VALUE ';'                                          
W-SEM2            W   1  A   VALUE ';'                                          
W-SEM3            W   1  A   VALUE ';'                                          
W-SEM4            W   1  A   VALUE ';'                                          
W-SEM5            W   1  A   VALUE ';'                                          
W-SEM6            W   1  A   VALUE ';'                                          
W-SEM7            W   1  A   VALUE ';'                                          
W-SEM8            W   1  A   VALUE ';'                                          
W-SEM9            W   1  A   VALUE ';'                                          
W-SEM10           W   1  A   VALUE ';'                                          
IX                W   3   N  VALUE 0                                            
W2-KDPRODSL       W   3   A  VALUE '   '                                        
FIRST-LINE1       W   1   A  VALUE 'J'                                          
FIRST-LINE2       W   1   A  VALUE 'J'                                          
NEWPAGE                                                                         
*                                                                               
* STEG 1. LAGERVÄRDESRAPPORT PRINTNING                                          
*                                                                               
JOB INPUT (W51242D1) START INIT                                                 
                                                                                
  UT-KDPRODSL = IN-KDPRODSL                                                     
                                                                                
  IX = 1                                                                        
  DO WHILE IX < 6                                                               
******                                            RÄKNAR UT NUVÄRDET **         
    IF IN-SUARTVLV-PR(IX) GT +0                                                 
      UT-SUARTVLV-INK = IN-KVANTMOT(IX) * IN-PRINK / IN-RETULF                  
      UT-SUARTVLV-PR  = IN-SUARTVLV-PR(IX)                                      
      UT-KDVALISO     = IN-KDVALISO(IX)                                         
      UT-DIFF         = UT-SUARTVLV-PR - UT-SUARTVLV-INK                        
      PRINT LISTA1                                                              
      UT1-SUARTVLV-INK = IN-KVANTMOT(IX) * IN-PRINK / IN-RETULF                 
      UT1-SUARTVLV-PR  = IN-SUARTVLV-PR(IX)                                     
      UT1-KDVALISO     = IN-KDVALISO(IX)                                        
      UT1-DIFF         = UT1-SUARTVLV-PR - UT1-SUARTVLV-INK                     
      PRINT LISTA2                                                              
    END-IF                                                                      
    IX = IX + 1                                                                 
  END-DO                                                                        
                                                                                
INIT. PROC                                                                      
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                      
  AKT-AAR       =       D-AAR                                                   
  AKT-MAANAD    =       D-MAANAD                                                
  AKT-DAG       =       D-DAG                                                   
END-PROC                                                                        
                                                                                
************                                                                    
* LISTA 1  *                                                                    
************                                                                    
  REPORT LISTA1                   +                                             
         PRINTER  W51242D2        +                                             
         LINESIZE 125             +                                             
         NODATE                   +                                             
         NOADJUST                 +                                             
         NOSPREAD                 +                                             
         PAGESIZE 32767           +                                             
         NOPAGE                   +                                             
         SUMMARY                  +                                             
         SUMCTL   DTLCOPY         +                                             
         SPACE    0                                                             
*                                                                               
SEQUENCE UT-KDPRODSL          +                                                 
         UT-KDVALISO                                                            
CONTROL  FINAL NOPRINT        +                                                 
         UT-KDPRODSL NOPRINT  +                                                 
         UT-KDVALISO                                                            
SUM      UT-SUARTVLV-INK      +                                                 
         UT-SUARTVLV-PR       +                                                 
         UT-DIFF                                                                
    TITLE 01 '¤DAPW51242-001'                                                   
    TITLE 02 '¤DAPW51242'                                                       
HEADING  UT-KDPRODSL            'PRODUCT GROUP'                                 
HEADING  W-SEM1                 ';'                                             
HEADING  UT-KDVALISO            'CURRENCY CODE'                                 
HEADING  W-SEM2                 ';'                                             
HEADING  UT-SUARTVLV-INK        'STOCK VALUE'                                   
HEADING  W-SEM3                 ';'                                             
HEADING  UT-SUARTVLV-PR         'PURCHASE VALUE'                                
HEADING  W-SEM4                 ';'                                             
HEADING  UT-DIFF                'DIFF'                                          
HEADING  W-SEM5                 ';'                                             
*                                                                               
LINE     UT-KDPRODSL        +                                                   
         W-SEM1             +                                                   
         UT-KDVALISO        +                                                   
         W-SEM1             +                                                   
         UT-SUARTVLV-INK    +                                                   
         W-SEM1             +                                                   
         UT-SUARTVLV-PR     +                                                   
         W-SEM1             +                                                   
         UT-DIFF            +                                                   
         W-SEM1                                                                 
                                                                                
************                                                                    
* LISTA 2  *                                                                    
************                                                                    
  REPORT LISTA2                   +                                             
         PRINTER W51242D3         +                                             
         LINESIZE 125             +                                             
         NODATE                   +                                             
         NOADJUST                 +                                             
         NOSPREAD                 +                                             
         PAGESIZE       32767     +                                             
         NOPAGE                   +                                             
         SUMMARY                  +                                             
         SUMCTL   DTLCOPY         +                                             
         SPACE          0                                                       
*                                                                               
SEQUENCE UT1-KDVALISO                                                           
CONTROL  FINAL NOPRINT                    +                                     
         UT1-KDVALISO                                                           
SUM UT1-SUARTVLV-INK                       +                                    
    UT1-SUARTVLV-PR                        +                                    
    UT1-DIFF                                                                    
                                                                                
    TITLE 1 '¤DAPW51242-002'                                                    
    TITLE 2 '¤DAPW51242'                                                        
HEADING  UT1-KDPRODSL            'PRODUCT GROUP'                                
HEADING  W-SEM6                  ';'                                            
HEADING  UT1-KDVALISO            'CURRENCY CODE'                                
HEADING  W-SEM7                  ';'                                            
HEADING  UT1-SUARTVLV-INK        'STOCK VALUE'                                  
HEADING  W-SEM8                  ';'                                            
HEADING  UT1-SUARTVLV-PR         'PURCHASE VALUE'                               
HEADING  W-SEM9                  ';'                                            
HEADING  UT1-DIFF                'DIFF'                                         
HEADING  W-SEM10                 ';'                                            
                                                                                
LINE        UT1-KDPRODSL        +                                               
            W-SEM6              +                                               
            UT1-KDVALISO        +                                               
            W-SEM7              +                                               
            UT1-SUARTVLV-INK    +                                               
            W-SEM8              +                                               
            UT1-SUARTVLV-PR     +                                               
            W-SEM9              +                                               
            UT1-DIFF            +                                               
            W-SEM10                                                             
