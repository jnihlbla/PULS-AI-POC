FILE W51362D1                                                                   
                                                                                
%W51358   'IN-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W51362D3                                                                   
                                                                                
%W011100  'IN2-'                                                                
                                                                                
NEWPAGE                                                                         
                                                                                
FILE TEMPFIL1 FB(17 0)                                                          
                                                                                
%W51358   'T1-'                                                                 
                                                                                
NEWPAGE                                                                         
                                                                                
FILE TEMPFIL2 FB(19 0)                                                          
                                                                                
%W51358   'T2-'                                                                 
T2-PRODSL       18   2 P 0                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
FILE W51362D4 PRINTER FB(121 0)                                                 
                                                                                
FILE W51362D5 PRINTER FB(121 0)                                                 
                                                                                
FILE W51362D6 PRINTER FB(121 0)                                                 
                                                                                
FILE W51362D7 PRINTER FB(121 0)                                                 
                                                                                
FILE W51362D8 PRINTER FB(121 0)                                                 
                                                                                
FILE W51362D9 PRINTER FB(121 0)                                                 
                                                                                
FILE W51362DA PRINTER FB(121 0)                                                 
                                                                                
FILE W51362DB PRINTER FB(121 0)                                                 
                                                                                
NEWPAGE                                                                         
                                                                                
%WDATKORT                                                                       
                                                                                
NEWPAGE                                                                         
                                                                                
W-PGMNAMN   W  6  A  VALUE 'W51362'                                             
W-WDATUM    W  6  A  VALUE 'WDATUM'                                             
                                                                                
W-DATUM                W  6   N                                                 
W-AAR     W-DATUM         2   N                                                 
W-MM      W-DATUM    +2   2   N                                                 
W-DD      W-DATUM    +4   2   N                                                 
                                                                                
W-VECKA                W  2   N                                                 
W-PRODSL               W  2   P                                                 
                                                                                
W-JUSTYP               W  1   P    HEADING(' ADJ.TYPE')                         
VÄRDE1                 W  8   N 2  HEADING('    VALUE')                         
VÄRDE2                 W  8   N 2  HEADING('    VALUE')                         
VÄRDE                  W  8   N 2  HEADING('NET  VALUE')                        
ANTAL                  W  6   N 0  HEADING('   ADJ. QTY  ')                     
ANTAL1                 W  6   N 0  HEADING('   ADJ. QTY  ')                     
ANTAL2                 W  6   N 0  HEADING('   ADJ. QTY  ')                     
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
                                                                                
SORT W51362D1 TO TEMPFIL1 USING (IN-IDARTNR)                                    
                                                                                
JOB INPUT (W51362D3 KEY (IN2-IDARTNR)  +                                        
           TEMPFIL1 KEY (T1-IDARTNR))                                           
                                                                                
IF  MATCHED                                                                     
   T2-IDDC     = T1-IDDC                                                        
   T2-IDARTNR  = T1-IDARTNR                                                     
   T2-PRARTSTD = IN2-PRARTSTD                                                   
   T2-KVJUSTKV = T1-KVJUSTKV                                                    
   T2-KDJUSTYP = T1-KDJUSTYP                                                    
   T2-PRODSL    = IN2-KDPRODSL                                                  
   PUT TEMPFIL2                                                                 
END-IF                                                                          
                                                                                
JOB INPUT TEMPFIL2 START INIT-PROC                                              
                                                                                
 IF T2-KDJUSTYP NE 6 OR   +                                                     
    T2-KDJUSTYP NE 0                                                            
   VÄRDE = T2-KVJUSTKV * T2-PRARTSTD                                            
   W-JUSTYP = T2-KDJUSTYP                                                       
   IF VÄRDE < 0                                                                 
      VÄRDE1  = VÄRDE                                                           
      ANTAL1  = 1                                                               
      ANTAL2  = 0                                                               
      VÄRDE2  = 0                                                               
   ELSE                                                                         
      VÄRDE1  = 0                                                               
      ANTAL2  = 1                                                               
      ANTAL1  = 0                                                               
      VÄRDE2  = VÄRDE                                                           
   END-IF                                                                       
   ANTAL = 1                                                                    
                                                                                
   IF T2-IDDC = SDC-NL                                                          
          PRINT RAPPORT21                                                       
   END-IF                                                                       
   IF T2-IDDC = SDC-NL-ET                                                       
          PRINT RAPPORT91                                                       
   END-IF                                                                       
*  IF T2-IDDC = SDC-GB                                                          
*            PRINT RAPPORT23                                                    
*  END-IF                                                                       
   IF T2-IDDC = SDC-ES                                                          
             PRINT RAPPORT24                                                    
   END-IF                                                                       
   IF T2-IDDC = SDC-IT                                                          
             PRINT RAPPORT25                                                    
   END-IF                                                                       
   IF T2-IDDC = SDC-AT                                                          
             PRINT RAPPORT26                                                    
   END-IF                                                                       
   IF T2-IDDC = NDC-JP-61                                                       
             PRINT RAPPORT61                                                    
   END-IF                                                                       
   IF T2-IDDC = NDC-AU                                                          
             PRINT RAPPORT62                                                    
   END-IF                                                                       
 END-IF                                                                         
                                                                                
INIT-PROC. PROC                                                                 
   CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                            
                                                                                
   W-AAR = D-AAR                                                                
   W-MM  = D-MAANAD                                                             
   W-DD  = D-DAG                                                                
   W-VECKA = D-VECKA                                                            
                                                                                
END-PROC                                                                        
                                                                                
********************                                                            
* RAPPORT FÖR DC 21                                                             
********************                                                            
                                                                                
REPORT RAPPORT21 PRINTER W51362D4 +                                             
      SKIP 1 TITLESKIP 1 LINESIZE 120 NODATE SUMMARY                            
                                                                                
    SEQUENCE T2-IDDC W-JUSTYP                                                   
    CONTROL  FINAL NOPRINT T2-IDDC NEWPAGE W-JUSTYP                             
                                                                                
    TITLE 1 'VCCS                   W51362-021     ' +                          
            'ADJUSTMENTS  DC' +                                                 
           T2-IDDC 'WEEK  ' W-VECKA  W-DATUM                                    
    TITLE 2 '           '                                                       
    TITLE 3 '              TOTAL                      '  +                      
            'DOWN ADJUSTMENTS            UP ADJUSTMENTS'                        
                                                                                
    LINE W-JUSTYP ANTAL  VÄRDE ANTAL1 VÄRDE1 ANTAL2 VÄRDE2                      
                                                                                
