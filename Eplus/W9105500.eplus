*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W9105500                                              *        
*                                                                      *        
*  FUNKTION   :  PROGRAMMET LÄSER FIL W91054                           *        
*                MATCHAR MOT W01178 OCH SKRIVER                        *        
*                FIL ME KINESISKA ÖVERSÄTTNINGAR TILL VR               *        
*                                                                      *        
*  FÖRFATTARE :  JOHAN NIHLBLAD                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W91055D1                                                                   
*                                                                               
%W91054  'IN1-'                                                                 
*                                                                               
NEWPAGE                                                                         
FILE W91055D2                                                                   
*                                                                               
%W11602  'IN2-'                                                                 
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W91055D3 FB (205 0)                                                        
%W91055  'UT-'                                                                  
*                                                                               
NEWPAGE                                                                         
*                                                                               
*******************************************                                     
* MATCHAR W91054 OCH W01178                                                     
*******************************************                                     
*                                                                               
JOB INPUT (W91055D1 KEY (IN1-IDARTNR) +                                         
           W91055D2 KEY (IN2-IDARTNR))                                          
                                                                                
     IF MATCHED                                                                 
       UT-IDARTNR     = IN2-IDARTNR                                             
       UT-BEARTEXT    = IN2-BEARTEXT                                            
       UT-BEARTEXT-RC = IN2-BEARTEXT-RC                                         
       PERFORM S01-SKRIV-UTFIL                                                  
     END-IF                                                                     
*                                                                               
NEWPAGE                                                                         
*                                                                               
  S01-SKRIV-UTFIL. PROC                                                         
     PUT W91055D3                                                               
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
