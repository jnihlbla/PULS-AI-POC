*                                                                    *          
* FUNKTION .. : DETTA PROGRAM SKAPAR LISTORNA FÖR BYTESUPPFÖLJNING   *          
*               FÖR ALLA RAPPORTER I STATUS 4                        *          
*                                                                    *          
* INDATA .... : W371.W3714C(+0) ALLA BYTESRAPPORTER I STATUS 4       *          
*                                                                    *          
* UTDATA..... : W37153                                               *          
*                                                                    *          
**********************************************************************          
*                                                                               
NEWPAGE                                                                         
*                                                                               
*****************************************************************               
*                                                               *               
* INFIL W371.W371D3.W3714C(+0) ALLA BYTESRAPPORTER I STATUS 4   *               
*                                                               *               
*****************************************************************               
*                                                                               
FILE W37153D1                                                                   
%W3714C  'IN4C-'                                                                
                                                                                
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* SORTAREA FÖR INFILEN MED BYTESRAPPORTER                       *               
*                                                               *               
*****************************************************************               
                                                                                
FILE TPFIL1 FB(10 0)                                                            
                                                                                
%W3714C   'T4C-'                                                                
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* RAPPORT BYTESUPPFÖLJNING PÅ STATUS 4 TILL DC 11               *               
*                                                               *               
*****************************************************************               
                                                                                
FILE W37153D2 PRINTER FB (121 0)                                                
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* RAPPORT BYTESUPPFÖLJNING PÅ STATUS 4 TILL DC 91               *               
*                                                               *               
*****************************************************************               
                                                                                
FILE W37153D3 PRINTER VB (135 0)                                                
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* COPYTEXT TILL SUBPGM WDATKORT                                 *               
*                                                               *               
*****************************************************************               
                                                                                
%WDATKORT                                                                       
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* HOST VARIABLER                                                *               
*                                                               *               
*****************************************************************               
                                                                                
W-PAGE       W  10  A    VALUE '  PAGE  '                                       
W-SIDA       W  10  A    VALUE '  SIDA  '                                       
W-PGMNAMN    W  6   A    VALUE 'W37153'                                         
W-WDATUM     W  6   A    VALUE '000001'                                         
                                                                                
  W-DATUM          W  6   N                                                     
  W-MM   W-DATUM       2  N                                                     
  W-DD   W-DATUM   +2  2  N                                                     
  W-AAR  W-DATUM   +4  2  N                                                     
                                                                                
                                                                                
W-IDDC            W   2  A                                                      
W-IDDISTR         W   5  N MASK 'ZZZZ9'.                                        
W-KVRETUR         W   7  N MASK 'ZZZZZZ9'.                                      
W-UT-FIX-SE       W   8  A                                                      
W-UT-FIX-1-SE W-UT-FIX-SE    2  A                                               
W-UT-FIX-2-SE W-UT-FIX-SE +2 1  A                                               
W-UT-FIX-3-SE W-UT-FIX-SE +3 2  A                                               
W-UT-FIX-4-SE W-UT-FIX-SE +5 1  A                                               
W-UT-FIX-5-SE W-UT-FIX-SE +6 2  A                                               
W-UT-FIX-US       W   8  A                                                      
W-UT-FIX-1-US W-UT-FIX-US    2  A                                               
W-UT-FIX-2-US W-UT-FIX-US +2 1  A                                               
W-UT-FIX-3-US W-UT-FIX-US +3 2  A                                               
W-UT-FIX-4-US W-UT-FIX-US +5 1  A                                               
W-UT-FIX-5-US W-UT-FIX-US +6 2  A                                               
W-UT-FIX-GB       W   8  A                                                      
W-UT-FIX-1-GB W-UT-FIX-GB    2  A                                               
W-UT-FIX-2-GB W-UT-FIX-GB +2 1  A                                               
W-UT-FIX-3-GB W-UT-FIX-GB +3 2  A                                               
W-UT-FIX-4-GB W-UT-FIX-GB +5 1  A                                               
W-UT-FIX-5-GB W-UT-FIX-GB +6 2  A                                               
W-SUM             W   4 P 0 MASK 'ZZZZZZ9'                                      
W-SUM2            W   4 P 0 MASK 'ZZZZZZ9'                                      
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* STEG 2  SORTERA BYTESFILEN PER IDDC IDDISTR IDBYTRAP          *               
*                                                               *               
*****************************************************************               
                                                                                
SORT W37153D1 TO TPFIL1 USING (IN4C-IDDC IN4C-IDDISTR)                          
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* STEG 4  LÄSER TPFIL1                                          *               
*                                                               *               
*****************************************************************               
                                                                                
                                                                                
JOB INPUT(TPFIL1) START INIT-PROC                                               
                                                                                
    W-UT-FIX-1-SE   = W-AAR                                                     
    W-UT-FIX-2-SE   = '-'                                                       
    W-UT-FIX-3-SE   = W-MM                                                      
    W-UT-FIX-4-SE   = '-'                                                       
    W-UT-FIX-5-SE   = W-DD                                                      
    W-UT-FIX-1-GB   = W-DD                                                      
    W-UT-FIX-2-GB   = '-'                                                       
    W-UT-FIX-3-GB   = W-MM                                                      
    W-UT-FIX-4-GB   = '-'                                                       
    W-UT-FIX-5-GB   = W-AAR                                                     
    W-UT-FIX-1-US   = W-MM                                                      
    W-UT-FIX-2-US   = '-'                                                       
    W-UT-FIX-3-US   = W-DD                                                      
    W-UT-FIX-4-US   = '-'                                                       
    W-UT-FIX-5-US   = W-AAR                                                     
  IF T4C-IDDC = CDC-SE                                                          
     W-IDDISTR     = T4C-IDDISTR                                                
     W-KVRETUR     = T4C-KVRETUR                                                
     W-SUM         = W-KVRETUR                                                  
                                                                                
     PRINT LISTA11                                                              
  END-IF                                                                        
  IF T4C-IDDC = SDC-NL-ET                                                       
     W-IDDISTR     = T4C-IDDISTR                                                
     W-KVRETUR     = T4C-KVRETUR                                                
     W-SUM2        = W-KVRETUR                                                  
     PRINT LISTA91                                                              
  END-IF                                                                        
NEWPAGE                                                                         
INIT-PROC. PROC                                                                 
    CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                           
    W-AAR  = D-AAR                                                              
    W-MM   = D-MAANAD                                                           
    W-DD   = D-DAG                                                              
                                                                                
END-PROC                                                                        
NEWPAGE                                                                         
                                                                                
  REPORT LISTA11                +                                               
         PRINTER W37153D2       +                                               
         PAGESIZE 41            +                                               
         LINESIZE 120           +                                               
         SPACE 1                +                                               
         TITLESKIP 1            +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NOADJUST               +                                               
         NODATE                 +                                               
         SUMCTL                 +                                               
         DTLCOPY                +                                               
         SUMMARY                                                                
                                                                                
                                                                                
SEQUENCE W-IDDISTR                                                              
                                                                                
CONTROL W-IDDISTR                                                               
                                                                                
                                                                                
TITLE 1  COL 01 W-UT-FIX-SE   +                                                 
         COL 11 'W37153-011 ' +                                                 
         COL 22 'DAGLIG UPPFÖLJNING PÅ BYTESRAPPORTER I STATUS 4' +             
         COL 108     W-SIDA                                                     
                                                                                
TITLE 2  COL 01 'DISTRIKT  '          +                                         
         COL 16 'ANTAL ARTIKLAR'      +                                         
                                                                                
LINE  1  COL 04  W-IDDISTR            +                                         
         COL 20  W-SUM                +                                         
                                                                                
                                                                                
                                                                                
  REPORT LISTA91                +                                               
         PRINTER W37153D3       +                                               
         PAGESIZE 41            +                                               
         LINESIZE 120           +                                               
         SPACE 1                +                                               
         TITLESKIP 1            +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NOADJUST               +                                               
         NODATE                 +                                               
         NOPAGE                 +                                               
         SUMCTL                 +                                               
         DTLCOPY                +                                               
         SUMMARY                                                                
                                                                                
                                                                                
                                                                                
SEQUENCE W-IDDISTR                                                              
                                                                                
CONTROL  FINAL NOPRINT           +                                              
         W-IDDISTR                                                              
SUM W-SUM2                                                                      
                                                                                
TITLE 1  COL 01 ';'                                               +             
         COL 11 'W37153-091;'                                     +             
         COL 22 'DAILY FOLLOWING-UP CORES IN REPORTS IN STATUS 4' +             
         COL 108 ';'                                                            
                                                                                
TITLE 2  COL 01 ';DISTRICT ;'            +                                      
         COL 19 'QUANTITY;'              +                                      
                                                                                
LINE  1  COL 01  ';'                       +                                    
         COL 02   W-IDDISTR                +                                    
         COL 10   ';'                      +                                    
         COL 17   W-SUM2                   +                                    
         COL 30   ';'                      +                                    
                                                                                
                                                                                
