                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W3358600                                              *        
*                                                                      *        
*  FUNCTION   :  TAR FRAM FÄRSKASTE PRISRAD PER ART + LEV OCH          *        
*                LÄGGER PÅ UTFIL.SPECIELL  FIL FÖR NDC:RNA             *        
*                                                                      *        
*  WRITER     :  ELEONOR ÖSTRÖM                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W33586D1                                                                   
*                                                                               
%W01184  'NDC-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W33586D2                                                                   
%W01161   'IN-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W33586D3                                                                   
%W33591      'LEV-'                                                             
                                                                                
NEWPAGE                                                                         
FILE W33586D4 FB (47 0)                                                         
%W33585   'UT-'                                                                 
                                                                                
*                                                                               
FILE TPFIL1  FB (51 0)                                                          
*                                                                               
%W01161   'T1-'                                                                 
                                                                                
FILE TPFIL2  FB (60 0)                                                          
%W01161   'T2-'                                                                 
T2-RETULF          52 4 P 4                                                     
T2-IDLEVNR-MOTSV   56 5 A                                                       
                                                                                
FILE TPFIL3  FB (14 0)                                                          
*                                                                               
%W33591   'T3-'                                                                 
                                                                                
FILE TPFIL4  FB (51 0)                                                          
*                                                                               
%W01161   'T4-'                                                                 
                                                                                
FILE TPFIL5  FB (483 0)                                                         
%W01184   'T5-'                                                                 
                                                                                
FILE TPFIL6   FB (47 0)                                                         
%W33585   'T6-'                                                                 
                                                                                
FILE TPFIL7  FB (47 0)                                                          
%W33585   'T7-'                                                                 
                                                                                
NEWPAGE                                                                         
                                                                                
*                                                                               
NEWPAGE                                                                         
  W-PROGRAM-NAMN   W  6   A   VALUE 'W33586'                                    
                                                                                
* DATUM                    W  8  A                                              
  W-DAGENS-DATUM           W  8  A                                              
  W-AA   W-DAGENS-DATUM       2  N                                              
  W-S1   W-DAGENS-DATUM   +2  1  A                                              
  W-MM   W-DAGENS-DATUM   +3  2  N                                              
  W-S2   W-DAGENS-DATUM   +5  1  A                                              
  W-DD   W-DAGENS-DATUM   +6  2  N                                              
                                                                                
  W-DATUM                  W  8  N                                              
  W-TI   W-DATUM              2  N                                              
  W-AR   W-DATUM          +2  2  N                                              
  W-MA   W-DATUM          +4  2  N                                              
  W-DA   W-DATUM          +6  2  N                                              
                                                                                
W-PRISDATUM      W 8 N    VALUE 0                                               
W-IDARTNR        W 9 P    VALUE 0                                               
W-IDLEVNR        W 5 A    VALUE '     '                                         
W-DIFF           W 9 P 2  VALUE 0                                               
ANT              W 8 P    VALUE 0                                               
                                                                                
************************************************************                    
* STEG 1. SORTERAR IN-FIL  PÅ IDLEVNR TILL TPFIL1          *                    
************************************************************                    
                                                                                
SORT W33586D2 TO TPFIL1 USING                                        +          
 (IN-PRL-IDLEVNR ) SIZE 800000                                                  
                                                                                
NEWPAGE                                                                         
************************************************************                    
* STEG 2. SORTERAR W33585D2 PÅ IDLEVNR TILL TPFIL3         *                    
************************************************************                    
                                                                                
SORT W33586D3 TO TPFIL3 USING                                      +            
 (LEV-IDLEVNR ) SIZE 800000                                                     
                                                                                
NEWPAGE                                                                         
************************************************************                    
* STEG 3. MATCHAR TPFIL1 OCH TPFIL3 LEV-FIL OCH BYTER UT   *                    
*         ALFALEVNR MOT DET GAMLA NUMERISKA LEVNR          *                    
************************************************************                    
*                                                                               
JOB INPUT (TPFIL3 KEY(T3-IDLEVNR) TPFIL1 KEY(T1-PRL-IDLEVNR))      +            
                                    START A-INIT                                
                                                                                
    IF MATCHED                                                                  
      IF DUPLICATE TPFIL1 OR NOT DUPLICATE TPFIL1                               
        T2-PRL-W01161 = T1-PRL-W01161                                           
        T2-RETULF        = T3-RETULF                                            
        T2-IDLEVNR-MOTSV = '     '                                              
        PUT TPFIL2                                                              
      END-IF                                                                    
    ELSE                                                                        
      IF TPFIL1                                                                 
        T2-PRL-W01161    = T1-PRL-W01161                                        
        T2-RETULF        = 0                                                    
        T2-IDLEVNR-MOTSV = '     '                                              
        PUT TPFIL2                                                              
      END-IF                                                                    
    END-IF                                                                      
                                                                                
A-INIT. PROC                                                                    
                                                                                
  W-DAGENS-DATUM = SYSDATE                                                      
  W-TI     = 20                                                                 
  W-AR     = W-AA                                                               
  W-MA     = W-MM                                                               
  W-DA     = W-DD                                                               
                                                                                
END-PROC.                                                                       
NEWPAGE                                                                         
************************************************************                    
* STEG 4. SORTERAR TPFIL2  PÅ ARTNR, IDLEVNR OCH DATUM     *                    
************************************************************                    
                                                                                
SORT TPFIL2 TO TPFIL2 USING                                          +          
 (T2-PRL-IDARTNR T2-PRL-IDLEVNR T2-PRL-DAPRLIST-9KOMPL )             +          
     BEFORE SORT-INIT  SIZE 800000                                              
                                                                                
 SORT-INIT. PROC                                                                
                                                                                
 IF T2-PRL-KDSTATUS-PR = 1                                                      
   W-PRISDATUM = 99999999 - T2-PRL-DAPRLIST-9KOMPL                              
   IF W-DATUM >= W-PRISDATUM                                                    
     SELECT                                                                     
   END-IF                                                                       
 END-IF                                                                         
                                                                                
 END-PROC                                                                       
                                                                                
************************************************************                    
* STEG 5. TAR FRAM FÄRSKASTE PRISRAD PER ARTNR OCH IDLEVNR *                    
************************************************************                    
                                                                                
JOB INPUT TPFIL2 START A-INIT                                                   
 IF W-IDARTNR = T2-PRL-IDARTNR AND W-IDLEVNR = T2-PRL-IDLEVNR                   
 ELSE                                                                           
   T6-IDARTNR         = T2-PRL-IDARTNR                                          
   T6-DAPRLIST-9KOMPL = 99999999 - T2-PRL-DAPRLIST-9KOMPL                       
   T6-FLHUVLEV        = T2-PRL-FLHUVLEV                                         
   T6-IDLEVNR-PR      = T2-PRL-IDLEVNR                                          
   T6-KDPRURSP        = T2-PRL-KDPRURSP                                         
   T6-KDSTATUS-PR     = T2-PRL-KDSTATUS-PR                                      
   T6-KDVALISO        = T2-PRL-KDVALISO                                         
   T6-PRARTBES-PR     = T2-PRL-PRARTBES-PR                                      
   T6-PRARTBEL-PR     = T2-PRL-PRARTBEL-PR                                      
   T6-SUINLEV-PR      = T2-PRL-SUINLEV-PR                                       
   T6-RETULF          = T2-RETULF                                               
   T6-IDLEVNR-MOTSV   = T2-IDLEVNR-MOTSV                                        
                                                                                
   PUT TPFIL6                                                                   
                                                                                
   W-IDARTNR  = T2-PRL-IDARTNR                                                  
   W-IDLEVNR  = T2-PRL-IDLEVNR                                                  
 END-IF                                                                         
                                                                                
A-INIT. PROC                                                                    
   W-IDARTNR  = 0                                                               
   W-IDLEVNR  = '     '                                                         
END-PROC                                                                        
******************************************************                          
* STEG 6. SORTERAR TPFIL6 PÅ ARTNR, IDLEVNR       V  *                          
******************************************************                          
NEWPAGE                                                                         
                                                                                
SORT TPFIL6 TO TPFIL7 USING (T6-IDARTNR T6-IDLEVNR-PR)               +          
                            SIZE 800000                                         
                                                                                
************************************************************                    
* STEG 7. VÄLJER UT ALLA ARTIKLAR SOM ÄR LOKALA            *                    
*         (EJ '1441 ' ELLER 'BP2TW')                       *                    
************************************************************                    
NEWPAGE                                                                         
SORT W33586D1 TO TPFIL5 USING (NDC-SLAG-IDARTNR NDC-SLAG-IDLEVNR)    +          
                        BEFORE SORT-INIT  SIZE 800000                           
                                                                                
SORT-INIT. PROC                                                                 
  IF NDC-SLAG-IDLEVNR NE '1441 ' 'BP2TW'                                        
    SELECT                                                                      
  END-IF                                                                        
END-PROC                                                                        
*                                                                               
************************************************************                    
* STEP 2. MATCHAR TPFIL5(NDC) MED TPFIL7(W01161) TILL      *                    
*         TPFIL4                                           *                    
************************************************************                    
NEWPAGE                                                                         
JOB INPUT (TPFIL5 KEY(T5-SLAG-IDARTNR T5-SLAG-IDLEVNR)              +           
           TPFIL7 KEY(T7-IDARTNR T7-IDLEVNR-PR))                                
                                                                                
    IF MATCHED                                                                  
        PUT W33586D4 FROM TPFIL7                                                
    END-IF                                                                      
                                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
