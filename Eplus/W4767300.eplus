*                                                                      *        
*-----------------------------------------FILES & COPYTEXTS                     
FILE W47673D1                                                                   
IN-BEGIN      1  13 A                                                           
IN-IDFAKT    14   7 A                                                           
IN-REST      21 185 A                                                           
IN-ALL        2 204 A                                                           
*                                                                               
*------                                                                         
CMD-COUNTER W   5 P                                                             
FIRSTLINE   W 205 A                                                             
*------                                                                         
FILE CMDFILE    FB (80 0)                                                       
CMD      1  10   A                                                              
TEXT    11  50   A                                                              
*                                                                               
*                                                                               
FILE MEMOFILE F 205                                                             
OUT-ALL       1 205 A                                                           
*****************************************************************               
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT W47673D1                                                              
CMD-COUNTER = CMD-COUNTER + 1                                                   
IF CMD-COUNTER = 1                                                              
  CMD = ')SEND'.  MOVE SPACE TO TEXT                                            
  PUT CMDFILE                                                                   
  CMD = 'OPTION'.  TEXT = 'FORCE'                                               
  PUT CMDFILE                                                                   
  CMD = 'OPTION'.  TEXT = 'NOEXPRL'                                             
  PUT CMDFILE                                                                   
  CMD = 'LINELTH'.  TEXT = '121'                                                
  PUT CMDFILE                                                                   
  CMD = 'TITLE'.  TEXT = 'IN-IDFAKT'                                            
  PUT CMDFILE                                                                   
  CMD = 'DEST '.  TEXT = 'PKULIKOW@VOLVOCARS.COM'                               
  PUT CMDFILE                                                                   
  CMD = 'MEMO '.  TEXT = 'SEND'                                                 
  PUT CMDFILE                                                                   
  CMD = ')END '.  MOVE SPACE TO TEXT                                            
  PUT CMDFILE                                                                   
  OUT-ALL = FIRSTLINE                                                           
  PUT MEMOFILE                                                                  
END-IF                                                                          
OUT-ALL = IN-ALL                                                                
PUT MEMOFILE                                                                    
