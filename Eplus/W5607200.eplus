                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W513   INVENTERINGEN                                  *        
*                                                                      *        
*  FUNKTION   :  CREATES A D&P LIST ADJ-DAILY FOR THE DAILY ADJUSTMENTS*        
*                KDINVKAT 8                                            *        
*                                                                      *        
*  AUTHOR     :  ARCHANA BHAT                                          *        
*                                                                      *        
*  INFIL      :  W5134N                                                *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W56072D1 FB(80 0)                                                          
                                                                                
%W51322P 'IN-'                                                                  
                                                                                
NEWPAGE                                                                         
                                                                                
FILE W56072D2 PRINTER VB(125 0)                                                 
                                                                                
  W-PGMNAMN    W  6   A    VALUE 'W56072'                                       
  W-PREV-IDDC  W  2   A                                                         
  W-IDARTNR    W  9   N 0 MASK 'ZZZZZZZZ9'                                      
  W-AREA       W  3   N 0 MASK 'ZZ9'                                            
  W-KDPRODSL   W  6   N 0 MASK 'ZZZZZ9'                                         
  W-ADJ-QTY    W  8   N 0 MASK '-------9'                                       
  W-ADJ-LS     W  7   N 0 MASK '------9'                                        
  W-ADJ-VAL    W 11   N 2 MASK '--------9.99'                                   
  W-BUYER      W 11   N   MASK '----------9'                                    
  W-VENDOR     W  7   A                                                         
  W-SORT       W  2   A                                                         
  W-BEART      W 15   A                                                         
  W-SEM        W  1   A   VALUE ';'                                             
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
SORT W56072D1 TO W56072D1 USING (IN-IDDC, IN-IDARTNR)                           
JOB INPUT W56072D1                                                              
                                                                                
  W-IDARTNR    = IN-IDARTNR                                                     
  W-AREA       = IN-ADLAGOMR                                                    
  W-SORT       = IN-KDSORT                                                      
  W-KDPRODSL   = IN-KDPSLLOC                                                    
  W-ADJ-QTY    = IN-KVJUSTKV                                                    
  W-ADJ-VAL    = IN-JUST-VAERDE                                                 
  W-BUYER      = IN-IDANSKNR                                                    
  W-VENDOR     = IN-IDLEVNR                                                     
  W-ADJ-LS     = IN-KVLS                                                        
  W-BEART      = IN-BEART                                                       
  PRINT RAPPORT01                                                               
                                                                                
************************************************************************        
*** LIST FOR NDC-NA - SENT TO D&P                                               
************************************************************************        
REPORT   RAPPORT01            +                                                 
         PRINTER W56072D2     +                                                 
         LINESIZE 120         +                                                 
         SPACE 0              +                                                 
         NOHEADING            +                                                 
         NOSPREAD             +                                                 
         NOADJUST             +                                                 
         PAGESIZE 32767       +                                                 
         NODATE                                                                 
LINE  1  W-IDARTNR            +                                                 
         W-SEM                +                                                 
         W-BEART              +                                                 
         W-SEM                +                                                 
         W-VENDOR             +                                                 
         W-SEM                +                                                 
         W-AREA               +                                                 
         W-SEM                +                                                 
         W-KDPRODSL           +                                                 
         W-SEM                +                                                 
         W-SORT               +                                                 
         W-SEM                +                                                 
         W-BUYER              +                                                 
         W-SEM                +                                                 
         W-ADJ-LS             +                                                 
         W-SEM                +                                                 
         W-ADJ-QTY            +                                                 
         W-SEM                +                                                 
         W-ADJ-VAL            +                                                 
         W-SEM                                                                  
*                                                                               
BEFORE-LINE. PROC                                                               
 IF IN-IDDC NE W-PREV-IDDC                                                      
   DISPLAY '¤DAPADJ-DAILY'                                                      
   DISPLAY '¤DAP' IN-IDDC                                                       
   DISPLAY 'PARTNO;DESCRIPTION;VENDOR;AREA;LPC;SORT;BUYER;ADJ.LS;' +            
           'ADJ.QTY;ADJ.VALUE;'                                                 
   W-PREV-IDDC = IN-IDDC                                                        
 END-IF                                                                         
END-PROC                                                                        
