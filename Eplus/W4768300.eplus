*                                                                               
*    -- CHECKED BY WY2000                                                       
*-------------*                                                                 
* JOB         *                                                                 
*-------------*                                                                 
*                                                                               
JOB INPUT(W47683DZ) NAME AKT01                                                  
*                                                                               
  IF FIRST-POST = 'J'                                                           
                                                                                
    FIRST-POST = 'N'                                                            
                                                                                
    UTFIL EQ E-RUBRIK-1                                                         
    PUT W47683D1                                                                
