         W-EFR-STD =    0                                                       
         W-EFR-AVG =   (DEFR-KVEFRS-OPACK * DEFR-PRAVCOST)      +               
                     + (DEFR-KVBEART-Q    * DEFR-PRAVCOST)      +               
                     + (DEFR-KVEFRS-PACK  * DEFR-PRAVCOST)      +               
                     + (DEFR-KVEFRS-SKEPP * DEFR-PRAVCOST)                      
       ELSE                                                                     
         W-EFR-STD =   (DEFR-KVEFRS-OPACK * DEFR-PRARTSTD)      +               
                     + (DEFR-KVBEART-Q    * DEFR-PRARTSTD)      +               
                     + (DEFR-KVEFRS-PACK  * DEFR-PRARTSTD)      +               
                     + (DEFR-KVEFRS-SKEPP * DEFR-PRARTSTD)                      
         W-EFR-AVG =    0                                                       
       END-IF                                                                   
     END-IF                                                                     
                                                                                
  NEWPAGE                                                                       
                                                                                
