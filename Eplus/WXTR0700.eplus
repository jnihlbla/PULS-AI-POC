  JOB INPUT (WXTR07D3 KEY (      IN-IDDC                         +              
                                 IN-IDPRC                        +              
                                 IN-KDORDKL                      +              
                                 IN-IDDISTR                      +              
                                 IN-IDKUNDNR                     +              
                                 IN-IDKUNDRF)                    +              
             WXTR07D4 KEY (TMP-GEFR-IDDC                         +              
                           TMP-GEFR-IDPRC                        +              
                           TMP-GEFR-KDORDKL                      +              
                           TMP-GEFR-IDDISTR                      +              
                           TMP-GEFR-IDKUNDNR                     +              
                           TMP-GEFR-IDKUNDRF)                    +              
             WXTR07D5 KEY (TMP-DEFR-IDDC                         +              
                           TMP-DEFR-IDPRC                        +              
                           TMP-DEFR-KDORDKL                      +              
                           TMP-DEFR-IDDISTR                      +              
                           TMP-DEFR-IDKUNDNR                     +              
                           TMP-DEFR-IDKUNDRF))                   +              
                   NAME   STEG03                                                
                                                                                
    IF MATCHED WXTR07D3 WXTR07D4 WXTR07D5                                       
      PERFORM A-MATCH                                                           
    ELSE                                                                        
      IF MATCHED WXTR07D3 WXTR07D5                                              
        PERFORM B-FAKT-DAGENS-EFR                                               
      ELSE                                                                      
        IF MATCHED WXTR07D3 WXTR07D4                                            
          PERFORM C-FAKT-GARDAGENS-EFR                                          
        ELSE                                                                    
          IF MATCHED WXTR07D4 WXTR07D5                                          
            PERFORM D-DAGENS-GARDAGENS-EFR                                      
          ELSE                                                                  
            IF WXTR07D3                                                         
              PERFORM E-ENBART-FAKT                                             
            ELSE                                                                
              IF WXTR07D5                                                       
                PERFORM F-ENBART-DAGENS-EFR                                     
              ELSE                                                              
                IF WXTR07D4                                                     
                  PERFORM G-ENBART-GARDAGENS-EFR                                
                END-IF                                                          
              END-IF                                                            
            END-IF                                                              
          END-IF                                                                
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
                                                                                
    IF UT-INK-STD       <  0                                                    
       UT-INK-STD       =  0                                                    
    END-IF                                                                      
    IF UT-INK-AVG       <  0                                                    
       UT-INK-AVG       =  0                                                    
    END-IF                                                                      
    IF UT-INK-LINES     <  0                                                    
       UT-INK-LINES     =  0                                                    
    END-IF                                                                      
    IF UT-INK-VKARTNTO  <  0                                                    
       UT-INK-VKARTNTO  =  0                                                    
    END-IF                                                                      
    IF UT-INK-VLARTNTO  <  0                                                    
       UT-INK-VLARTNTO  =  0                                                    
    END-IF                                                                      
                                                                                
    PUT WXTR07D6                                                                
                                                                                
