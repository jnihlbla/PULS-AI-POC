*                                                                               
  JOB INPUT WXTR07D1     FINISH Z-SKRIV-SISTA-POST               +              
                         NAME   STEG01                                          
                                                                                
     IF RECORD-COUNT =  1                                                       
        SPAR-IDDC       = GEFR-IDDC                                             
        SPAR-IDPRC      = GEFR-IDPRC                                            
        SPAR-KDORDKL    = GEFR-KDORDKL                                          
        SPAR-IDDISTR    = GEFR-IDDISTR                                          
        SPAR-IDKUNDNR   = GEFR-IDKUNDNR                                         
        SPAR-IDKUNDRF   = GEFR-IDKUNDRF                                         
        FL-TOM-INFIL    = NEJ                                                   
        W-EFR-STD       = 0                                                     
        W-EFR-AVG       = 0                                                     
        W-EFR-LINES     = 0                                                     
        W-EFR-VKARTNTO  = 0                                                     
        W-EFR-VLARTNTO  = 0                                                     
     END-IF                                                                     
                                                                                
     IF  SPAR-IDDC       = GEFR-IDDC      AND                     +             
         SPAR-IDPRC      = GEFR-IDPRC     AND                     +             
         SPAR-KDORDKL    = GEFR-KDORDKL   AND                     +             
         SPAR-IDDISTR    = GEFR-IDDISTR   AND                     +             
         SPAR-IDKUNDNR   = GEFR-IDKUNDNR  AND                     +             
         SPAR-IDKUNDRF   = GEFR-IDKUNDRF                                        
         W-EFR-LINES     = W-EFR-LINES    + 1                                   
         W-EFR-VKARTNTO  = W-EFR-VKARTNTO                         +             
                       + (GEFR-KVBEART-Q    * GEFR-VKARTNTO)      +             
                       + (GEFR-KVEFRS-OPACK * GEFR-VKARTNTO)      +             
                       + (GEFR-KVEFRS-PACK  * GEFR-VKARTNTO)      +             
                       + (GEFR-KVEFRS-SKEPP * GEFR-VKARTNTO)                    
         W-EFR-VLARTNTO  = W-EFR-VLARTNTO                         +             
                       + (GEFR-KVBEART-Q    * GEFR-VLARTNTO)      +             
                       + (GEFR-KVEFRS-OPACK * GEFR-VLARTNTO)      +             
                       + (GEFR-KVEFRS-PACK  * GEFR-VLARTNTO)      +             
                       + (GEFR-KVEFRS-SKEPP * GEFR-VLARTNTO)                    
         PERFORM S23-CHECK-SPAR-IDDC                                            
         IF SPAR-IDDC = NDC-NA OR                                 +             
            SPAR-IDDC = NDC-CN OR                                 +             
            SPAR-IDDC = LDC-CN                                                  
           W-EFR-STD =    0                                                     
           W-EFR-AVG =    W-EFR-AVG                               +             
                       + (GEFR-KVBEART-Q    * GEFR-PRAVCOST)      +             
                       + (GEFR-KVEFRS-OPACK * GEFR-PRAVCOST)      +             
                       + (GEFR-KVEFRS-PACK  * GEFR-PRAVCOST)      +             
                       + (GEFR-KVEFRS-SKEPP * GEFR-PRAVCOST)                    
         ELSE                                                                   
           W-EFR-STD =    W-EFR-STD                               +             
                       + (GEFR-KVBEART-Q    * GEFR-PRARTSTD)      +             
                       + (GEFR-KVEFRS-OPACK * GEFR-PRARTSTD)      +             
                       + (GEFR-KVEFRS-PACK  * GEFR-PRARTSTD)      +             
                       + (GEFR-KVEFRS-SKEPP * GEFR-PRARTSTD)                    
           W-EFR-AVG =    0                                                     
         END-IF                                                                 
     ELSE                                                                       
                                                                                
         PERFORM S01-SKRIV-FIL                                                  
                                                                                
         W-EFR-LINES     = 1                                                    
         W-EFR-VKARTNTO  = 0                                      +             
                       + (GEFR-KVBEART-Q    * GEFR-VKARTNTO)      +             
                       + (GEFR-KVEFRS-OPACK * GEFR-VKARTNTO)      +             
                       + (GEFR-KVEFRS-PACK  * GEFR-VKARTNTO)      +             
                       + (GEFR-KVEFRS-SKEPP * GEFR-VKARTNTO)                    
         W-EFR-VLARTNTO  = 0                                      +             
                       + (GEFR-KVBEART-Q    * GEFR-VLARTNTO)      +             
                       + (GEFR-KVEFRS-OPACK * GEFR-VLARTNTO)      +             
                       + (GEFR-KVEFRS-PACK  * GEFR-VLARTNTO)      +             
                       + (GEFR-KVEFRS-SKEPP * GEFR-VLARTNTO)                    
                                                                                
         SPAR-IDDC       = GEFR-IDDC                                            
         SPAR-IDPRC      = GEFR-IDPRC                                           
         SPAR-KDORDKL    = GEFR-KDORDKL                                         
         SPAR-IDDISTR    = GEFR-IDDISTR                                         
         SPAR-IDKUNDNR   = GEFR-IDKUNDNR                                        
         SPAR-IDKUNDRF   = GEFR-IDKUNDRF                                        
                                                                                
         PERFORM S23-CHECK-SPAR-IDDC                                            
         IF SPAR-IDDC = NDC-NA OR                                 +             
            SPAR-IDDC = NDC-CN OR                                 +             
            SPAR-IDDC = LDC-CN                                                  
           W-EFR-STD =    0                                                     
           W-EFR-AVG =   (GEFR-KVEFRS-OPACK * GEFR-PRAVCOST)      +             
                       + (GEFR-KVBEART-Q    * GEFR-PRAVCOST)      +             
                       + (GEFR-KVEFRS-PACK  * GEFR-PRAVCOST)      +             
                       + (GEFR-KVEFRS-SKEPP * GEFR-PRAVCOST)                    
         ELSE                                                                   
           W-EFR-STD =   (GEFR-KVEFRS-OPACK * GEFR-PRARTSTD)      +             
                       + (GEFR-KVBEART-Q    * GEFR-PRARTSTD)      +             
                       + (GEFR-KVEFRS-PACK  * GEFR-PRARTSTD)      +             
                       + (GEFR-KVEFRS-SKEPP * GEFR-PRARTSTD)                    
           W-EFR-AVG =    0                                                     
         END-IF                                                                 
     END-IF                                                                     
                                                                                
  NEWPAGE                                                                       
                                                                                
  S01-SKRIV-FIL.  PROC                                                          
                                                                                
     TMP-GEFR-IDDC          = SPAR-IDDC                                         
     TMP-GEFR-IDPRC         = SPAR-IDPRC                                        
     TMP-GEFR-KDORDKL       = SPAR-KDORDKL                                      
     TMP-GEFR-IDDISTR       = SPAR-IDDISTR                                      
     TMP-GEFR-IDKUNDNR      = SPAR-IDKUNDNR                                     
     TMP-GEFR-IDKUNDRF      = SPAR-IDKUNDRF                                     
     TMP-GEFR-EFR-STD       = W-EFR-STD                                         
     TMP-GEFR-EFR-AVG       = W-EFR-AVG                                         
     TMP-GEFR-EFR-LINES     = W-EFR-LINES                                       
     TMP-GEFR-EFR-VKARTNTO  = W-EFR-VKARTNTO                                    
     TMP-GEFR-EFR-VLARTNTO  = W-EFR-VLARTNTO                                    
                                                                                
     PUT WXTR07D4                                                               
                                                                                
  END-PROC                                                                      
                                                                                
*    --- S23-CHECK-SPAR-IDDC (MACRO PROCEDURE)                                  
%WWDC02 'SPAR-'                                                                 
*                                                                               
NEWPAGE                                                                         
                                                                                
  Z-SKRIV-SISTA-POST.  PROC                                                     
                                                                                
     TMP-GEFR-IDDC          = SPAR-IDDC                                         
     TMP-GEFR-IDPRC         = SPAR-IDPRC                                        
     TMP-GEFR-KDORDKL       = SPAR-KDORDKL                                      
     TMP-GEFR-IDDISTR       = SPAR-IDDISTR                                      
     TMP-GEFR-IDKUNDNR      = SPAR-IDKUNDNR                                     
     TMP-GEFR-IDKUNDRF      = SPAR-IDKUNDRF                                     
     TMP-GEFR-EFR-STD       = W-EFR-STD                                         
     TMP-GEFR-EFR-AVG       = W-EFR-AVG                                         
     TMP-GEFR-EFR-LINES     = W-EFR-LINES                                       
     TMP-GEFR-EFR-VKARTNTO  = W-EFR-VKARTNTO                                    
     TMP-GEFR-EFR-VLARTNTO  = W-EFR-VLARTNTO                                    
                                                                                
     IF FL-TOM-INFIL = NEJ                                                      
       PUT WXTR07D4                                                             
