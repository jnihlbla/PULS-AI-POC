                         NAME   STEG02                                          
                                                                                
     IF RECORD-COUNT =  1                                                       
       SPAR-IDDC       = DEFR-IDDC                                              
       SPAR-IDPRC      = DEFR-IDPRC                                             
       SPAR-KDORDKL    = DEFR-KDORDKL                                           
       SPAR-IDDISTR    = DEFR-IDDISTR                                           
       SPAR-IDKUNDNR   = DEFR-IDKUNDNR                                          
       SPAR-IDKUNDRF   = DEFR-IDKUNDRF                                          
       FL-TOM-INFIL    = NEJ                                                    
       W-EFR-STD       = 0                                                      
       W-EFR-AVG       = 0                                                      
       W-EFR-LINES     = 0                                                      
       W-EFR-VKARTNTO  = 0                                                      
       W-EFR-VLARTNTO  = 0                                                      
     END-IF                                                                     
                                                                                
     IF  SPAR-IDDC       = DEFR-IDDC      AND                     +             
         SPAR-IDPRC      = DEFR-IDPRC     AND                     +             
         SPAR-KDORDKL    = DEFR-KDORDKL   AND                     +             
         SPAR-IDDISTR    = DEFR-IDDISTR   AND                     +             
         SPAR-IDKUNDNR   = DEFR-IDKUNDNR  AND                     +             
         SPAR-IDKUNDRF   = DEFR-IDKUNDRF                                        
       W-EFR-LINES     = W-EFR-LINES    + 1                                     
       W-EFR-VKARTNTO  = W-EFR-VKARTNTO                         +               
                     + (DEFR-KVBEART-Q    * DEFR-VKARTNTO)      +               
                     + (DEFR-KVEFRS-OPACK * DEFR-VKARTNTO)      +               
                     + (DEFR-KVEFRS-PACK  * DEFR-VKARTNTO)      +               
                     + (DEFR-KVEFRS-SKEPP * DEFR-VKARTNTO)                      
       W-EFR-VLARTNTO  = W-EFR-VLARTNTO                         +               
                     + (DEFR-KVBEART-Q    * DEFR-VLARTNTO)      +               
                     + (DEFR-KVEFRS-OPACK * DEFR-VLARTNTO)      +               
                     + (DEFR-KVEFRS-PACK  * DEFR-VLARTNTO)      +               
                     + (DEFR-KVEFRS-SKEPP * DEFR-VLARTNTO)                      
       PERFORM S23-CHECK-SPAR-IDDC                                              
       IF SPAR-IDDC = NDC-NA OR                                 +               
          SPAR-IDDC = NDC-CN OR                                 +               
          SPAR-IDDC = LDC-CN                                                    
         W-EFR-STD =    0                                                       
         W-EFR-AVG =    W-EFR-AVG                               +               
                     + (DEFR-KVBEART-Q    * DEFR-PRAVCOST)      +               
                     + (DEFR-KVEFRS-OPACK * DEFR-PRAVCOST)      +               
                     + (DEFR-KVEFRS-PACK  * DEFR-PRAVCOST)      +               
                     + (DEFR-KVEFRS-SKEPP * DEFR-PRAVCOST)                      
       ELSE                                                                     
         W-EFR-STD =    W-EFR-STD                               +               
                     + (DEFR-KVBEART-Q    * DEFR-PRARTSTD)      +               
                     + (DEFR-KVEFRS-OPACK * DEFR-PRARTSTD)      +               
                     + (DEFR-KVEFRS-PACK  * DEFR-PRARTSTD)      +               
                     + (DEFR-KVEFRS-SKEPP * DEFR-PRARTSTD)                      
         W-EFR-AVG =    0                                                       
       END-IF                                                                   
     ELSE                                                                       
                                                                                
       PERFORM S01-SKRIV-FIL                                                    
                                                                                
       W-EFR-LINES     = 1                                                      
       W-EFR-VKARTNTO  = 0                                      +               
                     + (DEFR-KVBEART-Q    * DEFR-VKARTNTO)      +               
                     + (DEFR-KVEFRS-OPACK * DEFR-VKARTNTO)      +               
                     + (DEFR-KVEFRS-PACK  * DEFR-VKARTNTO)      +               
                     + (DEFR-KVEFRS-SKEPP * DEFR-VKARTNTO)                      
       W-EFR-VLARTNTO  = 0                                      +               
                     + (DEFR-KVBEART-Q    * DEFR-VLARTNTO)      +               
                     + (DEFR-KVEFRS-OPACK * DEFR-VLARTNTO)      +               
                     + (DEFR-KVEFRS-PACK  * DEFR-VLARTNTO)      +               
                     + (DEFR-KVEFRS-SKEPP * DEFR-VLARTNTO)                      
                                                                                
       SPAR-IDDC       = DEFR-IDDC                                              
       SPAR-IDPRC      = DEFR-IDPRC                                             
       SPAR-KDORDKL    = DEFR-KDORDKL                                           
       SPAR-IDDISTR    = DEFR-IDDISTR                                           
       SPAR-IDKUNDNR   = DEFR-IDKUNDNR                                          
       SPAR-IDKUNDRF   = DEFR-IDKUNDRF                                          
                                                                                
       PERFORM S23-CHECK-SPAR-IDDC                                              
       IF SPAR-IDDC = NDC-NA OR                                 +               
          SPAR-IDDC = NDC-CN OR                                 +               
