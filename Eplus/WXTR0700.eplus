  Z-SKRIV-SISTA-POST.  PROC                                                     
                                                                                
     TMP-DEFR-IDDC          = SPAR-IDDC                                         
     TMP-DEFR-IDPRC         = SPAR-IDPRC                                        
     TMP-DEFR-KDORDKL       = SPAR-KDORDKL                                      
     TMP-DEFR-IDDISTR       = SPAR-IDDISTR                                      
     TMP-DEFR-IDKUNDNR      = SPAR-IDKUNDNR                                     
     TMP-DEFR-IDKUNDRF      = SPAR-IDKUNDRF                                     
     TMP-DEFR-EFR-STD       = W-EFR-STD                                         
     TMP-DEFR-EFR-AVG       = W-EFR-AVG                                         
     TMP-DEFR-EFR-LINES     = W-EFR-LINES                                       
     TMP-DEFR-EFR-VKARTNTO  = W-EFR-VKARTNTO                                    
