                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4182400                                              *        
*                                                                      *        
*  DATUM      :  970527                                                *        
*                                                                      *        
*  FUNKTION   :  MATCHAR W41842 MED LAGERBANDET OCH SKAPAR             *        
*                UPPFÖLJNINGSFIL. DETTA PGM ÄR EN KOPIA AV             *        
*                W4282000 MED DEN SKILLNADEN ATT ENDAST NDC-POSTER *            
*                (DVS IDFTG EJ LIKA MED 57) BEHANDLAS,                 *        
*                PLUS ATT SUARTBTO & -RET BERÄKNAS MHA PRARTBTO-LOCINV *        
*                DVS LOKALA VIPS-FAKTURANS PRISER I LOKAL VALUTA.      *        
*                SAMT ATT ÖVRIGA SUART-FÄLT BERÄKNAS I ETT EFTER-      *        
*                FÖLJANDE PGM PGA ATT PRAVCOST SKALL ANVÄNDAS.         *        
*                                                                      *        
*  FÖRFATTARE :  STEFANO GIOBBI, WM-DATA.  :)                          *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     031028      SUSANNE OLSSON....       9233..                      *        
*     050823      SUSANNE OLSSON           9235  E-TRACKER 1572353     *        
*     051213      SUSANNE OLSSON           9235  E-TRACKER 2913019     *        
*     111117      SUSANNE OLSSON           9532  E-TRACKER 10143271    *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W42824D1                                                                   
W41842-IDPTYP 1 3    A                                                          
WDA201-DATA   4 145  A                                                          
WDA211-DATA   4 288  A                                                          
WDA221-DATA   4 1051 A                                                          
*                                                                               
FILE W42824D2                                                                   
%W01160                                                                         
*                                                                               
FILE TEMPFIL FB (309 0)                                                         
%W4282001    'TEMP-'                                                            
*                                                                               
FILE W42824D3 FB (309 0)                                                        
*  ENDAST NDC-POSTER, DVS IDFTG NE 57                                           
%W4282001    'UT-'                                                              
*                                                                               
NEWPAGE                                                                         
*                                                                               
%WDA201                                                                         
*                                                                               
%WDA211                                                                         
*                                                                               
*  CHECK IDFTG VALUES                                                           
%WWIDFTG      WORK ''                                                           
*                                                                               
*COPYTEXTER FÖR CALL                                                            
*                                                                               
%W418OKOD 'OKOD-'                                                               
*                                                                               
%WDATAREA                                                                       
*                                                                               
WDATKONV                 W  8   A   VALUE 'WDATKONV'                            
W418OKOD                 W  8   A   VALUE 'W418OKOD'                            
*                                                                               
JA                       W  1   A   VALUE 'J'                                   
NEJ                      W  1   A   VALUE 'N'                                   
W-TIAAVV-ALFA            W  4   A                                               
W-TIAAVV-NUM W-TIAAVV-ALFA  4   N                                               
                                                                                
W-KONV-AAAAMMDD          W  8   N                                               
W-KONV-AAMMDD   W-KONV-AAAAMMDD +2  6  N                                        
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
* SELEKTERAR UT DATA FRÅN WDA2 OCH SKAPAR TEMPFIL                               
*                                                                               
JOB INPUT W42824D1                                                              
IF W41842-IDPTYP = '201'                                                        
   ANM-WDA201                                 = WDA201-DATA                     
ELSE                                                                            
  IF W41842-IDPTYP = '211'                                                      
     LEV-WDA211                               = WDA211-DATA                     
    IF LEV-IDFTG NE WC-IDFTG-PV                                                 
      IF LEV-KDANMORS NE '84'                                                   
       TEMP-IDDISTR                             = ANM-IDDISTR                   
       TEMP-IDKUNDNR                            = ANM-IDKUNDNR                  
       TEMP-IDRAPPNR                            = ANM-IDRAPPNR                  
       TEMP-IDARTNR                             = LEV-IDARTNR                   
       TEMP-IDFKNGRP                            = 0                             
       TEMP-IDDC                                = LEV-IDDC                      
       TEMP-ADLAGOMR                            = LEV-ADLAGOMR                  
       TEMP-ADGANG                              = LEV-ADGANG                    
       TEMP-ADPLATS                             = LEV-ADPLATS                   
       TEMP-KDANMORS                            = LEV-KDANMORS                  
       OKOD-KDANMORS                            = LEV-KDANMORS                  
       CALL W418OKOD USING OKOD-W418OKOD                                        
       IF OKOD-FL-RETILL = JA OR OKOD-FL-INTERNUPPACKNING = JA                  
         TEMP-KDANMTYP                          = 2                             
       ELSE                                                                     
         IF OKOD-FL-KRENOT-DIREKT-SKR = JA                                      
           TEMP-KDANMTYP                        = 3                             
         ELSE                                                                   
           IF OKOD-FL-KRENOT-DIREKT = JA                                        
             TEMP-KDANMTYP                      = 0                             
           ELSE                                                                 
             IF OKOD-FL-TF = JA                                                 
               TEMP-KDANMTYP                    = 1                             
             ELSE                                                               
                IF LEV-KDANMORS = '39'                                          
                ELSE                                                            
                  DISPLAY 'FEL OKOD ' LEV-KDANMORS                              
                  STOP EXECUTE                                                  
                END-IF                                                          
             END-IF                                                             
           END-IF                                                               
         END-IF                                                                 
       END-IF                                                                   
       TEMP-KDKREBEH                            = LEV-KDKREBEH                  
       TEMP-FLDIRLEV                            = LEV-FLDIRLEV                  
       TEMP-IDANALYS                            = LEV-IDANALYS                  
  *----  START DATUMBEHANDLING                                                  
  *----  BEHANDLA LEVERANSANMÄRKNINGSDATUM                                      
       DAT-KDDATFORM                            = 'AAMMDD'                      
       IF ANM-DALEVANM > +0                                                     
         W-KONV-AAAAMMDD                        = ANM-DALEVANM                  
         DAT-I-TIDATUM                          = W-KONV-AAMMDD                 
         CALL WDATKONV USING (DAT-KDDATFORM     +                               
                             DAT-I-TIDATUM      +                               
                             DAT-O-TIDATUM      +                               
                             DAT-KDSVAR)                                        
         IF DAT-KDSVAR = ' '                                                    
           TEMP-TISAAPP-LEVANM-TISEKEL          = DAT-TISEKEL                   
           TEMP-TISAAVV-LEVANM-TISEKEL          = DAT-TISEKEL                   
           TEMP-TISAAPP-LEVANM-TIAAPP            = DAT-TIAAPP                   
           W-TIAAVV-ALFA                        = DAT-TIAAVV-GRP                
           TEMP-TISAAVV-LEVANM-TIAAVV                = W-TIAAVV-NUM             
         ELSE                                                                   
           DISPLAY 'FEL FRÅN DATKONV TILEVANM = ' ANM-DALEVANM                  
           DISPLAY 'DISTR = ' ANM-IDDISTR                                       
           DISPLAY 'KUND  = ' ANM-IDKUNDNR                                      
           DISPLAY 'RAPPNR= ' ANM-IDRAPPNR                                      
           TEMP-TISAAPP-LEVANM                  = '000000'                      
           TEMP-TISAAVV-LEVANM                  = '000000'                      
         END-IF                                                                 
       ELSE                                                                     
         TEMP-TISAAPP-LEVANM                    = '000000'                      
         TEMP-TISAAVV-LEVANM                    = '000000'                      
       END-IF                                                                   
  *----  BEHANDLA RETURTILLSTÅNDSDATUM                                          
       IF ANM-DARETILL > +0                                                     
         IF OKOD-FL-RETILL = JA OR OKOD-FL-INTERNUPPACKNING = JA                
           W-KONV-AAAAMMDD                      = ANM-DARETILL                  
           DAT-I-TIDATUM                        = W-KONV-AAMMDD                 
           CALL WDATKONV USING (DAT-KDDATFORM   +                               
                               DAT-I-TIDATUM    +                               
                               DAT-O-TIDATUM    +                               
                               DAT-KDSVAR)                                      
           IF DAT-KDSVAR = ' '                                                  
             TEMP-TISAAPP-RETILL-TISEKEL        = DAT-TISEKEL                   
             TEMP-TISAAVV-RETILL-TISEKEL        = DAT-TISEKEL                   
             TEMP-TISAAPP-RETILL-TIAAPP         = DAT-TIAAPP                    
             W-TIAAVV-ALFA                      = DAT-TIAAVV-GRP                
             TEMP-TISAAVV-RETILL-TIAAVV         = W-TIAAVV-NUM                  
           ELSE                                                                 
             DISPLAY 'FEL FRÅN DATKONV TIRETANK = ' ANM-DARETILL                
             STOP EXECUTE                                                       
           END-IF                                                               
         ELSE                                                                   
           TEMP-TISAAPP-RETILL                  = '000000'                      
           TEMP-TISAAVV-RETILL                  = '000000'                      
         END-IF                                                                 
       ELSE                                                                     
         TEMP-TISAAPP-RETILL                    = '000000'                      
         TEMP-TISAAVV-RETILL                    = '000000'                      
       END-IF                                                                   
  *----  BEHANDLA RETUR ANKOMMEN DATUM                                          
       IF ANM-DARETANK > +0                                                     
         W-KONV-AAAAMMDD                        = ANM-DARETANK                  
         DAT-I-TIDATUM                          = W-KONV-AAMMDD                 
         CALL WDATKONV USING (DAT-KDDATFORM     +                               
                             DAT-I-TIDATUM      +                               
                             DAT-O-TIDATUM      +                               
                             DAT-KDSVAR)                                        
         IF DAT-KDSVAR = ' '                                                    
           TEMP-TISAAPP-RETANK-TISEKEL          = DAT-TISEKEL                   
           TEMP-TISAAVV-RETANK-TISEKEL          = DAT-TISEKEL                   
           TEMP-TISAAPP-RETANK-TIAAPP           = DAT-TIAAPP                    
           W-TIAAVV-ALFA                        = DAT-TIAAVV-GRP                
           TEMP-TISAAVV-RETANK-TIAAVV           = W-TIAAVV-NUM                  
         ELSE                                                                   
           DISPLAY 'FEL FRÅN DATKONV TIRETANK = ' ANM-DARETANK                  
           STOP EXECUTE                                                         
         END-IF                                                                 
       ELSE                                                                     
         TEMP-TISAAPP-RETANK                    = '000000'                      
         TEMP-TISAAVV-RETANK                    = '000000'                      
       END-IF                                                                   
  *----  BEHANDLA INLÄGGNINGSDATUM                                              
       IF LEV-TIINLINL > +0                                                     
         DAT-I-TIDATUM                          = LEV-TIINLINL                  
         CALL WDATKONV USING (DAT-KDDATFORM     +                               
                             DAT-I-TIDATUM      +                               
                             DAT-O-TIDATUM      +                               
                             DAT-KDSVAR)                                        
         IF DAT-KDSVAR = ' '                                                    
           TEMP-TISAAPP-INLINL-TISEKEL          = DAT-TISEKEL                   
           TEMP-TISAAVV-INLINL-TISEKEL          = DAT-TISEKEL                   
           TEMP-TISAAPP-INLINL-TIAAPP           = DAT-TIAAPP                    
           W-TIAAVV-ALFA                        = DAT-TIAAVV-GRP                
           TEMP-TISAAVV-INLINL-TIAAVV           = W-TIAAVV-NUM                  
         ELSE                                                                   
           DISPLAY 'FEL FRÅN DATKONV TIINLINL = ' LEV-TIINLINL                  
           STOP EXECUTE                                                         
         END-IF                                                                 
       ELSE                                                                     
         TEMP-TISAAPP-INLINL                    = '000000'                      
         TEMP-TISAAVV-INLINL                    = '000000'                      
       END-IF                                                                   
  *----  BEHANDLA KREDITNOTADATUM                                               
       IF LEV-TIKNOTA > +0                                                      
         DAT-I-TIDATUM                          = LEV-TIKNOTA                   
         CALL WDATKONV USING (DAT-KDDATFORM     +                               
                             DAT-I-TIDATUM      +                               
                             DAT-O-TIDATUM      +                               
                             DAT-KDSVAR)                                        
         IF DAT-KDSVAR = ' '                                                    
           TEMP-TISAAPP-KNOTA-TISEKEL           = DAT-TISEKEL                   
           TEMP-TISAAVV-KNOTA-TISEKEL           = DAT-TISEKEL                   
           TEMP-TISAAPP-KNOTA-TIAAPP            = DAT-TIAAPP                    
           W-TIAAVV-ALFA                        = DAT-TIAAVV-GRP                
           TEMP-TISAAVV-KNOTA-TIAAVV            = W-TIAAVV-NUM                  
         ELSE                                                                   
           DISPLAY 'FEL FRÅN DATKONV TIKNOTA  = ' LEV-TIKNOTA                   
           STOP EXECUTE                                                         
         END-IF                                                                 
       ELSE                                                                     
         TEMP-TISAAPP-KNOTA                     = '000000'                      
         TEMP-TISAAVV-KNOTA                     = '000000'                      
       END-IF                                                                   
  *---- DATUMBEHANDLING SLUT                                                    
       TEMP-IDFTG                               = LEV-IDFTG                     
       TEMP-IDDC-RET                            = LEV-IDDC-RET                  
       TEMP-KDFRAKT                             = LEV-KDFRAKT                   
       TEMP-KVLEVANM                            = LEV-KVLEVANM                  
       TEMP-KVRETINL                            = LEV-KVRETINL                  
       TEMP-KVRETINL-SKR                        = LEV-KVRETINL-SKR              
       TEMP-KVAVV-KVAL                          = LEV-KVAVV-KVAL                
       TEMP-KVAVV-KVANT                         = LEV-KVAVV-KVANT               
       TEMP-SUARTBTO                            =                      +        
                                   LEV-KVLEVANM * LEV-PRARTBTO-LOCINV           
       TEMP-SUARTBTO-RET                        =                      +        
              (LEV-KVRETINL + LEV-KVRETINL-SKR) * LEV-PRARTBTO-LOCINV           
       TEMP-SUARTSTD                            = 0                             
       TEMP-SUARTSTD-INL                        = 0                             
       TEMP-SUARTSTD-SKR                        = 0                             
       TEMP-SUARTSTD-KVAL                       = 0                             
       TEMP-SUARTSTD-KVANT                      = 0                             
       TEMP-VKART                               = 0                             
       TEMP-VKART-KRED                          = 0                             
       TEMP-VKART-KVANT                         = 0                             
       TEMP-VLARTNTO                            = 0                             
       TEMP-VLARTNTO-KRED                       = 0                             
       TEMP-VLARTNTO-KVANT                      = 0                             
       TEMP-KDARBTYP-RET                        = ANM-KDARBTYP                  
       TEMP-IDPERSON-RET                        = ANM-IDPERSON                  
       TEMP-KDARBTYP-ADM                        = LEV-KDARBTYP                  
       TEMP-IDPERSON-ADM                        = LEV-IDPERSON                  
       TEMP-IDANSTNR-RET                        = LEV-IDANSTNR-RET              
       TEMP-KDORDKL                             = LEV-KDORDKL                   
       TEMP-IDUSER-PACK                         = LEV-IDUSER-PACK               
                                                                                
       IF LEV-KDANMORS = '39'                                                   
       ELSE                                                                     
         PUT TEMPFIL                                                            
       END-IF                                                                   
  *    DISPLAY TEMP-IDARTNR                                                     
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
*                                                                               
SORT TEMPFIL TO TEMPFIL USING TEMP-IDARTNR                                      
*                                                                               
JOB INPUT (W42824D2 KEY (CLAG-IDARTNR) +                                        
           TEMPFIL  KEY (TEMP-IDARTNR) )                                        
  IF MATCHED                                                                    
*   DISPLAY 'MATCHED ' CLAG-IDARTNR                                             
    UT-W42820                                 = TEMP-W42820                     
    UT-IDFKNGRP                               = CLAG-IDFKNGRP                   
    UT-VKART                                  =                   +             
                                TEMP-KVLEVANM * CLAG-VKART                      
    UT-VKART-KRED                             =                   +             
          (TEMP-KVRETINL + TEMP-KVRETINL-SKR) * CLAG-VKART                      
    UT-VKART-KVANT                            =                   +             
                             TEMP-KVAVV-KVANT * CLAG-VKART                      
    UT-VLARTNTO                               =                   +             
                                TEMP-KVLEVANM * CLAG-VLARTNTO                   
    UT-VLARTNTO-KRED                          =                   +             
          (TEMP-KVRETINL + TEMP-KVRETINL-SKR) * CLAG-VLARTNTO                   
    UT-VLARTNTO-KVANT                         =                   +             
                             TEMP-KVAVV-KVANT * CLAG-VLARTNTO                   
    IF UT-ADLAGOMR = 0                                                          
      UT-ADLAGOMR                             = CLAG-ADLAGOMR                   
    END-IF                                                                      
    PUT W42824D3                                                                
  ELSE                                                                          
    IF TEMPFIL                                                                  
      UT-W42820                               = TEMP-W42820                     
    DISPLAY 'TEMPFIL ' TEMP-IDARTNR                                             
      PUT W42824D3                                                              
    END-IF                                                                      
  END-IF                                                                        
