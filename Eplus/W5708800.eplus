                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5708800                                              *        
*                                                                      *        
*  FUNKTION   :  CREATE .CSV REPORT FOR CHINA AND US FINANCE DEPT      *        
*                TO SEPARATE PARTS PURCHASED FROM VCCS FROM NGC        *        
*                                                                      *        
*  FÖRFATTARE :  ARCHANA BHAT                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W57088D1                                                                   
*                                                                               
%W57087  'IN-'                                                                  
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
                                                                                
**** EXCEL-FIL-CHINA, MAIL VIA DAP                                              
FILE W57088D2  PRINTER VB(125 0)                                                
                                                                                
**** EXCEL-FIL-US, MAIL VIA DAP                                                 
FILE W57088D3  PRINTER VB(125 0)                                                
                                                                                
W-PERIOD                    W    6 N                                            
W-PART-NUM                  W    9 N 0 MASK 'ZZZZZZZZ9'                         
W-DC                        W    2 A                                            
W-PROD-GRP                  W    3 N 0 MASK 'ZZ9'                               
W-VENDOR                    W    5 A                                            
W-AVG-COST                  W    9 N 2 MASK 'ZZZZZZ9.99'                        
W-STOCK-AVAIL               W    7 N 0 MASK 'ZZZZZZ9'                           
W-INV-VALUE-STD             W    9 N 2 MASK 'ZZZZZZ9.99'                        
W-SEM1                      W    1 A VALUE ';'                                  
FIRST-TIME-SW-US            W    1 A VALUE 'Y'                                  
FIRST-TIME-SW-CN            W    1 A VALUE 'Y'                                  
W-STOCK-CAL                 W    9 N                                            
                                                                                
JOB INPUT W57088D1                                                              
                                                                                
   PERFORM S23-CHECK-IN-IDDC                                                    
   IF IN-IDDC = NDC-CN                                                          
      W-PERIOD           = IN-PERIOD                                            
      W-PART-NUM         = IN-IDARTNR                                           
      W-DC               = IN-IDDC                                              
      W-PROD-GRP         = IN-KDPRODSL                                          
      W-VENDOR           = IN-IDLEVNR                                           
      W-AVG-COST         = IN-PRAVCOST                                          
      W-STOCK-CAL        = IN-KVEFRS + IN-KVLS                                  
      W-STOCK-AVAIL      = W-STOCK-CAL                                          
      W-INV-VALUE-STD    = W-STOCK-CAL * IN-PRAVCOST                            
                                                                                
      PRINT XL-LIST-CN                                                          
    END-IF                                                                      
                                                                                
   IF IN-IDDC = NDC-US                                                          
      W-PERIOD           = IN-PERIOD                                            
      W-PART-NUM         = IN-IDARTNR                                           
      W-DC               = IN-IDDC                                              
      W-PROD-GRP         = IN-KDPRODSL                                          
      W-VENDOR           = IN-IDLEVNR                                           
      W-AVG-COST         = IN-PRAVCOST                                          
      W-STOCK-CAL        = IN-KVEFRS + IN-KVLS                                  
      W-STOCK-AVAIL      = W-STOCK-CAL                                          
      W-INV-VALUE-STD    = W-STOCK-CAL * IN-PRAVCOST                            
                                                                                
      PRINT XL-LIST-US                                                          
    END-IF                                                                      
                                                                                
*                                                                               
*    --- S23-CHECK-IN-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'IN-'                                                                   
*                                                                               
NEWPAGE                                                                         
  REPORT   XL-LIST-CN           +                                               
           PRINTER W57088D2     +                                               
           LINESIZE 120         +                                               
           SPACE 0              +                                               
           NOHEADING            +                                               
           NOSPREAD             +                                               
           NOADJUST             +                                               
           PAGESIZE 32767       +                                               
           NODATE                                                               
  LINE  1  W-PERIOD             +                                               
           W-SEM1               +                                               
           W-PART-NUM           +                                               
           W-SEM1               +                                               
           W-DC                 +                                               
           W-SEM1               +                                               
           W-PROD-GRP           +                                               
           W-SEM1               +                                               
           W-VENDOR             +                                               
           W-SEM1               +                                               
           W-AVG-COST           +                                               
           W-SEM1               +                                               
           W-STOCK-AVAIL        +                                               
           W-SEM1               +                                               
           W-INV-VALUE-STD                                                      
*                                                                               
BEFORE-LINE. PROC                                                               
 IF FIRST-TIME-SW-CN = 'Y'                                                      
      DISPLAY '¤DAPW57088-001'                                                  
      DISPLAY '¤DAPW57088'                                                      
      DISPLAY 'PERIOD;PART NUMBER;DC;PRODUCT GROUP;VENDOR;AVERAGE' +            
           ' COST;STOCK ON HAND;INVENTORY VALUE(SUM);'                          
      FIRST-TIME-SW-CN = 'N'                                                    
 END-IF                                                                         
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
  REPORT   XL-LIST-US           +                                               
           PRINTER W57088D3     +                                               
           LINESIZE 120         +                                               
           SPACE 0              +                                               
           NOHEADING            +                                               
           NOSPREAD             +                                               
           NOADJUST             +                                               
           PAGESIZE 32767       +                                               
           NODATE                                                               
  LINE  1  W-PERIOD             +                                               
           W-SEM1               +                                               
           W-PART-NUM           +                                               
           W-SEM1               +                                               
           W-DC                 +                                               
           W-SEM1               +                                               
           W-PROD-GRP           +                                               
           W-SEM1               +                                               
           W-VENDOR             +                                               
           W-SEM1               +                                               
           W-AVG-COST           +                                               
           W-SEM1               +                                               
           W-STOCK-AVAIL        +                                               
           W-SEM1               +                                               
           W-INV-VALUE-STD                                                      
*                                                                               
BEFORE-LINE. PROC                                                               
 IF FIRST-TIME-SW-US = 'Y'                                                      
      DISPLAY '¤DAPW57088-002'                                                  
      DISPLAY '¤DAPW57088'                                                      
      DISPLAY 'PERIOD;PART NUMBER;DC;PRODUCT GROUP;VENDOR;AVERAGE' +            
           ' COST;STOCK ON HAND;INVENTORY VALUE(SUM);'                          
      FIRST-TIME-SW-US = 'N'                                                    
 END-IF                                                                         
END-PROC                                                                        
