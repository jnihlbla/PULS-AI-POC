*                                                                               
NEWPAGE                                                                         
FILE W44078D5 FB (121 121) PRINTER                                              
*                                                                               
NEWPAGE                                                                         
*                                                                               
JA            W 1 A       VALUE 'J'                                             
NEJ           W 1 A       VALUE 'N'                                             
*                                                                               
C1-IDARTNR    W 5 P       VALUE 0                                               
C1-IDDC       W 2 A       VALUE '  '                                            
C1-RESS       W 4 P 0                                                           
C1-KVRO-DAG   W 4 P 0                                                           
C1-KVRO-BULK  W 4 P 0                                                           
C1-SUTPO-PB   W 4 P 0                                                           
C1-SUTPO-EJPB W 4 P 0                                                           
C1-SUTPO-TOT  W 4 P 0                                                           
*                                                                               
BLANKA1       W  8 A                                                            
BLANKA2       W 15 A                                                            
DIFF-PB       W  4 P 0               MASK '------9'                             
DIFF-EJPB     W  4 P 0               MASK '------9'                             
DIFF-TOT      W  4 P 0               MASK '------9'                             
DIFF-RO-DAG   W  4 P 0               MASK '------9'                             
DIFF-RO-BULK  W  4 P 0               MASK '------9'                             
DIFF-RES      W  4 P 0               MASK '------9'                             
*                                                                               
TEST-IDDC     W 2 A                                                             
TEST-IDARTNR  W 5 P                                                             
*                                                                               
PR-RADSALDO-KVRESS      W 4 P 0       MASK 'ZZZZZZ9'                            
PR-RADSALDO-KVROS-DAG   W 4 P 0       MASK 'ZZZZZZ9'                            
PR-RADSALDO-KVROS-BULK  W 4 P 0       MASK 'ZZZZZZ9'                            
PR-RADSALDO-SUTPO-PB    W 4 P 0       MASK 'ZZZZZZ9'                            
PR-RADSALDO-SUTPO-EJPB  W 4 P 0       MASK 'ZZZZZZ9'                            
PR-RADSALDO-SUTPO-TOT   W 4 P 0       MASK 'ZZZZZZ9'                            
NEWPAGE                                                                         
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
JOB INPUT(NULL)                                                  +              
                                                             NAME AKT01         
*                                                                               
  GET W44078D1                                                                  
  DO WHILE NOT EOF W44078D1                                                     
     PERFORM S23-CHECK-Q4-IDDC                                                  
     IF Q4-IDDC = NDC                                                           
        TEST-IDARTNR     = Q4-IDARTNR                                           
        WDQ4-IDARTNR     = Q4-IDARTNR                                           
        TEST-IDDC        = Q4-IDDC                                              
        WDQ4-IDDC        = Q4-IDDC                                              
        WDQ4-KVBEART-Q   = 0                                                    
        DO WHILE NOT EOF W44078D1             AND +                             
                 Q4-IDDC = TEST-IDDC          AND +                             
                 Q4-IDARTNR = TEST-IDARTNR                                      
           WDQ4-KVBEART-Q = WDQ4-KVBEART-Q + Q4-KVBEART-Q                       
           GET W44078D1                                                         
        END-DO                                                                  
        PUT WDQ4                                                                
     ELSE                                                                       
        GET W44078D1                                                            
     END-IF                                                                     
  END-DO                                                                        
NEWPAGE                                                                         
                                                                                
  GET W44078D3                                                                  
  DO WHILE NOT EOF W44078D3                                                     
     PERFORM S23-CHECK-Q1-IDDC                                                  
     IF Q1-IDDC = NDC                                                           
        TEST-IDARTNR     = Q1-IDARTNR                                           
        WDQ1-IDARTNR     = Q1-IDARTNR                                           
        TEST-IDDC        = Q1-IDDC                                              
        WDQ1-IDDC        = Q1-IDDC                                              
        WDQ1-KVBEART-Q   = 0                                                    
        DO WHILE NOT EOF W44078D3             AND +                             
                 Q1-IDDC = TEST-IDDC          AND +                             
                 Q1-IDARTNR = TEST-IDARTNR                                      
           WDQ1-KVBEART-Q = WDQ1-KVBEART-Q + Q1-KVBEART-Q                       
           GET W44078D3                                                         
        END-DO                                                                  
        PUT WDQ1                                                                
     ELSE                                                                       
        GET W44078D3                                                            
     END-IF                                                                     
  END-DO                                                                        
NEWPAGE                                                                         
                                                                                
  GET W44078D2                                                                  
  DO WHILE NOT EOF W44078D2                                                     
     PERFORM S23-CHECK-A5-RAD-IDDC                                              
     IF A5-RAD-IDDC = NDC                                                       
        C1-IDARTNR    = A5-RAD-IDARTNR                                          
        C1-IDDC       = A5-RAD-IDDC                                             
        C1-KVRO-DAG   = 0                                                       
        C1-KVRO-BULK  = 0                                                       
        C1-SUTPO-TOT  = 0                                                       
        C1-SUTPO-PB   = 0                                                       
        C1-SUTPO-EJPB = 0                                                       
        C1-RESS       = 0                                                       
        TEST-IDDC     = A5-RAD-IDDC                                             
        TEST-IDARTNR  = A5-RAD-IDARTNR                                          
        DO WHILE NOT EOF W44078D2                      AND +                    
                 A5-RAD-IDDC         = TEST-IDDC       AND +                    
                 A5-RAD-IDARTNR      = TEST-IDARTNR                             
                                                                                
           IF A5-RAD-KDSTARAD  = '1'             AND +                          
              A5-RAD-FLTPOBEK  = 'J'             AND +                          
              A5-RAD-KDTPOTYP NE 4                                              
              C1-SUTPO-TOT    = C1-SUTPO-TOT  + A5-RAD-KVART                    
              IF A5-RAD-KDTPOTYP = 1 2                                          
                 C1-SUTPO-PB   = C1-SUTPO-PB   + A5-RAD-KVART                   
              ELSE                                                              
                 C1-SUTPO-EJPB = C1-SUTPO-EJPB + A5-RAD-KVART                   
              END-IF                                                            
           END-IF                                                               
           IF A5-RAD-KDSTARAD = '2'                                             
              IF A5-RAD-KDORDKL < 2                                             
                 C1-KVRO-DAG = C1-KVRO-DAG + A5-RAD-KVART                       
              ELSE                                                              
                 IF A5-RAD-KDORDKL < 5                                          
                    C1-KVRO-BULK = C1-KVRO-BULK + A5-RAD-KVART                  
                 END-IF                                                         
              END-IF                                                            
           END-IF                                                               
           IF A5-RAD-KDSTARAD = '3'     AND +                                   
              A5-RAD-DARODAT > 0                                                
              C1-RESS = C1-RESS + A5-RAD-KVART                                  
           END-IF                                                               
           GET W44078D2                                                         
        END-DO                                                                  
                                                                                
        WDA5-IDARTNR    = C1-IDARTNR                                            
        WDA5-IDDC       = C1-IDDC                                               
        WDA5-KVRO-DAG   = C1-KVRO-DAG                                           
        WDA5-KVRO-BULK  = C1-KVRO-BULK                                          
        WDA5-SUTPO-PB   = C1-SUTPO-PB                                           
        WDA5-SUTPO-EJPB = C1-SUTPO-EJPB                                         
        WDA5-SUTPO-TOT  = C1-SUTPO-TOT                                          
        WDA5-RESS       = C1-RESS                                               
                                                                                
        IF WDA5-KVRO-DAG   = 0  AND                       +                     
           WDA5-KVRO-BULK  = 0  AND                       +                     
           WDA5-SUTPO-PB   = 0  AND                       +                     
           WDA5-SUTPO-EJPB = 0  AND                       +                     
           WDA5-SUTPO-TOT  = 0  AND                       +                     
           WDA5-RESS       = 0                                                  
        ELSE                                                                    
          PUT WDA5                                                              
        END-IF                                                                  
     END-IF                                                                     
     IF C1-IDDC = '  '                                                          
        GET W44078D2                                                            
     END-IF                                                                     
  END-DO                                                                        
                                                                                
  STOP                                                                          
*    --- S23-CHECK-Q4-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'Q4-'                                                                   
*                                                                               
*    --- S23-CHECK-Q1-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'Q1-'                                                                   
*                                                                               
*    --- S23-CHECK-A5-RAD-IDDC (MACRO PROCEDURE)                                
%WWDC02 'A5-RAD-'                                                               
*                                                                               
NEWPAGE                                                                         
JOB INPUT(WDA5  KEY (WDA5-IDDC    WDA5-IDARTNR)                 +               
          WDQ4  KEY (WDQ4-IDDC    WDQ4-IDARTNR)                 +               
          WDQ1  KEY (WDQ1-IDDC    WDQ1-IDARTNR))                +               
                                                             NAME AKT04         
  IF MATCHED                                                                    
     RADSALDO-IDARTNR    = WDA5-IDARTNR                                         
     RADSALDO-IDDC       = WDA5-IDDC                                            
     RADSALDO-KVRESS     = WDA5-RESS +                          +               
                           WDQ4-KVBEART-Q +                     +               
                           WDQ1-KVBEART-Q                                       
     RADSALDO-KVROS-DAG  = WDA5-KVRO-DAG                                        
     RADSALDO-KVROS-BULK = WDA5-KVRO-BULK                                       
     RADSALDO-SUTPO-PB   = WDA5-SUTPO-PB                                        
     RADSALDO-SUTPO-EJPB = WDA5-SUTPO-EJPB                                      
     RADSALDO-SUTPO-TOT  = RADSALDO-SUTPO-PB +                  +               
                           RADSALDO-SUTPO-EJPB                                  
     PUT RADSALDO                                                               
  ELSE                                                                          
     IF MATCHED WDA5 WDQ4                                                       
        RADSALDO-IDARTNR = WDA5-IDARTNR                                         
        RADSALDO-IDDC    = WDA5-IDDC                                            
        RADSALDO-KVRESS  = WDA5-RESS +                          +               
                           WDQ4-KVBEART-Q                                       
        RADSALDO-KVROS-DAG = WDA5-KVRO-DAG                                      
        RADSALDO-KVROS-BULK = WDA5-KVRO-BULK                                    
        RADSALDO-SUTPO-PB = WDA5-SUTPO-PB                                       
        RADSALDO-SUTPO-EJPB = WDA5-SUTPO-EJPB                                   
        RADSALDO-SUTPO-TOT = RADSALDO-SUTPO-PB +                +               
                             RADSALDO-SUTPO-EJPB                                
        PUT RADSALDO                                                            
     ELSE                                                                       
        IF MATCHED WDA5 WDQ1                                                    
           RADSALDO-IDARTNR = WDA5-IDARTNR                                      
           RADSALDO-IDDC = WDA5-IDDC                                            
           RADSALDO-KVRESS = WDA5-RESS +                        +               
                             WDQ1-KVBEART-Q                                     
           RADSALDO-KVROS-DAG = WDA5-KVRO-DAG                                   
           RADSALDO-KVROS-BULK = WDA5-KVRO-BULK                                 
           RADSALDO-SUTPO-PB = WDA5-SUTPO-PB                                    
           RADSALDO-SUTPO-EJPB = WDA5-SUTPO-EJPB                                
           RADSALDO-SUTPO-TOT = RADSALDO-SUTPO-PB +             +               
                                RADSALDO-SUTPO-EJPB                             
           PUT RADSALDO                                                         
        ELSE                                                                    
           IF MATCHED WDQ4 WDQ1                                                 
              RADSALDO-IDARTNR = WDQ4-IDARTNR                                   
              RADSALDO-IDDC = WDQ4-IDDC                                         
              RADSALDO-KVRESS = WDQ4-KVBEART-Q +                +               
                                WDQ1-KVBEART-Q                                  
              RADSALDO-KVROS-DAG = 0                                            
              RADSALDO-KVROS-BULK = 0                                           
              RADSALDO-SUTPO-PB = 0                                             
              RADSALDO-SUTPO-EJPB = 0                                           
              RADSALDO-SUTPO-TOT = 0                                            
              PUT RADSALDO                                                      
           ELSE                                                                 
              IF WDA5                                                           
                 RADSALDO-IDARTNR = WDA5-IDARTNR                                
                 RADSALDO-IDDC = WDA5-IDDC                                      
                 RADSALDO-KVRESS = WDA5-RESS                                    
                 RADSALDO-KVROS-DAG = WDA5-KVRO-DAG                             
                 RADSALDO-KVROS-BULK = WDA5-KVRO-BULK                           
                 RADSALDO-SUTPO-PB = WDA5-SUTPO-PB                              
                 RADSALDO-SUTPO-EJPB = WDA5-SUTPO-EJPB                          
                 RADSALDO-SUTPO-TOT = RADSALDO-SUTPO-PB +       +               
                                      RADSALDO-SUTPO-EJPB                       
                 PUT RADSALDO                                                   
              ELSE                                                              
                 IF WDQ4                                                        
                    RADSALDO-IDARTNR = WDQ4-IDARTNR                             
                    RADSALDO-IDDC = WDQ4-IDDC                                   
                    RADSALDO-KVRESS = WDQ4-KVBEART-Q                            
                    RADSALDO-KVROS-DAG = 0                                      
                    RADSALDO-KVROS-BULK = 0                                     
                    RADSALDO-SUTPO-PB = 0                                       
                    RADSALDO-SUTPO-EJPB = 0                                     
                    RADSALDO-SUTPO-TOT = 0                                      
                    PUT RADSALDO                                                
                 ELSE                                                           
                    IF WDQ1                                                     
                       RADSALDO-IDARTNR = WDQ1-IDARTNR                          
                       RADSALDO-IDDC = WDQ1-IDDC                                
                       RADSALDO-KVRESS = WDQ1-KVBEART-Q                         
                       RADSALDO-KVROS-DAG = 0                                   
                       RADSALDO-KVROS-BULK = 0                                  
                       RADSALDO-SUTPO-PB = 0                                    
                       RADSALDO-SUTPO-EJPB = 0                                  
                       RADSALDO-SUTPO-TOT = 0                                   
                       PUT RADSALDO                                             
                    END-IF                                                      
                 END-IF                                                         
              END-IF                                                            
           END-IF                                                               
        END-IF                                                                  
     END-IF                                                                     
  END-IF                                                                        
                                                                                
NEWPAGE                                                                         
JOB INPUT (W44078D4 KEY (K7-ART-IDDC    K7-ART-IDARTNR))        +               
                                                             NAME AKT05         
  IF W44078D4                                                                   
     PERFORM S23-CHECK-K7-ART-IDDC                                              
     IF K7-ART-IDDC = NDC                                                       
        ARTSALDO-IDARTNR    = K7-ART-IDARTNR                                    
        ARTSALDO-IDDC       = K7-ART-IDDC                                       
        ARTSALDO-KVRESS     = K7-ART-KVRESS                                     
        ARTSALDO-KVROS-DAG  = K7-ART-KVROS-DAG                                  
        ARTSALDO-KVROS-BULK = K7-ART-KVROS-BULK                                 
        ARTSALDO-SUTPO-TOT  = 0                                                 
        ARTSALDO-SUTPO-PB   = 0                                                 
        ARTSALDO-SUTPO-EJPB = 0                                                 
        PUT ARTSALDO                                                            
     END-IF                                                                     
  END-IF                                                                        
                                                                                
*    --- S23-CHECK-K7-ART-IDDC (MACRO PROCEDURE)                                
%WWDC02 'K7-ART-'                                                               
*                                                                               
NEWPAGE                                                                         
JOB INPUT (ARTSALDO KEY (ARTSALDO-IDDC                          +               
                         ARTSALDO-IDARTNR)                      +               
           RADSALDO KEY (RADSALDO-IDDC                          +               
                         RADSALDO-IDARTNR))                     +               
                                                             NAME AKT06         
  IF MATCHED                                                                    
     IF ARTSALDO-KVRESS     NE RADSALDO-KVRESS     OR            +              
        ARTSALDO-KVROS-DAG  NE RADSALDO-KVROS-DAG  OR            +              
        ARTSALDO-KVROS-BULK NE RADSALDO-KVROS-BULK OR            +              
        ARTSALDO-SUTPO-PB   NE RADSALDO-SUTPO-PB   OR            +              
        ARTSALDO-SUTPO-EJPB NE RADSALDO-SUTPO-EJPB OR            +              
        ARTSALDO-SUTPO-TOT  NE RADSALDO-SUTPO-TOT                               
        DIFF-RES     = ARTSALDO-KVRESS     - RADSALDO-KVRESS                    
        DIFF-RO-DAG  = ARTSALDO-KVROS-DAG  - RADSALDO-KVROS-DAG                 
        DIFF-RO-BULK = ARTSALDO-KVROS-BULK - RADSALDO-KVROS-BULK                
        DIFF-PB      = ARTSALDO-SUTPO-PB   - RADSALDO-SUTPO-PB                  
        DIFF-EJPB    = ARTSALDO-SUTPO-EJPB - RADSALDO-SUTPO-EJPB                
        DIFF-TOT     = ARTSALDO-SUTPO-TOT  - RADSALDO-SUTPO-TOT                 
        IF DIFF-RES     =  0                       AND           +              
           DIFF-RO-DAG  =  0                       AND           +              
           DIFF-RO-BULK =  0                                                    
        ELSE                                                                    
           PERFORM SKRIV-FELFIL                                                 
           PR-RADSALDO-SUTPO-PB   = RADSALDO-SUTPO-PB                           
           PR-RADSALDO-SUTPO-EJPB = RADSALDO-SUTPO-EJPB                         
           PR-RADSALDO-SUTPO-TOT  = RADSALDO-SUTPO-TOT                          
           PR-RADSALDO-KVROS-DAG  = RADSALDO-KVROS-DAG                          
           PR-RADSALDO-KVROS-BULK = RADSALDO-KVROS-BULK                         
           PR-RADSALDO-KVRESS     = RADSALDO-KVRESS                             
           PRINT FELLISTA                                                       
        END-IF                                                                  
     END-IF                                                                     
  ELSE                                                                          
     IF ARTSALDO                                                                
        IF ARTSALDO-KVRESS     NE 0          OR                  +              
           ARTSALDO-KVROS-DAG  NE 0          OR                  +              
           ARTSALDO-KVROS-BULK NE 0          OR                  +              
           ARTSALDO-SUTPO-PB   NE 0          OR                  +              
           ARTSALDO-SUTPO-EJPB NE 0          OR                  +              
           ARTSALDO-SUTPO-TOT  NE 0                                             
           DIFF-RES     = ARTSALDO-KVRESS                                       
           DIFF-RO-DAG  = ARTSALDO-KVROS-DAG                                    
           DIFF-RO-BULK = ARTSALDO-KVROS-BULK                                   
           DIFF-PB      = ARTSALDO-SUTPO-PB                                     
           DIFF-EJPB    = ARTSALDO-SUTPO-EJPB                                   
           DIFF-TOT     = ARTSALDO-SUTPO-TOT                                    
           IF DIFF-RES     =  0              AND                +               
              DIFF-RO-DAG  =  0              AND                +               
              DIFF-RO-BULK =  0                                                 
           ELSE                                                                 
              PERFORM SKRIV-FELFIL                                              
              PR-RADSALDO-SUTPO-PB   = 0                                        
              PR-RADSALDO-SUTPO-EJPB = 0                                        
              PR-RADSALDO-SUTPO-TOT  = 0                                        
              PR-RADSALDO-KVROS-DAG  = 0                                        
              PR-RADSALDO-KVROS-BULK = 0                                        
              PR-RADSALDO-KVRESS     = 0                                        
              PRINT FELLISTA                                                    
           END-IF                                                               
        END-IF                                                                  
     END-IF                                                                     
  END-IF                                                                        
                                                                                
NEWPAGE                                                                         
                                                                                
SKRIV-FELFIL. PROC                                                              
                                                                                
       UT-IDARTNR      = ARTSALDO-IDARTNR                                       
       UT-IDDC         = ARTSALDO-IDDC                                          
       IF DIFF-RES NE 0                                                         
          IF DIFF-RES < 0                                                       
             UT-KDMETOD  = 'ADD'                                                
          ELSE                                                                  
             UT-KDMETOD  = 'SUB'                                                
          END-IF                                                                
          UT-TIBEHOV    = 0                                                     
          UT-IDDB       = '711   '                                              
          UT-KVANTAL    = DIFF-RES                                              
          UT-IDSALDO    = 'KVRESS       '                                       
          PUT W44078D6                                                          
       END-IF                                                                   
                                                                                
       IF DIFF-RO-DAG NE 0                                                      
          IF DIFF-RO-DAG < 0                                                    
             UT-KDMETOD  = 'ADD'                                                
          ELSE                                                                  
             UT-KDMETOD  = 'SUB'                                                
          END-IF                                                                
          UT-TIBEHOV    = 0                                                     
          UT-IDDB       = '711   '                                              
          UT-KVANTAL    = DIFF-RO-DAG                                           
          UT-IDSALDO    = 'KVROS-DAG    '                                       
          PUT W44078D6                                                          
       END-IF                                                                   
                                                                                
       IF DIFF-RO-BULK NE 0                                                     
          IF DIFF-RO-BULK < 0                                                   
             UT-KDMETOD  = 'ADD'                                                
          ELSE                                                                  
             UT-KDMETOD  = 'SUB'                                                
          END-IF                                                                
          UT-TIBEHOV    = 0                                                     
          UT-IDDB       = '711   '                                              
          UT-KVANTAL    = DIFF-RO-BULK                                          
          UT-IDSALDO    = 'KVROS-BULK   '                                       
          PUT W44078D6                                                          
       END-IF                                                                   
                                                                                
    END-PROC                                                                    
NEWPAGE                                                                         
*                                                                               
  REPORT FELLISTA   +                                                           
         LINESIZE 120 SPACE 1 PRINTER W44078D5                                  
*                                                                               
    TITLE 1 'W4407800 - DIFFERENS ARTIKELREGISTER-RESTORDERREGISTER'            
    TITLE 2 'ARTIKELSALDO RELATIVT RADSUMMOR'                                   
    TITLE 4 BLANKA1 'ARTIKELREGISTREN' BLANKA2 'RESTORDERREGISTREN'             
*                                                                               
    HEADING ARTSALDO-IDARTNR            'ARTNR'                                 
    HEADING ARTSALDO-IDDC               'NL'                                    
    HEADING DIFF-PB                     'TPO-PB'                                
    HEADING DIFF-EJPB                   'TPO-EJPB'                              
