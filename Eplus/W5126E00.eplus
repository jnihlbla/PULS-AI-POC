UD3-TOTOBSD3     UD3-FOOTER2    +57  2  N 2                                     
UD3-SEP31        UD3-FOOTER2    +59  1  A   VALUE ';'                           
UD3-TOTOBSN4     UD3-FOOTER2    +60 11  N 0                                     
UD3-SEP32        UD3-FOOTER2    +71  1  A   VALUE '.'                           
UD3-TOTOBSD4     UD3-FOOTER2    +72  2  N 2                                     
UD3-SEP33        UD3-FOOTER2    +74  1  A   VALUE ';'                           
UD3-TOTOBSN5     UD3-FOOTER2    +75 11  N 0                                     
UD3-SEP34        UD3-FOOTER2    +86  1  A   VALUE '.'                           
UD3-TOTOBSD5     UD3-FOOTER2    +87  2  N 2                                     
UD3-SEP35        UD3-FOOTER2    +89  1  A   VALUE ';'                           
UD3-TOTOBSN6     UD3-FOOTER2    +90 11  N 0                                     
UD3-SEP36        UD3-FOOTER2   +101  1  A   VALUE '.'                           
UD3-TOTOBSD6     UD3-FOOTER2   +102  2  N 2                                     
*                                                                               
UD3-FOOTER3  W    135   A                                                       
UD3-TOTALOBS     UD3-FOOTER3        10  A   VALUE 'TOTAL OBS:'                  
UD3-SEP37        UD3-FOOTER3    +11  1  A   VALUE ';'                           
UD3-TOTOBSPN     UD3-FOOTER3    +12 11  N 0                                     
UD3-SEP38        UD3-FOOTER3    +23  1  A   VALUE '.'                           
UD3-TOTOBSPD     UD3-FOOTER3    +24  2  N 2                                     
UD3-SEP39        UD3-FOOTER3    +26  1  A   VALUE ';'                           
UD3-PERCENTAGEN  UD3-FOOTER3    +27  3  N 0                                     
UD3-SEP40        UD3-FOOTER3    +30  1  A   VALUE '.'                           
UD3-PERCENTAGED  UD3-FOOTER3    +31  2  N 2                                     
UD3-SEP41        UD3-FOOTER3    +33  1  A   VALUE ';'                           
UD3-SEP42        UD3-FOOTER3    +34 10  A   VALUE '% OF TOTAL'                  
*                                                                               
UD3-FOOTER4  W    135   A                                                       
UD3-TOTALTO      UD3-FOOTER4        19  A   VALUE 'TOTAL IN TURNOVER :'         
UD3-SEP43        UD3-FOOTER4    +20  1  A   VALUE ';'                           
UD3-STOCKVALUEN  UD3-FOOTER4    +21 11  N 0                                     
UD3-SEP44        UD3-FOOTER4    +32  1  A   VALUE '.'                           
UD3-STOCKVALUED  UD3-FOOTER4    +33  2  N 2                                     
**                                                                              
NEWPAGE                                                                         
WS-PG-TOT-STVL1   W   9   P   2 VALUE 0                                         
WS-PG-TOT-STVL2   W   9   P   2 VALUE 0                                         
WS-PG-TOT-STVL3   W   9   P   2 VALUE 0                                         
WS-PG-TOT-STVL4   W   9   P   2 VALUE 0                                         
WS-PG-TOT-STVL5   W   9   P   2 VALUE 0                                         
WS-PG-TOT-STVL6   W   9   P   2 VALUE 0                                         
WS-ST-TOT-STVL1   W   9   P   2 VALUE 0                                         
WS-ST-TOT-STVL2   W   9   P   2 VALUE 0                                         
WS-ST-TOT-STVL3   W   9   P   2 VALUE 0                                         
WS-ST-TOT-STVL4   W   9   P   2 VALUE 0                                         
WS-ST-TOT-STVL5   W   9   P   2 VALUE 0                                         
WS-ST-TOT-STVL6   W   9   P   2 VALUE 0                                         
WS-TOT-OBS        W   9   P   2 VALUE 0                                         
WST-PERCENTAGE    W   5   P   2 VALUE 0                                         
WS-SUP-TOT-STVL  W   9   P   2 VALUE 0                                          
WS1-INKRESDEL    W   3   P   2 VALUE 0.02                                       
WS2-INKRESDEL    W   3   P   2 VALUE 0.02                                       
WS3-INKRESDEL    W   3   P   2 VALUE 0.14                                       
WS4-INKRESDEL    W   3   P   2 VALUE 0.58                                       
WS5-INKRESDEL    W   3   P   2 VALUE 0.91                                       
WS6-INKRESDEL    W   3   P   2 VALUE 1.00                                       
HEAD-FLAG        W   1   A     VALUE 'Y'                                        
W-DATE           W  10  A                                                       
RUB-DATAA   W-DATE           2  N                                               
RUB-SEP1    W-DATE       +3  1  A VALUE '-'                                     
RUB-DATMM   W-DATE       +4  2  N                                               
RUB-SEP2    W-DATE       +6  1  A VALUE '-'                                     
RUB-DATDD   W-DATE       +7  2  N                                               
*                                                                               
W-STVL-FMT       W  13  N 2                                                     
W-STVL-N        W-STVL-FMT         11  N 0                                      
W-STVL-D        W-STVL-FMT     +11  2  N 2                                      
                                                                                
%WDATKORT                                                                       
PROGRAM-NAMN     W   6   A  VALUE 'W5126E'                                      
DATUMKORT-ID     W   6   A  VALUE 'WDATUM'                                      
                                                                                
*                                                                               
*----------------------------------------------------------------------*        
*  SORTS W5126ED1 ON PRODUCT GROUP                                              
*----------------------------------------------------------------------*        
SORT W5126ED1 TO TPFILE1  USING (IN-KDPRODSL) SIZE 900000 +                     
                            BEFORE SORT-INIT1                                   
 SORT-INIT1. PROC                                                               
  IF IN-STOCKVALUE1 EQ 0 AND +                                                  
     IN-STOCKVALUE2 EQ 0 AND +                                                  
     IN-STOCKVALUE3 EQ 0 AND +                                                  
     IN-STOCKVALUE4 EQ 0 AND +                                                  
     IN-STOCKVALUE5 EQ 0 AND +                                                  
     IN-STOCKVALUE6 EQ 0                                                        
     CONTINUE                                                                   
  ELSE                                                                          
     SELECT                                                                     
  END-IF                                                                        
 END-PROC                                                                       
*                                                                               
*----------------------------------------------------------------------*        
* STEP 6. READS TPFILE1 ON PRODUCT GROUP                                        
*----------------------------------------------------------------------*        
JOB INPUT (TPFILE1  KEY(TP1-KDPRODSL)) START B-INIT +                           
                                      FINISH X-FINIT                            
       UD3-KDPRODSL    = TP1-KDPRODSL                                           
       WS-PG-TOT-STVL1 = WS-PG-TOT-STVL1 + TP1-STOCKVALUE1                      
       WS-PG-TOT-STVL2 = WS-PG-TOT-STVL2 + TP1-STOCKVALUE2                      
       WS-PG-TOT-STVL3 = WS-PG-TOT-STVL3 + TP1-STOCKVALUE3                      
       WS-PG-TOT-STVL4 = WS-PG-TOT-STVL4 + TP1-STOCKVALUE4                      
       WS-PG-TOT-STVL5 = WS-PG-TOT-STVL5 + TP1-STOCKVALUE5                      
       WS-PG-TOT-STVL6 = WS-PG-TOT-STVL6 + TP1-STOCKVALUE6                      
       IF LAST-DUP TPFILE1 OR NOT DUPLICATE TPFILE1                             
          W-STVL-FMT      = WS-PG-TOT-STVL1                                     
          WS-ST-TOT-STVL1 = WS-ST-TOT-STVL1 + WS-PG-TOT-STVL1                   
          UD3-STOCKVALN1  = W-STVL-N                                            
          UD3-STOCKVALD1  = W-STVL-D                                            
          W-STVL-FMT      = 0                                                   
          W-STVL-FMT      = WS-PG-TOT-STVL2                                     
          WS-ST-TOT-STVL2 = WS-ST-TOT-STVL2 + WS-PG-TOT-STVL2                   
          UD3-STOCKVALN2  = W-STVL-N                                            
          UD3-STOCKVALD2  = W-STVL-D                                            
          W-STVL-FMT      = 0                                                   
          W-STVL-FMT      = WS-PG-TOT-STVL3                                     
          WS-ST-TOT-STVL3 = WS-ST-TOT-STVL3 + WS-PG-TOT-STVL3                   
          UD3-STOCKVALN3  = W-STVL-N                                            
          UD3-STOCKVALD3  = W-STVL-D                                            
          W-STVL-FMT      = 0                                                   
          W-STVL-FMT      = WS-PG-TOT-STVL4                                     
          WS-ST-TOT-STVL4 = WS-ST-TOT-STVL4 + WS-PG-TOT-STVL4                   
          UD3-STOCKVALN4  = W-STVL-N                                            
          UD3-STOCKVALD4  = W-STVL-D                                            
          W-STVL-FMT      = 0                                                   
          W-STVL-FMT      = WS-PG-TOT-STVL5                                     
          WS-ST-TOT-STVL5 = WS-ST-TOT-STVL5 + WS-PG-TOT-STVL5                   
          UD3-STOCKVALN5  = W-STVL-N                                            
          UD3-STOCKVALD5  = W-STVL-D                                            
          W-STVL-FMT      = 0                                                   
          W-STVL-FMT      = WS-PG-TOT-STVL6                                     
          WS-ST-TOT-STVL6 = WS-ST-TOT-STVL6 + WS-PG-TOT-STVL6                   
          UD3-STOCKVALN6  = W-STVL-N                                            
          UD3-STOCKVALD6  = W-STVL-D                                            
          W-STVL-FMT      = 0                                                   
          UTD3-DATA  = UD3-DATA                                                 
          PUT W5126ED2                                                          
          WS-PG-TOT-STVL1 = 0                                                   
          WS-PG-TOT-STVL2 = 0                                                   
          WS-PG-TOT-STVL3 = 0                                                   
          WS-PG-TOT-STVL4 = 0                                                   
          WS-PG-TOT-STVL5 = 0                                                   
          WS-PG-TOT-STVL6 = 0                                                   
       END-IF                                                                   
  B-INIT. PROC                                                                  
    IF HEAD-FLAG = 'Y'                                                          
       CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                 
       RUB-DATAA  = D-AAR                                                       
       RUB-DATMM  = D-MAANAD                                                    
       RUB-DATDD  = D-DAG                                                       
       UD3-COL15  = W-DATE                                                      
       UTD3-DATA  = UD3-HEAD1                                                   
       PUT W5126ED2                                                             
       UTD3-DATA  = UD3-HEAD2                                                   
       PUT W5126ED2                                                             
       HEAD-FLAG = 'N'                                                          
    END-IF                                                                      
  END-PROC                                                                      
  X-FINIT. PROC                                                                 
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-ST-TOT-STVL1                                           
    UD3-TOTSTVLN1   = W-STVL-N                                                  
    UD3-TOTSTVLD1   = W-STVL-D                                                  
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-ST-TOT-STVL1 * WS1-INKRESDEL                           
    WS-TOT-OBS      = WS-TOT-OBS + W-STVL-FMT                                   
    UD3-TOTOBSN1    = W-STVL-N                                                  
    UD3-TOTOBSD1    = W-STVL-D                                                  
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-ST-TOT-STVL2                                           
    UD3-TOTSTVLN2   = W-STVL-N                                                  
    UD3-TOTSTVLD2   = W-STVL-D                                                  
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-ST-TOT-STVL2 * WS2-INKRESDEL                           
    WS-TOT-OBS      = WS-TOT-OBS + W-STVL-FMT                                   
    UD3-TOTOBSN2    = W-STVL-N                                                  
    UD3-TOTOBSD2    = W-STVL-D                                                  
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-ST-TOT-STVL3                                           
    UD3-TOTSTVLN3   = W-STVL-N                                                  
    UD3-TOTSTVLD3   = W-STVL-D                                                  
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-ST-TOT-STVL3 * WS3-INKRESDEL                           
    WS-TOT-OBS      = WS-TOT-OBS + W-STVL-FMT                                   
    UD3-TOTOBSN3    = W-STVL-N                                                  
    UD3-TOTOBSD3    = W-STVL-D                                                  
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-ST-TOT-STVL4                                           
    UD3-TOTSTVLN4   = W-STVL-N                                                  
    UD3-TOTSTVLD4   = W-STVL-D                                                  
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-ST-TOT-STVL4 * WS4-INKRESDEL                           
    WS-TOT-OBS      = WS-TOT-OBS + W-STVL-FMT                                   
    UD3-TOTOBSN4    = W-STVL-N                                                  
    UD3-TOTOBSD4    = W-STVL-D                                                  
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-ST-TOT-STVL5                                           
    UD3-TOTSTVLN5   = W-STVL-N                                                  
    UD3-TOTSTVLD5   = W-STVL-D                                                  
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-ST-TOT-STVL5 * WS5-INKRESDEL                           
    WS-TOT-OBS      = WS-TOT-OBS + W-STVL-FMT                                   
    UD3-TOTOBSN5    = W-STVL-N                                                  
    UD3-TOTOBSD5    = W-STVL-D                                                  
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-ST-TOT-STVL6                                           
    UD3-TOTSTVLN6   = W-STVL-N                                                  
    UD3-TOTSTVLD6   = W-STVL-D                                                  
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-ST-TOT-STVL6 * WS6-INKRESDEL                           
    WS-TOT-OBS      = WS-TOT-OBS + W-STVL-FMT                                   
    UD3-TOTOBSN6    = W-STVL-N                                                  
    UD3-TOTOBSD6    = W-STVL-D                                                  
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-TOT-OBS                                                
    UD3-TOTOBSPN    = W-STVL-N                                                  
    UD3-TOTOBSPD    = W-STVL-D                                                  
    WS-SUP-TOT-STVL = WS-ST-TOT-STVL1   +                                       
                    + WS-ST-TOT-STVL2   +                                       
                    + WS-ST-TOT-STVL3   +                                       
                    + WS-ST-TOT-STVL4   +                                       
                    + WS-ST-TOT-STVL5   +                                       
                    + WS-ST-TOT-STVL6                                           
    WST-PERCENTAGE  = 100 * (WS-TOT-OBS / WS-SUP-TOT-STVL)                      
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WST-PERCENTAGE                                            
    UD3-PERCENTAGEN = W-STVL-N                                                  
    UD3-PERCENTAGED = W-STVL-D                                                  
    UTD3-DATA  = UD3-FOOTER1                                                    
    PUT W5126ED2                                                                
    UTD3-DATA  = UD3-FOOTER2                                                    
    PUT W5126ED2                                                                
    UTD3-DATA  = UD3-FOOTER3                                                    
    PUT W5126ED2                                                                
    W-STVL-FMT      = 0                                                         
    W-STVL-FMT      = WS-SUP-TOT-STVL                                           
    UD3-STOCKVALUEN = W-STVL-N                                                  
    UD3-STOCKVALUED = W-STVL-D                                                  
    UTD3-DATA  = UD3-FOOTER4                                                    
    PUT W5126ED2                                                                
  END-PROC                                                                      
