                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6124600                                              *        
*                                                                      *        
*  FUNKTION   :  LÄSER W61244 AVVIKELSE VID REFILLINLEVERNAS           *        
*                SKAPAR LISTA                                          *        
*                                                                      *        
*  FÖRFATTARE :  BODIL LINDAHL                                         *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W61246D1                                                                   
*                                                                               
%W61244  'IN-'                                                                  
NEWPAGE                                                                         
FILE W61246D2  PRINTER FB (133 0)                                               
*                                                                               
PROGRAM-NAMN      W   6   A   VALUE 'W61246'                                    
DATUMKORT-ID      W   6   A   VALUE 'WDATUM'                                    
%WDATKORT 'DATKORT-'                                                            
NEWPAGE                                                                         
WS-RAKNARE        W               10  P  2                                      
WS-RAKNARE-TOT    W               10  P  2                                      
INNEV-AAVV        W                4  N                                         
INNEV-AA          INNEV-AAVV       2  N                                         
INNEV-VV          INNEV-AAVV  +2   2  N                                         
WS-IDLEVNR        W   5   A                                                     
WS-IDARTNR        W   8   N   MASK 'ZZZZZZZ9'.                                  
WS-IDFAKT         W   7   N   MASK 'ZZZZZZ9'                                    
WS-KVANTAL        W   7   N   MASK 'ZZZZZZ9'.                                   
WS-IDKUNDRF       W   6   A                                                     
WS-SUM            W  12   N   MASK 'ZZZZZZZZZ9.99'.                             
WS-SUM-TOT        W  12   N   MASK 'ZZZZZZZZZ9.99'.                             
NEWPAGE                                                                         
************************************************************************        
* LÄSER INFIL W61244                                                            
************************************************************************        
JOB INPUT (W61246D1) +                                                          
    START (A-INIT)                                                              
                                                                                
  WS-IDLEVNR  = IN-IDLEVNR                                                      
  WS-IDARTNR  = IN-IDARTNR                                                      
  WS-IDFAKT   = IN-IDFAKT                                                       
  WS-KVANTAL  = IN-KVANTAL                                                      
  WS-IDKUNDRF = IN-IDKUNDRF                                                     
  WS-RAKNARE  = IN-KVANTAL * IN-PRARTBES-PR                                     
                                                                                
  PRINT RAPPORT01                                                               
                                                                                
A-INIT. PROC                                                                    
*                                                                               
  CALL DATKORT  USING (PROGRAM-NAMN +                                           
                       DATUMKORT-ID +                                           
                       DATKORT-DATUMKORT)                                       
  INNEV-AA      = DATKORT-D-AAR                                                 
  INNEV-VV      = DATKORT-D-VECKA                                               
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
REPORT RAPPORT01 PRINTER W61246D2 LINESIZE 132 PAGESIZE 41 +                    
       NOADJUST NOSPREAD SPACE 1 TITLESKIP 3                                    
                                                                                
SEQUENCE IN-IDLEVNR IN-IDDC-SEND IN-IDFAKT IN-IDARTNR                           
CONTROL  WS-IDLEVNR                                                             
SUM      WS-RAKNARE                                                             
                                                                                
TITLE 1  COL 12  'SDC AVVIKELSE REFILL INLEVERANS '        +                    
         COL 48  'VECKA'                                   +                    
         COL 55  INNEV-AAVV                                                     
                                                                                
HEADING WS-IDLEVNR       ('LEV.NR')                                             
HEADING IN-IDDC-SEND     ('DC SEND')                                            
HEADING WS-IDFAKT        ('FAKT.NR')                                            
HEADING IN-IDDC-REC      ('DC MOT')                                             
HEADING IN-IDKUNDRF      ('ORDER NR')                                           
HEADING WS-IDARTNR       ('ART.NR')                                             
HEADING WS-KVANTAL       ('AVVIK.ANTAL')                                        
HEADING WS-RAKNARE       ('AVVIK.ANTAL * PRIS')                                 
HEADING IN-AVVIKELSETYP  ('AVVIKELSE TYP')                                      
                                                                                
LINE 01  WS-IDLEVNR IN-IDDC-SEND WS-IDFAKT IN-IDDC-REC        +                 
         IN-IDKUNDRF WS-IDARTNR WS-KVANTAL WS-RAKNARE         +                 
         IN-AVVIKELSETYP                                                        
