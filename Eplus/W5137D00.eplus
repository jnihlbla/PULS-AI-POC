                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W513 INVENTERINGEN                                    *        
*                                                                      *        
*  PROGRAM    :  W5137D00                                              *        
*                                                                      *        
*  FUNKTION   :  SKAPAR EN GÅNG OM ÅRET, ÅRETS SISTA KÖRNING AV W513D2,*        
*                SOM HÄR HETER W513Y1, EN FIL MED KOMMANDE ÅRS ÅRTAL   *        
*                FÖR VILKET ÅR URVALSFILER SKALL SKAPAS.               *        
*                                                                      *        
*  FÖRFATTARE :  KJ HANSSON                                            *        
*                                                                      *        
*  UTFIL      :  W5137D                                                *        
*                                                                      *        
*----------------------------------------------------------------------*        
*-----------------------*                                                       
* DET NYA ÅRETS ÅRTAL.                                                          
*-----------------------*                                                       
FILE W5137DD1  FB(80 0)                                                         
%W5137D  'UT-'                                                                  
                                                                                
W-PGMNAMN       W 6 A VALUE 'W5137D'                                            
W-WDATUM        W 6 A VALUE 'WDATUM'                                            
                                                                                
%WDATKORT                                                                       
                                                                                
JOB INPUT NULL                                                                  
                                                                                
  CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                             
                                                                                
  UT-TIAAAA = 2000 + D-AAR + 1                                                  
  PUT W5137DD1                                                                  
 STOP EXECUTE                                                                   
