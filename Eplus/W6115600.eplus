*                / NDC:ERNA NA                                         *        
*                                                                      *        
*  FÖRFATTARE :  MÅNS SAMUELSSON                                       *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING   PROJEKT/ÄT      *        
*     941202      CONNY EGHOLT .....       57053.      SDC ST....      *        
*     970430      KENT JEBSEN ......       50653.      NDC.......      *        
*     111007      RAHUL REDDY ......       ......      CHINA WAREHOUSE *        
*     ......      ..................       ......      ..........      *        
*                                                                      *        
*----------------------------------------------------------------------*        
NEWPAGE                                                                         
FILE W61156D1                                                                   
%W6115001                                                                       
                                                                                
                                                                                
NEWPAGE                                                                         
FILE W61156D2  PRINTER VB (125 0)                                               
                                                                                
NEWPAGE                                                                         
FILE W61156D3  PRINTER FB (121 0)                                               
                                                                                
NEWPAGE                                                                         
FILE W61156D4  PRINTER FB (121 0)                                               
                                                                                
NEWPAGE                                                                         
FILE W61156D5  PRINTER FB (121 0)                                               
                                                                                
NEWPAGE                                                                         
FILE W61156D6  PRINTER FB (121 0)                                               
                                                                                
NEWPAGE                                                                         
FILE W61156D7  PRINTER FB (121 0)                                               
                                                                                
NEWPAGE                                                                         
FILE W61156D8 PRINTER VB (100 0)                                                
                                                                                
NEWPAGE                                                                         
                                                                                
FILE W61156DA                                                                   
DC-KOLL                 1  3 A                                                  
                                                                                
NEWPAGE                                                                         
FILE W61156DB                                                                   
%W93001    'KURS-'                                                              
                                                                                
NEWPAGE                                                                         
                                                                                
KVRADER-PROC            W  5 N 2 MASK 'ZZ9.99'                                  
SUBEL-PROC              W  5 N 2 MASK 'ZZ9.99'                                  
WS-DC-KOLL              W  3 A                                                  
WS-PREV-IDDC            W  2 A                                                  
WS-KURS-USD             W  4 N 2                                                
WS-KURS-CAD             W  4 N 2                                                
WS-KURS-CNY             W  4 N 2                                                
FL-FOERSTA-CAN          W  1 A   VALUE 'J'                                      
FL-FOERSTA-USA          W  1 A   VALUE 'J'                                      
FL-FOERSTA-CNY          W  1 A   VALUE 'J'                                      
WS-KVART                W  7 N   MASK '- --- --9'                               
WS-KVRADER              W  5 N   MASK '-- --9'                                  
WS-KVKOLLI              W  5 N   MASK '-- --9'                                  
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. HÄMTAR INFO OM IFALL KÖRNINGEN AVSER CDC/ NDCNA /NDC JPN-AUS          
*                                                                               
JOB INPUT W61156DA                                                              
WS-DC-KOLL = DC-KOLL                                                            
*                                                                               
* STEG 2. HÄMTAR VALUTAKURSER                                                   
*                                                                               
*** HÄMTAR AKTUELLA VALUTA-KURSER FÖR USA OCH CANADA                            
JOB INPUT W61156DB                                                              
IF KURS-SAP-KDVALISO = 'CAD' AND FL-FOERSTA-CAN = 'J'                           
   WS-KURS-CAD    = KURS-SAP-PRKURS                                             
   FL-FOERSTA-CAN = 'N'                                                         
END-IF                                                                          
IF KURS-SAP-KDVALISO = 'USD' AND FL-FOERSTA-USA = 'J'                           
   WS-KURS-USD    = KURS-SAP-PRKURS                                             
   FL-FOERSTA-USA = 'N'                                                         
END-IF                                                                          
IF KURS-SAP-KDVALISO = 'CNY' AND FL-FOERSTA-CNY = 'J'                           
   WS-KURS-CNY    = KURS-SAP-PRKURS                                             
   FL-FOERSTA-CNY = 'N'                                                         
END-IF                                                                          
*                                                                               
* STEG 3. LISTAR BELÄGGNINGSFILEN                                               
*                                                                               
SORT W61156D1 TO W61156D1 USING KDINLUPF                                        
*                                                                               
JOB INPUT W61156D1                                                              
                                                                                
  IF KDINLUPF = '    '                                                          
    KDINLUPF = 'TOT '                                                           
  END-IF                                                                        
  IF SUBEL > +0                                                                 
    SUBEL-PROC = (SUBEL-PRIO / SUBEL) * 100                                     
  ELSE                                                                          
    SUBEL-PROC = +0                                                             
  END-IF                                                                        
  IF KVRADER > +0                                                               
    KVRADER-PROC = (KVRADER-PRIO / KVRADER) * 100                               
  ELSE                                                                          
    KVRADER-PROC = +0                                                           
  END-IF                                                                        
                                                                                
  PERFORM S23-CHECK-IDDC                                                        
  IF WS-DC-KOLL = 'NDC'                                                         
    IF IDDC = NDC-US                                                            
      SUBEL      = SUBEL / WS-KURS-USD                                          
      SUBEL-PRIO = SUBEL-PRIO / WS-KURS-USD                                     
    ELSE                                                                        
      IF IDDC = NDC-CA                                                          
        SUBEL      = SUBEL / WS-KURS-CAD                                        
        SUBEL-PRIO = SUBEL-PRIO / WS-KURS-CAD                                   
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
                                                                                
  IF WS-DC-KOLL = 'CDC'                                                         
    IF IDDC = CDC-SE                                                            
      PRINT CDC-LISTA                                                           
    ELSE                                                                        
      IF IDDC = CDC-TR                                                          
        PRINT ST-LISTA                                                          
      END-IF                                                                    
    END-IF                                                                      
  ELSE                                                                          
    IF WS-DC-KOLL = 'NDC'                                                       
      IF IDDC = NDC-US-RU                                                       
        PRINT DC41-LISTA                                                        
      ELSE                                                                      
        IF IDDC = NDC-US-BAT                                                    
          PRINT DC92-LISTA                                                      
        ELSE                                                                    
          IF IDDC = NDC-US-LA                                                   
            PRINT DC43-LISTA                                                    
          ELSE                                                                  
            IF IDDC = NDC-CA                                                    
              PRINT DC51-LISTA                                                  
            END-IF                                                              
          END-IF                                                                
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
                                                                                
*    --- S23-CHECK-IDDC (MACRO PROCEDURE)                                       
%WWDC02 ''                                                                      
*                                                                               
NEWPAGE                                                                         
REPORT CDC-LISTA  PRINTER W61156D2 LINESIZE 120 DTLCTL FIRST                    
TITLE 1  'W61156-001  '  +                                                      
         'VOLVO CAR PARTS       AK-BELÄGGNING    DC11'                          
HEADING  KDINLUPF 'OMRÅDE'                                                      
HEADING  KVART    ('ANTAL  ' 'PARTIER')                                         
HEADING  KVRADER  ('ANTAL'   'RADER')                                           
HEADING  KVKOLLI  ('ANTAL '  'KOLLIN')                                          
HEADING  SUBEL    'VÄRDE'                                                       
HEADING  SUBEL-PROC ('%PRIO' 'VÄRDE')                                           
HEADING  KVRADER-PROC ('%PRIO' 'RADER')                                         
LINE  1  KDINLUPF KVART KVRADER KVKOLLI SUBEL SUBEL-PROC KVRADER-PROC           
                                                                                
NEWPAGE                                                                         
REPORT ST-LISTA  PRINTER W61156D3 LINESIZE 120 DTLCTL FIRST                     
TITLE 1  'W61156-002  '  +                                                      
         'VOLVO CAR PARTS       AK WORK LOAD     DC12'                          
HEADING  KDINLUPF 'AREA'                                                        
HEADING  KVART    ('QTY '  'LOTS')                                              
HEADING  KVRADER  ('QTY  ' 'LINES')                                             
HEADING  KVKOLLI  ('QTY  ' 'CASES')                                             
HEADING  SUBEL    'VALUE'                                                       
HEADING  SUBEL-PROC ('%PRIO' 'VALUE')                                           
HEADING  KVRADER-PROC ('%PRIO' 'LINES')                                         
LINE  1  KDINLUPF KVART KVRADER KVKOLLI SUBEL SUBEL-PROC KVRADER-PROC           
                                                                                
NEWPAGE                                                                         
REPORT DC41-LISTA  PRINTER W61156D4 LINESIZE 120 DTLCTL FIRST                   
TITLE 1  'W61156-003  VOLVO CAR PARTS      '  +                                 
         ' AK WORK LOAD  LOCAL RECEIVING      DC41'                             
HEADING  KDINLUPF 'AREA'                                                        
HEADING  KVART    ('QTY '  'LOTS')                                              
HEADING  KVRADER  ('QTY  ' 'LINES')                                             
HEADING  KVKOLLI  ('QTY  ' 'CASES')                                             
HEADING  SUBEL    'VALUE'                                                       
HEADING  SUBEL-PROC ('%PRIO' 'VALUE')                                           
HEADING  KVRADER-PROC ('%PRIO' 'LINES')                                         
LINE  1  KDINLUPF KVART KVRADER KVKOLLI SUBEL SUBEL-PROC KVRADER-PROC           
                                                                                
NEWPAGE                                                                         
REPORT DC92-LISTA  PRINTER W61156D5 LINESIZE 120 DTLCTL FIRST                   
TITLE 1  'W61156-004  VOLVO CAR PARTS      '  +                                 
         ' AK WORK LOAD  LOCAL RECEIVING      DC92'                             
HEADING  KDINLUPF 'AREA'                                                        
HEADING  KVART    ('QTY '  'LOTS')                                              
HEADING  KVRADER  ('QTY  ' 'LINES')                                             
HEADING  KVKOLLI  ('QTY  ' 'CASES')                                             
HEADING  SUBEL    'VALUE'                                                       
HEADING  SUBEL-PROC ('%PRIO' 'VALUE')                                           
HEADING  KVRADER-PROC ('%PRIO' 'LINES')                                         
LINE  1  KDINLUPF KVART KVRADER KVKOLLI SUBEL SUBEL-PROC KVRADER-PROC           
                                                                                
NEWPAGE                                                                         
REPORT DC43-LISTA  PRINTER W61156D6 LINESIZE 120 DTLCTL FIRST                   
TITLE 1  'W61156-005  VOLVO CAR PARTS      '  +                                 
         ' AK WORK LOAD  LOCAL RECEIVING      DC43'                             
HEADING  KDINLUPF 'AREA'                                                        
HEADING  KVART    ('QTY '  'LOTS')                                              
HEADING  KVRADER  ('QTY  ' 'LINES')                                             
HEADING  KVKOLLI  ('QTY  ' 'CASES')                                             
HEADING  SUBEL    'VALUE'                                                       
HEADING  SUBEL-PROC ('%PRIO' 'VALUE')                                           
HEADING  KVRADER-PROC ('%PRIO' 'LINES')                                         
LINE  1  KDINLUPF KVART KVRADER KVKOLLI SUBEL SUBEL-PROC KVRADER-PROC           
                                                                                
NEWPAGE                                                                         
REPORT DC51-LISTA  PRINTER W61156D7 LINESIZE 120 DTLCTL FIRST                   
TITLE 1  'W61156-006  VOLVO CAR PARTS      '  +                                 
         ' AK WORK LOAD  LOCAL RECEIVING      DC51'                             
HEADING  KDINLUPF 'AREA'                                                        
HEADING  KVART    ('QTY '  'LOTS')                                              
HEADING  KVRADER  ('QTY  ' 'LINES')                                             
HEADING  KVKOLLI  ('QTY  ' 'CASES')                                             
HEADING  SUBEL    'VALUE'                                                       
HEADING  SUBEL-PROC ('%PRIO' 'VALUE')                                           
HEADING  KVRADER-PROC ('%PRIO' 'LINES')                                         
LINE  1  KDINLUPF KVART KVRADER KVKOLLI SUBEL SUBEL-PROC KVRADER-PROC           
                                                                                
*                                                                               
* STEP 4. LISTAR BELÄGGNINGSFILEN                                               
*                                                                               
SORT W61156D1 TO W61156D1 USING (IDDC KDINLUPF)                                 
*                                                                               
JOB INPUT W61156D1                                                              
                                                                                
  IF KDINLUPF = '    '                                                          
    KDINLUPF = 'TOT '                                                           
  END-IF                                                                        
  IF SUBEL > +0                                                                 
    SUBEL-PROC = (SUBEL-PRIO / SUBEL) * 100                                     
  ELSE                                                                          
    SUBEL-PROC = +0                                                             
  END-IF                                                                        
  IF KVRADER > +0                                                               
    KVRADER-PROC = (KVRADER-PRIO / KVRADER) * 100                               
  ELSE                                                                          
    KVRADER-PROC = +0                                                           
  END-IF                                                                        
  WS-KVART       = KVART                                                        
  WS-KVRADER     = KVRADER                                                      
  WS-KVKOLLI     = KVKOLLI                                                      
*                                                                               
  PERFORM S23-CHECK-IDDC                                                        
  IF WS-DC-KOLL = 'DC7'                                                         
    SUBEL-PRIO = SUBEL-PRIO / WS-KURS-CNY                                       
    IF IDDC = NDC-CN                                                            
      PRINT DCCN-LISTA                                                          
    END-IF                                                                      
  END-IF                                                                        
                                                                                
*    --- S23-CHECK-IDDC (MACRO PROCEDURE)                                       
%WWDC02 ''                                                                      
*                                                                               
NEWPAGE                                                                         
REPORT DCCN-LISTA  PRINTER W61156D8 LINESIZE 90          +                      
                                    NOHEADING            +                      
                                    NOADJUST             +                      
                                    NODATE               +                      
                                    NOSPREAD +                                  
                                    SPACE 0                                     
LINE  1  IDDC KDINLUPF WS-KVART WS-KVRADER WS-KVKOLLI         +                 
         SUBEL-PROC KVRADER-PROC                                                
                                                                                
BEFORE-LINE. PROC                                                               
  IF IDDC NE WS-PREV-IDDC                                                       
   DISPLAY '¤DAPW61156-002'                                                     
   DISPLAY '¤DAP' IDDC                                                          
   WS-PREV-IDDC = IDDC                                                          
  END-IF                                                                        
END-PROC                                                                        
