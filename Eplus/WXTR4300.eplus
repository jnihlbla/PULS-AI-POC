*                                                                      *        
*  FUNKTION   :  PROGRAMMET INGÅR I VCAS UPPFÖLJNINGSMILJÖ.            *        
*                PROGRAMMET SKAPAR EN FIL MED FAKTURERAT,              *        
*                INKOMMET OCH PACKAT, FIP - VECKOFIL.                  *        
*                                                                      *        
*                (EG KOPIA AV WXTR1300)                                *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     970322      STEFANO GIOBBI           50654                       *        
*                 ÄNDRINGAR FÖR NDC                                    *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE WXTR43D1                                                                   
*      VECKANS FAKTURERAT                                                       
   IN-FAKT-IDDC            1    2  A                                            
   IN-FAKT-IDPRC           *    4  A                                            
   IN-FAKT-KDORDKL         *    1  P 0                                          
   IN-FAKT-IDDISTR         *    3  P 0                                          
   IN-FAKT-LINES           *   10  P 0                                          
   IN-FAKT-VALUE-STD       *   10  P 2                                          
   IN-FAKT-VALUE-NET       *   10  P 2                                          
   IN-FAKT-VKARTNTO        *   10  P 3                                          
   IN-FAKT-VLARTNTO        *   10  P 1                                          
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE WXTR43D2                                                                   
*     INKOMMET UNDER VECKAN                                                     
   IN-INK-IDDC             *    2  A                                            
   IN-INK-IDPRC            *    4  A                                            
   IN-INK-KDORDKL          *    1  P                                            
   IN-INK-IDDISTR          *    3  P 0                                          
   IN-INK-STD              *   10  P 2                                          
   IN-INK-LINES            *   10  P 2                                          
   IN-INK-VKARTNTO         *   10  P 2                                          
   IN-INK-VLARTNTO         *   10  P 2                                          
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE WXTR43D3                                                                   
*    VECKANS PACKFIL                                                            
   IN-PACK-IDDC            1    2  A                                            
   IN-PACK-IDPRC           *    4  A                                            
   IN-PACK-KDORDKL         *    1  P 0                                          
   IN-PACK-IDDISTR         *    3  P 0                                          
   IN-PACK-STD             *    6  P 2                                          
   IN-PACK-LINES           *    3  P 0                                          
   IN-PACK-VKARTNTO        *    4  P 3                                          
   IN-PACK-VLARTNTO        *    5  P 1                                          
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE WXTR43D4   FB (134 0)                                                      
*     FIP FIL                                                                   
   UT-TIAAVV               1    4  A                                            
   UT-IDDC                 *    2  A                                            
   UT-IDPRC                *    4  A                                            
   UT-KDORDKL              *    1  P                                            
   UT-IDDISTR              *    3  P 0                                          
   UT-FAKT-STD             *   10  P 2                                          
   UT-FAKT-LINES           *   10  P 2                                          
   UT-FAKT-VKARTNTO        *   10  P 3                                          
   UT-FAKT-VLARTNTO        *   10  P 1                                          
   UT-INK-STD              *   10  P 2                                          
   UT-INK-LINES            *   10  P 2                                          
   UT-INK-VKARTNTO         *   10  P 3                                          
   UT-INK-VLARTNTO         *   10  P 1                                          
   UT-PACK-STD             *   10  P 2                                          
   UT-PACK-LINES           *   10  P 2                                          
   UT-PACK-VKARTNTO        *   10  P 3                                          
   UT-PACK-VLARTNTO        *   10  P 1                                          
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
  JA                        W   1  A   VALUE 'J'                                
  NEJ                       W   1  A   VALUE 'N'                                
  FEL                       W   1  A   VALUE 'F'                                
  RKOD-16                   W   4  N   VALUE 16                                 
*                                                                               
%WDATAREA                                                                       
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
                                                                                
  JOB INPUT (WXTR43D1 KEY (IN-FAKT-IDDC                          +              
                           IN-FAKT-IDDISTR)                      +              
             WXTR43D2 KEY ( IN-INK-IDDC                          +              
                            IN-INK-IDDISTR)                      +              
             WXTR43D3 KEY (IN-PACK-IDDC                          +              
                           IN-PACK-IDDISTR))                     +              
                          START A-INIT                                          
                                                                                
    IF MATCHED                                                                  
      PERFORM A-FAKT-INK-PACK                                                   
    ELSE-IF WXTR43D1 AND WXTR43D2                                               
      PERFORM B-FAKT-INK                                                        
    ELSE-IF WXTR43D1 AND WXTR43D3                                               
      PERFORM C-FAKT-PACK                                                       
    ELSE-IF WXTR43D2 AND WXTR43D3                                               
      PERFORM D-INK-PACK                                                        
    ELSE-IF WXTR43D1                                                            
      PERFORM E-ENBART-FAKT                                                     
    ELSE-IF WXTR43D2                                                            
      PERFORM F-ENBART-INK                                                      
    ELSE-IF WXTR43D3                                                            
      PERFORM G-ENBART-PACK                                                     
    END-IF                                                                      
                                                                                
    UT-TIAAVV = DAT-TIAAVV-GRP                                                  
    PUT WXTR43D4                                                                
                                                                                
NEWPAGE                                                                         
                                                                                
  A-INIT.  PROC                                                                 
                                                                                
      DAT-KDDATFORM = 'IDAG  '                                                  
                                                                                
      CALL WDATKONV USING (DAT-KDDATFORM                         +              
                           DAT-I-TIDATUM                         +              
                           DAT-O-TIDATUM                         +              
                           DAT-KDSVAR    )                                      
                                                                                
      IF DAT-KDSVAR = FEL                                                       
         RETURN-CODE = RKOD-16                                                  
         STOP EXECUTE                                                           
      END-IF                                                                    
                                                                                
    END-PROC                                                                    
                                                                                
  A-FAKT-INK-PACK.  PROC                                                        
                                                                                
    UT-IDDC             = IN-FAKT-IDDC                                          
    UT-IDPRC            = IN-FAKT-IDPRC                                         
    UT-KDORDKL          = IN-FAKT-KDORDKL                                       
    UT-IDDISTR          = IN-FAKT-IDDISTR                                       
    UT-FAKT-STD         = IN-FAKT-VALUE-STD                                     
    UT-FAKT-LINES       = IN-FAKT-LINES                                         
    UT-FAKT-VKARTNTO    = IN-FAKT-VKARTNTO                                      
    UT-FAKT-VLARTNTO    = IN-FAKT-VLARTNTO                                      
    UT-INK-STD          = IN-INK-STD                                            
    UT-INK-LINES        = IN-INK-LINES                                          
    UT-INK-VKARTNTO     = IN-INK-VKARTNTO                                       
    UT-INK-VLARTNTO     = IN-INK-VLARTNTO                                       
    UT-PACK-STD         = IN-PACK-STD                                           
    UT-PACK-LINES       = IN-PACK-LINES                                         
    UT-PACK-VKARTNTO    = IN-PACK-VKARTNTO                                      
    UT-PACK-VLARTNTO    = IN-PACK-VLARTNTO                                      
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  B-FAKT-INK.  PROC                                                             
                                                                                
    UT-IDDC             = IN-FAKT-IDDC                                          
    UT-IDPRC            = IN-FAKT-IDPRC                                         
    UT-KDORDKL          = IN-FAKT-KDORDKL                                       
    UT-IDDISTR          = IN-FAKT-IDDISTR                                       
    UT-FAKT-STD         = IN-FAKT-VALUE-STD                                     
    UT-FAKT-LINES       = IN-FAKT-LINES                                         
    UT-FAKT-VKARTNTO    = IN-FAKT-VKARTNTO                                      
    UT-FAKT-VLARTNTO    = IN-FAKT-VLARTNTO                                      
    UT-INK-STD          = IN-INK-STD                                            
    UT-INK-LINES        = IN-INK-LINES                                          
    UT-INK-VKARTNTO     = IN-INK-VKARTNTO                                       
    UT-INK-VLARTNTO     = IN-INK-VLARTNTO                                       
    UT-PACK-STD         = 0                                                     
    UT-PACK-LINES       = 0                                                     
    UT-PACK-VKARTNTO    = 0                                                     
    UT-PACK-VLARTNTO    = 0                                                     
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  C-FAKT-PACK.  PROC                                                            
                                                                                
    UT-IDDC             = IN-FAKT-IDDC                                          
    UT-IDPRC            = IN-FAKT-IDPRC                                         
    UT-KDORDKL          = IN-FAKT-KDORDKL                                       
    UT-IDDISTR          = IN-FAKT-IDDISTR                                       
    UT-FAKT-STD         = IN-FAKT-VALUE-STD                                     
    UT-FAKT-LINES       = IN-FAKT-LINES                                         
    UT-FAKT-VKARTNTO    = IN-FAKT-VKARTNTO                                      
    UT-FAKT-VLARTNTO    = IN-FAKT-VLARTNTO                                      
    UT-INK-STD          = 0                                                     
    UT-INK-LINES        = 0                                                     
    UT-INK-VKARTNTO     = 0                                                     
    UT-INK-VLARTNTO     = 0                                                     
    UT-PACK-STD         = IN-PACK-STD                                           
    UT-PACK-LINES       = IN-PACK-LINES                                         
    UT-PACK-VKARTNTO    = IN-PACK-VKARTNTO                                      
    UT-PACK-VLARTNTO    = IN-PACK-VLARTNTO                                      
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  D-INK-PACK.  PROC                                                             
                                                                                
    UT-IDDC             = IN-INK-IDDC                                           
    UT-IDPRC            = IN-INK-IDPRC                                          
    UT-KDORDKL          = IN-INK-KDORDKL                                        
    UT-IDDISTR          = IN-INK-IDDISTR                                        
    UT-FAKT-STD         = 0                                                     
    UT-FAKT-LINES       = 0                                                     
    UT-FAKT-VKARTNTO    = 0                                                     
    UT-FAKT-VLARTNTO    = 0                                                     
    UT-INK-STD          = IN-INK-STD                                            
    UT-INK-LINES        = IN-INK-LINES                                          
    UT-INK-VKARTNTO     = IN-INK-VKARTNTO                                       
    UT-INK-VLARTNTO     = IN-INK-VLARTNTO                                       
    UT-PACK-STD         = IN-PACK-STD                                           
    UT-PACK-LINES       = IN-PACK-LINES                                         
    UT-PACK-VKARTNTO    = IN-PACK-VKARTNTO                                      
    UT-PACK-VLARTNTO    = IN-PACK-VLARTNTO                                      
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  E-ENBART-FAKT.  PROC                                                          
                                                                                
    UT-IDDC             = IN-FAKT-IDDC                                          
    UT-IDPRC            = IN-FAKT-IDPRC                                         
    UT-KDORDKL          = IN-FAKT-KDORDKL                                       
    UT-IDDISTR          = IN-FAKT-IDDISTR                                       
    UT-FAKT-STD         = IN-FAKT-VALUE-STD                                     
    UT-FAKT-LINES       = IN-FAKT-LINES                                         
    UT-FAKT-VKARTNTO    = IN-FAKT-VKARTNTO                                      
    UT-FAKT-VLARTNTO    = IN-FAKT-VLARTNTO                                      
    UT-INK-STD          = 0                                                     
    UT-INK-LINES        = 0                                                     
    UT-INK-VKARTNTO     = 0                                                     
    UT-INK-VLARTNTO     = 0                                                     
    UT-PACK-STD         = 0                                                     
    UT-PACK-LINES       = 0                                                     
    UT-PACK-VKARTNTO    = 0                                                     
    UT-PACK-VLARTNTO    = 0                                                     
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  F-ENBART-INK.  PROC                                                           
                                                                                
    UT-IDDC             = IN-INK-IDDC                                           
    UT-IDPRC            = IN-INK-IDPRC                                          
    UT-KDORDKL          = IN-INK-KDORDKL                                        
    UT-IDDISTR          = IN-INK-IDDISTR                                        
    UT-FAKT-STD         = 0                                                     
    UT-FAKT-LINES       = 0                                                     
    UT-FAKT-VKARTNTO    = 0                                                     
    UT-FAKT-VLARTNTO    = 0                                                     
    UT-INK-STD          = IN-INK-STD                                            
    UT-INK-LINES        = IN-INK-LINES                                          
    UT-INK-VKARTNTO     = IN-INK-VKARTNTO                                       
    UT-INK-VLARTNTO     = IN-INK-VLARTNTO                                       
    UT-PACK-STD         = 0                                                     
    UT-PACK-STD         = 0                                                     
    UT-PACK-LINES       = 0                                                     
    UT-PACK-VKARTNTO    = 0                                                     
    UT-PACK-VLARTNTO    = 0                                                     
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  G-ENBART-PACK.  PROC                                                          
                                                                                
    UT-IDDC             = IN-PACK-IDDC                                          
    UT-IDPRC            = IN-PACK-IDPRC                                         
    UT-KDORDKL          = IN-PACK-KDORDKL                                       
    UT-IDDISTR          = IN-PACK-IDDISTR                                       
    UT-FAKT-STD         = 0                                                     
    UT-FAKT-LINES       = 0                                                     
    UT-FAKT-VKARTNTO    = 0                                                     
    UT-FAKT-VLARTNTO    = 0                                                     
    UT-INK-STD          = 0                                                     
    UT-INK-LINES        = 0                                                     
    UT-INK-VKARTNTO     = 0                                                     
    UT-INK-VLARTNTO     = 0                                                     
    UT-PACK-STD         = IN-PACK-STD                                           
    UT-PACK-LINES       = IN-PACK-LINES                                         
    UT-PACK-VKARTNTO    = IN-PACK-VKARTNTO                                      
    UT-PACK-VLARTNTO    = IN-PACK-VLARTNTO                                      
                                                                                
  END-PROC                                                                      
                                                                                
  NEWPAGE                                                                       
                                                                                
