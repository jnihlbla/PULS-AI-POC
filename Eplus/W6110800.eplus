*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6110800                                              *        
*                                                                      *        
*  FUNKTION   :  SELECT RECORDS FROM THE NETWEIGHT FILE FROM KDP,      *        
*                WHICH ARE OK TO UPDATE IN PULS (WDK611 AND WDK212).   *        
*                ALSO CREATE AN ALARM FILE WHEN NETWEIGHT IS GREATER   *        
*                THAN GROSSWEIGHT.                                     *        
*                                                                      *        
*  FÖRFATTARE :  HÅKAN BOHLIN                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W61108D1                                                                   
*                                                                               
%W61106  'IN1-'                                                                 
                                                                                
FILE W61108D2                                                                   
*                                                                               
%W01160  'IN2-'                                                                 
                                                                                
FILE W61108D3 FB(80 0)                                                          
*                                                                               
%W61106    'OUT1-'                                                              
                                                                                
FILE W61108D4 FB(17 0)                                                          
*                                                                               
%W61108    'OUT2-'                                                              
                                                                                
FILE W61108D5 VB(51 0)                                                          
OUT3-AREA          1  47 A                                                      
OUT3-IDARTNR       1   8 N                                                      
OUT3-FILLER1       9   1 A                                                      
OUT3-VKART        10   7 N                                                      
OUT3-FILLER2      17   1 A                                                      
OUT3-VKART-NTO    18   8 N                                                      
OUT3-FILLER3      26   1 A                                                      
OUT3-KDERS        27   2 N                                                      
                                                                                
W-RUBRIK       W  47  A                                                         
W-RUB1         W-RUBRIK       7  A   VALUE 'PART NO'                            
W-FILLER1      W-RUBRIK +7    1  A   VALUE ';'                                  
W-RUB2         W-RUBRIK +8   11  A   VALUE 'GROSSWEIGHT'                        
W-FILLER2      W-RUBRIK +19   1  A   VALUE ';'                                  
W-RUB3         W-RUBRIK +20   9  A   VALUE 'NETWEIGHT'                          
W-FILLER3      W-RUBRIK +29   1  A   VALUE ';'                                  
W-RUB4         W-RUBRIK +30  17  A   VALUE 'SUPERSESSION CODE'                  
                                                                                
W-FORSTA-SW   W  1 A   VALUE 'J'                                                
NEWPAGE                                                                         
*                                                                               
                                                                                
JOB INPUT (W61108D1 KEY IN1-IDARTNR W61108D2 KEY IN2-CLAG-IDARTNR)              
IF MATCHED                                                                      
  IF IN2-CLAG-KDERS-UTG = 0                                                     
    IF IN1-VKART-NTO > 0                                                        
      OUT1-W61106 = IN1-W61106                                                  
      PUT W61108D3                                                              
      IF IN1-KVANTAL = 0                                                        
         OUT2-VKART-NTO ROUNDED = IN1-VKART-NTO / 1                             
      ELSE                                                                      
         OUT2-VKART-NTO ROUNDED = IN1-VKART-NTO / IN1-KVANTAL                   
         IF OUT2-VKART-NTO = 0                                                  
            OUT2-VKART-NTO = 1                                                  
         END-IF                                                                 
      END-IF                                                                    
      IF (IN2-CLAG-VKART < OUT2-VKART-NTO AND  +                                
          IN2-CLAG-VKART > 0)                                                   
         IF (IN2-CLAG-KDERS GE 0 AND IN2-CLAG-KDERS LE 19) OR +                 
            (IN2-CLAG-KDERS = 27 28)                                            
           IF W-FORSTA-SW = 'J'                                                 
              W-FORSTA-SW = 'N'                                                 
              OUT3-AREA = W-RUBRIK                                              
              RECORD-LENGTH(W61108D5) = 47                                      
              PUT W61108D5                                                      
           END-IF                                                               
           OUT3-FILLER1   = ';'                                                 
           OUT3-FILLER2   = ';'                                                 
           OUT3-FILLER3   = ';'                                                 
           OUT3-IDARTNR   = IN1-IDARTNR                                         
           OUT3-VKART     = IN2-CLAG-VKART                                      
           OUT3-VKART-NTO = OUT2-VKART-NTO                                      
           OUT3-KDERS     = IN2-CLAG-KDERS                                      
           RECORD-LENGTH(W61108D5) = 28                                         
           PUT W61108D5                                                         
         END-IF                                                                 
      ELSE                                                                      
         OUT2-IDARTNR   = IN1-IDARTNR                                           
         OUT2-KDUVKNTO  = IN2-CLAG-KDUVKNTO                                     
         PUT W61108D4                                                           
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
