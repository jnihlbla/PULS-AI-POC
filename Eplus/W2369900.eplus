                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2369900                                              *        
*                                                                      *        
*  FUNKTION   :  KONTROLL SPUF                                         *        
*                                                                      *        
*  FÖRFATTARE :  BODIL LINDAHL                                         *        
*                26 MARS 2004                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W23699D1                                                                   
%W23684   'FIL-'                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W23699D2                                                                   
%W23684   'REG-'                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W23699D3      VB(77 0)                                                     
%W23688   'FILUT-'                                                              
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W23699D4      FB(79 27966)                                                 
%W23684   'REGUT-'                                                              
*                                                                               
NEWPAGE                                                                         
*                                                                               
%WORKAREA                                                                       
%WDATKORT  'DATKORT-'                                                           
NEWPAGE                                                                         
*                                                                               
%WDATAREA                                                                       
NEWPAGE                                                                         
*                                                                               
JA         W  1  A  VALUE 'J'                                                   
NEJ        W  1  A  VALUE 'N'                                                   
WS-STAT    W  2  A                                                              
SW-SKRIV   W  1  A                                                              
SW-TRAFF   W  1  A                                                              
SW-A-FINNS W  1  A                                                              
PGM-NAMN   W  6  A  VALUE 'W23699'                                              
DATKORT-ID W  6  A  VALUE 'WDATUM'                                              
WORKDAY                 W  8 A VALUE 'WORKDAY '                                 
WDATKONV                W  8 A VALUE 'WDATKONV'                                 
*                                                                               
DAGENS-DATUM-125    W                     6   N                                 
*                                                                               
DAGENS-DATUM        W                     6   N                                 
DAGENS-DATUM-AA     DAGENS-DATUM          2   N                                 
DAGENS-DATUM-MM     DAGENS-DATUM       +2 2   N                                 
DAGENS-DATUM-DD     DAGENS-DATUM       +4 2   N                                 
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT                                                 +                     
 (W23699D1 KEY (FIL-PART-ID FIL-IDLEVNR FIL-DATUM-YYMMDD) +                     
  W23699D2 KEY (REG-PART-ID REG-IDLEVNR REG-DATUM-YYMMDD))+                     
  START A-INIT                                                                  
                                                                                
                                                                                
     IF MATCHED                                                                 
                                                                                
       IF DUPLICATE W23699D2                                                    
          WS-STAT = REG-STAT                                                    
          IF REG-DATUM-YYMMDD GT DAGENS-DATUM-125                               
             PERFORM S02-SKRIV-REGISTER                                         
          END-IF                                                                
          IF FIL-STAT = 'A' 'U'                                                 
             IF (REG-DELIVERED = FIL-DELIVERED     +                            
             AND REG-ORDERED = FIL-ORDERED)        +                            
             OR (REG-ORDERED = REG-DELIVERED)                                   
               IF REG-STAT = 'A' 'U'                                            
                  SW-TRAFF = JA                                                 
               END-IF                                                           
             END-IF                                                             
             IF LAST-DUP W23699D2                                               
                WS-STAT = FIL-STAT                                              
                IF SW-TRAFF = NEJ                                               
                   WS-STAT = FIL-STAT                                           
                   PERFORM S03-SKRIV-UTFIL                                      
                   IF FIL-DATUM-YYMMDD GT DAGENS-DATUM-125                      
                      PERFORM S04-SKRIV-REGISTER                                
                   END-IF                                                       
                   SW-TRAFF = NEJ                                               
                END-IF                                                          
             END-IF                                                             
          END-IF                                                                
          IF LAST-DUP W23699D2                                                  
             IF FIL-STAT = 'D'                                                  
                WS-STAT = 'D'                                                   
                PERFORM S03-SKRIV-UTFIL                                         
                IF FIL-DATUM-YYMMDD GT DAGENS-DATUM-125                         
                   PERFORM S04-SKRIV-REGISTER                                   
                END-IF                                                          
             END-IF                                                             
          END-IF                                                                
       ELSE                                                                     
          IF FIL-STAT = 'A' 'U'                                                 
             IF (REG-DELIVERED = FIL-DELIVERED     +                            
             AND REG-ORDERED = FIL-ORDERED)        +                            
             OR (REG-ORDERED = REG-DELIVERED)                                   
                IF REG-STAT = 'A' 'U'                                           
                   WS-STAT = REG-STAT                                           
                   IF FIL-DATUM-YYMMDD GT DAGENS-DATUM-125                      
                      PERFORM S02-SKRIV-REGISTER                                
                   END-IF                                                       
                ELSE                                                            
                   IF REG-STAT = 'D'                                            
                      WS-STAT = REG-STAT                                        
                      IF REG-DATUM-YYMMDD GT DAGENS-DATUM-125                   
                         PERFORM S02-SKRIV-REGISTER                             
                      END-IF                                                    
                      WS-STAT = FIL-STAT                                        
                      PERFORM S03-SKRIV-UTFIL                                   
                      IF FIL-DATUM-YYMMDD GT DAGENS-DATUM-125                   
                         PERFORM S04-SKRIV-REGISTER                             
                      END-IF                                                    
                   END-IF                                                       
                END-IF                                                          
             ELSE                                                               
                WS-STAT = REG-STAT                                              
                IF REG-DATUM-YYMMDD GT DAGENS-DATUM-125                         
                   PERFORM S02-SKRIV-REGISTER                                   
                END-IF                                                          
                WS-STAT = FIL-STAT                                              
                PERFORM S03-SKRIV-UTFIL                                         
                IF FIL-DATUM-YYMMDD GT DAGENS-DATUM-125                         
                   PERFORM S04-SKRIV-REGISTER                                   
                END-IF                                                          
             END-IF                                                             
          ELSE                                                                  
             IF FIL-STAT = 'D'                                                  
                WS-STAT = REG-STAT                                              
                IF REG-DATUM-YYMMDD GT DAGENS-DATUM-125                         
                   PERFORM S02-SKRIV-REGISTER                                   
                END-IF                                                          
                WS-STAT = FIL-STAT                                              
                PERFORM S03-SKRIV-UTFIL                                         
                IF FIL-DATUM-YYMMDD GT DAGENS-DATUM-125                         
                   PERFORM S04-SKRIV-REGISTER                                   
                END-IF                                                          
             END-IF                                                             
          END-IF                                                                
        END-IF                                                                  
     ELSE                                                                       
        IF W23699D1                                                             
*********  FINNS INTE PÅ REG                                                    
***        IF FIL-STAT = 'D'                                                    
***           CONTINUE                                                          
***        ELSE                                                                 
              WS-STAT = FIL-STAT                                                
              PERFORM S03-SKRIV-UTFIL                                           
              IF FIL-DATUM-YYMMDD GT DAGENS-DATUM-125                           
                PERFORM S04-SKRIV-REGISTER                                      
              END-IF                                                            
***        END-IF                                                               
        ELSE                                                                    
           IF W23699D2                                                          
*********  FINNS INTE PÅ FIL                                                    
              WS-STAT = REG-STAT                                                
              IF REG-DATUM-YYMMDD GT DAGENS-DATUM-125                           
                PERFORM S02-SKRIV-REGISTER                                      
              END-IF                                                            
           END-IF                                                               
        END-IF                                                                  
     END-IF                                                                     
*                                                                               
NEWPAGE                                                                         
*                                                                               
  A-INIT. PROC                                                                  
     CALL DATKORT USING (PGM-NAMN DATKORT-ID DATKORT-DATUMKORT)                 
                                                                                
                                                                                
     DAGENS-DATUM-AA = DATKORT-D-AAR                                            
     DAGENS-DATUM-MM = DATKORT-D-MAANAD                                         
     DAGENS-DATUM-DD = DATKORT-D-DAG                                            
                                                                                
     WORK-KDCALL = 003                                                          
     WORK-IDDC = '11'                                                           
     WORK-TIAAMMDD-TOM = DAGENS-DATUM                                           
     WORK-KVWORKD = 125                                                         
     CALL WORKDAY USING (WORK-KDCALL     +                                      
                         WORK-DATE-AREA  +                                      
                         WORK-KDSVAR)                                           
     IF WORK-KDSVAR = ' '                                                       
       DAGENS-DATUM-125 = WORK-TIAAMMDD-FOM                                     
     ELSE                                                                       
       DISPLAY 'FEL FRÅN WORKDAY '                                              
     END-IF                                                                     
     SW-TRAFF = NEJ                                                             
                                                                                
     END-PROC                                                                   
*                                                                               
NEWPAGE                                                                         
*                                                                               
  S02-SKRIV-REGISTER. PROC                                                      
                                                                                
     REGUT-FILE-TYPE     = REG-FILE-TYPE                                        
     REGUT-PLANT         = REG-PLANT                                            
     REGUT-IDLEVNR       = REG-IDLEVNR                                          
     REGUT-SUP-UNIT      = REG-SUP-UNIT                                         
     REGUT-PART-ID       = REG-PART-ID                                          
     REGUT-ORD-DATE      = REG-ORD-DATE                                         
     REGUT-ORDERED       = REG-ORDERED                                          
     REGUT-DELIVERED     = REG-DELIVERED                                        
     REGUT-STAT          = WS-STAT                                              
     REGUT-STAT-DATE     = REG-STAT-DATE                                        
     REGUT-STAT-TIME     = REG-STAT-TIME                                        
     REGUT-DATUM-YYMMDD  = REG-DATUM-YYMMDD                                     
     PUT W23699D4                                                               
*                                                                               
  END-PROC                                                                      
*                                                                               
NEWPAGE                                                                         
                                                                                
  S03-SKRIV-UTFIL. PROC                                                         
                                                                                
     FILUT-FILE-TYPE     = FIL-FILE-TYPE                                        
     FILUT-PLANT         = FIL-PLANT                                            
     FILUT-IDLEVNR       = FIL-IDLEVNR                                          
     FILUT-SUP-UNIT      = FIL-SUP-UNIT                                         
     FILUT-PART-ID       = FIL-PART-ID                                          
     FILUT-ORD-DATE      = FIL-ORD-DATE                                         
     FILUT-ORDERED       = FIL-ORDERED                                          
     FILUT-DELIVERED     = FIL-DELIVERED                                        
     FILUT-STAT          = WS-STAT                                              
     FILUT-STAT-DATE     = FIL-STAT-DATE                                        
     FILUT-STAT-TIME     = FIL-STAT-TIME                                        
     PUT W23699D3                                                               
  END-PROC                                                                      
*                                                                               
NEWPAGE                                                                         
*                                                                               
  S04-SKRIV-REGISTER. PROC                                                      
                                                                                
     REGUT-FILE-TYPE     = FIL-FILE-TYPE                                        
     REGUT-PLANT         = FIL-PLANT                                            
     REGUT-IDLEVNR       = FIL-IDLEVNR                                          
     REGUT-SUP-UNIT      = FIL-SUP-UNIT                                         
     REGUT-PART-ID       = FIL-PART-ID                                          
     REGUT-ORD-DATE      = FIL-ORD-DATE                                         
     REGUT-ORDERED       = FIL-ORDERED                                          
     REGUT-DELIVERED     = FIL-DELIVERED                                        
     REGUT-STAT          = WS-STAT                                              
     REGUT-STAT-DATE     = FIL-STAT-DATE                                        
     REGUT-STAT-TIME     = FIL-STAT-TIME                                        
     REGUT-DATUM-YYMMDD  = FIL-DATUM-YYMMDD                                     
     PUT W23699D4                                                               
*                                                                               
  END-PROC                                                                      
*                                                                               
NEWPAGE                                                                         
