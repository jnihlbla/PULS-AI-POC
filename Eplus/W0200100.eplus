FILE W02001D1                                                                   
*                                                                               
%W225P232 'IN-'                                                                 
*                                                                               
FILE W02001D2                                                                   
*                                                                               
%WCDCPART 'VLB-'                                                                
*                                                                               
FILE W02001D3 FB(20 23460)                                                      
*                                                                               
%W225P232 'SORT-'                                                               
*                                                                               
FILE W02001D4 FB (27 6210)                                                      
*                                                                               
%W020010E 'UT1-'                                                                
*                                                                               
* W-AREOR                                                                       
W-HITS    W   7   N 0                                                           
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
SORT W02001D1 TO W02001D3 USING IN-IDARTNR                                      
*                                                                               
JOB INPUT (W02001D2 KEY(VLB-IDARTNR) W02001D3 KEY(SORT-IDARTNR)) +              
          FINISH VISA-ACC                                                       
*                                                                               
 IF MATCHED AND VLB-KDPRODSL > 0                                                
   PERFORM TRÄFF                                                                
   GOTO JOB                                                                     
 END-IF                                                                         
*                                                                               
TRÄFF.  PROC                                                                    
  W-HITS        =  W-HITS + 1                                                   
  UT1-IDARTNR   =  SORT-IDARTNR                                                 
  UT1-KDCLAGER  =  SORT-KDCLAGER                                                
  UT1-IDDISTR   =  SORT-IDDISTR                                                 
  UT1-KDORDKL   =  SORT-KDORDKL                                                 
  UT1-KDPRODSL  =  VLB-KDPRODSL                                                 
  UT1-KDVVKL    =  VLB-KDVVKL                                                   
  UT1-IDANSK    =  VLB-IDANSK                                                   
  UT1-IDLEVNR   =  VLB-IDLEVNR                                                  
  UT1-REINKORD  =  SORT-REINKORD                                                
  UT1-RERORAD   =  SORT-RERORAD                                                 
  UT1-REFYSAVV  =  SORT-REFYSAVV                                                
  UT1-REAVBRAD  =  SORT-REAVBRAD                                                
  PUT W02001D4                                                                  
END-PROC                                                                        
*                                                                               
VISA-ACC.  PROC                                                                 
  DISPLAY NEWPAGE '************ ANTAL TRÄFFAR: ' W-HITS                         
END-PROC                                                                        
