                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4405700                                              *        
*                                                                      *        
*  FUNKTION   :  SALDOAVSTÄMNING NDC/SDC-LAGER.                        *        
*                JÄMFÖR OKS SOM LIGGER PÅ WDK7 MED BEART-Q             *        
*                PÅ WDQ4.                                              *        
*                VID MISSTÄMNING AV SALDON SKRIVS DIFFLISTA            *        
*                SAMT FIL W44057 MED RIKTIGT SALDO FÖR                 *        
*                UPPDATERING VIA W499B1.                               *        
*                                                                      *        
*             :  ÄNDRINGAR GJORDA PGA IMPLEMENTERING NDC-LAGER         *        
*                JAN  1997 BOO HAMMARIN (GDC-G)                        *        
*                                                                      *        
*  FÖRFATTARE :  STEFANO GIOBBI                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
*                            FILE SECTION                              *        
*----------------------------------------------------------------------*        
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W44057D1                                                                   
%W440055 'WDK7-'                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W44057D2                                                                   
%W440063 'WDQ4-'                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W44057D3  PRINTER FB (121 0)                                               
*       LISTA OKS-DIFFAR                                                        
*                                                                               
FILE W44057D4          FB (42 0)                                                
%W440056 'UT-'                                                                  
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------------*        
*                            WORKING STORAGE                           *        
*----------------------------------------------------------------------*        
*                                                                               
*                                                                               
  JA                        W    1     A     VALUE 'J'                          
  NEJ                       W    1     A     VALUE 'N'                          
*                                                                               
  SW-SALDO-DIFF-OKS-DAG     W    1     A     VALUE 'N'                          
  SW-SALDO-DIFF-OKS-BULK    W    1     A     VALUE 'N'                          
*                                                                               
  ACK-OKS-K7-DAG            W    5     P 0   VALUE 0                            
  ACK-OKS-Q4-DAG            W    5     P 0   VALUE 0                            
  ACK-OKS-K7-BULK           W    5     P 0   VALUE 0                            
  ACK-OKS-Q4-BULK           W    5     P 0   VALUE 0                            
*                                                                               
  SUM-OKS-DAG               W    3     P 0   VALUE 0                            
  SUM-OKS-BULK              W    3     P 0   VALUE 0                            
*                                                                               
  PRINT-IDARTNR             W    5     P     VALUE 0                            
  PRINT-IDDC                W    2     A     VALUE ' '                          
*                                                                               
  PRINT-OKS-K7-DAG          W    3     P 0   VALUE 0  MASK '----9'              
  PRINT-OKS-Q4-DAG          W    3     P 0   VALUE 0  MASK '----9'              
  PRINT-SUM-OKS-DAG         W    3     P 0   VALUE 0  MASK '----9'              
  PRINT-OKS-K7-BULK         W    3     P 0   VALUE 0  MASK '----9'              
  PRINT-OKS-Q4-BULK         W    3     P 0   VALUE 0  MASK '----9'              
  PRINT-SUM-OKS-BULK        W    3     P 0   VALUE 0  MASK '----9'              
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    -- CHECKED BY WY2000                                                       
*                                                                               
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------------*        
*                            PROCEDURE DIVISION                        *        
*----------------------------------------------------------------------*        
*                                                                               
JOB INPUT NULL                                                   +              
                                              NAME   STEG01                     
                                                                                
  GET W44057D1                                                                  
  GET W44057D2                                                                  
  DO WHILE NOT EOF W44057D2     AND +                                           
           WDQ4-IDDC = CDC-SE                                                   
    GET W44057D2                                                                
  END-DO                                                                        
                                                                                
  DO WHILE NOT EOF W44057D1                                                     
                                                                                
    PERFORM SUMMERA-WDK7-SALDO                                                  
                                                                                
    DO WHILE NOT EOF W44057D2      AND                           +              
     (WDQ4-IDDC    LT WDK7-IDDC    OR                            +              
      WDQ4-IDDC     = WDK7-IDDC    AND                           +              
      WDQ4-IDARTNR LE WDK7-IDARTNR)                                             
                                                                                
      IF WDQ4-IDARTNR = WDK7-IDARTNR AND                         +              
         WDQ4-IDDC    = WDK7-IDDC                                               
        PERFORM SUMMERA-WDQ4-SALDO                                              
      END-IF                                                                    
      GET W44057D2                                                              
    END-DO                                                                      
                                                                                
    PERFORM BERAKNA-SALDO-DIFFAR                                                
    PERFORM KONTROLLERA-OM-SALDO-DIFFAR                                         
    PERFORM PRINTA-RAPPORTER-SKRIV-FIL                                          
    PERFORM NOLLSTALL-ACKAR                                                     
                                                                                
    GET W44057D1                                                                
                                                                                
  END-DO                                                                        
                                                                                
  STOP                                                                          
*                                                                               
NEWPAGE                                                                         
*                                                                               
SUMMERA-WDQ4-SALDO.  PROC                                                       
                                                                                
  IF WDQ4-KDORDKL    = 0 1                                                      
     ACK-OKS-Q4-DAG  = ACK-OKS-Q4-DAG + WDQ4-KVBEART                            
  END-IF                                                                        
  IF WDQ4-KDORDKL    = 2 3 4                                                    
     ACK-OKS-Q4-BULK = ACK-OKS-Q4-BULK + WDQ4-KVBEART                           
  END-IF                                                                        
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
SUMMERA-WDK7-SALDO.  PROC                                                       
                                                                                
  ACK-OKS-K7-DAG  = ACK-OKS-K7-DAG  + WDK7-KVOKS-DAG                            
  ACK-OKS-K7-BULK = ACK-OKS-K7-BULK + WDK7-KVOKS-BULK                           
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
BERAKNA-SALDO-DIFFAR.  PROC                                                     
                                                                                
  SUM-OKS-DAG  = ACK-OKS-Q4-DAG - ACK-OKS-K7-DAG                                
  SUM-OKS-BULK = ACK-OKS-Q4-BULK - ACK-OKS-K7-BULK                              
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
KONTROLLERA-OM-SALDO-DIFFAR.  PROC                                              
                                                                                
  IF SUM-OKS-DAG      NE 0                                                      
    SW-SALDO-DIFF-OKS-DAG  =  JA                                                
  END-IF                                                                        
  IF SUM-OKS-BULK     NE 0                                                      
    SW-SALDO-DIFF-OKS-BULK =  JA                                                
  END-IF                                                                        
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
PRINTA-RAPPORTER-SKRIV-FIL.  PROC                                               
                                                                                
  IF SW-SALDO-DIFF-OKS-DAG     = JA                                             
     PERFORM FYLL-DETALJRAD-MED-OKS-DIFFAR                                      
     PERFORM SKRIV-UTFIL-MED-OKS-DIFFAR                                         
     PRINT   RAPPORT01                                                          
     SW-SALDO-DIFF-OKS-DAG     = NEJ                                            
     SW-SALDO-DIFF-OKS-BULK    = NEJ                                            
  ELSE                                                                          
     IF SW-SALDO-DIFF-OKS-BULK = JA                                             
        PERFORM FYLL-DETALJRAD-MED-OKS-DIFFAR                                   
        PERFORM SKRIV-UTFIL-MED-OKS-DIFFAR                                      
        PRINT   RAPPORT01                                                       
        SW-SALDO-DIFF-OKS-DAG  = NEJ                                            
        SW-SALDO-DIFF-OKS-BULK = NEJ                                            
     END-IF                                                                     
  END-IF                                                                        
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
FYLL-DETALJRAD-MED-OKS-DIFFAR.  PROC                                            
                                                                                
  PRINT-IDARTNR      = WDK7-IDARTNR                                             
  PRINT-IDDC         = WDK7-IDDC                                                
  PRINT-OKS-K7-DAG   = ACK-OKS-K7-DAG                                           
  PRINT-OKS-Q4-DAG   = ACK-OKS-Q4-DAG                                           
  PRINT-SUM-OKS-DAG  = SUM-OKS-DAG                                              
  PRINT-OKS-K7-BULK  = ACK-OKS-K7-BULK                                          
  PRINT-OKS-Q4-BULK  = ACK-OKS-Q4-BULK                                          
  PRINT-SUM-OKS-BULK = SUM-OKS-BULK                                             
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
SKRIV-UTFIL-MED-OKS-DIFFAR.  PROC                                               
                                                                                
  UT-IDDB        = '711'                                                        
  UT-IDDC        = WDK7-IDDC                                                    
  UT-IDARTNR     = WDK7-IDARTNR                                                 
  IF SUM-OKS-DAG  NE 0                                                          
    UT-KVANTAL   = SUM-OKS-DAG                                                  
    IF SUM-OKS-DAG  LE 0                                                        
      UT-KDMETOD = 'SUB'                                                        
    ELSE                                                                        
      UT-KDMETOD = 'ADD'                                                        
    END-IF                                                                      
    UT-IDSALDO   = 'KVOKS-DAG    '                                              
    PUT W44057D4                                                                
  END-IF                                                                        
  IF SUM-OKS-BULK NE 0                                                          
    UT-KVANTAL   = SUM-OKS-BULK                                                 
    IF SUM-OKS-BULK LE 0                                                        
      UT-KDMETOD = 'SUB'                                                        
    ELSE                                                                        
      UT-KDMETOD = 'ADD'                                                        
    END-IF                                                                      
    UT-IDSALDO   = 'KVOKS-BULK   '                                              
    PUT W44057D4                                                                
  END-IF                                                                        
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
NOLLSTALL-ACKAR.  PROC                                                          
                                                                                
  ACK-OKS-Q4-DAG  = 0                                                           
  ACK-OKS-K7-DAG  = 0                                                           
  ACK-OKS-Q4-BULK = 0                                                           
  ACK-OKS-K7-BULK = 0                                                           
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*----------------------------------------------------------------*              
*                     REPORT SECTION                             *              
*----------------------------------------------------------------*              
*                                                                               
    REPORT RAPPORT01 PRINTER W44057D3                            +              
                     LINESIZE     120                            +              
                     PAGESIZE      41                            +              
                     NODATE                                      +              
                     NOADJUST                                    +              
                     NOSPREAD                                    +              
                     SPACE 1                                                    
*                                                                               
    CONTROL   FINAL                  NOPRINT                     +              
              PRINT-IDARTNR          NOPRINT                                    
*                                                                               
    TITLE 01                                                     +              
    COL   02 'VOLVO CAR PARTS       W44057-001'                  +              
    COL   93  SYSDATE                                                           
*                                                                               
    TITLE 02                                                     +              
    COL   30 'SALDOAVSTÄMNING, ORDERKÖ FÖR SDC/NDC '                            
*                                                                               
    HEADING   PRINT-IDARTNR             'ART'                                   
    HEADING   PRINT-IDDC                'DC'                                    
    HEADING   PRINT-OKS-K7-DAG          ' OKS-DAG  K7'                          
    HEADING   PRINT-OKS-Q4-DAG          ' OKS-DAG  Q4'                          
    HEADING   PRINT-SUM-OKS-DAG         ' DIFF-DAG   '                          
    HEADING   PRINT-OKS-K7-BULK         ' OKS-BULK K7'                          
    HEADING   PRINT-OKS-Q4-BULK         ' OKS-BULK Q4'                          
    HEADING   PRINT-SUM-OKS-BULK        ' DIFF-BULK  '                          
*                                                                               
    LINE 01                                                      +              
              PRINT-IDARTNR                                      +              
              PRINT-IDDC                                         +              
              PRINT-OKS-K7-DAG                                   +              
              PRINT-OKS-Q4-DAG                                   +              
              PRINT-SUM-OKS-DAG                                  +              
              PRINT-OKS-K7-BULK                                  +              
              PRINT-OKS-Q4-BULK                                  +              
              PRINT-SUM-OKS-BULK                                                
*                                                                               
NEWPAGE                                                                         
