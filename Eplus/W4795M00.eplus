NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT (W4795MD2 KEY (ODEL-IDDISTR                          +              
                           ODEL-IDKUNDNR                         +              
                           ODEL-IDKUNDRF-R                       +              
                           ODEL-IDDC                             +              
                           ODEL-IDPRODNR                         +              
                           ODEL-IDPLKLST  )                      +              
             W4795MD1 KEY (  5K-IDDISTR                          +              
                             5K-IDKUNDNR                         +              
                             5K-IDKUNDRF                         +              
                             5K-IDDC-LEV                         +              
                             5K-IDPRODNR                         +              
                             5K-IDPLKLST  ))                     +              
                                                 NAME   STEG01                  
    IF MATCHED                                                                  
      5M-DEL1   = 5K-DEL1                                                       
      5M-IDPRC  = ODEL-IDPRC                                                    
      5M-DEL2   = 5K-DEL2                                                       
      PUT W4795MD3                                                              
    ELSE                                                                        
      IF W4795MD1                                                               
        5M-DEL1   = 5K-DEL1                                                     
        5M-IDPRC  = ' '                                                         
        5M-DEL2   = 5K-DEL2                                                     
        PUT W4795MD3                                                            
      END-IF                                                                    
    END-IF                                                                      
                                                                                
