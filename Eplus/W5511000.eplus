FILE W55110D1                                                                   
%W55101   'IN-'                                                                 
W-IDARTNR   1 5 P                                                               
                                                                                
                                                                                
FILE W55110D2 PRINTER FB(121 121)                                               
                                                                                
                                                                                
W-DATUM                          W  8 A                                         
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
*  UTSKRIFT AV FELLISTA KALKYLPÅLÄGG                                            
*                                                                               
JOB INPUT W55110D1 START A-INIT NAME AKT001                                     
*                                                                               
    PRINT LISTA                                                                 
                                                                                
A-INIT.  PROC                                                                   
   MOVE SYSDATE TO W-DATUM                                                      
END-PROC                                                                        
                                                                                
REPORT LISTA PRINTER W55110D2  LINESIZE 120 NODATE NOADJUST +                   
                 SPACE 1                                                        
   SEQUENCE W-IDARTNR                                                           
   TITLE 01 'VOLVO CAR PARTS                  W55110-001      ' +               
            '                              DATUM ' W-DATUM                      
   TITLE 03 'KALKYLPÅLÄGG  FELLISTA'                                            
   HEADING  W-IDARTNR        ('ARTIKEL')                                        
   HEADING  IN-KDGK          ('GODSMOT' 'LAGER')                                
   HEADING  IN-TENOTE        ('ORSAK')                                          
   LINE W-IDARTNR IN-KDGK IN-TENOTE                                             
