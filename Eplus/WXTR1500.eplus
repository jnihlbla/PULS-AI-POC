                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  WXTR1500                                              *        
*                                                                      *        
*  FÖRFATTARE :  GERRY CARMICHAEL                                      *        
*                                                                      *        
*  DATUM      :  001127                                                *        
*                                                                      *        
*  FUNKTION   :  PROGRAMMET INGÅR I VCAS UPPFÖLJNINGSMILJÖ.            *        
*                LÄGGER TILL ANTAL ORDER PER DISTRIKT PÅ INFIL.        *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*                                                                      *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE WXTR15D1                                                                   
*                                                                               
  IN-IDDC              1 2 A                                                    
  IN-IDPRC             * 4 A                                                    
  IN-KDORDKL           * 1 P 0                                                  
  IN-IDDISTR           * 3 P 0                                                  
  IN-IDKUNDNR          * 4 P 0                                                  
  IN-IDKUNDRF          * 10 A                                                   
  IN-LINES             * 10 P 0                                                 
  IN-VALUE-STD         * 10 P 2                                                 
  IN-VALUE-AVG         * 10 P 2                                                 
  IN-VKARTNTO          * 10 P 3                                                 
  IN-VLARTNTO          * 10 P 1                                                 
*                                                                               
NEWPAGE                                                                         
*                                                                               
*                                                                               
FILE WXTR15D2 FB (70 0)                                                         
*                                                                               
  UT-INK-IDDC          1  2 A                                                   
  UT-INK-IDPRC         *  4 A                                                   
  UT-INK-KDORDKL       *  1 P 0                                                 
  UT-INK-IDDISTR       *  3 P 0                                                 
  UT-INK-LINES         * 10 P 0                                                 
  UT-INK-VALUE-STD     * 10 P 2                                                 
  UT-INK-VALUE-AVG     * 10 P 2                                                 
  UT-INK-VKARTNTO      * 10 P 3                                                 
  UT-INK-VLARTNTO      * 10 P 1                                                 
  UT-INK-ORDERS        * 10 P 0                                                 
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
  JA                        W   1  A   VALUE 'J'                                
  NEJ                       W   1  A   VALUE 'N'                                
*                                                                               
  W-NOF-ORDERS              W  10  P 0                                          
  W-LINES                   W  10  P 0                                          
  W-VALUE-STD               W  10  P 2                                          
  W-VALUE-AVG               W  10  P 2                                          
  W-VKARTNTO                W  10  P 3                                          
  W-VLARTNTO                W  10  P 1                                          
*                                                                               
  SPAR-IDDC                 W   2  A                                            
  SPAR-IDPRC                W   4  A                                            
  SPAR-IDDISTR              W   3  P 0                                          
  SPAR-KDORDKL              W   1  P 0                                          
  SPAR-IDKUNDNR             W   4  P 0                                          
  SPAR-IDKUNDRF             W  10  A                                            
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT  WXTR15D1                                            +              
                              START  A-INIT                      +              
                              FINISH Z-FINIT                     +              
                              NAME   STEG01                                     
     IF RECORD-COUNT   = 1                                                      
       SPAR-IDDC      = IN-IDDC                                                 
       SPAR-IDPRC     = IN-IDPRC                                                
       SPAR-KDORDKL   = IN-KDORDKL                                              
       SPAR-IDDISTR   = IN-IDDISTR                                              
       SPAR-IDKUNDNR  = IN-IDKUNDNR                                             
       SPAR-IDKUNDRF  = IN-IDKUNDRF                                             
     END-IF                                                                     
                                                                                
     IF SPAR-IDDC     = IN-IDDC      AND                         +              
        SPAR-IDPRC    = IN-IDPRC     AND                         +              
        SPAR-KDORDKL  = IN-KDORDKL   AND                         +              
        SPAR-IDDISTR  = IN-IDDISTR                                              
                                                                                
        IF SPAR-IDKUNDNR NQ IN-IDKUNDNR OR                       +              
           SPAR-IDKUNDRF NQ IN-IDKUNDRF                                         
            W-NOF-ORDERS  = W-NOF-ORDERS + 1                                    
            SPAR-IDKUNDNR = IN-IDKUNDNR                                         
            SPAR-IDKUNDRF = IN-IDKUNDRF                                         
        END-IF                                                                  
        W-LINES       = W-LINES + IN-LINES                                      
        W-VALUE-STD   = W-VALUE-STD + IN-VALUE-STD                              
        W-VALUE-AVG   = W-VALUE-AVG + IN-VALUE-AVG                              
        W-VKARTNTO    = W-VKARTNTO + IN-VKARTNTO                                
        W-VLARTNTO    = W-VLARTNTO + IN-VLARTNTO                                
                                                                                
     ELSE                                                                       
       PERFORM S02-SKRIV-VECKOFIL                                               
                                                                                
       W-NOF-ORDERS     = 1                                                     
       W-LINES          = IN-LINES                                              
       W-VALUE-STD      = IN-VALUE-STD                                          
       W-VALUE-AVG      = IN-VALUE-AVG                                          
       W-VKARTNTO       = IN-VKARTNTO                                           
       W-VLARTNTO       = IN-VLARTNTO                                           
                                                                                
       SPAR-IDDC        = IN-IDDC                                               
       SPAR-IDPRC       = IN-IDPRC                                              
       SPAR-IDDISTR     = IN-IDDISTR                                            
       SPAR-KDORDKL     = IN-KDORDKL                                            
       SPAR-IDKUNDNR    = IN-IDKUNDNR                                           
       SPAR-IDKUNDRF    = IN-IDKUNDRF                                           
     END-IF                                                                     
                                                                                
  A-INIT.  PROC                                                                 
                                                                                
     W-NOF-ORDERS       = 0                                                     
     W-LINES            = 0                                                     
     W-VALUE-STD        = 0                                                     
     W-VALUE-AVG        = 0                                                     
     W-VKARTNTO         = 0                                                     
     W-VLARTNTO         = 0                                                     
                                                                                
    END-PROC                                                                    
                                                                                
    Z-FINIT.  PROC                                                              
                                                                                
      PERFORM S02-SKRIV-VECKOFIL                                                
                                                                                
    END-PROC                                                                    
                                                                                
NEWPAGE                                                                         
                                                                                
  S02-SKRIV-VECKOFIL. PROC                                                      
                                                                                
     UT-INK-IDDC      = SPAR-IDDC                                               
     UT-INK-IDPRC     = SPAR-IDPRC                                              
     UT-INK-KDORDKL   = SPAR-KDORDKL                                            
     UT-INK-IDDISTR   = SPAR-IDDISTR                                            
     UT-INK-LINES     = W-LINES                                                 
     UT-INK-VALUE-STD = W-VALUE-STD                                             
     UT-INK-VALUE-AVG = W-VALUE-AVG                                             
     UT-INK-VKARTNTO  = W-VKARTNTO                                              
     UT-INK-VLARTNTO  = W-VLARTNTO                                              
     UT-INK-ORDERS    = W-NOF-ORDERS                                            
                                                                                
     PUT WXTR15D2                                                               
                                                                                
  END-PROC                                                                      
NEWPAGE                                                                         
