                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W512                                                  *        
*                                                                      *        
*  FUNCTION   :  STOCK VALUE ANALYSIS                                  *        
*                                                                      *        
*  AUTHOR     :  SARASWATHY                                            *        
*                                                                      *        
*  INFILE     :  W51282,  W01160                                       *        
*                                                                      *        
*  UTDATA     :  EXCELFIL W51283 - NON VCC                             *        
*                CREATES EXCEL FOR STOCK VALUATION                     *        
*                DETAILED PART NUMBER WISE AND SUMMARY REPORTS         *        
*----------------------------------------------------------------------*        
                                                                                
FILE W51283D1                                                                   
%W51282  'IN1-'                                                                 
                                                                                
FILE TPFIL1 FB(49 0)                                                            
%W51282  'T1-'                                                                  
                                                                                
FILE W51283D2                                                                   
%W01160  'IN2-'                                                                 
                                                                                
FILE TPFIL2 FB(950 0)                                                           
%W01160  'T2-'                                                                  
                                                                                
*---------------------------------------------*                                 
* TEMPFIL MED DIVERSE LISTTRANSAR, EJ SUMMERADE                                 
*---------------------------------------------*                                 
FILE TPFIL3 FB(90 0)                                                            
T3-AREA            1 31 A                                                       
T3-IDDC            1  2 A                                                       
T3-IDARTNR         3  5 P                                                       
T3-KDTRADP         8  4 A                                                       
T3-KDPRODSL       12  2 P                                                       
T3-KVANTAL        14  4 P 0                                                     
T3-PRAVCOST       18  5 P 2                                                     
T3-SUNETT         23  9 P 2                                                     
T3-BEART          32 25 A                                                       
                                                                                
* TEMPFIL MED DIVERSE LISTTRANSAR, EJ SUMMERADE                                 
*---------------------------------------------*                                 
FILE TPFIL4 FB(26 0)                                                            
T4-AREA            1 17 A                                                       
T4-IDDC            1 2 A                                                        
T4-KDTRADP         3 4 A                                                        
T4-KDPRODSL        7 2 P                                                        
T4-KVANTAL         9 4 P 0                                                      
T4-PRAVCOST       13 5 P 2                                                      
T4-SUNETT         18 9 P 2                                                      
                                                                                
****** EXCELENS UTFIL                                                           
FILE W51283D3 PRINTER VB(57   0)                                                
                                                                                
****** EXCELENS 2:A TOM X:TE RAD                                                
UT-IDDC          W   2  A                                                       
UT-KDPRODSL      W   2  A                                                       
UT-KDTRADP       W   4  A                                                       
UT-TEXT          W   30 A                                                       
UT-SIGN          W   1  A                                                       
UT-SUMMA-N       W   11 N                                                       
UT-SUMMA-D       W   2  N                                                       
                                                                                
****** EXCELENS UTFIL                                                           
FILE W51283D4 PRINTER VB(65  0)                                                 
                                                                                
UT1-IDARTNR         W  9  N                                                     
UT1-IDDC            W  2  A                                                     
UT1-KDPRODSL        W  2  N                                                     
UT1-SIGN1           W  1  A                                                     
UT1-KVANTAL         W  7  N                                                     
UT1-SIGN2           W  1  A                                                     
UT1-PRAVCOST-N      W 11  N                                                     
UT1-PRAVCOST-D      W  2  N                                                     
UT1-SIGN3           W  1  A                                                     
UT1-SUMMA-N         W 11  N                                                     
UT1-SUMMA-D         W  2  N                                                     
                                                                                
****** EXCELENS UTFIL                                                           
FILE W51283D5 PRINTER VB(95  0)                                                 
                                                                                
UT2-IDARTNR         W  9  N                                                     
UT2-IDDC            W  2  A                                                     
UT2-KDPRODSL        W  2  N                                                     
UT2-SIGN1           W  1  A                                                     
UT2-KVANTAL         W  7  N                                                     
UT2-SIGN2           W  1  A                                                     
UT2-PRAVCOST-N      W 11  N                                                     
UT2-PRAVCOST-D      W  2  N                                                     
UT2-SIGN3           W  1  A                                                     
UT2-SUMMA-N         W 11  N                                                     
UT2-SUMMA-D         W  2  N                                                     
UT2-BEART           W 25  A                                                     
                                                                                
****** EXCELENS FÖRSTA RAD                                                      
RUB-DATUM        W   6  N                                                       
RUB-MÅNAD        W   2  N                                                       
                                                                                
%WDATKORT                                                                       
                                                                                
*-------------*                                                                 
* ARBETSAREOR *                                                                 
*-------------*                                                                 
W-PREV-KDTRADP   W   4 A                                                        
W-PREV-IDDC      W   2 A                                                        
W-IDDC           W   2 A                                                        
W-KDPRODSL       W   2 N                                                        
W-KDTRADP        W   4 A                                                        
W-SUNETT         W   8 P 2  MASK ('ZZZZZZZZZZZ99.99-')                          
W-PRAVCOST-M     W   8 P 2  MASK ('ZZZZZZZZZZZ99.99')                           
W-KVANTAL        W   5 P 0                                                      
IX               W   2 P 0                                                      
W-SEM            W   1 A    VALUE ';'                                           
W-DECIMAL        W   1 A    VALUE '.'                                           
                                                                                
W-SUNETT-FMT                     W  13  N 2                                     
W-SUNETT-N       W-SUNETT-FMT       11  N                                       
W-SUNETT-D       W-SUNETT-FMT +11   2   N                                       
                                                                                
W-PRAVCOST-FMT                   W  13  N 2                                     
W-PRAVCOST-N     W-PRAVCOST-FMT     11  N                                       
W-PRAVCOST-D     W-PRAVCOST-FMT +11  2  N                                       
                                                                                
PROGRAM-NAMN     W   6   A  VALUE 'W51283'                                      
DATUMKORT-ID     W   6   A  VALUE 'WDATUM'                                      
                                                                                
W-AAMMDD         W   6   N                                                      
W-AA   W-AAMMDD      2   N                                                      
W-MM   W-AAMMDD  +2  2   N                                                      
W-DD   W-AAMMDD  +4  2   N                                                      
                                                                                
BEPRODSL                W 27  A    OCCURS 98                                    
BEPRODSL-PS  BEPRODSL      2  A                                                 
BEPRODSL-TXT BEPRODSL +3  24  A                                                 
                                                                                
NEWPAGE                                                                         
*---------------------------------------------------------------*               
* STEP 1.SORT W51282  WITH IDARTNR                              *               
*---------------------------------------------------------------*               
SORT W51283D1 TO TPFIL1 USING(IN1-IDARTNR)  SIZE 900000                         
*---------------------------------------------------------------*               
* STEP 2.SORT W01160 WITH IDARTNR                               *               
*---------------------------------------------------------------*               
SORT W51283D2 TO TPFIL2 USING(IN2-CLAG-IDARTNR)  SIZE 900000                    
                                                                                
*---------------------------------------------------------------*               
* STEP 3.MATCH TPFIL1 AND TPFIL2 WITH IDARTNR                   *               
*---------------------------------------------------------------*               
                                                                                
JOB INPUT (TPFIL2 KEY (T2-CLAG-IDARTNR) TPFIL1 KEY (T1-IDARTNR)) +              
          START A-INIT                                                          
                                                                                
IF MATCHED                                                                      
  T3-IDDC       = T1-IDDC                                                       
  T3-IDARTNR    = T1-IDARTNR                                                    
  T3-KDPRODSL   = T2-CLAG-KDPRODSL                                              
  T3-KDTRADP    = T1-KDTRADP                                                    
  W-KVANTAL     = T1-KVLS + T1-KVEFRS                                           
  T3-KVANTAL    = W-KVANTAL                                                     
  T3-PRAVCOST   = T1-PRAVCOST                                                   
  T3-BEART      = T1-BEART                                                      
  T3-SUNETT     = W-KVANTAL * T1-PRAVCOST                                       
  IF T3-SUNETT NE 0                                                             
    PUT TPFIL3                                                                  
  END-IF                                                                        
END-IF                                                                          
                                                                                
A-INIT. PROC                                                                    
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                      
  W-AA       = D-AAR                                                            
  W-MM       = D-MAANAD                                                         
  W-DD       = D-DAG                                                            
  RUB-DATUM  = W-AAMMDD                                                         
  RUB-MÅNAD  = W-MM                                                             
                                                                                
****  INITIERA TABELLER ******                                                  
  BEPRODSL(01) =       '11 SPARE PARTS VCC'                                     
  BEPRODSL(02) =       '12                '                                     
  BEPRODSL(03) =       '13 CHEMICALS VCCS'                                      
  BEPRODSL(04) =       '14 EXCHANGE VCC'                                        
  BEPRODSL(05) =       '15 ACCESSORIES VCC'                                     
  BEPRODSL(06) =       '16 RADIO VCC/COMPLETE WHEELS'                           
  BEPRODSL(07) =       '17 TELEPHONES VCC'                                      
  BEPRODSL(08) =       '18 TOOLS VCC'                                           
  BEPRODSL(09) =       '19 PACKAGING VCC'                                       
  BEPRODSL(10) =       '20              '                                       
  BEPRODSL(11) =       '21 SPARE PARTS 300/400'                                 
  BEPRODSL(12) =       '22                    '                                 
  BEPRODSL(13) =       '23 CHEMICALS 300/400'                                   
  BEPRODSL(14) =       '24 EXCHANGE 300/400'                                    
