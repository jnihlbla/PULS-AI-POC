  BEPRODSL(78) =       '88           '                                          
  BEPRODSL(79) =       '89           '                                          
  BEPRODSL(80) =       '90           '                                          
  BEPRODSL(81) =       '91 SPARE PARTS LOC'                                     
  BEPRODSL(82) =       '92           '                                          
  BEPRODSL(83) =       '93 CHEMICALS LOC'                                       
  BEPRODSL(84) =       '94 EXCHANGE LOC'                                        
  BEPRODSL(85) =       '95 ACCESSORIES LOC'                                     
  BEPRODSL(86) =       '96 RADIO LOC'                                           
  BEPRODSL(87) =       '97 TELEPHONES LOC'                                      
  BEPRODSL(88) =       '98 TOOLS LOC'                                           
  BEPRODSL(89) =       '99 PACKAGING LOC'                                       
END-PROC                                                                        
                                                                                
*--------------------------------------------------------*                      
* STEG 3 SORTERA TPFIL2 TILL TPFIL2 PER DC OCH PRODSL                           
*        OCH SUMMERA SAMT SKRIV EXCELFIL                                        
*--------------------------------------------------------*                      
                                                                                
SORT TPFIL3 TO TPFIL3 USING (T3-IDDC T3-KDPRODSL T3-KDTRADP) +                  
                             SIZE 200000                                        
JOB INPUT NULL                                                                  
                                                                                
  GET TPFIL3                                                                    
  IF NOT EOF TPFIL3                                                             
    W-IDDC             = T3-IDDC                                                
    W-KDPRODSL         = T3-KDPRODSL                                            
    W-KDTRADP          = T3-KDTRADP                                             
    W-SUNETT           = 0                                                      
    DO WHILE NOT EOF TPFIL3                                                     
      IF T3-IDDC = W-IDDC AND T3-KDPRODSL = W-KDPRODSL +                        
      AND T3-KDTRADP = W-KDTRADP                                                
        W-SUNETT = W-SUNETT + T3-SUNETT                                         
      ELSE                                                                      
        PERFORM SKRIV-EXCELPOST-1                                               
        PRINT REPORT01                                                          
        W-IDDC             = T3-IDDC                                            
        W-KDPRODSL         = T3-KDPRODSL                                        
        W-KDTRADP          = T3-KDTRADP                                         
        W-SUNETT           = T3-SUNETT                                          
      END-IF                                                                    
      GET TPFIL3                                                                
    END-DO                                                                      
  END-IF                                                                        
  PERFORM SKRIV-EXCELPOST-1                                                     
  IF W-KDTRADP NE ' '                                                           
    PRINT REPORT01                                                              
  END-IF                                                                        
                                                                                
  STOP                                                                          
                                                                                
SKRIV-EXCELPOST-1. PROC                                                         
                                                                                
  UT-IDDC     = W-IDDC                                                          
  UT-KDPRODSL = W-KDPRODSL                                                      
  UT-KDTRADP  = W-KDTRADP                                                       
  UT-TEXT     = 'OTHERS'                                                        
  IX = 1                                                                        
  DO WHILE IX LE 98                                                             
    IF BEPRODSL-PS(IX) EQ UT-KDPRODSL                                           
      UT-TEXT     = BEPRODSL-TXT(IX)                                            
      IX = 99                                                                   
    END-IF                                                                      
    IX = IX + 1                                                                 
  END-DO                                                                        
  W-SUNETT-FMT  = W-SUNETT                                                      
  IF W-SUNETT > 0                                                               
    UT-SIGN     = '+'                                                           
  ELSE                                                                          
    UT-SIGN     = '-'                                                           
  END-IF                                                                        
  UT-SUMMA-N    = W-SUNETT-N                                                    
  UT-SUMMA-D    = W-SUNETT-D                                                    
END-PROC                                                                        
                                                                                
************************************************************************        
*** LIST FOR NON VCC - SENT TO D&P                                              
************************************************************************        
  REPORT   REPORT01             +                                               
           PRINTER W51283D3     +                                               
           LINESIZE 52          +                                               
           SPACE 0              +                                               
           NOHEADING            +                                               
           NOSPREAD             +                                               
           NOADJUST             +                                               
           PAGESIZE 32767       +                                               
           NODATE                                                               
LINE  1  UT-IDDC              +                                                 
         W-SEM                +                                                 
         UT-KDPRODSL          +                                                 
         W-SEM                +                                                 
         UT-TEXT              +                                                 
         W-SEM                +                                                 
         UT-SUMMA-N           +                                                 
         W-DECIMAL            +                                                 
         UT-SUMMA-D           +                                                 
         W-SEM                                                                  
*                                                                               
BEFORE-LINE. PROC                                                               
 IF W-KDTRADP NE W-PREV-KDTRADP                                                 
   DISPLAY '¤DAPW51283-001'                                                     
   DISPLAY '¤DAP' W-KDTRADP                                                     
   DISPLAY 'DATE' RUB-DATUM ';PERIOD' RUB-MÅNAD ';'                             
   W-PREV-KDTRADP = W-KDTRADP                                                   
 END-IF                                                                         
END-PROC                                                                        
*--------------------------------------------------------*                      
* STEG 4 SORT TPFIL3 TO TPFIL3 PER DC AND IDARTNR                               
*--------------------------------------------------------*                      
                                                                                
SORT TPFIL3 TO TPFIL3 USING (T3-IDDC T3-IDARTNR T3-KDTRADP) +                   
                             SIZE 200000                                        
JOB INPUT TPFIL3                                                                
                                                                                
  W-KDTRADP      = T3-KDTRADP                                                   
  W-IDDC         = T3-IDDC                                                      
  W-SUNETT-FMT   = 0                                                            
  W-SUNETT       = 0                                                            
                                                                                
  UT1-IDDC       = T3-IDDC                                                      
  UT1-IDARTNR    = T3-IDARTNR                                                   
  UT1-KDPRODSL   = T3-KDPRODSL                                                  
  IF T3-KVANTAL > 0                                                             
    UT1-SIGN1     = '+'                                                         
  ELSE                                                                          
    UT1-SIGN1     = '-'                                                         
  END-IF                                                                        
  UT1-KVANTAL    = T3-KVANTAL                                                   
                                                                                
  IF T3-PRAVCOST > 0                                                            
    UT1-SIGN2     = '+'                                                         
  ELSE                                                                          
    UT1-SIGN2     = '-'                                                         
  END-IF                                                                        
  W-PRAVCOST-FMT = T3-PRAVCOST                                                  
  UT1-PRAVCOST-N = W-PRAVCOST-N                                                 
  UT1-PRAVCOST-D = W-PRAVCOST-D                                                 
                                                                                
  IF T3-SUNETT   > 0                                                            
    UT1-SIGN3     = '+'                                                         
  ELSE                                                                          
    UT1-SIGN3     = '-'                                                         
  END-IF                                                                        
  W-SUNETT-FMT   = T3-SUNETT                                                    
  UT1-SUMMA-N    = W-SUNETT-N                                                   
  UT1-SUMMA-D    = W-SUNETT-D                                                   
                                                                                
  PRINT REPORT02                                                                
                                                                                
************************************************************************        
*** LIST FOR NON VCC - SENT TO D&P - PART LEVEL                                 
************************************************************************        
  REPORT   REPORT02             +                                               
           PRINTER W51283D4     +                                               
           LINESIZE 60          +                                               
           SPACE 0              +                                               
           NOHEADING            +                                               
           NOSPREAD             +                                               
           NOADJUST             +                                               
           PAGESIZE 32000       +                                               
           NODATE                                                               
LINE  1  UT1-IDARTNR            +                                               
         W-SEM                  +                                               
         UT1-IDDC               +                                               
         W-SEM                  +                                               
         UT1-KDPRODSL           +                                               
         W-SEM                  +                                               
         UT1-SIGN1              +                                               
         UT1-KVANTAL            +                                               
         W-SEM                  +                                               
         UT1-SIGN2              +                                               
         UT1-PRAVCOST-N         +                                               
         W-DECIMAL              +                                               
         UT1-PRAVCOST-D         +                                               
         W-SEM                  +                                               
         UT1-SIGN3              +                                               
         UT1-SUMMA-N            +                                               
         W-DECIMAL              +                                               
         UT1-SUMMA-D            +                                               
         W-SEM                                                                  
BEFORE-LINE. PROC                                                               
 IF W-KDTRADP NE W-PREV-KDTRADP                                                 
   DISPLAY '¤DAPW51283-002'                                                     
   DISPLAY '¤DAP' W-KDTRADP                                                     
   DISPLAY 'PART NO.;DC;PRODUCT GRP;QTY;PRICE;SUM'                              
   W-PREV-KDTRADP = W-KDTRADP                                                   
 END-IF                                                                         
END-PROC                                                                        
*--------------------------------------------------------*                      
* STEG 5 SORT TPFIL3 TO TPFIL3 PER DC AND IDARTNR                               
*--------------------------------------------------------*                      
                                                                                
SORT TPFIL3 TO TPFIL3 USING (T3-IDDC T3-IDARTNR T3-KDTRADP) +                   
                             SIZE 200000                                        
JOB INPUT TPFIL3                                                                
                                                                                
  W-KDTRADP      = T3-KDTRADP                                                   
  W-IDDC         = T3-IDDC                                                      
  W-SUNETT-FMT   = 0                                                            
  W-SUNETT       = 0                                                            
                                                                                
  UT2-IDDC       = T3-IDDC                                                      
  UT2-IDARTNR    = T3-IDARTNR                                                   
  UT2-KDPRODSL   = T3-KDPRODSL                                                  
  IF T3-KVANTAL > 0                                                             
    UT2-SIGN1     = '+'                                                         
  ELSE                                                                          
    UT2-SIGN1     = '-'                                                         
  END-IF                                                                        
  UT2-KVANTAL    = T3-KVANTAL                                                   
                                                                                
  IF T3-PRAVCOST > 0                                                            
    UT2-SIGN2     = '+'                                                         
  ELSE                                                                          
    UT2-SIGN2     = '-'                                                         
  END-IF                                                                        
  W-PRAVCOST-FMT = T3-PRAVCOST                                                  
  UT2-PRAVCOST-N = W-PRAVCOST-N                                                 
  UT2-PRAVCOST-D = W-PRAVCOST-D                                                 
                                                                                
  IF T3-SUNETT   > 0                                                            
    UT2-SIGN3     = '+'                                                         
  ELSE                                                                          
    UT2-SIGN3     = '-'                                                         
  END-IF                                                                        
  W-SUNETT-FMT   = T3-SUNETT                                                    
  UT2-SUMMA-N    = W-SUNETT-N                                                   
  UT2-SUMMA-D    = W-SUNETT-D                                                   
  UT2-BEART      = T3-BEART                                                     
                                                                                
  PRINT REPORT03                                                                
                                                                                
************************************************************************        
*** LIST FOR NON VCC - SENT TO D&P - PART LEVEL                                 
************************************************************************        
  REPORT   REPORT03             +                                               
           PRINTER W51283D5     +                                               
           LINESIZE 90          +                                               
           SPACE 0              +                                               
           NOHEADING            +                                               
           NOSPREAD             +                                               
           NOADJUST             +                                               
           PAGESIZE 32000       +                                               
           NODATE                                                               
LINE  1  UT2-IDARTNR            +                                               
         W-SEM                  +                                               
         UT2-IDDC               +                                               
         W-SEM                  +                                               
         UT2-KDPRODSL           +                                               
         W-SEM                  +                                               
         UT2-SIGN1              +                                               
         UT2-KVANTAL            +                                               
         W-SEM                  +                                               
         UT2-SIGN2              +                                               
         UT2-PRAVCOST-N         +                                               
         W-DECIMAL              +                                               
         UT2-PRAVCOST-D         +                                               
         W-SEM                  +                                               
         UT2-SIGN3              +                                               
         UT2-SUMMA-N            +                                               
         W-DECIMAL              +                                               
         UT2-SUMMA-D            +                                               
         W-SEM                  +                                               
         UT2-BEART              +                                               
         W-SEM                                                                  
BEFORE-LINE. PROC                                                               
 IF W-KDTRADP NE W-PREV-KDTRADP                                                 
   DISPLAY '¤DAPW51283-003'                                                     
   DISPLAY '¤DAP' W-KDTRADP                                                     
   DISPLAY 'PART NO.;DC;PRODUCT GRP;QTY;PRICE;SUM;DESCRIPTION'                  
   W-PREV-KDTRADP = W-KDTRADP                                                   
 END-IF                                                                         
END-PROC                                                                        
