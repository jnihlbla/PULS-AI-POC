NEWPAGE                                                                         
FILE W22430D1                                                                   
*                                                                               
%W4267501  'KV-'                                                                
                                                                                
FILE W22430D2                                                                   
*                                                                               
%W22435  'IN-'                                                                  
                                                                                
FILE W22430D3  PRINTER FB (121 121)                                             
                                                                                
