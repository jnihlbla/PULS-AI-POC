NEWPAGE                                                                         
************      WORKING STORAGE                                               
WS-IDARTNR             W  9  N     MASK 'ZZZZZZZZZ'                             
WS-IDARTNR-MOTSV       W  9  N     MASK 'ZZZZZZZZZ'                             
WS-IDFKNGRP            W  4  N     MASK 'ZZZZ'                                  
WS-IDLEVNR-OLD         W  5  A                                                  
WS-IDLEVNR-NEW         W  5  A                                                  
WS-BEFT                W  3  N     MASK 'ZZZ'                                   
WS-KDFARLIG            W  1  N     MASK 'Z'                                     
WS-KDKVAKTL            W  4  A                                                  
WS-TEXT                W 11  A                                                  
WS-TIFINLV             W  5  N                                                  
WS-TIAAVV  WS-TIFINLV     4  N                                                  
WS-TID     WS-TIFINLV +4  1  N                                                  
WS-AAVV                W  4  N     MASK 'ZZZZ'                                  
SPAR-IDARTNR           W  5  P     VALUE +0                                     
                                                                                
TITEL-FTG-CAR         W 27 A   VALUE 'VOLVO CAR CORP., AFTERSALES'              
TITEL-FTG             W 27 A                                                    
*                                                                               
* SVENSK TEXT                                                                   
*                                                                               
TITEL-RUBRIK-1-S      W 41 A                                       +            
      VALUE 'NYREGISTRERINGAR OCH LEVERANTÖRSBYTEN    '                         
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
* STEG 1. SORTERAR KONTROLLKODSFILEN                                            
*                                                                               
SORT W22430D1  TO    +                                                          
     W22430D1 USING (KV-IDARTNR)                                                
*                                                                               
* STEG 2. MATCHAR NYREG/LEVBYTEN MED KVALKONTROLLEN OCH SKAPAR                  
*         LISTA                                                                 
*                                                                               
JOB INPUT (W22430D2 KEY (IN-IDARTNR) W22430D1 KEY (KV-IDARTNR))                 
                                                                                
    IF MATCHED                                                                  
      WS-KDKVAKTL    =   KV-KDKVAKTL                                            
      PERFORM B-SATT-VARDEN                                                     
                                                                                
      PERFORM C-VALJ-LISTA                                                      
    ELSE                                                                        
      IF W22430D2                                                               
        MOVE SPACE TO WS-KDKVAKTL                                               
        PERFORM B-SATT-VARDEN                                                   
        PERFORM C-VALJ-LISTA                                                    
      END-IF                                                                    
    END-IF                                                                      
                                                                                
B-SATT-VARDEN. PROC                                                             
      SPAR-IDARTNR   =   IN-IDARTNR                                             
      WS-IDARTNR     =   IN-IDARTNR                                             
      WS-IDARTNR-MOTSV = IN-IDARTNR-MOTSV                                       
      WS-IDFKNGRP    =   IN-IDFKNGRP                                            
      WS-IDLEVNR-OLD =   IN-IDLEVNR-GAM                                         
      WS-IDLEVNR-NEW =   IN-IDLEVNR-NY                                          
      WS-BEFT        =   IN-BEFT                                                
      WS-KDFARLIG    =   IN-KDFARLIG                                            
      WS-TIFINLV     =   IN-TIFINLV                                             
      WS-AAVV        =   WS-TIAAVV                                              
      IF IN-NYREG = 'NY'                                                        
          WS-TEXT = 'NYREG ARTNR'                                               
      ELSE                                                                      
          WS-TEXT = 'BYTE LEVNR'                                                
      END-IF                                                                    
END-PROC                                                                        
                                                                                
C-VALJ-LISTA. PROC                                                              
      IF IN-IDFKNGRP = 1000 THRU 1999                                           
        PRINT LISTA-001                                                         
      ELSE                                                                      
      IF IN-IDFKNGRP = 3000 THRU 3999                  +                        
                       8000 THRU 8999                                           
        PRINT LISTA-002                                                         
      ELSE                                                                      
      IF IN-IDFKNGRP = 2000 THRU 2999                  +                        
                       4000 THRU 7999                                           
        PRINT LISTA-003                                                         
      ELSE                                                                      
        PRINT LISTA-004                                                         
      END-IF                                                                    
      END-IF                                                                    
      END-IF                                                                    
                                                                                
      IF IN-IDFKNGRP = 2101 2102 2104 2105 2111 2121   +                        
         2611 2841 3521 3522 3531 3532                 +                        
         3561 THRU 3567                                +                        
         3811 4311 4371                                +                        
         8101 8121 8111 8131 8139 8211 8251 8261       +                        
         8311 8321                                     +                        
         8360 THRU 8369                                +                        
         8414 8415 8431 8433                           +                        
         8440 THRU 8445                                +                        
         8554 8614                                     +                        
         8730 THRU 8749                                +                        
         8811 8841 8845 8915                                                    
        PRINT LISTA-005                                                         
      END-IF                                                                    
END-PROC                                                                        
NEWPAGE                                                                         
                                                                                
REPORT LISTA-001 PRINTER W22430D3 LINESIZE 120                      +           
                  SPACE 1 NODATE NOADJUST DTLCTL FIRST                          
SEQUENCE IN-IDPROJ IN-IDFKNGRP IN-IDARTNR                                       
CONTROL  IN-IDPROJ NEWPAGE                                                      
TITLE 1  TITEL-FTG-CAR  COL  30 'W22430-001' COL 45 TITEL-RUBRIK-1-S +          
                        COL 89 'DATUM' SYSDATE                                  
HEADING  IN-IDPROJ  ('PROJ')                                                    
HEADING  WS-IDARTNR ('  ART.NR')                                                
HEADING  IN-BEART-SVE  ('BENÄMNING      ')                                      
HEADING  WS-IDFKNGRP  ('FKN' 'GRUPP')                                           
HEADING  WS-IDLEVNR-OLD  ('GAMMAL ' 'LEV  ')                                    
HEADING  WS-IDLEVNR-NEW  ('NY ' 'LEV')                                          
HEADING  WS-BEFT      ('FÖRP' 'TYP')                                            
HEADING  WS-AAVV  (' ' '1:A IN')                                                
HEADING  WS-KDKVAKTL (' ' 'KKOD')                                               
HEADING  WS-KDFARLIG (' ' 'FG')                                                 
HEADING  IN-KDFORP   ('FÖRP' 'KOD')                                             
HEADING  WS-IDARTNR-MOTSV ('MOTSV' 'ART.NR')                                    
HEADING  WS-TEXT     (' ' 'TYP AV REG')                                         
                                                                                
LINE   IN-IDPROJ WS-IDARTNR IN-BEART-SVE  +                                     
       WS-IDFKNGRP             +                                                
       WS-IDLEVNR-OLD WS-IDLEVNR-NEW +                                          
       WS-BEFT WS-AAVV   +                                                      
       WS-KDKVAKTL WS-KDFARLIG IN-KDFORP   +                                    
       WS-IDARTNR-MOTSV  WS-TEXT                                                
                                                                                
NEWPAGE                                                                         
                                                                                
