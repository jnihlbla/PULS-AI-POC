*----------------------------------------------------------------*              
*                                                                               
FILE W47730D1                                                                   
*                                                                               
%W475894E      'IN-'                                                            
*                                                                               
FILE W47730D3 TABLE                                                             
     ARG   1 2 A                                                                
     DESC  3 3 A                                                                
*                                                                               
FILE W47730D4 TABLE                                                             
     ARG   1 3 A                                                                
     DESC  4 5 N 4                                                              
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W47730D2 PRINTER                                                           
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
*                                                                               
 SPAR-INFOP        W  12  A    VALUE '800213609B16'                             
 SPAR-RUBRIEK      W   1  N    VALUE 6                                          
 SPAR-TARIC        W   2  N    VALUE 00                                         
 SPAR-STELSEL      W   2  N    VALUE 00                                         
 SPAR-TRANS        W   1  N    VALUE 1                                          
 SPAR-COUN         W   3  A    VALUE '000'                                      
 SPAR-VTAK         W   1  N    VALUE 3                                          
 SPAR-CONTAIN      W   1  N    VALUE 0                                          
 SPAR-VERKGEB      W   2  N    VALUE 53                                         
 SPAR-HSTATNR      W   9  N                                                     
 SPAR-IDSTATNR     W   9  N                                                     
 SPAR-IDLANDX2     W   2  A                                                     
 SPAR-KVLEVART     W   6  N                                                     
 SPAR-VKLEV        W   7  N  1                                                  
 SPAR-PVKLEV       W   7  N                                                     
 SPAR-SUEEC        W   9  N  2                                                  
 SPAR-SUEFTA       W   9  N  2                                                  
 SPAR-SUOEVR       W   9  N  2                                                  
 SPAR-SUFAKT       W   9  N  2                                                  
 SPAR-PSUFAKT      W   9  N                                                     
 SPAR-STATVAL      W   9  N  2                                                  
 SPAR-PSTATVAL     W   9  N                                                     
 SPAR-TIFAKT       W   6  N                                                     
 SPAR-YYMM         SPAR-TIFAKT  4  N                                            
 SPAR-RATE         W   5  N  4                                                  
 SPAR-AFF          W   5  N  4                                                  
 SPAR-SARG         W   3  A                                                     
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT  W47730D1   START A-INIT                             +              
                        FINISH Z-FINIT                           +              
                                                  NAME   STEG01                 
    IF IN-IDSTATNR = 0                                                          
       IN-IDSTATNR = 87089998                                                   
    END-IF                                                                      
                                                                                
    IF RECORD-COUNT = 1                                                         
* DETERMINE REPORTING PERIOD                                                    
      SPAR-TIFAKT = IN-TIFAKT                                                   
                                                                                
      PERFORM SPARA-NYCKLAR                                                     
    END-IF                                                                      
                                                                                
    IF IN-IDSTATNR = SPAR-IDSTATNR                                              
*     IN-IDLANDX2 = SPAR-IDLANDX2                                               
        PERFORM SUMMERA-VARDEN                                                  
    ELSE                                                                        
      SPAR-PVKLEV ROUNDED = SPAR-VKLEV * 1                                      
      IF SPAR-PVKLEV = 0                                                        
         SPAR-PVKLEV = 1                                                        
      END-IF                                                                    
      SPAR-PSUFAKT ROUNDED = SPAR-SUFAKT * SPAR-RATE                            
      IF SPAR-PSUFAKT = 0                                                       
         SPAR-PSUFAKT = 1                                                       
      END-IF                                                                    
      SPAR-PSTATVAL ROUNDED = SPAR-PSUFAKT * SPAR-AFF                           
      PRINT RAPPORT01                                                           
      PERFORM SPARA-NYCKLAR                                                     
      PERFORM NOLLA-VARDEN                                                      
      PERFORM SUMMERA-VARDEN                                                    
    END-IF                                                                      
                                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
  A-INIT. PROC                                                                  
                                                                                
    SPAR-IDSTATNR   = 0                                                         
    SPAR-IDLANDX2   = '  '                                                      
    SPAR-KVLEVART   = 0                                                         
    SPAR-VKLEV      = 0                                                         
    SPAR-PVKLEV     = 0                                                         
    SPAR-SUEEC      = 0                                                         
    SPAR-SUEFTA     = 0                                                         
    SPAR-SUOEVR     = 0                                                         
    SPAR-SUFAKT     = 0                                                         
    SPAR-PSUFAKT    = 0                                                         
    SPAR-STATVAL    = 0                                                         
    SPAR-PSTATVAL   = 0                                                         
                                                                                
* GET RATE                                                                      
      SPAR-RATE = 1                                                             
      SPAR-SARG = 'SEK'                                                         
      SEARCH W47730D4 WITH SPAR-SARG GIVING SPAR-RATE                           
                                                                                
* GET FACTOR FOR STATISTICAL VALUE                                              
      SPAR-AFF = 1                                                              
      SPAR-SARG = 'AFF'                                                         
      SEARCH W47730D4 WITH SPAR-SARG GIVING SPAR-AFF                            
                                                                                
  END-PROC                                                                      
NEWPAGE                                                                         
*                                                                               
  SPARA-NYCKLAR. PROC                                                           
                                                                                
    SPAR-IDSTATNR  = IN-IDSTATNR                                                
    SPAR-HSTATNR  = IN-IDSTATNR                                                 
    SPAR-IDLANDX2  = 'SE'                                                       
                                                                                
    SPAR-COUN = IN-IDLANDX2                                                     
    SEARCH W47730D3 WITH SPAR-IDLANDX2 GIVING SPAR-COUN                         
                                                                                
  END-PROC                                                                      
NEWPAGE                                                                         
*                                                                               
  SUMMERA-VARDEN. PROC                                                          
                                                                                
    SPAR-KVLEVART = SPAR-KVLEVART + IN-KVLEVART                                 
    SPAR-VKLEV    = SPAR-VKLEV    + IN-VKLEV                                    
    SPAR-SUEEC    = SPAR-SUEEC    + IN-SUEEC                                    
    SPAR-SUEFTA   = SPAR-SUEFTA   + IN-SUEFTA                                   
    SPAR-SUOEVR   = SPAR-SUOEVR   + IN-SUOEVR                                   
    SPAR-SUFAKT   = SPAR-SUFAKT   + IN-SUFAKT                                   
    SPAR-STATVAL  = SPAR-STATVAL  + IN-SUFAKT                                   
                                                                                
  END-PROC                                                                      
NEWPAGE                                                                         
*                                                                               
  NOLLA-VARDEN. PROC                                                            
                                                                                
    SPAR-KVLEVART  = 0                                                          
    SPAR-VKLEV     = 0                                                          
    SPAR-SUEEC     = 0                                                          
    SPAR-SUEFTA    = 0                                                          
    SPAR-SUOEVR    = 0                                                          
    SPAR-SUFAKT    = 0                                                          
    SPAR-STATVAL   = 0                                                          
                                                                                
  END-PROC                                                                      
NEWPAGE                                                                         
*                                                                               
  Z-FINIT. PROC                                                                 
                                                                                
    PRINT RAPPORT01                                                             
                                                                                
  END-PROC                                                                      
NEWPAGE                                                                         
*                                                                               
  REPORT RAPPORT01 PRINTER W47730D2                              +              
                   LINESIZE     128                              +              
                   NOHEADING                                     +              
                   SPACE 1                                       +              
                   NOADJUST                                                     
*                                                                               
  CONTROL SPAR-IDSTATNR NOPRINT                                                 
*                                                                               
* SUM SPAR-VKLEV                                                 +              
*     SPAR-SUFAKT                                                               
*                                                                               
  LINE 01                                                        +              
           SPAR-YYMM                                             +              
           SPAR-INFOP                                            +              
           SPAR-RUBRIEK                                          +              
           SPAR-TARIC                                            +              
           SPAR-STELSEL                                          +              
           SPAR-TRANS                                            +              
           SPAR-COUN                                             +              
           SPAR-VTAK                                             +              
           SPAR-CONTAIN                                          +              
           SPAR-VERKGEB                                          +              
           SPAR-HSTATNR                                          +              
           SPAR-KVLEVART                                         +              
           SPAR-PVKLEV                                           +              
           SPAR-PSUFAKT                                          +              
           SPAR-PSTATVAL                                                        
*                                                                               
