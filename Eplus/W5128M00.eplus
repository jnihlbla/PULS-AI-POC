* STEG 1.SORTERA  ARTIKELSALDOPOSTER ALLA DC PER ARTIKELNUMMER  *               
*---------------------------------------------------------------*               
SORT W5128MD1 TO TPFIL1 USING(IN-IDARTNR)  SIZE 900000                          
                                                                                
*---------------------------------------------------------------*               
* STEG 2. MATCHA SORTERAD FIL MED ARTIKELINFO O SKRIV TPFIL2    *               
*---------------------------------------------------------------*               
                                                                                
JOB INPUT (W5128MD2 KEY (CLAG-IDARTNR) TPFIL1 KEY (T1-IDARTNR)) +               
          START A-INIT                                                          
                                                                                
IF MATCHED                                                                      
  T2-IDDC       = T1-IDDC                                                       
  T2-KDPRODSL   = CLAG-KDPRODSL                                                 
  T2-KDTRADP    = T1-KDTRADP                                                    
  T2-KVAVIS     = T1-KVAVIS                                                     
  T2-SUNETT     = T1-PRARTNTO                                                   
  T2-IDLOPNRM   = T1-IDLOPNRM                                                   
  T2-IDARTNR    = T1-IDARTNR                                                    
  T2-IDPTYP     = T1-IDPTYP                                                     
  T2-IDFAKT     = T1-IDFAKT                                                     
  T2-RETULF     = T1-RETULF                                                     
    PUT TPFIL2                                                                  
                                                                                
  T3-IDPTYP     = T1-IDPTYP                                                     
  T3-IDDC       = T1-IDDC                                                       
  T3-IDLEVNR    = T1-IDLEVNR                                                    
  T3-IDARTNR    = T1-IDARTNR                                                    
  T3-KDPRODSL   = CLAG-KDPRODSL                                                 
  T3-DAINLEV    = T1-DAINLEV                                                    
  T3-KVAVIS     = T1-KVAVIS                                                     
  T3-PRARTNTO   = T1-PRARTNTO                                                   
  T3-KDTRADP    = T1-KDTRADP                                                    
  T3-KDVALISO   = T1-KDVALISO                                                   
  T3-IDFAKT     = T1-IDFAKT                                                     
  T3-IDLOPNRM   = T1-IDLOPNRM                                                   
  T3-RETULF     = T1-RETULF                                                     
    PUT TPFIL3                                                                  
END-IF                                                                          
                                                                                
A-INIT. PROC                                                                    
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                      
  W-AA       = D-AAR                                                            
  W-MM       = D-MAANAD                                                         
  W-DD       = D-DAG                                                            
  RUB-DATUM  = W-AAMMDD                                                         
  RUB-MÅNAD  = W-MM                                                             
                                                                                
