*--------------------------------------------------------*                      
* STEG 3 SORTERA TPFIL2 TILL TPFIL2 PER DC OCH PRODSL                           
*        OCH SUMMERA SAMT SKRIV EXCELFIL                                        
*--------------------------------------------------------*                      
                                                                                
SORT TPFIL2 TO TPFIL2 USING (T2-IDDC T2-KDPRODSL T2-IDARTNR  +                  
                             T2-KDTRADP) SIZE 200000                            
JOB INPUT NULL                                                                  
                                                                                
  GET TPFIL2                                                                    
  IF NOT EOF TPFIL2                                                             
    W-IDDC             = T2-IDDC                                                
    W-KDPRODSL         = T2-KDPRODSL                                            
    W-KDTRADP          = T2-KDTRADP                                             
    W-SUNETT           = 0                                                      
    DO WHILE NOT EOF TPFIL2                                                     
      IF T2-IDDC = W-IDDC AND T2-KDPRODSL = W-KDPRODSL +                        
      AND T2-KDTRADP = W-KDTRADP                                                
        IF T2-IDPTYP = 'R31'                +                                   
        OR T2-IDPTYP = 'P32'                +                                   
        OR T2-IDPTYP = 'R40'                +                                   
        AND  T2-IDFAKT  EQ  0                                                   
          W-SUNETT-SUM = T2-SUNETT * T2-KVAVIS + T2-SUNETT          +           
                              * T2-KVAVIS * (T2-RETULF - 1)                     
          W-SUNETT = W-SUNETT-SUM + W-SUNETT                                    
        ELSE                                                                    
          W-SUNETT = T2-SUNETT * T2-KVAVIS + W-SUNETT                           
        END-IF                                                                  
      ELSE                                                                      
        PERFORM SKRIV-EXCELPOST-1                                               
        PRINT REPORT01                                                          
        W-IDDC             = T2-IDDC                                            
        W-KDPRODSL         = T2-KDPRODSL                                        
        W-KDTRADP          = T2-KDTRADP                                         
        W-SUNETT           = 0                                                  
        IF T2-IDPTYP = 'R31'                +                                   
        OR T2-IDPTYP = 'P32'                +                                   
        OR T2-IDPTYP = 'R40'                +                                   
        AND  T2-IDFAKT  EQ  0                                                   
          W-SUNETT-SUM = T2-SUNETT * T2-KVAVIS + T2-SUNETT          +           
                              * T2-KVAVIS * (T2-RETULF - 1)                     
          W-SUNETT = W-SUNETT-SUM + W-SUNETT                                    
        ELSE                                                                    
          W-SUNETT = T2-SUNETT * T2-KVAVIS + W-SUNETT                           
        END-IF                                                                  
      END-IF                                                                    
      GET TPFIL2                                                                
    END-DO                                                                      
  END-IF                                                                        
  PERFORM SKRIV-EXCELPOST-1                                                     
  IF W-KDTRADP NE ' '                                                           
    PRINT REPORT01                                                              
  END-IF                                                                        
                                                                                
  STOP                                                                          
                                                                                
SKRIV-EXCELPOST-1. PROC                                                         
                                                                                
  UT-IDDC     = W-IDDC                                                          
  UT-KDPRODSL = W-KDPRODSL                                                      
  UT-KDTRADP  = W-KDTRADP                                                       
  UT-TEXT     = 'OTHERS'                                                        
  IX = 1                                                                        
  DO WHILE IX LE 98                                                             
    IF BEPRODSL-PS(IX) EQ UT-KDPRODSL                                           
      UT-TEXT     = BEPRODSL-TXT(IX)                                            
      IX = 99                                                                   
    END-IF                                                                      
    IX = IX + 1                                                                 
  END-DO                                                                        
  W-SUNETT-FMT  = W-SUNETT                                                      
  IF W-SUNETT < 0                                                               
    UT-SIGN     = '-'                                                           
  ELSE                                                                          
    UT-SIGN     = ' '                                                           
  END-IF                                                                        
  UT-SUMMA-N    = W-SUNETT-N                                                    
  UT-SUMMA-D    = W-SUNETT-D                                                    
END-PROC                                                                        
                                                                                
************************************************************************        
*** LIST FOR NON VCC - SENT TO D&P                                              
************************************************************************        
  REPORT   REPORT01             +                                               
           PRINTER W5128MD3     +                                               
           LINESIZE 53          +                                               
           SPACE 0              +                                               
           NOHEADING            +                                               
           NOSPREAD             +                                               
           NOADJUST             +                                               
           PAGESIZE 32767       +                                               
           NODATE                                                               
LINE  1  UT-IDDC              +                                                 
         W-SEM                +                                                 
         UT-KDPRODSL          +                                                 
         W-SEM                +                                                 
         UT-TEXT              +                                                 
         W-SEM                +                                                 
         UT-SIGN              +                                                 
         UT-SUMMA-N           +                                                 
         W-DECIMAL            +                                                 
         UT-SUMMA-D           +                                                 
         W-SEM                                                                  
*                                                                               
BEFORE-LINE. PROC                                                               
 IF W-KDTRADP NE W-PREV-KDTRADP                                                 
   DISPLAY '¤DAPW5128M-001'                                                     
   DISPLAY '¤DAP' W-KDTRADP                                                     
   DISPLAY 'DATE' RUB-DATUM ';PERIOD' RUB-MÅNAD ';'                             
   W-PREV-KDTRADP = W-KDTRADP                                                   
 END-IF                                                                         
END-PROC                                                                        
*--------------------------------------------------------*                      
* STEG 4 SORTERA TPFIL3 TILL TPFIL3 PER DC OCH IDARTNR                          
*--------------------------------------------------------*                      
                                                                                
SORT TPFIL3 TO TPFIL3 USING (T3-IDDC T3-KDPRODSL T3-IDARTNR +                   
                             T3-KDTRADP)        SIZE 200000                     
JOB INPUT TPFIL3                                                                
                                                                                
  W-KDTRADP       = T3-KDTRADP                                                  
  W-KDVALISO      = T3-KDVALISO                                                 
                                                                                
  UT1-IDPTYP      = T3-IDPTYP                                                   
  UT1-IDDC        = T3-IDDC                                                     
  UT1-IDLEVNR     = T3-IDLEVNR                                                  
  UT1-IDARTNR     = T3-IDARTNR                                                  
  UT1-KDPRODSL    = T3-KDPRODSL                                                 
  WS-DATE-DISPLAY = 9999999999999999 - T3-DAINLEV                               
  WS-YEAR         = WS-YY                                                       
  WS-MONTH        = WS-MM                                                       
  WS-DAY          = WS-DD                                                       
  UT1-DAREGDAT    = WS-DATE                                                     
  UT1-KVAVIS      = T3-KVAVIS                                                   
  IF T3-KVAVIS > 0 OR T3-KVAVIS = 0                                             
    MOVE ' ' TO UT1-SIGN1                                                       
  ELSE                                                                          
    MOVE '-' TO UT1-SIGN1                                                       
  END-IF                                                                        
  IF T3-PRARTNTO > 0 OR T3-PRARTNTO = 0                                         
    MOVE ' ' TO UT1-SIGN2                                                       
  ELSE                                                                          
    MOVE '-' TO UT1-SIGN2                                                       
  END-IF                                                                        
  W-PRARTNTO-FMT  = T3-PRARTNTO                                                 
  UT1-PRARTNTO-N  = W-PRARTNTO-N                                                
  UT1-PRARTNTO-D  = W-PRARTNTO-D                                                
                                                                                
  W-PRARTNTO-TOT  = T3-PRARTNTO                                                 
                                                                                
  W-RETULF-FMT    = T3-RETULF                                                   
  UT1-RETULF-N    = W-RETULF-FMT-N                                              
  UT1-RETULF-D    = W-RETULF-FMT-D                                              
                                                                                
  IF T3-IDPTYP = 'R31'                                      +                   
  OR T3-IDPTYP = 'P32'                                      +                   
  OR T3-IDPTYP = 'R40'                                      +                   
  AND  T3-IDFAKT  EQ  0                                                         
    UT1-IDFAKT      = T3-IDLOPNRM                                               
    W-PRARTNTO-TRA      = T3-PRARTNTO * T3-KVAVIS +                +            
                          T3-PRARTNTO * T3-KVAVIS * (T3-RETULF - 1)             
    IF W-PRARTNTO-TRA > 0 OR W-PRARTNTO-TRA = 0                                 
      MOVE ' ' TO UT1-SIGN3                                                     
    ELSE                                                                        
      MOVE '-' TO UT1-SIGN3                                                     
    END-IF                                                                      
    UT1-PRARTNTO-TOT-N  = W-PRARTNTO-TRA-N                                      
    UT1-PRARTNTO-TOT-D  = W-PRARTNTO-TRA-D                                      
  ELSE                                                                          
    W-PRARTNTO-TRA      = T3-PRARTNTO * T3-KVAVIS                               
    IF W-PRARTNTO-TRA > 0 OR W-PRARTNTO-TRA = 0                                 
      MOVE ' ' TO UT1-SIGN3                                                     
    ELSE                                                                        
      MOVE '-' TO UT1-SIGN3                                                     
    END-IF                                                                      
    UT1-PRARTNTO-TOT-N  = W-PRARTNTO-TRA-N                                      
    UT1-PRARTNTO-TOT-D  = W-PRARTNTO-TRA-D                                      
    UT1-IDFAKT          = T3-IDFAKT                                             
  END-IF                                                                        
  PRINT REPORT02                                                                
                                                                                
************************************************************************        
*** LIST FOR NON VCC - SENT TO D&P - PART LEVEL                                 
************************************************************************        
  REPORT   REPORT02             +                                               
           PRINTER W5128MD4     +                                               
           LINESIZE 146         +                                               
           SPACE 0              +                                               
           NOHEADING            +                                               
           NOSPREAD             +                                               
           NOADJUST             +                                               
           PAGESIZE 32767       +                                               
           NODATE                                                               
LINE  1  UT1-IDPTYP             +                                               
         W-SEM                  +                                               
         UT1-IDARTNR            +                                               
         W-SEM                  +                                               
         UT1-IDDC               +                                               
         W-SEM                  +                                               
         UT1-IDLEVNR            +                                               
         W-SEM                  +                                               
         UT1-KDPRODSL           +                                               
         W-SEM                  +                                               
         UT1-DAREGDAT           +                                               
         W-SEM                  +                                               
