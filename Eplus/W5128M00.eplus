BEFORE-LINE. PROC                                                               
 IF W-KDTRADP NE W-PREV-KDTRADP1                                                
   DISPLAY '¤DAPW5128MA-001'                                                    
   DISPLAY '¤DAP' W-KDTRADP                                                     
   DISPLAY 'TYPE;PART NO.;DC;SUPPLIER;PRODUCT GRP;DATE;QTY;PRICE; +             
            INVOICE NO; FREIGHT FACTOR;TOTAL PRICE WITH FREIGHT;'               
   W-PREV-KDTRADP1 = W-KDTRADP                                                  
 END-IF                                                                         
END-PROC                                                                        
