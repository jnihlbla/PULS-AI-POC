NEWPAGE                                                                         
FILE W09216D1                                                                   
*                                                                               
%W09211EE  'IN-'                                                                
                                                                                
                                                                                
NEWPAGE                                                                         
FILE W09216DS FB(122 0)                                                         
*                                                                               
%W09211EE  'S-'                                                                 
                                                                                
                                                                                
                                                                                
                                                                                
MS-IDDISTR    10  4 N   MASK 'ZZZ9'                                             
MS-IDKUNDNR   14  6 N   MASK 'ZZZZZ9'                                           
MS-SORTBGP    29  8 N   MASK 'ZZZZZZZ9'                                         
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
NEWPAGE                                                                         
                                                                                
                                                                                
FILE W09216D6  PRINTER FB (121 0)                                               
                                                                                
                                                                                
                                                                                
FILE W09216D8  PRINTER FB (121 0)                                               
                                                                                
                                                                                
FILE W09216D9  PRINTER FB (121 0)                                               
                                                                                
                                                                                
FILE W09216DA  PRINTER FB (121 0)                                               
                                                                                
                                                                                
FILE W09216DB  PRINTER FB (121 0)                                               
                                                                                
                                                                                
NEWPAGE                                                                         
                                                                                
                                                                                
  RAD-FELTEXT      W  75   A                                                    
                                                                                
                                                                                
  R-TYP            W   3   A   VALUE 'TYP'                                      
  R-DIST           W   4   A   VALUE 'DIST'                                     
  R-KUND           W   6   A   VALUE 'KUND  '                                   
  R-C              W   1   A   VALUE 'C'                                        
  R-FK             W   2   A   VALUE 'FK'                                       
  R-ORDER          W   5   A   VALUE 'ORDER'                                    
  R-K              W   1   A   VALUE 'K'                                        
  R-ARTNR          W   8   A   VALUE 'ARTNR   '                                 
  R-FEL            W   3   A   VALUE 'FEL'                                      
  R-FELTEXT        W  75   A   VALUE '     FELTEXT'                             
                                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
  W-DATUM          W   8   A                                                    
                                                                                
  W-AA     W-DATUM     2   A                                                    
  FILLER1  W-DATUM +2  1   A   VALUE '/'                                        
  W-MM     W-DATUM +3  2   A                                                    
  FILLER2  W-DATUM +5  1   A   VALUE '/'                                        
  W-DD     W-DATUM +6  2   A                                                    
                                                                                
                                                                                
                                                                                
                                                                                
                                                                                
  PROGRAMNAMN      W   6   A   VALUE 'W09216'                                   
  DATKORT-ID       W   6   A   VALUE 'WDATUM'                                   
                                                                                
%WDATKORT                                                                       
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
                                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1.  SORT                                                                 
*                                                                               
                                                                                
SORT W09216D1 TO                                                +               
     W09216DS USING (IN-SORTARG, IN-IDDISTR, IN-IDKUNDNR,       +               
                     IN-IDORDNR, IN-KDFRAKT, IN-SORTBGP,  IN-IDPTYP)            
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 2.  JOBB                                                                 
*                                                                               
                                                                                
JOB INPUT W09216DS   START INIT                                                 
                                                                                
                                                                                
  IF W09216DS                                                                   
                                                                                
                                                                                
    RAD-FELTEXT = S-FELTEXT                                                     
                                                                                
                                                                                
                                                                                
    IF S-KDLISTAD = 'OR'                                                        
      PERFORM  B-FELLISTA-TILL-ORDER                                            
    ELSE                                                                        
      PERFORM D-FELLISTA-TILL-PV                                                
    END-IF                                                                      
                                                                                
  END-IF                                                                        
                                                                                
NEWPAGE                                                                         
                                                                                
                                                                                
  INIT.  PROC                                                                   
                                                                                
                                                                                
    CALL DATKORT USING (PROGRAMNAMN DATKORT-ID DATUMKORT)                       
                                                                                
    W-AA  =  D-AAR                                                              
    W-MM  =  D-MAANAD                                                           
    W-DD  =  D-DAG                                                              
                                                                                
                                                                                
  END-PROC                                                                      
                                                                                
                                                                                
NEWPAGE                                                                         
                                                                                
  B-FELLISTA-TILL-ORDER.  PROC                                                  
                                                                                
  IF S-KDLISTSO = 80                                                            
    R-FK        =  '  '                                                         
    R-ORDER     =  'IDENT'                                                      
  ELSE                                                                          
    R-FK        =  'FK'                                                         
    R-ORDER     =  'ORDER'                                                      
  END-IF                                                                        
                                                                                
  IF S-KDLISTSO < 90                                                            
    PRINT    ORDER                                                              
  ELSE                                                                          
    PRINT    ORDER-INFO                                                         
  END-IF                                                                        
                                                                                
                                                                                
                                                                                
  END-PROC                                                                      
                                                                                
                                                                                
NEWPAGE                                                                         
                                                                                
  D-FELLISTA-TILL-PV.     PROC                                                  
                                                                                
  IF  S-KDLISTAD = 'MF'                                                         
                          PERFORM DA-MARKNADSFORING                             
  ELSE                                                                          
  IF  S-KDLISTAD = 'AN'                                                         
                          PERFORM DB-ANSKAFFNING                                
  ELSE                                                                          
  IF  S-KDLISTAD = 'EK'                                                         
                          PERFORM DC-EKONOMI                                    
  ELSE                                                                          
  IF  S-KDLISTAD = 'GM'                                                         
                          PERFORM DD-GODSMOTTAGNING                             
  ELSE                                                                          
                          DISPLAY 'FINNS INGEN MOTTAGAR-ADRESS TILL '           
                          DISPLAY S-W09211                                      
  END-IF                                                                        
  END-IF                                                                        
  END-IF                                                                        
  END-IF                                                                        
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  DA-MARKNADSFORING.      PROC                                                  
                                                                                
  IF (S-IDPTYP = '666', '667')   AND       +                                    
     (S-IDDISTR < 100  OR  S-IDDISTR > 7999)                                    
                    CONTINUE                                                    
  ELSE                                                                          
                                                                                
    IF S-KDLISTSO < 90                                                          
      PRINT PV-MARKNAD                                                          
    ELSE                                                                        
      PRINT PV-MARKNAD-INFO                                                     
    END-IF                                                                      
                                                                                
  END-IF                                                                        
                                                                                
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  DB-ANSKAFFNING.         PROC                                                  
                                                                                
  IF S-KDLISTSO < 90                                                            
    PRINT PV-ANSK                                                               
  ELSE                                                                          
    PRINT PV-ANSK-INFO                                                          
  END-IF                                                                        
                                                                                
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  DC-EKONOMI.             PROC                                                  
                                                                                
  IF S-KDLISTSO < 90                                                            
    PRINT PV-EKO                                                                
  ELSE                                                                          
    PRINT PV-EKO-INFO                                                           
  END-IF                                                                        
                                                                                
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  DD-GODSMOTTAGNING.      PROC                                                  
                                                                                
  IF S-IDPTYP  = 'R77'  OR  S-IDPTYP = 'R78'                                    
    R-FK        =  '  '                                                         
    R-ORDER     =  'IDENT'                                                      
  ELSE                                                                          
    R-FK        =  'FK'                                                         
    R-ORDER     =  'ORDER'                                                      
  END-IF                                                                        
                                                                                
  IF S-KDLISTSO < 90                                                            
    PRINT PV-GODSM                                                              
  ELSE                                                                          
    PRINT PV-GODSM-INFO                                                         
  END-IF                                                                        
                                                                                
                                                                                
                                                                                
  END-PROC                                                                      
                                                                                
