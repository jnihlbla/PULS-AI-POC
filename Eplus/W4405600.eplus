*                                                                               
JA            W 1 A       VALUE 'J'                                             
NEJ           W 1 A       VALUE 'N'                                             
*                                                                               
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
C1-IDARTNR    W 5 P                                                             
C1-IDDC       W 2 A                                                             
C1-RESS       W 4 P 0                                                           
C1-KVRO       W 4 P 0                                                           
C1-SUTPO-PB   W 4 P 0                                                           
C1-SUTPO-EJPB W 4 P 0                                                           
C1-SUTPO-TOT  W 4 P 0                                                           
*                                                                               
BLANKA1  W  8 A                                                                 
BLANKA2  W 15 A                                                                 
DIFF-PB   W  4 P 0                    MASK '------9'                            
DIFF-EJPB W  4 P 0                    MASK '------9'                            
DIFF-TOT  W  4 P 0                    MASK '------9'                            
DIFF-RO   W  4 P 0                    MASK '------9'                            
DIFF-RES  W  4 P 0                    MASK '------9'                            
TEST-IDARTNR  W 5 P                                                             
*                                                                               
PR-RADSALDO-KVRESS      W 4 P 0       MASK 'ZZZZZZ9'                            
PR-RADSALDO-KVROS       W 4 P 0       MASK 'ZZZZZZ9'                            
PR-RADSALDO-SUTPO-PB    W 4 P 0       MASK 'ZZZZZZ9'                            
PR-RADSALDO-SUTPO-EJPB  W 4 P 0       MASK 'ZZZZZZ9'                            
PR-RADSALDO-SUTPO-TOT   W 4 P 0       MASK 'ZZZZZZ9'                            
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
JOB INPUT(NULL)                                                  +              
                                                             NAME AKT01         
*                                                                               
  GET W44056D1                                                                  
  DO WHILE NOT EOF W44056D1                   AND +                             
           J2-SATS-IDDC = CDC-SE                                                
    TEST-IDARTNR  = J2-SATS-IDARTNR                                             
    WDJ2-IDARTNR  = J2-SATS-IDARTNR                                             
    WDJ2-IDDC     = J2-SATS-IDDC                                                
    WDJ2-KVSATRES = 0                                                           
    DO WHILE NOT EOF W44056D1                 AND +                             
             J2-SATS-IDDC     = CDC-SE        AND +                             
             J2-SATS-IDARTNR  = TEST-IDARTNR                                    
      WDJ2-KVSATRES = WDJ2-KVSATRES + J2-SATS-KVSATRES                          
      GET W44056D1                                                              
    END-DO                                                                      
    PUT WDJ2                                                                    
  END-DO                                                                        
NEWPAGE                                                                         
                                                                                
  GET W44056D6                                                                  
  DO WHILE NOT EOF W44056D6                   AND +                             
           Q4-IDDC = CDC-SE                                                     
    TEST-IDARTNR     = Q4-IDARTNR                                               
    WDQ4-IDARTNR     = Q4-IDARTNR                                               
    WDQ4-IDDC        = Q4-IDDC                                                  
    WDQ4-KVBEART-Q   = 0                                                        
    DO WHILE NOT EOF W44056D6                 AND +                             
             Q4-IDDC     = CDC-SE             AND +                             
             Q4-IDARTNR  = TEST-IDARTNR                                         
      WDQ4-KVBEART-Q = WDQ4-KVBEART-Q + Q4-KVBEART-Q                            
      GET W44056D6                                                              
    END-DO                                                                      
    PUT WDQ4                                                                    
  END-DO                                                                        
NEWPAGE                                                                         
                                                                                
  GET W44056D7                                                                  
  DO WHILE NOT EOF W44056D7              AND +                                  
           Q1-IDDC = CDC-SE                                                     
    TEST-IDARTNR     = Q1-IDARTNR                                               
    WDQ1-IDARTNR     = Q1-IDARTNR                                               
    WDQ1-IDDC        = Q1-IDDC                                                  
    WDQ1-KVBEART-Q   = 0                                                        
    DO WHILE NOT EOF W44056D7            AND +                                  
             Q1-IDDC     = '11'          AND +                                  
             Q1-IDARTNR  = TEST-IDARTNR                                         
      WDQ1-KVBEART-Q = WDQ1-KVBEART-Q + Q1-KVBEART-Q                            
      GET W44056D7                                                              
    END-DO                                                                      
    PUT WDQ1                                                                    
  END-DO                                                                        
NEWPAGE                                                                         
                                                                                
  GET W44056D3                                                                  
  DO WHILE NOT EOF W44056D3                   AND +                             
           M2-KAMP-IDDC = CDC-SE                                                
    TEST-IDARTNR        = M2-KAMP-IDARTNR                                       
    WDM2-IDARTNR        = M2-KAMP-IDARTNR                                       
    WDM2-IDDC           = M2-KAMP-IDDC                                          
    WDM2-KVBEART-KAMP   = 0                                                     
    WDM2-KVRESS-ART     = 0                                                     
    DO WHILE NOT EOF W44056D3                 AND +                             
             M2-KAMP-IDDC     = CDC-SE        AND +                             
             M2-KAMP-IDARTNR  = TEST-IDARTNR                                    
      WDM2-KVBEART-KAMP = WDM2-KVBEART-KAMP + M2-KAMP-KVBEART-KAMP              
      WDM2-KVRESS-ART   = WDM2-KVRESS-ART   + M2-KAMP-KVRESS-ART                
      GET W44056D3                                                              
    END-DO                                                                      
    PUT WDM2                                                                    
  END-DO                                                                        
NEWPAGE                                                                         
                                                                                
  GET W44056D5                                                                  
                                                                                
  DO WHILE NOT EOF W44056D5              AND +                                  
           A5-RAD-IDDC NE CDC-SE                                                
    GET W44056D5                                                                
  END-DO                                                                        
                                                                                
  DO WHILE NOT EOF W44056D5              AND +                                  
           A5-RAD-IDDC = CDC-SE                                                 
    C1-IDARTNR    = A5-RAD-IDARTNR                                              
    C1-IDDC       = A5-RAD-IDDC                                                 
    C1-KVRO       = 0                                                           
    C1-SUTPO-TOT  = 0                                                           
    C1-SUTPO-PB   = 0                                                           
    C1-SUTPO-EJPB = 0                                                           
    C1-RESS       = 0                                                           
    TEST-IDARTNR  = A5-RAD-IDARTNR                                              
    DO WHILE NOT EOF W44056D5               AND +                               
             A5-RAD-IDDC     = CDC-SE       AND +                               
             A5-RAD-IDARTNR  = TEST-IDARTNR                                     
                                                                                
      IF A5-RAD-KDSTARAD  = '1'             AND +                               
         A5-RAD-FLTPOBEK  = 'J'             AND +                               
         A5-RAD-KDTPOTYP NE 4                                                   
        C1-SUTPO-TOT    = C1-SUTPO-TOT  + A5-RAD-KVART                          
        IF A5-RAD-KDTPOTYP = 1 2                                                
          C1-SUTPO-PB   = C1-SUTPO-PB   + A5-RAD-KVART                          
        ELSE                                                                    
          C1-SUTPO-EJPB = C1-SUTPO-EJPB + A5-RAD-KVART                          
        END-IF                                                                  
      END-IF                                                                    
      IF A5-RAD-KDSTARAD = '2'                                                  
        C1-KVRO = C1-KVRO + A5-RAD-KVART                                        
      END-IF                                                                    
      IF A5-RAD-KDSTARAD = '3'     AND +                                        
         A5-RAD-DARODAT > 0                                                     
         C1-RESS = C1-RESS + A5-RAD-KVART                                       
      END-IF                                                                    
      GET W44056D5                                                              
    END-DO                                                                      
                                                                                
    WDA5-IDARTNR    = C1-IDARTNR                                                
    WDA5-IDDC       = C1-IDDC                                                   
    WDA5-KVRO       = C1-KVRO                                                   
    WDA5-SUTPO-PB   = C1-SUTPO-PB                                               
    WDA5-SUTPO-EJPB = C1-SUTPO-EJPB                                             
    WDA5-SUTPO-TOT  = C1-SUTPO-TOT                                              
    WDA5-RESS       = C1-RESS                                                   
                                                                                
    IF WDA5-KVRO       = 0  AND                                  +              
       WDA5-SUTPO-PB   = 0  AND                                  +              
       WDA5-SUTPO-EJPB = 0  AND                                  +              
       WDA5-SUTPO-TOT  = 0  AND                                  +              
       WDA5-RESS       = 0                                                      
    ELSE                                                                        
      PUT WDA5                                                                  
    END-IF                                                                      
                                                                                
  END-DO                                                                        
                                                                                
  STOP                                                                          
NEWPAGE                                                                         
JOB INPUT(WDJ2  KEY (WDJ2-IDDC    WDJ2-IDARTNR)                 +               
          WDQ4  KEY (WDQ4-IDDC    WDQ4-IDARTNR)                 +               
          WDQ1  KEY (WDQ1-IDDC    WDQ1-IDARTNR))                +               
                                                             NAME AKT02         
     IF MATCHED                                                                 
       J2Q4Q1-IDARTNR  = WDJ2-IDARTNR                                           
       J2Q4Q1-IDDC     = WDJ2-IDDC                                              
       J2Q4Q1-KVSATRES = WDJ2-KVSATRES + WDQ4-KVBEART-Q +                       
                                       + WDQ1-KVBEART-Q                         
       PUT J2Q4Q1                                                               
     ELSE                                                                       
     IF MATCHED WDJ2 WDQ4                                                       
         J2Q4Q1-IDARTNR  = WDJ2-IDARTNR                                         
         J2Q4Q1-IDDC     = WDJ2-IDDC                                            
         J2Q4Q1-KVSATRES = WDJ2-KVSATRES + WDQ4-KVBEART-Q                       
         PUT J2Q4Q1                                                             
       ELSE                                                                     
         IF MATCHED WDQ4 WDQ1                                                   
           J2Q4Q1-IDARTNR  = WDQ4-IDARTNR                                       
           J2Q4Q1-IDDC     = WDQ4-IDDC                                          
           J2Q4Q1-KVSATRES = WDQ4-KVBEART-Q + WDQ1-KVBEART-Q                    
           PUT J2Q4Q1                                                           
         ELSE                                                                   
           IF MATCHED WDJ2 WDQ1                                                 
             J2Q4Q1-IDARTNR  = WDJ2-IDARTNR                                     
             J2Q4Q1-IDDC     = WDJ2-IDDC                                        
             J2Q4Q1-KVSATRES = WDJ2-KVSATRES + WDQ1-KVBEART-Q                   
             PUT J2Q4Q1                                                         
           ELSE                                                                 
             IF WDJ2                                                            
               J2Q4Q1-IDARTNR  = WDJ2-IDARTNR                                   
               J2Q4Q1-IDDC     = WDJ2-IDDC                                      
               J2Q4Q1-KVSATRES = WDJ2-KVSATRES                                  
               PUT J2Q4Q1                                                       
             ELSE                                                               
               IF WDQ4                                                          
                 J2Q4Q1-IDARTNR  = WDQ4-IDARTNR                                 
                 J2Q4Q1-IDDC     = WDQ4-IDDC                                    
                 J2Q4Q1-KVSATRES = WDQ4-KVBEART-Q                               
                 PUT J2Q4Q1                                                     
               ELSE                                                             
                 IF WDQ1                                                        
                   J2Q4Q1-IDARTNR  = WDQ1-IDARTNR                               
                   J2Q4Q1-IDDC     = WDQ1-IDDC                                  
                   J2Q4Q1-KVSATRES = WDQ1-KVBEART-Q                             
                   PUT J2Q4Q1                                                   
                 END-IF                                                         
               END-IF                                                           
             END-IF                                                             
           END-IF                                                               
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
NEWPAGE                                                                         
JOB INPUT (J2Q4Q1  KEY (J2Q4Q1-IDDC    J2Q4Q1-IDARTNR)          +               
           WDM2    KEY (  WDM2-IDDC      WDM2-IDARTNR))         +               
                                                             NAME AKT03         
     IF MATCHED                                                                 
       J2Q4Q1M2-IDARTNR         = J2Q4Q1-IDARTNR                                
       J2Q4Q1M2-IDDC            = J2Q4Q1-IDDC                                   
       J2Q4Q1M2-KVSATRES        = J2Q4Q1-KVSATRES + WDM2-KVRESS-ART             
       J2Q4Q1M2-KVBEART-KAMP    = WDM2-KVBEART-KAMP                             
       PUT J2Q4Q1M2                                                             
     ELSE                                                                       
       IF J2Q4Q1                                                                
         J2Q4Q1M2-IDARTNR         = J2Q4Q1-IDARTNR                              
         J2Q4Q1M2-IDDC            = J2Q4Q1-IDDC                                 
         J2Q4Q1M2-KVSATRES        = J2Q4Q1-KVSATRES                             
         J2Q4Q1M2-KVBEART-KAMP    = 0                                           
         PUT J2Q4Q1M2                                                           
       ELSE                                                                     
         IF WDM2                                                                
           J2Q4Q1M2-IDARTNR         = WDM2-IDARTNR                              
           J2Q4Q1M2-IDDC            = WDM2-IDDC                                 
           J2Q4Q1M2-KVSATRES        = WDM2-KVRESS-ART                           
           J2Q4Q1M2-KVBEART-KAMP    = WDM2-KVBEART-KAMP                         
           PUT J2Q4Q1M2                                                         
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
NEWPAGE                                                                         
JOB INPUT (J2Q4Q1M2 KEY (J2Q4Q1M2-IDDC    J2Q4Q1M2-IDARTNR)     +               
           WDA5     KEY (    WDA5-IDDC        WDA5-IDARTNR))    +               
                                                             NAME AKT04         
     IF MATCHED                                                                 
       RADSALDO-IDARTNR    = J2Q4Q1M2-IDARTNR                                   
       RADSALDO-IDDC       = J2Q4Q1M2-IDDC                                      
       RADSALDO-KVRESS     = J2Q4Q1M2-KVSATRES + WDA5-RESS                      
       RADSALDO-KVROS      = WDA5-KVRO                                          
       RADSALDO-SUTPO-PB   = WDA5-SUTPO-PB                                      
       RADSALDO-SUTPO-EJPB = WDA5-SUTPO-EJPB   + J2Q4Q1M2-KVBEART-KAMP          
       RADSALDO-SUTPO-TOT  = RADSALDO-SUTPO-PB + RADSALDO-SUTPO-EJPB            
       PUT RADSALDO                                                             
     ELSE                                                                       
       IF J2Q4Q1M2                                                              
         RADSALDO-IDARTNR    = J2Q4Q1M2-IDARTNR                                 
         RADSALDO-IDDC       = J2Q4Q1M2-IDDC                                    
         RADSALDO-KVRESS     = J2Q4Q1M2-KVSATRES                                
         RADSALDO-KVROS      = 0                                                
         RADSALDO-SUTPO-PB   = 0                                                
         RADSALDO-SUTPO-EJPB = J2Q4Q1M2-KVBEART-KAMP                            
         RADSALDO-SUTPO-TOT  = RADSALDO-SUTPO-PB + RADSALDO-SUTPO-EJPB          
         PUT RADSALDO                                                           
       ELSE                                                                     
         IF WDA5                                                                
          IF WDA5-IDDC = '11'                                                   
           RADSALDO-IDARTNR    = WDA5-IDARTNR                                   
           RADSALDO-IDDC       = WDA5-IDDC                                      
           RADSALDO-KVRESS     = WDA5-RESS                                      
           RADSALDO-KVROS      = WDA5-KVRO                                      
           RADSALDO-SUTPO-PB   = WDA5-SUTPO-PB                                  
           RADSALDO-SUTPO-EJPB = WDA5-SUTPO-EJPB                                
           RADSALDO-SUTPO-TOT  = RADSALDO-SUTPO-PB + RADSALDO-SUTPO-EJPB        
           PUT RADSALDO                                                         
          END-IF                                                                
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
NEWPAGE                                                                         
JOB INPUT (W44056D4 KEY (K6-ART-IDDC    K6-ART-IDARTNR)         +               
           W44056D2 KEY (K9-ART-IDDC    K9-ART-IDARTNR))        +               
                                                             NAME AKT05         
  IF MATCHED                                                                    
    IF K6-ART-IDDC = CDC-SE                                                     
      ARTSALDO-IDARTNR    = K6-ART-IDARTNR                                      
      ARTSALDO-IDDC       = K6-ART-IDDC                                         
      ARTSALDO-KVRESS     = K6-ART-KVRESS                                       
      ARTSALDO-KVROS      = K6-ART-KVROS                                        
      ARTSALDO-SUTPO-TOT  = K9-ART-SUTPO-TOT                                    
      ARTSALDO-SUTPO-PB   = K9-ART-SUTPO-PB                                     
      ARTSALDO-SUTPO-EJPB = K9-ART-SUTPO-EJPB                                   
      PUT ARTSALDO                                                              
    END-IF                                                                      
  ELSE                                                                          
    IF W44056D4                                                                 
      IF K6-ART-IDDC = CDC-SE                                                   
        ARTSALDO-IDARTNR    = K6-ART-IDARTNR                                    
        ARTSALDO-IDDC       = K6-ART-IDDC                                       
        ARTSALDO-KVRESS     = K6-ART-KVRESS                                     
        ARTSALDO-KVROS      = K6-ART-KVROS                                      
        ARTSALDO-SUTPO-TOT  = 0                                                 
        ARTSALDO-SUTPO-PB   = 0                                                 
        ARTSALDO-SUTPO-EJPB = 0                                                 
        PUT ARTSALDO                                                            
      END-IF                                                                    
    ELSE                                                                        
      IF W44056D2                                                               
        IF K9-ART-IDDC = CDC-SE                                                 
          ARTSALDO-IDARTNR    = K9-ART-IDARTNR                                  
          ARTSALDO-IDDC       = K9-ART-IDDC                                     
          ARTSALDO-KVRESS     = 0                                               
          ARTSALDO-KVROS      = 0                                               
          ARTSALDO-SUTPO-TOT  = K9-ART-SUTPO-TOT                                
          ARTSALDO-SUTPO-PB   = K9-ART-SUTPO-PB                                 
          ARTSALDO-SUTPO-EJPB = K9-ART-SUTPO-EJPB                               
          PUT ARTSALDO                                                          
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
                                                                                
NEWPAGE                                                                         
JOB INPUT (ARTSALDO KEY (ARTSALDO-IDDC                          +               
                         ARTSALDO-IDARTNR)                      +               
           RADSALDO KEY (RADSALDO-IDDC                          +               
                         RADSALDO-IDARTNR))                     +               
                                                             NAME AKT06         
   IF MATCHED                                                                   
     IF ARTSALDO-KVRESS     NE RADSALDO-KVRESS     OR            +              
        ARTSALDO-KVROS      NE RADSALDO-KVROS      OR            +              
        ARTSALDO-SUTPO-PB   NE RADSALDO-SUTPO-PB   OR            +              
        ARTSALDO-SUTPO-EJPB NE RADSALDO-SUTPO-EJPB OR            +              
        ARTSALDO-SUTPO-TOT  NE RADSALDO-SUTPO-TOT                               
       DIFF-RES  = ARTSALDO-KVRESS     - RADSALDO-KVRESS                        
       DIFF-RO   = ARTSALDO-KVROS      - RADSALDO-KVROS                         
       DIFF-PB   = ARTSALDO-SUTPO-PB   - RADSALDO-SUTPO-PB                      
       DIFF-EJPB = ARTSALDO-SUTPO-EJPB - RADSALDO-SUTPO-EJPB                    
       DIFF-TOT  = ARTSALDO-SUTPO-TOT  - RADSALDO-SUTPO-TOT                     
       IF DIFF-RES  =  0                           AND           +              
          DIFF-RO   =  0                           AND           +              
          DIFF-PB   =  0                           AND           +              
          DIFF-EJPB NE 0                           AND           +              
          DIFF-EJPB =  ARTSALDO-SUTPO-TOT - RADSALDO-SUTPO-TOT                  
       ELSE                                                                     
         PERFORM SKRIV-FELFIL                                                   
         PR-RADSALDO-SUTPO-PB   = RADSALDO-SUTPO-PB                             
         PR-RADSALDO-SUTPO-EJPB = RADSALDO-SUTPO-EJPB                           
         PR-RADSALDO-SUTPO-TOT  = RADSALDO-SUTPO-TOT                            
         PR-RADSALDO-KVROS      = RADSALDO-KVROS                                
         PR-RADSALDO-KVRESS     = RADSALDO-KVRESS                               
         PRINT FELLISTA                                                         
       END-IF                                                                   
     END-IF                                                                     
   ELSE                                                                         
     IF ARTSALDO                                                                
       IF ARTSALDO-KVRESS     NE 0          OR                   +              
          ARTSALDO-KVROS      NE 0          OR                   +              
          ARTSALDO-SUTPO-PB   NE 0          OR                   +              
          ARTSALDO-SUTPO-EJPB NE 0          OR                   +              
          ARTSALDO-SUTPO-TOT  NE 0                                              
         DIFF-RES  = ARTSALDO-KVRESS                                            
         DIFF-RO   = ARTSALDO-KVROS                                             
         DIFF-PB   = ARTSALDO-SUTPO-PB                                          
         DIFF-EJPB = ARTSALDO-SUTPO-EJPB                                        
         DIFF-TOT  = ARTSALDO-SUTPO-TOT                                         
         IF DIFF-RES  =  0                  AND                  +              
            DIFF-RO   =  0                  AND                  +              
            DIFF-PB   =  0                  AND                  +              
            DIFF-EJPB NE 0                  AND                  +              
            DIFF-EJPB =  ARTSALDO-SUTPO-TOT                                     
         ELSE                                                                   
           PERFORM SKRIV-FELFIL                                                 
           PR-RADSALDO-SUTPO-PB   = 0                                           
           PR-RADSALDO-SUTPO-EJPB = 0                                           
           PR-RADSALDO-SUTPO-TOT  = 0                                           
           PR-RADSALDO-KVROS      = 0                                           
           PR-RADSALDO-KVRESS     = 0                                           
           PRINT FELLISTA                                                       
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
   END-IF                                                                       
                                                                                
NEWPAGE                                                                         
                                                                                
SKRIV-FELFIL. PROC                                                              
                                                                                
       UT-IDARTNR   = ARTSALDO-IDARTNR                                          
       UT-IDDC      = ARTSALDO-IDDC                                             
       IF DIFF-RES NE 0                                                         
         IF  DIFF-RES < 0                                                       
           UT-KDMETOD  = 'ADD'                                                  
         ELSE                                                                   
           UT-KDMETOD  = 'SUB'                                                  
         END-IF                                                                 
         UT-TIBEHOV    = 0                                                      
         UT-IDDB       = '611   '                                               
         UT-KVANTAL    = DIFF-RES                                               
         UT-IDSALDO    = 'KVRESS       '                                        
         PUT W44056D9                                                           
       END-IF                                                                   
                                                                                
       IF DIFF-RO NE 0                                                          
         IF  DIFF-RO < 0                                                        
           UT-KDMETOD   = 'ADD'                                                 
         ELSE                                                                   
           UT-KDMETOD   = 'SUB'                                                 
         END-IF                                                                 
         UT-TIBEHOV     = 0                                                     
         UT-IDDB        = '611   '                                              
         UT-KVANTAL     = DIFF-RO                                               
         UT-IDSALDO     = 'KVROS        '                                       
         PUT W44056D9                                                           
       END-IF                                                                   
                                                                                
       IF DIFF-PB NE 0                                                          
         IF  DIFF-PB < 0                                                        
           UT-KDMETOD = 'ADD '                                                  
         ELSE                                                                   
           UT-KDMETOD = 'SUB'                                                   
         END-IF                                                                 
         UT-TIBEHOV     = 99999                                                 
         UT-IDDB        = '911   '                                              
         UT-KVANTAL   = DIFF-PB                                                 
         UT-IDSALDO   = 'SUTPO-PB     '                                         
         PUT W44056D9                                                           
       END-IF                                                                   
                                                                                
       IF DIFF-EJPB NE 0                                                        
         IF  DIFF-EJPB < 0                                                      
           UT-KDMETOD = 'ADD'                                                   
         ELSE                                                                   
           UT-KDMETOD = 'SUB'                                                   
         END-IF                                                                 
         UT-IDDB        = '911   '                                              
         UT-TIBEHOV     = 99999                                                 
         UT-KVANTAL   = DIFF-EJPB                                               
         UT-IDSALDO  = 'SUTPO-EJPB   '                                          
         PUT W44056D9                                                           
       END-IF                                                                   
                                                                                
       IF DIFF-TOT NE 0                                                         
         IF  DIFF-TOT < 0                                                       
           UT-KDMETOD = 'ADD'                                                   
         ELSE                                                                   
           UT-KDMETOD = 'SUB'                                                   
         END-IF                                                                 
         UT-TIBEHOV     = 0                                                     
         UT-IDDB        = '901   '                                              
         UT-KVANTAL   = DIFF-TOT                                                
         UT-IDSALDO   = 'SUTPO-TOT    '                                         
         PUT W44056D9                                                           
       END-IF                                                                   
     END-PROC                                                                   
NEWPAGE                                                                         
*                                                                               
  REPORT FELLISTA   +                                                           
         LINESIZE 120 SPACE 1 PRINTER W44056D8                                  
*                                                                               
    TITLE 1 'W4405600 - DIFFERENS ARTIKELREGISTER-RESTORDERREGISTER'            
    TITLE 2 'ARTIKELSALDO RELATIVT RADSUMMOR'                                   
    TITLE 4 BLANKA1 'ARTIKELREGISTREN' BLANKA2 'RESTORDERREGISTREN'             
*                                                                               
    HEADING ARTSALDO-IDARTNR            'ARTNR'                                 
    HEADING ARTSALDO-IDDC               'CL'                                    
    HEADING DIFF-PB                     'TPO-PB'                                
    HEADING DIFF-EJPB                   'TPO-EJPB'                              
    HEADING DIFF-TOT                    'TPO-TOT'                               
    HEADING DIFF-RO                     'RO'                                    
    HEADING DIFF-RES                    'RESS'                                  
    HEADING PR-RADSALDO-KVRESS          'RESS'                                  
    HEADING PR-RADSALDO-KVROS           'RO'                                    
    HEADING PR-RADSALDO-SUTPO-PB        'SUM-PB'                                
    HEADING PR-RADSALDO-SUTPO-EJPB      'SUM-EJPB'                              
    HEADING PR-RADSALDO-SUTPO-TOT       'SUM-TOT'                               
*                                                                               
    LINE  1                                                      +              
            ARTSALDO-IDARTNR                                     +              
            ARTSALDO-IDDC                                        +              
            DIFF-PB                                              +              
            DIFF-EJPB                                            +              
            DIFF-TOT                                             +              
            DIFF-RO                                              +              
            DIFF-RES                                             +              
            PR-RADSALDO-SUTPO-PB                                 +              
            PR-RADSALDO-SUTPO-EJPB                               +              
            PR-RADSALDO-SUTPO-TOT                                +              
            PR-RADSALDO-KVROS                                    +              
            PR-RADSALDO-KVRESS                                                  
*                                                                               
NEWPAGE                                                                         
