***************************************************                             
* SORTAR UTFILEN PÅ DC                            *                             
***************************************************                             
SORT W51355DW TO W51355DW USING (UT-IDDC)                                       
***************************************************                             
NEWPAGE                                                                         
                                                                                
SORT TEMPFIL1 TO TEMPFIL1 USING (T1-IDDC, T1-IDARTNR)                           
JOB INPUT TEMPFIL1                                                              
                                                                                
    W-IDARTNR-E   = T1-IDARTNR                                                  
    W-BEART       = T1-BEART                                                    
    W-ADJ-DATE    = T1-ADJ-DATE                                                 
    W-ADLAGOMR-E  = T1-ADLAGOMR                                                 
    W-ADJ-QTY     = T1-ADJ-QTY                                                  
    W-VAL-U       = T1-VAL-U                                                    
    W-VAL-D       = T1-VAL-D                                                    
    W-VAL-T       = T1-VAL-T                                                    
    W-KDPRODSL-E  = T1-KDPRODSL                                                 
    PRINT RAPPORT4X                                                             
                                                                                
************************************************************************        
*** LIST FOR NDC-US DC 4X - SENT TO D&P                                         
************************************************************************        
REPORT   RAPPORT4X            +                                                 
         PRINTER W51355DA     +                                                 
         LINESIZE 120         +                                                 
         SPACE 0              +                                                 
         NOHEADING            +                                                 
         NOSPREAD             +                                                 
         NOADJUST             +                                                 
         PAGESIZE 32767       +                                                 
         NODATE                                                                 
LINE  1  W-IDARTNR-E          +                                                 
         W-SEM                +                                                 
         W-BEART              +                                                 
         W-SEM                +                                                 
         W-ADJ-DATE           +                                                 
         W-SEM                +                                                 
         W-ADLAGOMR-E         +                                                 
         W-SEM                +                                                 
         W-ADJ-QTY            +                                                 
         W-SEM                +                                                 
         W-VAL-U              +                                                 
         W-SEM                +                                                 
         W-VAL-D              +                                                 
         W-SEM                +                                                 
         W-VAL-T              +                                                 
         W-SEM                +                                                 
         W-KDPRODSL-E                                                           
*                                                                               
BEFORE-LINE. PROC                                                               
 IF T1-IDDC NE W-PREV-IDDC                                                      
   DISPLAY '¤DAPWEEKLY-ADJ>5000'                                                
   DISPLAY '¤DAP' T1-IDDC                                                       
   DISPLAY 'PARTNO;DESCRIPTION;ADJ. DATE;AREA;ADJ.QTY;' +                       
           'UP ADJUST;DOWN ADJUST;NET;PCODE;'                                   
   W-PREV-IDDC = T1-IDDC                                                        
 END-IF                                                                         
END-PROC                                                                        
