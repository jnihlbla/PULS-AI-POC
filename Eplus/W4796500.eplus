*******************************************************************             
* W4796500                                                        *             
* SORTERAR OCH MATCHAR W01184(NDC OCH LDC) MED FAKTRAD            *             
* SKRIVER W47965A,                                                *             
*                                                                 *             
* ÄNDRING:                                                        *             
*                                                                 *             
*******************************************************************             
FILE W47965D1                                                                   
%W01184   'LB-'                                                                 
NEWPAGE                                                                         
*                                                                               
FILE W47965D2                                                                   
%W479055  'FR-'                                                                 
NEWPAGE                                                                         
*                                                                               
FILE W47965D3 FB (182 0)                                                        
%W47965A  '65A-'                                                                
NEWPAGE                                                                         
*                                                                               
JOB INPUT (W47965D1 KEY (LB-SLAG-IDDC     +                                     
                         LB-SLAG-IDARTNR) +                                     
           W47965D2 KEY (FR-IDDC-LEV      +                                     
                         FR-IDARTNR))                                           
                                                                                
IF MATCHED                                                                      
   65A-W47965A  = FR-W479055                                                    
   65A-PRAVCOST = LB-SLAG-PRAVCOST                                              
   PUT W47965D3                                                                 
ELSE                                                                            
   IF W47965D2                                                                  
      65A-W47965A  = FR-W479055                                                 
      65A-PRAVCOST = 0                                                          
      PUT W47965D3                                                              
   END-IF                                                                       
END-IF                                                                          
*                                                                               
