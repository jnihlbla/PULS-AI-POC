                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W3354700                                              *        
*                                                                      *        
*  FUNCTION   :  MATCHAR ARTINFO W33539 MED W33588 OCH BYTER UT        *        
*                SJÄLVKOST MOT NY MÅNADS SJÄLVKOST OCH SKRIVER UT PÅ   *        
*                FIL W33547.                                           *        
*                                                                      *        
*  WRITER     :  ELEONOR ÖSTRÖM                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W33547D1                                                                   
%W33589   'PRIS-'                                                               
                                                                                
NEWPAGE                                                                         
FILE W33547D2                                                                   
%W33539   'IN-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W33547D3 FB (910 0)                                                        
%W33539   'UT-'                                                                 
                                                                                
NEWPAGE                                                                         
PROGRAM-NAMN      W   6   A   VALUE 'W33547'                                    
                                                                                
*                                                                               
NEWPAGE                                                                         
************************************************************                    
* STEP 1. MATCHAR W33588 MED W33539 OCH BYTER UT SJÄLVKOST *                    
*         MOT NY MÅNADS-SJÄLVKOST                          *                    
************************************************************                    
*                                                                               
JOB INPUT (W33547D2 KEY(IN-IDARTNR)                                    +        
           W33547D1 KEY(PRIS-IDARTNR))                                          
                                                                                
    IF MATCHED                                                                  
      UT-W33539          = IN-W33539                                            
      UT-PRARTSJK        = PRIS-PRARTSJK                                        
      PUT W33547D3                                                              
    ELSE                                                                        
      IF W33547D2                                                               
        PUT W33547D3 FROM W33547D2                                              
      END-IF                                                                    
    END-IF                                                                      
                                                                                
