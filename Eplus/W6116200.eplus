JOB INPUT (W61162D1) FINISH Z-FINIT                                             
                                                                                
                                                                                
    WS-IDOKOLLI              =  IN-IDOKOLLI                                     
    WS-IDLEVNR-KOLLI         =  IN-IDLEVNR-KOLLI                                
    WS-IDLOPNRM              =  IN-IDLOPNRM                                     
    WS-IDARTNR               =  IN-IDARTNR                                      
    WS-KVINLART              =  IN-KVINLART                                     
    WS-ADLAGOMR              =  IN-ADLAGOMR                                     
    WS-ADGANG                =  IN-ADGANG                                       
    WS-ADPLATS               =  IN-ADPLATS                                      
    WS-FLKVAFEL              =  IN-FLKVAFEL                                     
                                                                                
    IF IN-FLKVAFEL = 'N'                                                        
      PRINT RAPPORT01                                                           
    ELSE                                                                        
      PRINT RAPPORT02                                                           
    END-IF                                                                      
                                                                                
Z-FINIT. PROC                                                                   
    IF RECORD-COUNT = +0                                                        
      PRINT RAPPORT03                                                           
    END-IF                                                                      
END-PROC                                                                        
