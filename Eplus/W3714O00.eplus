*****************************************************************               
*                                                               *               
* STEG 2  SORTERA BYTESUPPFÖLJNING DC DISTR RAPPNR              *               
*                                                               *               
*****************************************************************               
                                                                                
SORT W3714OD1 TO TPFIL1 USING (IN-IDDC IN-IDDISTR IN-IDBYTRAP)                  
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* STEG 4  LÄSER  W3714OD1                                       *               
*                                                               *               
*****************************************************************               
                                                                                
JOB INPUT(TPFIL1)           START  A-INIT   +                                   
                              FINISH Z-SLUT                                     
*                             NAMN   STEG01                                     
   IF FORSTA-POST EQ 'J'                                                        
     W-IDDC  = T-IDDC                                                           
     UT-POST EQ W-RUB1                                                          
     PUT W3714OD3                                                               
     UT-POST EQ W-RUB2                                                          
     PUT W3714OD3                                                               
     UT-POST EQ  ' '                                                            
     FORSTA-POST EQ 'N'                                                         
   END-IF                                                                       
                                                                                
   IF W-IDDC NE T-IDDC                                                          
      W-IDDC  = T-IDDC                                                          
      W-ANTAL = 6                                                               
   END-IF                                                                       
                                                                                
   IF W-ANTAL > 5                                                               
      PERFORM D-LAGRA                                                           
      PERFORM C-SKRIV-RAD                                                       
      PERFORM B-NOLLA                                                           
   ELSE                                                                         
      PERFORM D-LAGRA                                                           
      W-ANTAL = W-ANTAL + 1                                                     
   END-IF                                                                       
*                                                                               
A-INIT.   PROC                                                                  
   W-IDDC  = T-IDDC                                                             
   FORSTA-POST EQ 'J'                                                           
   PERFORM B-NOLLA                                                              
END-PROC                                                                        
*                                                                               
B-NOLLA.  PROC                                                                  
   W-IDDISTR-1  = 0                                                             
   W-IDDISTR-2  = 0                                                             
   W-IDDISTR-3  = 0                                                             
   W-IDDISTR-4  = 0                                                             
   W-IDDISTR-5  = 0                                                             
   W-IDDISTR-6  = 0                                                             
   W-IDBYTRAP-1 = 0                                                             
   W-IDBYTRAP-2 = 0                                                             
   W-IDBYTRAP-3 = 0                                                             
   W-IDBYTRAP-4 = 0                                                             
   W-IDBYTRAP-5 = 0                                                             
   W-IDBYTRAP-6 = 0                                                             
   W-ANTAL      = 1                                                             
   UT-POST EQ  ' '                                                              
END-PROC                                                                        
*                                                                               
C-SKRIV-RAD.  PROC                                                              
   IF T-IDDC = SDC-NL-ET                                                        
*     PRINT LISTA91                                                             
      UT-POST EQ UT4O-W3714O                                                    
      PUT W3714OD3                                                              
   END-IF                                                                       
*  IF T-IDDC = CDC-SE                                                           
*     PRINT LISTA11                                                             
*  END-IF                                                                       
END-PROC                                                                        
*                                                                               
D-LAGRA.   PROC                                                                 
   IF W-ANTAL = 1                                                               
      W-IDDISTR-1   = T-IDDISTR                                                 
      UT4O-IDDISTR-1   = T-IDDISTR                                              
      UT4O-SEMI-1   = ';'                                                       
      W-IDBYTRAP-1  = T-IDBYTRAP                                                
      UT4O-IDBYTRAP-1  = T-IDBYTRAP                                             
      UT4O-SEMI-2   = ';'                                                       
   END-IF                                                                       
   IF W-ANTAL = 2                                                               
      W-IDDISTR-2   = T-IDDISTR                                                 
      UT4O-IDDISTR-2   = T-IDDISTR                                              
      UT4O-SEMI-3   = ';'                                                       
      W-IDBYTRAP-2  = T-IDBYTRAP                                                
      UT4O-IDBYTRAP-2  = T-IDBYTRAP                                             
      UT4O-SEMI-4   = ';'                                                       
   END-IF                                                                       
   IF W-ANTAL = 3                                                               
      W-IDDISTR-3   = T-IDDISTR                                                 
      UT4O-IDDISTR-3   = T-IDDISTR                                              
      UT4O-SEMI-5   = ';'                                                       
      W-IDBYTRAP-3  = T-IDBYTRAP                                                
      UT4O-IDBYTRAP-3  = T-IDBYTRAP                                             
      UT4O-SEMI-6   = ';'                                                       
   END-IF                                                                       
   IF W-ANTAL = 4                                                               
      W-IDDISTR-4   = T-IDDISTR                                                 
      UT4O-IDDISTR-4   = T-IDDISTR                                              
      UT4O-SEMI-7   = ';'                                                       
      W-IDBYTRAP-4  = T-IDBYTRAP                                                
      UT4O-IDBYTRAP-4  = T-IDBYTRAP                                             
      UT4O-SEMI-8   = ';'                                                       
   END-IF                                                                       
   IF W-ANTAL = 5                                                               
      W-IDDISTR-5   = T-IDDISTR                                                 
      UT4O-IDDISTR-5   = T-IDDISTR                                              
      UT4O-SEMI-9   = ';'                                                       
      W-IDBYTRAP-5  = T-IDBYTRAP                                                
      UT4O-IDBYTRAP-5  = T-IDBYTRAP                                             
      UT4O-SEMI-10  = ';'                                                       
   END-IF                                                                       
   IF W-ANTAL = 6                                                               
      W-IDDISTR-6   = T-IDDISTR                                                 
      UT4O-IDDISTR-6   = T-IDDISTR                                              
      UT4O-SEMI-11  = ';'                                                       
      W-IDBYTRAP-6  = T-IDBYTRAP                                                
      UT4O-IDBYTRAP-6  = T-IDBYTRAP                                             
   END-IF                                                                       
 END-PROC                                                                       
*                                                                               
Z-SLUT. PROC                                                                    
** PERFORM C-SKRIV-RAD                                                          
      UT-POST EQ UT4O-W3714O                                                    
      PUT W3714OD3                                                              
END-PROC                                                                        
