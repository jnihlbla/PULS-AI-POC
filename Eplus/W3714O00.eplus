*                                                               *               
**********-******************************************************               
                                                                                
*    --- VALID IDDC CODES                                                       
%WWDC99                                                                         
*                                                                               
W-IDDC            W   2  A                                                      
W-IDDISTR-1       W   5  N MASK 'ZZZZ9'.                                        
W-IDDISTR-2       W   5  N MASK 'ZZZZ9'.                                        
W-IDDISTR-3       W   5  N MASK 'ZZZZ9'.                                        
W-IDDISTR-4       W   5  N MASK 'ZZZZ9'.                                        
W-IDDISTR-5       W   5  N MASK 'ZZZZ9'.                                        
W-IDDISTR-6       W   5  N MASK 'ZZZZ9'.                                        
W-IDDISTR-7       W   5  N MASK 'ZZZZ9'.                                        
W-IDDISTR-8       W   5  N MASK 'ZZZZ9'.                                        
W-IDBYTRAP-1      W   7  N MASK 'ZZZZZZ9'.                                      
W-IDBYTRAP-2      W   7  N MASK 'ZZZZZZ9'.                                      
W-IDBYTRAP-3      W   7  N MASK 'ZZZZZZ9'.                                      
W-IDBYTRAP-4      W   7  N MASK 'ZZZZZZ9'.                                      
W-IDBYTRAP-5      W   7  N MASK 'ZZZZZZ9'.                                      
W-IDBYTRAP-6      W   7  N MASK 'ZZZZZZ9'.                                      
W-IDBYTRAP-7      W   7  N MASK 'ZZZZZZ9'.                                      
W-IDBYTRAP-8      W   7  N MASK 'ZZZZZZ9'.                                      
W-ANTAL           W   3  P                                                      
                                                                                
FORSTA-POST       W   1 A                                                       
                                                                                
W-RUB1                W  59 A                                                   
W-RUB1TEXT1   W-RUB1     10 A VALUE  'W3714O-091'                               
W-RUB1FILLER1 W-RUB1 +11  1 A VALUE  ';'                                        
W-RUBTEXT2    W-RUB1 +12 46 A VALUE  +                                          
    'DAILY FOLLOWING-UP CORES IN REPORT IN STATUS 4'                            
W-RUB1FILLER2 W-RUB1 +58 1 A VALUE ';'                                          
                                                                                
W-RUB2               W  127 A                                                   
W-RUB2TEXT1    W-RUB2      8 A VALUE  'DISTRICT'                                
W-RUB2FILLER1  W-RUB2 +9   1 A VALUE  ';'                                       
W-RUB2TEXT11   W-RUB2 +10 11 A VALUE  'CASE REPORT'                             
W-RUB2FILLER11 W-RUB2 +21  1 A VALUE  ';'                                       
W-RUB2TEXT2    W-RUB2 +22  8 A VALUE  'DISTRICT'                                
W-RUB2FILLER2  W-RUB2 +30  1 A VALUE  ';'                                       
W-RUB2TEXT22   W-RUB2 +31 11 A VALUE  'CASE REPORT'                             
W-RUB2FILLER22 W-RUB2 +42  1 A VALUE  ';'                                       
W-RUB2TEXT3    W-RUB2 +43  8 A VALUE  'DISTRICT'                                
W-RUB2FILLER3  W-RUB2 +51  1 A VALUE  ';'                                       
W-RUB2TEXT33   W-RUB2 +52 11 A VALUE  'CASE REPORT'                             
W-RUB2FILLER33 W-RUB2 +63  1 A VALUE  ';'                                       
W-RUB2TEXT4    W-RUB2 +64  8 A VALUE  'DISTRICT'                                
W-RUB2FILLER4  W-RUB2 +72  1 A VALUE  ';'                                       
W-RUB2TEXT44   W-RUB2 +73 11 A VALUE  'CASE REPORT'                             
W-RUB2FILLER44 W-RUB2 +84  1 A VALUE  ';'                                       
W-RUB2TEXT5    W-RUB2 +85  8 A VALUE  'DISTRICT'                                
W-RUB2FILLER5  W-RUB2 +93  1 A VALUE  ';'                                       
W-RUB2TEXT55   W-RUB2 +94 11 A VALUE  'CASE REPORT'                             
W-RUB2FILLER55 W-RUB2 +105 1 A VALUE  ';'                                       
W-RUB2TEXT6    W-RUB2 +106 8 A VALUE  'DISTRICT'                                
W-RUB2FILLER6  W-RUB2 +114 1 A VALUE  ';'                                       
