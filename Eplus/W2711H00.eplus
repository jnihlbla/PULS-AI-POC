                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2711H00                                              *        
*                                                                               
*  FUNKTION   :  ADD INFO FROM W01160, W01174 AND W01184 TO THE                 
*                WDE3-EXTRACT FILE CREATED BY PGM W2711G.                       
*                                                                               
*  FÖRFATTARE :  CHESTER COUCH                                         *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W2711HD1                                                                   
*                                                                               
%W2711G  'INPARTS-'                                                             
                                                                                
NEWPAGE                                                                         
FILE W2711HD2                                                                   
*                                                                               
%W01160  'IN60-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W2711HD3                                                                   
*                                                                               
%W01174  'IN74-'                                                                
                                                                                
NEWPAGE                                                                         
FILE TEMPFIL  FB(132 0)                                                         
*                                                                               
%W2711HT 'TMP-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W2711HD4                                                                   
*                                                                               
%W2711G  'IN-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE TEMPFIL2 FB(132 0)                                                         
*                                                                               
%W2711HT 'TMP2-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W2711HD5                                                                   
*                                                                               
%W01184  'IN84-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W2711HD6 FB(162 0)                                                         
*                                                                               
%W2711H  'OUT-'                                                                 
                                                                                
NEWPAGE                                                                         
W-TAB                         W   1 A VALUE X'05'                               
                                                                                
W-VLARTNTO                    W  10 A                                           
W-VLARTNTO-INT  W-VLARTNTO        8 N                                           
W-VLARTNTO-INT-LZ W-VLARTNTO-INT  1 A    +                                      
           OCCURS  7                     +                                      
           INDEX      W-LEADING-ZERO-IX                                         
W-VLARTNTO-DECP W-VLARTNTO   +8   1 A                                           
W-VLARTNTO-DEC  W-VLARTNTO   +9   1 N                                           
                                                                                
W-TEREFMED                    W  72 A                                           
W-TEREFMED-COMM2 W-TEREFMED +36  36 A                                           
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEP 1. MATCH AND CREATE FILE BASED ON                                        
*          WDE3/W2711GU/W2711HD1 (UNIQUE PART NUMBERS IN WDE3-EXTRACT)          
*          WDK6/W01150/W2711HD2                                                 
*           AND                                                                 
*          WDD3/W01174/W2711HD3                                                 
*                                                                               
JOB INPUT (W2711HD1 KEY(INPARTS-IDARTNR  )  +                                   
           W2711HD2 KEY(IN60-CLAG-IDARTNR)  +                                   
           W2711HD3 KEY(IN74-IDARTNR     )  +                                   
          )                                                                     
                                                                                
   IF W2711HD1 AND W2711HD2                                                     
      TMP-IDARTNR        = INPARTS-IDARTNR                                      
      TMP-IDSTATNR       = IN60-CLAG-IDSTATNR(3)                                
      TMP-KDARTURS       = IN60-CLAG-KDARTURS                                   
      TMP-VKART          = IN60-CLAG-VKART                                      
      TMP-VLARTNTO       = IN60-CLAG-VLARTNTO                                   
      IF W2711HD3                                                               
         IF IN74-BEART(4) = '                         '                         
            TMP-BEART          = '(DESCRIPTION MISSING)    '                    
         ELSE                                                                   
            TMP-BEART          = IN74-BEART(4)                                  
         END-IF                                                                 
      ELSE                                                                      
         TMP-BEART          = '(DESCRIPTION MISSING)    '                       
      END-IF                                                                    
                                                                                
      PUT TEMPFIL                                                               
   END-IF                                                                       
                                                                                
*                                                                               
* STEP 2. MATCH TO ADD INFO FROM WDE3/W2711G/W2711HD4                           
*                                                                               
JOB INPUT (TEMPFIL  KEY(TMP-IDARTNR)  +                                         
           W2711HD4 KEY(IN-IDARTNR )  +                                         
          )                                                                     
                                                                                
   IF TEMPFIL AND W2711HD4                                                      
      TMP2-IDDC          = IN-IDDC                                              
      TMP2-IDPERSON-BUY  = IN-IDPERSON-BUY                                      
      TMP2-KDREFTYP      = IN-KDREFTYP                                          
      TMP2-IDARTNR       = TMP-IDARTNR                                          
      TMP2-KDREFORS      = IN-KDREFORS                                          
      TMP2-KVBEART       = IN-KVBEART                                           
      TMP2-TEREFMED      = IN-TEREFMED                                          
      TMP2-IDSTATNR      = TMP-IDSTATNR                                         
      TMP2-KDARTURS      = TMP-KDARTURS                                         
      TMP2-VKART         = TMP-VKART                                            
      TMP2-VLARTNTO      = TMP-VLARTNTO                                         
      TMP2-BEART         = TMP-BEART                                            
                                                                                
      PUT TEMPFIL2                                                              
   END-IF                                                                       
*                                                                               
* STEP 3. MATCH TO ADD INFO FROM WDK7/W01184/W2711HD5 ON DC-LEVEL               
*                             TO WDE3ETC/TEMPFIL2 ON DC-&REFTYP-LEVEL           
*                                                                               
JOB INPUT (W2711HD5 KEY(IN84-SLAG-IDARTNR, IN84-SLAG-IDDC)  +                   
           TEMPFIL2 KEY(TMP2-IDARTNR,      TMP2-IDDC     )  +                   
          )                                                                     
                                                                                
   IF TEMPFIL2                                                                  
      OUT-IDPERSON-BUY   = TMP2-IDPERSON-BUY                                    
      OUT-KDREFTYP       = TMP2-KDREFTYP                                        
      OUT-IDARTNR        = TMP2-IDARTNR                                         
      OUT-BEART          = TMP2-BEART                                           
      OUT-KVBEART        = TMP2-KVBEART                                         
      OUT-TEREFMED-COMM1 = TMP2-TEREFMED                                        
      W-TEREFMED         = TMP2-TEREFMED                                        
      OUT-TEREFMED-COMM2 = W-TEREFMED-COMM2                                     
      OUT-IDSTATNR       = TMP2-IDSTATNR                                        
      IF W2711HD5                                                               
         OUT-FLFLYG         = IN84-SLAG-FLFLYG                                  
      ELSE                                                                      
         OUT-FLFLYG         = '?'                                               
      END-IF                                                                    
      OUT-KDARTURS       = TMP2-KDARTURS                                        
      OUT-VKART          = TMP2-VKART                                           
                                                                                
      W-VLARTNTO-INT     = TMP2-VLARTNTO                                        
      W-LEADING-ZERO-IX  = 1                                                    
      DO WHILE W-LEADING-ZERO-IX LE 7    +                                      
           AND W-VLARTNTO-INT-LZ(W-LEADING-ZERO-IX) = '0'                       
          W-VLARTNTO-INT-LZ(W-LEADING-ZERO-IX) = ' '                            
          W-LEADING-ZERO-IX = W-LEADING-ZERO-IX + 1                             
      END-DO                                                                    
      W-VLARTNTO-DECP    = '.'                                                  
      W-VLARTNTO-DEC     = TMP2-VLARTNTO * 10                                   
      OUT-VLARTNTO       = W-VLARTNTO                                           
                                                                                
      OUT-DELIMITER-01   = W-TAB                                                
      OUT-DELIMITER-02   = W-TAB                                                
      OUT-DELIMITER-03   = W-TAB                                                
      OUT-DELIMITER-04   = W-TAB                                                
      OUT-DELIMITER-05   = W-TAB                                                
      OUT-DELIMITER-06   = W-TAB                                                
      OUT-DELIMITER-07   = W-TAB                                                
      OUT-DELIMITER-08   = W-TAB                                                
      OUT-DELIMITER-09   = W-TAB                                                
      OUT-DELIMITER-10   = W-TAB                                                
      OUT-DELIMITER-11   = W-TAB                                                
                                                                                
      PUT W2711HD6                                                              
   END-IF                                                                       
