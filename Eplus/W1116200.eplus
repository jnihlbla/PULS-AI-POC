                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W111D3                                                *        
*                                                                      *        
*  FUNKTION   :  MATCHAR GAMMAL OCH NY ERSÄTTNINGSFIL OCH SKAPAR       *        
*                FIL MED FÖRÄNDRADE ERSKODER.                          *        
*                                                                      *        
*                                                                      *        
*  FÖRFATTARE :  G KJELLSON                                            *        
*                                                                      *        
*  INFILER    :  W111.W111D3.W11161(+0) (NY VR-ERSÄTTNINGSFIL)         *        
*             :  W111.W111D3.W11161(-1) (GAMMAL VR-ERSÄTTNINGSFIL)     *        
*                                                                      *        
*  UTFILER    :  W111.W111D3.W11162(+1) ARTIKLAR MED FÖRÄNDRAD KDERS   *        
*                                                                      *        
*  ÄNDRING             DATUM    AVD                                    *        
*                                                                      *        
*                                                                      *        
*  --------------      ------   ------                                 *        
*  --------------      ------   ------                                 *        
*                                                                      *        
************************************************************************        
FILE W11162D1.               * VR ERSÄTTNINGSFIL (NY)                           
%W11161 'NEW-'                                                                  
*                                                                               
FILE W11162D2.               * VR ERSÄTTNINGSFIL (GAMMAL)                       
%W11161 'OLD-'                                                                  
*                                                                               
FILE W11162D3 FB(20 28900). * UTFIL                                             
%W11123   'UT-'                                                                 
*                                                                               
*                                                                               
*                                                                               
***                                                                             
SW-CHANGE-KDERS    W  1  A                                                      
W-IDARTNR          W  5  P                                                      
                                                                                
*                                                                               
JOB INPUT (W11162D2 KEY (OLD-IDARTNR) +                                         
           W11162D1 KEY (NEW-IDARTNR))                                          
                                                                                
  IF MATCHED                                                                    
    IF NEW-KDERS > 20 AND NEW-KDERS < 30                                        
       IF OLD-KDERS < NEW-KDERS                                                 
          UT-W11123    = '   '                                                  
          UT-IDPTYP    = '100'                                                  
          UT-IDARTNR   = NEW-IDARTNR                                            
          UT-KDERS-OLD = OLD-KDERS                                              
          UT-KDERS-NEW = NEW-KDERS                                              
          PUT W11162D3                                                          
       END-IF                                                                   
    END-IF                                                                      
  ELSE                                                                          
    IF W11162D1                                                                 
       IF NEW-KDERS > 20 AND NEW-KDERS < 30                                     
          UT-W11123    = '   '                                                  
          UT-IDPTYP    = '100'                                                  
          UT-IDARTNR   = NEW-IDARTNR                                            
          UT-KDERS-OLD = 0                                                      
          UT-KDERS-NEW = NEW-KDERS                                              
          PUT W11162D3                                                          
       END-IF                                                                   
    END-IF                                                                      
  END-IF                                                                        
