*    -- CHECKED BY WY2000                                                       
                                                                                
*-------------*                                                                 
* JOB         *                                                                 
*-------------*                                                                 
*                                                                               
JOB INPUT W33076D1 START INIT-PROC                                              
*                                                                               
  W-IDGTYP           = BILD02-IDGTYP                                            
  IF W-IDGTYP < 5                                                               
     W-URVAL-IDGTYP       = W-IDGTYP                                            
     IF BILD02-IDTRANS    = '3202'                                              
                                                                                
***     SKAPA FÖRSÄTTSBLAD TILL LISTA VA1 DÅ URVAL KOMMER                       
***     FRÅN BILD 3202, FUNKTIONSGRUPP.                                         
                                                                                
        IF W-IDGTYP = 0                                                         
           MOVE '*** URVALET SAKNAR RESULTAT ***' TO         +                  
                W-VA1-RESULTAT-SAKNAS                                           
        ELSE                                                                    
           MOVE '                               ' TO         +                  
                W-VA1-RESULTAT-SAKNAS                                           
        END-IF                                                                  
                                                                                
        MOVE 'FUNKTIONSGRUPP'  TO W-VA1-BILDTYP                                 
        W-VV-START        = BILD02-DAFSGVV-FOM                                  
        W-VV-SLUT         = BILD02-DAFSGVV-TOM                                  
        W-FVV-START       = BILD02-DAFSGVV-FOM - 100                            
        W-FVV-SLUT        = BILD02-DAFSGVV-TOM - 100                            
                                                                                
        WU02-IDUSER       = BILD02-IDUSER                                       
        W-REGDAT          = BILD02-DAREGDAT                                     
        W-REGTID          = BILD02-TIREGTID                                     
                                                                                
        W-IDFSGURV        = BILD02-IDFSGURV                                     
                                                                                
        SPAR-KDNIVA       = BILD02-KDNIVA                                       
        W-KDPRTYPG        = BILD02-KDPRTYPG                                     
        W-KDVVKL01        = BILD02-KDVVKL(1)                                    
        W-KDVVKL02        = BILD02-KDVVKL(2)                                    
        W-KDVVKL03        = BILD02-KDVVKL(3)                                    
        W-KDVVKL04        = BILD02-KDVVKL(4)                                    
        W-KDVVKL05        = BILD02-KDVVKL(5)                                    
                                                                                
        W-KDPRODSL01      = BILD02-KDPRODSL(1)                                  
        W-KDPRODSL02      = BILD02-KDPRODSL(2)                                  
        W-KDPRODSL03      = BILD02-KDPRODSL(3)                                  
        W-KDPRODSL04      = BILD02-KDPRODSL(4)                                  
        W-KDPRODSL05      = BILD02-KDPRODSL(5)                                  
        W-KDPRODSL06      = BILD02-KDPRODSL(6)                                  
        W-KDPRODSL07      = BILD02-KDPRODSL(7)                                  
                                                                                
        W-IDKONCNR01      = BILD02-IDKONCNR(1)                                  
        W-IDKONCNR02      = BILD02-IDKONCNR(2)                                  
        W-IDKONCNR03      = BILD02-IDKONCNR(3)                                  
        W-IDKONCNR04      = BILD02-IDKONCNR(4)                                  
        W-IDKONCNR05      = BILD02-IDKONCNR(5)                                  
        W-IDKONCNR06      = BILD02-IDKONCNR(6)                                  
        W-IDKONCNR07      = BILD02-IDKONCNR(7)                                  
        W-IDKONCNR08      = BILD02-IDKONCNR(8)                                  
                                                                                
        W-IDLEVNR01       = BILD02-IDLEVNR(1)                                   
        W-IDLEVNR02       = BILD02-IDLEVNR(2)                                   
        W-IDLEVNR03       = BILD02-IDLEVNR(3)                                   
        W-IDLEVNR04       = BILD02-IDLEVNR(4)                                   
        W-IDLEVNR05       = BILD02-IDLEVNR(5)                                   
        W-IDLEVNR06       = BILD02-IDLEVNR(6)                                   
        W-IDLEVNR07       = BILD02-IDLEVNR(7)                                   
        W-IDLEVNR08       = BILD02-IDLEVNR(8)                                   
                                                                                
        W-IDLKTO01        = BILD02-IDLKTO(1)                                    
        W-IDLKTO02        = BILD02-IDLKTO(2)                                    
        W-IDLKTO03        = BILD02-IDLKTO(3)                                    
        W-IDLKTO04        = BILD02-IDLKTO(4)                                    
        W-IDLKTO05        = BILD02-IDLKTO(5)                                    
        W-IDLKTO06        = BILD02-IDLKTO(6)                                    
        W-IDLKTO07        = BILD02-IDLKTO(7)                                    
        W-IDLKTO08        = BILD02-IDLKTO(8)                                    
                                                                                
        PERFORM FLYTTA-DISTRIKTSGRUPPER                                         
                                                                                
        PERFORM FLYTTA-KONCERN                                                  
                                                                                
        PERFORM FLYTTA-MARKNADSGRUPPER                                          
                                                                                
                                                                                
        W-ANSKAFFAR-GRP   = BILD02-ANSKAFFAR-GRP(1)                             
        W-IDANSK01-F      = W-IDANSK-FOM                                        
        W-IDANSK01-T      = W-IDANSK-TOM                                        
        W-ANSKAFFAR-GRP   = BILD02-ANSKAFFAR-GRP(2)                             
        W-IDANSK02-F      = W-IDANSK-FOM                                        
        W-IDANSK02-T      = W-IDANSK-TOM                                        
        W-ANSKAFFAR-GRP   = BILD02-ANSKAFFAR-GRP(3)                             
        W-IDANSK03-F      = W-IDANSK-FOM                                        
        W-IDANSK03-T      = W-IDANSK-TOM                                        
        W-ANSKAFFAR-GRP   = BILD02-ANSKAFFAR-GRP(4)                             
        W-IDANSK04-F      = W-IDANSK-FOM                                        
        W-IDANSK04-T      = W-IDANSK-TOM                                        
        W-SOEK-IX = 1                                                           
        DO WHILE W-SOEK-IX < 100                                                
           PERFORM FLYTTA-FUNKTIONSGRUPPER                                      
           PRINT RAPPORT02                                                      
        END-DO                                                                  
     ELSE                                                                       
                                                                                
***     SKAPA FÖRSÄTTSBLAD TILL LISTA VA1 DÅ URVAL KOMMER                       
***     FRÅN BILD 3203, ARTIKEL.                                                
                                                                                
        IF W-IDGTYP = 0                                                         
           MOVE '*** URVALET SAKNAR RESULTAT ***' TO         +                  
                W-VA1-RESULTAT-SAKNAS                                           
        ELSE                                                                    
           MOVE '                               ' TO         +                  
                W-VA1-RESULTAT-SAKNAS                                           
        END-IF                                                                  
                                                                                
        MOVE 'ARTIKEL       ' TO W-VA1-BILDTYP                                  
        W-VV-START        = BILD03-DAFSGVV-FOM                                  
        W-VV-SLUT         = BILD03-DAFSGVV-TOM                                  
        W-FVV-START       = BILD03-DAFSGVV-FOM - 100                            
        W-FVV-SLUT        = BILD03-DAFSGVV-TOM - 100                            
                                                                                
        WU03-IDUSER       = BILD03-IDUSER                                       
        W-REGDAT          = BILD03-DAREGDAT                                     
        W-REGTID          = BILD03-TIREGTID                                     
        W-IDFSGURV        = BILD03-IDFSGURV                                     
                                                                                
        WU03-DAFSGVV-FOM  = BILD03-DAFSGVV-FOM                                  
        WU03-DAFSGVV-TOM  = BILD03-DAFSGVV-TOM                                  
        WU03-IDPTYP       = BILD03-IDPTYP                                       
        WU03-KDPRTYPG     = BILD03-KDPRTYPG                                     
                                                                                
                                                                                
        PERFORM FLYTTA-DISTRIKTSGRUPPER                                         
                                                                                
        PERFORM FLYTTA-KONCERN                                                  
                                                                                
        PERFORM FLYTTA-MARKNADSGRUPPER                                          
        W-SOEK-IX = 1                                                           
        DO WHILE BILD03-IDARTNR(W-SOEK-IX) NE W-TOMT-IDARTNR                    
           W-SOEK-IX = W-SOEK-IX + 1                                            
        END-DO                                                                  
        MOVE W-SOEK-IX TO W-MAX-ARTNR-IX                                        
                                                                                
        W-ARTNR-IX = 1                                                          
        DO WHILE W-ARTNR-IX < W-MAX-ARTNR-IX                                    
           W-IDARTNR01    = BILD03-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR02    = BILD03-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR03    = BILD03-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR04    = BILD03-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR05    = BILD03-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR06    = BILD03-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR07    = BILD03-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR08    = BILD03-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR09    = BILD03-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           W-IDARTNR10    = BILD03-IDARTNR(W-ARTNR-IX)                          
           W-ARTNR-IX     = W-ARTNR-IX + 1                                      
           PRINT RAPPORT03                                                      
        END-DO                                                                  
     END-IF                                                                     
  ELSE                                                                          
     W-REGDAT             = RES-DAREGDAT                                        
     W-REGTID             = RES-TIREGTID                                        
     W-VA1-SULEVANT-VV    = RES-SULEVANT-VV                                     
     W-VA1-SULEVANT-FVV   = RES-SULEVANT-FVV                                    
                                                                                
     UT-LINE-IDARTNR           = RES-IDARTNR                                    
     UT-LINE-BEART-SVE         = RES-BEART-SVE                                  
     UT-LINE-SULEVANT-VV       = RES-SULEVANT-VV                                
     UT-LINE-SUARTFSG-VV       = RES-SUARTFSG-VV                                
     UT-LINE-RETOTBV-VV        = RES-RETOTBV-VV                                 
     UT-LINE-SULEVANT-FVV      = RES-SULEVANT-FVV                               
     UT-LINE-SUARTFSG-FVV      = RES-SUARTFSG-FVV                               
     UT-LINE-RETOTBV-FVV       = RES-RETOTBV-FVV                                
                                                                                
     PRINT RAPPORT-VA1                                                          
  END-IF                                                                        
                                                                                
                                                                                
INIT-PROC. PROC                                                                 
                                                                                
W-SOEK-IX             = 0                                                       
W-ARTNR-IX            = 0                                                       
W-MAX-ARTNR-IX        = 0                                                       
W-TOMT-IDARTNR        = 0                                                       
                                                                                
SUM-SUARTSJK-VV       = 0                                                       
SUM-SUARTSJK-FVV      = 0                                                       
W-TG-VV               = 0                                                       
W-TG-FVV              = 0                                                       
