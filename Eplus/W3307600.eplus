  REPORT RAPPORT-VA1                                         +                  
         PRINTER W33076D2                                    +                  
         LINESIZE 120                                        +                  
         PAGESIZE 41                                         +                  
         TITLESKIP 0                                         +                  
         SPACE 1                                             +                  
         NOADJUST                                            +                  
         NOHEADING                                           +                  
         SUMCTL NONE                                                            
                                                                                
    CONTROL  FINAL NOPRINT                                   +                  
             RES-IDUSER NOPRINT W-REGDAT NOPRINT             +                  
             W-REGTID NOPRINT RENUM                                             
                                                                                
                                                                                
    SUM     RES-SULEVANT-VV RES-SUARTFSG-VV                  +                  
            RES-SULEVANT-FVV RES-SUARTFSG-FVV                +                  
            RES-SUARTSJK-VV RES-SUARTSJK-FVV                                    
                                                                                
    TITLE 1 COL 005 ' '                                                         
                                                                                
    TITLE 2 COL 004 'VOLVO PARTS AB'                         +                  
            COL 020 'W33076-001'                             +                  
            COL 032 'URVAL:'                                 +                  
            COL 038 W-IDFSGURV                               +                  
            COL 049 'VA1'                                    +                  
            COL 053 'ARTIKELSTATISTIK'                       +                  
            COL 080 'USERID'                                 +                  
            COL 088 RES-IDUSER                               +                  
            COL 108 'DAT'                                  +                    
            COL 112 W-REGDAT                                                    
                                                                                
    TITLE 3 COL 053 W-VA1-BILDTYP                            +                  
            COL 108 'TID'                                    +                  
            COL 114 W-REGTID                                                    
                                                             +                  
    TITLE 5 COL 053 'VECKA'                            +                        
            COL 061 W-VV-START                               +                  
            COL 068 '-'                                      +                  
            COL 070 W-VV-SLUT                                +                  
            COL 093 'VECKA'                            +                        
            COL 101 W-FVV-START                              +                  
            COL 108 '-'                                      +                  
            COL 110 W-FVV-SLUT                                                  
                                                                                
    TITLE 6 COL 005 'ARTIKEL'                                                   
                                                                                
    TITLE 7  COL 005 'NUMMER'                                +                  
             COL 015 'ARTIKELBENÄMNING'                      +                  
             COL 050 'ST'                                    +                  
             COL 064 'FSG KR'                                +                  
             COL 073 'TG KR'                                 +                  
             COL 088 'ST'                                    +                  
             COL 103 'FSG KR'                                +                  
             COL 112 'TG KR'                                                    
                                                                                
    LINE 1   COL 005 UT-LINE-IDARTNR                         +                  
             COL 015 UT-LINE-BEART-SVE                       +                  
             COL 043 UT-LINE-SULEVANT-VV                     +                  
             COL 056 UT-LINE-SUARTFSG-VV                     +                  
             COL 074 UT-LINE-RETOTBV-VV                      +                  
             COL 081 UT-LINE-SULEVANT-FVV                    +                  
             COL 095 UT-LINE-SUARTFSG-FVV                    +                  
             COL 113 UT-LINE-RETOTBV-FVV                                        
                                                                                
BEFORE-BREAK. PROC                                                              
    IF LEVEL = 1                                                                
       IF RES-SUARTFSG-VV NE 0                                                  
          W-TG-VV  = (100 * (RES-SUARTFSG-VV -               +                  
                      RES-SUARTSJK-VV)) / RES-SUARTFSG-VV                       
       ELSE                                                                     
          MOVE ZEROES TO W-TG-VV                                                
       END-IF                                                                   
                                                                                
                                                                                
       IF RES-SUARTFSG-FVV NE 0                                                 
          W-TG-FVV = (100 * (RES-SUARTFSG-FVV -              +                  
                      RES-SUARTSJK-FVV)) / RES-SUARTFSG-FVV                     
       ELSE                                                                     
          MOVE ZEROES TO W-TG-FVV                                               
       END-IF                                                                   
                                                                                
       IF W-TG-VV > 0                                                           
          W-TG-VV = W-TG-VV + 0.05                                              
       ELSE                                                                     
          IF W-TG-VV < 0                                                        
             W-TG-VV = W-TG-VV - 0.05                                           
          END-IF                                                                
       END-IF                                                                   
                                                                                
       IF W-TG-FVV > 0                                                          
          W-TG-FVV = W-TG-FVV + 0.05                                            
       ELSE                                                                     
          IF W-TG-FVV < 0                                                       
             W-TG-FVV = W-TG-FVV - 0.05                                         
          END-IF                                                                
       END-IF                                                                   
                                                                                
       GTOT-SULEVANT-VV          = RES-SULEVANT-VV                              
       GTOT-SUARTFSG-VV          = RES-SUARTFSG-VV                              
       IF W-TG-VV > 99.9                                                        
          GTOT-RETOTBV-VV = 99.9                                                
       ELSE                                                                     
          IF W-TG-VV < -99.9                                                    
             GTOT-RETOTBV-VV = -99.9                                            
          ELSE                                                                  
            GTOT-RETOTBV-VV           = W-TG-VV                                 
          END-IF                                                                
       END-IF                                                                   
       GTOT-SULEVANT-FVV         = RES-SULEVANT-FVV                             
       GTOT-SUARTFSG-FVV         = RES-SUARTFSG-FVV                             
       IF W-TG-FVV > 99.9                                                       
          GTOT-RETOTBV-FVV = 99.9                                               
       ELSE                                                                     
          IF W-TG-FVV < -99.9                                                   
             GTOT-RETOTBV-FVV = -99.9                                           
          ELSE                                                                  
            GTOT-RETOTBV-FVV          = W-TG-FVV                                
          END-IF                                                                
       END-IF                                                                   
                                                                                
       DISPLAY '   '                                                            
       DISPLAY  COL 005 'URVAL - TOTAL'                      +                  
                COL 043 GTOT-SULEVANT-VV                     +                  
                COL 056 GTOT-SUARTFSG-VV                     +                  
                COL 074 GTOT-RETOTBV-VV                      +                  
                COL 081 GTOT-SULEVANT-FVV                    +                  
                COL 095 GTOT-SUARTFSG-FVV                    +                  
                COL 113 GTOT-RETOTBV-FVV                                        
                                                                                
    END-IF                                                                      
END-PROC                                                                        
