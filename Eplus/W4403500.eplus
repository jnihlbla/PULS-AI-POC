                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4403500                                              *        
*                                                                      *        
*  FUNKTION   :  SKAPAR FIL MED ARTIKLAR SOM HAR KVROS STÖRRE ÄN NOLL  *        
*                INFIL SLB W01184 MED POSTER FÖR NDC-NA OCH NDC-CN     *        
*                NDC-JP  UTFIL W44035                                  *        
*                COPYTEXT PÅ UTFIL W44035                              *        
*                                                                      *        
*  FÖRFATTARE :  T LARSSON            AUG - 97                         *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W44035D1                                                                   
*                                                                               
%W01184   'SLB-'                                                                
                                                                                
NEWPAGE                                                                         
FILE TPFIL1   FB(483 0)                                                         
*                                                                               
%W01184  'TEMP-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W44035D2 FB(15 0)                                                          
*                                                                               
%W44035  'UT-'                                                                  
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
WS-DISP   W  6  P 0  VALUE 0                                                    
WS-IDDC   W  2  A                                                               
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
                                                                                
NEWPAGE                                                                         
*-----------------------------------------------------------------*             
* STEG 1  SORTERAR SUPPORTLAGERBAND PÅ ARTIKELNR                                
*-----------------------------------------------------------------*             
                                                                                
SORT W44035D1 TO TPFIL1 USING (SLB-SLAG-IDARTNR)                                
                                                                                
                                                                                
*-----------------------------------------------------------------*             
* STEG 2  LÄSER LAGERBANDEN OCH SKAPAR FIL MED DE SOM HAR KVROS > 0             
*                                                                               
*-----------------------------------------------------------------*             
                                                                                
JOB INPUT TPFIL1                                                                
                                                                                
 WS-IDDC = TEMP-SLAG-IDDC                                                       
 PERFORM S23-CHECK-WS-IDDC                                                      
 IF TEMP-SLAG-IDDC = NDC-NA +                                                   
 OR TEMP-SLAG-IDDC = NDC-CN +                                                   
 OR TEMP-SLAG-IDDC = NDC-JP                                                     
                                                                                
   WS-DISP = 0                                                                  
   IF TEMP-SLAG-KVROS-DAG > 0 +                                                 
   OR TEMP-SLAG-KVROS-BULK > 0                                                  
                                                                                
     WS-DISP = TEMP-SLAG-KVLS                                    +              
             - TEMP-SLAG-KVOKS-DAG                               +              
             - TEMP-SLAG-KVOKS-BULK                              +              
             - TEMP-SLAG-KVRESS                                  +              
             - TEMP-SLAG-KVUTRS                                  +              
             - TEMP-SLAG-KVSPARR-KVAL                                           
                                                                                
     IF WS-DISP <= 0                                                            
       UT-IDARTNR    = TEMP-SLAG-IDARTNR                                        
       UT-KVROS-DAG  = TEMP-SLAG-KVROS-DAG                                      
       UT-KVROS-BULK = TEMP-SLAG-KVROS-BULK                                     
       UT-IDDC       = TEMP-SLAG-IDDC                                           
                                                                                
       PUT W44035D2                                                             
     END-IF                                                                     
   END-IF                                                                       
 END-IF                                                                         
NEWPAGE                                                                         
*    --- S23-CHECK-WS-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'WS-'                                                                   
NEWPAGE                                                                         
                                                                                
