                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2714000                                              *        
*                                                                      *        
*  FUNKTION   :  VÄLJER UT ARTIKLAR SOM SKALL AKTIVERAS PÅ WDK7.       *        
*                                                                      *        
*  FÖRFATTARE :  LARS THELL                                            *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE STEERFIL                                                                   
 IN-STEER-PARM   01   03  A                                                     
                                                                                
NEWPAGE                                                                         
FILE W27140D1                                                                   
*                                                                               
%W01160                                                                         
                                                                                
NEWPAGE                                                                         
FILE W27140D2                                                                   
*                                                                               
%W01184                                                                         
                                                                                
NEWPAGE                                                                         
FILE W27140D3                                                                   
*                                                                               
%W01186                                                                         
                                                                                
NEWPAGE                                                                         
FILE TEMPFIL1 FB(483 0)                                                         
*                                                                               
%W01184  'T1-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE TEMPFIL2 FB(2094 0)                                                        
*                                                                               
%W01186  'T2-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE W27140D4 FB(248 0)                                                         
%W27140  'SDC-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W27140D5 FB(248 0)                                                         
*                                                                               
%W27140  'UT-'                                                                  
                                                                                
NEWPAGE                                                                         
                                                                                
JA                W    1   A   VALUE 'J'                                        
NEJ               W    1   A   VALUE 'N'                                        
PASSIV            W    1   A   VALUE 'P'                                        
INDX              W    2   N   VALUE 0                                          
WS-KVOT-RULL-SUM  W    8   N   VALUE 0                                          
WS-KVOT-INNEV-SUM W    8   N   VALUE 0                                          
WS-STEER          W    3   A   VALUE ' '                                        
WS-IDDC           W    2   A   VALUE ' '                                        
                                                                                
WS-IDDC-REF       W                    2   A   VALUE ' '                        
WS-IDDC-REF-1     WS-IDDC-REF          1   A                                    
WS-IDDC-REF-2     WS-IDDC-REF    +1    1   A                                    
                                                                                
NEWPAGE                                                                         
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
* STEG 0. MATCH FILES TO CREATE TEMP INPUT FILE                                 
*                        AS PER THE STEERING PARAMETER                          
*                                                                               
JOB INPUT(W27140D2 KEY (SLAG-IDARTNR SLAG-IDDC) +                               
          W27140D3 KEY (DC-IDARTNR DC-IDDC))    +                               
          START GETPARM                                                         
                                                                                
    IF WS-STEER = 'CHN'                                                         
*---   I/P FILE 1 IS EXTRACT OF K7 FOR ALL SDC, LDC AND NDC REFILLED            
*---   FROM CHINA                                                               
*---   I/P FILE 2 IS EXTRACT OF L7 FOR ALL LDC, SDC AND NDC                     
*---   O/P FILE 1 HAS ALL LDC, SDC AND NDC PARTS REFILLED FROM KINA             
*---   O/P FILE 2 HAS ALL LDC, SDC, NDC-CN PARTS REFILLED FROM KINA             
*---                                                                            
       IF MATCHED                                                               
          WS-IDDC                 = DC-IDDC                                     
          PERFORM S23-CHECK-WS-IDDC                                             
          IF WS-IDDC = NDC-CN                                                   
                T2-DC-W01186      = DC-W01186                                   
                PUT TEMPFIL2                                                    
          ELSE                                                                  
            IF WS-IDDC = SDC LDC                                                
               T2-DC-W01186       = DC-W01186                                   
               PUT TEMPFIL2                                                     
            END-IF                                                              
          END-IF                                                                
          T1-SLAG-W01184          = SLAG-W01184                                 
          PUT TEMPFIL1                                                          
       ELSE                                                                     
          IF W27140D2                                                           
             T1-SLAG-W01184       = SLAG-W01184                                 
             PUT TEMPFIL1                                                       
          END-IF                                                                
          IF W27140D3                                                           
             WS-IDDC              = DC-IDDC                                     
             PERFORM S23-CHECK-WS-IDDC                                          
             IF WS-IDDC = SDC LDC                                               
                T2-DC-W01186      = DC-W01186                                   
                PUT TEMPFIL2                                                    
             END-IF                                                             
          END-IF                                                                
       END-IF                                                                   
    ELSE                                                                        
       IF WS-STEER                = 'NDC'                                       
*---      I/P FILE 1 IS EXTRACT OF K7 FOR ALL NDC                               
*---      I/P FILE 2 IS EXTRACT OF L7 FOR ALL NDC                               
*---      O/P FILE 1 HAS ALL NDC PARTS - NOT KINA                               
*---      O/P FILE 2 HAS ALL NDC PARTS - NOT KINA                               
*---                                                                            
          IF MATCHED                                                            
             WS-IDDC-REF          = SLAG-IDDC-REF                               
             IF WS-IDDC-REF-1     = '7'                                         
                WS-IDDC           = DC-IDDC                                     
                PERFORM S23-CHECK-WS-IDDC                                       
                IF WS-IDDC = NDC-CN                                             
                   CONTINUE                                                     
                ELSE                                                            
                   T2-DC-W01186   = DC-W01186                                   
                   PUT TEMPFIL2                                                 
                END-IF                                                          
             ELSE                                                               
                T1-SLAG-W01184    = SLAG-W01184                                 
                PUT TEMPFIL1                                                    
*                                                                               
                T2-DC-W01186      = DC-W01186                                   
                PUT TEMPFIL2                                                    
             END-IF                                                             
          ELSE                                                                  
             IF W27140D2                                                        
                WS-IDDC-REF       = SLAG-IDDC-REF                               
                IF WS-IDDC-REF-1 NE '7'                                         
                   T1-SLAG-W01184 = SLAG-W01184                                 
                   PUT TEMPFIL1                                                 
                END-IF                                                          
             END-IF                                                             
             IF W27140D3                                                        
                T2-DC-W01186      = DC-W01186                                   
                PUT TEMPFIL2                                                    
             END-IF                                                             
          END-IF                                                                
       ELSE                                                                     
         IF WS-STEER              = 'ALL'                                       
*---        I/P FILE 1 IS EXTRACT OF K7 FOR ALL LDC, SDC AND NDC                
*---        I/P FILE 2 IS EXTRACT OF L7 FOR ALL LDC, SDC AND NDC                
*---        O/P FILE 1 HAS ALL LDC, SDC AND NDC PARTS                           
*---        O/P FILE 2 HAS ALL LDC, SDC AND NDC PARTS                           
*---                                                                            
            IF MATCHED OR W27140D2                                              
               T1-SLAG-W01184     = SLAG-W01184                                 
               PUT TEMPFIL1                                                     
            END-IF                                                              
            IF MATCHED OR W27140D3                                              
               T2-DC-W01186       = DC-W01186                                   
               PUT TEMPFIL2                                                     
            END-IF                                                              
         END-IF                                                                 
       END-IF                                                                   
    END-IF                                                                      
                                                                                
GETPARM. PROC                                                                   
                                                                                
  GET STEERFIL                                                                  
  WS-STEER = IN-STEER-PARM                                                      
                                                                                
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
*    --- S23-CHECK-WS-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'WS-'                                                                   
*                                                                               
                                                                                
*                                                                               
* STEG 1. MATCHAR FILER  WDK7,SAMTLIGA LAGER OCH                                
*                        WDL7,SAMTLIGA LAGER                                    
*                                                                               
JOB INPUT(TEMPFIL1 KEY (T1-SLAG-IDARTNR T1-SLAG-IDDC) +                         
          TEMPFIL2 KEY (T2-DC-IDARTNR T2-DC-IDDC))                              
                                                                                
 IF MATCHED                                                                     
    IF T1-SLAG-KDREFSTA = PASSIV                                                
       IF T1-SLAG-FLREFILL = JA                                                 
          PERFORM SKAPA-SDC-MATCH                                               
          PUT W27140D4                                                          
       END-IF                                                                   
    END-IF                                                                      
 ELSE                                                                           
    IF TEMPFIL2                                                                 
          PERFORM SKAPA-SDC-OMATCH                                              
          PUT W27140D4                                                          
    END-IF                                                                      
 END-IF                                                                         
                                                                                
                                                                                
SKAPA-SDC-MATCH. PROC                                                           
                                                                                
 SDC-IDARTNR                = T2-DC-IDARTNR                                     
 SDC-IDDC                   = T2-DC-IDDC                                        
 SDC-TIFINLV                = 0                                                 
                                                                                
 INDX                       = 1                                                 
 DO WHILE INDX             LT 54                                                
   SDC-KVOT-RULL(INDX)                                               +          
                = T2-DC-KVOT-RULL(INDX) + T2-DC-KVOT-REF-RULL(INDX)             
   INDX                    = INDX + 1                                           
 END-DO                                                                         
                                                                                
 INDX                       = 1                                                 
 DO WHILE INDX             LT 6                                                 
   SDC-KVOT-INNEV(INDX)                                               +         
                = T2-DC-KVOT-INNEV    (INDX)                          +         
                + T2-DC-KVOT-PP-INNEV (INDX)                          +         
                + T2-DC-KVOT-REF-INNEV(INDX)                                    
   INDX                    = INDX + 1                                           
 END-DO                                                                         
                                                                                
 SDC-FLARTREG               = JA                                                
                                                                                
END-PROC                                                                        
                                                                                
                                                                                
SKAPA-SDC-OMATCH. PROC                                                          
                                                                                
 SDC-IDARTNR                = T2-DC-IDARTNR                                     
 SDC-IDDC                   = T2-DC-IDDC                                        
 SDC-TIFINLV                = 0                                                 
                                                                                
 INDX                       = 1                                                 
 DO WHILE INDX             LT 54                                                
   SDC-KVOT-RULL(INDX)                                               +          
                = T2-DC-KVOT-RULL(INDX) + T2-DC-KVOT-REF-RULL(INDX)             
   INDX                    = INDX + 1                                           
 END-DO                                                                         
                                                                                
 INDX                       = 1                                                 
 DO WHILE INDX             LT 6                                                 
   SDC-KVOT-INNEV(INDX)                                              +          
                = T2-DC-KVOT-INNEV    (INDX)                         +          
                + T2-DC-KVOT-PP-INNEV (INDX)                         +          
                + T2-DC-KVOT-REF-INNEV(INDX)                                    
   INDX                    = INDX + 1                                           
 END-DO                                                                         
                                                                                
                                                                                
                                                                                
 SDC-FLARTREG               = NEJ                                               
                                                                                
END-PROC                                                                        
                                                                                
                                                                                
*                                                                               
* STEG 2. MATCHAR FILER  WDK6,ARTIKELFIL OCH                                    
*                        SDCFIL(W27140D4) (PASSIVA REFILLARTIKLAR SAMT          
*                        REFILLARTIKLAR SOM EJ FINNS PÅ K7)                     
*                                                                               
                                                                                
JOB INPUT (W27140D1 KEY (CLAG-IDARTNR) +                                        
           W27140D4 KEY (SDC-IDARTNR))                                          
                                                                                
                                                                                
  IF MATCHED                                                                    
     IF CLAG-KDERS   < 10                                                       
        PERFORM S01-SKRIV-UTFIL                                                 
     END-IF                                                                     
  END-IF                                                                        
                                                                                
  NEWPAGE                                                                       
                                                                                
  S01-SKRIV-UTFIL. PROC                                                         
                                                                                
     WS-KVOT-RULL-SUM        = 0                                                
     WS-KVOT-INNEV-SUM       = 0                                                
     UT-IDARTNR              = SDC-IDARTNR                                      
     UT-IDDC                 = SDC-IDDC                                         
     UT-TIFINLV              = CLAG-TIFINLV                                     
     UT-PRARTSTD             = CLAG-PRARTSTD                                    
                                                                                
     INDX                       = 1                                             
     DO WHILE INDX             LT 54                                            
        UT-KVOT-RULL(INDX) = SDC-KVOT-RULL(INDX)                                
        WS-KVOT-RULL-SUM =  UT-KVOT-RULL(INDX) + WS-KVOT-RULL-SUM               
        INDX                    = INDX + 1                                      
     END-DO                                                                     
                                                                                
     INDX                       = 1                                             
     DO WHILE INDX             LT 6                                             
        UT-KVOT-INNEV(INDX) = SDC-KVOT-INNEV(INDX)                              
        WS-KVOT-INNEV-SUM = UT-KVOT-INNEV(INDX) + WS-KVOT-INNEV-SUM             
        INDX                    = INDX + 1                                      
     END-DO                                                                     
                                                                                
                                                                                
    UT-FLARTREG          = SDC-FLARTREG                                         
                                                                                
    IF WS-KVOT-RULL-SUM = 0 AND WS-KVOT-INNEV-SUM = 0                           
        CONTINUE                                                                
    ELSE                                                                        
        PUT W27140D5                                                            
    END-IF                                                                      
                                                                                
  END-PROC                                                                      
*                                                                               
*    --- S23-CHECK-SDC-IDDC (MACRO PROCEDURE)                                   
%WWDC02 'SDC-'                                                                  
