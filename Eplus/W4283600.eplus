    W-SUSTDTOT-INL = W-SUSTDTOT-INL + IN-R32-SUSTDTOT                           
  END-IF                                                                        
                                                                                
  A-INIT. PROC                                                                  
    W-SUSTDTOT-INL = +0                                                         
  END-PROC                                                                      
                                                                                
  Z-FINIT. PROC                                                                 
    PRINT W42836-001                                                            
  END-PROC                                                                      
                                                                                
