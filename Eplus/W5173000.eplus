                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W517   SUMMERAD MÅNADSRAPPORT                         *        
*                FREKVENS, MÅNADSSLUT.                                 *        
*                                                                      *        
*  FUNKTION   :  LÄSER UTFALLS TRANSAR FRÅN PEDAL OCH SKAPAR LISTA     *        
*                                                                      *        
*  FÖRFATTARE :  KARL JOHAN HANSSON                                    *        
*                                                                      *        
*  INFILER    :  W517.W500R1.W51713 (DAGFILER FRÅN PEDAL)              *        
*                                                                      *        
*  UTDATA     :  LISTA W51730-001                                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W51730D1                                                                   
*                                                                               
%W51713   'MON-'                                                                
                                                                                
FILE TPFIL1   FB(101 0)                                                         
%W51713   'TP-'                                                                 
                                                                                
FILE W51730D2  VB (84 0)                                                        
UTFIL  1 80  A                                                                  
* ARBETS-AREOR                                                                  
*                                                                               
TRANS-TIAAVV            W   4   N                                               
TRANS-TIVV TRANS-TIAAVV +2  2   N                                               
                                                                                
W-TIMM        W   2  A                                                          
W-TIVV        W   2  N                                                          
W-KDMARK      W   3  N                                                          
W-SUARTFSG    W  11  N  2                                                       
W-SUBV        W  11  N  2                                                       
                                                                                
W-SUARTFSG-E  W  11  N  2                                                       
W-SUBV-E      W  11  N  2                                                       
FIRST-POST    W   1  A  VALUE 'J'                                               
                                                                                
W-SUARTFSG1                 W   11 N 2                                          
W-SUARTFSG-HEL W-SUARTFSG1       9 N                                            
W-SUARTFSG-DEC W-SUARTFSG1  +9   2 N                                            
                                                                                
W-SUBV1                     W   11 N 2                                          
W-SUBV-HEL     W-SUBV1           9 N                                            
W-SUBV-DEC     W-SUBV1     +9    2 N                                            
                                                                                
** EXCEL AREA **                                                                
                                                                                
E-RUBRIK      W  84 A                                                           
W-EDATUM      E-RUBRIK            6  A                                          
W-XFILLER01   E-RUBRIK      +7    1  A  VALUE ';'                               
W-XFILLER02   E-RUBRIK      +8   10  A  VALUE 'W51730-001'                      
W-XFILLER03   E-RUBRIK     +18    1  A  VALUE ';'                               
W-XFILLER04   E-RUBRIK     +19   13  A  VALUE 'MÅNADSRAPPORT'                   
W-XFILLER05   E-RUBRIK     +32    1  A  VALUE ';'                               
W-XFILLER06   E-RUBRIK     +33   11  A  VALUE 'FÖRSÄLJNING'                     
W-XFILLER07   E-RUBRIK     +44    1  A  VALUE ';'                               
W-XFILLER08   E-RUBRIK     +45   15  A  VALUE 'OCH BRUTTOVINST'                 
W-XFILLER09   E-RUBRIK     +60    1  A  VALUE ';'                               
                                                                                
E-RUBRIK1     W  84 A                                                           
W-XFILLER10   E-RUBRIK1           5  A VALUE 'MÅNAD'                            
W-XFILLER11   E-RUBRIK1     +6    1  A VALUE ';'                                
W-XFILLER12   E-RUBRIK1     +7    5  A VALUE 'VECKA'                            
W-XFILLER13   E-RUBRIK1    +12    1  A VALUE ';'                                
W-XFILLER14   E-RUBRIK1    +13   11  A VALUE 'MARKNADSKOD'                      
W-XFILLER15   E-RUBRIK1    +24    1  A VALUE ';'                                
W-XFILLER16   E-RUBRIK1    +25    5  A VALUE 'SALES'                            
W-XFILLER17   E-RUBRIK1    +30    1  A VALUE ';'                                
W-XFILLER18   E-RUBRIK1    +31   15  A VALUE 'BRUTTOVINST'                      
W-XFILLER19   E-RUBRIK1    +46    1  A VALUE ';'                                
                                                                                
E-RAD      W    84 A                                                            
E-TIMM         E-RAD              2 A                                           
E-FILLER20     E-RAD          +3  1 A VALUE ';'                                 
E-WEEK         E-RAD          +4  2 A                                           
E-FILLER21     E-RAD          +6  1 A VALUE ';'                                 
E-KDMARK       E-RAD          +7  3 N                                           
E-FILLER22     E-RAD         +10  1 A VALUE ';'                                 
E-SUARTFSGTECK E-RAD         +11  1 A                                           
E-SUARTFSG     E-RAD         +12  9 N                                           
E-FILLER23     E-RAD         +21  1 A VALUE ','                                 
E-SUARTFSGDEC  E-RAD         +22  2 N                                           
E-FILLER24     E-RAD         +24  1 A VALUE ';'                                 
E-SUBVTECK     E-RAD         +25  1 A                                           
E-SUBV         E-RAD         +26  9 N                                           
E-FILLER25     E-RAD         +35  1 A VALUE ','                                 
E-SUBVDEC      E-RAD         +36  2 N                                           
E-FILLER26     E-RAD         +38  1 A VALUE ';'                                 
                                                                                
*------------*                                                                  
*  JOB1 SORT *                                                                  
*------------*                                                                  
                                                                                
SORT W51730D1 TO TPFIL1 USING (MON-TIMM  +                                      
                             MON-TIAAVV   +                                     
                             MON-KDMARK)  +                                     
                             SIZE 1000000                                       
*---------*                                                                     
*  JOB2   *                                                                     
*---------*                                                                     
                                                                                
JOB INPUT TPFIL1  FINISH Z-END                                                  
                                                                                
  W-TIMM               = TP-TIMM                                                
  TRANS-TIAAVV         = TP-TIAAVV                                              
  W-TIVV               = TRANS-TIVV                                             
  W-KDMARK             = TP-KDMARK                                              
  W-SUARTFSG           = TP-SUARTFSG                                            
  W-SUBV               = TP-SUARTFSG - TP-SUARTSJK                              
  IF FIRST-POST = 'J'                                                           
    E-TIMM             = TP-TIMM                                                
    E-WEEK             = W-TIVV                                                 
    E-KDMARK           = TP-KDMARK                                              
    W-SUARTFSG-E       = TP-SUARTFSG                                            
    W-SUBV-E           = W-SUBV                                                 
    FIRST-POST = 'N'                                                            
    UTFIL EQ E-RUBRIK                                                           
    PUT W51730D2                                                                
    UTFIL EQ E-RUBRIK1                                                          
    PUT W51730D2                                                                
  ELSE                                                                          
    IF E-TIMM NE TP-TIMM OR E-WEEK NE W-TIVV OR E-KDMARK NE TP-KDMARK           
      IF W-SUBV-E LT 0                                                          
        E-SUBVTECK EQ '-'                                                       
        W-SUBV-E    = W-SUBV-E * -1                                             
      ELSE                                                                      
        E-SUBVTECK EQ ' '                                                       
      END-IF                                                                    
      IF W-SUARTFSG-E LT 0                                                      
        E-SUARTFSGTECK    EQ '-'                                                
        W-SUARTFSG-E       = W-SUARTFSG-E * -1                                  
      ELSE                                                                      
        E-SUARTFSGTECK EQ ' '                                                   
      END-IF                                                                    
                                                                                
      W-SUBV1    EQ W-SUBV-E                                                    
      E-SUBV     EQ W-SUBV-HEL                                                  
      E-SUBVDEC  EQ W-SUBV-DEC                                                  
                                                                                
      W-SUARTFSG1   EQ W-SUARTFSG-E                                             
      E-SUARTFSG    EQ W-SUARTFSG-HEL                                           
      E-SUARTFSGDEC EQ W-SUARTFSG-DEC                                           
                                                                                
      UTFIL EQ E-RAD                                                            
      PUT W51730D2                                                              
      W-SUBV-E     EQ W-SUBV                                                    
      W-SUARTFSG-E EQ TP-SUARTFSG                                               
      E-TIMM       EQ TP-TIMM                                                   
      E-WEEK       EQ W-TIVV                                                    
      E-KDMARK     EQ TP-KDMARK                                                 
    ELSE                                                                        
      W-SUBV-E     = W-SUBV-E + W-SUBV                                          
      W-SUARTFSG-E = W-SUARTFSG-E + TP-SUARTFSG                                 
    END-IF                                                                      
  END-IF                                                                        
                                                                                
Z-END. PROC                                                                     
  W-SUARTFSG1   EQ W-SUARTFSG-E                                                 
  E-SUARTFSG    EQ W-SUARTFSG-HEL                                               
  E-SUARTFSGDEC EQ W-SUARTFSG-DEC                                               
                                                                                
  W-SUBV1    EQ W-SUBV-E                                                        
  E-SUBV     EQ W-SUBV-HEL                                                      
  E-SUBVDEC  EQ W-SUBV-DEC                                                      
                                                                                
  IF W-SUBV-E LT 0                                                              
    E-SUBVTECK EQ '-'                                                           
    W-SUBV-E    = W-SUBV-E * -1                                                 
  ELSE                                                                          
    E-SUBVTECK EQ ' '                                                           
  END-IF                                                                        
  IF W-SUARTFSG-E LT 0                                                          
    E-SUARTFSGTECK    EQ '-'                                                    
    W-SUARTFSG-E       = W-SUARTFSG-E * -1                                      
  ELSE                                                                          
    E-SUARTFSGTECK EQ ' '                                                       
  END-IF                                                                        
  UTFIL EQ E-RAD                                                                
  PUT W51730D2                                                                  
END-PROC                                                                        
