                                                                                
*----------------------------------------------------------------------*        
*  PROGRAM    :  W3354500                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR ARTIKELDATA W01160                            *        
*             :          NOTERING    W01162                            *        
*                        NYPON-INFO  W01166                            *        
*                        BENÄMNING   W01174                            *        
* *                                                                             
*                TILL UTFIL MED ARTIKELINFO.                           *        
*                                                                      *        
*  FÖRFATTARE :  BODIL LINDAHL                                         *        
*                                                                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
*--------------------------------------*                                        
*   ARTIKELDATA                        *                                        
* -------------------------------------*                                        
FILE W33545D1                                                                   
*                                                                               
%W01160                                                                         
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  BENÄMNINGAR                         *                                        
* -------------------------------------*                                        
FILE W33545D2                                                                   
%W01174   'BEN-'                                                                
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  NOTERING                            *                                        
* -------------------------------------*                                        
FILE W33545D3                                                                   
%W01162                                                                         
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  NYPON                               *                                        
* -------------------------------------*                                        
FILE W33545D4                                                                   
%W01166                                                                         
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  UTFIL                               *                                        
* -------------------------------------*                                        
FILE W33545D5 FB (365 0)                                                        
%W33545    'UT-'                                                                
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  TEMPFILER                           *                                        
* -------------------------------------*                                        
FILE W33545D6 FB(365 0) VIRTUAL                                                 
%W33545    'TEMP1-'                                                             
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W33545D7 FB(365 0) VIRTUAL                                                 
%W33545    'TEMP2-'                                                             
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  ARBETSFÄLT                          *                                        
* -------------------------------------*                                        
*                                                                               
 JA                       W  1 A   VALUE 'J'                                    
 NEJ                      W  1 A   VALUE 'N'                                    
 IX1                      W  2 N   VALUE 0                                      
                                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
*------------------------------------------------------------------*            
* STEG 1. LÄSER ARTIKELDATA OCH BENÄMNINGAR                        *            
*         SKRIVER FIL TILL STEG 2                                  *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT (W33545D1 KEY (CLAG-IDARTNR)                             +            
           W33545D2 KEY (BEN-IDARTNR))                                          
                                                                                
 IF MATCHED                                                                     
    PERFORM AA-ARTIKELDATA                                                      
    PERFORM AB-BENAMNINGAR                                                      
    PUT W33545D6                                                                
 ELSE                                                                           
    IF W33545D1                                                                 
       PERFORM AA-ARTIKELDATA                                                   
       PUT W33545D6                                                             
    END-IF                                                                      
 END-IF                                                                         
*                                                                               
NEWPAGE                                                                         
*                                                                               
 AA-ARTIKELDATA. PROC                                                           
*                                                                               
    TEMP1-IDARTNR      =  CLAG-IDARTNR                                          
    TEMP1-IDFKNGRP     =  CLAG-IDFKNGRP                                         
    TEMP1-IDPROJ       =  CLAG-IDPROJ                                           
    TEMP1-IDPROJUP     =  CLAG-IDPROJUP                                         
    TEMP1-IDLEVNR      =  CLAG-IDLEVNR                                          
    TEMP1-KDAGE        =  CLAG-KDAGE                                            
    TEMP1-KDARTURS     =  CLAG-KDARTURS                                         
    TEMP1-KDBPSR       =  CLAG-KDBPSR                                           
    TEMP1-KDERS        =  CLAG-KDERS                                            
    TEMP1-KDPRODSL     =  CLAG-KDPRODSL                                         
    TEMP1-KDPSLLOC     =  CLAG-KDPSLLOC                                         
    TEMP1-KDSORT       =  CLAG-KDSORT                                           
    TEMP1-KDSRA        =  CLAG-KDSRA                                            
    TEMP1-KDVSOP       =  CLAG-KDVSOP                                           
    TEMP1-KVQPACK-0    =  CLAG-KVQPACK-0                                        
    TEMP1-PRARTSJK     =  CLAG-PRARTSJK                                         
    TEMP1-PRARTSTD     =  CLAG-PRARTSTD                                         
    TEMP1-TIFINLV      =  CLAG-TIFINLV                                          
    TEMP1-TIERSDAT     =  CLAG-TIERSDAT                                         
    TEMP1-VLARTNTO     =  CLAG-VLARTNTO                                         
    TEMP1-VKART        =  CLAG-VKART                                            
    TEMP1-KDUART       =  CLAG-KDUART                                           
    TEMP1-KDTIPPR      =  CLAG-KDTIPPR                                          
    TEMP1-FLIART       =  CLAG-FLIART                                           
    TEMP1-FLLSRDEL     =  CLAG-FLLSRDEL                                         
    TEMP1-IDAO(1)      =  CLAG-IDAO(1)                                          
    TEMP1-IDAO(2)      =  CLAG-IDAO(2)                                          
    TEMP1-IDANSK       =  CLAG-IDANSK                                           
    TEMP1-KDVVKL       =  CLAG-KDVVKL                                           
    TEMP1-IDINK        =  CLAG-IDINK                                            
    TEMP1-PRINK        =  CLAG-PRINK                                            
    TEMP1-IDRITN       =  CLAG-IDRITN                                           
    TEMP1-PRDIRLON     =  CLAG-PRDIRLON                                         
    TEMP1-PRDMTRL      =  CLAG-PRDMTRL                                          
    TEMP1-PROVRPAL     =  CLAG-PROVRPAL                                         
    TEMP1-IDSTATNR      = CLAG-IDSTATNR(3)                                      
    TEMP1-TIURPROD      = CLAG-TIURPROD                                         
                                                                                
    IX1 = 1                                                                     
    DO WHILE IX1 < 4                                                            
      TEMP1-IDKAT (IX1) = CLAG-IDKAT(IX1)                                       
      IX1 = IX1 + 1                                                             
    END-DO                                                                      
                                                                                
    TEMP1-IDARTNR-MOTSV = 0                                                     
    TEMP1-TEORSAK       = ' '                                                   
    TEMP1-TEARTNOT-3    = ' '                                                   
    TEMP1-FLGEMFMC      = ' '                                                   
    TEMP1-TEARTNOT-7    = ' '                                                   
                                                                                
    IX1 = 1                                                                     
    DO WHILE IX1 < 4                                                            
      TEMP1-BEART (IX1) = ' '                                                   
      IX1 = IX1 + 1                                                             
    END-DO                                                                      
                                                                                
 END-PROC                                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
 AB-BENAMNINGAR. PROC                                                           
    TEMP1-BEART (1) = BEN-BEART (4)                                             
    TEMP1-BEART (2) = BEN-BEART (8)                                             
    TEMP1-BEART (3) = BEN-BEART (10)                                            
 END-PROC                                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*------------------------------------------------------------------*            
* STEG 2. LÄSER TEMPFIL1 OCH NYPONFIL                              *            
*         SKRIVER FIL TILL STEG 3                                  *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT (W33545D6 KEY(TEMP1-IDARTNR) W33545D4 KEY(ART-IDARTNR))               
                                                                                
    IF MATCHED                                                                  
       TEMP1-IDARTNR-MOTSV = ART-IDARTNR-MOTSV                                  
       TEMP1-TEORSAK       = ART-TEORSAK                                        
       PUT W33545D7 FROM W33545D6                                               
    ELSE                                                                        
       IF W33545D6                                                              
          PUT W33545D7 FROM W33545D6                                            
       END-IF                                                                   
    END-IF                                                                      
*                                                                               
NEWPAGE                                                                         
*------------------------------------------------------------------*            
* STEG 3. LÄSER TEMPFIL2 OCH NOTERING                              *            
*         SKRIVER FIL TILL STEG 4                                  *            
* -----------------------------------------------------------------*            
*                                                                               
JOB INPUT (W33545D7 KEY(TEMP2-IDARTNR) W33545D3 KEY(NOT-IDARTNR))               
                                                                                
    IF MATCHED                                                                  
       IF NOT-KDNOTTYP = 3                                                      
          TEMP2-TEARTNOT-3 = NOT-TEARTNOT                                       
       END-IF                                                                   
       IF NOT-KDNOTTYP = 7                                                      
          TEMP2-TEARTNOT-7 = NOT-TEARTNOT                                       
       END-IF                                                                   
       IF DUPLICATE W33545D3                                                    
          IF LAST-DUP W33545D3                                                  
             PUT W33545D5 FROM W33545D7                                         
          END-IF                                                                
       ELSE                                                                     
          PUT W33545D5 FROM W33545D7                                            
       END-IF                                                                   
    ELSE                                                                        
       IF W33545D7                                                              
          PUT W33545D5 FROM W33545D7                                            
       END-IF                                                                   
    END-IF                                                                      
*                                                                               
NEWPAGE                                                                         
