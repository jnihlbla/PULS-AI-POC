                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  WXTR9T00                                              *        
*                                                                      *        
*  FUNKTION   :  ADD BINNING DATE FROM WDL6 FILE TO SDC EXTRACT        *        
*                                                                      *        
*  FÖRFATTARE :  ARCHANA BHAT                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE WXTR9TD1                                                                   
*                                                                               
%WSDCPART  'SDC-'                                                               
                                                                                
NEWPAGE                                                                         
FILE WXTR9TD2                                                                   
*                                                                               
%W61271A   'WDL6-'                                                              
                                                                                
NEWPAGE                                                                         
FILE TPFIL1 FB(11 0)                                                            
*                                                                               
%W61271A   'T1-'                                                                
                                                                                
NEWPAGE                                                                         
FILE WXTR9TD3 FB(601 0)                                                         
*                                                                               
%WSDCPART                                                                       
                                                                                
NEWPAGE                                                                         
*----------------------------------                                             
* STEP 1. SORT WDL6 EXTRACT                                                     
*----------------------------------                                             
SORT WXTR9TD2 TO TPFIL1                                 +                       
            USING (WDL6-IDARTNR, WDL6-IDDC)                                     
*------------------------------------------------------------------*            
* STEP 2. MATCH TPFIL1 WITH SDC EXTRACT                            *            
* -----------------------------------------------------------------*            
JOB INPUT(WXTR9TD1 KEY (SDC-IDARTNR, SDC-IDDC)        +                         
          TPFIL1 KEY (T1-IDARTNR, T1-IDDC))                                     
                                                                                
IF MATCHED                                                                      
                                                                                
   SDC-TIINLINL            = T1-TIINLINL                                        
                                                                                
   PUT WXTR9TD3 FROM WXTR9TD1                                                   
ELSE                                                                            
   IF WXTR9TD1                                                                  
      PUT WXTR9TD3 FROM WXTR9TD1                                                
   END-IF                                                                       
END-IF                                                                          
*                                                                               
