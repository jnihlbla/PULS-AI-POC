                                                                                
*    PROGRAMNAMN:W4260700                                       *               
*                                                               *               
*    UTFÄRDARE: KATARINA KYMMER           DATUM: 900427         *               
*    KORT BESKRIVNING: SKAPAR EN LISTA  MED ARTIKLAR FÖR        *               
*    KVALITETS KONTROLL                                         *               
*                                                                               
FILE W42607D1                                                                   
%W4260601 'IN-'                                                                 
W-TIAARP   IN-TIAARP      3 P                                                   
W-ADLAGOMR IN-ADLAGOMR    2 P                                                   
W-ADGANG   IN-ADGANG      2 P                                                   
W-ADPLATS  IN-ADPLATS     3 P                                                   
W-IDARTNR  IN-IDARTNR     5 P                                                   
W-KVLS     IN-KVLS        4 P                                                   
W-BEFT     IN-BEFT        2 P                                                   
                                                                                
FILE W42607D2 PRINTER FB(121 121)                                               
FILE W42607D3 PRINTER FB(121 121)                                               
FILE W42607D4 PRINTER FB(121 121)                                               
FILE W42607D5 PRINTER FB(121 121)                                               
FILE W42607D6 PRINTER FB(121 121)                                               
FILE W42607D7 PRINTER FB(121 121)                                               
FILE W42607D8 PRINTER FB(121 121)                                               
*                                                                               
%WDATKORT                                                                       
*                                                                               
PROGRAM-NAMN       W  6   A  VALUE 'W42607'                                     
DATUMKORT-ID       W  6   A  VALUE 'WDATUM'                                     
FELTYP             W  8   A  VALUE '        '                                   
W1-ADGANG          W  3   N  MASK 'ZZ9'                                         
W1-BEFT            W  3   N  MASK 'ZZ9'                                         
W1-KVLS            W  7   N  MASK 'ZZZZZZ9'                                     
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*                                                                               
%WY2000W7                                                                       
 W-Y2K-TIAARP      W  4   N                                                     
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT W42607D1 START A-INIT                                                 
                                                                                
    W1-BEFT   = W-BEFT                                                          
    W1-ADGANG = W-ADGANG                                                        
    W1-KVLS   = W-KVLS                                                          
    TMP1-YYRP = W-TIAARP                                                        
    PERFORM WY2000P7                                                            
    W-Y2K-TIAARP = TMP1-YYRP                                                    
    IF IN-IDDC = CDC-SE                                                         
      PRINT LISTA-CDC                                                           
    ELSE                                                                        
      IF IN-IDDC = SDC-NL                                                       
        PRINT LISTA-DC21                                                        
      ELSE                                                                      
*       IF IN-IDDC = DC22                                                       
*         PRINT LISTA-DC22                                                      
*       ELSE                                                                    
          IF IN-IDDC = SDC-GB                                                   
            PRINT LISTA-DC23                                                    
          ELSE                                                                  
            IF IN-IDDC = SDC-ES                                                 
              PRINT LISTA-DC24                                                  
            ELSE                                                                
              IF IN-IDDC = SDC-IT                                               
                PRINT LISTA-DC25                                                
              ELSE                                                              
                IF IN-IDDC = SDC-AT                                             
                  PRINT LISTA-DC26                                              
                END-IF                                                          
              END-IF                                                            
            END-IF                                                              
          END-IF                                                                
*       END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
*                                                                               
 A-INIT.  PROC                                                                  
     CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                   
 END-PROC                                                                       
*                                                                               
%WY2000P7                                                                       
*                                                                               
   REPORT LISTA-CDC +                                                           
     PRINTER W42607D2 +                                                         
      DTLCTL FIRST +                                                            
       LINESIZE 120 SPACE 1 NOADJUST NODATE                                     
     SEQUENCE  IN-IDDC    IN-IDKVAOMR IN-IDKVAGRP W-Y2K-TIAARP +                
               W-ADPLATS W-ADGANG  W-ADLAGOMR W-IDARTNR                         
     CONTROL  IN-IDDC    IN-IDKVAOMR IN-IDKVAGRP W-TIAARP NOPRINT +             
              NEWPAGE                                                           
   TITLE 01  'VOLVO CAR AFTERSALES           W42607-001           '+            
             'CENTRALLAGRET, GBG             DATUM'                +            
             D-AAR D-MAANAD D-DAG                                               
   TITLE 03  'ARTIKLAR FÖR KONTROLL  KVALITET'                                  
   TITLE 05  'LAGER         ' IN-IDDC                                           
   TITLE 06  'KONTR OMRÅDE ' COL 16 IN-IDKVAOMR  COL 19 IN-BEKVAOMR             
   TITLE 07  'KONTR GRUPP  ' IN-IDKVAGRP                                        
   TITLE 09  'PERIOD    ' W-TIAARP                                              
   HEADING W-ADLAGOMR    (' ' 'OMRÅDE')                                         
   HEADING W1-ADGANG     (' ' 'GÅNG')                                           
   HEADING W-ADPLATS     (' ' 'PLATS')                                          
   HEADING W-IDARTNR     (' ' 'ART.NR')                                         
   HEADING IN-BEART      (' ' 'BENÄMNING')                                      
   HEADING W1-BEFT       (' ' 'F-TYP')                                          
   HEADING W1-KVLS       ('LAGER' 'SALDO')                                      
   HEADING FELTYP        (' ' ' FELKODER')                                      
   LINE 1 W-ADLAGOMR W1-ADGANG  W-ADPLATS W-IDARTNR  IN-BEART +                 
          W1-BEFT W1-KVLS FELTYP                                                
   LINE 2 '                                                   '                 
NEWPAGE                                                                         
