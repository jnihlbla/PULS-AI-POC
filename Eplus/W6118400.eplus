                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6118400                                              *        
*                                                                      *        
*  FUNKTION   :  MATCHAR FILER FRÅN W6D1 OCH W6G3.                     *        
*                SKAPAR NY FIL MED NYCKLAR TILL DE                     *        
*                POSTER SOM SKALL RENSAS FRÅN W6G3.                    *        
*                SKAPAR ÄVEN HISTORIKFIL FÖR UPPFÖLJNING               *        
*                                                                      *        
*  FÖRFATTARE :  LARS THELL                                            *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING   PROJEKT/ÄT      *        
*     941208      CONNY EGHOLT .....       57053.      SDC ST....      *        
*     ......      ..................       ......      ..........      *        
*     ......      ..................       ......      ..........      *        
*     ......      ..................       ......      ..........      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W61184D1                                                                   
%W6111001  'IN10-'                                                              
*                                                                               
                                                                                
NEWPAGE                                                                         
FILE W61184D2                                                                   
%W6114101  'IN41-'                                                              
*                                                                               
                                                                                
NEWPAGE                                                                         
FILE W61184D3  FB (27 23463)                                                    
%W6118401  'UT84-'                                                              
*                                                                               
                                                                                
NEWPAGE                                                                         
FILE W61184D4  FB (46 27968)                                                    
%W6112801  'UT28-'                                                              
*                                                                               
                                                                                
NEWPAGE                                                                         
%WDATKORT                                                                       
*                                                                               
  W-DATUM          W  6   N                                                     
  W-AAR  W-DATUM       2  N                                                     
  W-MM   W-DATUM   +2  2  N                                                     
  W-DD   W-DATUM   +4  2  N                                                     
*                                                                               
PROGRAM-NAMN       W  6  A  VALUE 'WXTRA0'                                      
DATUMKORT-ID       W  6  A  VALUE 'WDATUM'                                      
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
JOB INPUT (W61184D1 KEY (IN10-IDDC       +                                      
                         IN10-IDLOPNRM)  +                                      
           W61184D2 KEY (IN41-IDDC       +                                      
                         IN41-IDLOPNRM) ) +                                     
    START A-INIT                                                                
                                                                                
  IF MATCHED                                                                    
      IF IN10-FLKLAR           = 'J'                                            
          PERFORM S11-SKRIV-W61184                                              
      END-IF                                                                    
      IF IN41-TIREGDAT         = W-DATUM                                        
          PERFORM S12-SKRIV-W61128                                              
      END-IF                                                                    
  ELSE                                                                          
      IF W61184D2                                                               
          PERFORM S11-SKRIV-W61184                                              
      END-IF                                                                    
  END-IF                                                                        
                                                                                
 A-INIT.  PROC                                                                  
                                                                                
    CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                    
    W-AAR                      = D-AAR                                          
    W-MM                       = D-MAANAD                                       
    W-DD                       = D-DAG                                          
 END-PROC                                                                       
                                                                                
 S11-SKRIV-W61184.  PROC                                                        
                                                                                
    UT84-IDPGM                 = IN41-IDPGM                                     
    UT84-TIREGDAT              = IN41-TIREGDAT                                  
    UT84-TIKLOCK               = IN41-TIKLOCK                                   
    UT84-IDSEKVNR              = IN41-IDSEKVNR                                  
    UT84-IDCPYTXT              = IN41-IDCPYTXT                                  
    PUT W61184D3                                                                
 END-PROC                                                                       
                                                                                
NEWPAGE                                                                         
                                                                                
 S12-SKRIV-W61128.  PROC                                                        
                                                                                
    UT28-IDARTNR               = IN10-IDARTNR                                   
    UT28-IDDC                  = IN41-IDDC                                      
    UT28-TIREGDAT              = IN41-TIREGDAT                                  
    UT28-TIKLOCK               = IN41-TIKLOCK                                   
    UT28-IDLOPNRM              = IN41-IDLOPNRM                                  
    UT28-IDRADNR               = IN41-IDRADNR                                   
    UT28-KDINLPRIO             = IN41-KDINLPRIO                                 
    UT28-KDINLSTA              = IN41-KDINLSTA                                  
    IF IN41-KDINLUPF-NXT       = ' '                                            
        UT28-KDINLUPF          = IN41-KDINLUPF                                  
    ELSE                                                                        
        UT28-KDINLUPF          = IN41-KDINLUPF-NXT                              
    END-IF                                                                      
    UT28-KVINLART              = IN41-KVINLART                                  
    UT28-PRARTSTD              = IN41-PRARTSTD                                  
    UT28-KVKOLLI               = IN41-KVKOLLI                                   
    UT28-FLINLI                = IN41-FLINLI                                    
    PUT W61184D4                                                                
 END-PROC                                                                       
