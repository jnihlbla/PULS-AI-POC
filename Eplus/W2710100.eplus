                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W2710100                                              *        
*                                                                      *        
*  FUNKTION   :  SKAPAR FIL MED ARTIKLAR MED ORDERINGÅNG SENASTE       *        
*                DYGNET                                                *        
*                                                                      *        
*  FÖRFATTARE :  STEFAN KIHLBERG                                       *        
*                                                                      *        
*----------------------------------------------------------------------*        
NEWPAGE                                                                         
FILE W27101D1                                                                   
%W01186  'OLD-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W27101D2                                                                   
%W01186  'NEW-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W27101D3 FB (19 0)                                                         
%W27101   'W27101-'                                                             
                                                                                
*--------------------------*                                                    
* DATUMKORT                *                                                    
*--------------------------*                                                    
                                                                                
                                                                                
%WDATKORT 'DATKORT-'                                                            
                                                                                
*--------------------------*                                                    
* DATAREA                  *                                                    
*--------------------------*                                                    
                                                                                
NEWPAGE                                                                         
%WDATAREA                                                                       
                                                                                
                                                                                
*--------------------------*                                                    
* DAGAREA                  *                                                    
*--------------------------*                                                    
                                                                                
NEWPAGE                                                                         
%WDAGAREA                                                                       
                                                                                
  PROGRAM-NAMN          W  6 A   VALUE 'W27101'                                 
  DATUMKORT-ID          W  6 A   VALUE 'WDATUM'                                 
  WDATKONV              W  8 A   VALUE 'WDATKONV'                               
  WS-KVOI-LAST-DAY       W   7  N                                               
  TRAFF                  W   1  A     VALUE 'N'                                 
                                                                                
  DAGENS-DATUM        W                     6   N                               
  DAGENS-DATUM-AA     DAGENS-DATUM          2   N                               
  DAGENS-DATUM-MM     DAGENS-DATUM       +2 2   N                               
  DAGENS-DATUM-DD     DAGENS-DATUM       +4 2   N                               
                                                                                
  DD-TIAAVVD                          W   5  N                                  
  DD-TIAA             DD-TIAAVVD          2  N                                  
  DD-TIVV             DD-TIAAVVD      +2  2  N                                  
  DD-TID              DD-TIAAVVD      +2  1  N                                  
                                                                                
  IX                     W   2  N                                               
  SPAR-IX                W   2  N                                               
  WS-NEW-DC-KVOI-INNEV   W   4  P 0                                             
  WS-OLD-DC-KVOI-INNEV   W   4  P 0                                             
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. MATCHAR GÅRDAGENS FIL MED L7 UPPGIFTER MED                            
*         DAGENS.                                                               
*         SAMLAR UPPGIFTER OM DET SENASTE DYGNETS ORDER-                        
*         INGÅNG SAMT ORDERTRÄFFAR DET SENASTE ÅRET                             
*         (NDC SENASTE TRE ÅREN). SKAPAR UTFIL MED                              
*         ARTIKLAR MED ORDERINGÅNG.                                             
*                                                                               
*                                                                               
*                                                                               
                                                                                
JOB INPUT(W27101D1 KEY (OLD-DC-IDARTNR OLD-DC-IDDC) +                           
          W27101D2 KEY (NEW-DC-IDARTNR NEW-DC-IDDC)) +                          
START(A-INIT)                                                                   
                                                                                
    IF RECORD-COUNT(W27101D2) = 1      +                                        
    AND W27101D2                                                                
       PERFORM HAMTA-VECKO-IX                                                   
    END-IF                                                                      
                                                                                
    IF MATCHED                                                                  
       PERFORM KOLLA-ORDERING-MATCHAD                                           
       IF WS-KVOI-LAST-DAY > 0                                                  
          PERFORM SKAPA-W27101-MATCHAD                                          
          PUT W27101D3                                                          
       END-IF                                                                   
    ELSE                                                                        
       IF W27101D2                                                              
          PERFORM KOLLA-ORDERING-EJ-MATCHAD                                     
          IF WS-KVOI-LAST-DAY > 0                                               
             PERFORM SKAPA-W27101-EJ-MATCHAD                                    
             PUT W27101D3                                                       
          END-IF                                                                
       END-IF                                                                   
    END-IF                                                                      
A-INIT. PROC                                                                    
                                                                                
                                                                                
*  HÄMTA DATUM FRÅN DATKORT                                                     
                                                                                
   CALL DATKORT USING (PROGRAM-NAMN +                                           
                       DATUMKORT-ID +                                           
                       DATKORT-DATUMKORT)                                       
                                                                                
   MOVE DATKORT-D-AAR   TO DAGENS-DATUM-AA                                      
   MOVE DATKORT-D-MAANAD TO DAGENS-DATUM-MM                                     
   MOVE DATKORT-D-DAG   TO DAGENS-DATUM-DD                                      
                                                                                
   DISPLAY 'DAGENS DATUM = ' DAGENS-DATUM                                       
                                                                                
*  HÄMTA DAGENS VECKA                                                           
*                                                                               
                                                                                
   DAT-I-TIDATUM = DAGENS-DATUM                                                 
   DAT-KDDATFORM = 'AAMMDD'                                                     
   CALL WDATKONV USING (DAT-KDDATFORM  +                                        
                        DAT-I-TIDATUM  +                                        
                        DAT-O-TIDATUM  +                                        
                        DAT-KDSVAR)                                             
   IF DAT-KDSVAR = ' '                                                          
      DD-TIAAVVD        = DAT-TIAAVVD                                           
   ELSE                                                                         
      DISPLAY 'FEL FRÅN DATKONV 1 I A-INIT'                                     
      STOP EXECUTE                                                              
   END-IF                                                                       
                                                                                
   DISPLAY 'DD-TIVV = ' DD-TIVV                                                 
END-PROC                                                                        
                                                                                
                                                                                
HAMTA-VECKO-IX. PROC                                                            
       IX = 1                                                                   
       DO WHILE IX LT 6 AND TRAFF NE 'J'                                        
          DISPLAY 'NEW-TIVV = ' NEW-DC-TIVV(IX)                                 
          IF NEW-DC-TIVV(IX) = DD-TIVV                                          
             SPAR-IX = IX                                                       
             TRAFF = 'J'                                                        
          END-IF                                                                
          IX = IX + 1                                                           
       END-DO                                                                   
END-PROC                                                                        
                                                                                
                                                                                
KOLLA-ORDERING-MATCHAD. PROC                                                    
                                                                                
      WS-KVOI-LAST-DAY = 0                                                      
      WS-NEW-DC-KVOI-INNEV = NEW-DC-KVOI-INNEV   (SPAR-IX)  +                   
                           + NEW-DC-KVOI-PP-INNEV(SPAR-IX)                      
      WS-OLD-DC-KVOI-INNEV = OLD-DC-KVOI-INNEV   (SPAR-IX)  +                   
                           + OLD-DC-KVOI-PP-INNEV(SPAR-IX)                      
                                                                                
      IF WS-NEW-DC-KVOI-INNEV GT WS-OLD-DC-KVOI-INNEV                           
         WS-KVOI-LAST-DAY = WS-NEW-DC-KVOI-INNEV            +                   
                          - WS-OLD-DC-KVOI-INNEV                                
      END-IF                                                                    
END-PROC                                                                        
                                                                                
                                                                                
KOLLA-ORDERING-EJ-MATCHAD. PROC                                                 
                                                                                
      WS-KVOI-LAST-DAY = 0                                                      
      WS-KVOI-LAST-DAY = NEW-DC-KVOI-INNEV   (SPAR-IX) +  +                     
                         NEW-DC-KVOI-PP-INNEV(SPAR-IX)                          
END-PROC                                                                        
                                                                                
                                                                                
                                                                                
                                                                                
SKAPA-W27101-MATCHAD. PROC                                                      
      W27101-IDARTNR        = NEW-DC-IDARTNR                                    
      W27101-IDDC           = NEW-DC-IDDC                                       
      W27101-KVOI-LAST-DAY  = WS-KVOI-LAST-DAY                                  
      W27101-TIREFEFT-OLD   = OLD-DC-TIREFEFT                                   
      W27101-TIREFEFT-NEW   = NEW-DC-TIREFEFT                                   
END-PROC                                                                        
                                                                                
SKAPA-W27101-EJ-MATCHAD. PROC                                                   
      W27101-IDARTNR        = NEW-DC-IDARTNR                                    
      W27101-IDDC           = NEW-DC-IDDC                                       
      W27101-KVOI-LAST-DAY  = WS-KVOI-LAST-DAY                                  
      W27101-TIREFEFT-OLD   = 0                                                 
      W27101-TIREFEFT-NEW   = NEW-DC-TIREFEFT                                   
END-PROC                                                                        
