*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE W2713BD1                                                                   
*                                                                               
%W2713A       'IN-'                                                             
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W2713BD3 VB (75 0) PRINTER                                                 
*                                                                               
*                                                                               
  UT-IDARTNR           W  9  N      MASK 'ZZZZZZZZ9'                            
  UT-IDDC              W  2  A                                                  
  UT-IDPERSON-BUY      W  2  P      MASK 'ZZ9'                                  
  UT-BEART             W 25  A                                                  
  UT-KVPBREOI          W  4  P  1   MASK 'ZZZZZ9.9-'                            
  UT-NY-KVPBREOI       W  4  P  1   MASK 'ZZZZZ9.9-'                            
                                                                                
  SW-FIRST             W  1  A  VALUE 'J'                                       
                                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
  JA                        W   1  A   VALUE 'J'                                
  NEJ                       W   1  A   VALUE 'N'                                
  W-SEM1                    W   1  A   VALUE ';'                                
*                                                                               
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT W2713BD1 +                                                          
      NAME   STEG01                                                             
                                                                                
     UT-IDARTNR          = IN-IDARTNR                                           
     UT-IDDC             = IN-IDDC                                              
     UT-IDPERSON-BUY     = IN-IDPERSON-BUY                                      
     UT-BEART            = IN-BEART                                             
     UT-KVPBREOI         = IN-KVPBREOI                                          
     UT-NY-KVPBREOI      = IN-NY-KVPBREOI                                       
                                                                                
        PRINT RAPPORT01                                                         
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    REPORT SECTION                              *              
*----------------------------------------------------------------*              
*                                                                               
    REPORT RAPPORT01 PRINTER W2713BD3                            +              
                     LINESIZE      70                            +              
                     NODATE                                      +              
                     NOHEADING                                   +              
                     NOADJUST                                    +              
                     NOSPREAD                                    +              
                     SPACE          0                                           
*                                                                               
    LINE 01                         +                                           
              UT-IDPERSON-BUY       +                                           
              W-SEM1                +                                           
              UT-IDARTNR            +                                           
              W-SEM1                +                                           
              UT-IDDC               +                                           
              W-SEM1                +                                           
              UT-BEART              +                                           
              W-SEM1                +                                           
              UT-KVPBREOI           +                                           
              W-SEM1                +                                           
              UT-NY-KVPBREOI        +                                           
              W-SEM1                                                            
                                                                                
*                                                                               
BEFORE-LINE. PROC                                                               
 IF SW-FIRST = JA                                                               
   DISPLAY '¤DAPW27139-002'                                                     
   DISPLAY '¤DAPW27139'                                                         
   DISPLAY 'BUYER;PART NO;DC;PART DESCRIPTION;CURRENT PB;NEW PB;'               
   SW-FIRST = NEJ                                                               
 END-IF                                                                         
END-PROC                                                                        
