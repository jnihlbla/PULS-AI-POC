                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W44059                                                *        
*                                                                      *        
*  FUNKTION   :  UNDERHÅLLER UPPFÖLJNINGSFIL FÖR AKTIVA VOR-RADER      *        
*                SKAPAR FIL MED FÖRÄNDRADE VOR-RADER                   *        
*                                                                      *        
*  FÖRFATTARE :  G KJELLSON                                            *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
* DAGEXTRAKT (W44062)                                                           
FILE W44059D1                                                                   
%W440058   'VOR-'                                                               
                                                                                
* GAMMAL AKTIVA VOR-RADER (W44060 )                                             
FILE W44059D2                                                                   
%W440058   'OLD-'                                                               
                                                                                
* NYA AKTIVA VOR-RADER (W44060)                                                 
FILE W44059D3 FB(293 0)                                                         
%W440058   'NEW-'                                                               
                                                                                
* ÄNDRADE VOR-RADER (W44067)                                                    
FILE W44059D4 FB(293 0)                                                         
%W440058      'CHG-'                                                            
                                                                                
* BORTTAGNA VOR-RADER (W44067D)                                                 
FILE W44059D5 FB(293 0)                                                         
%W440058      'DEL-'                                                            
                                                                                
                                                                                
JOB INPUT (W44059D1 KEY (VOR-IDDISTR VOR-IDKUNDNR VOR-IDORDNR7-URSP +           
                       VOR-IDARTNR) +                                           
           W44059D2 KEY (OLD-IDDISTR OLD-IDKUNDNR +                             
                           OLD-IDORDNR7-URSP OLD-IDARTNR))                      
                                                                                
IF MATCHED                                                                      
   PERFORM SKAPA-NEW                                                            
   IF VOR-W440058 NE OLD-W440058                                                
      PERFORM SKAPA-CHG                                                         
   END-IF                                                                       
ELSE                                                                            
   IF W44059D1                                                                  
      PERFORM SKAPA-NEW                                                         
      PERFORM SKAPA-CHG                                                         
   ELSE                                                                         
      PERFORM SKAPA-DEL                                                         
   END-IF                                                                       
END-IF                                                                          
                                                                                
SKAPA-NEW. PROC                                                                 
                                                                                
      NEW-W440058       = VOR-W440058                                           
      PUT W44059D3                                                              
END-PROC                                                                        
                                                                                
SKAPA-CHG. PROC                                                                 
                                                                                
      CHG-W440058       = VOR-W440058                                           
      PUT W44059D4                                                              
END-PROC                                                                        
                                                                                
SKAPA-DEL. PROC                                                                 
                                                                                
      DEL-W440058       = OLD-W440058                                           
      PUT W44059D5                                                              
END-PROC                                                                        
                                                                                
