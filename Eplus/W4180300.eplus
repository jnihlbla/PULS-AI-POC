FILE W41803D1                                                                   
IN-DATA                   1   87 A                                              
IN-TYP IN-DATA                 3 A                                              
*                                                                               
%W418R14                                                                        
*                                                                               
NEWPAGE                                                                         
FILE W41803D2 VB(283 0)                                                         
*                                                                               
%W41803 'UT-'                                                                   
*                                                                               
NEWPAGE                                                                         
*                                                                               
*---- WS-STORAGE                                                                
   JA                         W   1  A     VALUE 'J'                            
   NEJ                        W   1  A     VALUE 'N'                            
   WS-IDLEVANM                W   7  A                                          
     WS-IDLEVANM-NUM WS-IDLEVANM  7  N                                          
   WS-KDANMORS                W   2  N     VALUE 0                              
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
*NEWPAGE                                                                        
*-------------*                                                                 
* JOB         *                                                                 
*-------------*                                                                 
*                                                                               
JOB INPUT W41803D1                                                              
*                                                                               
   IF IN-TYP = 'R14'                                                            
      W418R14                            = IN-DATA                              
      PERFORM B-FLYTTA                                                          
                                                                                
      PUT W41803D2                                                              
   END-IF                                                                       
*                                                                               
 B-FLYTTA.  PROC                                                                
*                                                                               
     UT-IDPTYP                           = 'BAT'                                
     UT-IDDISTR                          = IDDISTR                              
     UT-IDKUNDNR                         = IDKUNDNR                             
     WS-IDLEVANM                         = IDLEVANM                             
     UT-IDRAPPNR                         = WS-IDLEVANM-NUM                      
     UT-IDARTNR                          = IDARTNR                              
     UT-IDRADNR                          = IDRADNR                              
     IF FLDIRLEV = 1                                                            
        UT-FLDIRLEV                      = 'J'                                  
     ELSE                                                                       
        UT-FLDIRLEV                      = 'N'                                  
     END-IF                                                                     
     UT-IDFAKT                           = IDFAKT                               
     UT-IDKOLLI                          = IDKOLLI                              
     UT-IDORDNR                          = IDORDNR                              
     WS-KDANMORS                         = KDANMORS                             
     UT-KDANMORS                         = WS-KDANMORS                          
     UT-IDDC                             = KDCLAGER                             
     UT-KDEMBLEV                         = KDEMBLEV                             
     UT-KDFAKTYP                         = KDFAKTYP                             
     UT-KDFRAKT                          = KDFRAKT                              
     UT-KVLEVANM                         = KVLEVANM                             
     UT-PRARTBTO                         = PRARTBTO                             
     UT-PRARTBTO-LOC                     = PRARTBTO-LOC                         
     UT-KDVALISO                         = KDVALISO                             
     UT-TIFAKT                           = TIFAKT                               
     UT-TILEVANM                         = TIM-LEVANM                           
                                                                                
     UT-TEANMNOT-REG (1)                 = ' '                                  
     UT-TEANMNOT-REG (2)                 = ' '                                  
     UT-TEANMNOT-REG (3)                 = ' '                                  
                                                                                
 END-PROC                                                                       
