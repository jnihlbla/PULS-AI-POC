                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W1168600                                              *        
*                                                                      *        
*  FUNKTION   :  PROGRAMMET LÄSER FIL W11685(NEDLÄST WDF5),            *        
*                MATCHAR MOT W01160 OCH SKRIVER LEVERANTÖRENS          *        
*                ARTIKELBENÄMNING.                                     *        
*                                                                      *        
*  FÖRFATTARE :  BODIL LINDAHL                                         *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W11686D1                                                                   
*                                                                               
%W11685  'LEV-'                                                                 
*                                                                               
NEWPAGE                                                                         
FILE W11686D2                                                                   
*                                                                               
%W01160                                                                         
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W11686D3 FB (41 0)                                                         
%W11685  'UT-'                                                                  
*                                                                               
NEWPAGE                                                                         
*                                                                               
*******************************************                                     
* MATCHAR W11685 OCH W01160                                                     
*******************************************                                     
*                                                                               
JOB INPUT (W11686D2 KEY (CLAG-IDARTNR CLAG-IDLEVNR) +                           
           W11686D1 KEY (LEV-IDARTNR LEV-IDLEVNR))                              
                                                                                
     IF MATCHED                                                                 
        IF DUPLICATE W11686D1                                                   
********** ARTIKEL FÖREKOMMER FLERA GÅNGER PÅ LEVFIL                            
           IF LAST-DUP  W11686D1                                                
              UT-IDLEVNR  = LEV-IDLEVNR                                         
              UT-BELEVART = LEV-BELEVART                                        
              UT-IDBENR   = LEV-IDBENR                                          
              PERFORM S01-SKRIV-UTFIL                                           
           END-IF                                                               
        ELSE                                                                    
           UT-IDLEVNR  = LEV-IDLEVNR                                            
           UT-BELEVART = LEV-BELEVART                                           
           UT-IDBENR   = LEV-IDBENR                                             
           PERFORM S01-SKRIV-UTFIL                                              
        END-IF                                                                  
     ELSE                                                                       
        IF W11686D2                                                             
           UT-IDLEVNR  = CLAG-IDLEVNR                                           
           UT-BELEVART = ' '                                                    
           UT-IDBENR   = 0                                                      
           PERFORM S01-SKRIV-UTFIL                                              
        END-IF                                                                  
     END-IF                                                                     
*                                                                               
NEWPAGE                                                                         
*                                                                               
  S01-SKRIV-UTFIL. PROC                                                         
     UT-IDARTNR = CLAG-IDARTNR                                                  
     PUT W11686D3                                                               
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
