NEWPAGE                                                                         
*    --- VALID IDDC CODES                                                       
%WWDC99                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
  JA                        W   1 A   VALUE 'J'                                 
  NEJ                       W   1 A   VALUE 'N'                                 
  1A                        W   2 A   VALUE '1A'                                
  2A                        W   2 A   VALUE '2A'                                
  SPAR-IDDC                 W   2 A   VALUE '  '                                
*                                                                               
*COPYTEXTER FÖR CALL                                                            
*                                                                               
%WL10WBDC                                                                       
*                                                                               
    PROGRAM-NAMN          W          6         A  VALUE 'W47930'                
    WS1START              W          8         A  VALUE 'WS1START'              
    LDC-1A                W          2         A  VALUE '1A'                    
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*SORTERA W47923 (WXTRA0) PÅ DC OCH ARTNR.                                       
***                                                                             
SORT W47930D1 TO W47930D4 USING (W47923-IDDC W47923-IDARTNR)                    
*                                                                               
*SORTERA PÅ DC OCH ARTNR.                                                       
***                                                                             
SORT W47930D2 TO W47930D5 USING (SLAG-IDDC SLAG-IDARTNR)                        
***                                                                             
  JOB INPUT (W47930D5 KEY (SORT2-SLAG-IDDC SORT2-SLAG-IDARTNR)      +           
             W47930D4 KEY (SORT1-IDDC SORT1-IDARTNR))                           
                                                                                
    IF MATCHED                                                                  
      WBDC-IDDC = SORT1-IDDC                                                    
      CALL WL10WBDC USING WBDC-AREA                                             
      IF WBDC-FLWEBDC = 'J'                                                     
                                                                                
*     DISPLAY 'SORT1-FLFYSAVV= ' SORT1-FLFYSAVV                                 
*     DISPLAY 'SORT1-KVBEART = ' SORT1-KVBEART                                  
*     DISPLAY 'SORT1-KVAVBART= ' SORT1-KVAVBART                                 
*     DISPLAY 'SORT1-KVLEVART= ' SORT1-KVLEVART                                 
                                                                                
        SPAR-IDDC = SORT1-IDDC                                                  
        PERFORM S23-CHECK-SPAR-IDDC                                             
        IF  SORT1-FLFYSAVV = NEJ                                    +           
        AND SORT1-KVBEART  > SORT1-KVAVBART                         +           
        AND SORT1-KVAVBART = SORT1-KVLEVART                                     
        ELSE                                                                    
          TEMP-W47930-IDDC      = SORT1-IDDC                                    
          TEMP-W47930-IDDISTR   = SORT1-IDDISTR                                 
          TEMP-W47930-IDKUNDNR  = SORT1-IDKUNDNR                                
          TEMP-W47930-IDORDER   = SORT1-IDORDER                                 
          TEMP-W47930-IDPRODNR  = SORT1-IDPRODNR                                
          TEMP-W47930-IDARTNR   = SORT1-IDARTNR                                 
          TEMP-W47930-FLFYSAVV  = SORT1-FLFYSAVV                                
          TEMP-W47930-KVBEART   = SORT1-KVBEART                                 
          TEMP-W47930-KVLEVART  = SORT1-KVLEVART                                
          TEMP-W47930-KVAVBART  = SORT1-KVAVBART                                
          TEMP-W47930-ADLAGOMR  = SORT1-ADLAGOMR                                
          TEMP-W47930-IDUSER    = SORT1-IDUSER                                  
          TEMP-W47930-TIBEGPAC  = SORT1-TIBEGPAC                                
          TEMP-W47930-KVLS      = SORT2-SLAG-KVLS                               
          IF SPAR-IDDC = NDC                                                    
            TEMP-W47930-KVOKS   =                                   +           
                   SORT2-SLAG-KVOKS-BULK + SORT2-SLAG-KVOKS-DAG                 
          ELSE                                                                  
            TEMP-W47930-KVOKS   = SORT2-SLAG-KVOKS-DAG                          
          END-IF                                                                
          TEMP-W47930-ADGANG    = SORT2-SLAG-ADGANG                             
          TEMP-W47930-ADPLATS   = SORT2-SLAG-ADPLATS                            
                                                                                
          PUT W47930D6                                                          
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
                                                                                
*    --- S23-CHECK-SPAR-IDDC (MACRO PROCEDURE)                                  
%WWDC02 'SPAR-'                                                                 
*                                                                               
NEWPAGE                                                                         
***                                                                             
SORT W47930D6 TO W47930D7 USING +                                               
                (TEMP-W47930-IDORDER TEMP-W47930-IDDC)                          
***                                                                             
                                                                                
    JOB INPUT (W47930D3 KEY (ODEL-IDORDER ODEL-IDDC)             +              
               W47930D7 KEY (SORT3-IDORDER SORT3-IDDC))                         
                                                                                
    IF NOT EOF W47930D3 OR EOF W47930D7                                         
                                                                                
    IF MATCHED                                                                  
      WBDC-IDDC = ODEL-IDDC                                                     
      CALL WL10WBDC USING WBDC-AREA                                             
      IF WBDC-FLWEBDC = 'J'                                                     
        SPAR-IDDC = SORT3-IDDC                                                  
                                                                                
        IF  SORT3-FLFYSAVV = NEJ                             +                  
        AND SORT3-KVBEART  > SORT3-KVAVBART                  +                  
        AND SORT3-KVAVBART = SORT3-KVLEVART                                     
        ELSE                                                                    
          TEMP-UT-IDORDNR5 = ODEL-IDORDNR7                                      
          TEMP-UT-IDDC     = SORT3-IDDC                                         
          TEMP-UT-IDDISTR  = SORT3-IDDISTR                                      
          TEMP-UT-IDKUNDNR = SORT3-IDKUNDNR                                     
          TEMP-UT-IDORDER  = SORT3-IDORDER                                      
          TEMP-UT-IDPRODNR = SORT3-IDPRODNR                                     
          TEMP-UT-IDARTNR  = SORT3-IDARTNR                                      
          TEMP-UT-KVBEART  = SORT3-KVBEART                                      
          TEMP-UT-KVLEVART = SORT3-KVLEVART                                     
          TEMP-UT-KVAVBART = SORT3-KVAVBART                                     
          TEMP-UT-KVLS     = SORT3-KVLS                                         
          TEMP-UT-KVOKS    = SORT3-KVOKS                                        
          TEMP-UT-ADLAGOMR = SORT3-ADLAGOMR                                     
          TEMP-UT-ADGANG   = SORT3-ADGANG                                       
          TEMP-UT-ADPLATS  = SORT3-ADPLATS                                      
          TEMP-UT-IDUSER   = SORT3-IDUSER                                       
          TEMP-UT-TIBEGPAC = SORT3-TIBEGPAC                                     
          TEMP-UT-FLFYSAVV = SORT3-FLFYSAVV                                     
                                                                                
          PUT W47930D8                                                          
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
                                                                                
END-IF                                                                          
                                                                                
***                                                                             
SORT W47930D8 TO W47930D9 USING +                                               
                (TEMP-UT-IDDC   +                                               
                 TEMP-UT-IDDISTR +                                              
                 TEMP-UT-IDKUNDNR +                                             
                 TEMP-UT-IDARTNR )                                              
***                                                                             
                                                                                
