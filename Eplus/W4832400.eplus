                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4832400                                              *        
*                                                                      *        
*  FUNKTION   :  READ W48323 (OR VYYWW.FRAKT) CONTAINING               *        
*                TRANSPORTS INFORMATION AND CREATE A FILE              *        
*                WITH INFO ABOUT PSN NUMBERS AND RELATED DATA.         *        
*                IT WILL BE USED AS INPUT TO UPDATE DB2 TABLES         *        
*                USED IN A WEB BASED DATA WAREHOUSE SYSTEM (Q&A)       *        
*                                                                      *        
*  FÖRFATTARE :  KJELL A                                               *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W48324D1                                                                   
*                                                                               
%W4832301  'IN-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W48324D2 FB(22  0)                                                         
*                                                                               
%W4832401 'UT-'                                                                 
                                                                                
IX        W    2   N   VALUE 1                                                  
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. EXTRACT PSN INFO                                                      
*                                                                               
JOB INPUT W48324D1                                                              
                                                                                
  IX = 1                                                                        
  DO WHILE IX <= 10                                                             
    IF IN-IDPSN(IX) NE 0                                                        
      UT-TILASTN       = IN-TILASTN                                             
      UT-IDPRODNR      = IN-IDPRODNR                                            
      UT-IDKOLLI       = IN-IDKOLLI                                             
      UT-IDPSN         = IN-IDPSN    (IX)                                       
      UT-VKART-FG      = IN-VKART-FG (IX)                                       
      UT-VLFG          = IN-VLFG     (IX)                                       
      PUT W48324D2                                                              
    END-IF                                                                      
                                                                                
    IX = IX + 1                                                                 
  END-DO                                                                        
