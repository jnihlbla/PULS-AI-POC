                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4885200                                              *        
*                                                                      *        
*  FUNKTION  1:  SKAPA EN NY LOC-NDC AV W01184-UTSEENDE MED ENBART     *        
*                KVPB-REF DÄR IDLEVNR INTE ÄR '1441 '.                 *        
*            2:  SORTERA LOC-NDC I ARTIKELNUMMERORDNING.               *        
*            3:  MATCHA SORTFILEN MED W48852A(+0) FRÅN FÖREG JOBB OCH  *        
*                SUBTRAHERA LOC-NDC-KVPB-REF FRÅN W48852-KVPB-TOT.     *        
*                                                                      *        
*  FÖRFATTARE :                                                        *        
*     DATUM       NAMN                     AVDELNING                   *        
*   2003-02-17    CONNY EGHOLT......       9232..                      *        
*                                                                      *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*     DATUM       NAMN                     AVDELNING                   *        
*   2015-10-26    RAHUL REDDY              ADD BEART.ETRACKER 10263392 *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W48852D1                                                                   
%W01184  'NDC-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W48852D2 FB(483 0)                                                         
%W01184  'LOC-NDC-'                                                             
                                                                                
NEWPAGE                                                                         
FILE W48852D3 FB(483 0)                                                         
%W01184  'SORT-NDC-'                                                            
                                                                                
NEWPAGE                                                                         
FILE W48852D4                                                                   
%W4885601  'INHL-'                                                              
                                                                                
NEWPAGE                                                                         
FILE W48852D5  FB(54 0)                                                         
%W4885601  'UTHL-'                                                              
*------------------------------------------------------------                   
NEWPAGE                                                                         
%W4885601 'WS-'                                                                 
                                                                                
*------------------------------------------------------------                   
NEWPAGE                                                                         
*                                                                               
* STEG 1. SKAPA EN RENODLAD NDC-W01184, MED LEVNR <> 1441                       
*                               PÅ DC=41,42,43,51,61,62                         
JOB INPUT W48852D1                                                              
                                                                                
  IF NDC-SLAG-IDLEVNR NE '1441 '                                                
     PUT W48852D2 FROM W48852D1                                                 
  END-IF                                                                        
*------------------------------------------------------------                   
NEWPAGE                                                                         
*                                                                               
* STEG 2. SORTAR NDC-ARTIKLAR I STIGANDE ORDNING                                
*                                                                               
SORT W48852D2 TO +                                                              
     W48852D3 USING (LOC-NDC-SLAG-IDARTNR) SIZE 40000                           
                                                                                
*------------------------------------------------------------                   
NEWPAGE                                                                         
*                                                                               
* STEG 3. MATCH AV SORTADE LOC-NDC-FILEN OCH W48852D4                           
*                                                                               
JOB INPUT (  W48852D4 KEY (INHL-IDARTNR) +                                      
             W48852D3 KEY (SORT-NDC-SLAG-IDARTNR) +                             
          )                                                                     
  IF MATCHED                                                                    
                                                                                
    IF DUPLICATE W48852D3                                                       
      IF FIRST-DUP W48852D3                                                     
*       -- Spara INHL-arean                                                     
        WS-W4885601 = INHL-W4885601                                             
      END-IF                                                                    
                                                                                
      IF NOT LAST-DUP W48852D3                                                  
*     --- Subtrahera för alla duplicater utom den sista                         
        WS-KVPB-TOT = WS-KVPB-TOT - SORT-NDC-SLAG-KVPB-REF                      
      END-IF                                                                    
                                                                                
      IF LAST-DUP W48852D3                                                      
*     --- Subtrahera för den sista duplikaten och skriv post                    
        WS-KVPB-TOT = WS-KVPB-TOT - SORT-NDC-SLAG-KVPB-REF                      
        UTHL-W4885601 = WS-W4885601                                             
        PUT W48852D5                                                            
      END-IF                                                                    
                                                                                
    ELSE                                                                        
*     --- Subtrahera för enkel match-post och skriv ut den                      
      INHL-KVPB-TOT = INHL-KVPB-TOT - SORT-NDC-SLAG-KVPB-REF                    
      PUT W48852D5 FROM W48852D4                                                
    END-IF                                                                      
                                                                                
  ELSE                                                                          
    IF W48852D4                                                                 
*     --- Skriv ut INHL-post som inte har KVPB på LOC-NDC.                      
      PUT W48852D5 FROM W48852D4                                                
    END-IF                                                                      
  END-IF                                                                        
                                                                                
