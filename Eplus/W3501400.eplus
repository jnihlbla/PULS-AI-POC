FILE W35014D5 PRINTER FB(121 121)                                               
FILE W35014D6 PRINTER FB(121 121)                                               
FILE W35014D7 PRINTER FB(121 121)                                               
NEWPAGE                                                                         
W-PGMNAMN   W  6  A  VALUE 'W35014'                                             
W-WDATUM    W  6  A  VALUE 'WDATUM'                                             
                                                                                
%WDATKORT                                                                       
                                                                                
NEWPAGE                                                                         
*------------------------*                                                      
* ARBETSAREOR            *                                                      
*------------------------*                                                      
                                                                                
TIAAPP-IFJOL               W  4   N                                             
TIAA-IFJOL  TIAAPP-IFJOL      2   N                                             
TIPP-IFJOL  TIAAPP-IFJOL +2   2   N                                             
                                                                                
TIAAPP-IÅR                 W  4   N                                             
TIAA-IÅR    TIAAPP-IÅR        2   N                                             
TIPP-IÅR    TIAAPP-IÅR   +2   2   N                                             
                                                                                
%WY2000W6                                                                       
                                                                                
                                                                                
NEWPAGE                                                                         
*------------------------*                                                      
* JOB                    *                                                      
*------------------------*                                                      
                                                                                
JOB INPUT W35014D1 START INIT-PROC                                              
                                                                                
   S1-ANTAL-MÅN-IÅR    = 0                                                      
   S1-BELOPP-MÅN-IÅR   = 0                                                      
   S1-ANTAL-TOT-IÅR    = 0                                                      
   S1-BELOPP-TOT-IÅR   = 0                                                      
   S1-ANTAL-MÅN-IFJOL  = 0                                                      
   S1-BELOPP-MÅN-IFJOL = 0                                                      
   S1-ANTAL-TOT-IFJOL  = 0                                                      
   S1-BELOPP-TOT-IFJOL = 0                                                      
   S1-KDPRODSL         = KDPRODSL                                               
   S1-KDSORT2          = KDSORT2                                                
   S1-IDSKYLT          = IDSKYLT                                                
                                                                                
   S2-ANTAL-MÅN-IÅR    = 0                                                      
   S2-BELOPP-MÅN-IÅR   = 0                                                      
   S2-ANTAL-TOT-IÅR    = 0                                                      
   S2-BELOPP-TOT-IÅR   = 0                                                      
   S2-ANTAL-MÅN-IFJOL  = 0                                                      
   S2-BELOPP-MÅN-IFJOL = 0                                                      
   S2-ANTAL-TOT-IFJOL  = 0                                                      
   S2-BELOPP-TOT-IFJOL = 0                                                      
   S2-KDPRODSL         = KDPRODSL                                               
   S2-IDFKNGRP         = IDFKNGRP                                               
   S2-KDSORT2          = KDSORT2                                                
   S2-IDSKYLT          = IDSKYLT                                                
   S2-FKNTUSEN         = IDFKNGRP / 1000                                        
                                                                                
NEWPAGE                                                                         
   S3-ANTAL-MÅN-IÅR    = 0                                                      
   S3-BELOPP-MÅN-IÅR   = 0                                                      
   S3-ANTAL-TOT-IÅR    = 0                                                      
   S3-BELOPP-TOT-IÅR   = 0                                                      
   S3-ANTAL-MÅN-IFJOL  = 0                                                      
   S3-BELOPP-MÅN-IFJOL = 0                                                      
   S3-ANTAL-TOT-IFJOL  = 0                                                      
   S3-BELOPP-TOT-IFJOL = 0                                                      
   S3-KDPRODSL         = KDPRODSL                                               
   S3-IDFKNGRP         = IDFKNGRP                                               
   S3-KDSORT2          = KDSORT2                                                
   S3-IDSKYLT          = IDSKYLT                                                
   S3-FKNTUSEN         = IDFKNGRP / 1000                                        
                                                                                
   IF TIAAPP = TIAAPP-IÅR                                                       
      S1-ANTAL-MÅN-IÅR    = KVANTAL                                             
      S1-BELOPP-MÅN-IÅR   = SUFKTBEL                                            
      S1-ANTAL-TOT-IÅR    = KVANTAL                                             
      S1-BELOPP-TOT-IÅR   = SUFKTBEL                                            
                                                                                
      S2-ANTAL-MÅN-IÅR    = KVANTAL                                             
      S2-BELOPP-MÅN-IÅR   = SUFKTBEL                                            
      S2-ANTAL-TOT-IÅR    = KVANTAL                                             
      S2-BELOPP-TOT-IÅR   = SUFKTBEL                                            
                                                                                
      S3-ANTAL-MÅN-IÅR    = KVANTAL                                             
      S3-BELOPP-MÅN-IÅR   = SUFKTBEL                                            
      S3-ANTAL-TOT-IÅR    = KVANTAL                                             
      S3-BELOPP-TOT-IÅR   = SUFKTBEL                                            
                                                                                
      PUT W35014D2                                                              
      PUT W35014D3                                                              
      PUT W35014D4                                                              
   ELSE                                                                         
NEWPAGE                                                                         
   TMP1-YYPP = TIAAPP                                                           
   TMP2-YYPP = TIAAPP-IÅR                                                       
   PERFORM WY2000P6                                                             
   IF TMP1-YYPP < TMP2-YYPP AND TIAA-IÅR EQ (TIAAPP / 100)                      
      S1-ANTAL-TOT-IÅR    = KVANTAL                                             
      S1-BELOPP-TOT-IÅR   = SUFKTBEL                                            
                                                                                
      S2-ANTAL-TOT-IÅR    = KVANTAL                                             
      S2-BELOPP-TOT-IÅR   = SUFKTBEL                                            
                                                                                
      S3-ANTAL-TOT-IÅR    = KVANTAL                                             
      S3-BELOPP-TOT-IÅR   = SUFKTBEL                                            
                                                                                
      PUT W35014D2                                                              
      PUT W35014D3                                                              
      PUT W35014D4                                                              
   ELSE                                                                         
   IF TIAAPP = TIAAPP-IFJOL                                                     
      S1-ANTAL-MÅN-IFJOL  = KVANTAL                                             
      S1-BELOPP-MÅN-IFJOL = SUFKTBEL                                            
      S1-ANTAL-TOT-IFJOL  = KVANTAL                                             
      S1-BELOPP-TOT-IFJOL = SUFKTBEL                                            
                                                                                
      S2-ANTAL-MÅN-IFJOL  = KVANTAL                                             
      S2-BELOPP-MÅN-IFJOL = SUFKTBEL                                            
      S2-ANTAL-TOT-IFJOL  = KVANTAL                                             
      S2-BELOPP-TOT-IFJOL = SUFKTBEL                                            
                                                                                
      S3-ANTAL-MÅN-IFJOL  = KVANTAL                                             
      S3-BELOPP-MÅN-IFJOL = SUFKTBEL                                            
      S3-ANTAL-TOT-IFJOL  = KVANTAL                                             
      S3-BELOPP-TOT-IFJOL = SUFKTBEL                                            
                                                                                
      PUT W35014D2                                                              
      PUT W35014D3                                                              
      PUT W35014D4                                                              
   ELSE                                                                         
NEWPAGE                                                                         
   TMP1-YYPP = TIAAPP                                                           
   TMP2-YYPP = TIAAPP-IFJOL                                                     
   PERFORM WY2000P6                                                             
   IF TIAA-IFJOL EQ (TIAAPP / 100) AND TMP1-YYPP < TMP2-YYPP                    
      S1-ANTAL-TOT-IFJOL  = KVANTAL                                             
      S1-BELOPP-TOT-IFJOL = SUFKTBEL                                            
                                                                                
      S2-ANTAL-TOT-IFJOL  = KVANTAL                                             
      S2-BELOPP-TOT-IFJOL = SUFKTBEL                                            
                                                                                
      S3-ANTAL-TOT-IFJOL  = KVANTAL                                             
      S3-BELOPP-TOT-IFJOL = SUFKTBEL                                            
                                                                                
      PUT W35014D2                                                              
      PUT W35014D3                                                              
      PUT W35014D4                                                              
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
   END-IF                                                                       
                                                                                
NEWPAGE                                                                         
                                                                                
INIT-PROC. PROC                                                                 
   CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                            
                                                                                
   IF D-MAANAD = 1                                                              
     TIPP-IÅR    = 12                                                           
     TIPP-IFJOL  = 12                                                           
     IF D-AAR = 00                                                              
       TIAA-IÅR    = 99                                                         
       TIAA-IFJOL  = 98                                                         
     ELSE                                                                       
       IF D-AAR = 01                                                            
         TIAA-IÅR    = 00                                                       
         TIAA-IFJOL  = 99                                                       
       ELSE                                                                     
         TIAA-IÅR    = D-AAR - 1                                                
         TIAA-IFJOL  = D-AAR - 2                                                
       END-IF                                                                   
     END-IF                                                                     
   ELSE                                                                         
     TIAA-IÅR    = D-AAR                                                        
     TIPP-IÅR    = D-MAANAD - 1                                                 
     TIPP-IFJOL  = D-MAANAD - 1                                                 
     IF D-AAR = 00                                                              
       TIAA-IFJOL = 99                                                          
     ELSE                                                                       
       TIAA-IFJOL = D-AAR - 1                                                   
     END-IF                                                                     
   END-IF                                                                       
                                                                                
END-PROC                                                                        
                                                                                
 NEWPAGE                                                                        
%WY2000P6                                                                       
                                                                                
NEWPAGE                                                                         
*------------------------*                                                      
* SORT                   *                                                      
*------------------------*                                                      
                                                                                
SORT W35014D2 TO W35014D2 USING (S1-KDPRODSL +                                  
                                 S1-KDSORT2)                                    
                                                                                
*------------------------*                                                      
* SORT                   *                                                      
*------------------------*                                                      
                                                                                
SORT W35014D3 TO W35014D3 USING (S2-KDPRODSL +                                  
                                 S2-IDFKNGRP +                                  
                                 S2-KDSORT2)                                    
                                                                                
*------------------------*                                                      
* SORT                   *                                                      
*------------------------*                                                      
                                                                                
SORT W35014D4 TO W35014D4 USING (S3-KDPRODSL +                                  
                                 S3-FKNTUSEN +                                  
                                 S3-KDSORT2)                                    
NEWPAGE                                                                         
*------------------------*                                                      
* JOB                    *                                                      
*------------------------*                                                      
                                                                                
JOB INPUT NULL                                                                  
   GET W35014D2                                                                 
   DO WHILE NOT EOF W35014D2                                                    
      PRINT RAPPORT01                                                           
      GET W35014D2                                                              
   END-DO                                                                       
   GET W35014D3                                                                 
   DO WHILE NOT EOF W35014D3                                                    
      PRINT RAPPORT02                                                           
      GET W35014D3                                                              
   END-DO                                                                       
   GET W35014D4                                                                 
   DO WHILE NOT EOF W35014D4                                                    
      PRINT RAPPORT03                                                           
      GET W35014D4                                                              
   END-DO                                                                       
   STOP                                                                         
                                                                                
NEWPAGE                                                                         
*------------------------*                                                      
* REPORT                 *                                                      
*------------------------*                                                      
                                                                                
REPORT RAPPORT01 PRINTER W35014D5 SUMSPACE 0 +                                  
    SUMMARY LINESIZE 120 SPACE 0 TITLESKIP 1 NOSPREAD NOADJUST                  
                                                                                
    CONTROL  FINAL NOPRINT S1-KDPRODSL NEWPAGE S1-IDSKYLT                       
                                                                                
    TITLE 1 COL 20 'VOLVO PARTS   W35014-001  ' +                               
           'VAGN + RS GARANTIER (PV)   PRODUKTSLAG ' S1-KDPRODSL                
                                                                                
    TITLE 4  COL 39 'INNEVARANDE ÅR' COL 92 'FÖREGÅENDE ÅR'                     
    TITLE 6  COL 30 'MÅNAD' COL 56 'TOTALT' COL 82 'MÅNAD' +                    
             COL 108 'TOTALT'                                                   
                                                                                
    LINE COL 3 S1-IDSKYLT +                                                     
    COL 18 S1-ANTAL-MÅN-IÅR   COL  28 S1-BELOPP-MÅN-IÅR   +                     
    COL 44 S1-ANTAL-TOT-IÅR   COL  54 S1-BELOPP-TOT-IÅR   +                     
    COL 70 S1-ANTAL-MÅN-IFJOL COL  80 S1-BELOPP-MÅN-IFJOL +                     
    COL 96 S1-ANTAL-TOT-IFJOL COL 106 S1-BELOPP-TOT-IFJOL                       
 BEFORE-BREAK. PROC                                                             
    IF LEVEL = 2                                                                
        DISPLAY ' '                                                             
    END-IF                                                                      
 END-PROC                                                                       
NEWPAGE                                                                         
*------------------------*                                                      
* REPORT                 *                                                      
*------------------------*                                                      
                                                                                
REPORT RAPPORT02 PRINTER W35014D6 SUMSPACE 0 +                                  
    SUMMARY LINESIZE 120 SPACE 0 TITLESKIP 1 NOSPREAD NOADJUST +                
    PAGESIZE 40                                                                 
                                                                                
    CONTROL  FINAL NOPRINT S2-KDPRODSL NEWPAGE NOPRINT +                        
             S2-FKNTUSEN NEWPAGE NOPRINT S2-IDFKNGRP S2-IDSKYLT                 
                                                                                
    TITLE 1 COL 20 'VOLVO PARTS   W35014-002   ' +                              
           'VAGN + RS GARANTIER (PV)   PRODUKTSLAG ' S2-KDPRODSL                
                                                                                
    TITLE 4  COL 39 'INNEVARANDE ÅR' COL 92 'FÖREGÅENDE ÅR'                     
    TITLE 6  COL 30 'MÅNAD' COL 56 'TOTALT' COL 82 'MÅNAD' +                    
             COL 108 'TOTALT'                                                   
                                                                                
    LINE COL 3 S2-IDSKYLT     COL  11 S2-IDFKNGRP         +                     
    COL 18 S2-ANTAL-MÅN-IÅR   COL  28 S2-BELOPP-MÅN-IÅR   +                     
    COL 44 S2-ANTAL-TOT-IÅR   COL  54 S2-BELOPP-TOT-IÅR   +                     
    COL 70 S2-ANTAL-MÅN-IFJOL COL  80 S2-BELOPP-MÅN-IFJOL +                     
    COL 96 S2-ANTAL-TOT-IFJOL COL 106 S2-BELOPP-TOT-IFJOL                       
NEWPAGE                                                                         
*------------------------*                                                      
* REPORT                 *                                                      
*------------------------*                                                      
                                                                                
REPORT RAPPORT03 PRINTER W35014D7 SUMSPACE 0 +                                  
    SUMMARY LINESIZE 120 SPACE 0 TITLESKIP 0 NOSPREAD NOADJUST                  
                                                                                
    CONTROL  FINAL NOPRINT S3-KDPRODSL NEWPAGE NOPRINT +                        
             S3-FKNTUSEN NEWPAGE NOPRINT S3-IDSKYLT                             
                                                                                
    TITLE 1 COL 20 'VOLVO PARTS   W35014-003   ' +                              
           'VAGN + RS GARANTIER (PV)   PRODUKTSLAG ' S3-KDPRODSL                
                                                                                
    TITLE 4  COL 39 'INNEVARANDE ÅR' COL 92 'FÖREGÅENDE ÅR'                     
    TITLE 6  COL 30 'MÅNAD' COL 56 'TOTALT' +                                   
             COL 82 'MÅNAD' COL 108 'TOTALT'                                    
    TITLE 7  COL 11 'TUSEN-'                                                    
                                                                                
    LINE COL 3 S3-IDSKYLT     COL  11 S3-FKNTUSEN         +                     
    COL 18 S3-ANTAL-MÅN-IÅR   COL  28 S3-BELOPP-MÅN-IÅR   +                     
    COL 44 S3-ANTAL-TOT-IÅR   COL  54 S3-BELOPP-TOT-IÅR   +                     
    COL 70 S3-ANTAL-MÅN-IFJOL COL  80 S3-BELOPP-MÅN-IFJOL +                     
    COL 96 S3-ANTAL-TOT-IFJOL COL 106 S3-BELOPP-TOT-IFJOL                       
                                                                                
NEWPAGE                                                                         
 BEFORE-BREAK. PROC                                                             
    IF LEVEL = 2                                                                
    DISPLAY ' '                                                                 
    DISPLAY COL 3 'TOTALT 1:A NIVÅ ' +                                          
    COL 18 S3-ANTAL-MÅN-IÅR   COL  28 S3-BELOPP-MÅN-IÅR +                       
    COL 44 S3-ANTAL-TOT-IÅR   COL  54 S3-BELOPP-TOT-IÅR   +                     
    COL 70 S3-ANTAL-MÅN-IFJOL COL  80 S3-BELOPP-MÅN-IFJOL +                     
    COL 96 S3-ANTAL-TOT-IFJOL COL 106 S3-BELOPP-TOT-IFJOL                       
        DISPLAY ' '                                                             
    END-IF                                                                      
 END-PROC                                                                       
