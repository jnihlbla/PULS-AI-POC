*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5128K00                                              *        
*                                                                      *        
*  FUNKTION   :  CREATES KVAKS REPORT FROM WDK6 AND WDK7               *        
*                                                                      *        
*  FÖRFATTARE :  SARASWATHY S                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W5128KD1                                                                   
*                                                                               
%W51261  'IN-'                                                                  
FILE TPFIL1 FB(16 0)                                                            
T1-AREA     1    16 A                                                           
IDARTNR     1     5 P 0                                                         
IDDC        6     2 A                                                           
KVAKS       8     4 P 0                                                         
PRARTSTD   12     5 P 2                                                         
*                                                                               
****** EXCEL UTFIL                                                              
FILE W5128KD2 VB(90 0)                                                          
UT-AREA           1 90 A                                                        
**                                                                              
UT-HEAD1         W     90   A                                                   
UT-ROW11         UT-HEAD1           14  A VALUE '¤DAPW5128K-001'                
**                                                                              
UT-HEAD2         W     90   A                                                   
UT-ROW21         UT-HEAD2           10  A VALUE '¤DAPW5128K'                    
**                                                                              
UT-HEAD3         W     90   A                                                   
UT-ROW31         UT-HEAD3           11  A VALUE 'PART NUMBER'                   
UT-ROW32         UT-HEAD3       +12  1  A VALUE ';'                             
UT-ROW33         UT-HEAD3       +13  2  A VALUE 'DC'                            
UT-ROW34         UT-HEAD3       +15  1  A VALUE ';'                             
UT-ROW35         UT-HEAD3       +16  8  A VALUE 'QUANTITY'                      
UT-ROW36         UT-HEAD3       +23  1  A VALUE ';'                             
UT-ROW37         UT-HEAD3       +24 14  A VALUE 'STANDARD PRICE'                
UT-ROW38         UT-HEAD3       +38  1  A VALUE ';'                             
UT-ROW39         UT-HEAD3       +39 11  A VALUE 'TOTAL PRICE'                   
**                                                                              
UT-DATA          W     90   A                                                   
UT-IDARTNR       UT-DATA             9  N                                       
UT-SEM1          UT-DATA        +10  1  A VALUE ';'                             
UT-IDDC          UT-DATA        +11  2  A                                       
UT-SEM2          UT-DATA        +13  1  A VALUE ';'                             
UT-SIGN1         UT-DATA        +14  1  A                                       
UT-KVAKS         UT-DATA        +15 11  N                                       
UT-SEM3          UT-DATA        +26  1  A VALUE ';'                             
UT-SIGN2         UT-DATA        +27  1  A                                       
UT-STDPR-N       UT-DATA        +28 11  N                                       
UT-DEC2          UT-DATA        +39  1  A VALUE '.'                             
UT-STDPR-D       UT-DATA        +40  2  N                                       
UT-SEM4          UT-DATA        +42  1  A VALUE ';'                             
UT-SIGN3         UT-DATA        +43  1  A                                       
UT-TOTPR-N       UT-DATA        +44 13  N                                       
UT-DEC3          UT-DATA        +57  1  A VALUE '.'                             
UT-TOTPR-D       UT-DATA        +58  2  N                                       
UT-SEM5          UT-DATA        +60  1  A VALUE ';'                             
**                                                                              
UT-FOOTER        W     90   A                                                   
UT-DESC          UT-FOOTER          12  A VALUE 'TOTAL PRICE:'                  
UT-SEM6          UT-FOOTER      +13  1  A VALUE ';'                             
UT-SIGN4         UT-FOOTER      +14  1  A                                       
UT-TOT-PRICE-N   UT-FOOTER      +15 13  N                                       
UT-DEC4          UT-FOOTER      +28  1  A VALUE '.'                             
UT-TOT-PRICE-D   UT-FOOTER      +29  2  N                                       
UT-SEM7          UT-FOOTER      +31  1  A VALUE ';'                             
*****************************************************************               
**WORKING STORAGE VARIABLES                                                     
*****************************************************************               
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
WS-KVAKS         W  8  P 0 VALUE 0                                              
WS-STDPR         W  9  P 2 VALUE 0                                              
W-PRARTSTD       W   9 P 2                                                      
W-PSTD-FMT       W  17 N 2                                                      
W-PRIS-N        W-PSTD-FMT       15  N                                          
W-PRIS-D        W-PSTD-FMT    +15 2  N                                          
W-PRARTTOT       W   9 P 2                                                      
W-PTOT-FMT       W  17 N 2                                                      
W-PTOT-N        W-PTOT-FMT       15  N                                          
W-PTOT-D        W-PTOT-FMT    +15 2  N                                          
W-FOOTTOT        W   9 P 2                                                      
W-FTOT-FMT       W  17 N 2                                                      
W-FTOT-N        W-FTOT-FMT       15  N                                          
W-FTOT-D        W-FTOT-FMT    +15 2  N                                          
*****************************************************************               
**READS W51261 ON IDARTNR AND IDDC                                              
*****************************************************************               
JOB INPUT (W5128KD1 KEY(IN-IDARTNR IN-IDDC)) +                                  
          START A-START FINISH Z-FINIT                                          
IF  IN-KVAKS NE 0   AND               +                                         
    IN-IDDC NE XDC-NON-VCC-OWNED  AND +                                         
    IN-IDDC NE NDC-NA AND             +                                         
    IN-IDDC NE LDC-CN                                                           
   WS-KVAKS     = WS-KVAKS + IN-KVAKS                                           
   IF LAST-DUP W5128KD1 OR NOT DUPLICATE W5128KD1                               
     UT-IDARTNR  = IN-IDARTNR                                                   
     UT-IDDC     = IN-IDDC                                                      
     IF WS-KVAKS  < 0                                                           
       UT-SIGN1 = '-'                                                           
     ELSE                                                                       
       UT-SIGN1 = ' '                                                           
     END-IF                                                                     
     UT-KVAKS     = WS-KVAKS                                                    
     W-PRARTSTD   = IN-PRARTSTD                                                 
     W-PSTD-FMT   = W-PRARTSTD                                                  
     IF W-PRARTSTD < 0                                                          
      UT-SIGN2 = '-'                                                            
     ELSE                                                                       
      UT-SIGN2 = ' '                                                            
     END-IF                                                                     
     UT-STDPR-N  = W-PRIS-N                                                     
     UT-STDPR-D  = W-PRIS-D                                                     
     W-PRARTTOT   = IN-PRARTSTD * WS-KVAKS                                      
     W-PTOT-FMT   = W-PRARTTOT                                                  
     IF W-PRARTTOT < 0                                                          
      UT-SIGN3 = '-'                                                            
     ELSE                                                                       
      UT-SIGN3 = ' '                                                            
     END-IF                                                                     
     UT-TOTPR-N  = W-PTOT-N                                                     
     UT-TOTPR-D  = W-PTOT-D                                                     
     UT-AREA      = UT-DATA                                                     
     PUT W5128KD2                                                               
     WS-STDPR     = WS-STDPR + W-PRARTTOT                                       
     W-PRARTTOT   = 0                                                           
     W-PTOT-FMT   = 0                                                           
     WS-KVAKS     = 0                                                           
   END-IF                                                                       
END-IF                                                                          
A-START. PROC                                                                   
  WS-STDPR = 0                                                                  
  W-PRARTTOT   = 0                                                              
  W-PTOT-FMT   = 0                                                              
  UT-AREA  = UT-HEAD1                                                           
  PUT W5128KD2                                                                  
  UT-AREA  = UT-HEAD2                                                           
  PUT W5128KD2                                                                  
  UT-AREA  = UT-HEAD3                                                           
  PUT W5128KD2                                                                  
END-PROC.                                                                       
                                                                                
Z-FINIT. PROC                                                                   
  W-FOOTTOT    = WS-STDPR                                                       
  W-FTOT-FMT   = W-FOOTTOT                                                      
  IF W-FOOTTOT  < 0                                                             
   UT-SIGN4 = '-'                                                               
  ELSE                                                                          
   UT-SIGN4 = ' '                                                               
  END-IF                                                                        
  UT-TOT-PRICE-N = W-FTOT-N                                                     
  UT-TOT-PRICE-D = W-FTOT-D                                                     
  UT-AREA  = UT-FOOTER                                                          
  PUT W5128KD2                                                                  
END-PROC.                                                                       
*                                                                               
                                                                                
