*  FUNKTION   :  SORTERA OCH PLOCCKA BORT DUBLETTER                    *        
*                PROCEDURE                                             *        
*                                                                      *        
*  FÖRFATTARE :  ODD OLSEN                                             *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE WDMR06D1                                                                   
*                                                                               
  IN-POST              1 80 A                                                   
  IN-PROC              1 13 A                                                   
                                                                                
NEWPAGE                                                                         
FILE TEMP FB(80 23440) VIRTUAL                                                  
*                                                                               
  TEMP-POST            1 80 A                                                   
  TEMP-PROC            1 13 A                                                   
                                                                                
NEWPAGE                                                                         
FILE WDMR06D2 FB(80 23440)                                                      
*                                                                               
  UT-POST              1 80 A                                                   
  UT-PROC              1 13 A                                                   
                                                                                
NEWPAGE                                                                         
*                                                                               
* ARBETSAREA                                                                    
*                                                                               
  SPAR-POST            W 80 A                                                   
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
* SORT                                                                          
*                                                                               
SORT WDMR06D1 TO +                                                              
     TEMP USING (IN-POST)                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
* BEARBETA                                                                      
*                                                                               
JOB INPUT(TEMP)                                                                 
                                                                                
    IF TEMP-POST ^= SPAR-POST                                                   
      PUT WDMR06D2 FROM TEMP                                                    
      SPAR-POST = TEMP-POST                                                     
    END-IF                                                                      
                                                                                
    GOTO JOB                                                                    
                                                                                
STOP                                                                            
