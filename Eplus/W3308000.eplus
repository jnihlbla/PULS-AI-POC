  REPORT RAPPORT-VA2                                         +                  
         PRINTER W33080D2                                    +                  
         LINESIZE 120                                        +                  
         PAGESIZE 41                                         +                  
         TITLESKIP 0                                         +                  
         SPACE 1                                             +                  
         NOADJUST                                            +                  
         NOHEADING                                           +                  
         SUMCTL NONE                                                            
                                                                                
                                                                                
                                                                                
    CONTROL  FINAL NOPRINT                                   +                  
             RES-IDUSER NOPRINT   W-REGDAT NOPRINT           +                  
             W-REGTID NOPRINT RENUM W-BRYT-IDARTNR NEWPAGE                      
                                                                                
                                                                                
    SUM     RES-SUARTSJK-VV RES-SUARTSJK-FVV                 +                  
            RES-SULEVANT-VV RES-SULEVANT-FVV                 +                  
            RES-SUARTFSG-VV RES-SUARTFSG-FVV                                    
                                                                                
    TITLE 1 COL 005 ' '                                                         
                                                                                
    TITLE 2 COL 004 'VOLVO PARTS AB'                         +                  
            COL 020 'W33080-001'                             +                  
            COL 032 'URVAL:'                                 +                  
            COL 038 W-IDFSGURV                               +                  
            COL 049 'VA2'                                    +                  
            COL 053 'ARTIKELSTATISTIK'                       +                  
            COL 080 'USERID'                                 +                  
            COL 088 RES-IDUSER                               +                  
            COL 108 'DAT'                                  +                    
            COL 112 W-REGDAT                                                    
                                                                                
    TITLE 3 COL 005 'ARTIKELNR'                              +                  
            COL 017 W-VA2-IDARTNR                            +                  
            COL 031 W-VA2-BEART-SVE                          +                  
            COL 053 W-VA2-BILDTYP                            +                  
            COL 060 'PRODUKTSLAG'                            +                  
            COL 072 W-VA2-KDPRODSL                           +                  
            COL 080 W-VA2-BEPRODSL                           +                  
            COL 108 'TID'                                    +                  
            COL 114 W-REGTID                                                    
                                                                                
    TITLE 5 COL 050 'VECKA'                            +                        
            COL 060 W-VV-START                               +                  
            COL 069 '-'                                      +                  
            COL 071 W-VV-SLUT                                +                  
            COL 093 'VECKA'                            +                        
            COL 102 W-FVV-START                              +                  
            COL 112 '-'                                      +                  
            COL 114 W-FVV-SLUT                                                  
                                                                                
    TITLE 7  COL 005 W-VA2-OMRTYP                            +                  
             COL 050 'ST'                                    +                  
             COL 064 'FSG KR'                                +                  
             COL 073 'TG KR'                                 +                  
             COL 088 'ST'                                    +                  
             COL 103 'FSG KR'                                +                  
             COL 112 'TG KR'                                                    
*&                                                                              
    LINE 1   COL 005 UT-LINE-OMRADE                          +                  
             COL 043 UT-LINE-SULEVANT-VV                     +                  
             COL 056 UT-LINE-SUARTFSG-VV                     +                  
             COL 074 UT-LINE-RETOTBV-VV                      +                  
             COL 081 UT-LINE-SULEVANT-FVV                    +                  
             COL 095 UT-LINE-SUARTFSG-FVV                    +                  
             COL 113 UT-LINE-RETOTBV-FVV                                        
                                                                                
BEFORE-BREAK. PROC                                                              
    IF LEVEL = 1                                                                
                                                                                
       IF RES-SUARTFSG-VV NE 0                                                  
          W-RETOTBV-VV = (100 * (RES-SUARTFSG-VV -           +                  
             RES-SUARTSJK-VV)) / RES-SUARTFSG-VV                                
       ELSE                                                                     
          MOVE ZEROES TO W-RETOTBV-VV                                           
       END-IF                                                                   
                                                                                
       IF RES-SUARTFSG-FVV NE 0                                                 
          W-RETOTBV-FVV = (100 * (RES-SUARTFSG-FVV -         +                  
              RES-SUARTSJK-FVV)) / RES-SUARTFSG-FVV                             
       ELSE                                                                     
          MOVE ZEROES TO W-RETOTBV-FVV                                          
       END-IF                                                                   
                                                                                
                                                                                
       IF W-RETOTBV-VV > 0                                                      
          W-RETOTBV-VV = W-RETOTBV-VV + 0.05                                    
       ELSE                                                                     
          IF W-RETOTBV-VV < 0                                                   
             W-RETOTBV-VV = W-RETOTBV-VV - 0.05                                 
          END-IF                                                                
       END-IF                                                                   
                                                                                
       IF W-RETOTBV-FVV > 0                                                     
          W-RETOTBV-FVV = W-RETOTBV-FVV + 0.05                                  
       ELSE                                                                     
          IF W-RETOTBV-FVV < 0                                                  
             W-RETOTBV-FVV = W-RETOTBV-FVV - 0.05                               
          END-IF                                                                
       END-IF                                                                   
                                                                                
                                                                                
                                                                                
       GT-SULEVANT-VV =                                      +                  
          GT-SULEVANT-VV + RES-SULEVANT-VV                                      
       GT-SUARTFSG-VV =                                      +                  
          GT-SUARTFSG-VV + RES-SUARTFSG-VV                                      
       GT-SUARTSJK-VV =                                      +                  
          GT-SUARTSJK-VV + RES-SUARTSJK-VV                                      
       GT-SULEVANT-FVV =                                     +                  
          GT-SULEVANT-FVV + RES-SULEVANT-FVV                                    
       GT-SUARTFSG-FVV =                                     +                  
          GT-SUARTFSG-FVV + RES-SUARTFSG-FVV                                    
       GT-SUARTSJK-FVV =                                     +                  
          GT-SUARTSJK-FVV + RES-SUARTSJK-FVV                                    
                                                                                
                                                                                
       UT-ATOT-SULEVANT-VV   = RES-SULEVANT-VV                                  
       UT-ATOT-SUARTFSG-VV   = RES-SUARTFSG-VV                                  
                                                                                
       IF W-RETOTBV-VV > 99.9                                                   
          UT-ATOT-RETOTBV-VV = 99.9                                             
       ELSE                                                                     
          IF W-RETOTBV-VV < -99.9                                               
             UT-ATOT-RETOTBV-VV = -99.9                                         
          ELSE                                                                  
             UT-ATOT-RETOTBV-VV    = W-RETOTBV-VV                               
          END-IF                                                                
       END-IF                                                                   
                                                                                
                                                                                
       UT-ATOT-SULEVANT-FVV  = RES-SULEVANT-FVV                                 
       UT-ATOT-SUARTFSG-FVV  = RES-SUARTFSG-FVV                                 
       IF W-RETOTBV-FVV > 99.9                                                  
          UT-ATOT-RETOTBV-FVV = 99.9                                            
       ELSE                                                                     
          IF W-RETOTBV-FVV < -99.9                                              
             UT-ATOT-RETOTBV-FVV = -99.9                                        
          ELSE                                                                  
             UT-ATOT-RETOTBV-FVV    = W-RETOTBV-FVV                             
          END-IF                                                                
       END-IF                                                                   
                                                                                
       DISPLAY '   '                                                            
       DISPLAY  COL 005 'ARTIKEL - TOTAL'                    +                  
                COL 043  UT-ATOT-SULEVANT-VV                 +                  
                COL 056  UT-ATOT-SUARTFSG-VV                 +                  
                COL 074  UT-ATOT-RETOTBV-VV                  +                  
                COL 081  UT-ATOT-SULEVANT-FVV                +                  
                COL 095  UT-ATOT-SUARTFSG-FVV                +                  
                COL 113  UT-ATOT-RETOTBV-FVV                                    
                                                                                
    END-IF                                                                      
    IF LEVEL = 2                                                                
       IF GT-SUARTFSG-VV NE 0                                                   
          W-GT-RETOTBV-VV = (100 * (GT-SUARTFSG-VV -         +                  
             GT-SUARTSJK-VV)) / GT-SUARTFSG-VV                                  
       ELSE                                                                     
          MOVE ZEROES TO W-GT-RETOTBV-VV                                        
       END-IF                                                                   
                                                                                
       IF GT-SUARTFSG-FVV NE 0                                                  
          W-GT-RETOTBV-FVV = (100 * (GT-SUARTFSG-FVV -       +                  
             GT-SUARTSJK-FVV)) / GT-SUARTFSG-FVV                                
       ELSE                                                                     
          MOVE ZEROES TO W-GT-RETOTBV-FVV                                       
       END-IF                                                                   
                                                                                
       W-GT-RETOTBV-VV =                                     +                  
       W-GT-RETOTBV-VV + 0.05                                                   
                                                                                
       W-GT-RETOTBV-FVV =                                    +                  
       W-GT-RETOTBV-FVV + 0.05                                                  
                                                                                
       UT-GTOT-SULEVANT-VV   = GT-SULEVANT-VV                                   
       UT-GTOT-SUARTFSG-VV   = GT-SUARTFSG-VV                                   
       IF W-GT-RETOTBV-VV > 99.9                                                
          UT-GTOT-RETOTBV-VV = 99.9                                             
       ELSE                                                                     
          IF W-GT-RETOTBV-VV < -99.9                                            
             UT-GTOT-RETOTBV-VV = -99.9                                         
          ELSE                                                                  
             UT-GTOT-RETOTBV-VV    =  W-GT-RETOTBV-VV                           
          END-IF                                                                
       END-IF                                                                   
       UT-GTOT-SULEVANT-FVV  = GT-SULEVANT-FVV                                  
       UT-GTOT-SUARTFSG-FVV  = GT-SUARTFSG-FVV                                  
       IF W-GT-RETOTBV-FVV > 99.9                                               
          UT-GTOT-RETOTBV-FVV = 99.9                                            
       ELSE                                                                     
          IF W-GT-RETOTBV-FVV < -99.9                                           
             UT-GTOT-RETOTBV-FVV = -99.9                                        
          ELSE                                                                  
             UT-GTOT-RETOTBV-FVV   = W-GT-RETOTBV-FVV                           
          END-IF                                                                
       END-IF                                                                   
                                                                                
       DISPLAY '   '                                                            
       DISPLAY  COL 005 'URVAL - TOTAL'                      +                  
                COL 043  UT-GTOT-SULEVANT-VV                 +                  
                COL 056  UT-GTOT-SUARTFSG-VV                 +                  
                COL 074  UT-GTOT-RETOTBV-VV                  +                  
                COL 081  UT-GTOT-SULEVANT-FVV                +                  
                COL 095  UT-GTOT-SUARTFSG-FVV                +                  
                COL 113  UT-GTOT-RETOTBV-FVV                                    
                                                                                
                                                                                
       GT-SULEVANT-VV    = 0                                                    
       GT-SUARTFSG-VV    = 0                                                    
       GT-SUARTSJK-VV    = 0                                                    
       W-GT-RETOTBV-VV   = 0                                                    
       GT-SULEVANT-FVV   = 0                                                    
       GT-SUARTFSG-FVV   = 0                                                    
       GT-SUARTSJK-FVV   = 0                                                    
       W-GT-RETOTBV-FVV  = 0                                                    
    END-IF                                                                      
END-PROC                                                                        
