                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W56077                                                *        
*                                                                      *        
*  FUNKTION   :  MATCHAR INLEV.HISTORIKFIL MED BENÄMNINGSFIL TILL TEMP-*        
*                FIL01 KOMPLETTERAR DENNA FIL (MATCHAR) MED  BEFKNGRP  *        
*                OCH SKAPAR 'LIFO CALCULATION' LISTOR ÅT USA           *        
*                                                                      *        
*  FÖRFATTARE :  KARL JOHAN HANSSON OKT 2002                           *        
*                                                                      *        
*  INFILER    :  W560.W560Y4.W56065 INLEVERANSFIL                      *        
*                W011.W01174        BENÄMNINGSREGISTERFIL              *        
*                W560.W56099        FIL MED FUNKTIONSGRUPPSBENÄMNINGAR *        
*                                                                      *        
*  UTFIL      :  W56077, LISTOR PÅ FIL TILL LAB (USA)                  *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
* INFIL W56065 INLEVERANS-FIL FRÅN WDL6 PER DC                                  
FILE W56077D1                                                                   
%W56065  'I1-'                                                                  
                                                                                
* INFIL W01174  FIL MED ARTIKELBENÄMNINGAR                                      
FILE W56077D2                                                                   
%W01174  'I2-'                                                                  
                                                                                
* INFIL W56099  FIL MED FUNKTIONSGRUPPS-BENÄMNINGAR                             
FILE W56077D3                                                                   
I3-IDFKNGRP         1  4 N                                                      
I3-BEFKNGRP-SE      6 50 A                                                      
I3-BEFKNGRP-GB     54 50 A                                                      
                                                                                
* TEMPORÄR INLEVERANSFIL PER DC SORTERAD PÅ ARTIKELNR                           
FILE TPFIL01 FB(100 0)                                                          
%W56065   'T1-'                                                                 
                                                                                
* TEMPORÄR INLEVERANSFIL PER DC SORTERAD PÅ FUNKTIONSGRUPP                      
FILE TPFIL02 FB(100 0)                                                          
T2-IDARTNR        1  5 P 0                                                      
T2-IDFKNGRP       6  4 N                                                        
T2-IDDC          10  2 A                                                        
T2-IDDISTR       12  3 P 0                                                      
T2-IDFAKT        15  4 P 0                                                      
T2-DAFAKT        19  8 N                                                        
T2-KVAKS         27  4 P 0                                                      
T2-PRARTBEL-PR   31  7 P 5                                                      
T2-PRKURS        38  6 P 5                                                      
T2-BEART         44 25 A                                                        
                                                                                
* RAPPORT U2509 DC ALL (W56077-001, W56077-002)                                 
FILE W56077D4 PRINTER VB (220 0)                                                
                                                                                
* ARBETS-AREOR                                                  *               
* ARBETS-TABELL FÖR FUNKTIONSGRUPPBESKRIVNINGAR                 *               
W-TAB            W      540   A                                                 
W-TAB-L     W-TAB        54   A OCCURS 10                                       
W-SEM           W  6  A            VALUE ';'                                    
 FIRST-LINE1     S  1  A            VALUE 'J'                                   
 FIRST-LINE2     S  1  A            VALUE 'J'                                   
                                                                                
* ARBETS-AREA FÖR LISTA -001                                                    
W-IDFKNGRP        W   4  N     MASK 'ZZZ9'                                      
W-IDFAKT          W   7  N     MASK 'ZZZZZZ9'                                   
W-KVAKS           W   7  N     MASK 'ZZZZZZ9'                                   
W-IDARTNR         W   9  N     MASK 'ZZZZZZZZ9'                                 
W-PRARTNTO        W   9  N  2  MASK 'ZZZZZZ9.99'                                
W-SUARTNTO        W   9  N  2  MASK 'ZZZZZZ9.99'                                
W-SUM-SUARTNTO    W   9  N  2  MASK 'ZZZZZZ9.99'                                
W-TOT-SUARTNTO    W   9  N  2  MASK 'ZZZZZZ9.99'                                
W-BEART           W  25  A                                                      
W-BEFKNGRP        W  35  A                                                      
                                                                                
* ARBETS-AREA FÖR LISTA -002                                                    
W2-IDFKNGRP       W   4  N VALUE 0 MASK 'ZZZ9'                                  
W2-IDFKNGRP1 W2-IDFKNGRP 1 N                                                    
W2-FUNKKAT        W   1  N                                                      
W2-TOT-SUARTNTO   W   9  N  2  MASK 'ZZZZZZ9.99'                                
W2-SUM-SUARTNTO   W   9  N  2  MASK 'ZZZZZZ9.99'                                
W2-GTOT-SUARTNTO  W   9  N  2  MASK 'ZZZZZZ9.99'                                
W2-BEFKNGRP       W  35  A                                                      
                                                                                
*****************************************************************               
* STEG 1  SORTERA INLEVERANSFIL  PER IDARTNR                    *               
*****************************************************************               
                                                                                
SORT W56077D1 TO TPFIL01 USING (I1-IDARTNR)                                     
                                                                                
*****************************************************************               
* STEG 2  MATCHA SORTERAD FIL MED BENÄMNINGSFIL O KOMPLETTERA                   
*         MED ARTIKELBENÄMNING                                                  
*****************************************************************               
                                                                                
JOB INPUT(W56077D2 KEY (I2-IDARTNR )                      +                     
           TPFIL01 KEY (T1-IDARTNR))                                            
                                                                                
 IF MATCHED                                                                     
   T2-IDFKNGRP       = T1-IDFKNGRP                                              
   T2-IDFAKT         = T1-IDFAKT                                                
   T2-IDARTNR        = T1-IDARTNR                                               
   T2-IDDC           = T1-IDDC                                                  
   T2-IDDISTR        = T1-IDDISTR                                               
   T2-DAFAKT         = T1-DAFAKT                                                
   T2-KVAKS          = T1-KVAKS                                                 
   T2-PRARTBEL-PR    = T1-PRARTBEL-PR                                           
   T2-PRKURS         = T1-PRKURS                                                
   IF I2-BEART(10)  EQ '                         '                              
     T2-BEART        = I2-BEART(04)                                             
   ELSE                                                                         
     T2-BEART        = I2-BEART(10)                                             
   END-IF                                                                       
   PUT TPFIL02                                                                  
 ELSE                                                                           
   IF TPFIL01                                                                   
     T2-IDARTNR        = T1-IDARTNR                                             
     T2-IDFKNGRP       = T1-IDFKNGRP                                            
     T2-IDDC           = T1-IDDC                                                
     T2-IDDISTR        = T1-IDDISTR                                             
     T2-IDFAKT         = T1-IDFAKT                                              
     T2-DAFAKT         = T1-DAFAKT                                              
     T2-KVAKS          = T1-KVAKS                                               
     T2-PRARTBEL-PR    = T1-PRARTBEL-PR                                         
     T2-PRKURS         = T1-PRKURS                                              
     T2-BEART          = '                         '                            
     PUT TPFIL02                                                                
   END-IF                                                                       
 END-IF                                                                         
                                                                                
*****************************************************************               
* STEG 3  SORTERA INLEVERANSFIL  PER IDFKNGRP                   *               
*****************************************************************               
                                                                                
SORT TPFIL02 TO TPFIL02 USING (T2-IDFKNGRP T2-IDFAKT T2-IDARTNR)                
                                                                                
*****************************************************************               
* STEG 4  MATCHA SORTERAD FIL OCH FIL MED FUNKTIONSGRUPPSBENÄMNING              
*         OCH SKAPA LISTOR - LIFO CALCULATION OCH - TOTALLISTA                  
*****************************************************************               
                                                                                
JOB INPUT(W56077D3 KEY (I3-IDFKNGRP)                      +                     
           TPFIL02 KEY (T2-IDFKNGRP)) START A-INIT FINISH Z-FIN                 
                                                                                
 IF MATCHED                                                                     
    W-BEFKNGRP             = I3-BEFKNGRP-GB                                     
    PERFORM 4-SKAPA-LISTRAD                                                     
 ELSE                                                                           
   IF TPFIL02                                                                   
     W-BEFKNGRP             = '             '                                   
     PERFORM 4-SKAPA-LISTRAD                                                    
   END-IF                                                                       
 END-IF                                                                         
                                                                                
A-INIT. PROC                                                                    
 W-TAB-L(1)  = 'GENERAL                                               '         
 W-TAB-L(2)  = 'STANDARD PARTS, SERVICE AND MAINTENANCE MATERIAL      '         
 W-TAB-L(3)  = 'ENGINE WITH MOUNTING AND EQUIPMENT                    '         
 W-TAB-L(4)  = 'ELECTRIC POWER SUPPLY; LIGHTING; INSTRUMENTS; SOFTWARE'         
 W-TAB-L(5)  = 'POWER TRANSMISSION                                    '         
 W-TAB-L(6)  = 'BRAKE                                                 '         
 W-TAB-L(7)  = 'WHEEL SUSPENSION AND STEERING                         '         
 W-TAB-L(8)  = 'FRAME, SPRINGS, DAMPING AND WHEELS                    '         
 W-TAB-L(9)  = 'BODY, CAB AND INTERIOR                                '         
 W-TAB-L(10) = 'MISCELLANEOUS, SPECIAL FUNCTIONS                      '         
END-PROC.                                                                       
                                                                                
4-SKAPA-LISTRAD. PROC                                                           
                                                                                
   W-IDFKNGRP             = T2-IDFKNGRP                                         
   W-IDFAKT               = T2-IDFAKT                                           
   W-IDARTNR              = T2-IDARTNR                                          
   W-BEART                = T2-BEART                                            
   W-KVAKS                = T2-KVAKS                                            
   W-PRARTNTO ROUNDED     = T2-PRARTBEL-PR                                      
   W-SUARTNTO ROUNDED     = W-PRARTNTO * T2-KVAKS                               
   W-SUM-SUARTNTO         = W-SUARTNTO                                          
   W-TOT-SUARTNTO         = W-SUARTNTO                                          
   IF W2-IDFKNGRP EQ T2-IDFKNGRP                                                
     W2-SUM-SUARTNTO      = W2-SUM-SUARTNTO + W-SUARTNTO                        
   ELSE                                                                         
     IF W2-IDFKNGRP NE 0                                                        
       W2-TOT-SUARTNTO    = W2-SUM-SUARTNTO                                     
       W2-GTOT-SUARTNTO   = W2-SUM-SUARTNTO                                     
       W2-FUNKKAT         = W2-IDFKNGRP1 + 1                                    
       PRINT LISTA2                                                             
     END-IF                                                                     
     W2-IDFKNGRP          = T2-IDFKNGRP                                         
     W2-BEFKNGRP          = W-BEFKNGRP                                          
     W2-SUM-SUARTNTO      = W-SUARTNTO                                          
   END-IF                                                                       
   PRINT LISTA1                                                                 
END-PROC.                                                                       
                                                                                
Z-FIN. PROC                                                                     
   W2-TOT-SUARTNTO        = W2-SUM-SUARTNTO                                     
   W2-GTOT-SUARTNTO       = W2-SUM-SUARTNTO                                     
   W2-FUNKKAT             = W2-IDFKNGRP1 + 1                                    
   PRINT LISTA2                                                                 
END-PROC.                                                                       
                                                                                
**************************                                                      
**  RAPPORT W56077-001   *                                                      
**************************                                                      
                                                                                
  REPORT LISTA1                 +                                               
         PRINTER W56077D4       +                                               
         PAGESIZE 60            +                                               
         LINESIZE 200           +                                               
         SPACE 0                +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NODATE                 +                                               
         NOADJUST                                                               
                                                                                
                                                                                
SEQUENCE W-IDFKNGRP                                                             
                                                                                
CONTROL  FINAL NOPRINT +                                                        
        W-IDFKNGRP NOPRINT                                                      
                                                                                
SUM      W-SUM-SUARTNTO         +                                               
         W-TOT-SUARTNTO                                                         
                                                                                
                                                                                
LINE     W-IDFKNGRP           +                                                 
         W-SEM                +                                                 
         W-IDFAKT             +                                                 
         W-SEM                +                                                 
         W-IDARTNR            +                                                 
         W-SEM                +                                                 
         W-KVAKS              +                                                 
         W-SEM                +                                                 
         'Å'                  +                                                 
         W-PRARTNTO           +                                                 
         W-SEM                +                                                 
         'Å'                  +                                                 
         W-SUARTNTO           +                                                 
         W-SEM                +                                                 
         W-BEART              +                                                 
         W-SEM                                                                  
                                                                                
 BEFORE-BREAK. PROC                                                             
   IF LEVEL = 1                                                                 
     DISPLAY W-SEM             +                                                
             W-SEM             +                                                
              'SUB TOTAL:'     +                                                
             W-SEM             +                                                
             W-SEM             +                                                
             W-SEM             +                                                
             'Å'               +                                                
             W-SUM-SUARTNTO    +                                                
             W-SEM                                                              
     DISPLAY ' '                                                                
   END-IF                                                                       
   IF LEVEL = 2                                                                 
     DISPLAY W-SEM             +                                                
             W-SEM             +                                                
             'TOTAL:'          +                                                
             W-SEM             +                                                
             W-SEM             +                                                
             W-SEM             +                                                
             'Å'               +                                                
             W-TOT-SUARTNTO    +                                                
             W-SEM                                                              
     DISPLAY ' '                                                                
   END-IF                                                                       
 END-PROC                                                                       
                                                                                
BEFORE-LINE. PROC                                                               
 IF FIRST-LINE1 = 'J'                                                           
   DISPLAY '¤DAPW56077-001'                                                     
   DISPLAY '¤DAPW56077'                                                         
   DISPLAY 'FUNCTION GROUP;INVOICE NUMBER;PART NUMBER;TOTAL STOCK;'    +        
           'INVOICE COST;EXTENDED COST;DESCRIPTION;'                            
   FIRST-LINE1 = 'N'                                                            
 END-IF                                                                         
END-PROC                                                                        
**************************                                                      
**  RAPPORT W56077-002   *                                                      
**************************                                                      
                                                                                
  REPORT LISTA2                 +                                               
         PRINTER W56077D4       +                                               
         PAGESIZE 60            +                                               
         LINESIZE  200          +                                               
         SPACE 0                +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NODATE                 +                                               
         NOADJUST                                                               
                                                                                
SEQUENCE W2-IDFKNGRP                                                            
                                                                                
CONTROL  FINAL NOPRINT              +                                           
         W2-FUNKKAT NOPRINT +                                                   
         W2-IDFKNGRP NOPRINT                                                    
                                                                                
SUM      W2-TOT-SUARTNTO   +                                                    
         W2-GTOT-SUARTNTO                                                       
                                                                                
                                                                                
LINE  1  W2-IDFKNGRP       +                                                    
         W-SEM             +                                                    
         'Å'               +                                                    
         W2-SUM-SUARTNTO   +                                                    
         W-SEM             +                                                    
         W2-BEFKNGRP       +                                                    
         W-SEM                                                                  
                                                                                
 BEFORE-BREAK. PROC                                                             
   IF LEVEL = 2                                                                 
     DISPLAY 'SUB TOTAL:'  +                                                    
             W-SEM         +                                                    
             'Å'           +                                                    
             W2-TOT-SUARTNTO +                                                  
             W-SEM                                                              
     DISPLAY ' '                                                                
   END-IF                                                                       
   IF LEVEL = 3                                                                 
     DISPLAY 'GRAND TOTAL:' +                                                   
             W-SEM         +                                                    
             'Å'           +                                                    
             W2-GTOT-SUARTNTO +                                                 
             W-SEM                                                              
     DISPLAY ' '                                                                
   END-IF                                                                       
 END-PROC                                                                       
                                                                                
BEFORE-LINE. PROC                                                               
 IF FIRST-LINE2 = 'J'                                                           
   DISPLAY '¤DAPW56077-002'                                                     
   DISPLAY '¤DAPW56077'                                                         
   DISPLAY 'FUNCTION GROUP;EXTENDED COST;FUNCTION GROUP NAME;'                  
   FIRST-LINE2 = 'N'                                                            
 END-IF                                                                         
END-PROC                                                                        
