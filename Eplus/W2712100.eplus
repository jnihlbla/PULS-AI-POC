NEWPAGE                                                                         
FILE W27121D1                                                                   
*                                                                               
%W27147  'K7-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE W27121D2                                                                   
*                                                                               
%W01160  'K6-'                                                                  
                                                                                
NEWPAGE                                                                         
FILE W27121D3 FB(79 0)                                                          
*                                                                               
%W27121  'UT-'                                                                  
                                                                                
AKTIV      W   1   A  VALUE  'A'                                                
IX         W   2   N  VALUE 0                                                   
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. LÄSER POSTER SKRIVER UTFIL                                            
*                                                                               
    JOB INPUT (W27121D2 KEY (K6-CLAG-IDARTNR)      +                            
             W27121D1 KEY (K7-SLAG-IDARTNR))       +                            
                                         NAME STEG01                            
                                                                                
    IF MATCHED                                                                  
       PERFORM SKAPA-FIL                                                        
       PUT W27121D3                                                             
    END-IF                                                                      
                                                                                
SKAPA-FIL. PROC                                                                 
                                                                                
      UT-IDDC        = K7-SLAG-IDDC                                             
      UT-IDARTNR     = K7-SLAG-IDARTNR                                          
      UT-KDPRODSL    = K6-CLAG-KDPRODSL                                         
      UT-KDREFSTA    = K7-SLAG-KDREFSTA                                         
      UT-PRARTSTD    = K6-CLAG-PRARTSTD                                         
      UT-KVPB-REF    = K7-SLAG-KVPB-REF                                         
      UT-KVPBREOI    = K7-SLAG-KVPBREOI                                         
      UT-KVREFBER    = K7-SLAG-KVREFBER                                         
      UT-KVREFOVL    = K7-SLAG-KVREFOVL                                         
      UT-KVREFPKT    = K7-SLAG-KVREFPKT                                         
      UT-TIREFPAF    = K7-SLAG-TIREFPAF                                         
      UT-TIREFPKT    = K7-SLAG-TIREFPKT                                         
      UT-ADLAGOMR-DC = K7-SLAG-ADLAGOMR                                         
      UT-IDLEVNR-DC  = K7-SLAG-IDLEVNR                                          
      UT-FLWILSON    = K7-SLAG-FLWILSON                                         
      UT-FLREFBEO    = K7-SLAG-FLREFBEO                                         
      UT-IDREFTAB    = K7-SLAG-IDREFTAB                                         
      UT-IDDC-REF    = K7-SLAG-IDDC-REF                                         
      IX = 1                                                                    
      DO WHILE IX LT 13                                                         
         UT-RESEASON(IX) = K7-SLAG-RESEASON(IX)                                 
         IX = IX + 1                                                            
      END-DO                                                                    
END-PROC                                                                        
                                                                                
