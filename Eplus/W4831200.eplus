*                                                                               
FILE W48312D8 VIRTUAL FB(22 0)                                                  
UT2-IDDC        1   2   A                                                       
UT2-IDDISTR     3   3   P 0                                                     
UT2-IDKUNDNR    6   4   P 0                                                     
UT2-KDORDKL    10   1   P 0                                                     
UT2-KVKOLLI    11   4   P 0                                                     
UT2-VKFAKTBTO  15   4   P 1                                                     
UT2-VLFAKTBTO  19   4   P 3                                                     
NEWPAGE                                                                         
*                                                                               
*                                                                               
* ARBETSAREOR TILL STEG 1                                                       
W1-IDKUNDREF-RO        W     10   A                                             
W1-IDRONR    W1-IDKUNDREF-RO  5   N 0                                           
W11-ORDER              W      4   P 0  VALUE +1                                 
W11-RADER              W      4   P 0                                           
W11-SUFAKTV-FOB        W      6   P 2                                           
W11-SUFAKTV-STD        W      6   P 2                                           
W11-VKFAKTNTO          W      4   P 1                                           
W11-VLFAKTNTO          W      6   P 1                                           
*                                                                               
* ARBETSAREOR TILL STEG 2                                                       
W21-IDDC               W      2   A                                             
W21-IDKUNDNR           W      4   P 0                                           
W21-IDDISTR            W      3   P 0                                           
W21-KDORDKL            W      1   P 0                                           
W21-KVKOLLI            W      4   P 0                                           
W21-VKFAKTBTO          W      4   P 1                                           
W21-VLFAKTBTO          W      4   P 3                                           
NEWPAGE                                                                         
*                                                                               
*                                                                               
%WDATAREA 'W-'                                                                  
*                                                                               
W3-TIAAVV              W      4   N 0                                           
W3-TIAA    W3-TIAAVV          2   N 0                                           
W3-TIVV    W3-TIAAVV +2       2   N 0                                           
NEWPAGE                                                                         
*                                                                               
*                                                                               
MATCH                  W      4   P 0                                           
NOMATCH                W      4   P 0                                           
*                                                                               
OLD-IDDC               W      2   A                                             
OLD-IDKUNDNR           W      4   P 0                                           
OLD-KDORDKL            W      1   P 0                                           
OLD-IDDISTR            W      3   P 0                                           
OLD-IDPRODNR           W      4   P 0                                           
OLD-IDARTNR            W      5   P 0                                           
OLD-IDRONR             W      5   N 0                                           
*                                                                               
FOERSTA-GANG           W      1   A    VALUE 'J'                                
JA                     W      1   A    VALUE 'J'                                
NEJ                    W      1   A    VALUE 'N'                                
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
**                                                                              
JOB INPUT W48312D1                                                              
*                                                                               
  IF RAD-FLDIRLEV = 'J'                                                         
     RAD-KDORDKL = 5                                                            
  END-IF                                                                        
  W1-IDKUNDREF-RO = RAD-IDKUNDRF-RO                                             
  PERFORM SKRIV                                                                 
*                                                                               
SKRIV.  PROC                                                                    
  M1-IDDC      = RAD-IDDC-LEV                                                   
  M1-IDKUNDNR  = RAD-IDKUNDNR                                                   
  M1-KDORDKL   = RAD-KDORDKL                                                    
  M1-IDPRODNR  = RAD-IDPRODNR                                                   
  M1-IDARTNR   = RAD-IDARTNR                                                    
  M1-IDRONR    = W1-IDRONR                                                      
  M1-IDDISTR   = RAD-IDDISTR                                                    
  M1-KVLEVART2 = RAD-KVLEVART2                                                  
  M1-PRARTNTO  = RAD-PRARTNTO                                                   
  M1-PRARTSTD  = RAD-PRARTSTD                                                   
  M1-VKART     = RAD-VKARTNTO                                                   
  M1-VLARTNTO  = RAD-VLARTNTO                                                   
  PUT W48312D4                                                                  
END-PROC                                                                        
***                                                                             
SORT W48312D4 TO W48312D5 USING (M1-IDDC M1-IDKUNDNR M1-IDDISTR +               
                      M1-KDORDKL M1-IDPRODNR M1-IDARTNR M1-IDRONR)              
***                                                                             
NEWPAGE                                                                         
**                                                                              
JOB INPUT W48312D5 FINISH SKRIV1                                                
*                                                                               
  IF FOERSTA-GANG = JA                                                          
                                                                                
    OLD-IDDC      = S1-IDDC                                                     
    OLD-IDKUNDNR  = S1-IDKUNDNR                                                 
    OLD-IDDISTR   = S1-IDDISTR                                                  
    OLD-KDORDKL   = S1-KDORDKL                                                  
    OLD-IDPRODNR  = S1-IDPRODNR                                                 
    OLD-IDARTNR   = S1-IDARTNR                                                  
    OLD-IDRONR    = S1-IDRONR                                                   
                                                                                
    FOERSTA-GANG = NEJ                                                          
  END-IF                                                                        
NEWPAGE                                                                         
*                                                                               
  IF OLD-IDDC     = S1-IDDC     AND  +                                          
     OLD-IDKUNDNR = S1-IDKUNDNR AND  +                                          
     OLD-IDDISTR  = S1-IDDISTR  AND  +                                          
     OLD-KDORDKL  = S1-KDORDKL                                                  
                                                                                
    W11-RADER = W11-RADER + 1                                                   
    W11-SUFAKTV-FOB = W11-SUFAKTV-FOB +                                         
                    + (S1-KVLEVART2 * S1-PRARTNTO)                              
                                                                                
    W11-SUFAKTV-STD = W11-SUFAKTV-STD +                                         
                    + (S1-KVLEVART2 * S1-PRARTSTD)                              
                                                                                
    W11-VKFAKTNTO = W11-VKFAKTNTO + (S1-KVLEVART2 * S1-VKART)                   
    W11-VLFAKTNTO = W11-VLFAKTNTO + (S1-KVLEVART2 * S1-VLARTNTO)                
                                                                                
    IF OLD-IDPRODNR NE S1-IDPRODNR                                              
      W11-ORDER = W11-ORDER + 1                                                 
      OLD-IDPRODNR = S1-IDPRODNR                                                
    END-IF                                                                      
                                                                                
    IF OLD-IDARTNR NE S1-IDARTNR                                                
      OLD-IDARTNR = S1-IDARTNR                                                  
    END-IF                                                                      
                                                                                
    IF OLD-IDRONR NE S1-IDRONR                                                  
      OLD-IDRONR = S1-IDRONR                                                    
    END-IF                                                                      
                                                                                
  ELSE                                                                          
    PERFORM SKRIV1                                                              
    W11-RADER = 1                                                               
    W11-ORDER = 1                                                               
    MOVE ZERO TO W11-SUFAKTV-STD                                                
                 W11-SUFAKTV-FOB                                                
                 W11-VKFAKTNTO                                                  
                 W11-VLFAKTNTO                                                  
    PERFORM SPARA1                                                              
    W11-SUFAKTV-STD = S1-KVLEVART2 * S1-PRARTSTD                                
    W11-SUFAKTV-FOB = S1-KVLEVART2 * S1-PRARTNTO                                
    W11-VKFAKTNTO = S1-KVLEVART2 * S1-VKART                                     
    W11-VLFAKTNTO = S1-KVLEVART2 * S1-VLARTNTO                                  
                                                                                
  END-IF                                                                        
NEWPAGE                                                                         
*                                                                               
SPARA1. PROC                                                                    
  OLD-IDDC      = S1-IDDC                                                       
  OLD-IDKUNDNR  = S1-IDKUNDNR                                                   
  OLD-IDDISTR   = S1-IDDISTR                                                    
  OLD-KDORDKL   = S1-KDORDKL                                                    
  OLD-IDPRODNR  = S1-IDPRODNR                                                   
  OLD-IDARTNR   = S1-IDARTNR                                                    
  OLD-IDRONR    = S1-IDRONR                                                     
END-PROC                                                                        
*                                                                               
*                                                                               
SKRIV1. PROC                                                                    
  UT1-IDDC         = OLD-IDDC                                                   
  UT1-IDDISTR      = OLD-IDDISTR                                                
  UT1-IDKUNDNR     = OLD-IDKUNDNR                                               
  UT1-KDORDKL      = OLD-KDORDKL                                                
  UT1-KVRADER-FAKT = W11-RADER                                                  
  UT1-KVORDER-FAKT = W11-ORDER                                                  
  UT1-SUFAKTV-STD  = W11-SUFAKTV-STD                                            
  UT1-SUFAKTV-FOB  = W11-SUFAKTV-FOB                                            
  UT1-VKFAKTNTO    = W11-VKFAKTNTO                                              
  UT1-VLFAKTNTO    = W11-VLFAKTNTO / 1000000 + .0005                            
                                                                                
  PUT W48312D6                                                                  
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
*** STEG 2                                                                      
***                                                                             
SORT W48312D2 TO W48312D7 USING (KOLLI-IDDC KOLLI-IDKUNDNR +                    
                   KOLLI-IDDISTR KOLLI-KDORDKL KOLLI-IDKOLLI)  +                
                                 BEFORE SORT-PROC                               
SORT-PROC.  PROC                                                                
  IF KOLLI-FLDIRLEV = 'J'                                                       
    KOLLI-KDORDKL = 5                                                           
  END-IF                                                                        
  SELECT                                                                        
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
***                                                                             
JOB INPUT NULL                                                                  
  GET W48312D7                                                                  
  PERFORM NOLLA21                                                               
  DO WHILE NOT EOF W48312D7                                                     
    PERFORM SPARA21                                                             
                                                                                
    DO WHILE NOT EOF W48312D7 AND S2-IDDC     = W21-IDDC +                      
                              AND S2-IDKUNDNR = W21-IDKUNDNR +                  
                              AND S2-IDDISTR  = W21-IDDISTR  +                  
                              AND S2-KDORDKL  = W21-KDORDKL                     
      W21-KVKOLLI   = W21-KVKOLLI + 1                                           
      W21-VKFAKTBTO = W21-VKFAKTBTO + S2-VKORDBTO-KOLLI                         
      W21-VLFAKTBTO = W21-VLFAKTBTO + S2-VLORDBTO-KOLLI                         
                                                                                
      GET W48312D7                                                              
    END-DO                                                                      
                                                                                
    PERFORM SKRIV21                                                             
    PERFORM NOLLA21                                                             
                                                                                
  END-DO                                                                        
STOP                                                                            
***                                                                             
NEWPAGE                                                                         
*                                                                               
NOLLA21.  PROC                                                                  
  MOVE ZERO  TO W21-IDKUNDNR  W21-IDDISTR W21-KDORDKL +                         
                W21-VKFAKTBTO W21-VLFAKTBTO W21-KVKOLLI                         
                                                                                
  MOVE SPACE TO W21-IDDC                                                        
END-PROC                                                                        
*                                                                               
*                                                                               
SPARA21.  PROC                                                                  
  W21-IDDC     = S2-IDDC                                                        
  W21-IDKUNDNR = S2-IDKUNDNR                                                    
  W21-IDDISTR  = S2-IDDISTR                                                     
  W21-KDORDKL  = S2-KDORDKL                                                     
  W21-IDDISTR  = S2-IDDISTR                                                     
END-PROC                                                                        
*                                                                               
*                                                                               
SKRIV21.  PROC                                                                  
  UT2-IDDC      = W21-IDDC                                                      
  UT2-IDKUNDNR  = W21-IDKUNDNR                                                  
  UT2-KDORDKL   = W21-KDORDKL                                                   
  UT2-IDDISTR   = W21-IDDISTR                                                   
  UT2-KVKOLLI   = W21-KVKOLLI                                                   
  UT2-VKFAKTBTO = W21-VKFAKTBTO                                                 
  UT2-VLFAKTBTO = W21-VLFAKTBTO                                                 
                                                                                
  PUT W48312D8                                                                  
END-PROC                                                                        
***                                                                             
NEWPAGE                                                                         
***                                                                             
JOB INPUT (W48312D6 KEY(UT1-IDDC UT1-IDKUNDNR UT1-IDDISTR       +               
                        UT1-KDORDKL)  +                                         
           W48312D8 KEY(UT2-IDDC UT2-IDKUNDNR UT2-IDDISTR       +               
                        UT2-KDORDKL)) +                                         
           START VECKONR FINISH DISPLAY-ACC                                     
*                                                                               
IF MATCHED                                                                      
  PERFORM SKRIV31                                                               
  MATCH = MATCH + 1                                                             
                                                                                
ELSE                                                                            
  NOMATCH = NOMATCH + 1                                                         
  IF W48312D8                                                                   
    DISPLAY UT2-IDDC    'X' UT2-IDDISTR 'X' UT2-IDKUNDNR 'X' +                  
            UT2-KDORDKL 'X' UT2-KVKOLLI 'X' 'D8'                                
  ELSE                                                                          
                                                                                
    IF W48312D6                                                                 
      DISPLAY  UT1-IDDC     'X' UT1-IDDISTR 'X' +                               
           'X' UT1-IDKUNDNR 'X' UT1-KDORDKL 'X' 'D6'                            
    END-IF                                                                      
                                                                                
  END-IF                                                                        
END-IF                                                                          
**                                                                              
NEWPAGE                                                                         
*                                                                               
SKRIV31.  PROC                                                                  
                                                                                
UT-TIAAVV       = W3-TIAAVV                                                     
UT-IDDC         = UT1-IDDC                                                      
UT-IDDISTR      = UT1-IDDISTR                                                   
UT-IDKUNDNR     = UT1-IDKUNDNR                                                  
UT-KDORDKL      = UT1-KDORDKL                                                   
UT-KVRADER-FAKT = UT1-KVRADER-FAKT                                              
UT-KVORDER-FAKT = UT1-KVORDER-FAKT                                              
UT-SUFAKTV-FOB  = UT1-SUFAKTV-FOB                                               
UT-VKFAKTNTO    = UT1-VKFAKTNTO                                                 
UT-VLFAKTNTO    = UT1-VLFAKTNTO                                                 
UT-SUFAKTV-STD  = UT1-SUFAKTV-STD                                               
UT-KVKOLLI      = UT2-KVKOLLI                                                   
UT-VKFAKTBTO    = UT2-VKFAKTBTO                                                 
UT-VLFAKTBTO    = UT2-VLFAKTBTO                                                 
                                                                                
PUT W48312D3                                                                    
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
VECKONR.  PROC                                                                  
                                                                                
W-DAT-KDDATFORM = 'IDAG  '                                                      
CALL WDATKONV USING(W-DAT-KDDATFORM W-DAT-I-TIDATUM W-DAT-O-TIDATUM +           
                    W-DAT-KDSVAR)                                               
W3-TIAA = W-DAT-TIAA                                                            
W3-TIVV = W-DAT-TIVV                                                            
                                                                                
END-PROC                                                                        
*                                                                               
*                                                                               
DISPLAY-ACC.  PROC                                                              
                                                                                
DISPLAY NEWPAGE  'ANTAL MATCHADE:  ' MATCH                                      
DISPLAY SKIP 1   'ANTAL OMATCHADE: ' NOMATCH                                    
                                                                                
END-PROC                                                                        
***                                                                             
