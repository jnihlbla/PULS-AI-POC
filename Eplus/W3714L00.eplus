                                                                                
**********************************************************************          
*                                                                    *          
* PROGRAM ............ : W3714L                                      *          
*                                                                    *          
* SKRIVET AV ......... :     SKJELBRED    50654                      *          
*                                                                    *          
* DATUM .............. : 970731                                      *          
*                                                                    *          
* FUNKTION .. : DETTA PROGRAM SKAPAR UPPFÖLJNING TILL BORN           *          
*                                                                    *          
* INDATA .... : W371.W3714L(+0) RÅ MATERIAL TILL UPPFÖLJNINGEN       *          
*                                                                    *          
* UTDATA..... : LISTA91                                              *          
*               LISTA11                                              *          
*                                                                    *          
**********************************************************************          
*                                                                               
NEWPAGE                                                                         
*                                                                               
*****************************************************************               
*                                                               *               
* INFIL W371.W3714L(+0) ÅRSFIL MED ALLA ARTIKLARNAS PRISER      *               
*                                                               *               
*****************************************************************               
*                                                                               
FILE W3714LD1                                                                   
%W3714J  'IN4J-'                                                                
                                                                                
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* BYTESUPPFÖLJNING BORN SORTERAD PÅ DISTRIKT OCH FUNKTIONSGRUPP *               
*                                OCH ARTIKEL                    *               
*****************************************************************               
                                                                                
FILE TPFIL1 FB(42 0)                                                            
                                                                                
%W3714J   'T4J-'                                                                
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* RAPPORT BYTESUPPFÖLJNING TILL BORN LISTA91                    *               
*                                                               *               
*****************************************************************               
                                                                                
FILE W3714LD2 PRINTER FB (121 0)                                                
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* RAPPORT UTFIL SOM GÅR ATT PLOCKA UPP I EXEL                   *               
*                                                               *               
*****************************************************************               
                                                                                
FILE W3714LD3 VB(70 0)                                                          
UT-POST        1  70  A                                                         
%W3714P   'UT4P-'                                                               
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* RAPPORT BYTESUPPFÖLJNING TILL BORN LISTA11                    *               
*                                                               *               
*****************************************************************               
                                                                                
FILE W3714LD4 PRINTER FB (121 0)                                                
                                                                                
*****************************************************************               
*                                                               *               
* HOST VARIABLER                                                *               
*                                                               *               
*****************************************************************               
                                                                                
*    --- VALID IDDC CODES                                                       
%WWDC99                                                                         
*                                                                               
W-IDDC            W   2  A                                                      
W-IDDISTR         W   5  N MASK 'ZZZZ9'.                                        
W-KVRETUR         W   7  N MASK 'ZZZZZZ9'.                                      
W-IDARTNR         W   9  N MASK 'ZZZZZZZZ9'.                                    
W-IDFKNGRP        W   5  N MASK 'ZZZZ9'.                                        
W-BEART           W   25 A.                                                     
W-SUM-11          W   4 P 0 MASK 'ZZZZZZ9'                                      
W-SUM-91          W   4 P 0 MASK 'ZZZZZZ9'                                      
FORSTA-POST       W   1 A                                                       
                                                                                
W-RUB1                W  59 A                                                   
W-RUB1TEXT1   W-RUB1     10 A VALUE  'W3714L-091'                               
W-RUB1FILLER1 W-RUB1 +11  1 A VALUE  ';'                                        
W-RUBTEXT2    W-RUB1 +12 46 A VALUE  +                                          
    'DAILY FOLLOWING-UP CORES IN REPORT IN STATUS 4'                            
W-RUB1FILLER2 W-RUB1 +58 1 A VALUE ';'                                          
                                                                                
W-RUB2               W   41 A                                                   
W-RUB2TEXT1   W-RUB2      8 A VALUE  'DISTRICT'                                 
W-RUB2FILLER1 W-RUB2 +9   1 A VALUE  ';'                                        
W-RUB2TEXT2   W-RUB2 +10  7 A VALUE  'PART NO'                                  
W-RUB2FILLER2 W-RUB2 +17  1 A VALUE  ';'                                        
W-RUB2TEXT3   W-RUB2 +18  6 A VALUE  'FNKTGR'                                   
W-RUB2FILLER3 W-RUB2 +24  1 A VALUE  ';'                                        
W-RUB2TEXT4   W-RUB2 +25 11 A VALUE  'DESCRIPTION'                              
W-RUB2FILLER4 W-RUB2 +36  1 A VALUE  ';'                                        
W-RUB2TEXT5   W-RUB2 +37  3 A VALUE  'QTY'                                      
W-RUB2FILLER5 W-RUB2 +40  1 A VALUE  ';'                                        
                                                                                
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* STEG 2  SORTERA PRISREGISTREET PER IDARTNR                    *               
*                                                               *               
*****************************************************************               
                                                                                
SORT W3714LD1 TO TPFIL1 USING (IN4J-IDDC     IN4J-IDDISTR  +                    
                               IN4J-IDFKNGRP IN4J-IDARTNR)                      
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* STEG 4  LÄSER  TPFIL1                                         *               
*                                                               *               
*****************************************************************               
                                                                                
JOB INPUT(TPFIL1)                                                               
                                                                                
  IF T4J-IDDC     = SDC-NL-ET                                                   
    IF FORSTA-POST NE 'N'                                                       
      UT-POST EQ W-RUB1                                                         
      PUT W3714LD3                                                              
      UT-POST EQ W-RUB2                                                         
      PUT W3714LD3                                                              
      FORSTA-POST = 'N'                                                         
    END-IF                                                                      
    W-IDDISTR     = T4J-IDDISTR                                                 
    UT4P-IDDISTR  = T4J-IDDISTR                                                 
    UT4P-SEMI-1   = ';'                                                         
    W-IDARTNR     = T4J-IDARTNR                                                 
    UT4P-IDARTNR  = T4J-IDARTNR                                                 
    UT4P-SEMI-2   = ';'                                                         
    W-IDFKNGRP    = T4J-IDFKNGRP                                                
    UT4P-IDFKNGRP = T4J-IDFKNGRP                                                
    UT4P-SEMI-3   = ';'                                                         
    W-BEART       = T4J-BEART                                                   
    UT4P-BEART    = T4J-BEART                                                   
    UT4P-SEMI-4   = ';'                                                         
    W-KVRETUR     = T4J-KVRETUR                                                 
    UT4P-KVRETUR  = T4J-KVRETUR                                                 
    W-SUM-91      = W-KVRETUR                                                   
*   PRINT LISTA91                                                               
    UT-POST EQ UT4P-W3714P                                                      
    PUT W3714LD3                                                                
  END-IF                                                                        
                                                                                
  IF T4J-IDDC     = CDC-SE                                                      
    W-IDDISTR     = T4J-IDDISTR                                                 
    W-IDARTNR     = T4J-IDARTNR                                                 
    W-IDFKNGRP    = T4J-IDFKNGRP                                                
    W-BEART       = T4J-BEART                                                   
    W-KVRETUR     = T4J-KVRETUR                                                 
    W-SUM-11      = W-KVRETUR                                                   
    PRINT LISTA11                                                               
  END-IF                                                                        
                                                                                
  REPORT LISTA91                +                                               
         PRINTER W3714LD2       +                                               
         PAGESIZE 41            +                                               
         LINESIZE 120           +                                               
         SPACE 1                +                                               
         TITLESKIP 1            +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NOADJUST                                                               
                                                                                
                                                                                
SEQUENCE W-IDDISTR W-IDFKNGRP W-IDARTNR                                         
                                                                                
CONTROL FINAL NOPRINT W-IDDISTR NOPRINT W-IDFKNGRP NOPRINT                      
                                                                                
                                                                                
SUM W-SUM-91                                                                    
                                                                                
TITLE 1  COL 11 'W3714L-091 ' +                                                 
         COL 22 'DAILY FOLLOWING-UP CORES IN REPORT IN STATUS 4'                
                                                                                
TITLE 2  COL 02 'DISTRICT'            +                                         
         COL 13 'FNKTGR'              +                                         
         COL 24 'PART NO'             +                                         
         COL 35 'DESCRIPTION'         +                                         
         COL 67 'QTY'                 +                                         
                                                                                
LINE  1  COL 05  W-IDDISTR            +                                         
         COL 14  W-IDFKNGRP           +                                         
         COL 22  W-IDARTNR            +                                         
         COL 35  W-BEART              +                                         
         COL 63  W-KVRETUR            +                                         
                                                                                
  BEFORE-BREAK. PROC                                                            
    IF LEVEL = 1                                                                
       DISPLAY ' '                                                              
       DISPLAY COL 02 'TOTALS FNKTGR' +                                         
               COL 67 W-SUM-91                                                  
       DISPLAY ' '                                                              
    END-IF                                                                      
    IF LEVEL = 2                                                                
       DISPLAY ' '                                                              
       DISPLAY COL 02 'TOTALS DISTRICT ' +                                      
               COL 67 W-SUM-91                                                  
       DISPLAY ' '                                                              
    END-IF                                                                      
    IF LEVEL = 3                                                                
       DISPLAY ' '                                                              
       DISPLAY COL 02 'TOTAL QUANTITY ' +                                       
               COL 67 W-SUM-91                                                  
       DISPLAY ' '                                                              
    END-IF                                                                      
  END-PROC                                                                      
                                                                                
  REPORT LISTA11                +                                               
         PRINTER W3714LD4       +                                               
         PAGESIZE 41            +                                               
         LINESIZE 120           +                                               
         SPACE 1                +                                               
         TITLESKIP 1            +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NOADJUST                                                               
                                                                                
                                                                                
SEQUENCE W-IDDISTR W-IDFKNGRP W-IDARTNR                                         
                                                                                
CONTROL FINAL NOPRINT W-IDDISTR NOPRINT W-IDFKNGRP NOPRINT                      
                                                                                
                                                                                
SUM W-SUM-11                                                                    
                                                                                
TITLE 1  COL 11 'W3714L-011 ' +                                                 
         COL 22 'DAILY FOLLOWING-UP CORES IN REPORT IN STATUS 4'                
                                                                                
TITLE 2  COL 02 'DISTRICT'            +                                         
         COL 13 'FNKTGR'              +                                         
         COL 24 'PART NO'             +                                         
         COL 35 'DESCRIPTION'         +                                         
         COL 67 'QTY'                 +                                         
                                                                                
LINE  1  COL 05  W-IDDISTR            +                                         
         COL 14  W-IDFKNGRP           +                                         
         COL 22  W-IDARTNR            +                                         
         COL 35  W-BEART              +                                         
         COL 63  W-KVRETUR            +                                         
                                                                                
  BEFORE-BREAK. PROC                                                            
    IF LEVEL = 1                                                                
       DISPLAY ' '                                                              
       DISPLAY COL 02 'TOTALS FNKTGR' +                                         
               COL 67 W-SUM-11                                                  
       DISPLAY ' '                                                              
    END-IF                                                                      
    IF LEVEL = 2                                                                
       DISPLAY ' '                                                              
       DISPLAY COL 02 'TOTALS DISTRICT ' +                                      
               COL 67 W-SUM-11                                                  
       DISPLAY ' '                                                              
    END-IF                                                                      
    IF LEVEL = 3                                                                
       DISPLAY ' '                                                              
       DISPLAY COL 02 'TOTAL QUANTITY ' +                                       
               COL 67 W-SUM-11                                                  
       DISPLAY ' '                                                              
    END-IF                                                                      
  END-PROC                                                                      
                                                                                
