*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5609000                                              *        
*                                                                      *        
*  FUNKTION   :  DAILY LISTS FOR PARTS WITHOUT AVG COST              *          
*                                                                      *        
*  FÖRFATTARE :  RAGUR SATHEESH                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
**                                                                              
NEWPAGE                                                                         
FILE W56090D1                                                                   
*                                                                               
%W01184  'IN-'                                                                  
                                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
FILE W56090D2 VB (59 0) PRINTER                                                 
*                                                                               
****************************************                                        
UT-SLAG-IDARTNR         W   9   N      MASK 'ZZZZZZZZ9'                         
UT-SLAG-IDDC            W   2   A                                               
UT-SLAG-KVLS            W   8   N                                               
UT-SLAG-KVEFRS          W   8   N                                               
UT-SLAG-PRAVCOST        W   9   N 2    MASK '------9.99'                        
*                                                                               
NEWPAGE                                                                         
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
  W-SEM1                    W   1  A   VALUE ';'                                
  W-PREV-IDDC               W   2  A                                            
  RCOUNT                    W   8  N   VALUE  0                                 
  SALDO                     W   8  P 0 VALUE  0                                 
  WS-DESCRIPTION            W  34  A   VALUE 'NO PART WITH AVGCOST ZERO'        
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
JOB INPUT W56090D1  FINISH(Z-FINIT)                                             
                                                                                
 PERFORM S23-CHECK-IN-SLAG-IDDC                                                 
                                                                                
   IF IN-SLAG-IDDC = XDC-NON-VCC-OWNED OR +                                     
      IN-SLAG-IDDC = NDC-NA                                                     
    SALDO = IN-SLAG-KVLS + IN-SLAG-KVEFRS                                       
    IF SALDO GT 0                                                               
       IF IN-SLAG-PRAVCOST EQ 0                                                 
          IF (NOT EOF W56090D1)                                                 
             UT-SLAG-IDARTNR   = IN-SLAG-IDARTNR                                
             UT-SLAG-IDDC      = IN-SLAG-IDDC                                   
             UT-SLAG-KVLS      = IN-SLAG-KVLS                                   
             UT-SLAG-KVEFRS    = IN-SLAG-KVEFRS                                 
             UT-SLAG-PRAVCOST  = IN-SLAG-PRAVCOST                               
             PRINT RAPPORT01                                                    
             RCOUNT = RCOUNT + 1                                                
          END-IF                                                                
       END-IF                                                                   
    END-IF                                                                      
 END-IF                                                                         
*                                                                               
Z-FINIT. PROC                                                                   
   IF RCOUNT EQ 0                                                               
     PRINT RAPPORT02                                                            
     RCOUNT = 1                                                                 
   END-IF                                                                       
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*    --- S23-CHECK-IN-SLAG-IDDC (MACRO PROCEDURE)                               
%WWDC02 'IN-SLAG-'                                                              
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    REPORT SECTION                              *              
*----------------------------------------------------------------*              
*                    REPORT -1 LIST OF PARTS WITHOUT AVEREGE COST*              
*----------------------------------------------------------------*              
*                                                                               
    REPORT RAPPORT01 PRINTER W56090D2                            +              
                     LINESIZE      54                            +              
                     NODATE                                      +              
                     NOHEADING                                   +              
                     NOADJUST                                    +              
                     NOSPREAD                                    +              
                     PAGESIZE       32767                        +              
                     SPACE          0                                           
*                                                                               
    LINE 01                              +                                      
              UT-SLAG-IDARTNR            +                                      
              W-SEM1                     +                                      
              UT-SLAG-IDDC               +                                      
              W-SEM1                     +                                      
              UT-SLAG-KVLS               +                                      
              W-SEM1                     +                                      
              UT-SLAG-KVEFRS             +                                      
              W-SEM1                     +                                      
              UT-SLAG-PRAVCOST           +                                      
              W-SEM1                                                            
                                                                                
BEFORE-LINE. PROC                                                               
 IF  IN-SLAG-IDDC NE W-PREV-IDDC     +                                          
 AND IN-SLAG-IDDC NE ' '                                                        
   DISPLAY '¤DAPW56090-001'                                                     
   DISPLAY '¤DAP' IN-SLAG-IDDC                                                  
   DISPLAY 'PART NUMBER;DC;STOCK BALANCE;NOT INVOICED;AVERAGE COST'             
   W-PREV-IDDC = IN-SLAG-IDDC                                                   
 END-IF                                                                         
END-PROC                                                                        
*                                                                               
*----------------------------------------------------------------*              
*               REPORT -2 NO PARTS WITHOUT AVERAGE COST WITH ZERO*              
*----------------------------------------------------------------*              
*                                                                               
    REPORT RAPPORT02 PRINTER W56090D2                            +              
                     LINESIZE      54                            +              
                     NODATE                                      +              
                     NOHEADING                                   +              
                     NOADJUST                                    +              
                     NOSPREAD                                    +              
                     SPACE          0                                           
    LINE 01   WS-DESCRIPTION                                                    
*                                                                               
BEFORE-LINE. PROC                                                               
 DISPLAY '¤DAPW56090-001'                                                       
 DISPLAY '¤DAPW56090'                                                           
END-PROC                                                                        
*                                                                               
