                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4794900                                              *        
*                                                                      *        
*  FUNKTION   :  CREATE .CSV REPORT TO SHOW THE MOVE BETWEEN INTERNAL  *        
*                VCC WAREHOUSES                                        *        
*                                                                      *        
*  FÖRFATTARE :  ARCHANA BHAT                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W47949D1                                                                   
*                                                                               
%W47948  'IN1-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE TPFIL1 FB(18 0)                                                            
*                                                                               
%W47948  'TMP1-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W47949D2                                                                   
*                                                                               
%W47947  'IN2-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE TPFIL2 FB(89 0)                                                            
*                                                                               
%W47947  'TMP2-'                                                                
                                                                                
**** EXCEL-FIL, MAIL VIA DAP                                                    
FILE W47949D3  PRINTER VB(125 0)                                                
                                                                                
W-PERIOD                    W    6 N                                            
W-FROM-DC                   W    2 A                                            
W-FROM-CTRY                 W   35 A                                            
W-TO-DISTR                  W    5 N 0 MASK 'ZZZZ9'                             
W-TO-CTRY                   W   35 A                                            
W-DISTR-TYP                 W   14 A                                            
W-INV-VALUE-STD             W   13 N 2 MASK 'ZZZZZZZZZZ9.99'                    
W-SEM1                      W    1 A VALUE ';'                                  
FIRST-TIME-SW               W    1 A VALUE 'Y'                                  
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. SORT ON IDDC AND IDDISTR                                              
*                                                                               
SORT W47949D1 TO +                                                              
     TPFIL1 USING (IN1-IDDC-LEV, IN1-IDDISTR)                                   
NEWPAGE                                                                         
*                                                                               
* STEG 2. SORT ON IDDC AND IDDISTR                                              
*                                                                               
SORT W47949D2 TO +                                                              
     TPFIL2 USING (IN2-IDDC, IN2-IDDISTR)                                       
NEWPAGE                                                                         
*                                                                               
* STEG 3. MATCH TPFIL1 AND TPFIL2                                               
*                                                                               
JOB INPUT (TPFIL1 KEY(TMP1-IDDC-LEV, TMP1-IDDISTR) +                            
           TPFIL2 KEY(TMP2-IDDC, TMP2-IDDISTR))                                 
                                                                                
IF MATCHED                                                                      
   W-FROM-DC        = TMP1-IDDC-LEV                                             
   W-FROM-CTRY      = TMP2-ADGMT-LAND-FROM                                      
                                                                                
   W-TO-DISTR       = TMP1-IDDISTR                                              
   W-TO-CTRY        = TMP2-ADGMT-LAND-TO                                        
   W-DISTR-TYP      = TMP2-DISTR-TYP                                            
   W-INV-VALUE-STD  = TMP1-SUARTSTD                                             
   W-PERIOD         = TMP1-TIDATUM                                              
                                                                                
   PRINT XL-LIST                                                                
END-IF                                                                          
                                                                                
NEWPAGE                                                                         
  REPORT   XL-LIST              +                                               
           PRINTER W47949D3     +                                               
           LINESIZE 120         +                                               
           SPACE 0              +                                               
           NOHEADING            +                                               
           NOSPREAD             +                                               
           NOADJUST             +                                               
           PAGESIZE 32767       +                                               
           NODATE                                                               
  LINE  1  W-PERIOD             +                                               
           W-SEM1               +                                               
           W-FROM-DC            +                                               
           W-SEM1               +                                               
           W-FROM-CTRY          +                                               
           W-SEM1               +                                               
           W-TO-DISTR           +                                               
           W-SEM1               +                                               
           W-TO-CTRY            +                                               
           W-SEM1               +                                               
           W-DISTR-TYP          +                                               
           W-SEM1               +                                               
           W-INV-VALUE-STD                                                      
*                                                                               
BEFORE-LINE. PROC                                                               
 IF FIRST-TIME-SW = 'Y'                                                         
   DISPLAY '¤DAPW47949-001'                                                     
   DISPLAY '¤DAPW47949'                                                         
   DISPLAY 'PERIOD;FROM DC;FROM COUNTRY;TO DISTRICT;TO COUNTRY;' +              
           'DISTRICT TYPE;INVOICED VALUE STD;'                                  
   FIRST-TIME-SW = 'N'                                                          
 END-IF                                                                         
END-PROC                                                                        
