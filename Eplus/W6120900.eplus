*                                                                      *        
*  PROGRAM    :  W6120900                                              *        
*                                                                      *        
*  FUNKTION   :  SKAPAR BINNING PRODUCTIVITY REPORT                    *        
*                DAG                                                            
*                                                                      *        
*  FÖRFATTARE :  BODIL LINDAHL                                         *        
*                                                                      *        
*----------------------------------------------------------------------*        
*                                                                               
NEWPAGE                                                                         
FILE W61209D1                                                                   
*                                                                               
%W61208  'IN-'                                                                  
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W61209D2  PRINTER FB (121 0)                                               
FILE W61209D3  PRINTER FB (121 0)                                               
FILE W61209D4  PRINTER FB (121 0)                                               
FILE W61209D5  PRINTER FB (121 0)                                               
*                                                                               
FILE W61209D6  PRINTER VB (125 0)                                               
FILE W61209D7  PRINTER VB (125 0)                                               
FILE W61209D8  PRINTER VB (125 0)                                               
*                                                                               
NEWPAGE                                                                         
*                                                                               
PROGRAM-NAMN      W   6   A   VALUE 'W61209'                                    
DATUMKORT-ID      W   6   A   VALUE 'WDATUM'                                    
%WDATKORT 'DATKORT-'                                                            
*                                                                               
NEWPAGE                                                                         
*                                                                               
WS-AAMMDD         W             6  N                                            
WS-AAR            WS-AAMMDD     2  N                                            
WS-MM             WS-AAMMDD  +2 2  N                                            
WS-DD             WS-AAMMDD  +4 2  N                                            
*                                                                               
INNEV-AAMMDD      W                6  N                                         
INNEV-AAR         INNEV-AAMMDD     2  N                                         
INNEV-MM          INNEV-AAMMDD  +2 2  N                                         
INNEV-DD          INNEV-AAMMDD  +4 2  N                                         
WS-IDDC           W 2 A                                                         
WS-ADLAGOMR-1     W 5 N MASK 'ZZZZ9'                                            
WS-ADLAGOMR-2     W 5 N MASK 'ZZZZ9'                                            
WS-ADLAGOMR-3     W 5 N MASK 'ZZZZ9'                                            
WS-ADLAGOMR-4     W 5 N MASK 'ZZZZ9'                                            
WS-ADLAGOMR-9     W 5 N MASK 'ZZZZ9'                                            
WS-ADLAGOMR-OVR   W 5 N MASK 'ZZZZ9'                                            
WS-KVRADER-BIN    W 5 N MASK 'ZZZZ9'                                            
WS-KVRADER-SHORT  W 5 N MASK 'ZZZZ9'                                            
WS-KVRADER-OVER   W 5 N MASK 'ZZZZ9'                                            
WS-KVRADER-DAM    W 5 N MASK 'ZZZZ9'                                            
WS-PREV-IDDC      W 2 A       VALUE '  '                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    --- TO CHECK IF "WEB DC"                                                   
*                                                                               
%WL10WBDC                                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
NEWPAGE                                                                         
************************************************************************        
* SKAPAR LISTA                                                                  
************************************************************************        
*                                                                               
JOB INPUT (W61209D1) +                                                          
    START (A-INIT)                                                              
                                                                                
    WS-AAMMDD        = IN-TIAAMMDD                                              
    WS-KVRADER-BIN   = IN-KVRADER-BIN                                           
    WS-KVRADER-SHORT = IN-KVRADER-SHORT                                         
    WS-KVRADER-OVER  = IN-KVRADER-OVER                                          
    WS-KVRADER-DAM   = IN-KVRADER-DAM                                           
    WS-ADLAGOMR-1 = IN-KVANTAL-1                                                
    WS-ADLAGOMR-2 = IN-KVANTAL-2                                                
    WS-ADLAGOMR-3 = IN-KVANTAL-3                                                
    WS-ADLAGOMR-4 = IN-KVANTAL-4                                                
    WS-ADLAGOMR-9 = IN-KVANTAL-9                                                
    WS-ADLAGOMR-OVR = IN-KVANTAL-OVR                                            
    MOVE IN-IDDC TO WS-IDDC                                                     
    PERFORM S23-CHECK-WS-IDDC                                                   
                                                                                
    WBDC-IDDC = IN-IDDC                                                         
    CALL WL10WBDC USING WBDC-AREA                                               
                                                                                
**  IF WS-IDDC = SDC-GB                                                         
**     PRINT W61209-001                                                         
**  ELSE                                                                        
       IF WS-IDDC = NDC-US-RU                                                   
          PRINT W61209-002                                                      
       ELSE                                                                     
**        IF WS-IDDC = NDC-US-AT                                                
**           PRINT W61209-003                                                   
**        ELSE                                                                  
**           IF WS-IDDC = NDC-US-LA                                             
**              PRINT W61209-004                                                
**           ELSE                                                               
                IF WS-IDDC = CDC-SE                                             
                   PRINT W61209-011                                             
                ELSE                                                            
                   IF WBDC-FLWEBDC = 'J'                                        
                    IF (WS-IDDC = NDC-CN OR WS-IDDC = NDC-PACIFIC +             
                        OR WS-IDDC = NDC-AE)                                    
                      PRINT W61209-006                                          
                    ELSE                                                        
                      PRINT W61209-005                                          
                    END-IF                                                      
                   END-IF                                                       
                END-IF                                                          
**           END-IF                                                             
**        END-IF                                                                
       END-IF                                                                   
**  END-IF                                                                      
                                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
A-INIT. PROC                                                                    
*                                                                               
  CALL DATKORT  USING (PROGRAM-NAMN +                                           
                       DATUMKORT-ID +                                           
                       DATKORT-DATUMKORT)                                       
*                                                                               
  INNEV-AAR = DATKORT-D-AAR                                                     
  INNEV-MM  = DATKORT-D-MAANAD                                                  
  INNEV-DD  = DATKORT-D-DAG                                                     
*                                                                               
 DISPLAY ' DATKORT DATUM : ' WS-AAMMDD                                          
*                                                                               
                                                                                
END-PROC                                                                        
*                                                                               
NEWPAGE                                                                         
*                                                                               
