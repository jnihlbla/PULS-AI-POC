                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W517   VECKORAPPORTEN                                 *        
*                                                                      *        
*  FUNKTION   :  LÄSER VECKORAPPORTSREGISTER FÖR SENASTE TVÅ VECKORNA  *        
*                OCH SKAPAR EN SUMMERAD LISTA PER VECKA OCH MARKNAD    *        
*                                                                      *        
*  FÖRFATTARE :  KARL JOHAN HANSSON                                    *        
*                                                                      *        
*  INFILER    :  W517.W517V1.W51741(+0)                                *        
*                                                                      *        
*  UTFILER    :  W51706, LISTA SUMMERAD PER VECKA OCH MARKNAD          *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W51706D1                                                                   
%W517RW1  'I1-'                                                                 
                                                                                
FILE TPFIL1 FB(14 0)                                                            
T1-DAVVREG        1  6 N                                                        
T1-KDMARK         7  2 N                                                        
T1-SUFSG          9  6 P 2                                                      
                                                                                
FILE W51706D2 VB(28 0)                                                          
U1-AREA           1 28  A                                                       
U1-DAVVREG        2  6  N                                                       
U1-FILLER1        8  1  A                                                       
U1-KDMARK         9  2  N                                                       
U1-FILLER2       11  1  A                                                       
U1-SIGN          12  1  A                                                       
U1-SUFSG-H       13  9  N                                                       
U1-SUFSG-K       22  1  A                                                       
U1-SUFSG-D       23  2  N                                                       
                                                                                
*--------------------------*                                                    
* DATUMKORT                *                                                    
*--------------------------*                                                    
PROGRAM-NAMN   W    8    A        VALUE 'W5170600'                              
DATUMKORT-ID   W    6    A        VALUE 'WDATUM'                                
%WDATKORT                                                                       
                                                                                
AKT-AARVV       W   6 N VALUE 0                                                 
AKT-SEKEL  AKT-AARVV     2   N                                                  
AKT-AAR    AKT-AARVV +2  2   N                                                  
AKT-VV     AKT-AARVV +4  2   N                                                  
                                                                                
****  WORKAREA                                                                  
W-TAB     W  1  A  VALUE X'05'                                                  
                                                                                
W-SUFSG         W 11  N  2                                                      
W-SUFSG-H     W-SUFSG         9 N                                               
W-SUFSG-D     W-SUFSG     +9  2 N                                               
                                                                                
NEWPAGE                                                                         
*------------------*                                                            
* STEG1, SELEKTERA *                                                            
*------------------*                                                            
                                                                                
JOB INPUT W51706D1 START A-INIT                                                 
                                                                                
IF I1-IDPTYP = 'RW1'                                                            
*** TAR FRAM SENASTE OCH NÄST SENASTE VECKANS FSG-VÄRDEN                        
  IF I1-DAVVREG EQ AKT-AARVV OR +                                               
     I1-DAVVREG EQ AKT-AARVV - 1                                                
    T1-DAVVREG   = I1-DAVVREG                                                   
    T1-KDMARK    = I1-KDMARK                                                    
    T1-SUFSG     = I1-SUARTFSG                                                  
    PUT TPFIL1                                                                  
  END-IF                                                                        
END-IF                                                                          
                                                                                
A-INIT. PROC                                                                    
  CALL DATKORT USING (PROGRAM-NAMN DATUMKORT-ID DATUMKORT)                      
  AKT-SEKEL        = 20                                                         
  AKT-AAR          = D-AAR                                                      
  AKT-VV           = D-VECKA                                                    
END-PROC                                                                        
                                                                                
*------------------*                                                            
* STEG2, SORTERA   *                                                            
*------------------*                                                            
                                                                                
SORT TPFIL1 TO TPFIL1 USING (T1-DAVVREG T1-KDMARK)                              
                                                                                
*------------------*                                                            
* STEG3, SUMMERA   *                                                            
*------------------*                                                            
                                                                                
JOB INPUT TPFIL1 START B-INIT FINISH Z-AVSLUTA                                  
                                                                                
IF T1-DAVVREG EQ U1-DAVVREG AND T1-KDMARK EQ U1-KDMARK                          
  W-SUFSG = W-SUFSG + T1-SUFSG                                                  
ELSE                                                                            
  IF W-SUFSG NE 0                                                               
    U1-SUFSG-H   = W-SUFSG-H                                                    
    U1-SUFSG-K   = ','                                                          
    U1-SUFSG-D   = W-SUFSG-D                                                    
    IF W-SUFSG LT 0                                                             
      U1-SIGN    = '-'                                                          
    ELSE                                                                        
      U1-SIGN    = ' '                                                          
    END-IF                                                                      
    PUT W51706D2                                                                
  END-IF                                                                        
  U1-DAVVREG     = T1-DAVVREG                                                   
  U1-KDMARK      = T1-KDMARK                                                    
  W-SUFSG = T1-SUFSG                                                            
END-IF                                                                          
                                                                                
B-INIT. PROC                                                                    
***  OBS MELLAN DELRUBRIKERNA FINNS AVGRÄNSARE X'05' (W-TAB)                    
  U1-AREA        = 'ÅR VECKA	MARKNAD	 SUMMA FSG'                                
  PUT W51706D2                                                                  
  U1-AREA        = ' '                                                          
  U1-DAVVREG     = 000000                                                       
  U1-KDMARK      = 00                                                           
  U1-FILLER1     = W-TAB                                                        
  U1-FILLER2     = W-TAB                                                        
  W-SUFSG        = 0                                                            
END-PROC                                                                        
                                                                                
Z-AVSLUTA. PROC                                                                 
  IF W-SUFSG NE 0                                                               
    U1-FILLER1     = W-TAB                                                      
    U1-FILLER2     = W-TAB                                                      
    U1-SUFSG-H     = W-SUFSG-H                                                  
    U1-SUFSG-K     = ','                                                        
    U1-SUFSG-D     = W-SUFSG-D                                                  
    PUT W51706D2                                                                
  END-IF                                                                        
END-PROC                                                                        
