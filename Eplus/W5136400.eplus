                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5136400                                              *        
*                                                                      *        
*  FUNKTION   : LÄSER IN PERIODENS INVENTERINGAR PÅ FIL, SAMT LAGERBAND*        
*               SORTERAR DESSA OCH SUMMERAR OCH MATCHAR DE SUMMERADE   *        
*               FILERNA FÖR ATT SKRIVA UT PERIODLISTA                  *        
*                                                                      *        
*  FÖRFATTARE :  ASPFJÄLL MARKUS                                       *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
FILE W51364D1                                                                   
** PERIODENS INVENTERINGAR PÅ DC 11                                             
%W51360 'I1-'                                                                   
                                                                                
FILE TPFIL1 FB (20 0)                                                           
** PERIODENS INVENTERINGAR PÅ DC 11, SORTERADE PÅ LAGEROMRÅDE O ART.NR          
%W51360 'T1-'                                                                   
                                                                                
FILE W51364D2                                                                   
** AKTUELLT LAGERBAND                                                           
%W011100 'LB-'                                                                  
                                                                                
FILE W51364D3  PRINTER FB (121 0)                                               
                                                                                
FILE TPFIL2 FB (642 0)                                                          
** AKTUELLT LAGERBAND, SORTERAT PÅ LAGEROMRÅDE                                  
%W011100 'T2-'                                                                  
                                                                                
FILE TPFIL3   FB (12 0)                                                         
**** TOTALT ANTAL OCH VÄRDE PER LAGEROMRÅDE (LAGERBAND SUMMERAT)                
T3-ADLAGOMR         1  2 P                                                      
T3-SUARTSTD         3  7 P 2                                                    
T3-KVANTART        10  3 P 0                                                    
                                                                                
FILE TPFIL4 FB (41 0)                                                           
**** TOTALT ANTAL OCH VÄRDE PER LAGEROMRÅDE (SUMMERADE INVENTERINGAR)           
T4-ADLAGOMR         1  2 P                                                      
T4-SALDO-UPP        3  7 P                                                      
T4-SALDO-NED       10  7 P                                                      
T4-KVANTART        17  3 P 0                                                    
T4-JUST-ANT-1      20  3 P 0                                                    
T4-JUST-ANT-2      23  3 P 0                                                    
T4-JUST-ANT-3      26  3 P 0                                                    
T4-JUST-ANT-4      29  3 P 0                                                    
T4-JUST-ANT-5      32  3 P 0                                                    
T4-SUARTSTD        35  7 P 2                                                    
                                                                                
*******************************************                                     
*         WORKING STORAGE                 *                                     
*******************************************                                     
*                                                                               
SPAR-IDARTNR           W     5 P   VALUE 0                                      
SPAR-ADLAGOMR          W     2 P   VALUE 0 MASK 'Z99'                           
W-SUARTSTD             W     7 P 0 VALUE 0 MASK 'Z.ZZZ.ZZZ.ZZZ.ZZ9'             
W-INV-SUARTSTD         W     7 P 0 VALUE 0 MASK 'Z.ZZZ.ZZZ.ZZZ.ZZ9'             
W-INVANDEL             W     5 N 1 VALUE 0 MASK 'ZZZ9,9'                        
W-JUSTBELOPP           W     5 P 2 VALUE 0                                      
ANTAL-EJPRIS           W     3 P 0 VALUE 0 MASK 'ZZ.ZZ9'                        
ANTAL-INT-1            W     3 P 0 VALUE 0 MASK 'ZZ.ZZ9'                        
ANTAL-INT-2            W     3 P 0 VALUE 0 MASK 'ZZ.ZZ9'                        
ANTAL-INT-3            W     3 P 0 VALUE 0 MASK 'ZZ.ZZ9'                        
ANTAL-INT-4            W     3 P 0 VALUE 0 MASK 'ZZ.ZZ9'                        
W-JUSTANT-INV          W     4 P 0 VALUE 0 MASK 'Z.ZZZ.ZZ9'                     
W-UPP                  W     5 P 0 VALUE 0 MASK 'ZZZ.ZZZ.ZZ9'                   
W-NED                  W     5 P 0 VALUE 0 MASK 'ZZZ.ZZZ.ZZ9'                   
W-NETTO                W     5 P 0 VALUE 0 MASK 'ZZZ.ZZZ.ZZ9-'                  
W-BRUTTO               W     5 P 0 VALUE 0 MASK 'ZZZ.ZZZ.ZZ9'                   
W-NETTODIFF            W     5 N 1 VALUE 0 MASK 'ZZZ9,9'                        
W-BRUTTODIFF           W     5 N 1 VALUE 0 MASK 'ZZZ9,9'                        
W-KVANTART             W     3 P 0 VALUE 0 MASK 'ZZ.ZZ9'                        
W-KVANTART-INV         W     3 P 0 VALUE 0 MASK 'ZZ.ZZ9'                        
                                                                                
                                                                                
W-PGMNAMN   W  6  A  VALUE 'W51364'                                             
W-WDATUM    W  6  A  VALUE 'WDATUM'                                             
                                                                                
W-DATUM                W  6   N                                                 
W-AAR     W-DATUM         2   N                                                 
W-MM      W-DATUM    +2   2   N                                                 
W-DD      W-DATUM    +4   2   N                                                 
                                                                                
W-AAMM    W-DATUM         4   N                                                 
                                                                                
                                                                                
W-AAVV                 W  4   N                                                 
W-AAR1    W-AAVV          2   N                                                 
W-VV      W-AAVV      +2  2   N                                                 
                                                                                
%WDATKORT                                                                       
                                                                                
************                                                                    
*   STEG 1 *                                                                    
************                                                                    
                                                                                
***** SORTERA O RÄKNA UT ANTAL ARTIKELNR, LAGERSALDO OCH                        
***** VÄRDE PER LAGEROMRÅDE SAMT TOTALT LAGERVÄRDE ALLA ART.                    
                                                                                
SORT W51364D2 TO TPFIL2 USING (LB-ADLAGOMR) SIZE 400000                         
                                                                                
JOB INPUT TPFIL2   START A-INIT FINISH Z-FINIT                                  
                                                                                
IF T3-ADLAGOMR EQ T2-ADLAGOMR                                                   
   T3-SUARTSTD      = T3-SUARTSTD + (T2-KVLS * T2-PRARTSTD)                     
   T3-KVANTART      = T3-KVANTART + 1                                           
ELSE                                                                            
   IF T3-KVANTART NE 0                                                          
     PUT TPFIL3                                                                 
   END-IF                                                                       
                                                                                
   T3-ADLAGOMR      = T2-ADLAGOMR                                               
   T3-SUARTSTD      = T2-KVLS * T2-PRARTSTD                                     
   T3-KVANTART      = 1                                                         
END-IF                                                                          
                                                                                
A-INIT.  PROC                                                                   
  T3-KVANTART  = 0                                                              
  T3-ADLAGOMR  = 999                                                            
END-PROC                                                                        
                                                                                
Z-FINIT.  PROC                                                                  
   PUT TPFIL3                                                                   
END-PROC                                                                        
                                                                                
************                                                                    
*   STEG 2 *                                                                    
************                                                                    
****SORTERA OCH SUMMERA JUSTERINGSFILEN                                         
                                                                                
SORT W51364D1 TO TPFIL1 USING (I1-ADLAGOMR I1-IDARTNR)                          
                                                                                
JOB INPUT TPFIL1 START AA-IN FINISH ZZ-FINIT                                    
                                                                                
IF T4-ADLAGOMR NE T1-ADLAGOMR                                                   
   IF T4-KVANTART NE 0                                                          
     PUT TPFIL4                                                                 
   END-IF                                                                       
                                                                                
   SPAR-IDARTNR  = T1-IDARTNR                                                   
   T4-ADLAGOMR   = T1-ADLAGOMR                                                  
   T4-KVANTART   = 1                                                            
   T4-SALDO-UPP  = 0                                                            
   T4-SALDO-NED  = 0                                                            
   T4-JUST-ANT-1 = 0                                                            
   T4-JUST-ANT-2 = 0                                                            
   T4-JUST-ANT-3 = 0                                                            
   T4-JUST-ANT-4 = 0                                                            
   T4-JUST-ANT-5 = 0                                                            
   T4-SUARTSTD   = 0                                                            
END-IF                                                                          
PERFORM  ADDERA-T4-TRANS                                                        
                                                                                
AA-IN. PROC                                                                     
   T4-KVANTART = 0                                                              
   T4-ADLAGOMR = 999                                                            
END-PROC.                                                                       
                                                                                
ADDERA-T4-TRANS. PROC                                                           
                                                                                
   IF T1-KVLS GE 0                                                              
     T4-SUARTSTD      = T4-SUARTSTD + (T1-KVLS * T1-PRARTSTD)                   
   ELSE                                                                         
     T4-SUARTSTD      = T4-SUARTSTD + (T1-KVLS * T1-PRARTSTD * -1)              
   END-IF                                                                       
                                                                                
   W-JUSTBELOPP       = T1-KVJUSTKV * T1-PRARTSTD                               
   IF T1-PRARTSTD EQ 0                                                          
     T4-JUST-ANT-5       = T4-JUST-ANT-5 + 1                                    
   ELSE                                                                         
     IF W-JUSTBELOPP EQ 0                                                       
       T4-JUST-ANT-1     = T4-JUST-ANT-1 + 1                                    
     ELSE                                                                       
       IF W-JUSTBELOPP EQ 0 THRU 8000 OR +                                      
          W-JUSTBELOPP EQ 0 THRU -8000                                          
         T4-JUST-ANT-2   = T4-JUST-ANT-2 + 1                                    
       ELSE                                                                     
         IF W-JUSTBELOPP EQ 8000 THRU 25000 OR +                                
            W-JUSTBELOPP EQ -8000 THRU -25000                                   
           T4-JUST-ANT-3 = T4-JUST-ANT-3 + 1                                    
         ELSE                                                                   
           T4-JUST-ANT-4 = T4-JUST-ANT-4 + 1                                    
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
   END-IF                                                                       
                                                                                
   IF T1-KVJUSTKV GE 0                                                          
     T4-SALDO-UPP  = T4-SALDO-UPP + W-JUSTBELOPP                                
   ELSE                                                                         
     T4-SALDO-NED  = T4-SALDO-NED - W-JUSTBELOPP                                
   END-IF                                                                       
                                                                                
   IF SPAR-IDARTNR NE T1-IDARTNR                                                
     T4-KVANTART = T4-KVANTART + 1                                              
     SPAR-IDARTNR  = T1-IDARTNR                                                 
   END-IF                                                                       
END-PROC                                                                        
                                                                                
ZZ-FINIT.  PROC                                                                 
   PUT TPFIL4                                                                   
END-PROC                                                                        
                                                                                
******************************************************                          
* STEG 3. MATCHAR OCH SKRIVER UT LISTAN              *                          
******************************************************                          
                                                                                
******** MATCHAR IHOP SUMMERAD ARTIKELFIL OCH SUMMERAD INV.FIL                  
                                                                                
JOB INPUT(TPFIL3 KEY (T3-ADLAGOMR) TPFIL4 KEY (T4-ADLAGOMR)) +                  
                          START INIT-PROC                                       
IF MATCHED                                                                      
  SPAR-ADLAGOMR  = T4-ADLAGOMR                                                  
  W-UPP          = T4-SALDO-UPP                                                 
  W-NED          = T4-SALDO-NED                                                 
  W-NETTO        = T4-SALDO-UPP - T4-SALDO-NED                                  
  W-BRUTTO       = T4-SALDO-UPP + T4-SALDO-NED                                  
  W-JUSTANT-INV  = T4-JUST-ANT-1 + +                                            
                   T4-JUST-ANT-2 + +                                            
                   T4-JUST-ANT-3 + +                                            
                   T4-JUST-ANT-4 + +                                            
                   T4-JUST-ANT-5                                                
  ANTAL-INT-1    = T4-JUST-ANT-1                                                
  ANTAL-INT-2    = T4-JUST-ANT-2                                                
  ANTAL-INT-3    = T4-JUST-ANT-3                                                
  ANTAL-INT-4    = T4-JUST-ANT-4                                                
  ANTAL-EJPRIS   = T4-JUST-ANT-5                                                
  W-KVANTART-INV = T4-KVANTART                                                  
  W-INV-SUARTSTD = T4-SUARTSTD                                                  
  W-KVANTART     = T3-KVANTART                                                  
  W-SUARTSTD     = T3-SUARTSTD                                                  
  IF T3-SUARTSTD NE 0                                                           
    W-NETTODIFF ROUNDED  =                                      +               
                 (T4-SALDO-UPP - T4-SALDO-NED) / T3-SUARTSTD * 100              
    W-BRUTTODIFF ROUNDED =                                      +               
                 (T4-SALDO-UPP + T4-SALDO-NED) / T3-SUARTSTD * 100              
    W-INVANDEL ROUNDED   =                                      +               
                  T4-SUARTSTD / T3-SUARTSTD * 100                               
  ELSE                                                                          
    W-NETTODIFF  = 0                                                            
    W-BRUTTODIFF = 0                                                            
    W-INVANDEL    = 0                                                           
  END-IF                                                                        
  PRINT RAPPORT01                                                               
END-IF                                                                          
INIT-PROC. PROC                                                                 
   CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                            
                                                                                
   W-AAR  = D-AAR                                                               
   W-AAR1 = D-AAR                                                               
   W-MM   = D-MAANAD                                                            
   W-DD   = D-DAG                                                               
   W-VV   = D-VECKA                                                             
                                                                                
END-PROC                                                                        
*******************************************                                     
*           REPORT SECTION                *                                     
*******************************************                                     
                                                                                
REPORT RAPPORT01                   +                                            
       PRINTER W51364D3            +                                            
       PAGESIZE  40                +                                            
       LINESIZE 120                +                                            
       SPACE 0                     +                                            
       NOADJUST                    +                                            
       NOSPREAD                    +                                            
       NODATE                      +                                            
       NOPAGE                                                                   
                                                                                
CONTROL  FINAL NOPRINT             +                                            
         SPAR-ADLAGOMR  NOPRINT NEWPAGE                                         
                                                                                
TITLE 1  COL   1 'W51364-001'                                        +          
         COL  20 'VCCS'                                              +          
         COL  40 'PERIODENS JUSTERINGSVÄRDEN, PERIOD ' W-MM          +          
         COL  90 'DC: 11'                                            +          
         COL 100 'DATE: ' W-DATUM                                               
                                                                                
LINE 01  COL  13 'LAGER'                                             +          
         COL 102 'ANTAL'                                                        
LINE 02  COL  13 'OMRÅDE               UPP               NED'        +          
         COL  65 'NETTO             BRUTTO             JUST'                    
LINE 03  COL  13  SPAR-ADLAGOMR                                      +          
         COL  23  W-UPP     '  KR'                                   +          
         COL  41  W-NED     '  KR'                                   +          
         COL  56  W-NETTO   ' KR'                                    +          
         COL  75  W-BRUTTO  '  KR'                                   +          
         COL  94  W-JUSTANT-INV ' ST'                                           
LINE 04  COL   1  ' '                                                           
LINE 05  COL  13 'ANTAL JUSTERINGAR 0 KR       :'                    +          
         COL  56  ANTAL-INT-1                                        +          
         COL  67 'ST'                                                           
LINE 06  COL  13 'ANTAL JUSTERINGAR 0-8000  KR :'                    +          
         COL  56  ANTAL-INT-2                                        +          
         COL  67 'ST'                                                           
LINE 07  COL  13 'ANTAL JUSTERINGAR 8-25000 KR :'                    +          
         COL  56  ANTAL-INT-3                                        +          
         COL  67 'ST'                                                           
LINE 08  COL  13 'ANTAL JUSTERINGAR >25000  KR :'                    +          
         COL  56  ANTAL-INT-4                                        +          
         COL  67 'ST'                                                           
LINE 09  COL  13 'ANTAL MED STD-PRIS NOLL   KR :'                    +          
         COL  56  ANTAL-EJPRIS                                       +          
         COL  67 'ST'                                                           
LINE 10  COL  1 ' '                                                             
LINE 11  COL  13 'INVENTERAT ANTAL ARTIKELNR   :'                    +          
         COL  56  W-KVANTART-INV                                     +          
         COL  67 'ST'                                                           
LINE 12  COL  13 'INVENTERAT VÄRDE             :'                    +          
         COL  45  W-INV-SUARTSTD                                     +          
         COL  67 'KR'                                                           
LINE 13  COL  13 'ANTAL ARTIKELNR I LAGEROMR   :'                    +          
         COL  56  W-KVANTART                                         +          
         COL  67 'ST'                                                           
LINE 14  COL  13 'LAGERSALDOVÄRDE              :'                    +          
         COL  45  W-SUARTSTD                                         +          
         COL  67 'KR'                                                           
LINE 15  COL  1 ' '                                                             
LINE 16  COL  13 'NETTODIFF  I % AV LS-VÄRDE   :'                    +          
         COL  56  W-NETTODIFF                                        +          
         COL  67 '%'                                                            
LINE 17  COL  13 'BRUTTODIFF I % AV LS-VÄRDE   :'                    +          
         COL  56  W-BRUTTODIFF                                       +          
         COL  67 '%'                                                            
LINE 18  COL  13 'INV. VÄRDE I % AV LS-VÄRDE   :'                    +          
         COL  56  W-INVANDEL                                         +          
         COL  67 '%'                                                            
LINE 19  COL  1 ' '                                                             
