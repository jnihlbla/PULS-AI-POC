 JOB INPUT W42831D1                                                             
 IF W41842-IDPTYP                     = '201'                                   
   ANM-WDA201                        = WDA201-DATA                              
                                                                                
   IF ANM-IDDISTR = 8111, 8211                                                  
     IF ANM-KDLEVANM = '4', '5', '6'                                            
