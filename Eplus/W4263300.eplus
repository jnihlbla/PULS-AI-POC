*  PROGRAM    :  W4263300                                              *        
*                                                                      *        
*  FUNKTION   :  KREDITNÖTTER MED KONCERNLEVERANTÖRER.                 *        
*                INFIL SKAPAS I W42635. LEVERANTÖRER SOM EJ            *        
*                UPPDATERAR SAPR3. SKAPAR LISTA W42633-001.            *        
*                                                                      *        
*  FÖRFATTARE :  KENT JEBSEN                                           *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W42633D1                                                                   
*                                                                               
%W42633  'IN-'                                                                  
*                                                                               
NEWPAGE                                                                         
FILE W42633D2  PRINTER FB (121 0)                                               
                                                                                
W-IDVERNR       W   9  A                                                        
W-TIFAKT        W   6  N   MASK '999999'           VALUE 0                      
W-IDKR          W   5  N   MASK 'ZZZZ9'            VALUE 0                      
*                                                                               
*    -- CHECKED BY WY2000                                                       
                                                                                
JOB INPUT W42633D1                                                              
                                                                                
    W-IDVERNR = IN-IDVERNR                                                      
    W-TIFAKT  = IN-TIFAKT                                                       
    W-IDKR    = IN-IDKR                                                         
    PRINT RAPPORT01                                                             
                                                                                
REPORT RAPPORT01 PRINTER W42633D2 LINESIZE 120 NODATE NOADJUST +                
                 SPACE 1                                                        
TITLE 01 'KREDITNÖTTER SOM EJ UPPDATERAT SAPR3'                      +          
                  COL 40 'W42633-001 '                               +          
                  COL 89 'DATUM ' SYSDATE                                       
HEADING  W-IDVERNR          ('KRED-NR')                                         
HEADING  W-TIFAKT           ('DATUM')                                           
HEADING  W-IDKR             ('KR-NR')                                           
LINE     W-IDVERNR W-TIFAKT W-IDKR                                              
