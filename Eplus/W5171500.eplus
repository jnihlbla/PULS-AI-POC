                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  VECKORAPPORT                                          *        
*                                                                      *        
*  FUNKTION   :  SKAPAR LAGERVÄRDESTRANSAR FÖR KARANTÄN ÅT RSREDO      *        
*                DESSA LÄGGS PÅ FEJKAT DC = 13                         *        
*                                                                      *        
*  FÖRFATTARE :  KARL JOHAN HANSSON SEPT 2000                          *        
*                                                                      *        
*  INFILER    :  W488.W488S1.W48881, BUFFERTSALDOFIL                   *        
*                W011.W01177, VECKOLAGERBAND                           *        
*                                                                      *        
*  UTFIL      :  W51715, LAGERVÄRDESFIL MED 'KARANTÄNVÄRDEN'           *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W51715D1                                                                   
                                                                                
%W011100 'LB-'                                                                  
                                                                                
NEWPAGE                                                                         
                                                                                
FILE W51715D2                                                                   
* BUFFERTFIL                    ******                                          
%W48881   'I2-'                                                                 
                                                                                
NEWPAGE                                                                         
* URVAL BUFFERTFIL SORTERAD     ******                                          
FILE TPFIL1 FB(41 0)                                                            
%W48881   'T1-'                                                                 
                                                                                
NEWPAGE                                                                         
                                                                                
*  LAGERVÄRDESTRANSAR MED VÄRDEN FÖR KARANTÄN  (DC = 13)                        
FILE W51715D3 FB(27 0)                                                          
%W51712   'UT-'                                                                 
                                                                                
NEWPAGE                                                                         
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    --- VALID KDPRODSL                                                         
%WWPRODSL  'LB-' WORK ''                                                        
*                                                                               
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
                                                                                
*-----------------------------------------------------------*                   
* STEG1  SORTERA FIL W48881 TILL TPFIL1                                         
*-----------------------------------------------------------*                   
                                                                                
SORT W51715D2 TO TPFIL1 USING (I2-IDARTNR) BEFORE SORT-INIT                     
                                                                                
SORT-INIT.  PROC                                                                
  IF I2-ADBUFFOMR EQ +17 AND I2-IDDC EQ CDC-SE                                  
    SELECT                                                                      
  END-IF                                                                        
END-PROC                                                                        
                                                                                
*-----------------------------------------------------------*                   
* STEG2  MATCHA LAGERBAND OCH BUFFERFIL OCH SKAPA TPFIL2                        
*-----------------------------------------------------------*                   
                                                                                
JOB INPUT (TPFIL1 KEY (T1-IDARTNR) W51715D1 KEY (LB-IDARTNR)) +                 
          START A-INIT                                                          
                                                                                
  IF MATCHED                                                                    
    UT-KVLS          = T1-KVBUFF-F + T1-KVBUFF-OF                               
    UT-IDARTNR       = LB-IDARTNR                                               
    IF T1-KVBUFF-F NE +0 OR T1-KVBUFF-OF NE +0                                  
      PERFORM S25-CHECK-LB-KDPRODSL                                             
      IF LB-KDPRODSL = KDPRODSL-VOLVO-BIMA                                      
        PUT W51715D3                                                            
      END-IF                                                                    
    END-IF                                                                      
  ELSE                                                                          
    IF W51715D1                                                                 
      IF LB-ADLAGOMR EQ +71 AND LB-ADPLATS EQ +7000 AND LB-KVLS NE +0           
        UT-KVLS      = LB-KVLS                                                  
        UT-IDARTNR   = LB-IDARTNR                                               
        PERFORM S25-CHECK-LB-KDPRODSL                                           
        IF LB-KDPRODSL = KDPRODSL-VOLVO-BIMA                                    
          PUT W51715D3                                                          
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
  END-IF                                                                        
                                                                                
A-INIT. PROC                                                                    
  UT-IDDC         = '13'                                                        
  UT-KVAKS        = +0                                                          
  UT-KVLS         = +0                                                          
  UT-KVEFRS       = +0                                                          
  UT-KVRESS       = +0                                                          
  UT-KVOKS        = +0                                                          
END-PROC                                                                        
*                                                                               
%WWPRODSL 'LB-' PROC ''                                                         
