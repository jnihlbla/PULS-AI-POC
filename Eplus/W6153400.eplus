                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W6153400                                              *        
*                                                                      *        
*  FUNKTION   :  PROGRAMMET MATCHAR 2 INFILER OCH SKRIVER 1 UTFIL      *        
*                ENLIGT 'RELOCATION RULES'.                            *        
*                                                                      *        
*  FÖRFATTARE :  TOMMIE JIVARP                                         *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W61534D1                                                                   
*                                                                               
%W61530  'IN1-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE TEMP1 FB(80 0)                                                             
*                                                                               
%W61530  'TMP1-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W61534D3                                                                   
*                                                                               
%W61530  'IN2-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE TEMP2 FB(80 0)                                                             
*                                                                               
%W61530  'TMP2-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W61534D5 FB(80 0)                                                          
*                                                                               
%W61530  'UT1-'                                                                 
                                                                                
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. SORTERAR W61530-FILEN TILL TEMP1                                      
*                                                                               
SORT W61534D1 TO +                                                              
     TEMP1  USING (IN1-IDDC, IN1-ADLAGOMR, IN1-ADGANG, IN1-ADPLATS)             
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 2. SORTERAR W61532-FILEN TILL TEMP2                                      
*                                                                               
SORT W61534D3 TO +                                                              
     TEMP2  USING (IN2-IDDC, IN2-ADLAGOMR, IN2-ADGANG, IN2-ADPLATS)             
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 3. MATCHNING AV TEMP1 OCH TEMP2                                          
*                                                                               
JOB INPUT (TEMP1 KEY(TMP1-IDDC, TMP1-ADLAGOMR, TMP1-ADGANG  +                   
          TMP1-ADPLATS) +                                                       
          TEMP2 KEY(TMP2-IDDC, TMP2-ADLAGOMR, TMP2-ADGANG   +                   
          TMP2-ADPLATS))                                                        
                                                                                
IF MATCHED                                                                      
                                                                                
  IF TMP2-KVPB-TOT > TMP1-KVPB-TOM                                              
    IF (TMP1-RELOCFAC < (TMP2-KVPB-TOT - TMP1-KVPB-TOM) +                       
                                / TMP1-KVPB-TOM)                                
      MOVE '+' TO UT1-KDTECKEN                                                  
      PERFORM A-FLYTTA-TILL-UT1                                                 
      PUT W61534D5                                                              
    END-IF                                                                      
  END-IF                                                                        
                                                                                
  IF TMP2-KVPB-TOT < TMP1-KVPB-FOM                                              
    IF (TMP1-RELOCFAC < (TMP1-KVPB-FOM - TMP2-KVPB-TOT)    +                    
                                / TMP1-KVPB-FOM)                                
      MOVE '-' TO UT1-KDTECKEN                                                  
      PERFORM A-FLYTTA-TILL-UT1                                                 
      PUT W61534D5                                                              
    END-IF                                                                      
  END-IF                                                                        
END-IF                                                                          
                                                                                
A-FLYTTA-TILL-UT1. PROC                                                         
  MOVE TMP2-IDARTNR   TO UT1-IDARTNR                                            
  MOVE TMP2-IDDC      TO UT1-IDDC                                               
  MOVE TMP2-ADLAGOMR  TO UT1-ADLAGOMR                                           
  MOVE TMP2-ADGANG    TO UT1-ADGANG                                             
  MOVE TMP2-ADPLATS   TO UT1-ADPLATS                                            
  MOVE TMP2-KVQPACK-3 TO UT1-KVQPACK-3                                          
  MOVE TMP2-FLCDART   TO UT1-FLCDART                                            
  MOVE TMP2-VKART     TO UT1-VKART                                              
  MOVE TMP1-KVPB-FOM  TO UT1-KVPB-FOM                                           
  MOVE TMP1-KVPB-TOM  TO UT1-KVPB-TOM                                           
  MOVE TMP1-RELOCFAC  TO UT1-RELOCFAC                                           
  MOVE TMP1-KDSTOR    TO UT1-KDSTOR                                             
  MOVE TMP1-KDFREQ    TO UT1-KDFREQ                                             
  MOVE TMP2-KVPB-TOT  TO UT1-KVPB-TOT                                           
  MOVE TMP2-FLSEASON  TO UT1-FLSEASON                                           
END-PROC                                                                        
