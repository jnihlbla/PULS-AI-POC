                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W3715J00                                              *        
*                                                                      *        
*  FUNKTION   :  EXCHANGE PRODUCTION REPORT SITTARD/DOWNLOAD IN D&P    *        
*                                                                      *        
*  FÖRFATTARE :  RAGUR SATHEESH                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
*                                                                               
NEWPAGE                                                                         
FILE W3715JD1                                                                   
*                                                                               
%W01184  'IN84-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W3715JD2                                                                   
*                                                                               
%W01174  'IN74-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W3715JD3                                                                   
*                                                                               
%W01160  'IN60-'                                                                
                                                                                
NEWPAGE                                                                         
FILE W3715JD4                                                                   
*                                                                               
%W371001  'IN-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE TPFL1 FB(483 0)                                                            
*                                                                               
%W01184  'TP1-'                                                                 
*                                                                               
NEWPAGE                                                                         
FILE W3715JD5 PRINTER VB (251 0)                                                
*                                                                               
UT-ADLAGOMR       W   3   N                                                     
UT-ADGANG         W   5   N                                                     
UT-ADPLATS        W   5   N                                                     
UT-IDARTNR        W   9   N                                                     
UT-BEART-ENG      W   25  A                                                     
UT-IDFKNGRP       W   5   N                                                     
UT-KDPRODSL       W   3   N                                                     
UT-KVLS           W   4   P 0  MASK 'ZZZZZZ9-'                                  
UT-KVAKS-TOT      W   7   N                                                     
UT-RENOVOR        W   3   P                                                     
UT-ALTERNAT       W   30  A                                                     
UT-MSTOCK         W   4   P 0                                                   
                                                                                
NEWPAGE                                                                         
%WDATKORT                                                                       
%WWDC99                                                                         
                                                                                
NEWPAGE                                                                         
W-PGMNAMN   W  6  A  VALUE 'W3715J'                                             
W-WDATUM    W  6  A  VALUE 'WDATUM'                                             
W-DATUM                W  6   N                                                 
W-AAR     W-DATUM         2   N                                                 
W-MM      W-DATUM    +2   2   N                                                 
W-DD      W-DATUM    +4   2   N                                                 
*                                                                               
NEWPAGE                                                                         
FILE TPFILE2 FB (211 0)                                                         
TP2-IDPTYP           1   3   A                                                  
TP2-BYTESNR          4   5   P                                                  
TP2-OBJEKT-BRA       9   5   P                                                  
TP2-OBJEKT-DAL      14   5   P                                                  
TP2-OBJEKT-BRA1     14   5   P                                                  
TP2-IDARTNR-EMB     19   5   P                                                  
TP2-IDDISTR-RENOV   24   3   P                                                  
TP2-TEBYTKVA1       27  75   A                                                  
TP2-TEBYTKVA2      102  75   A                                                  
TP2-BETFLEV        177  30   A                                                  
TP2-KVLS-MAXCORE   207   4   P 0                                                
*------------------------------------------------*                              
FILE TPFILE3 FB (211 0)                                                         
TP3-IDPTYP          1   3   A                                                   
TP3-BYTESNR         4   5   P                                                   
TP3-OBJEKT-BRA      9   5   P                                                   
TP3-OBJEKT-DAL     14   5   P                                                   
TP3-IDARTNR-EMB    19   5   P                                                   
TP3-IDDISTR-RENOV  24   3   P                                                   
TP3-TEBYTKVA1      27  75   A                                                   
TP3-TEBYTKVA2     102  75   A                                                   
TP3-BETFLEV       177  30   A                                                   
TP3-KVLS-MAXCORE  207   4   P 0                                                 
*------------------------------------------------*                              
*ADD CUSTOMER VALUES                                                            
*------------------------------------------------*                              
  PNVAN         W   5  P  VALUE 5007000.                                        
  PNTOT         W   5  P  VALUE 99999999.                                       
  FGVAN         W   3  P  VALUE 0000.                                           
  FGTOT         W   3  P  VALUE 9999                                            
  RNVAN         W   3  P  VALUE 0000.                                           
  RNTOT         W   3  P  VALUE 9999                                            
  KVAKS         W   4  P                                                        
*------------------------------------------------*                              
* WORKING STORAGE                                                               
*------------------------------------------------*                              
NEWPAGE                                                                         
*                                                                               
W-SEM1          W   1  A   VALUE ';'                                            
JA              W   1  A   VALUE 'J'                                            
NEJ             W   1  A   VALUE 'N'                                            
SW-FIRST        S   1  A   VALUE 'J'                                            
*------------------------------------------------*                              
*                                                                               
NEWPAGE                                                                         
*                                                                               
JOB INPUT (W3715JD1 KEY (IN84-SLAG-IDARTNR))                                    
  IF DUPLICATE W3715JD1                                                         
     IF IN84-SLAG-IDDC = SDC-NL-ET                                              
        PUT TPFL1   FROM W3715JD1                                               
     END-IF                                                                     
  ELSE                                                                          
     PUT TPFL1   FROM W3715JD1                                                  
  END-IF                                                                        
*                                                                               
JOB INPUT W3715JD4                                                              
  IF IN-IDPTYP = '001'                                                          
     TP3-IDPTYP      = IN-IDPTYP                                                
     TP3-BYTESNR     = IN-BYTESNR                                               
     TP3-OBJEKT-BRA  = IN-OBJEKT-BRA                                            
                                                                                
     IF IN-BYTESNR = 8103000 THRU 8103999 OR +                                  
        IN-BYTESNR = 9953000 THRU 9953999                                       
                                                                                
        TP3-OBJEKT-DAL    = IN-BYTESNR + 1000                                   
     ELSE                                                                       
        TP3-OBJEKT-DAL    = IN-BYTESNR + 6000                                   
     END-IF                                                                     
     TP3-IDARTNR-EMB      = IN-IDARTNR-EMB                                      
     TP3-IDDISTR-RENOV    = IN-IDDISTR-RENOV                                    
     TP3-TEBYTKVA1        = IN-TEBYTKVA1                                        
     TP3-TEBYTKVA2        = IN-TEBYTKVA2                                        
     TP3-BETFLEV          = IN-BETFLEV                                          
     IF IN-KVLS-MAXCORE NOT NUMERIC                                             
        CONTINUE                                                                
     ELSE                                                                       
        IF IN-KVLS-MAXCORE NUMERIC                                              
           TP3-KVLS-MAXCORE    = IN-KVLS-MAXCORE                                
        END-IF                                                                  
     END-IF                                                                     
     PUT TPFILE3                                                                
  END-IF                                                                        
*                                                                               
SORT TPFILE3 TO TPFILE2 USING TP3-OBJEKT-DAL                                    
*                                                                               
*-------------------------------------------------*                             
JOB INPUT (TPFILE2 KEY TP2-OBJEKT-DAL  TPFL1 KEY (TP1-SLAG-IDARTNR) +           
           W3715JD2 KEY (IN74-IDARTNR)                              +           
           W3715JD3 KEY (IN60-CLAG-IDARTNR)) START INIT-PROC                    
                                                                                
                                                                                
  IF MATCHED                                                                    
     IF TP1-SLAG-IDDC = SDC-NL-ET AND +                                         
        IN60-CLAG-KDPRODSL = 14 16 18 24 34 54 94                               
                                                                                
        IF TP1-SLAG-IDARTNR    >= PNVAN AND  +                                  
           TP1-SLAG-IDARTNR    <= PNTOT AND  +                                  
           IN60-CLAG-IDFKNGRP  >= FGVAN AND  +                                  
           IN60-CLAG-IDFKNGRP  <= FGTOT AND  +                                  
           TP2-IDDISTR-RENOV   >= RNVAN AND  +                                  
           TP2-IDDISTR-RENOV   <= RNTOT                                         
                                                                                
           KVAKS = (TP1-SLAG-KVAKS-SDC) + (TP1-SLAG-KVAKS-PAV)                  
                                                                                
           PERFORM A-CREATE-W3715J                                              
                                                                                
           PRINT W3715JPRINT                                                    
        END-IF                                                                  
     END-IF                                                                     
  END-IF                                                                        
***                                                                             
NEWPAGE                                                                         
***                                                                             
A-CREATE-W3715J. PROC                                                           
  UT-ADLAGOMR  = TP1-SLAG-ADLAGOMR                                              
  UT-ADGANG    = TP1-SLAG-ADGANG                                                
  UT-ADPLATS   = TP1-SLAG-ADPLATS                                               
  UT-IDARTNR   = TP1-SLAG-IDARTNR                                               
  UT-BEART-ENG = IN74-BEART(4)                                                  
  UT-IDFKNGRP  = IN60-CLAG-IDFKNGRP                                             
  UT-KDPRODSL  = IN60-CLAG-KDPRODSL                                             
  UT-KVLS      = TP1-SLAG-KVLS                                                  
  UT-KVAKS-TOT = KVAKS                                                          
  UT-RENOVOR   = TP2-IDDISTR-RENOV                                              
  UT-ALTERNAT  = TP2-BETFLEV                                                    
  IF TP2-KVLS-MAXCORE NOT NUMERIC                                               
     CONTINUE                                                                   
  ELSE                                                                          
     IF TP2-KVLS-MAXCORE NUMERIC                                                
        UT-MSTOCK = TP2-KVLS-MAXCORE                                            
     END-IF                                                                     
  END-IF                                                                        
END-PROC                                                                        
***                                                                             
INIT-PROC. PROC                                                                 
  CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                             
                                                                                
  W-AAR = D-AAR                                                                 
  W-MM  = D-MAANAD                                                              
  W-DD  = D-DAG                                                                 
END-PROC                                                                        
*-------------------------------------------------*                             
REPORT W3715JPRINT  PRINTER W3715JD5            +                               
                    LINESIZE     246            +                               
                    NODATE                      +                               
                    NOHEADING                   +                               
                    PAGESIZE     32767          +                               
                    SPACE        0              +                               
                    SKIP         0              +                               
                    NOPAGE                      +                               
                    NOADJUST                    +                               
                    TITLESKIP    3              +                               
                    NOSPREAD                                                    
                                                                                
 SEQUENCE UT-IDFKNGRP        +                                                  
          UT-RENOVOR         +                                                  
          UT-IDARTNR                                                            
*-------------------------------------------------*                             
*                                                                               
LINE   UT-ADLAGOMR           +                                                  
       W-SEM1                +                                                  
       UT-ADGANG             +                                                  
       W-SEM1                +                                                  
       UT-ADPLATS            +                                                  
       W-SEM1                +                                                  
       UT-IDARTNR            +                                                  
       W-SEM1                +                                                  
       UT-BEART-ENG          +                                                  
       W-SEM1                +                                                  
       UT-IDFKNGRP           +                                                  
       W-SEM1                +                                                  
       UT-KDPRODSL           +                                                  
       W-SEM1                +                                                  
       UT-KVLS               +                                                  
       W-SEM1                +                                                  
       UT-KVAKS-TOT          +                                                  
       W-SEM1                +                                                  
       UT-RENOVOR            +                                                  
       W-SEM1                +                                                  
       UT-ALTERNAT           +                                                  
       W-SEM1                +                                                  
       UT-MSTOCK             +                                                  
       W-SEM1                                                                   
                                                                                
BEFORE-LINE. PROC                                                               
 IF SW-FIRST = JA                                                               
     DISPLAY '¤DAPW3715J-0' SDC-NL-ET                                           
     DISPLAY '¤DAPW3715J'                                                       
     DISPLAY 'W3715J-0' SDC-NL-ET '                 DATE:' W-DATUM              
     DISPLAY 'PART NUMBERS VAN '  PNVAN  ' TOT EN MET ' PNTOT                   
     DISPLAY 'FUNCTION GRP VAN '  FGVAN  ' TOT EN MET ' FGTOT                   
     DISPLAY 'RENOVÖR VAN '       RNVAN  ' TOT EN MET ' RNTOT                   
     DISPLAY 'AREA;AISLE;ADDRESS;PARTNR;DESCRIPTION;FGRP;PRODGR;' +             
             'BAL;AK;REN;-------ALTERNATIVE-------;MSTOCK'                      
    SW-FIRST = NEJ                                                              
  END-IF                                                                        
END-PROC                                                                        
*                                                                               
