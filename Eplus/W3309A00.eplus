*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W3309A00                                              *        
*                                                                      *        
*  FUNKTION   :  PROGRAMMET SKAPAR EN NY GENERATION AV W3309A FILEN.   *        
*                INNEHÅLLER FÖRSÄLJNINGS INFO FÖR ÅREN (1987-NNNN).             
*                                                                      *        
*  FÖRFATTARE :  BOHLIN HÅKAN                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W3309AD1                                                                   
*                                                                               
%W33096 'IN1-'                                                                  
IN1-SUARTSJK2  11  6 P 0                                                        
                                                                                
NEWPAGE                                                                         
FILE W3309AD2                                                                   
*                                                                               
%W3309A 'IN2-'                                                                  
IN2-SUARTSJK2  24 11 N                                                          
                                                                                
NEWPAGE                                                                         
FILE W3309AD3 FB(35 0)                                                          
*                                                                               
%W3309A 'OUT-'                                                                  
OUT-SUARTSJK2 24 11 N                                                           
                                                                                
FILE TMPFIL01 FB (24 0) VIRTUAL RETAIN                                          
TMP1-IDARTNR    1  9 N                                                          
TMP1-TIAAAA    10  4 N                                                          
TMP1-TIAAAA-1  10  2 N                                                          
TMP1-TIAAAA-2  12  2 N                                                          
TMP1-SULEVANT  14  5 P 0                                                        
TMP1-SUARTSJK  19  6 P 0                                                        
                                                                                
FILE TMPFIL02 FB (24 0) VIRTUAL RETAIN                                          
TMP2-IDARTNR    1  9 N                                                          
TMP2-TIAAAA    10  4 N                                                          
TMP2-SULEVANT  14  5 P 0                                                        
TMP2-SUARTSJK  19  6 P 0                                                        
                                                                                
W-SULEVANT     W  5 P 0 VALUE 0                                                 
W-SUARTSJK     W  6 P 0 VALUE 0                                                 
W-SPAR-IDARTNR W  5 P   VALUE 000000000                                         
W-SPAR-TIAAAA  W  4 N   VALUE 0000                                              
W-FORSTA-SW    W  1 A   VALUE 'J'                                               
                                                                                
NEWPAGE                                                                         
*                                                                               
* STEG 1. LÄSER W33096(+0) OCH SKAPAR TMPFIL01 UT                               
*                                                                               
                                                                                
JOB INPUT W3309AD1                                                              
                                                                                
    IF IN1-SULEVANT > 0 OR IN1-SULEVANT < 0                                     
       TMP1-IDARTNR  = IN1-IDARTNR                                              
       TMP1-TIAAAA-1 = 20                                                       
       TMP1-TIAAAA-2 = IN1-TIAA                                                 
       TMP1-SULEVANT = IN1-SULEVANT                                             
       TMP1-SUARTSJK = IN1-SUARTSJK2                                            
       PUT TMPFIL01                                                             
    END-IF                                                                      
                                                                                
*                                                                               
* STEG 2. LÄSER TMPFIL01 OCH SKAPAR TMPFIL02 UT.                                
*         SUMMERAR IHOP SULEVANT OCH SUARTSJK PER ARTIKEL.                      
*                                                                               
                                                                                
JOB INPUT TMPFIL01 FINISH Z-FINIT1                                              
                                                                                
  IF W-FORSTA-SW = 'J'                                                          
     W-SPAR-IDARTNR = TMP1-IDARTNR                                              
     W-SULEVANT = TMP1-SULEVANT                                                 
     W-SUARTSJK = TMP1-SUARTSJK                                                 
     W-FORSTA-SW = 'N'                                                          
  ELSE                                                                          
     IF W-SPAR-IDARTNR = TMP1-IDARTNR                                           
        W-SULEVANT = W-SULEVANT + TMP1-SULEVANT                                 
        IF W-SULEVANT > 980000000                                               
           DISPLAY 'W-SULEVANT > 980000000'                                     
           RETURN-CODE = 16                                                     
           STOP EXECUTE                                                         
        END-IF                                                                  
        W-SUARTSJK = W-SUARTSJK + TMP1-SUARTSJK                                 
        IF W-SUARTSJK > 98000000000                                             
           DISPLAY 'W-SUARTSJK > 98000000000'                                   
           RETURN-CODE = 16                                                     
           STOP EXECUTE                                                         
        END-IF                                                                  
     ELSE                                                                       
        TMP2-IDARTNR  = W-SPAR-IDARTNR                                          
        TMP2-TIAAAA = TMP1-TIAAAA                                               
        TMP2-SULEVANT = W-SULEVANT                                              
        TMP2-SUARTSJK = W-SUARTSJK                                              
        PUT TMPFIL02                                                            
        W-SULEVANT = TMP1-SULEVANT                                              
        W-SUARTSJK = TMP1-SUARTSJK                                              
     END-IF                                                                     
     W-SPAR-IDARTNR = TMP1-IDARTNR                                              
     W-SPAR-TIAAAA = TMP1-TIAAAA                                                
  END-IF                                                                        
                                                                                
Z-FINIT1. PROC                                                                  
    TMP2-IDARTNR  = W-SPAR-IDARTNR                                              
    TMP2-TIAAAA = W-SPAR-TIAAAA                                                 
    TMP2-SULEVANT = W-SULEVANT                                                  
    TMP2-SUARTSJK = W-SUARTSJK                                                  
    PUT TMPFIL02                                                                
END-PROC.                                                                       
                                                                                
*                                                                               
* STEG 3. MATCHAR TMPFIL02 MED W3309A(+0) OCH SKAPAR NY GENERATION              
*         AV W3309A FILEN. UTFILEN INNEHÅLLER FÖRSÄLJNINGS INFO PÅ              
*         ARTIKEL NIVÅ (1987-NNNN).                                             
*                                                                               
                                                                                
JOB INPUT NULL START A-INIT                                                     
                                                                                
  IF EOF TMPFIL02 OR EOF W3309AD2                                               
     PERFORM Z-FINIT2                                                           
  END-IF                                                                        
                                                                                
  IF IN2-IDARTNR = TMP2-IDARTNR                                                 
     IF IN2-TIAAAA < TMP2-TIAAAA                                                
        OUT-IDARTNR  = IN2-IDARTNR                                              
        OUT-TIAAAA = IN2-TIAAAA                                                 
        OUT-SULEVANT = IN2-SULEVANT                                             
        OUT-SULEVANT-KDTECKEN = IN2-SULEVANT-KDTECKEN                           
        OUT-SUARTSJK2 = IN2-SUARTSJK2                                           
        OUT-SUARTSJK-KDTECKEN = IN2-SUARTSJK-KDTECKEN                           
        PUT W3309AD3                                                            
        PERFORM S02-READ-W3309AD2                                               
     ELSE                                                                       
       IF IN2-TIAAAA = TMP2-TIAAAA                                              
          DISPLAY 'IN2-TIAAAA = TMP2-TIAAAA: '  TMP2-IDARTNR                    
          RETURN-CODE = 16                                                      
          STOP EXECUTE                                                          
       ELSE                                                                     
         IF IN2-TIAAAA > TMP2-TIAAAA                                            
            DISPLAY 'IN2-TIAAAA > TMP2-TIAAAA: ' TMP2-IDARTNR                   
            RETURN-CODE = 16                                                    
            STOP EXECUTE                                                        
         END-IF                                                                 
       END-IF                                                                   
     END-IF                                                                     
  ELSE                                                                          
     IF IN2-IDARTNR > TMP2-IDARTNR                                              
        OUT-IDARTNR = TMP2-IDARTNR                                              
        OUT-TIAAAA = TMP2-TIAAAA                                                
        OUT-SULEVANT = TMP2-SULEVANT                                            
        IF TMP2-SULEVANT < 0                                                    
           OUT-SULEVANT-KDTECKEN = '-'                                          
        ELSE                                                                    
           OUT-SULEVANT-KDTECKEN = ' '                                          
        END-IF                                                                  
        OUT-SUARTSJK2 = TMP2-SUARTSJK                                           
        IF TMP2-SUARTSJK < 0                                                    
           OUT-SUARTSJK-KDTECKEN = '-'                                          
        ELSE                                                                    
           OUT-SUARTSJK-KDTECKEN = ' '                                          
        END-IF                                                                  
        PUT W3309AD3                                                            
        PERFORM S01-READ-TMPFIL02                                               
     ELSE                                                                       
        IF IN2-IDARTNR < TMP2-IDARTNR                                           
           OUT-IDARTNR  = IN2-IDARTNR                                           
           OUT-TIAAAA = IN2-TIAAAA                                              
           OUT-SULEVANT = IN2-SULEVANT                                          
           OUT-SULEVANT-KDTECKEN = IN2-SULEVANT-KDTECKEN                        
           OUT-SUARTSJK2 = IN2-SUARTSJK2                                        
           OUT-SUARTSJK-KDTECKEN = IN2-SUARTSJK-KDTECKEN                        
           PUT W3309AD3                                                         
           PERFORM S02-READ-W3309AD2                                            
        END-IF                                                                  
     END-IF                                                                     
  END-IF                                                                        
                                                                                
A-INIT. PROC                                                                    
  PERFORM S01-READ-TMPFIL02                                                     
  PERFORM S02-READ-W3309AD2                                                     
END-PROC.                                                                       
                                                                                
S01-READ-TMPFIL02. PROC                                                         
  GET TMPFIL02                                                                  
END-PROC.                                                                       
                                                                                
S02-READ-W3309AD2. PROC                                                         
  GET W3309AD2                                                                  
END-PROC.                                                                       
                                                                                
Z-FINIT2. PROC                                                                  
    IF EOF W3309AD2                                                             
       DO WHILE NOT EOF TMPFIL02                                                
          OUT-IDARTNR = TMP2-IDARTNR                                            
          OUT-TIAAAA = TMP2-TIAAAA                                              
          OUT-SULEVANT = TMP2-SULEVANT                                          
          IF TMP2-SULEVANT < 0                                                  
             OUT-SULEVANT-KDTECKEN = '-'                                        
          ELSE                                                                  
             OUT-SULEVANT-KDTECKEN = ' '                                        
          END-IF                                                                
          OUT-SUARTSJK2 = TMP2-SUARTSJK                                         
          IF TMP2-SUARTSJK < 0                                                  
             OUT-SUARTSJK-KDTECKEN = '-'                                        
          ELSE                                                                  
             OUT-SUARTSJK-KDTECKEN = ' '                                        
          END-IF                                                                
          PUT W3309AD3                                                          
          PERFORM S01-READ-TMPFIL02                                             
       END-DO                                                                   
    ELSE                                                                        
       IF EOF TMPFIL02                                                          
          DO WHILE NOT EOF W3309AD2                                             
             OUT-IDARTNR = IN2-IDARTNR                                          
             OUT-TIAAAA = IN2-TIAAAA                                            
             OUT-SULEVANT = IN2-SULEVANT                                        
             OUT-SULEVANT-KDTECKEN = IN2-SULEVANT-KDTECKEN                      
             OUT-SUARTSJK2 = IN2-SUARTSJK2                                      
             OUT-SUARTSJK-KDTECKEN = IN2-SUARTSJK-KDTECKEN                      
             PUT W3309AD3                                                       
             PERFORM S02-READ-W3309AD2                                          
          END-DO                                                                
       END-IF                                                                   
    END-IF                                                                      
    STOP                                                                        
END-PROC.                                                                       
                                                                                
