*                                                                      *        
*  FÖRFATTARE :  HGK 36510  870401                                     *        
*                                                                      *        
*  INFILER    :  W479.W020V1.W47955 HISTORIKFIL INNAN RENAME TILL W020 *        
*                                                                      *        
*  UTFILER    :  W020.PÅÅX.SUMHIST                                     *        
************************************************************************        
FILE W02005D1                                                                   
*                                                                               
%W479055  'IN-'                                                                 
NEWPAGE                                                                         
*                                                                               
FILE W02005D3 VIRTUAL FB(38 0)                                                  
M1-IDDC           1   2   A                                                     
M1-IDDISTR        3   3   P 0                                                   
M1-KDORDKL        6   1   P 0                                                   
M1-IDPRODNR       7   4   P 0                                                   
M1-IDARTNR       11   5   P 0                                                   
M1-IDRONR        16   5   N 0                                                   
M1-KVLEVART2     21   4   P 0                                                   
M1-PRARTNTO      25   5   P 2                                                   
M1-VKART         30   4   P 3                                                   
M1-VLARTNTO      34   5   P 1                                                   
*                                                                               
FILE W02005D4 VIRTUAL FB(38 0)                                                  
*                                                                               
SORT1-KEY         1   6   A                                                     
SORT-IDDC         1   2   A                                                     
SORT-IDDISTR      3   3   P 0                                                   
SORT-KDORDKL      6   1   P 0                                                   
SORT-IDPRODNR     7   4   P 0                                                   
SORT3-KEY        11  10   A                                                     
SORT-IDARTNR     11   5   P 0                                                   
SORT-IDRONR      16   5   N 0                                                   
SORT-KVLEVART2   21   4   P 0                                                   
SORT-PRARTNTO    25   5   P 2                                                   
SORT-VKART       30   4   P 3                                                   
SORT-VLARTNTO    34   5   P 1                                                   
*                                                                               
FILE W02005D2 FB(34 0)                                                          
%W020050E  'UT-'                                                                
NEWPAGE                                                                         
*                                                                               
* ARBETSAREOR                                                                   
W-IDKUNDREF-RO         W    10    A                                             
W-IDRONR    W-IDKUNDREF-RO   5    N 0                                           
W1-KEY                 W     6    A                                             
W1-IDDC            W1-KEY    2    A                                             
W1-IDDISTR         W1-KEY +2 3    P 0                                           
W1-KDORDKL         W1-KEY +5 1    P 0                                           
W2-IDPRODNR            W     4    P 0                                           
W3-KEY                 W    10    A                                             
W3-IDARTNR         W3-KEY    5    P 0                                           
W3-IDRONR          W3-KEY +5 5    N 0                                           
W3-RADER               W     4    P 0                                           
W3-SUVÄRDE             W     6    P 2                                           
W3-SUVIKT              W     6    P 3                                           
W3-SUVOLYM             W     7    P 1                                           
W2-ORDER               W     4    P 0                                           
W2-RADER               W     4    P 0                                           
W2-SUVÄRDE             W     6    P 2                                           
W2-SUVIKT              W     6    P 3                                           
W2-SUVOLYM             W     7    P 1                                           
W1-ORDER               W     4    P 0                                           
W1-RADER               W     4    P 0                                           
W1-SUVÄRDE             W     6    P 2                                           
W1-SUVIKT              W     6    P 3                                           
W1-SUVOLYM             W     7    P 1                                           
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
JOB INPUT W02005D1                                                              
*                                                                               
  IF IN-FLDIRLEV = 'J'                                                          
     IN-KDORDKL = 5                                                             
  END-IF                                                                        
  W-IDKUNDREF-RO = IN-IDKUNDRF-RO                                               
  PERFORM SKRIV                                                                 
*                                                                               
SKRIV.  PROC                                                                    
  M1-IDDC      = IN-IDDC-LEV                                                    
  M1-IDDISTR   = IN-IDDISTR                                                     
  M1-KDORDKL   = IN-KDORDKL                                                     
  M1-IDPRODNR  = IN-IDPRODNR                                                    
  M1-IDARTNR   = IN-IDARTNR                                                     
  M1-IDRONR    = W-IDRONR                                                       
  M1-KVLEVART2 = IN-KVLEVART2                                                   
  M1-PRARTNTO  = IN-PRARTNTO                                                    
  M1-VKART     = IN-VKARTNTO                                                    
  M1-VLARTNTO  = IN-VLARTNTO                                                    
  PUT W02005D3                                                                  
END-PROC                                                                        
***                                                                             
SORT W02005D3 TO W02005D4 USING (M1-IDDC M1-IDDISTR M1-KDORDKL +                
                             M1-IDPRODNR M1-IDARTNR M1-IDRONR)                  
NEWPAGE                                                                         
***                                                                             
JOB INPUT NULL                                                                  
  GET W02005D4                                                                  
  PERFORM NOLLA1                                                                
                                                                                
  DO WHILE NOT EOF W02005D4                                                     
    PERFORM SPARA1                                                              
                                                                                
    DO WHILE NOT EOF W02005D4 AND SORT1-KEY = W1-KEY                            
      PERFORM SPARA2                                                            
                                                                                
      DO WHILE NOT EOF W02005D4 AND SORT-IDPRODNR = W2-IDPRODNR                 
        PERFORM SPARA3                                                          
                                                                                
        DO WHILE NOT EOF W02005D4 AND SORT3-KEY = W3-KEY                        
          W3-RADER = 1                                                          
          W3-SUVÄRDE = W3-SUVÄRDE + (SORT-KVLEVART2 * SORT-PRARTNTO)            
          W3-SUVIKT = W3-SUVIKT + (SORT-KVLEVART2 * SORT-VKART)                 
          W3-SUVOLYM = W3-SUVOLYM + (SORT-KVLEVART2 * SORT-VLARTNTO)            
          GET W02005D4                                                          
        END-DO                                                                  
                                                                                
        W2-ORDER = 1                                                            
        W2-RADER = W2-RADER + W3-RADER                                          
        W2-SUVÄRDE = W2-SUVÄRDE + W3-SUVÄRDE                                    
        W2-SUVIKT = W2-SUVIKT + W3-SUVIKT                                       
        W2-SUVOLYM = W2-SUVOLYM + W3-SUVOLYM                                    
        PERFORM NOLLA3                                                          
      END-DO                                                                    
                                                                                
      W1-ORDER = W1-ORDER + W2-ORDER                                            
      W1-RADER = W1-RADER + W2-RADER                                            
      W1-SUVÄRDE = W1-SUVÄRDE + W2-SUVÄRDE                                      
      W1-SUVIKT = W1-SUVIKT + W2-SUVIKT                                         
      W1-SUVOLYM = W1-SUVOLYM + W2-SUVOLYM                                      
      PERFORM NOLLA2                                                            
    END-DO                                                                      
                                                                                
    PERFORM SKRIV1                                                              
    PERFORM NOLLA1                                                              
  END-DO                                                                        
STOP                                                                            
NEWPAGE                                                                         
***                                                                             
NOLLA1.  PROC                                                                   
  MOVE ZERO  TO W1-IDDISTR W1-KDORDKL W1-SUVÄRDE  +                             
                W1-SUVIKT  W1-SUVOLYM W1-RADER  W1-ORDER                        
  MOVE SPACE TO W1-IDDC                                                         
END-PROC                                                                        
*                                                                               
*                                                                               
NOLLA2.  PROC                                                                   
  MOVE ZERO TO W2-IDPRODNR W2-SUVÄRDE W2-SUVIKT W2-SUVOLYM +                    
               W2-ORDER    W2-RADER                                             
END-PROC                                                                        
*                                                                               
*                                                                               
NOLLA3.  PROC                                                                   
  MOVE ZERO TO W3-IDARTNR W3-IDRONR W3-SUVÄRDE W3-SUVIKT  +                     
               W3-SUVOLYM W3-RADER                                              
END-PROC                                                                        
NEWPAGE                                                                         
*                                                                               
*                                                                               
SPARA1.  PROC                                                                   
  W1-IDDC     = SORT-IDDC                                                       
  W1-IDDISTR  = SORT-IDDISTR                                                    
  W1-KDORDKL  = SORT-KDORDKL                                                    
  W2-IDPRODNR = SORT-IDPRODNR                                                   
END-PROC                                                                        
*                                                                               
*                                                                               
SPARA2.  PROC                                                                   
  W2-IDPRODNR = SORT-IDPRODNR                                                   
END-PROC                                                                        
*                                                                               
*                                                                               
SPARA3.  PROC                                                                   
  W3-IDARTNR  = SORT-IDARTNR                                                    
  W3-IDRONR   = SORT-IDRONR                                                     
END-PROC                                                                        
*                                                                               
*                                                                               
SKRIV1.  PROC                                                                   
  UT-IDDC    = W1-IDDC                                                          
  UT-IDDISTR = W1-IDDISTR                                                       
  UT-KDORDKL = W1-KDORDKL                                                       
  UT-SURADER = W1-RADER                                                         
  UT-SUORDER = W1-ORDER                                                         
  UT-SUVÄRDE = W1-SUVÄRDE                                                       
  UT-SUVIKT  = W1-SUVIKT                                                        
  UT-SUVOLYM = W1-SUVOLYM                                                       
  PUT W02005D2                                                                  
END-PROC                                                                        
