                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4323300                                              *        
*                                                                      *        
*  FÖRFATTARE :  BO SVENSSON                                           *        
*                                                                      *        
*  DATUM      :  971111                                                *        
*                                                                      *        
*  FUNKTION   :  MATCHAR KUNDUPPGIFTER MOT (-1)-FIL FöR ATT            *        
*                SKICKA FöRäNDRADE ELLER NYA POSTER TILL VADIS.        *        
*                                                                      *        
*                PROGRAMMET TAR IN FILERNA                             *        
*                  W43232(-1) 'GÅRDAGENS' KUNDUPPGIFTER                *        
*                  W43232(+0) 'DAGENS'    KUNDUPPGIFTER                *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*                                                                      *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE W43233D1                                                                   
*  GÅRDAGENS KUNDUPPGIFTER                                                      
%W432VAD1 'GVAD-'                                                               
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W43233D2                                                                   
*  DAGENS KUNDUPPGIFTER                                                         
%W432VAD1 'DVAD-'                                                               
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE W43233D3   VB (70 0)                                                       
*  ÄNDRADE/NYA KUNDUPPGIFTER                                                    
%W432VAD1 'NVAD-'                                                               
*                                                                               
  NVAD-POST     1  66 A                                                         
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
  JA            W    1  A   VALUE 'J'                                           
  NEJ           W    1  A   VALUE 'N'                                           
  RAKNARE       W    4  N   VALUE 0                                             
*                                                                               
  FL-START-REC  W    1  A   VALUE 'N'                                           
  WS-START-REC  W   24  A   VALUE '((DIS038-01-01)(CN)(LN))'                    
  WS-FORTS1-REC W    6  A   VALUE '((LY))'                                      
  WS-FORTS2-REC W    6  A   VALUE '((LN))'                                      
  WS-END-REC    W   10  A   VALUE '((LY)(CY))'                                  
*                                                                               
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT (W43233D2 KEY (DVAD-IDDISTR                          +              
                           DVAD-IDKUNDNR)                        +              
             W43233D1 KEY (GVAD-IDDISTR                          +              
                           GVAD-IDKUNDNR))                       +              
      FINISH Z-AVSLUT                                            +              
                   NAME   STEG01                                                
                                                                                
    IF FL-START-REC = 'N'                                                       
        W43233D3:RECORD-LENGTH = 24                                             
        NVAD-POST = WS-START-REC                                                
        PUT W43233D3                                                            
        FL-START-REC = 'Y'                                                      
    END-IF                                                                      
                                                                                
    IF MATCHED W43233D2 W43233D1                                                
      PERFORM A-KOLLA-ANDRAD                                                    
    ELSE                                                                        
      IF W43233D2                                                               
        PERFORM B-NY-POST                                                       
      END-IF                                                                    
    END-IF                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  A-KOLLA-ANDRAD.  PROC                                                         
                                                                                
    IF (DVAD-IDLANDX2   NE GVAD-IDLANDX2                         +              
    OR  DVAD-DASTADAT   NE GVAD-DASTADAT                         +              
    OR  DVAD-DASTODAT   NE GVAD-DASTODAT                         +              
    OR  DVAD-BEGMT-RAD1 NE GVAD-BEGMT-RAD1)                      +              
    AND DVAD-DASTADAT   > 0                                                     
      RAKNARE = RAKNARE + 1                                                     
      IF RAKNARE > 1000                                                         
         W43233D3:RECORD-LENGTH = 6                                             
         NVAD-POST = WS-FORTS1-REC                                              
         PUT W43233D3                                                           
                                                                                
         W43233D3:RECORD-LENGTH = 6                                             
         NVAD-POST = WS-FORTS2-REC                                              
         PUT W43233D3                                                           
                                                                                
         RAKNARE = 1                                                            
      END-IF                                                                    
                                                                                
      NVAD-IDPTYP     = 'DID'                                                   
      NVAD-IDDISTR    = DVAD-IDDISTR                                            
      NVAD-IDKUNDNR   = DVAD-IDKUNDNR                                           
      NVAD-IDLANDX2   = DVAD-IDLANDX2                                           
      NVAD-DASTADAT   = DVAD-DASTADAT                                           
      NVAD-DASTODAT   = DVAD-DASTODAT                                           
      NVAD-BEGMT-RAD1 = DVAD-BEGMT-RAD1                                         
                                                                                
      W43233D3:RECORD-LENGTH = 66                                               
      PUT W43233D3                                                              
    END-IF                                                                      
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  B-NY-POST.  PROC                                                              
                                                                                
    IF  DVAD-DASTADAT   > 0                                                     
      RAKNARE = RAKNARE + 1                                                     
      IF RAKNARE > 1000                                                         
         W43233D3:RECORD-LENGTH = 6                                             
         NVAD-POST = WS-FORTS1-REC                                              
         PUT W43233D3                                                           
                                                                                
         W43233D3:RECORD-LENGTH = 6                                             
         NVAD-POST = WS-FORTS2-REC                                              
         PUT W43233D3                                                           
                                                                                
         RAKNARE = 1                                                            
      END-IF                                                                    
      NVAD-IDPTYP     = 'DID'                                                   
      NVAD-IDDISTR    = DVAD-IDDISTR                                            
      NVAD-IDKUNDNR   = DVAD-IDKUNDNR                                           
      NVAD-IDLANDX2   = DVAD-IDLANDX2                                           
      NVAD-DASTADAT   = DVAD-DASTADAT                                           
      NVAD-DASTODAT   = DVAD-DASTODAT                                           
      NVAD-BEGMT-RAD1 = DVAD-BEGMT-RAD1                                         
                                                                                
      W43233D3:RECORD-LENGTH = 66                                               
      PUT W43233D3                                                              
    END-IF                                                                      
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  Z-AVSLUT.  PROC                                                               
                                                                                
                                                                                
    W43233D3:RECORD-LENGTH = 10                                                 
    NVAD-POST = WS-END-REC                                                      
    PUT W43233D3                                                                
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
