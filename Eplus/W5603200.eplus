FILE W56032D1                                                                   
%W56031  'IN-'                                                                  
                                                                                
IDARTNR                 1   8  N     MASK 'ZZZZZZZ9'                            
IDLEVNR                 9   5  A                                                
                                                                                
FILE W56032D2  PRINTER VB (84 0)                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* ARBETSAREA                                                    *               
*                                                               *               
*****************************************************************               
*                                                                               
W-IDDC                  W   5  A                                                
W-IDLEVNR               W   3  A                                                
W-IDARTNR               W   9  A                                                
W-BEART                 W  32  A                                                
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
                                                                                
                                                                                
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* JOBSTEG 1 : LÄSER IN W56032D1                                 *               
*                                                               *               
*****************************************************************               
JOB INPUT W56032D1                                                              
                                                                                
                                                                                
  PRINT RAPPORT01                                                               
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* RAPPORTBESKRIVNING                                            *               
*                                                               *               
*****************************************************************               
REPORT RAPPORT01 PRINTER W56032D2              +                                
                                  LINESIZE 79  +                                
                                  PAGESIZE 50  +                                
                                  NOADJUST     +                                
                                  NODATE       +                                
                                  NOPAGE       +                                
                                  DTLCTL NONE                                   
                                                                                
SEQUENCE IDARTNR IDLEVNR IN-IDDC                                                
                                                                                
TITLE 1 COL 7 'VOLVO CAR CUSTOMER SERVICE     W56032-001' +                     
COL 57 SYSDATE                                                                  
TITLE 3 COL 7 '   MISSING AVERAGE COST OR MISSING PARTNO  '                     
HEADING  IDARTNR       '   PART NO   '                                          
HEADING  IDLEVNR       'SUPPLIER'                                               
HEADING  IN-IDDC       'DC'                                                     
HEADING  IN-BEART      'DESCRIPTION              '                              
LINE COL 7 IDARTNR IDLEVNR IN-IDDC IN-BEART                                     
