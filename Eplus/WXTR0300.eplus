*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE WXTR03D1                                                                   
*                                                                               
%W4795N    'IN-'                                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE WXTR03D2                                                                   
*                                                                               
   TAB-IDDC             1   2  A                                                
   TAB-IDDISTR          *   4  N                                                
   TAB-BELAND           *  25  A                                                
   TAB-BEMARKET         *  25  A                                                
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE WXTR03D3   FB (84 0)                                                       
*     FAKTRAD SUMMERAD PÅ DISTR,KUND, ORDER, DC OCH KLASS                       
   UT-IDDC          1  2  A                                                     
   UT-IDPRC         *  4  A                                                     
   UT-KDORDKL       *  1  P 0                                                   
   UT-IDDISTR       *  3  P 0                                                   
   UT-IDKUNDNR      *  4  P 0                                                   
   UT-IDKUNDRF      * 10  A                                                     
   UT-LINES         * 10  P 0                                                   
   UT-VALUE-STD     * 10  P 2                                                   
   UT-VALUE-NET     * 10  P 2                                                   
   UT-VALUE-AVG     * 10  P 2                                                   
   UT-VKARTNTO      * 10  P 3                                                   
   UT-VLARTNTO      * 10  P 1                                                   
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE WXTR03D4   FB (60 0) VIRTUAL RETAIN                                        
*     VISS FAKTURAINFO - TEMPFIL                                                
   T1-IDDC          1  2  A                                                     
   T1-IDPRC         *  4  A                                                     
   T1-KDORDKL       *  1  P 0                                                   
   T1-IDDISTR       *  3  P 0                                                   
   T1-VALUE-STD     * 10  P 2                                                   
   T1-VALUE-NET     * 10  P 2                                                   
   T1-VALUE-AVG     * 10  P 2                                                   
   T1-VKARTNTO      * 10  P 3                                                   
   T1-VLARTNTO      * 10  P 1                                                   
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE WXTR03D5 PRINTER                                                           
FILE WXTR03D6 PRINTER                                                           
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
  JA                        W   1  A   VALUE 'J'                                
  NEJ                       W   1  A   VALUE 'N'                                
*                                                                               
  SPAR-VALUE-STD            W  10  P 2                                          
  SPAR-VALUE-NET            W  10  P 2                                          
  SPAR-VALUE-AVG            W  10  P 2                                          
  SPAR-VKARTNTO             W  10  P 3                                          
  SPAR-VLARTNTO             W  10  P 1                                          
*                                                                               
  PRINT-IDDC                W   2  A                                            
  PRINT-IDPRC               W   4  A                                            
  PRINT-SORTFALT            W   1  N                                            
  PRINT-BELAND              W  25  A                                            
  PRINT-KDORDKL             W   1  P             MASK '9'                       
* PRINT-LINES               W   4  P 0           MASK 'Z.ZZZ.ZZ9'               
  PRINT-VALUE-STD           W   6  P 2           MASK 'ZZZ.ZZZ.ZZ9,99'          
  PRINT-VALUE-NET           W   6  P 2           MASK 'ZZZ.ZZZ.ZZ9,99'          
  PRINT-VALUE-AVG           W   6  P 2           MASK 'ZZZ.ZZZ.ZZ9,99'          
  PRINT-VKARTNTO            W   5  P 3           MASK 'ZZZ.ZZ9,999'             
  PRINT-VLARTNTO            W   5  P 1           MASK 'ZZ.ZZZ.ZZ9,9'            
  PRINT-CUR                 W  21  A                                            
  PRINT-VK                  W  21  A                                            
  PRINT-VL                  W  21  A                                            
*                                                                               
  USD                       W  21  A    VALUE 'CURRENCY IN USD. '               
  CAD                       W  21  A    VALUE 'CURRENCY IN CAD. '               
  CNY                       W  21  A    VALUE 'CURRENCY IN CNY. '               
  POUNDS                    W  21  A    VALUE 'WEIGHT IN POUNDS.'               
  FT3                       W  21  A    VALUE 'VOLUME IN CUBIC FEET.'           
  KG                        W  21  A    VALUE 'WEIGHT IN KILOS.'                
  LITER                     W  21  A    VALUE 'VOLUME IN LITERS.'               
  NET-KG                    W  21  A    VALUE 'WEIGHT IN NET KG.'               
  DM3                       W  21  A    VALUE 'VOLUME IN NET DM3.'              
*                                                                               
%WWOMVAND                                                                       
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT  WXTR03D1                                            +              
                                                 NAME   STEG01                  
   SPAR-VALUE-STD = IN-KVLEVART2 * IN-PRARTSTD                                  
   SPAR-VALUE-NET = IN-KVLEVART2 * IN-PRARTNTO                                  
   SPAR-VALUE-AVG = IN-KVLEVART2 * IN-PRAVCOST                                  
   SPAR-VKARTNTO  = IN-KVLEVART2 * IN-VKARTNTO                                  
   SPAR-VLARTNTO  = IN-KVLEVART2 * IN-VLARTNTO                                  
                                                                                
   PRINT SUMFILE01                                                              
                                                                                
   T1-IDDC        = IN-IDDC-LEV                                                 
   T1-IDPRC       = IN-IDPRC                                                    
   T1-KDORDKL     = IN-KDORDKL                                                  
   T1-IDDISTR     = IN-IDDISTR                                                  
   T1-VALUE-STD   = SPAR-VALUE-STD                                              
   T1-VALUE-NET   = SPAR-VALUE-NET                                              
   T1-VALUE-AVG   = SPAR-VALUE-AVG                                              
   T1-VKARTNTO    = SPAR-VKARTNTO                                               
   T1-VLARTNTO    = SPAR-VLARTNTO                                               
   PUT   WXTR03D4                                                               
                                                                                
NEWPAGE                                                                         
                                                                                
    REPORT SUMFILE01 SUMFILE WXTR03D3                            +              
                     LINESIZE     159                            +              
                     SUMMARY                                     +              
                     NOHEADING                                   +              
                     NODATE                                      +              
                     NOPAGE                                      +              
                     SPACE          0                                           
    CONTROL                                                      +              
              FINAL            NOPRINT                           +              
              IN-IDDC-LEV      NOPRINT                           +              
              IN-IDPRC         NOPRINT                           +              
              IN-KDORDKL       NOPRINT                           +              
              IN-IDDISTR       NOPRINT                           +              
              IN-IDKUNDNR      NOPRINT                           +              
              IN-IDKUNDRF      NOPRINT                                          
    TITLE ' '                                                                   
    LINE 01                                                      +              
              SPAR-VALUE-STD                                     +              
              SPAR-VALUE-NET                                     +              
              SPAR-VALUE-AVG                                     +              
              SPAR-VKARTNTO                                      +              
              SPAR-VLARTNTO                                                     
                                                                                
NEWPAGE                                                                         
                                                                                
  SORT WXTR03D4 TO WXTR03D4 USING (T1-IDDC                       +              
                                   T1-IDDISTR)                   +              
                                                 NAME   STEG02                  
                                                                                
NEWPAGE                                                                         
                                                                                
  JOB INPUT (WXTR03D2 KEY (TAB-IDDC                              +              
                           TAB-IDDISTR)                          +              
             WXTR03D4 KEY (T1-IDDC                               +              
                           T1-IDDISTR ))                         +              
                                                 NAME   STEG03                  
    IF MATCHED                                                                  
      PRINT-IDDC      = T1-IDDC                                                 
      PRINT-IDPRC     = T1-IDPRC                                                
      PRINT-KDORDKL   = T1-KDORDKL                                              
      PRINT-SORTFALT  = 1                                                       
      PRINT-BELAND    = TAB-BELAND                                              
      PERFORM S23-CHECK-T1-IDDC                                                 
      IF T1-IDDC = NDC-NA OR                                     +              
         T1-IDDC = NDC-CN OR                                     +              
         T1-IDDC = LDC-CN                                                       
        PRINT-VALUE-AVG = T1-VALUE-AVG                                          
        IF T1-IDDC = NDC-US                                                     
          PRINT-VKARTNTO  = T1-VKARTNTO           * CONV-KG-TO-LB               
          PRINT-VLARTNTO  = T1-VLARTNTO / 1000000 * CONV-M3-TO-FT3              
          PRINT-CUR       = USD                                                 
          PRINT-VK        = POUNDS                                              
          PRINT-VL        = FT3                                                 
        ELSE                                                                    
          IF T1-IDDC = NDC-CA                                                   
            PRINT-VKARTNTO  = T1-VKARTNTO           * CONV-KG-TO-LB             
            PRINT-VLARTNTO  = T1-VLARTNTO / 1000000 * CONV-M3-TO-FT3            
*           PRINT-VKARTNTO  = T1-VKARTNTO                                       
*           PRINT-VLARTNTO  = T1-VLARTNTO / 1000                                
            PRINT-CUR       = CAD                                               
*           PRINT-VK        = KG                                                
*           PRINT-VL        = LITER                                             
            PRINT-VK        = POUNDS                                            
            PRINT-VL        = FT3                                               
          ELSE                                                                  
            PRINT-VKARTNTO  = T1-VKARTNTO                                       
            PRINT-VLARTNTO  = T1-VLARTNTO / 1000                                
            PRINT-CUR       = CNY                                               
            PRINT-VK        = NET-KG                                            
            PRINT-VL        = DM3                                               
          END-IF                                                                
        END-IF                                                                  
        PRINT RAPPORT02                                                         
      ELSE                                                                      
        PRINT-VALUE-STD   = T1-VALUE-STD                                        
        PRINT-VALUE-NET   = T1-VALUE-NET                                        
        PRINT-VKARTNTO    = T1-VKARTNTO                                         
        PRINT-VLARTNTO    = T1-VLARTNTO / 1000                                  
        PRINT RAPPORT01                                                         
      END-IF                                                                    
    ELSE                                                                        
      IF WXTR03D4                                                               
        PRINT-IDDC      = T1-IDDC                                               
        PRINT-IDPRC     = T1-IDPRC                                              
        PRINT-KDORDKL   = T1-KDORDKL                                            
        PRINT-SORTFALT  = 9                                                     
        PRINT-BELAND    = 'MISC'                                                
        IF T1-IDDC = NDC-NA OR                                   +              
           T1-IDDC = NDC-CN OR                                   +              
           T1-IDDC = LDC-CN                                                     
          PRINT-VALUE-AVG = T1-VALUE-AVG                                        
          IF T1-IDDC = NDC-US                                                   
            PRINT-VKARTNTO  = T1-VKARTNTO           * CONV-KG-TO-LB             
            PRINT-VLARTNTO  = T1-VLARTNTO / 1000000 * CONV-M3-TO-FT3            
            PRINT-CUR       = USD                                               
            PRINT-VK        = POUNDS                                            
            PRINT-VL        = FT3                                               
          ELSE                                                                  
            IF T1-IDDC = NDC-CA                                                 
              PRINT-VKARTNTO  = T1-VKARTNTO           * CONV-KG-TO-LB           
              PRINT-VLARTNTO  = T1-VLARTNTO / 1000000 * CONV-M3-TO-FT3          
*             PRINT-VKARTNTO  = T1-VKARTNTO                                     
*             PRINT-VLARTNTO  = T1-VLARTNTO / 1000                              
              PRINT-CUR       = CAD                                             
              PRINT-VK        = POUNDS                                          
              PRINT-VL        = FT3                                             
*             PRINT-VK        = KG                                              
*             PRINT-VL        = LITER                                           
            ELSE                                                                
              PRINT-VKARTNTO  = T1-VKARTNTO                                     
              PRINT-VLARTNTO  = T1-VLARTNTO / 1000                              
              PRINT-CUR       = CNY                                             
              PRINT-VK        = NET-KG                                          
              PRINT-VL        = DM3                                             
            END-IF                                                              
          END-IF                                                                
          PRINT RAPPORT02                                                       
        ELSE                                                                    
          PRINT-VALUE-STD = T1-VALUE-STD                                        
          PRINT-VALUE-NET = T1-VALUE-NET                                        
          PRINT-VKARTNTO  = T1-VKARTNTO                                         
          PRINT-VLARTNTO  = T1-VLARTNTO / 1000                                  
          PRINT RAPPORT01                                                       
        END-IF                                                                  
      END-IF                                                                    
    END-IF                                                                      
                                                                                
*    --- S23-CHECK-T1-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'T1-'                                                                   
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    REPORT SECTION                              *              
*----------------------------------------------------------------*              
*                                                                               
    REPORT RAPPORT01 PRINTER WXTR03D5                            +              
                     LINESIZE     120                            +              
                     PAGESIZE      41                            +              
                     SUMMARY                                     +              
                     NODATE                                      +              
                     NOADJUST                                    +              
                     NOSPREAD                                    +              
                     SPACE          1                                           
*                                                                               
    SEQUENCE                                                     +              
              PRINT-IDDC                                         +              
              PRINT-IDPRC                                        +              
              PRINT-KDORDKL                                      +              
              PRINT-SORTFALT                                     +              
              PRINT-BELAND                                                      
*                                                                               
    CONTROL                                                      +              
              FINAL          NOPRINT                             +              
              PRINT-IDDC             NEWPAGE RENUM               +              
              PRINT-IDPRC                                        +              
              PRINT-KDORDKL                                      +              
              PRINT-SORTFALT NOPRINT                             +              
              PRINT-BELAND                                                      
*                                                                               
    TITLE 01                                                     +              
    COL   02 'VOLVO CAR CORP., AFTERSALES   WXTR03-001 '         +              
    COL   93  SYSDATE                                                           
*                                                                               
    TITLE 02                                                     +              
    COL   35 'INVOICED LINES PER DC, DISTRICT AND ORDER CLASS.'                 
*                                                                               
    TITLE 03                                                     +              
    COL   35 'TARGET:  DC ' PRINT-IDDC                                          
*                                                                               
    HEADING   PRINT-IDPRC        'PRC'                                          
    HEADING   PRINT-KDORDKL      'CL'                                           
    HEADING   PRINT-BELAND       'COUNTRY'                                      
    HEADING   TALLY              'INV LINES'                                    
    HEADING   PRINT-VALUE-STD   ('VALUE' 'STD SEK')                             
    HEADING   PRINT-VALUE-NET   ('VALUE' 'NET SEK')                             
    HEADING   PRINT-VKARTNTO    ('WEIGHT' 'NET KG')                             
    HEADING   PRINT-VLARTNTO    ('VOLUME' 'NET DM3')                            
*                                                                               
    LINE 01                                                      +              
              PRINT-IDPRC                                        +              
              PRINT-KDORDKL                                      +              
              PRINT-BELAND                                       +              
              TALLY                                              +              
              PRINT-VALUE-STD                                    +              
              PRINT-VALUE-NET                                    +              
              PRINT-VKARTNTO                                     +              
              PRINT-VLARTNTO                                                    
                                                                                
NEWPAGE                                                                         
                                                                                
    REPORT RAPPORT02 PRINTER WXTR03D6                            +              
                     LINESIZE     120                            +              
                     PAGESIZE      41                            +              
                     SUMMARY                                     +              
                     NODATE                                      +              
                     NOADJUST                                    +              
                     NOSPREAD                                    +              
                     SPACE          2                                           
*                                                                               
    SEQUENCE                                                     +              
              PRINT-IDDC                                         +              
              PRINT-SORTFALT                                     +              
              PRINT-IDPRC                                        +              
              PRINT-KDORDKL                                      +              
              PRINT-BELAND                                                      
*                                                                               
    CONTROL                                                      +              
              FINAL          NOPRINT                             +              
              PRINT-IDDC             NEWPAGE RENUM               +              
              PRINT-SORTFALT NOPRINT                             +              
              PRINT-IDPRC                                        +              
              PRINT-KDORDKL                                      +              
              PRINT-BELAND                                                      
*                                                                               
    TITLE 01                                                     +              
    COL   02 'VOLVO CAR CORP., AFTERSALES   WXTR03-002 '         +              
    COL   93  SYSDATE                                                           
*                                                                               
    TITLE 02                                                     +              
    COL   10 'INVOICED LINES PER DC, DISTRICT AND ORDER CLASS.'                 
*                                                                               
    TITLE 03                                                     +              
    COL   10 PRINT-CUR                                           +              
             PRINT-VK                                            +              
             PRINT-VL                                                           
*                                                                               
    TITLE 04                                                     +              
    COL   35 'TARGET:  DC' PRINT-IDDC                                           
*                                                                               
    HEADING   PRINT-IDPRC        'PRC'                                          
    HEADING   PRINT-KDORDKL      'CL'                                           
    HEADING   PRINT-BELAND       'COUNTRY'                                      
    HEADING   TALLY              'INV LINES'                                    
    HEADING   PRINT-VALUE-AVG   ('VALUE,' 'AVG. COST')                          
    HEADING   PRINT-VKARTNTO    ('WEIGHT,' 'NET')                               
    HEADING   PRINT-VLARTNTO    ('VOLUME,' 'NET')                               
*                                                                               
    LINE 01                                                      +              
              PRINT-IDPRC                                        +              
              PRINT-KDORDKL                                      +              
              PRINT-BELAND                                       +              
              TALLY                                              +              
              PRINT-VALUE-AVG                                    +              
              PRINT-VKARTNTO                                     +              
              PRINT-VLARTNTO                                                    
                                                                                
NEWPAGE                                                                         
