                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W4266000                                              *        
*                                                                      *        
*  FUNKTION   :  LÄSER ARTIKEL INFO OCH SKAPAR EN UTFIL                *        
*                                                                      *        
*  FÖRFATTARE :  GERRY CARMICHAEL                                      *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W42660D1                                                                   
*                                                                               
%W91042  'IN-'                                                                  
*                                                                               
*LB-BEART-TAB-R       IN-WDD3-INFO                  280 A                       
*LB-BEART-TABELL-R    LB-BEART-TAB-R                 28 A   +                   
*                  OCCURS    10                                                 
*LB-IDSKYLT-R         LB-BEART-TABELL-R               3 A                       
*LB-BEART-R           LB-BEART-TABELL-R  +3          25 A                       
*                                                                               
                                                                                
NEWPAGE                                                                         
FILE W42660D2 FB(63 0000)                                                       
*                                                                               
%W4266001  'UT-'                                                                
                                                                                
NEWPAGE                                                                         
*                                                                               
*---------------- WORKING STORAGE -------------------------*                    
IX                     W  2  N  VALUE 0                                         
W-IDSKYLT              W  3  A                                                  
                                                                                
*    -- CHECKED BY WY2000                                                       
NEWPAGE                                                                         
*                                                                               
* STEG 1. SKRIVER UTFIL                                                         
*                                                                               
JOB INPUT W42660D1 +                                                            
                    NAME STEG01                                                 
                                                                                
  UT-IDARTNR     =  IN-IDARTNR                                                  
                                                                                
  IF IN-IDBERED > 19 OR IN-IDBERED EQ 0                                         
    MOVE 'S  ' TO W-IDSKYLT                                                     
  ELSE                                                                          
    MOVE 'GB ' TO W-IDSKYLT                                                     
  END-IF                                                                        
                                                                                
  IX = 1                                                                        
  DO WHILE IX < 11                                                              
    IF IN-IDSKYLT   (IX) = W-IDSKYLT                                            
      UT-BEART   =  IN-BEART   (IX)                                             
      IX         =  11                                                          
    ELSE                                                                        
      IX = IX + 1                                                               
    END-IF                                                                      
  END-DO                                                                        
                                                                                
  UT-IDBERED     =  IN-IDBERED                                                  
  UT-IDFKNGRP    =  IN-IDFKNGRP                                                 
  UT-IDLEVNR-OLD =  IN-IDLEVNR                                                  
  UT-IDLEVNR-NEW =  IN-IDLEVNR                                                  
  UT-KDERS       =  IN-KDERS                                                    
  UT-KDFARLIG    =  IN-KDFARLIG                                                 
  UT-BEFT        =  IN-BEFT                                                     
  UT-KDPRODSL    =  IN-KDPRODSL                                                 
  UT-KDVVKL      =  IN-KDVVKL                                                   
  UT-KDYTBEH     =  IN-KDYTBEH                                                  
  UT-PRARTSTD    =  IN-PRARTSTD                                                 
  UT-TIFINLV     =  IN-TIFINLV                                                  
                                                                                
  PUT W42660D2                                                                  
