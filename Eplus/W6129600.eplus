FILE W61296DI                                                                   
*                                                                               
%W01171    'BE-CN-'                                                             
                                                                                
***********************************************************************         
***** WORKING STORAGE     ********************                                  
***********************************************************************         
SPAR-IDDC             W   2 A                                                   
SPAR-IDARTNR          W   9 N                                                   
WS-KVBUFF             W   4 P 0                                                 
WS-URVAL1             W   5 P 3                                                 
WS-URVAL2             W   5 P 3                                                 
WS-KVPLATS            W   5 P 3                                                 
COUNTER               W   3 N 0                                                 
PAGE                  W   8 A VALUE '    PAGE'                                  
WS-PREV-IDDC          W   2 A                                                   
UTG-IDARTNR           W   9 N    MASK 'ZZZZZZZZ9'                               
UTG-KVPB-REF          W   7 N 1  MASK '--- --9.9'                               
UTG-KVPLATS           W   7 N 0  MASK '- --- --9'                               
UTG-KVBUFF            W   7 N 0  MASK '- --- --9'                               
                                                                                
WS-ADBUFF                W  11 A                                                
  WS-ADBUFFOMR  WS-ADBUFF    2 N                                                
  WS-BLANK1     WS-ADBUFF +2 1 A                                                
  WS-ADBUFFGANG WS-ADBUFF +3 2 N                                                
  WS-BLANK2     WS-ADBUFF +5 1 A                                                
  WS-ADBUFFPL   WS-ADBUFF +6 5 N                                                
                                                                                
DAGENS-DATUM          W   6  N                                                  
  DAGENS-TIAA         DAGENS-DATUM     2  N                                     
  DAGENS-TIMM         DAGENS-DATUM +2  2  N                                     
  DAGENS-TIDD         DAGENS-DATUM +4  2  N                                     
                                                                                
DD-DATUM              W   6  N                                                  
*                                                                               
*    --- VALID IDDC CODES                                                       
%WWDC99                                                                         
*    --- VALID KDPRODSL                                                         
%WWPRODSL  'IN-CLAG-' WORK ''                                                   
***********************************************************************         
***** ALLMÄNNA SUBPROGRAM ********************                                  
***********************************************************************         
PROGRAM-NAMN      W   6   A   VALUE 'W61296'                                    
DATUMKORT-ID      W   6   A   VALUE '000000'                                    
%WDATKORT 'DATKORT-'                                                            
*                                                                               
%WDAGAREA                                                                       
                                                                                
*    --- TO CHECK IF "WEB DC"                                                   
*                                                                               
%WL10WBDC                                                                       
*                                                                               
 NEWPAGE                                                                        
***********************************************************************         
*   JOB INPUT                                                                   
***********************************************************************         
*                                                                               
***********************************************************************         
* STEP01                                                                        
* SORTERAR BUFFERTFILEN OCH SELEKTERAR UT NDC                                   
***********************************************************************         
SORT W61296D1 TO W61296D4 USING (W48881-IDDC, W48881-IDARTNR)      +            
                                              BEFORE URVAL                      
*                                                                               
URVAL. PROC                                                                     
      PERFORM S23-CHECK-W48881-IDDC                                             
*     -- ALL NDC:S + LDC:S + SDC:S                                              
      IF W48881-IDDC = NDC, LDC, SDC                                            
          SELECT                                                                
      END-IF                                                                    
END-PROC                                                                        
*    --- S23-CHECK-W48881-IDDC (MACRO PROCEDURE)                                
%WWDC02 'W48881-'                                                               
*                                                                               
***********************************************************************         
* STEP02                                                                        
* SUMMERAR BUFFERT-SALDO/ ARTIKEL O LAGER                                       
***********************************************************************         
JOB INPUT W61296D4                                                  +           
                                           FINISH Z-FINIT                       
                                                                                
IF RECORD-COUNT = 1                                                             
   SPAR-IDDC    = BUF-IDDC                                                      
   SPAR-IDARTNR = BUF-IDARTNR                                                   
END-IF                                                                          
IF SPAR-IDDC = BUF-IDDC AND SPAR-IDARTNR = BUF-IDARTNR                          
   WS-KVBUFF = WS-KVBUFF + BUF-KVBUFF-F + BUF-KVBUFF-OF                         
ELSE                                                                            
   BUF2-IDDC    = SPAR-IDDC                                                     
   BUF2-IDARTNR = SPAR-IDARTNR                                                  
   BUF2-KVBUFF  = WS-KVBUFF                                                     
   PUT W61296D5                                                                 
   SPAR-IDDC    = BUF-IDDC                                                      
   SPAR-IDARTNR = BUF-IDARTNR                                                   
   WS-KVBUFF    = BUF-KVBUFF-F + BUF-KVBUFF-OF                                  
END-IF                                                                          
                                                                                
Z-FINIT. PROC                                                                   
      BUF2-IDDC    = SPAR-IDDC                                                  
      BUF2-IDARTNR = SPAR-IDARTNR                                               
      BUF2-KVBUFF  = WS-KVBUFF                                                  
      PUT W61296D5                                                              
END-PROC                                                                        
***********************************************************************         
* STEP03                                                                        
* MATCHAR SUMMERADE BUFFILEN MED W01184-FILEN FÖR ATT FÅ FRAM                   
* DE ARTIKLAR SOM SKA MED PÅ LISTAN, SÄTTER STATUS PÅ DESSA                     
***********************************************************************         
JOB INPUT (W61296D5 KEY (BUF2-IDDC              +                               
                         BUF2-IDARTNR)          +                               
           W61296D2 KEY (LB-SLAG-IDDC           +                               
                         LB-SLAG-IDARTNR))                                      
                                                                                
IF MATCHED                                                                      
  WS-KVPLATS = LB-SLAG-KVLS - BUF2-KVBUFF                                       
* RÄKNAR UT SALDOT PÅ PLOCKPLATS (LAGERSALDO - TOTALT BUFFERTSALDO)             
                                                                                
     WS-URVAL1 = 0.05                                                           
     WS-URVAL2 = 0.10                                                           
                                                                                
                                                                                
* TRÄFF NEDAN OM PLOCKPLATSSALDO ÄR MINDRE ÄN SUMMERAD ORDERKÖ ELLER            
* MINDRE ÄN FEM PROCENT AV PERIODBEHOV (REFILLING)                              
  IF WS-KVPLATS < (LB-SLAG-KVOKS-DAG + LB-SLAG-KVOKS-BULK)  OR     +            
     WS-KVPLATS < WS-URVAL1 * LB-SLAG-KVPB-REF                                  
     TMP-IDDC     = BUF2-IDDC                                                   
     TMP-IDARTNR  = BUF2-IDARTNR                                                
     TMP-ADLAGOMR = LB-SLAG-ADLAGOMR                                            
     TMP-ADGANG   = LB-SLAG-ADGANG                                              
     TMP-ADPLATS  = LB-SLAG-ADPLATS                                             
     TMP-KVPB-REF = LB-SLAG-KVPB-REF                                            
     TMP-KVPLATS  = WS-KVPLATS                                                  
     TMP-STATUS   = '1PRIO  '                                                   
     IF LB-SLAG-KDLEVSP > 0                                                     
        TMP-KDFLAGGA-KVAL = ' TOTAL '                                           
     ELSE                                                                       
        IF LB-SLAG-KVSPARR-KVAL > 0                                             
           TMP-KDFLAGGA-KVAL = 'PARTIAL'                                        
        ELSE                                                                    
           TMP-KDFLAGGA-KVAL = '       '                                        
        END-IF                                                                  
     END-IF                                                                     
     PUT W61296D6                                                               
  ELSE                                                                          
     IF W61296D2                                                                
        WS-KVPLATS = LB-SLAG-KVLS                                               
        IF WS-KVPLATS < WS-URVAL2 * LB-SLAG-KVPB-REF                            
           TMP-IDDC  = LB-SLAG-IDDC                                             
           TMP-IDARTNR = LB-SLAG-IDARTNR                                        
           TMP-ADLAGOMR = LB-SLAG-ADLAGOMR                                      
           TMP-ADGANG = LB-SLAG-ADGANG                                          
           TMP-ADPLATS = LB-SLAG-ADPLATS                                        
           TMP-KVPB-REF = LB-SLAG-KVPB-REF                                      
           TMP-KVPLATS = WS-KVPLATS                                             
           TMP-STATUS = '2NORMAL'                                               
           IF LB-SLAG-KDLEVSP > 0                                               
              TMP-KDFLAGGA-KVAL = ' TOTAL '                                     
           ELSE                                                                 
              IF LB-SLAG-KVSPARR-KVAL > 0                                       
                 TMP-KDFLAGGA-KVAL = 'PARTIAL'                                  
              ELSE                                                              
                 TMP-KDFLAGGA-KVAL = '       '                                  
              END-IF                                                            
           END-IF                                                               
           PUT W61296D6                                                         
        END-IF                                                                  
     END-IF                                                                     
  END-IF                                                                        
END-IF                                                                          
***********************************************************************         
* STEP04                                                                        
* SORTERAR OM FÖR ATT FÅ BENÄMNING TILL ALLA DC                                 
***********************************************************************         
SORT W61296D6 TO W61296D6 USING (TMP-IDARTNR , TMP-IDDC)                        
***********************************************************************         
* STEP05                                                                        
* HÄMTAR ARTIKELBENÄMNING                                                       
***********************************************************************         
JOB INPUT (W61296D3 KEY (BE-IDARTNR)             +                              
           W61296D6 KEY (TMP-IDARTNR))                                          
IF MATCHED                                                                      
   UTW-IDDC     = TMP-IDDC                                                      
   UTW-IDARTNR  = TMP-IDARTNR                                                   
   UTW-ADLAGOMR = TMP-ADLAGOMR                                                  
   UTW-BLANK1   = ' '                                                           
   UTW-ADGANG   = TMP-ADGANG                                                    
   UTW-BLANK2   = ' '                                                           
   UTW-ADPLATS  = TMP-ADPLATS                                                   
   UTW-KVPB-REF = TMP-KVPB-REF                                                  
   UTW-KVPLATS  = TMP-KVPLATS                                                   
   UTW-STATUS   = TMP-STATUS                                                    
   UTW-BEART    = BE-BEART(10)                                                  
   UTW-KDFLAGGA-KVAL = TMP-KDFLAGGA-KVAL                                        
   PUT W61296DH                                                                 
ELSE                                                                            
   IF W61296D6                                                                  
      UTW-IDDC     = TMP-IDDC                                                   
      UTW-IDARTNR  = TMP-IDARTNR                                                
      UTW-ADLAGOMR = TMP-ADLAGOMR                                               
      UTW-BLANK1   = ' '                                                        
      UTW-ADGANG   = TMP-ADGANG                                                 
      UTW-BLANK2   = ' '                                                        
      UTW-ADPLATS  = TMP-ADPLATS                                                
      UTW-KVPB-REF = TMP-KVPB-REF                                               
      UTW-KVPLATS  = TMP-KVPLATS                                                
      UTW-STATUS   = TMP-STATUS                                                 
      UTW-BEART    = ' '                                                        
      UTW-KDFLAGGA-KVAL = TMP-KDFLAGGA-KVAL                                     
      PUT W61296DH                                                              
   END-IF                                                                       
END-IF                                                                          
***********************************************************************         
* STEP05-CN                                                                     
* HÄMTAR ARTIKELBENÄMNING (KINESISK)                                            
***********************************************************************         
JOB INPUT (W61296DI KEY (BE-CN-IDARTNR)          +                              
           W61296DH KEY (UTW-IDARTNR))                                          
IF MATCHED                                                                      
   UT1-IDDC     = UTW-IDDC                                                      
   UT1-IDARTNR  = UTW-IDARTNR                                                   
   UT1-ADLAGOMR = UTW-ADLAGOMR                                                  
   UT1-BLANK1   = ' '                                                           
   UT1-ADGANG   = UTW-ADGANG                                                    
   UT1-BLANK2   = ' '                                                           
   UT1-ADPLATS  = UTW-ADPLATS                                                   
   UT1-KVPB-REF = UTW-KVPB-REF                                                  
   UT1-KVPLATS  = UTW-KVPLATS                                                   
   UT1-STATUS   = UTW-STATUS                                                    
                                                                                
   PERFORM S23-CHECK-UTW-IDDC                                                   
   IF UTW-IDDC = NDC-CN, LDC-CN                                                 
      UT1-BEART    = BE-CN-BEARTEXT(9)                                          
   ELSE                                                                         
      UT1-BEART    = UTW-BEART                                                  
   END-IF                                                                       
   UT1-KDFLAGGA-KVAL = UTW-KDFLAGGA-KVAL                                        
   PUT W61296D7                                                                 
ELSE                                                                            
   IF W61296DH                                                                  
      UT1-IDDC     = UTW-IDDC                                                   
      UT1-IDARTNR  = UTW-IDARTNR                                                
      UT1-ADLAGOMR = UTW-ADLAGOMR                                               
      UT1-BLANK1   = ' '                                                        
      UT1-ADGANG   = UTW-ADGANG                                                 
      UT1-BLANK2   = ' '                                                        
      UT1-ADPLATS  = UTW-ADPLATS                                                
      UT1-KVPB-REF = UTW-KVPB-REF                                               
      UT1-KVPLATS  = UTW-KVPLATS                                                
      UT1-STATUS   = UTW-STATUS                                                 
      UT1-BEART    = UTW-BEART                                                  
      UT1-KDFLAGGA-KVAL = UTW-KDFLAGGA-KVAL                                     
      PUT W61296D7                                                              
   END-IF                                                                       
END-IF                                                                          
*    --- S23-CHECK-UTW-IDDC (MACRO PROCEDURE)                                   
%WWDC02 'UTW-'                                                                  
***********************************************************************         
* STEP06                                                                        
* SELEKTERAR BORT EMBALLAGE MHA. KDPRODSL                                       
***********************************************************************         
JOB INPUT (W61296D7 KEY (UT1-IDARTNR)             +                             
           W61296D9 KEY (IN-CLAG-IDARTNR))                                      
IF MATCHED                                                                      
  PERFORM S25-CHECK-IN-CLAG-KDPRODSL                                            
  IF IN-CLAG-KDPRODSL EQ KDPRODSL-VOLVO-EMB KDPRODSL-LOCAL-EMB                  
     CONTINUE                                                                   
  ELSE                                                                          
     IF UT1-IDDC  = NDC-AU                                                      
        IF UT1-ADLAGOMR NE 49                                                   
*          SELEKTERAR BORT LAGEROMRÅDE 49 FÖR DC 62                             
*          DÅ DETTA ïNTE ANVÄNDS FÖR PÅFYLLNAD !!!  JL 990429                   
           UT-IDDC    =  UT1-IDDC                                               
           UT-IDARTNR =  UT1-IDARTNR                                            
           UT-ADLAGOMR = UT1-ADLAGOMR                                           
           UT-BLANK1  =  ' '                                                    
           UT-ADGANG  =  UT1-ADGANG                                             
           UT-BLANK2  =  ' '                                                    
           UT-ADPLATS =  UT1-ADPLATS                                            
           UT-KVPB-REF = UT1-KVPB-REF                                           
           UT-KVPLATS =  UT1-KVPLATS                                            
           UT-STATUS  =  UT1-STATUS                                             
           UT-BEART   =  UT1-BEART                                              
           UT-KDFLAGGA-KVAL = UT1-KDFLAGGA-KVAL                                 
           PUT W61296D0                                                         
        END-IF                                                                  
     ELSE                                                                       
        UT-IDDC       =  UT1-IDDC                                               
        UT-IDARTNR    =  UT1-IDARTNR                                            
        UT-ADLAGOMR   =  UT1-ADLAGOMR                                           
        UT-BLANK1     =  ' '                                                    
        UT-ADGANG     =  UT1-ADGANG                                             
        UT-BLANK2     =  ' '                                                    
        UT-ADPLATS    =  UT1-ADPLATS                                            
        UT-KVPB-REF   =  UT1-KVPB-REF                                           
        UT-KVPLATS    =  UT1-KVPLATS                                            
        UT-STATUS     =  UT1-STATUS                                             
        UT-BEART      =  UT1-BEART                                              
        UT-KDFLAGGA-KVAL = UT1-KDFLAGGA-KVAL                                    
        PUT W61296D0                                                            
     END-IF                                                                     
  END-IF                                                                        
END-IF                                                                          
%WWPRODSL 'IN-CLAG-' PROC ''                                                    
***********************************************************************         
* STEP07                                                                        
* SORTERAR URVALSFIL PÅ DC OCH ARTNR                                            
***********************************************************************         
SORT W61296D0 TO W61296D0 USING (UT-IDDC , UT-IDARTNR)                          
***********************************************************************         
* STEP08                                                                        
* MATCHER URVALSFIL MED DEN SUMMERADE BUFFERTFILEN                              
* OCH KOMPLETTERAR PÅ SÅ SÄTT EN DEL UPPGIFTER                                  
***********************************************************************         
JOB INPUT (W61296D0 KEY (UT-IDDC                +                               
                         UT-IDARTNR)            +                               
           W61296D4 KEY (BUF-IDDC               +                               
                         BUF-IDARTNR))                                          
IF MATCHED                                                                      
   BUF3-IDDC        = BUF-IDDC                                                  
   BUF3-IDARTNR     = BUF-IDARTNR                                               
   BUF3-ADBUFFOMR   = BUF-ADBUFFOMR                                             
   BUF3-ADBUFFGANG  = BUF-ADBUFFGANG                                            
   BUF3-ADBUFFPL    = BUF-ADBUFFPL                                              
   BUF3-KVBUFF      = BUF-KVBUFF-F                                              
   BUF3-DABUFPAF    = BUF-DABUFPAF                                              
   BUF3-ADLAGOMR    = UT-ADLAGOMR                                               
   BUF3-STATUS-NR   = UT-STATUS-NR                                              
   BUF3-KDFLAGGA-KVAL = UT-KDFLAGGA-KVAL                                        
   PUT W61296D8                                                                 
END-IF                                                                          
                                                                                
***********************************************************************         
* STEP09                                                                        
* SORTERAR URVALSFILEN                                                          
***********************************************************************         
SORT W61296D0 TO W61296D0 USING (UT-IDDC, UT-ADLAGOMR, UT-STATUS-NR  +          
                                                      UT-IDARTNR)               
                                                                                
***********************************************************************         
* STEP10                                                                        
* SORTERAR DEN KOMPL. URVALSFILEN                                               
***********************************************************************         
SORT W61296D8 TO W61296D8 USING (BUF3-IDDC, BUF3-ADLAGOMR,           +          
                            BUF3-STATUS-NR, BUF3-IDARTNR, BUF3-DABUFPAF)        
                                                                                
***********************************************************************         
* STEP11                                                                        
* MATCHAR MED BUFFERTFIL OCH SKRIVER UTLISTOR                                   
***********************************************************************         
JOB INPUT (W61296D0 KEY (UT-IDDC                 +                              
                         UT-IDARTNR)             +                              
           W61296D8 KEY (BUF3-IDDC               +                              
                         BUF3-IDARTNR))          +                              
                              START A-INIT                                      
IF MATCHED                                                                      
   IF SPAR-IDDC = UT-IDDC AND SPAR-IDARTNR = UT-IDARTNR                         
      COUNTER   = COUNTER + 1                                                   
   ELSE                                                                         
      IF SPAR-IDDC NE UT-IDDC                                                   
        PERFORM X-CHECK-IF-WEB-REPORT                                           
        SPAR-IDDC    = UT-IDDC                                                  
      END-IF                                                                    
      COUNTER      = 1                                                          
      SPAR-IDARTNR = UT-IDARTNR                                                 
   END-IF                                                                       
   WS-ADBUFFOMR  = BUF3-ADBUFFOMR                                               
   WS-BLANK1     = ' '                                                          
   WS-ADBUFFGANG = BUF3-ADBUFFGANG                                              
   WS-BLANK2     = ' '                                                          
   WS-ADBUFFPL   = BUF3-ADBUFFPL                                                
   PERFORM S23-CHECK-UT-IDDC                                                    
*                                                                               
* OBS OBS OBS NYTT SKRIVER ALLA BUFFERTPLATSER                                  
*  IF COUNTER < 4                                                               
      IF WBDC-FLWEBDC = 'N'                                                     
*       -- NON WEB DC:S - SEPARATE REPORTS FOR EACH                             
        IF UT-IDDC = NDC-US-RU                                                  
           PRINT W61296-001                                                     
        END-IF                                                                  
        IF UT-IDDC = NDC-US-LA                                                  
           PRINT W61296-003                                                     
        END-IF                                                                  
        IF UT-IDDC = NDC-JP-61                                                  
          PRINT W61296-005                                                      
        END-IF                                                                  
      ELSE                                                                      
*       -- ALL WEB DC:S (LDC, SDC, NDC)                                         
        UTG-IDARTNR   = UT-IDARTNR                                              
        UTG-KVPB-REF  = UT-KVPB-REF                                             
        UTG-KVPLATS   = UT-KVPLATS                                              
        UTG-KVBUFF    = BUF3-KVBUFF                                             
        PRINT W61296-007                                                        
      END-IF                                                                    
*  END-IF                                                                       
END-IF                                                                          
                                                                                
A-INIT. PROC                                                                    
*  INITIERING AV ARBETSFÄLT                                                     
      SPAR-IDDC          = UT-IDDC                                              
      SPAR-IDARTNR       = UT-IDARTNR                                           
      COUNTER            = 0                                                    
*  INHÄMTNING AV DATUM                                                          
      CALL DATKORT USING (PROGRAM-NAMN       +                                  
                          DATUMKORT-ID       +                                  
                          DATKORT-DATUMKORT)                                    
      DAGENS-TIAA        = DATKORT-D-AAR                                        
      DAGENS-TIMM        = DATKORT-D-MAANAD                                     
      DAGENS-TIDD        = DATKORT-D-DAG                                        
*  FRAMRÄKNING AV DATKORTSDATUM TILL NÄSTA DAG                                  
      DAG-TIAAMMDD-FOM   = DAGENS-DATUM                                         
      DAG-KDCALL         = +002                                                 
******* ------------->     +002 = NÄSTA DAG                                     
      DAG-KVKALDAG       = +002                                                 
      CALL WDAGKONV USING (DAG-KDCALL      +                                    
                           DAG-DATUM-AREA  +                                    
                           DAG-KDSVAR)                                          
                                                                                
      IF DAG-KDSVAR = ' '                                                       
         DD-DATUM        = DAG-TIAAMMDD-TOM                                     
      ELSE                                                                      
         DISPLAY 'FEL FRÅN WDATKONV   I A-INIT SECTION I W61296'                
                                                                                
         STOP EXECUTE                                                           
      END-IF                                                                    
                                                                                
END-PROC                                                                        
*    --- S23-CHECK-UT-IDDC (MACRO PROCEDURE)                                    
%WWDC02 'UT-'                                                                   
*                                                                               
                                                                                
NEWPAGE                                                                         
X-CHECK-IF-WEB-REPORT. PROC                                                     
   WBDC-IDDC = UT-IDDC                                                          
   CALL WL10WBDC USING WBDC-AREA                                                
END-PROC                                                                        
                                                                                
NEWPAGE                                                                         
