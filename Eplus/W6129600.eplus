REPORT W61296-001 PRINTER W61296DA                                +             
         LINESIZE       121                                       +             
         NOSPREAD                                                 +             
         NOADJUST                                                 +             
         NODATE                                                   +             
         SPACE            1                                                     
                                                                                
SEQUENCE UT-ADLAGOMR UT-STATUS-TEXT UT-ADART UT-IDARTNR UT-BEART                
                                                                                
CONTROL  FINAL           NOPRINT                                  +             
         UT-ADLAGOMR     NEWPAGE   NOPRINT                        +             
         UT-STATUS-TEXT  NEWPAGE   NOPRINT                        +             
         UT-ADART        NOPRINT                                  +             
         UT-IDARTNR      NOPRINT                                  +             
         UT-BEART        NOPRINT                                                
                                                                                
TITLE 01 DD-DATUM '            W61296-001  ' UT-STATUS-TEXT       +             
         '     LIST PARTS TO BE'                                  +             
         'BIN FILLED IN DC 41    AREA ' UT-ADLAGOMR               +             
COL 106  PAGE                                                                   
                                                                                
HEADING  UT-IDARTNR    'PARTNUMBER'                                             
HEADING  UT-KDFLAGGA-KVAL ('QUALITY' 'BLOCKED')                                 
HEADING  UT-BEART      'PART DESCRIPTION'                                       
HEADING  UT-KVPB-REF   'FORECAST'                                               
HEADING  UT-ADART      'PRIME LOCATION'                                         
HEADING  UT-KVPLATS    'QUANTITY'                                               
HEADING  WS-ADBUFF     'RESERVE LOCATION'                                       
HEADING  BUF3-KVBUFF   'QUANTITY'                                               
                                                                                
LINE 01  UT-IDARTNR                                               +             
         UT-KDFLAGGA-KVAL                                         +             
         UT-BEART                                                 +             
         UT-KVPB-REF                                              +             
         UT-ADART                                                 +             
         UT-KVPLATS                                               +             
         WS-ADBUFF                                                +             
         BUF3-KVBUFF                                                            
*                                                                               
AFTER-BREAK. PROC                                                               
  IF LEVEL EQ 2                                                                 
     DISPLAY '- - - - -'                                                        
  END-IF                                                                        
END-PROC                                                                        
