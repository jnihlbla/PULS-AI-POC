                                                                                
 **********************************************************************         
 *                                                                    *         
 * PROGRAM       W55190                                               *         
 *                                                                    *         
 * SKRIVET AV    KARL JOHAN HANSSON                                   *         
 *                                                                    *         
 * DATUM         OKTOBER 1999                                         *         
 *                                                                    *         
 * FUNKTION:     SKAPAR ANALYS-LISTOR VID ÅRSSLUT ÖVER LAGERV.FÖRÄNDR.*         
 *                                                                    *         
 * INDATA   D1.: W551.W551B1.W55160(+0) - NYA PRISÄNDR.FILEN (W551B1) *         
 *          D2   W551.WYR001.W55102(+0) - ÅRSFIL FRÅN FÖRRA ÅRSSKIFTET*         
 *          D3   W510.W510D4.W51053     - SALDO ALLA DC UTOM 4X OCH 5X*         
 *               W510.W510D4.W51054       SALDO DC 11                 *         
 *                                                                    *         
 * RAPPORT  D4.: W55190-001 - ANALYSLISTA / PRODUKTSLAG               *         
 *          D5   W55190-002 - KONTROLL-LISTA EJ JÄMFÖRBARA ARTIKLAR   *         
 *          D6   W55190-003 - ANALYSLISTA / TOTAL                     *         
 *          D7   W510.W01172(+0) - ARTREG-EXTRAKT MED NYTT STD        *         
 **********************************************************************         
                                                                                
 *****************************************************************              
 *                                                               *              
 * INFIL01    SPIS ANALYS-FIL W55160                             *              
 *                                                               *              
 *****************************************************************              
 FILE W55190D1                                                                  
                                                                                
 %W551601 (ANA-)                                                                
 *****************************************************************              
 *                                                               *              
 * INFIL02    ÅRSFIL W55102 FRÅN FÖRRA STANDARDPRISSÄTTNINGEN    *              
 *            FÖREGÅENDE ÅR.                                     *              
 *****************************************************************              
 FILE W55190D2                                                                  
                                                                                
 %W55102 (YEAR-)                                                                
                                                                                
 *****************************************************************              
 *                                                               *              
 * INFIL03    SALDOFIL ALLA DC UTOM FÖR USA O CANADA             *              
 *                                                               *              
 *****************************************************************              
 FILE W55190D3                                                                  
 %W51054 'D3-'                                                                  
                                                                                
 *****************************************************************              
 *                                                               *              
 * INFIL07    ARTIKELREG-UPPGIFTER FRÅN WDK6                     *              
 *                                                               *              
 *****************************************************************              
 FILE W55190D7                                                                  
 %W011100 'LB-'                                                                 
                                                                                
 *****************************************************************              
 *                                                               *              
 * TPFIL1     SPIS ANALYS-FIL W55160 MED KOMPL. DISP. LAGER      *              
 *                                                               *              
 *****************************************************************              
 FILE TPFIL1 FB (192 0)                                                         
 %W551601   'T1-'                                                               
                                                                                
 *****************************************************************              
 *                                                               *              
 * TPFIL2     SORTERAD SALDOFIL ALLA DC UTO 4X O 5X              *              
 *                                                               *              
 *****************************************************************              
 FILE TPFIL2 FB (46 0)                                                          
 %W51054    'T2-'                                                               
                                                                                
 *****************************************************************              
 *                                                               *              
 * TPFIL3     SUMMERAD SALDOFIL ALLA DC UTO 4X O 5X              *              
 *            KOMPLETTERD MED ARTREGUPPGIFTER                    *              
 *                                                               *              
 *****************************************************************              
 FILE TPFIL3 FB (22 0)                                                          
 T3-IDARTNR   1 5 P 0                                                           
 T3-IDLEVNR   6 5 A                                                             
 T3-KVDISP   11 5 P 0                                                           
 T3-PRARTSTD 16 5 P 2                                                           
 T3-KDPRODSL 21 2 P 0                                                           
                                                                                
 *****************************************************************              
 *                                                               *              
 * ARBETSAREA                                                    *              
 *                                                               *              
 *****************************************************************              
                                                                                
 W-IDARTNR           W  8  N    MASK 'ZZZZZZZ9'                                 
 W-KDPRODSL          W  2  N    MASK 'Z9'                                       
 W-FELTYP            W 26  A                                                    
 W-FL-JFRBAR         W  1  A                                                    
                                                                                
 W-PRARTSTD-AKT      W  5  P 2                                                  
 W-PRARTSTD-KOM      W  5  P 2                                                  
 W-PRARTSTD-AKT8     W 12  N 5                                                  
 W-PRARTSTD-KOM8     W 12  N 5                                                  
                                                                                
 W-LAGERV-AKT-J      W 11  N 3  MASK '--------.--9'                             
 W-LAGERV-AKT-N      W 11  N 3  MASK '--------.--9'                             
                                                                                
 W-LAGERV-KOM-J      W 11  N 3  MASK '--------.--9'                             
 W-LAGERV-KOM-N      W 11  N 3  MASK '--------.--9'                             
                                                                                
 W-A                 W 18  N 10                                                 
 W-B                 W 18  N 10                                                 
 W-C                 W 18  N 10                                                 
 W-D                 W 18  N 10                                                 
                                                                                
 W-BASPRIS-DIFF      W 18  N 10                                                 
 W-BASPRIS-DIFF-J    W 11  N 3  MASK '--------.--9'                             
                                                                                
 W-VALUTA-DIFF       W 18  N 10                                                 
 W-VALUTA-DIFF-J     W 11  N 3  MASK '--------.--9'                             
                                                                                
 W-HEMTAG-DIFF       W 18  N 10                                                 
 W-HEMTAG-DIFF-J     W 11  N 3  MASK '--------.--9'                             
                                                                                
 W-KALKP-DIFF        W 18  N 10                                                 
 W-KALKP-DIFF-J      W  9  N 3  MASK '------.--9'                               
                                                                                
 W-KALKP-AKT         W  9  N 3  MASK '------.--9'                               
 W-KALKP-KOM         W  9  N 3  MASK '------.--9'                               
                                                                                
 S-BASPRIS-PROC-J    W  5  N 2  MASK '--9.99'                                   
 S-VALUTA-PROC-J     W  5  N 2  MASK '--9.99'                                   
 S-HEMTAG-PROC-J     W  5  N 2  MASK '--9.99'                                   
 S-KALKP-PROC-J      W  5  N 2  MASK '--9.99'                                   
                                                                                
 S-SUMMA-PROC-J      W  5  N 2  MASK '--9.99'                                   
 S-SUMMA-PROC-N      W  5  N 2  MASK '--9.99'                                   
                                                                                
 S-SUMMA-DIFF-J      W 11  N 3  MASK '--------.--9'                             
 S-SUMMA-DIFF-N      W 11  N 3  MASK '--------.--9'                             
                                                                                
 S-LAGERV-AKT-TOT    W 11  N 3  MASK '--------.--9'                             
 S-LAGERV-KOM-TOT    W 11  N 3  MASK '--------.--9'                             
                                                                                
 S-LAGERV-DIFF-N     W 11  N 3  MASK '--------.--9'                             
                                                                                
 S-LAGERV-DIFF-TOT   W 11  N 3  MASK '--------.--9'                             
 S-LAGERV-PROC-TOT   W  5  N 2  MASK '--9.99'                                   
                                                                                
 ***************                                                                
 * RAPPORT 1 - *                                                 *              
 ***************                                                                
 FILE W55190D4 VB(84 0) PRINTER                                                 
                                                                                
 ***************                                                                
 * RAPPORT 2 - *                                                 *              
 ***************                                                                
 FILE W55190D5 VB(84 0) PRINTER                                                 
                                                                                
 ***************                                                                
 * RAPPORT 3 - *                                                 *              
 ***************                                                                
 FILE W55190D6 VB(84 0) PRINTER                                                 
                                                                                
 *****************************************************************              
 *                                                               *              
 * JOB STEG 1  -  SORTERA SALDOFILER PER ART.NR OCH MATCHA       *              
 *                DESSA MOT WDK6-DATA SOM LÄGGS PÅ TPFIL3        *              
 *                                                               *              
 *****************************************************************              
                                                                                
 SORT W55190D3 TO TPFIL2 USING(D3-IDARTNR)  SIZE 900000                         
                                                                                
                                                                                
 JOB INPUT (W55190D7 KEY(LB-IDARTNR) TPFIL2 KEY(T2-IDARTNR)) +                  
                   START A-INIT                                                 
 IF TPFIL2                                                                      
   T3-KVDISP = T3-KVDISP +                                         +            
               T2-KVLS + T2-KVEFRS + T2-KVAKS + T2-KVAKS-PAV                    
 END-IF                                                                         
                                                                                
 IF MATCHED                                                                     
   IF LAST-DUP TPFIL2 OR NOT DUPLICATE TPFIL2                                   
     T3-IDARTNR    = LB-IDARTNR                                                 
     T3-IDLEVNR    = LB-IDLEVNR                                                 
     T3-PRARTSTD   = LB-PRARTSTD                                                
     T3-KDPRODSL   = LB-KDPRODSL                                                
     PUT TPFIL3                                                                 
     T3-KVDISP    = 0                                                           
   END-IF                                                                       
 ELSE                                                                           
   IF W55190D7                                                                  
     T3-IDARTNR    = LB-IDARTNR                                                 
     T3-IDLEVNR    = LB-IDLEVNR                                                 
     T3-PRARTSTD   = LB-PRARTSTD                                                
     T3-KDPRODSL   = LB-KDPRODSL                                                
     PUT TPFIL3                                                                 
     T3-KVDISP    = 0                                                           
   END-IF                                                                       
 END-IF                                                                         
                                                                                
 A-INIT. PROC                                                                   
   T3-KVDISP = 0                                                                
 END-PROC                                                                       
                                                                                
  ****************************************************************              
 *                                                               *              
 * JOB STEG 2  -  MATCHA ÅRSFIL MOT SUMMERAD SALDOFIL FÖR KOMPL  *              
 *                                                               *              
 *****************************************************************              
 JOB INPUT (W55190D1 KEY (ANA-IDARTNR)                         +                
            TPFIL3   KEY ( T3-IDARTNR))                                         
                                                                                
 IF MATCHED                                                                     
    T1-W551601         = ANA-W551601                                            
    T1-KVDISP-SPIS     = T3-KVDISP                                              
    PUT TPFIL1                                                                  
 ELSE                                                                           
   IF W55190D1                                                                  
     T1-W551601         = ANA-W551601                                           
     T1-KVDISP-SPIS     = 0                                                     
     PUT TPFIL1                                                                 
     DISPLAY '  EJ MATCHAD SPISART. ' ANA-IDARTNR ANA-KVDISP-SPIS               
   ELSE                                                                         
****  ARTIKLAR ENDAST PÅ LAGERBANDET OCH SOM EJ ÄR PRISÄNDRADE                  
     IF T3-KVDISP NE 0                                                          
       T1-W551601         = ' '                                                 
       T1-IDARTNR         = T3-IDARTNR                                          
       T1-IDLEVNR-HUV     = T3-IDLEVNR                                          
       T1-IDLEVNR         = ' '                                                 
       T1-KDVALISO        = '   '                                               
       T1-PRARTSTD-AKT    = T3-PRARTSTD                                         
       T1-PRARTSTD-KOM    = T3-PRARTSTD                                         
       T1-KDPRODSL        = T3-KDPRODSL                                         
       T1-KVDISP-SPIS     = T3-KVDISP                                           
       PUT TPFIL1                                                               
     END-IF                                                                     
   END-IF                                                                       
 END-IF                                                                         
                                                                                
 *****************************************************************              
 *                                                               *              
 * JOB STEG 2  -  MATCHA ÅRSFIL MOT SPIS-FIL                     *              
 *                                                               *              
 *****************************************************************              
 JOB INPUT (TPFIL1   KEY ( T1-IDARTNR )                          +              
            W55190D2 KEY (YEAR-IDARTNR ))                                       
                                                                                
 IF MATCHED                                                                     
   W-KDPRODSL  =  T1-KDPRODSL                                                   
                                                                                
   PERFORM A-KOLLA-OM-JFRBAR                                                    
                                                                                
   IF W-FL-JFRBAR = 'J'                                                         
     PERFORM B-JAMFORBARA                                                       
     PRINT RAPPORT01                                                            
     PRINT RAPPORT03                                                            
   ELSE                                                                         
     W-LAGERV-AKT-N   ROUNDED  = T1-PRARTSTD-AKT * T1-KVDISP-SPIS               
     W-LAGERV-KOM-N   ROUNDED  = T1-PRARTSTD-KOM * T1-KVDISP-SPIS               
     W-LAGERV-AKT-J            = +0                                             
     W-LAGERV-KOM-J            = +0                                             
     W-VALUTA-DIFF-J           = +0                                             
     W-BASPRIS-DIFF-J          = +0                                             
     W-KALKP-DIFF-J            = +0                                             
     W-HEMTAG-DIFF-J           = +0                                             
     PRINT RAPPORT01                                                            
     PRINT RAPPORT02                                                            
     PRINT RAPPORT03                                                            
   END-IF                                                                       
 ELSE                                                                           
   IF TPFIL1                                                                    
     W-KDPRODSL  =  T1-KDPRODSL                                                 
     W-FELTYP    = 'NY ARTIKEL'                                                 
                                                                                
     W-LAGERV-AKT-N   ROUNDED  = T1-PRARTSTD-AKT * T1-KVDISP-SPIS               
     W-LAGERV-KOM-N   ROUNDED  = T1-PRARTSTD-KOM * T1-KVDISP-SPIS               
     W-LAGERV-AKT-J            = +0                                             
     W-LAGERV-KOM-J            = +0                                             
     W-VALUTA-DIFF-J           = +0                                             
     W-BASPRIS-DIFF-J          = +0                                             
     W-KALKP-DIFF-J            = +0                                             
     W-HEMTAG-DIFF-J           = +0                                             
                                                                                
     PRINT RAPPORT01                                                            
     PRINT RAPPORT02                                                            
     PRINT RAPPORT03                                                            
   END-IF                                                                       
 END-IF                                                                         
                                                                                
 A-KOLLA-OM-JFRBAR. PROC                                                        
                                                                                
  W-FL-JFRBAR = 'J'                                                             
                                                                                
  IF T1-IDLEVNR-HUV NE '1002 '                                                  
   IF T1-KDVALISO EQ YEAR-KDVALISO                                              
     IF T1-IDLEVNR EQ YEAR-IDLEVNR                                              
       W-PRARTSTD-AKT  ROUNDED =   YEAR-PRINK       +           +               
                                   YEAR-PRDIRLON-BD +           +               
                                   YEAR-PRDMTRL-BD  +           +               
                                   YEAR-PROVRPAL-BD                             
       IF W-PRARTSTD-AKT  EQ T1-PRARTSTD-AKT                                    
         IF (T1-PRDIRLON-AKT EQ YEAR-PRDIRLON-BD) AND           +               
            (T1-PRDMTRL-AKT  EQ YEAR-PRDMTRL-BD)  AND           +               
            (T1-PROVRPAL-AKT EQ YEAR-PROVRPAL-BD)                               
                                                                                
           IF T1-PRARTBEL-PR GT +0 AND                          +               
              T1-PRKURS      GT +0 AND                          +               
              T1-RETULF      GT +0                                              
                                                                                
             IF YEAR-PRARTBEL GT +0                                             
               W-PRARTSTD-KOM  ROUNDED =   T1-PRINK-KOM     +   +               
                                           T1-PRDIRLON-KOM  +   +               
                                           T1-PRDMTRL-KOM   +   +               
                                           T1-PROVRPAL-KOM                      
               IF W-PRARTSTD-KOM  EQ T1-PRARTSTD-KOM                            
                 IF YEAR-PRKURS GT +0                                           
                   IF YEAR-RETULF EQ +0                                         
                     W-FL-JFRBAR = 'N'                                          
                     W-FELTYP = 'HTFAKT-1/1 = 0'                                
                   END-IF                                                       
                 ELSE                                                           
                   W-FL-JFRBAR = 'N'                                            
                   W-FELTYP = 'KURS-1/1 = 0'                                    
                 END-IF                                                         
               ELSE                                                             
                 W-FL-JFRBAR = 'N'                                              
                 W-FELTYP = 'STDPRIS-KOM NE STDPRIS-KOM'                        
               END-IF                                                           
             ELSE                                                               
               W-FL-JFRBAR = 'N'                                                
               W-FELTYP = 'PRIS-1/1 = 0'                                        
             END-IF                                                             
           ELSE                                                                 
             W-FL-JFRBAR = 'N'                                                  
             W-FELTYP = 'PRIS EL KURS EL HTFAKT=0'                              
           END-IF                                                               
         ELSE                                                                   
           W-FL-JFRBAR = 'N'                                                    
           W-FELTYP = 'PÅLÄGG-AKT NE PÅLÄGG-1/1'                                
         END-IF                                                                 
       ELSE                                                                     
         W-FL-JFRBAR = 'N'                                                      
         W-FELTYP = 'STDPRIS-AKT NE STDPRIS-1/1'                                
       END-IF                                                                   
     ELSE                                                                       
       W-FL-JFRBAR = 'N'                                                        
       W-FELTYP = 'BYTT LEVERANTÖR'                                             
     END-IF                                                                     
   ELSE                                                                         
     W-FL-JFRBAR = 'N'                                                          
     W-FELTYP = 'VALUTAN FÖRÄNDRAD'                                             
   END-IF                                                                       
  ELSE                                                                          
    W-FL-JFRBAR = 'N'                                                           
    W-FELTYP = 'SATS-ARTIKEL     '                                              
  END-IF                                                                        
                                                                                
 END-PROC.                                                                      
                                                                                
 B-JAMFORBARA. PROC                                                             
                                                                                
   W-LAGERV-AKT-N            = +0                                               
   W-LAGERV-KOM-N            = +0                                               
                                                                                
   W-PRARTSTD-AKT8 ROUNDED  = ( YEAR-PRARTBEL *             +                   
                                YEAR-PRKURS   *             +                   
                                YEAR-RETULF )    +          +                   
                                YEAR-PRDIRLON-BD +          +                   
                                YEAR-PRDMTRL-BD  +          +                   
                                YEAR-PROVRPAL-BD                                
                                                                                
   W-LAGERV-AKT-J   ROUNDED  = W-PRARTSTD-AKT8 * T1-KVDISP-SPIS                 
                                                                                
   W-PRARTSTD-KOM8  ROUNDED = ( T1-PRARTBEL-PR *            +                   
                                T1-PRKURS    *              +                   
                                T1-RETULF )      +          +                   
                                T1-PRDIRLON-KOM +           +                   
                                T1-PRDMTRL-KOM   +          +                   
                                T1-PROVRPAL-KOM                                 
                                                                                
   W-LAGERV-KOM-J   ROUNDED  = W-PRARTSTD-KOM8 * T1-KVDISP-SPIS                 
                                                                                
   W-VALUTA-DIFF    ROUNDED  =                              +                   
                  ((T1-PRKURS - YEAR-PRKURS)    *           +                   
                    T1-PRARTBEL-PR)             *           +                   
                    T1-KVDISP-SPIS                                              
                                                                                
   W-VALUTA-DIFF-J           = W-VALUTA-DIFF                                    
                                                                                
   W-BASPRIS-DIFF   ROUNDED  = (((T1-PRARTBEL-PR * T1-PRKURS) -       +         
                                 (YEAR-PRARTBEL   * YEAR-PRKURS)) *   +         
                                  T1-KVDISP-SPIS) - W-VALUTA-DIFF-J             
                                                                                
   W-BASPRIS-DIFF-J          = W-BASPRIS-DIFF                                   
                                                                                
                                                                                
   W-KALKP-AKT      ROUNDED  = T1-PRDIRLON-AKT +                      +         
                               T1-PRDMTRL-AKT   +                     +         
                               T1-PROVRPAL-AKT                                  
                                                                                
   W-KALKP-KOM      ROUNDED  = T1-PRDIRLON-KOM +                      +         
                               T1-PRDMTRL-KOM   +                     +         
                               T1-PROVRPAL-KOM                                  
                                                                                
   W-KALKP-DIFF     ROUNDED  = (W-KALKP-KOM   - W-KALKP-AKT  )  *     +         
                                T1-KVDISP-SPIS                                  
                                                                                
   W-KALKP-DIFF-J            = W-KALKP-DIFF                                     
                                                                                
 ***                                                                            
 *** RÄKNAR UT HEMTAGNINGS-DIFFEN BIT FÖR BIT FÖR ATT UNDVIKA DEC-FEL           
 ***                                                                            
                                                                                
   W-A ROUNDED =   (T1-RETULF * T1-PRARTBEL-PR * T1-PRKURS)                     
   W-B ROUNDED =   (YEAR-RETULF * YEAR-PRARTBEL  * YEAR-PRKURS)                 
   W-C ROUNDED =   (T1-PRARTBEL-PR * T1-PRKURS)                                 
   W-D ROUNDED =   (YEAR-PRARTBEL * YEAR-PRKURS)                                
                                                                                
   W-HEMTAG-DIFF ROUNDED =                                            +         
               (((W-A - W-B)) - (W-C - W-D))* T1-KVDISP-SPIS                    
                                                                                
   W-HEMTAG-DIFF-J           =  W-HEMTAG-DIFF                                   
                                                                                
 END-PROC                                                                       
                                                                                
 *****************************************************************              
 *                                                               *              
 * RAPPORTBESKRIVNING 1 - ANALYS NYA STANDARDPRISER              *              
 *                                                               *              
 *****************************************************************              
 REPORT    RAPPORT01                                             +              
           PRINTER W55190D4                                      +              
           LINESIZE  79                                          +              
           NOADJUST                                              +              
           NOHEADING                                             +              
           NODATE                                                +              
           SPACE 1                                               +              
           SUMCTL DTLCOPY                                        +              
           SUMSPACE 2                                            +              
           SUMMARY                                                              
                                                                                
 SEQUENCE  W-KDPRODSL                                                           
                                                                                
 CONTROL   FINAL      NOPRINT                                    +              
           W-KDPRODSL NEWPAGE                                                   
                                                                                
 TITLE 01  COL   1 'VOLVO CAR PARTS'                             +              
           COL  25 'W55190-001'                                  +              
           COL  58  SYSDATE                                                     
                                                                                
 TITLE 03  COL   1 'A N A L Y S    NYA STANDARDPRISER   S P I S' +              
           COL  63 'PRODUKTSLAG : ' W-KDPRODSL                                  
                                                                                
 LINE   1  COL   1 '========================================'    +              
           COL  40 '========================================'                   
 LINE   2  COL   3 'JÄMFÖRBARA ARTIKLAR'                         +              
           COL  46 'VÄRDE TKR'                                   +              
           COL  60 '%-ENHETER'                                                  
 LINE   3  COL   1 '========================================'    +              
           COL  40 '========================================'                   
 LINE   5  COL   1 'LAGERVÄRDE TILL ÅRETS STANDARD PRIS'         +              
           COL  40  W-LAGERV-AKT-J                                              
 LINE   7  COL   1 '- BASPRISER '                                +              
           COL  40  W-BASPRIS-DIFF-J                             +              
           COL  60  S-BASPRIS-PROC-J                                            
 LINE   8  COL   1 '- VALUTAKURSER'                              +              
           COL  40  W-VALUTA-DIFF-J                              +              
           COL  60  S-VALUTA-PROC-J                                             
 LINE   9  COL   1 '- HEMTAGNINGSFAKTOR'                         +              
           COL  40  W-HEMTAG-DIFF-J                              +              
           COL  60  S-HEMTAG-PROC-J                                             
 LINE  10  COL   1 '- KALKYLPÅLÄGG'                              +              
           COL  42  W-KALKP-DIFF-J                               +              
           COL  60  S-KALKP-PROC-J                                              
 LINE  11  COL  38 '-----------------'                           +              
           COL  57 '------------'                                               
 LINE  12  COL  23 'SUMMA DIFF'                                  +              
           COL  40  S-SUMMA-DIFF-J                               +              
           COL  60  S-SUMMA-PROC-J                                              
 LINE  14  COL   1 'LAGERVÄRDE TILL NYTT STANDARD PRIS'          +              
           COL  40  W-LAGERV-KOM-J                                              
 LINE  17  COL   1 '========================================'    +              
           COL  40 '========================================'                   
 LINE  18  COL   3 'EJ JÄMFÖRBARA ARTIKLAR'                      +              
           COL  46 'VÄRDE TKR'                                                  
 LINE  19  COL   1 '========================================'    +              
           COL  40 '========================================'                   
 LINE  21  COL   1 'LAGERVÄRDE TILL ÅRETS STANDARD PRIS'         +              
           COL  40  W-LAGERV-AKT-N                                              
 LINE  22  COL   1 'LAGERVÄRDE TILL NYTT STANDARD PRIS'          +              
           COL  40  W-LAGERV-KOM-N                                              
 LINE  23  COL  38 '-----------------'                                          
 LINE  24  COL  23 'DIFF LAGERVÄRDE'                             +              
           COL  40  S-LAGERV-DIFF-N                                             
 LINE  27  COL   1 '========================================'    +              
           COL  40 '========================================'                   
 LINE  28  COL   3 'TOTALT'                                      +              
           COL  46 'VÄRDE TKR'                                   +              
           COL  60 '%-ENHETER'                                                  
 LINE  29  COL   1 '========================================'    +              
           COL  40 '========================================'                   
 LINE  31  COL   1 'LAGERVÄRDE TILL ÅRETS STANDARD PRIS'         +              
           COL  40  S-LAGERV-AKT-TOT                                            
 LINE  32  COL   1 'LAGERVÄRDE TILL NYTT STANDARD PRIS'          +              
           COL  40  S-LAGERV-KOM-TOT                                            
 LINE  33  COL  38 '-----------------'                           +              
           COL  57 '------------'                                               
 LINE  34  COL  23 'DIFF LAGERVÄRDE'                             +              
           COL  40  S-LAGERV-DIFF-TOT                            +              
           COL  60  S-LAGERV-PROC-TOT                                           
                                                                                
 BEFORE-BREAK. PROC                                                             
                                                                                
   S-BASPRIS-PROC-J ROUNDED  =                                   +              
                   (W-BASPRIS-DIFF-J / W-LAGERV-AKT-J) * 100                    
   S-VALUTA-PROC-J  ROUNDED  =                                   +              
                   (W-VALUTA-DIFF-J  / W-LAGERV-AKT-J) * 100                    
   S-HEMTAG-PROC-J  ROUNDED  =                                   +              
                   (W-HEMTAG-DIFF-J  / W-LAGERV-AKT-J) * 100                    
   S-KALKP-PROC-J   ROUNDED  =                                   +              
                   (W-KALKP-DIFF-J   / W-LAGERV-AKT-J) * 100                    
                                                                                
   S-SUMMA-PROC-J   = S-BASPRIS-PROC-J + S-VALUTA-PROC-J +       +              
                      S-HEMTAG-PROC-J  + S-KALKP-PROC-J                         
                                                                                
   S-SUMMA-DIFF-J   = W-BASPRIS-DIFF-J + W-VALUTA-DIFF-J +       +              
                      W-HEMTAG-DIFF-J  + W-KALKP-DIFF-J                         
                                                                                
   S-SUMMA-DIFF-J ROUNDED  = ( S-SUMMA-DIFF-J    / 1000000)                     
                                                                                
   S-LAGERV-DIFF-N   =   W-LAGERV-KOM-N - W-LAGERV-AKT-N                        
   S-LAGERV-DIFF-N   = ( S-LAGERV-DIFF-N  / 1000000)                            
                                                                                
   S-LAGERV-AKT-TOT  = W-LAGERV-AKT-J  +                         +              
                       W-LAGERV-AKT-N  +                                        
                                                                                
   S-LAGERV-KOM-TOT  = W-LAGERV-KOM-J  +                         +              
                       W-LAGERV-KOM-N  +                                        
                                                                                
   S-LAGERV-DIFF-TOT =  S-LAGERV-KOM-TOT - S-LAGERV-AKT-TOT                     
   S-LAGERV-PROC-TOT = (S-LAGERV-DIFF-TOT / S-LAGERV-AKT-TOT) * 100             
                                                                                
   S-LAGERV-AKT-TOT  ROUNDED = ( S-LAGERV-AKT-TOT  / 1000000)                   
   S-LAGERV-KOM-TOT  ROUNDED = ( S-LAGERV-KOM-TOT  / 1000000)                   
   S-LAGERV-DIFF-TOT ROUNDED = ( S-LAGERV-DIFF-TOT / 1000000)                   
                                                                                
 ****************** GÖR OM TILL TKR *******************                         
                                                                                
   W-LAGERV-AKT-J   ROUNDED =   ( W-LAGERV-AKT-J     / 1000000)                 
   W-BASPRIS-DIFF-J ROUNDED =   ( W-BASPRIS-DIFF-J   / 1000000)                 
   W-VALUTA-DIFF-J  ROUNDED =   ( W-VALUTA-DIFF-J    / 1000000)                 
   W-HEMTAG-DIFF-J  ROUNDED =   ( W-HEMTAG-DIFF-J    / 1000000)                 
   W-KALKP-DIFF-J   ROUNDED =   ( W-KALKP-DIFF-J     / 1000000)                 
   W-LAGERV-KOM-J   ROUNDED =   ( W-LAGERV-KOM-J     / 1000000)                 
   W-LAGERV-AKT-N   ROUNDED =   ( W-LAGERV-AKT-N     / 1000000)                 
   W-LAGERV-KOM-N   ROUNDED =   ( W-LAGERV-KOM-N     / 1000000)                 
 END-PROC                                                                       
                                                                                
