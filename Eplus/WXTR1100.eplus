*  FÖRFATTARE :  STEFANO GIOBBI                                        *        
*                                                                      *        
*  DATUM      :  940829                                                *        
*                                                                      *        
*  FUNKTION   :  PROGRAMMET INGÅR I VCAS UPPFÖLJNINGSMILJÖ.            *        
*                PROGRAMMET TAR IN EN FIL SOM INNEHÅLLER VECKANS       *        
*                FYSISKA AVVIKELSER MM.                                *        
*                I PROCEDUREN TAS ENDAST DE POSTER MED SOM HAR         *        
*                REFYSAVV > 0 MED MHA DFSORT.                          *        
*                UT SKAPAS ETT REGISTER SOM INNEHÅLLER VECKA SAMT      *        
*                HUR MÅNGA FYSAVVIKELSER SOM FANNS DEN VECKAN MÄTT     *        
*                I RADER.                                              *        
*                                                                      *        
*                PROGRAMMET SKAPAR FIL                                 *        
*                  WXTRB5 SUMMAPOST/VECKA                              *        
*                                                                      *        
*  ÄNDRING    :                                                        *        
*                                                                      *        
*     DATUM       NAMN                     AVDELNING                   *        
*     ......      ..................       ......                      *        
*     ......      ..................       ......                      *        
*                                                                      *        
*----------------------------------------------------------------------*        
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    FILE SECTION                                *              
*----------------------------------------------------------------*              
*                                                                               
FILE WXTR11D1                                                                   
*     VECKANS FYSAVVIKELSER MM                                                  
%W225P232     'IN-'                                                             
*                                                                               
NEWPAGE                                                                         
*                                                                               
FILE WXTR11D2   FB (10 27990)                                                   
*     VECKANS FYSAVVIKELSER I RADER PER VECKA                                   
  UT-TIVECKA           1 4 N 0                                                  
  UT-KVFARAD           5 6 N 0                                                  
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    WORKING STORAGE                             *              
*----------------------------------------------------------------*              
*                                                                               
  JA                        W   1 A   VALUE 'J'                                 
  NEJ                       W   1 A   VALUE 'N'                                 
  NOT-OK                    W   1 A   VALUE 'F'                                 
*                                                                               
  ACK-VALUE                 W   9 P 2 VALUE  0                                  
*                                                                               
  SPAR-IDDISTR              W   3 P 0 VALUE  0                                  
  SPAR-TIVECKA-ALFA         W   4 A                                             
    SPAR-TIVECKA            W   4 N 0                                           
*                                                                               
  ACK-FYSAVV                W   4 P 0 VALUE  0                                  
*                                                                               
NEWPAGE                                                                         
*                                                                               
*        PARAMETRAR TILL WDATKONV                                               
%WDATAREA                                                                       
                                                                                
*    -- CHECKED BY WY2000                                                       
*                                                                               
NEWPAGE                                                                         
*                                                                               
*----------------------------------------------------------------*              
*                    JOB SECTION                                 *              
*----------------------------------------------------------------*              
*                                                                               
  JOB INPUT  WXTR11D1                                            +              
                                                 START  A-INIT   +              
                                                 FINISH Z-FINIT  +              
                                                 NAME   STEG01                  
    ACK-FYSAVV = ACK-FYSAVV + 1                                                 
                                                                                
NEWPAGE                                                                         
                                                                                
  A-INIT.  PROC                                                                 
                                                                                
    DAT-KDDATFORM = 'IDAG  '                                                    
                                                                                
    CALL WDATKONV USING (DAT-KDDATFORM                           +              
                         DAT-I-TIDATUM                           +              
                         DAT-O-TIDATUM                           +              
                         DAT-KDSVAR   )                                         
                                                                                
    IF DAT-KDSVAR = NOT-OK                                                      
      DISPLAY '   '                                                             
      DISPLAY '   '                                                             
      DISPLAY '   '                                                             
      DISPLAY '   ---   KONVERTERING AV DAGENS DATUM MISSLYCKADES   ---'        
      DISPLAY '   '                                                             
      DISPLAY '   '                                                             
      DISPLAY '   '                                                             
      RETURN-CODE = 16                                                          
      STOP EXECUTE                                                              
    END-IF                                                                      
                                                                                
    SPAR-TIVECKA-ALFA = DAT-TIAAVV-GRP                                          
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
                                                                                
  Z-FINIT.  PROC                                                                
                                                                                
    UT-TIVECKA = SPAR-TIVECKA                                                   
    UT-KVFARAD = ACK-FYSAVV                                                     
    PUT WXTR11D2                                                                
                                                                                
  END-PROC                                                                      
                                                                                
NEWPAGE                                                                         
