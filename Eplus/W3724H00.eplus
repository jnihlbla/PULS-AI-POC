SUM W-SUM7                                                                      
                                                                                
TITLE 1  COL 01 W-UT-FIX-US   +                                                 
         COL 11 'W3724H-061 ' +                                                 
         COL 22 'WEEKLY FOLLOWING-UP WARRANTY-REPORTS DC 61         ' +         
         COL 108     W-PAGE                                                     
                                                                                
TITLE 2  COL 01 'DISTRICT  '          +                                         
         COL 16 'CUSTOMER'            +                                         
         COL 27 'CASE REPORT'         +                                         
         COL 40 'CORE PART'           +                                         
         COL 51 'QUANTITY'            +                                         
                                                                                
LINE  1  COL 04  W-IDDISTR            +                                         
         COL 17  W-IDKUNDNR           +                                         
         COL 31  W-IDBYTRAP           +                                         
         COL 40  W-IDARTNR            +                                         
         COL 52  W-KVRETUR            +                                         
                                                                                
  BEFORE-BREAK. PROC                                                            
    IF LEVEL = 1                                                                
       DISPLAY ' '                                                              
