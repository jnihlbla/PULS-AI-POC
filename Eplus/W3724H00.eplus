*                                                               *               
*****************************************************************               
                                                                                
FILE W3724HD6 PRINTER FB (121 0)                                                
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* COPYTEXT TILL SUBPGM WDATKORT                                 *               
*                                                               *               
*****************************************************************               
                                                                                
%WDATKORT                                                                       
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* HOST VARIABLER                                                *               
*                                                               *               
*****************************************************************               
                                                                                
W-PAGE       W  10  A    VALUE '  PAGE  '                                       
W-SIDA       W  10  A    VALUE '  SIDA  '                                       
W-PGMNAMN    W  6   A    VALUE 'W3724H'                                         
W-WDATUM     W  6   A    VALUE '000001'                                         
                                                                                
  W-DATUM          W  6   N                                                     
  W-MM   W-DATUM       2  N                                                     
  W-DD   W-DATUM   +2  2  N                                                     
  W-AAR  W-DATUM   +4  2  N                                                     
                                                                                
W-IDDC            W   2  A                                                      
W-IDDISTR         W   5  N MASK 'ZZZZ9'.                                        
W-IDKUNDNR        W   7  N MASK 'ZZZZZZ9'.                                      
W-IDBYTRAP        W   7  N MASK 'ZZZZZZ9'.                                      
W-IDARTNR         W   9  N MASK 'ZZZZZZZZ9'.                                    
W-KVRETUR         W   7  N MASK 'ZZZZZZ9'.                                      
W-UT-FIX-SE       W   8  A                                                      
W-UT-FIX-1-SE W-UT-FIX-SE    2  A                                               
W-UT-FIX-2-SE W-UT-FIX-SE +2 1  A                                               
W-UT-FIX-3-SE W-UT-FIX-SE +3 2  A                                               
W-UT-FIX-4-SE W-UT-FIX-SE +5 1  A                                               
W-UT-FIX-5-SE W-UT-FIX-SE +6 2  A                                               
W-UT-FIX-US       W   8  A                                                      
W-UT-FIX-1-US W-UT-FIX-US    2  A                                               
W-UT-FIX-2-US W-UT-FIX-US +2 1  A                                               
W-UT-FIX-3-US W-UT-FIX-US +3 2  A                                               
W-UT-FIX-4-US W-UT-FIX-US +5 1  A                                               
W-UT-FIX-5-US W-UT-FIX-US +6 2  A                                               
W-UT-FIX-GB       W   8  A                                                      
W-UT-FIX-1-GB W-UT-FIX-GB    2  A                                               
W-UT-FIX-2-GB W-UT-FIX-GB +2 1  A                                               
W-UT-FIX-3-GB W-UT-FIX-GB +3 2  A                                               
W-UT-FIX-4-GB W-UT-FIX-GB +5 1  A                                               
W-UT-FIX-5-GB W-UT-FIX-GB +6 2  A                                               
W-SUM             W   4 P 0 MASK 'ZZZZZZ9'                                      
W-SUM2            W   4 P 0 MASK 'ZZZZZZ9'                                      
W-SUM3            W   4 P 0 MASK 'ZZZZZZ9'                                      
W-SUM4            W   4 P 0 MASK 'ZZZZZZ9'                                      
W-SUM5            W   4 P 0 MASK 'ZZZZZZ9'                                      
W-SUM6            W   4 P 0 MASK 'ZZZZZZ9'                                      
W-SUM7            W   4 P 0 MASK 'ZZZZZZ9'                                      
W-SUM8            W   4 P 0 MASK 'ZZZZZZ9'                                      
W-SUM9            W   4 P 0 MASK 'ZZZZZZ9'                                      
                                                                                
*    --- VALID IDDC CODES                                                       
*                                                                               
%WWDC99                                                                         
*                                                                               
*    -- CHECKED BY WY2000                                                       
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* STEG 2  SORTERA BYTESFILEN PER IDDC IDDISTR IDBYTRAP          *               
*                                                               *               
*****************************************************************               
                                                                                
SORT W3724HD1 TO TPFIL1 USING (IN4F-IDDC IN4F-IDDISTR    +                      
                 IN4F-IDKUNDNR IN4F-IDBYTRAP IN4F-IDARTNR-OBJ)                  
                                                                                
NEWPAGE                                                                         
*****************************************************************               
*                                                               *               
* STEG 4  LÄSER TPFIL1                                          *               
*                                                               *               
*****************************************************************               
                                                                                
                                                                                
JOB INPUT(TPFIL1) START INIT-PROC                                               
                                                                                
    W-UT-FIX-1-SE   = W-AAR                                                     
    W-UT-FIX-2-SE   = '-'                                                       
    W-UT-FIX-3-SE   = W-MM                                                      
    W-UT-FIX-4-SE   = '-'                                                       
    W-UT-FIX-5-SE   = W-DD                                                      
    W-UT-FIX-1-GB   = W-DD                                                      
    W-UT-FIX-2-GB   = '-'                                                       
    W-UT-FIX-3-GB   = W-MM                                                      
    W-UT-FIX-4-GB   = '-'                                                       
    W-UT-FIX-5-GB   = W-AAR                                                     
    W-UT-FIX-1-US   = W-MM                                                      
    W-UT-FIX-2-US   = '-'                                                       
    W-UT-FIX-3-US   = W-DD                                                      
    W-UT-FIX-4-US   = '-'                                                       
    W-UT-FIX-5-US   = W-AAR                                                     
    IF T4F-IDDC = CDC-SE                                                        
       W-IDDISTR     = T4F-IDDISTR                                              
       W-IDKUNDNR    = T4F-IDKUNDNR                                             
       W-IDBYTRAP    = T4F-IDBYTRAP                                             
       W-IDARTNR     = T4F-IDARTNR-OBJ                                          
       W-KVRETUR     = T4F-KVRETUR                                              
       W-SUM         = W-KVRETUR                                                
       PRINT LISTA11                                                            
    END-IF                                                                      
    IF T4F-IDDC = NDC-US-RU                                                     
       W-IDDISTR     = T4F-IDDISTR                                              
       W-IDKUNDNR    = T4F-IDKUNDNR                                             
       W-IDBYTRAP    = T4F-IDBYTRAP                                             
       W-IDARTNR     = T4F-IDARTNR-OBJ                                          
       W-KVRETUR     = T4F-KVRETUR                                              
       W-SUM3        = W-KVRETUR                                                
       W-SUM4        = W-KVRETUR                                                
       PRINT LISTA41                                                            
    END-IF                                                                      
    IF T4F-IDDC = NDC-JP                                                        
       W-IDDISTR     = T4F-IDDISTR                                              
       W-IDKUNDNR    = T4F-IDKUNDNR                                             
       W-IDBYTRAP    = T4F-IDBYTRAP                                             
       W-IDARTNR     = T4F-IDARTNR-OBJ                                          
       W-KVRETUR     = T4F-KVRETUR                                              
       W-SUM6        = W-KVRETUR                                                
       W-SUM7        = W-KVRETUR                                                
       PRINT LISTA61                                                            
    END-IF                                                                      
    IF T4F-IDDC = NDC-AU                                                        
       W-IDDISTR     = T4F-IDDISTR                                              
       W-IDKUNDNR    = T4F-IDKUNDNR                                             
       W-IDBYTRAP    = T4F-IDBYTRAP                                             
       W-IDARTNR     = T4F-IDARTNR-OBJ                                          
       W-KVRETUR     = T4F-KVRETUR                                              
       W-SUM8        = W-KVRETUR                                                
       W-SUM9        = W-KVRETUR                                                
       PRINT LISTA62                                                            
    END-IF                                                                      
  PRINT LISTA2                                                                  
NEWPAGE                                                                         
INIT-PROC. PROC                                                                 
    CALL DATKORT USING (W-PGMNAMN W-WDATUM DATUMKORT)                           
    W-AAR  = D-AAR                                                              
    W-MM   = D-MAANAD                                                           
    W-DD   = D-DAG                                                              
                                                                                
END-PROC                                                                        
NEWPAGE                                                                         
                                                                                
  REPORT LISTA11                +                                               
         PRINTER W3724HD2       +                                               
         PAGESIZE 41            +                                               
         LINESIZE 120           +                                               
         SPACE 1                +                                               
         TITLESKIP 1            +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NOADJUST               +                                               
         NODATE                 +                                               
         SUMCTL                 +                                               
         DTLCOPY                +                                               
         SUMMARY                                                                
                                                                                
                                                                                
SEQUENCE W-IDDISTR W-IDKUNDNR W-IDBYTRAP                                        
                                                                                
CONTROL W-IDDISTR W-IDKUNDNR                                                    
                                                                                
SUM W-SUM                                                                       
                                                                                
TITLE 1  COL 01 W-UT-FIX-SE   +                                                 
         COL 11 'W3724H-011 ' +                                                 
         COL 22 'UPPFÖLNING PÅ GARANTIRAPPORTER I STATUS 4' +                   
         COL 108     W-SIDA                                                     
                                                                                
TITLE 2  COL 01 'DISTRIKT'            +                                         
         COL 15 'KUND'                +                                         
         COL 24 'RAPPORT'             +                                         
         COL 35 'ANTAL ARTIKLAR'      +                                         
                                                                                
LINE  1  COL 04  W-IDDISTR            +                                         
         COL 15  W-IDKUNDNR           +                                         
         COL 24  W-IDBYTRAP           +                                         
         COL 35  W-SUM                +                                         
                                                                                
                                                                                
  REPORT LISTA41                +                                               
         PRINTER W3724HD3       +                                               
         PAGESIZE 41            +                                               
         LINESIZE 120           +                                               
         SPACE 1                +                                               
         TITLESKIP 1            +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NOADJUST               +                                               
         NODATE                                                                 
                                                                                
                                                                                
                                                                                
                                                                                
SEQUENCE W-IDDISTR W-IDKUNDNR W-IDBYTRAP W-IDARTNR                              
                                                                                
CONTROL FINAL NOPRINT W-IDDISTR NOPRINT W-IDKUNDNR NOPRINT                      
                                                                                
SUM W-SUM3                                                                      
                                                                                
TITLE 1  COL 01 W-UT-FIX-US   +                                                 
         COL 11 'W3724H-041 ' +                                                 
         COL 22 'WEEKLY FOLLOWING-UP WARRANTY-REPORTS TO TMA        ' +         
         COL 108     W-PAGE                                                     
                                                                                
TITLE 2  COL 01 'DISTRICT  '          +                                         
         COL 16 'CUSTOMER'            +                                         
         COL 27 'CASE REPORT'         +                                         
         COL 40 'CORE PART'           +                                         
         COL 51 'QUANTITY'            +                                         
                                                                                
LINE  1  COL 04  W-IDDISTR            +                                         
         COL 17  W-IDKUNDNR           +                                         
         COL 31  W-IDBYTRAP           +                                         
         COL 40  W-IDARTNR            +                                         
         COL 52  W-KVRETUR            +                                         
                                                                                
  BEFORE-BREAK. PROC                                                            
    IF LEVEL = 1                                                                
       DISPLAY ' '                                                              
       DISPLAY COL 49 W-SUM3                                                    
       DISPLAY ' '                                                              
    END-IF                                                                      
  END-PROC                                                                      
                                                                                
  REPORT LISTA2                 +                                               
         PRINTER W3724HD4       +                                               
         PAGESIZE 41            +                                               
         LINESIZE 120           +                                               
         SPACE 1                +                                               
         TITLESKIP 1            +                                               
         NOHEADING              +                                               
         NOSPREAD               +                                               
         NOADJUST               +                                               
