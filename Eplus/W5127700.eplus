*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W5127700                                              *        
*                                                                      *        
*  FUNCTION   :  CREATES SCRAP REPORT                                  *        
*                                                                      *        
*  AUTHOR     :  SARASWATHY S                                          *        
*                                                                      *        
*----------------------------------------------------------------------*        
NEWPAGE                                                                         
FILE W51277D1                                                                   
*                                                                               
%W01160  'IN1-'                                                                 
*                                                                               
FILE W51277D2                                                                   
*                                                                               
%W21611  'IN2-'                                                                 
*                                                                               
FILE W51277D3  PRINTER VB (285 0)                                               
                                                                                
UT-IDDC               W 2  A                                                    
UT-SCRAP-DATE         W 8  N                                                    
UT-IDARTNR            W 9  N        MASK  'ZZZZZZZZ9'    VALUE 0                
UT-KDPRODSL           W 3  N        MASK  'ZZ9'          VALUE 0                
UT-KDERS              W 2  N        MASK  'Z9'           VALUE 0                
UT-IDDISTR            W 4  N        MASK  'ZZZ9'         VALUE 0                
UT-IDKUNDNR           W 6  N        MASK  'ZZZZZ9'       VALUE 0                
UT-SCRAP-QTY          W 9  N        MASK  'ZZZZZZZZ9'    VALUE 0                
UT-PRARTSTD           W 11 N      2 MASK  'ZZZZZZZZ9.99' VALUE 0                
UT-SCRAP-VAL          W 11 N      2 MASK  'ZZZZZZZZ9.99' VALUE 0                
UT-IDUSER             W 8  A                                                    
UT-DESC               W 25 A                                                    
UT-SCRAP-REASON1      W 66 A                                                    
UT-SCRAP-REASON2      W 66 A                                                    
UT-SEM1               W 1  A                             VALUE ';'              
*                                                                               
*******************************************************************             
*   WORKING STORAGE SECTION                                       *             
*******************************************************************             
SW-FIRST         S   1   A                           VALUE 'J'                  
JA               W   1   A                           VALUE 'J'                  
NEJ              W   1   A                           VALUE 'N'                  
*                                                                               
NEWPAGE                                                                         
*-----------------------------------------------------------------*             
* STEP 1. MATCH W01160 AND W21611                                               
*-----------------------------------------------------------------*             
JOB INPUT (W51277D1 KEY (IN1-CLAG-IDARTNR)   +                                  
           W51277D2 KEY (IN2-IDARTNR))                                          
IF MATCHED                                                                      
   UT-IDDC         =    IN2-IDDC                                                
   UT-SCRAP-DATE   =    99999999 - IN2-DASKROT9-BEORD                           
   UT-IDARTNR      =    IN2-IDARTNR                                             
   UT-KDPRODSL     =    IN1-CLAG-KDPRODSL                                       
   UT-KDERS        =    IN1-CLAG-KDERS                                          
   UT-IDDISTR      =    IN2-IDDISTR                                             
   UT-IDKUNDNR     =    IN2-IDKUNDNR                                            
   UT-SCRAP-QTY    =    IN2-KVSKROT-BEORD                                       
   UT-PRARTSTD     =    IN1-CLAG-PRARTSTD                                       
   UT-SCRAP-VAL    =    IN2-KVSKROT-BEORD * IN1-CLAG-PRARTSTD                   
   UT-IDUSER       =    IN2-IDUSER                                              
   UT-DESC         =    IN2-BEANST                                              
   IF IN2-TEMEMO(1) NOT SPACES                                                  
      UT-SCRAP-REASON1 = IN2-TEMEMO(1)                                          
   END-IF                                                                       
   IF IN2-TEMEMO(2) NOT SPACES                                                  
      UT-SCRAP-REASON2 = IN2-TEMEMO(2)                                          
   END-IF                                                                       
   PRINT REPORT1                                                                
END-IF                                                                          
*-----------------------------------------------------------------*             
*     REPORT  W51277-001                                                        
*-----------------------------------------------------------------*             
  REPORT    REPORT1             +                                               
            PRINTER   W51277D3  +                                               
            LINESIZE  244       +                                               
            PAGESIZE  32767     +                                               
            NOHEADING           +                                               
            SPACE     0         +                                               
            SKIP      0         +                                               
            TITLESKIP 0         +                                               
            NOADJUST            +                                               
            NOSPREAD                                                            
*                                                                               
LINE 01                         +                                               
        UT-IDDC        +                                                        
        UT-SEM1        +                                                        
        UT-SCRAP-DATE  +                                                        
        UT-SEM1        +                                                        
        UT-IDARTNR     +                                                        
        UT-SEM1        +                                                        
        UT-KDPRODSL    +                                                        
        UT-SEM1        +                                                        
        UT-KDERS       +                                                        
        UT-SEM1        +                                                        
        UT-IDDISTR     +                                                        
        UT-SEM1        +                                                        
        UT-IDKUNDNR    +                                                        
        UT-SEM1        +                                                        
        UT-SCRAP-QTY   +                                                        
        UT-SEM1        +                                                        
        UT-PRARTSTD    +                                                        
        UT-SEM1        +                                                        
        UT-SCRAP-VAL   +                                                        
        UT-SEM1        +                                                        
        UT-IDUSER      +                                                        
        UT-SEM1        +                                                        
        UT-DESC        +                                                        
        UT-SEM1        +                                                        
        UT-SCRAP-REASON1 +                                                      
        UT-SCRAP-REASON2                                                        
*                                                                               
BEFORE-LINE. PROC                                                               
IF SW-FIRST = JA                                                                
 DISPLAY '¤DAPW51277-001'                                                       
 DISPLAY '¤DAPW51277'                                                           
 DISPLAY 'DC;SCRAP DATE;PART NO;PRODUCT GROUP;SUPERSESSION CODE;'  +            
         'DISTRICT NUMBER;CUSTOMER NUMBER;'  +                                  
         'SCRAP QUANTITY;STANDART PRICE;SCRAP VALUE;USER;' +                    
         'NAME;SCRAP REASON'                                                    
 SW-FIRST = NEJ                                                                 
END-IF                                                                          
END-PROC                                                                        
