                                                                                
************************************************************************        
*                                                                      *        
*   PROGRAM:     W22552                                                *        
*                                                                      *        
*   FÖRFATTARE:  JOHAN LINDKVIST                                       *        
*                                                                      *        
*   FUNKTION:    LISTAR SERVICEGRAD PER VENDOR                         *        
*                                                                      *        
*   INPUT:       W231.W231V3.W23195                                    *        
*                                                                      *        
*   OUTPUT:      LISTA                                                 *        
*                                                                      *        
*  ÄNDRING:    97-11-25   FLYTT AV FELAKTIG END-IF I AFTERBREAK SEKTION*        
*                                                                      *        
*  RAHUL JAIN  11-10-26   INKOM KINA DC'ER. ISTÄLLET FÖR ATT ANVÄNDA   *        
*              FLERA RAPPORT, ANVÄNDER DET NU BARA EN RAPPORT.         *        
*                                                                      *        
************************************************************************        
FILE W22552D1                                                                   
%W23195 'INP-'                                                                  
*                                                                               
FILE SORTFIL1 FB (792 0)                                                        
%W23195                                                                         
*                                                                               
FILE W22552D2 PRINTER VB (125 0)                                                
*                                                                               
SERVGN   W  3 P 1                                                               
SERVGB   W  3 P 1                                                               
*                                                                               
VENDOR   W  5  A                                                                
AVBOK    W  7  P 2 MASK (BWZ)                                                   
INKOMM   W  7  P 0 MASK (BWZ)                                                   
FYSAVV   W  7  P 2 MASK (BWZ)                                                   
DC02-IDDC  W  2  A VALUE 'XX'.                                                  
*                                                                               
SYS-NAMN   W  18 A                                                              
DC-TXT     W  10 A                                                              
LOC-TXT    W  14 A                                                              
PREV-IDDC  W   2 A VALUE 'XX'                                                   
FIRST-PASS W   1 A VALUE 'Y'                                                    
WS-NDC-US  W   2 A VALUE '40'                                                   
*                                                                               
%WWDC99                                                                         
*                                                                               
SORT W22552D1 TO SORTFIL1 USING (INP-IDDC INP-IDLEVNR)                          
*                                                                               
JOB INPUT SORTFIL1                                                              
VENDOR   = IDLEVNR                                                              
AVBOK    = SUAVBRP                                                              
INKOMM   = SUINKORD                                                             
FYSAVV   = SUFYSAVP                                                             
                                                                                
PREV-IDDC  = DC02-IDDC                                                          
DC02-IDDC  = IDDC                                                               
                                                                                
PERFORM S23-CHECK-DC02-IDDC                                                     
                                                                                
IF DC02-IDDC = NDC-US                                                           
   DC02-IDDC = WS-NDC-US                                                        
   IDDC      = WS-NDC-US                                                        
END-IF                                                                          
                                                                                
DC-TXT   = 'W22552'                                                             
SYS-NAMN = 'PARTS             '                                                 
                                                                                
IF FIRST-PASS = 'Y'                                                             
 DISPLAY W22552D2 '¤DAP' DC-TXT                                                 
 DISPLAY W22552D2 '¤DAP' DC02-IDDC                                              
 FIRST-PASS = 'N'                                                               
END-IF                                                                          
                                                                                
PRINT RAPPORT01                                                                 
                                                                                
NEWPAGE                                                                         
*    --- S23-CHECK-DC02-IDDC (MACRO PROCEDURE)                                  
%WWDC02 'DC02-'                                                                 
*                                                                               
*************** START OF REPORTS FOR DC'S ******************                    
                                                                                
REPORT RAPPORT01  SUMMARY +                                                     
       PRINTER W22552D2 LINESIZE 120 SPACE 2 NOADJUST                           
SEQUENCE IDDC VENDOR                                                            
CONTROL  FINAL NOPRINT IDDC NEWPAGE VENDOR                                      
TITLE 1  COL 12 'VOLVO CAR' SYS-NAMN DC-TXT                                     
TITLE 2  COL 12 'LISTING OF SERVICE PER VENDOR         DC' DC02-IDDC            
HEADING IDLEVNR   ('VENDOR')                                                    
HEADING SERVGN    ('SERVICE' 'NET')                                             
HEADING SERVGB    ('SERVICE' 'GROSS')                                           
HEADING TALLY     ('NO. OF' 'PARTS')                                            
HEADING INKOMM    ('NO. OF' 'LINES')                                            
HEADING AVBOK     ('  ')                                                        
HEADING FYSAVV    ('  ')                                                        
LINE VENDOR SERVGN SERVGB TALLY  INKOMM AVBOK FYSAVV                            
                                                                                
BEFORE-BREAK. PROC                                                              
 IF INKOMM > 0                                                                  
    SERVGB ROUNDED = AVBOK * 100 / INKOMM                                       
    SERVGN ROUNDED = (AVBOK - FYSAVV) * 100 / INKOMM                            
 END-IF                                                                         
 AVBOK   = 0                                                                    
 FYSAVV  = 0                                                                    
END-PROC                                                                        
                                                                                
AFTER-BREAK. PROC                                                               
 IF LEVEL EQ 2 AND (PREV-IDDC NE DC02-IDDC OR PREV-IDDC NE IDDC)                
    DISPLAY '¤DAP' DC-TXT                                                       
    DISPLAY '¤DAP' DC02-IDDC                                                    
 END-IF                                                                         
                                                                                
END-PROC                                                                        
