                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W910 FILER TILL ANDRA SYSTEM                          *        
*                                                                      *        
*  FUNKTION   :  MATCHAR GENERATION 0 COH -1 AV FIL W91020             *        
*                OCH SKICKAR DET FÖRÄNDRADE DATAT.                     *        
*                                                                      *        
*  FÖRFATTARE :  JOHAN NIHLBLAD                                        *        
*                                                                      *        
*  INFILER    :  W91020 (+0)                                           *        
*                W91020 (-1)                                           *        
*                                                                      *        
*  UTFILER    :  W91021                                                *        
*                                                                      *        
*----------------------------------------------------------------------*        
FILE W91021D1                                                                   
%W91020  'NY-'                                                                  
*                                                                               
FILE W91021D2                                                                   
%W91020  'GL-'                                                                  
*                                                                               
NEWPAGE                                                                         
FILE W91021D3 FB (55 0)                                                         
%W91020 'UT-'                                                                   
*                                                                               
JOB INPUT (W91021D1 KEY(NY-IDARTNR) W91021D2 KEY(GL-IDARTNR))                   
*                                                                               
IF MATCHED                                                                      
   IF NY-W91020 NE GL-W91020                                                    
      PERFORM S01-SKRIV-UTPOST                                                  
   END-IF                                                                       
ELSE                                                                            
   IF W91021D1                                                                  
      PERFORM S01-SKRIV-UTPOST                                                  
   END-IF                                                                       
END-IF                                                                          
                                                                                
S01-SKRIV-UTPOST.  PROC                                                         
                                                                                
  UT-IDARTNR   = NY-IDARTNR                                                     
  UT-BEART     = NY-BEART                                                       
  UT-KVQPACK-1 = NY-KVQPACK-1                                                   
  UT-PRARTSTD  = NY-PRARTSTD                                                    
  UT-DATPUBL   = NY-DATPUBL                                                     
  PUT W91021D3                                                                  
END-PROC                                                                        
*                                                                               
