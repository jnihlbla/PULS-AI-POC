                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  SYSTEM     :  W555                                                  *        
*                                                                      *        
*  BAKGRUND: SOL-TRANSAR FRÅN PROGRAM W4752000 (HÄR KALLAT SUM-)       *        
*            INNEHÅLLER SUMMERADE SALDOHÄNDELSER SAMT STATUS PÅ DE     *        
*            4 EKONOMISKA SALDONA KVAKS, KVAKS-PAV, KVEFRS OCH KVLS    *        
*            VID UPPDATERINGSTILLFÄLLET.                               *        
*            SOL-TRANSAR FRÅN PGM W4752100 DÄREMOT (HÄR KALLAT DET-)   *        
*            INNEHÅLLER DETALJINFO MEN SAKNAR SALDO-STATUS.            *        
*  FUNKTION: PROGRAMMET SKALL FÖRA ÖVER INFORMATION FRÅN SUM-TRANSAR   *        
*            TILL DET-TRANSAR PÅ SOL SAMT SEDAN RENSA BORT             *        
*            SUM-TRANSARNA. DETTA MINSKAR SOL-HÄNDELSERNA MED 25 %     *        
*            ELLER CA 12 MILJONER TRANSAR PER ÅR.                      *        
*            RENSNINGEN UNDERLÄTTAR ÄVEN LÄSNING AV SOL MM.            *        
*  FILER:  - INFIL W55510 INNEHÅLLER ALLA DET- OCH SUM-TRANSAR SOM     *        
*            SKALL KOMBINERAS.                                         *        
*          - UTFIL W55511, SUM-TRANSAR FRÅN STEG1 FÖR BORTTAG.         *        
*          - UTFIL W55512, SUM-TRANSAR FRÅN STEG3 FÖR BORTTAG.         *        
*          - UTFIL W55513, DET-TRANSAR FRÅN STEG3 FÖR UPPDATERING,     *        
*          - UTFIL W55514, SUM-TRANSAR FRÅN STEG3 FÖR KÄNNEDOM.        *        
*            DESSA SUM-TRANSAR GICK EJ ATT BUNTA IHOP MED DET-         *        
*            TRANSAR. FÖRHOPPNINGSVIS BLIR DET INGA HÄR!!!             *        
*                                                                      *        
*  FÖRFATTARE :  KARL JOHAN HANSSON                                    *        
*                                                                      *        
*  INFIL      :  W555.W555D2.W55510                                    *        
*                                                                      *        
*  UTFILER    :  W555.W555D2.W55511                                    *        
*                W555.W555D2.W55512                                    *        
*                W555.W555D2.W55513                                    *        
*                W555.W555D2.W55514                                    *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
****  INFIL MED ALLA SOL-TRANSAR W4752000 OCH W4752100                          
                                                                                
FILE W55512D1                                                                   
 IN-AREA           1 116 A                                                      
 IN-IDARTNR        1 5 P 0                                                      
 IN-DAREGDAT-9KOMP 6 8 N 0                                                      
 IN-TIKLOCK-9KOMP 14 5 P 0                                                      
 IN-IDSEKVNR      19 2 P 0                                                      
 IN-IDDC          21 2 A                                                        
 IN-IDPGM         30 8 A                                                        
                                                                                
****  TEMPFIL MED ALLA SOL-TRANSAR SORTERADE                                    
FILE TPFIL1 FB (116 0)                                                          
                                                                                
 T1-AREA           1 116 A                                                      
 T1-IDARTNR        1 5 P 0                                                      
 T1-DAREGDAT-9KOMP 6 8 N 0                                                      
 T1-TIKLOCK-9KOMP 14 5 P 0                                                      
 T1-IDSEKVNR      19 2 P 0                                                      
 T1-IDDC          21 2 A                                                        
 T1-IDPGM         30 8 A                                                        
 T1-IDPGM2        42 8 A                                                        
 T1-KVART-SALDO   85 4 P 0                                                      
 T1-KVAKS         90 4 P 0                                                      
 T1-KVAKS-PAV     95 4 P 0                                                      
 T1-TECKEN-EFRS   99 1 A                                                        
 T1-KVEFRS       100 4 P 0                                                      
 T1-KVLS         105 4 P 0                                                      
                                                                                
****  TEMPFIL MED ALLA SOL-TRANSAR W4752000 OCH W4752100                        
****  FÖRUTOM DE BORTPLOCKADE SUM-TRANSARNA SOM KOM I SEKVENS                   
                                                                                
FILE TPFIL2 FB (116 0)                                                          
 T2-AREA           1 116 A                                                      
 T2-IDARTNR        1 5 P 0                                                      
 T2-DAREGDAT-9KOMP 6 8 N 0                                                      
 T2-TIKLOCK-9KOMP 14 5 P 0                                                      
 T2-IDSEKVNR      19 2 P 0                                                      
 T2-IDDC          21 2 A                                                        
 T2-IDPGM         30 8 A                                                        
 T2-IDPGM2        42 8 A                                                        
 T2-KVART-SALDO   85 4 P 0                                                      
 T2-KVAKS         90 4 P 0                                                      
 T2-KVAKS-PAV     95 4 P 0                                                      
 T2-TECKEN-EFRS   99 1 A                                                        
 T2-KVEFRS       100 4 P 0                                                      
 T2-KVLS         105 4 P 0                                                      
                                                                                
****  FIL MED ALLA SOL-TRANSAR W4752000 OCH W4752100                            
****  DE W4752000-TRANSAR SOM EJ PASSAR IHOP HAR IDPGM2=99999999                
                                                                                
FILE TPFIL3 FB (116 0)                                                          
 T3-AREA           1 116 A                                                      
 T3-IDARTNR        1 5 P 0                                                      
 T3-DAREGDAT-9KOMP 6 8 N 0                                                      
 T3-TIKLOCK-9KOMP 14 5 P 0                                                      
 T3-IDSEKVNR      19 2 P 0                                                      
 T3-IDDC          21 2 A                                                        
 T3-IDPGM         30 8 A                                                        
 T3-IDPGM2        42 8 A                                                        
 T3-KVART-SALDO   85 4 P 0                                                      
 T3-KVAKS         90 4 P 0                                                      
 T3-KVAKS-PAV     95 4 P 0                                                      
 T3-TECKEN-EFRS   99 1 A                                                        
 T3-KVEFRS       100 4 P 0                                                      
 T3-KVLS         105 4 P 0                                                      
                                                                                
******  UTFIL MED RENSNINGSTRANSAR (SUMTRANSAR I FÖLJD)                         
                                                                                
FILE W55512D2 FB(116 0)                                                         
 U2-AREA     1 116 A                                                            
                                                                                
******  UTFIL MED UPPDATERINGSTRANSAR                                           
                                                                                
FILE W55512D3 FB(116 0)                                                         
 U3-AREA         1 116 A                                                        
 U3-IDPGM2        42 8 A                                                        
                                                                                
******  FIL MED KVARVARANDE TRANSAR                                             
                                                                                
FILE W55512D4 FB(116 0)                                                         
 U4-AREA     1 116 A                                                            
 U4-IDPGM         30 8 A                                                        
 U4-IDPGM2        42 8 A                                                        
 U4-KVART-SALDO   85 4 P 0                                                      
 U4-KVAKS         90 4 P 0                                                      
 U4-KVAKS-PAV     95 4 P 0                                                      
 U4-KVEFRS       100 4 P 0                                                      
 U4-KVLS         105 4 P 0                                                      
                                                                                
*---------------------------------------------------------                      
******  WORK-AREOR                                                              
 W-KVAKS          W 4 P 0                                                       
 W-KVAKS-PAV      W 4 P 0                                                       
 W-TECKEN-EFRS    W 1 A                                                         
 W-KVEFRS         W 4 P 0                                                       
 W-KVLS           W 4 P 0                                                       
 W-IDARTNR        W 5 P 0                                                       
 W-IDDC           W 2 A                                                         
 W-KVART          W 5 P 0 VALUE +999999999                                      
 W-DAREGDAT-KOMPL W 8 N 0                                                       
 W-TIKLOCK-KOMPL  W 5 P 0                                                       
 W-IDSEKVNR       W 2 P 0                                                       
 LOPNR            W 7 P 0                                                       
 TRANSAR          W 7 P 0                                                       
 W-W47520         W 7 P 0                                                       
 W-W47521         W 7 P 0                                                       
 W-IDLOPNR        W 8 N  VALUE 0                                                
 LAST-IDPGM       W 8 A  VALUE '        '                                       
 OMATCH           W 4 P 0 VALUE +0                                              
 ANTAL1           W 4 P 0 VALUE +0                                              
 ANTAL2           W 4 P 0 VALUE +0                                              
 ANTAL3           W 4 P 0 VALUE +0                                              
 W-LOPNR          W 8 A                                                         
                                                                                
 SUM-IDARTNR      W   5 P 0                                                     
 SUM-IDDC         W   2 A                                                       
 SUM-AREA         W 116 A VALUE ' '                                             
 SUM-FL           W 1   A VALUE ' '                                             
*SUM-FL TALAR OM IFALL SUM-AREA ÄR IFYLLD                                       
                                                                                
*************                                                                   
*  STEG 0 ***                                                                   
*************                                                                   
                                                                                
*  - - - - - - - - HÄR SORTERAR VI - - - - - - - -                              
                                                                                
SORT W55512D1 TO TPFIL1 USING +                                                 
(IN-IDARTNR IN-IDDC IN-DAREGDAT-9KOMP D IN-TIKLOCK-9KOMP D +                    
            IN-IDSEKVNR D)                  SIZE 800000                         
                                                                                
*************                                                                   
*  STEG 1 ***                                                                   
*************                                                                   
                                                                                
**** OM SUM-TRANSAR KOMMER I SEKVENS UTAN DET-TRANSAR EMELLAN,                  
**** SKRIV DEN ÄLDSTE PÅ RENSNINGS-FILEN W55511, SUMMERA KVART                  
**** OCH LÄGG SUMMAN PÅ DEN YNGSTA TRANSEN, DENNA OCH ÖVRIGA TRANSAR            
**** SKRIVS UT PÅ TPFIL2.                                                       
                                                                                
JOB INPUT(TPFIL1) FINISH B-SLUTA                                                
                                                                                
  IF T1-IDPGM EQ 'W4752000' AND T2-IDPGM EQ 'W4752000'                          
    IF T1-IDDC       EQ T2-IDDC      AND +                                      
       T1-IDARTNR    EQ T2-IDARTNR   AND +                                      
       T1-KVAKS      EQ T2-KVAKS     AND +                                      
       T1-KVAKS-PAV  EQ T2-KVAKS-PAV AND +                                      
       T1-KVLS       EQ T2-KVLS                                                 
                                                                                
**** SKRIV UT DUBBLETTEN PÅ RENSFIL FRÅN T2-AREA ALT T1-AREA.                   
**** LÄGG T2-AREAN OCH SALDOSUMMAN PÅ KÖ-AREAN FÖR NÄSTA JÄMFÖRELSE             
      W-KVART           = T1-KVART-SALDO + T2-KVART-SALDO                       
      IF T1-KVEFRS LT T2-KVEFRS                                                 
        U2-AREA         = T2-AREA                                               
        PUT W55512D2                                                            
                                                                                
        T2-AREA         = T1-AREA                                               
      ELSE                                                                      
        U2-AREA         = T1-AREA                                               
        PUT W55512D2                                                            
      END-IF                                                                    
      T2-KVART-SALDO    = W-KVART                                               
    ELSE                                                                        
**** TVÅ SUM-POSTER I RAD, OLIKA ID (SUM-POST SAKNAR DET-POST)                  
**** HOPPA ÖVER OCH TA NÄSTA POST                                               
                                                                                
      ANTAL2 = ANTAL2 + 1                                                       
      T2-AREA           = T1-AREA                                               
                                                                                
    END-IF                                                                      
  ELSE                                                                          
    IF T2-IDPGM EQ 'W4752000' 'W4752100'                                        
      PUT TPFIL2                                                                
    END-IF                                                                      
    T2-AREA             = T1-AREA                                               
  END-IF                                                                        
                                                                                
B-SLUTA. PROC                                                                   
                                                                                
  PUT TPFIL2                                                                    
                                                                                
END-PROC                                                                        
                                                                                
*  - - - - - - - - HÄR SORTERAR VI - - - - - - - -                              
SORT TPFIL2 TO TPFIL2 USING +                                                   
(T2-IDARTNR T2-IDDC T2-DAREGDAT-9KOMP D T2-TIKLOCK-9KOMP D +                    
            T2-IDSEKVNR D)                  SIZE 800000                         
                                                                                
*************                                                                   
*  STEG 2 ***                                                                   
*************                                                                   
                                                                                
**** KOMBINERA SUM-TRANSAR MED DET-TRANSAR.                                     
**** ALLA SUM-TRANSARS KVART-SALDO SKALL GÅ IHOP MED EFTER-                     
**** FÖLJANDE DET-TRANSARS KVART-SALDO (EN ELLER FLERA DET-).                   
**** OM SÅ ÄR FALLET SKRIVS SUM-TANSEN UT PÅ TPFIL3 TILLSAMMANS                 
**** MED DET-TRANSARNA,                                                         
**** ANNARS SKRIVS ENDAST DET-TRANSEN UT PÅ TPFIL3                              
**** SUM- OCH DET-TRANSARNA FÅR PÅ TPFIL3 ETT TEMPORÄRT UNIKT LÖP-              
**** NUMMER FÖR DEN KOMMANDE SORTEN.                                            
                                                                                
JOB INPUT(TPFIL2) START C-BÖRJA FINISH D-SLUTA                                  
                                                                                
  IF T2-IDPGM = 'W4752000'                                                      
***  SUM-POST SKRIVS UT EFTER DESS DET-POSTER                                   
                                                                                
    IF SUM-FL = 'J'                                                             
      PERFORM SKRIV-UT-SUM-POST                                                 
    END-IF                                                                      
    W-IDLOPNR          = W-IDLOPNR + 1                                          
    T2-IDPGM2          = W-IDLOPNR                                              
    SUM-AREA           = T2-AREA                                                
    SUM-IDARTNR        = T2-IDARTNR                                             
    SUM-IDDC           = T2-IDDC                                                
    SUM-FL             = 'J'                                                    
    W-KVART            = T2-KVART-SALDO                                         
  ELSE                                                                          
    T2-IDPGM2          = W-IDLOPNR                                              
    T3-AREA            = T2-AREA                                                
    IF SUM-IDARTNR EQ T3-IDARTNR AND +                                          
       SUM-IDDC    EQ T3-IDDC                                                   
      PUT TPFIL3                                                                
    ELSE                                                                        
      DISPLAY 'OLIKA ID ' SUM-IDARTNR SUM-IDDC T3-IDARTNR T3-IDDC               
      IF SUM-FL = 'J'                                                           
        PERFORM SKRIV-UT-SUM-POST                                               
        SUM-FL           = 'N'                                                  
      END-IF                                                                    
    END-IF                                                                      
    W-KVART = W-KVART - T2-KVART-SALDO                                          
  END-IF                                                                        
  LAST-IDPGM           = T3-IDPGM                                               
                                                                                
C-BÖRJA. PROC                                                                   
  W-KVART     = 0                                                               
  W-IDLOPNR   = 00000001                                                        
END-PROC.                                                                       
                                                                                
SKRIV-UT-SUM-POST. PROC                                                         
  T3-AREA          = SUM-AREA                                                   
  IF W-KVART NE +0                                                              
    ANTAL3 = ANTAL3 + 1                                                         
  ELSE                                                                          
    PUT TPFIL3                                                                  
  END-IF                                                                        
END-PROC.                                                                       
                                                                                
D-SLUTA. PROC                                                                   
  IF SUM-FL = 'J' AND W-KVART EQ +0                                             
    T3-AREA       = SUM-AREA                                                    
    PUT TPFIL3                                                                  
  ELSE                                                                          
    ANTAL3 = ANTAL3 + 1                                                         
  END-IF                                                                        
END-PROC.                                                                       
                                                                                
*  - - - - - - - - HÄR SORTERAR VI - - - - - - - -                              
SORT TPFIL3 TO TPFIL3 USING (T3-IDPGM2 T3-IDPGM +                               
          T3-DAREGDAT-9KOMP D T3-TIKLOCK-9KOMP D T3-IDSEKVNR D) +               
                                    SIZE 800000                                 
*************                                                                   
*  STEG 3 ***                                                                   
*************                                                                   
                                                                                
**** FÖR ALLA POSTER PÅ SAMMA LÖPNUMMER MED EN OCH ENDAST EN SUM-               
**** POST OCH EN ELLER FLERA DET-POSTER SKAPAS UTFILER:                         
**** SKAPA SUM-POSTERS RENSFIL W55512D3 OCH                                     
**** DET-POSTERS UPPDATERINGSFIL W55512D4                                       
**** ÖVRIGA POSTER RÄKNAS ENDAST.                                               
                                                                                
JOB INPUT(TPFIL3) START E-BÖRJA FINISH F-AVSLUTA                                
                                                                                
  IF T3-IDPGM = 'W4752000'                                                      
    W-LOPNR           = T3-IDPGM2                                               
    IF W-LOPNR NE '00000000'                                                    
      U3-AREA         = SUM-AREA                                                
      U3-IDPGM2       = 'W4752000'                                              
      PUT W55512D3                                                              
    END-IF                                                                      
    SUM-AREA          = T3-AREA                                                 
** RÄKNA UPP KVEFRS FÖR SUM-TRANSEN                                             
    W-KVEFRS          = T3-KVEFRS + T3-KVART-SALDO                              
    W-KVLS            = T3-KVLS                                                 
    W-KVAKS           = T3-KVAKS                                                
    W-KVAKS-PAV       = T3-KVAKS-PAV                                            
  ELSE                                                                          
    IF T3-IDPGM2 = W-LOPNR                                                      
      U4-AREA         = T3-AREA                                                 
** RÄKNA NER KVEFRS FÖR DET-TRANSEN                                             
      W-KVEFRS        = W-KVEFRS - T3-KVART-SALDO                               
      U4-KVEFRS       = W-KVEFRS                                                
      U4-KVLS         = W-KVLS                                                  
      U4-KVAKS        = W-KVAKS                                                 
      U4-KVAKS-PAV    = W-KVAKS-PAV                                             
      U4-IDPGM        = 'W4752099'                                              
      U4-IDPGM2       = 'W4752099'                                              
      PUT W55512D4                                                              
    ELSE                                                                        
      W-LOPNR         = '00000000'                                              
      DISPLAY 'OMATCH ' T3-IDARTNR T3-IDDC                                      
      ANTAL1 = ANTAL1 + 1                                                       
**** RÄKNA OMATCHADE DET-POSTER                                                 
    END-IF                                                                      
  END-IF                                                                        
                                                                                
E-BÖRJA. PROC                                                                   
  W-LOPNR           = '00000000'                                                
END-PROC                                                                        
                                                                                
F-AVSLUTA. PROC                                                                 
  DISPLAY 'SUM-POSTER SOM SAKNAR DET-P STEG1 ' ANTAL2                           
  DISPLAY 'SUM-POSTER SOM SAKNAR DET-P STEG2 ' ANTAL3                           
  DISPLAY 'OMATCHADE DETALJTRANSAR     STEG3 ' ANTAL1                           
END-PROC.                                                                       
