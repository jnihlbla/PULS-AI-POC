                                                                                
*----------------------------------------------------------------------*        
*                                                                      *        
*  PROGRAM    :  W3358500                                              *        
*                                                                      *        
*  FUNCTION   :  TAR FRAM FÄRSKASTE PRISRAD PER ART + LEV OCH          *        
*                LÄGGER PÅ UTFIL                                       *        
*                                                                      *        
*  WRITER     :  ELEONOR ÖSTRÖM                                        *        
*                                                                      *        
*----------------------------------------------------------------------*        
                                                                                
NEWPAGE                                                                         
FILE W33585D1                                                                   
%W01161   'IN-'                                                                 
                                                                                
NEWPAGE                                                                         
FILE W33585D2                                                                   
%W33591      'LEV-'                                                             
                                                                                
NEWPAGE                                                                         
FILE W33585D3 FB (47 0)                                                         
%W33585   'UT-'                                                                 
                                                                                
*                                                                               
FILE TPFIL1  FB (51 0)                                                          
*                                                                               
%W01161   'T1-'                                                                 
                                                                                
FILE TPFIL2  FB (60 0)                                                          
%W01161   'T2-'                                                                 
T2-RETULF          52 4 P 4                                                     
T2-IDLEVNR-MOTSV   56 5 A                                                       
                                                                                
FILE TPFIL3  FB (14 0)                                                          
*                                                                               
%W33591   'T3-'                                                                 
                                                                                
NEWPAGE                                                                         
                                                                                
*                                                                               
NEWPAGE                                                                         
  W-PROGRAM-NAMN   W  6   A   VALUE 'W33585'                                    
                                                                                
* DATUM                    W  8  A                                              
  W-DAGENS-DATUM           W  8  A                                              
  W-AA   W-DAGENS-DATUM       2  N                                              
  W-S1   W-DAGENS-DATUM   +2  1  A                                              
  W-MM   W-DAGENS-DATUM   +3  2  N                                              
  W-S2   W-DAGENS-DATUM   +5  1  A                                              
  W-DD   W-DAGENS-DATUM   +6  2  N                                              
                                                                                
  W-DATUM                  W  8  N                                              
  W-TI   W-DATUM              2  N                                              
  W-AR   W-DATUM          +2  2  N                                              
  W-MA   W-DATUM          +4  2  N                                              
  W-DA   W-DATUM          +6  2  N                                              
                                                                                
W-PRISDATUM      W 8 N    VALUE 0                                               
W-IDARTNR        W 9 P    VALUE 0                                               
W-IDLEVNR        W 5 A    VALUE '     '                                         
W-DIFF           W 9 P 2  VALUE 0                                               
ANT              W 8 P    VALUE 0                                               
                                                                                
NEWPAGE                                                                         
************************************************************                    
* STEG 1. SORTERAR IN-FIL  PÅ IDLEVNR TILL TPFIL1          *                    
************************************************************                    
                                                                                
SORT W33585D1 TO TPFIL1 USING                                        +          
 (IN-PRL-IDLEVNR ) SIZE 800000                                                  
*    BEFORE SORT-INIT  SIZE 800000                                              
NEWPAGE                                                                         
************************************************************                    
* STEG 2. SORTERAR W33585D2 PÅ IDLEVNR TILL TPFIL3         *                    
************************************************************                    
                                                                                
SORT W33585D2 TO TPFIL3 USING                                      +            
 (LEV-IDLEVNR ) SIZE 800000                                                     
*    BEFORE SORT-INIT  SIZE 800000                                              
NEWPAGE                                                                         
************************************************************                    
* STEG 3. MATCHAR TPFIL1 OCH TPFIL3 LEV-FIL OCH BYTER UT   *                    
*         ALFALEVNR MOT DET GAMLA NUMERISKA LEVNR          *                    
************************************************************                    
*                                                                               
JOB INPUT (TPFIL3 KEY(T3-IDLEVNR) TPFIL1 KEY(T1-PRL-IDLEVNR))      +            
                                    START A-INIT                                
                                                                                
    IF MATCHED                                                                  
      IF DUPLICATE TPFIL1 OR NOT DUPLICATE TPFIL1                               
        T2-PRL-W01161 = T1-PRL-W01161                                           
        T2-RETULF        = T3-RETULF                                            
        T2-IDLEVNR-MOTSV = '     '                                              
        PUT TPFIL2                                                              
      END-IF                                                                    
    ELSE                                                                        
      IF TPFIL1                                                                 
        T2-PRL-W01161    = T1-PRL-W01161                                        
        T2-RETULF        = 1                                                    
        T2-IDLEVNR-MOTSV = '     '                                              
        PUT TPFIL2                                                              
      END-IF                                                                    
    END-IF                                                                      
                                                                                
A-INIT. PROC                                                                    
                                                                                
  W-DAGENS-DATUM = SYSDATE                                                      
  W-TI     = 20                                                                 
  W-AR     = W-AA                                                               
  W-MA     = W-MM                                                               
  W-DA     = W-DD                                                               
                                                                                
END-PROC.                                                                       
NEWPAGE                                                                         
************************************************************                    
* STEG 4. SORTERAR TPFIL2  PÅ ARTNR, IDLEVNR OCH DATUM     *                    
************************************************************                    
                                                                                
SORT TPFIL2 TO TPFIL2 USING                                          +          
 (T2-PRL-IDARTNR T2-PRL-IDLEVNR T2-PRL-DAPRLIST-9KOMPL )             +          
     BEFORE SORT-INIT  SIZE 800000                                              
                                                                                
 SORT-INIT. PROC                                                                
 ANT = ANT + 1                                                                  
 IF T2-PRL-SUINLEV-PR > 0                                                       
   IF T2-PRL-KDSTATUS-PR = 1 AND T2-PRL-FLHUVLEV = 'J'                          
     W-PRISDATUM = 99999999 - T2-PRL-DAPRLIST-9KOMPL                            
     IF W-DATUM >= W-PRISDATUM                                                  
       SELECT                                                                   
     END-IF                                                                     
   END-IF                                                                       
 END-IF                                                                         
                                                                                
 END-PROC                                                                       
************************************************************                    
* STEG 5. TAR FRAM FÄRSKASTE PRISRAD PER ARTNR OCH IDLEVNR *                    
************************************************************                    
                                                                                
JOB INPUT TPFIL2 START A-INIT                                                   
 IF W-IDARTNR = T2-PRL-IDARTNR AND W-IDLEVNR = T2-PRL-IDLEVNR                   
 ELSE                                                                           
   UT-IDARTNR         = T2-PRL-IDARTNR                                          
   UT-DAPRLIST-9KOMPL = 99999999 - T2-PRL-DAPRLIST-9KOMPL                       
   UT-FLHUVLEV        = T2-PRL-FLHUVLEV                                         
   UT-IDLEVNR-PR      = T2-PRL-IDLEVNR                                          
   UT-KDPRURSP        = T2-PRL-KDPRURSP                                         
   UT-KDSTATUS-PR     = T2-PRL-KDSTATUS-PR                                      
   UT-KDVALISO        = T2-PRL-KDVALISO                                         
   UT-PRARTBES-PR     = T2-PRL-PRARTBES-PR                                      
   UT-PRARTBEL-PR     = T2-PRL-PRARTBEL-PR                                      
   UT-SUINLEV-PR      = T2-PRL-SUINLEV-PR                                       
   UT-RETULF          = T2-RETULF                                               
   UT-IDLEVNR-MOTSV   = T2-IDLEVNR-MOTSV                                        
   PUT W33585D3                                                                 
   W-IDARTNR  = T2-PRL-IDARTNR                                                  
   W-IDLEVNR  = T2-PRL-IDLEVNR                                                  
 END-IF                                                                         
                                                                                
A-INIT. PROC                                                                    
   W-IDARTNR  = 0                                                               
   W-IDLEVNR  = '     '                                                         
END-PROC                                                                        
*                                                                               
