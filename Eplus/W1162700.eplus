*----------------------------------------------------------------------*        
*--------------------------------------*                                        
*        FILE SECTION                  *                                        
* -------------------------------------*                                        
FILE W11627D1                                                                   
%W11610A     'IN-'                                                              
*                                                                               
NEWPAGE                                                                         
FILE W11627D2                                                                   
%W11602      'TR-'                                                              
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*  UTFIL                               *                                        
* -------------------------------------*                                        
FILE W11627D3 FB (311 0)                                                        
%W11610A    'UT-'                                                               
*                                                                               
NEWPAGE                                                                         
*--------------------------------------*                                        
*      JOB INPUT                       *                                        
* -------------------------------------*                                        
                                                                                
JOB INPUT (W11627D1 KEY(IN-IDARTNR) W11627D2 KEY(TR-IDARTNR))                   
  IF MATCHED                                                                    
     UT-W11610A = IN-W11610A                                                    
     UT-BEARTEXT = TR-BEARTEXT                                                  
     PUT W11627D3                                                               
  ELSE                                                                          
     UT-W11610A = IN-W11610A                                                    
     IF W11627D1                                                                
        PUT W11627D3                                                            
     END-IF                                                                     
  END-IF                                                                        
*                                                                               
