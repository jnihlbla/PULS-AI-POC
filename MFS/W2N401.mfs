               LTH=2,                                                  +        
               FILL=X'F0'                                                       
         MFLD  (BLADDANT,                                              +        
               '   '),                                                 +        
               LTH=3,                                                  +        
               JUST=R,                                                 +        
               FILL=X'F0'                                                       
         MSGEND                                                                 
         END                                                                    
