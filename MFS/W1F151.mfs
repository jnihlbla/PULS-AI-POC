*          DATA SET W1F151FII0 AT LEVEL 005 AS OF 89/07/11                      
*                                                                               
         PRINT NOGEN                                                            
W1F151   FMT                                                                    
         DEV   TYPE=(3270,2),                                          *        
               FEAT=IGNORE,                                            *        
