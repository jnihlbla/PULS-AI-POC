         DFLD  'DISTR.NO',                                             *        
               POS=(18,31),LTH=0008,ATTR=(NUM,PROT)                             
         DFLD  'DISTR.NO',                                             *        
               POS=(18,41),LTH=0008,ATTR=(NUM,PROT)                             
         DFLD  'DISTR.NO',                                             *        
               POS=(18,51),LTH=0008,ATTR=(NUM,PROT)                             
         DFLD  'DISTR.NO',                                             *        
               POS=(18,61),LTH=0008,ATTR=(NUM,PROT)                             
         DFLD  'DISTR.NO',                                             *        
               POS=(18,71),LTH=0008,ATTR=(NUM,PROT)                             
FLD1905  DFLD  POS=(19,05),LTH=0001,ATTR=(ALPHA)                                
FLD1913  DFLD  POS=(19,13),LTH=0006,ATTR=(ALPHA)                                
FLD1924  DFLD  POS=(19,24),LTH=0004,ATTR=(NUM)                                  
FLD1934  DFLD  POS=(19,34),LTH=0004,ATTR=(NUM)                                  
FLD1944  DFLD  POS=(19,44),LTH=0004,ATTR=(NUM)                                  
FLD1954  DFLD  POS=(19,54),LTH=0004,ATTR=(NUM)                                  
FLD1964  DFLD  POS=(19,64),LTH=0004,ATTR=(NUM)                                  
FLD1974  DFLD  POS=(19,74),LTH=0004,ATTR=(NUM)                                  
         DFLD  '13 MARK. STR.  14 PROJ. STR.    15 PROJ. MENY  16 BERED*        
               /FUNKGRP 17 BASL.ÅF-SATS 18 ORDERGEN.   19              *        
                20             21               22 WHELP   ',          *        
               POS=(21,02),LTH=0156,ATTR=(NUM,PROT)                             
FLD2302  DFLD  POS=(23,02),LTH=0055,ATTR=(NUM,PROT,HI)                          
