         MFLD  (FLD1924,'++++'),LTH=0004,FILL=C'0',JUST=R                       
         MFLD  (FLD1934,'++++'),LTH=0004,FILL=C'0',JUST=R                       
         MFLD  (FLD1944,'++++'),LTH=0004,FILL=C'0',JUST=R                       
