COL04    DFLD  POS=(06,04),LTH=0006,ATTR=(NUM,PROT)                             
COL15    DFLD  POS=(06,15),LTH=0004,ATTR=(NUM,PROT)                             
         ENDDO                                                                  
         DO    12,SUF=33                                                        
COL33    DFLD  POS=(06,33),LTH=0006,ATTR=(NUM,PROT)                             
COL44    DFLD  POS=(06,44),LTH=0004,ATTR=(NUM,PROT)                             
