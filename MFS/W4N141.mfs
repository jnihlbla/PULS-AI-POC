         TITLE 'Parts not sent to customs       '                               
W4N141   FMT                                                                    
         DEV   TYPE=(3270,2),                                          +        
               FEAT=IGNORE,                                            +        
               SYSMSG=FSYSMSG,                                         +        
               DSCA=X'0080',                                           +        
               PFK=(FLDPFK,                                            +        
               1='W0T501  ',                                           +        
               2='W0T501  ',                                           +        
               3='W0T501  ',                                           +        
               4='W0T501  ',                                           +        
               5='W0T501  ',                                           +        
               6='W0T501  ',                                           +        
               7='W4T141 7',                                           +        
               8='W4T141 8',                                           +        
               9='W0T501  ',                                           +        
               10='WHELP   ',                                          +        
               11='W4T141U ',                                          +        
               12='/RCL.   ',                                          +        
               13='W0T501  ',                                          +        
               14='W0T501  ',                                          +        
               15='W0T501  ',                                          +        
               16='W0T501  ',                                          +        
               17='W0T501  ',                                          +        
               18='W0T501  ',                                          +        
               19='W0T501  ',                                          +        
               20='W0T501  ',                                          +        
               21='W0T501  ',                                          +        
               22='WHELP   ',                                          +        
               23='W0T501  ',                                          +        
               24='/RCL.   ')                                                   
         DIV   TYPE=INOUT                                                       
DGI00001 DPAGE CURSOR=((2,15)),                                        +        
               FILL=NONE                                                        
FLD0102  DFLD  POS=(1,2),LTH=1,                                        +        
               ATTR=(NOPROT,MOD)                                                
FLD0104  DFLD  POS=(1,4),LTH=1,                                        +        
               ATTR=(NUM,NOPROT,MOD)                                            
FLD0106  DFLD  POS=(1,6),LTH=1,                                        +        
               ATTR=(NUM,NOPROT,MOD)                                            
FLD0108  DFLD  POS=(1,8),LTH=1,                                        +        
               ATTR=(NUM,NOPROT,MOD)                                            
         DFLD  'PARTS NOT SENT TO CUSTOMS',                            +        
               POS=(1,11),LTH=25,                                      +        
               ATTR=(PROT)                                                      
FLD0141  DFLD  POS=(1,41),LTH=40,                                      +        
               ATTR=(PROT,HI)                                                   
         DFLD  'Part No:',                                             +        
               POS=(2,06),LTH=8,                                       +        
               ATTR=(NUM,PROT)                                                  
ARTNRIN  DFLD  POS=(2,15),LTH=9,                                       +        
               ATTR=(NUM,NOPROT)                                                
ARTNRUT  DFLD  POS=(3,15),LTH=9,                                       +        
               ATTR=(PROT,MOD)                                                  
         DFLD  'New Part No:',                                         +        
               POS=(4,02),LTH=12,                                      +        
               ATTR=(PROT)                                                      
ARTNUMI  DFLD  POS=(4,15),LTH=9,                                       +        
               ATTR=(NUM,NOPROT)                                                
         DFLD  'Last update',                                          +        
               POS=(2,28),LTH=11,                                      +        
               ATTR=(PROT)                                                      
LASTUPD  DFLD  POS=(2,40),LTH=6,                                       +        
               ATTR=(NUM,PROT)                                                  
         DFLD  'Active parts',                                         +        
               POS=(2,52),LTH=12,                                      +        
               ATTR=(PROT)                                                      
ACTIVE   DFLD  POS=(2,65),LTH=6,                                       +        
               ATTR=(NUM,PROT)                                                  
         DFLD  ' Total parts',                                         +        
               POS=(3,52),LTH=12,                                      +        
               ATTR=(PROT)                                                      
TOTAL    DFLD  POS=(3,65),LTH=6,                                       +        
               ATTR=(NUM,PROT)                                                  
         DFLD  'S(top)/A(ctivate)',                                    +        
               POS=(5,2),LTH=18,                                       +        
               ATTR=(PROT)                                                      
         DFLD  'D(elete)',                                             +        
               POS=(6,6),LTH=8,                                        +        
               ATTR=(PROT)                                                      
         DFLD  'START',                                                +        
               POS=(5,28),LTH=07,                                      +        
               ATTR=(PROT)                                                      
         DFLD  'Part No',                                              +        
               POS=(6,18),LTH=07,                                      +        
               ATTR=(PROT)                                                      
         DFLD  'USER ID',                                              +        
               POS=(6,28),LTH=07,                                      +        
               ATTR=(PROT)                                                      
         DFLD  'DATE',                                                 +        
               POS=(6,37),LTH=04,                                      +        
               ATTR=(PROT)                                                      
         DFLD  'TIME',                                                 +        
               POS=(6,44),LTH=04,                                      +        
               ATTR=(PROT)                                                      
         DFLD  'STOP',                                                 +        
               POS=(5,53),LTH=07,                                      +        
               ATTR=(PROT)                                                      
         DFLD  'USER ID',                                              +        
               POS=(6,53),LTH=07,                                      +        
               ATTR=(PROT)                                                      
         DFLD  'DATE',                                                 +        
               POS=(6,62),LTH=04,                                      +        
               ATTR=(PROT)                                                      
         DFLD  'TIME',                                                 +        
               POS=(6,69),LTH=04,                                      +        
               ATTR=(PROT)                                                      
         DO    14,SUF=07                                                        
CMD      DFLD  POS=(7,8),LTH=1,                                        +        
               ATTR=(NOPROT,MOD)                                                
ARTNR    DFLD  POS=(7,18),LTH=9,                                       +        
               ATTR=(PROT,MOD)                                                  
ACFSTA   DFLD  POS=(7,28),LTH=8,                                       +        
               ATTR=(PROT,MOD)                                                  
DATSTA   DFLD  POS=(7,37),LTH=6,                                       +        
               ATTR=(PROT,MOD)                                                  
TIMSTA   DFLD  POS=(7,44),LTH=5,                                       +        
               ATTR=(PROT,MOD)                                                  
ACFSTO   DFLD  POS=(7,53),LTH=8,                                       +        
               ATTR=(PROT,MOD)                                                  
DATSTO   DFLD  POS=(7,62),LTH=6,                                       +        
               ATTR=(PROT,MOD)                                                  
TIMSTO   DFLD  POS=(7,69),LTH=5,                                       +        
               ATTR=(PROT,MOD)                                                  
         ENDDO                                                                  
         DFLD  'F7=First  F8=Next  F10=WHELP  F11=Update',             +        
               POS=(22,2),LTH=40,                                      +        
               ATTR=(PROT)                                                      
FLD2302  DFLD  POS=(23,2),LTH=55,                                      +        
               ATTR=(PROT,HI)                                                   
         DFLD  'VCCS',                                                 +        
               POS=(23,59),LTH=4,                                      +        
               ATTR=(PROT)                                                      
DATE     DFLD  POS=(23,64),LTH=8,                                      +        
               ATTR=(PROT)                                                      
TIME     DFLD  POS=(23,73),LTH=8,                                      +        
               ATTR=(PROT)                                                      
FSYSMSG  DFLD  POS=(24,2),LTH=79,                                      +        
               ATTR=(PROT,HI)                                                   
         FMTEND                                                                 
W4O141N1 MSG   TYPE=OUTPUT,                                            +        
               SOR=(W4N141,IGNORE),                                    +        
               OPT=2,                                                  +        
               NXT=W4I141N1,                                           +        
               FILL=PT                                                          
DGI00002 LPAGE SOR=DGI00001                                                     
         SEG                                                                    
         MFLD  FLD0102,                                                +        
               LTH=1                                                            
         MFLD  FLD0104,                                                +        
               LTH=1                                                            
         MFLD  FLD0106,                                                +        
               LTH=1                                                            
         MFLD  FLD0108,                                                +        
               LTH=1                                                            
         MFLD  FLD0141,                                                +        
               LTH=40                                                           
         MFLD  ARTNRIN,                                                +        
               LTH=9                                                            
         MFLD  ARTNRUT,                                                +        
               LTH=9                                                            
         MFLD  ARTNUMI,                                                +        
               LTH=11,                                                 +        
               ATTR=(YES)                                                       
         MFLD  LASTUPD,                                                +        
               LTH=6                                                            
         MFLD  ACTIVE,                                                 +        
               LTH=4                                                            
         MFLD  TOTAL,                                                  +        
               LTH=4                                                            
         DO    14,SUF=07                                                        
         MFLD  CMD,                                                    +        
               LTH=3,                                                  +        
               ATTR=(YES)                                                       
         MFLD  ARTNR,                                                  +        
               LTH=11,                                                 +        
               ATTR=(YES)                                                       
         MFLD  ACFSTA,                                                 +        
               LTH=8                                                            
         MFLD  DATSTA,                                                 +        
               LTH=6                                                            
         MFLD  TIMSTA,                                                 +        
               LTH=5                                                            
         MFLD  ACFSTO,                                                 +        
               LTH=8                                                            
         MFLD  DATSTO,                                                 +        
               LTH=6                                                            
         MFLD  TIMSTO,                                                 +        
               LTH=5                                                            
         ENDDO                                                                  
         MFLD  FLD2302,                                                +        
               LTH=55                                                           
         MFLD  (DATE,                                                  +        
               DATE4)                                                           
         MFLD  (TIME,                                                  +        
               TIME)                                                            
         MFLD  (FSYSMSG,                                               +        
               ' '),                                                   +        
               LTH=1                                                            
         MSGEND                                                                 
W4I141N1 MSG   TYPE=INPUT,                                             +        
               SOR=(W4N141),                                           +        
               OPT=2,                                                  +        
               NXT=W4O141N1                                                     
DGI00003 LPAGE SOR=(DGI00001)                                                   
         SEG                                                                    
         MFLD  FLDPFK,                                                 +        
               LTH=8,                                                  +        
               FILL=NULL                                                        
         MFLD  'W',                                                    +        
               LTH=1                                                            
         MFLD  FLD0102,                                                +        
               LTH=1,                                                  +        
               FILL=X'F4'                                                       
         MFLD  'T',                                                    +        
               LTH=1                                                            
         MFLD  FLD0104,                                                +        
               LTH=1,                                                  +        
               FILL=X'F5'                                                       
         MFLD  FLD0106,                                                +        
               LTH=1,                                                  +        
               FILL=X'F4'                                                       
         MFLD  FLD0108,                                                +        
               LTH=1,                                                  +        
               FILL=X'F1'                                                       
         MFLD  '  ',                                                   +        
               LTH=2                                                            
         MFLD  '41411',                                                +        
               LTH=5                                                            
         MFLD  (ARTNRIN,                                               +        
               '+++++++++'),                                           +        
               LTH=9,                                                  +        
               JUST=R                                                           
         MFLD  (ARTNRUT,                                               +        
               '         '),                                           +        
               LTH=9,                                                  +        
               FILL=X'F0'                                                       
         MFLD  (ARTNUMI,                                               +        
               '+++++++++'),                                           +        
               LTH=9,                                                  +        
               JUST=R                                                           
         DO    14,SUF=07                                                        
         MFLD  (CMD,                                                   +        
               '+'),                                                   +        
               LTH=1                                                            
         ENDDO                                                                  
         DO    14,SUF=07                                                        
         MFLD  ARTNR,                                                  +        
               LTH=9                                                            
         ENDDO                                                                  
         MSGEND                                                                 
         END                                                                    
