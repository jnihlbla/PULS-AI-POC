         MFLD  FLD0426,LTH=0006                                                 
         MFLD  FLD0433,LTH=0006                                                 
         MFLD  FLD0440,LTH=0008                                                 
         MFLD  FLD0450,LTH=0008                                                 
         DO    14,SUF=06                                                        
         MFLD  COL02,LTH=0004,ATTR=YES                                          
         MFLD  COL05,LTH=0010,ATTR=YES                                          
         MFLD  COL14,LTH=0010,ATTR=YES                                          
         MFLD  COL22,LTH=0008,ATTR=YES                                          
         MFLD  COL34,LTH=0006,ATTR=YES                                          
         ENDDO                                                                  
         DO    14,SUF=06                                                        
         MFLD  COL40,LTH=0004,ATTR=YES                                          
         MFLD  COL43,LTH=0010,ATTR=YES                                          
         MFLD  COL52,LTH=0010,ATTR=YES                                          
         MFLD  COL60,LTH=0008,ATTR=YES                                          
         MFLD  COL69,LTH=0006,ATTR=YES                                          
         ENDDO                                                                  
         MFLD  FLD2302,LTH=0055                                                 
         MFLD  (FLD2364,DATE4)                                                  
         MFLD  (FLD2373,TIME)                                                   
         MFLD  (FSYSMSG,' '),LTH=0001                                           
         MSGEND                                                                 
         EJECT                                                                  
W3I20101 MSG   TYPE=INPUT,                                             *        
               SOR=W3F201,                                             *        
               OPT=2,                                                  *        
               NXT=W3O20101                                                     
         SEG                                                                    
         MFLD  FLDPFK,LTH=0008,FILL=NULL                                        
         MFLD  'W',LTH=0001                                                     
         MFLD  FLD0102,LTH=0001,FILL=C'3'                                       
         MFLD  'T',LTH=0001                                                     
         MFLD  FLD0104,LTH=0001,FILL=C'2'                                       
         MFLD  FLD0106,LTH=0001,FILL=C'0'                                       
         MFLD  FLD0108,LTH=0001,FILL=C'1'                                       
         MFLD  '  ',LTH=0002                                                    
         MFLD  '32011',LTH=0005                                                 
         MFLD  (FLD0216,'++++++++'),LTH=0008,FILL=C' ',JUST=L                   
         MFLD  (FLD0234,'++++++++'),LTH=0008,FILL=C' ',JUST=L                   
         MFLD  FLD0316,LTH=0008,FILL=C' ',JUST=L                                
         MFLD  FLD0334,LTH=0008,FILL=C' ',JUST=L                                
         MFLD  FLD0402,LTH=0004,FILL=C' ',JUST=L                                
         MFLD  FLD0407,LTH=0004,FILL=C' ',JUST=L                                
         MFLD  FLD0412,LTH=0008,FILL=C'0',JUST=R                                
         MFLD  FLD0419,LTH=0008,FILL=C'0',JUST=R                                
         MFLD  FLD0426,LTH=0006,FILL=C'0',JUST=R                                
         MFLD  FLD0433,LTH=0006,FILL=C'0',JUST=R                                
         MFLD  FLD0440,LTH=0008,FILL=C' ',JUST=L                                
         MFLD  FLD0450,LTH=0008,FILL=C' ',JUST=L                                
         DO    14,SUF=06                                                        
         MFLD  (COL02,'+'),LTH=0001,FILL=C' ',JUST=L                            
         MFLD  COL05,LTH=0008,JUST=L                                            
         MFLD  COL14,LTH=0008,JUST=R                                            
         MFLD  COL22,LTH=0006,JUST=R                                            
         MFLD  COL34,LTH=0004,JUST=L                                            
         ENDDO                                                                  
         DO    14,SUF=06                                                        
         MFLD  (COL40,'+'),LTH=0001,FILL=C' ',JUST=L                            
         MFLD  COL43,LTH=0008,JUST=L                                            
         MFLD  COL52,LTH=0008,JUST=R                                            
         MFLD  COL60,LTH=0006,JUST=R                                            
         MFLD  COL69,LTH=0004,JUST=L                                            
         ENDDO                                                                  
         MSGEND                                                                 
         END                                                                    
