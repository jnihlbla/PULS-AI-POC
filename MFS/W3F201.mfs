*          DATA SET W3F201FII0 AT LEVEL 042 AS OF 89/11/16                      
         PRINT NOGEN                                                            
W3F201   FMT                                                                    
         DEV   TYPE=(3270,2),                                          *        
               FEAT=IGNORE,                                            *        
               PFK=(FLDPFK,'W0T551U ','W0T501  ','W0T501  ','W0T501  ',*        
               'W0T501  ','W0T501  ','W3T201 7','W3T201 8','W3T201 9', *        
               'WHELP   ','W0T501  ','/RCL.   ','W3T201  ','W3T202  ', *        
