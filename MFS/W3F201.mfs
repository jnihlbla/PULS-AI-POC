FLD0102  DFLD  POS=(01,02),LTH=0001,ATTR=(ALPHA,NOPROT,MOD)                     
FLD0104  DFLD  POS=(01,04),LTH=0001,ATTR=(NUM)                                  
FLD0106  DFLD  POS=(01,06),LTH=0001,ATTR=(NUM)                                  
FLD0108  DFLD  POS=(01,08),LTH=0001,ATTR=(NUM)                                  
         DFLD  'ART.STAT  KATALOG ÖVER URVAL ',                        *        
               POS=(01,10),LTH=0029,ATTR=(NUM,PROT)                             
FLD0140  DFLD  POS=(01,40),LTH=0040,ATTR=(NUM,PROT,HI)                          
         DFLD  'Urval',                                                *        
               POS=(02,10),LTH=0005,ATTR=(NUM,PROT)                             
FLD0216  DFLD  POS=(02,16),LTH=0008,ATTR=(ALPHA)                                
         DFLD  'Userid',                                               *        
               POS=(02,27),LTH=0006,ATTR=(NUM,PROT)                             
FLD0234  DFLD  POS=(02,34),LTH=0008,ATTR=(ALPHA)                                
FLD0316  DFLD  POS=(03,16),LTH=0008,ATTR=(NUM,PROT,MOD)                         
FLD0334  DFLD  POS=(03,34),LTH=0008,ATTR=(NUM,PROT,MOD)                         
FLD0402  DFLD  POS=(04,02),LTH=0004,ATTR=(NUM,PROT,MOD,NODISP)                  
FLD0407  DFLD  POS=(04,07),LTH=0004,ATTR=(NUM,PROT,MOD,NODISP)                  
FLD0412  DFLD  POS=(04,12),LTH=0008,ATTR=(NUM,PROT,MOD,NODISP)                  
FLD0419  DFLD  POS=(04,21),LTH=0008,ATTR=(NUM,PROT,MOD,NODISP)                  
FLD0426  DFLD  POS=(04,30),LTH=0006,ATTR=(NUM,PROT,MOD,NODISP)                  
