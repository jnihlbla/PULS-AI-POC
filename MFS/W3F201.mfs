FLD0440  DFLD  POS=(04,50),LTH=0008,ATTR=(NUM,PROT,MOD,NODISP)                  
FLD0450  DFLD  POS=(04,60),LTH=0008,ATTR=(NUM,PROT,MOD,NODISP)                  
         DFLD  'S  Namn     Datum   Klockslag   Bild  S  Namn     Datum*        
                  Klockslag   Bild',                                   *        
               POS=(05,02),LTH=0074,ATTR=(NUM,PROT)                             
         DO    14,SUF=06                                                        
COL02    DFLD  POS=(06,02),LTH=0001,ATTR=(ALPHA,MOD)                            
COL05    DFLD  POS=(06,05),LTH=0008,ATTR=(NUM,PROT,MOD)                         
COL14    DFLD  POS=(06,14),LTH=0008,ATTR=(NUM,PROT,MOD)                         
COL22    DFLD  POS=(06,23),LTH=0006,ATTR=(NUM,PROT,MOD)                         
COL34    DFLD  POS=(06,34),LTH=0004,ATTR=(NUM,PROT,MOD)                         
         ENDDO                                                                  
         DO    14,SUF=06                                                        
COL40    DFLD  POS=(06,40),LTH=0001,ATTR=(ALPHA,MOD)                            
COL43    DFLD  POS=(06,43),LTH=0008,ATTR=(NUM,PROT,MOD)                         
COL52    DFLD  POS=(06,52),LTH=0008,ATTR=(NUM,PROT,MOD)                         
COL60    DFLD  POS=(06,61),LTH=0006,ATTR=(NUM,PROT,MOD)                         
COL69    DFLD  POS=(06,72),LTH=0004,ATTR=(NUM,PROT,MOD)                         
         ENDDO                                                                  
         DFLD  '13 Katalog-bild 14 Fkngrp-urval 15 Artikelurval 16 Stor*        
               säljare  17              18              19             *        
                20              21              10 Whelp',             *        
               POS=(21,02),LTH=0152,ATTR=(NUM,PROT)                             
FLD2302  DFLD  POS=(23,02),LTH=0055,ATTR=(NUM,PROT,HI)                          
         DFLD  ' VCP ',POS=(23,58)                                              
FLD2364  DFLD  POS=(23,64),LTH=0008,ATTR=(NUM,PROT)                             
FLD2373  DFLD  POS=(23,73),LTH=0008,ATTR=(NUM,PROT)                             
FSYSMSG  DFLD  POS=(24,02),LTH=0079,ATTR=(NUM,PROT,HI)                          
         FMTEND                                                                 
         EJECT                                                                  
W3O20101 MSG   TYPE=OUTPUT,                                            *        
               SOR=(W3F201,IGNORE),                                    *        
               OPT=2,                                                  *        
               NXT=W3I20101,                                           *        
               FILL=PT,                                                *        
               PAGE=NO                                                          
         SEG                                                                    
         MFLD  FLD0102,LTH=0001                                                 
         MFLD  FLD0104,LTH=0001                                                 
         MFLD  FLD0106,LTH=0001                                                 
         MFLD  FLD0108,LTH=0001                                                 
         MFLD  FLD0140,LTH=0040                                                 
