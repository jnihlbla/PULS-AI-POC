               ATTR=(NUM,PROT,HI)                                               
         FMTEND                                                                 
W3I221N1 MSG   TYPE=INPUT,                                             +        
               SOR=(W3N221),                                           +        
               OPT=2,                                                  +        
               NXT=W3O221N1                                                     
MID      LPAGE SOR=(FORMAT)                                                     
         SEG                                                                    
         MFLD  FLDPFK,                                                 +        
               LTH=8,                                                  +        
