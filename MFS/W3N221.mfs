IDARTNR  DFLD  POS=(8,17),LTH=9,                                       +        
               ATTR=(NUM,NOPROT)                                                
         DFLD  'F1=Help',                                              +        
               POS=(22,2),LTH=7,                                       +        
               ATTR=(PROT)                                                      
         DFLD  'F10=WHELP    F11=Update   F12=Logoff',                 +        
               POS=(22,14),LTH=36,                                     +        
               ATTR=(PROT)                                                      
FLD2302  DFLD  POS=(23,2),LTH=55,                                      +        
               ATTR=(PROT,HI)                                                   
         DFLD  'VCP',                                                  +        
               POS=(23,59),LTH=3,                                      +        
