         DFLD  'Product Group',                                        +        
               POS=(6,2),LTH=13,                                       +        
               ATTR=(PROT)                                                      
PRODSL   DFLD  POS=(6,17),LTH=2,                                       +        
               ATTR=(NOPROT)                                                    
         DFLD  'Function Group',                                       +        
               POS=(7,2),LTH=14,                                       +        
               ATTR=(PROT)                                                      
IDFKN1   DFLD  POS=(7,17),LTH=4,                                       +        
               ATTR=(NUM,NOPROT)                                                
         DFLD  '-',                                                    +        
               POS=(7,22),LTH=1,                                       +        
