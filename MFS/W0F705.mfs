         MFLD  FLD0102,LTH=0001,FILL=C'0'                                       
         MFLD  'T',LTH=0001                                                     
         MFLD  FLD0104,LTH=0001,FILL=C'7'                                       
         MFLD  FLD0106,LTH=0001,FILL=C'0'                                       
         MFLD  FLD0108,LTH=0001,FILL=C'5'                                       
         MFLD  '  ',LTH=0002                                                    
         MFLD  '07051',LTH=0005                                                 
         MFLD  (FLD0210,'++++++++'),LTH=0008,FILL=C' '                          
         MFLD  FLD0310,LTH=0008,FILL=C' '                                       
         MFLD  (FLD0225,'++++++++'),LTH=0008,FILL=C' '                          
         MFLD  FLD0325,LTH=0008,FILL=C' '                                       
         MFLD  (FLD0240,'+'),LTH=0001,FILL=C' '                                 
         MFLD  FLD0502,LTH=0005,FILL=C'0',JUST=R                                
         DO    14,SUF=06                                                        
         MFLD  (COL02,'+++++'),LTH=0005,FILL=C'0',JUST=R                        
         MFLD  (COL08,'++++++++++++++++++++++++++++++++++++++++++++++++*        
