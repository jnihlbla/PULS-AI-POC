*          DATA SET W0F705FII0 AT LEVEL 009 AS OF 89/10/25                      
*                                                                               
         PRINT NOGEN                                                            
W0F705   FMT                                                                    
         DEV   TYPE=(3270,2),                                          *        
               FEAT=IGNORE,                                            *        
               PFK=(FLDPFK,'W0T501  ','W0T501  ','W0T501  ','R05T01  ',*        
