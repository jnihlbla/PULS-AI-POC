FLD0240  DFLD  POS=(02,40),LTH=0001,ATTR=(ALPHA)                                
FLD0310  DFLD  POS=(03,10),LTH=0008,ATTR=(NUM,PROT,MOD)                         
FLD0325  DFLD  POS=(03,25),LTH=0008,ATTR=(NUM,PROT,MOD)                         
FLD0502  DFLD  POS=(05,02),LTH=0005,ATTR=(NUM,MOD)                              
         DO    14,SUF=06                                                        
COL02    DFLD  POS=(06,02),LTH=0005,ATTR=(NUM,MOD)                              
COL08    DFLD  POS=(06,08),LTH=0071,ATTR=(ALPHA)                                
         ENDDO                                                                  
         DFLD  '13 SÄKERHET     14 RUTIN UPPD   15 VISA RUTINER 16 JOBB*        
                UPPD    17 ÄNDRA DATA',                                *        
               POS=(21,02),LTH=0077,ATTR=(NUM,PROT)                             
