         DFLD  '2. Year',                                              +        
               POS=(7,2),LTH=7,                                        +        
               ATTR=(PROT)                                                      
DATHISY  DFLD  POS=(7,10),LTH=4,                                       +        
               ATTR=(PROT)                                                      
FLTHISY  DFLD  POS=(7,32),LTH=1,                                       +        
               ATTR=(NOPROT)                                                    
         DFLD  '(Y or N)',                                             +        
               POS=(7,43),LTH=8,                                       +        
               ATTR=(PROT)                                                      
         DFLD  '3. Year',                                              +        
               POS=(8,2),LTH=7,                                        +        
               ATTR=(PROT)                                                      
DALASTY  DFLD  POS=(8,10),LTH=4,                                       +        
               ATTR=(PROT)                                                      
FLLASTY  DFLD  POS=(8,32),LTH=1,                                       +        
               ATTR=(NOPROT)                                                    
         DFLD  '(Y or N)',                                             +        
               POS=(8,43),LTH=8,                                       +        
               ATTR=(PROT)                                                      
         DFLD  '13',                                                   +        
               POS=(21,2),LTH=2,                                       +        
               ATTR=(PROT)                                                      
