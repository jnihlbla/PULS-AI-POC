         DIV   TYPE=INOUT                                                       
FORMAT   DPAGE CURSOR=((6,32)),                                        +        
               FILL=NONE                                                        
FLD0102  DFLD  POS=(1,2),LTH=1,                                        +        
               ATTR=(NOPROT)                                                    
FLD0104  DFLD  POS=(1,4),LTH=1,                                        +        
               ATTR=(NUM,NOPROT,MOD)                                            
FLD0106  DFLD  POS=(1,6),LTH=1,                                        +        
               ATTR=(NUM,NOPROT,MOD)                                            
FLD0108  DFLD  POS=(1,8),LTH=1,                                        +        
               ATTR=(NUM,NOPROT,MOD)                                            
         DFLD  'BALANCE-LOG SELECTION',                                +        
               POS=(1,11),LTH=21,                                      +        
               ATTR=(PROT)                                                      
FLD0141  DFLD  POS=(1,41),LTH=40,                                      +        
               ATTR=(PROT,HI)                                                   
         DFLD  'Userid',                                               +        
               POS=(2,2),LTH=6,                                        +        
               ATTR=(NUM,PROT)                                                  
USERIN   DFLD  POS=(2,9),LTH=8,                                        +        
               ATTR=(PROT)                                                      
USERUT   DFLD  POS=(3,9),LTH=8,                                        +        
               ATTR=(PROT,MOD)                                                  
         DFLD  'Selection parameter menu;',                            +        
               POS=(5,2),LTH=25,                                       +        
               ATTR=(PROT)                                                      
         DFLD  '1. Partno',                                            +        
               POS=(6,2),LTH=9,                                        +        
               ATTR=(PROT)                                                      
IDARTNR  DFLD  POS=(6,32),LTH=9,                                       +        
