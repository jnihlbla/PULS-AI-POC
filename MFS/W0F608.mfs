*          DATA SET W0F608FII0 AT LEVEL 001 AS OF 89/01/19                      
         PRINT NOGEN                                                            
W0F608   FMT                                                                    
         DEV   TYPE=(3270,2),                                          *        
               FEAT=IGNORE,                                            *        
               PFK=(FLDPFK,'W0T501  ','W0T501  ','W0T501  ','W0T501  ',*        
               'W0T501  ','W0T501  ','W0T501  ','W0T501  ','W0T501  ', *        
               'WHELP   ','W0T501  ','/RCL.   ','W0T501  ','W0T501  ', *        
               'W0T501  ','W0T501  ','W0T501  ','W0T501  ','W0T501  ', *        
               'W0T608  ','W0T501  ','WHELP   ','W0T501  ','/RCL.   '),*        
               DSCA=X'0080',SYSMSG=FSYSMSG                                      
         DIV   TYPE=INOUT                                                       
         DPAGE CURSOR=((01,02)),                                       *        
               FILL=NONE                                                        
         ALPHA 'abcdefghijklmnopqrstuvxyzåäö'                                   
FLD0102  DFLD  POS=(01,02),LTH=0001,ATTR=(ALPHA,NOPROT,MOD)                     
FLD0104  DFLD  POS=(01,04),LTH=0001,ATTR=(NUM,MOD)                              
FLD0106  DFLD  POS=(01,06),LTH=0001,ATTR=(NUM,MOD)                              
FLD0108  DFLD  POS=(01,08),LTH=0001,ATTR=(NUM,MOD)                              
         DFLD  'Printning Dirlevunderlag ',                            *        
               POS=(01,10),LTH=0025,ATTR=(NUM,PROT)                             
FLD0141  DFLD  POS=(01,41),LTH=0040,ATTR=(NUM,PROT,HI)                          
         DFLD  'Sätt X framför ditt val nedan. Endast ETT val',        *        
               POS=(05,02),LTH=0045,ATTR=(NUM,PROT)                             
         DFLD  'Val',                                                  *        
               POS=(08,03),LTH=0003,ATTR=(NUM,PROT)                             
FLD1004  DFLD  POS=(10,04),LTH=0001,ATTR=(ALPHA,MOD)                            
         DFLD  'Starta printning av DAGORDER      ',                   *        
               POS=(10,08),LTH=0034,ATTR=(NUM,PROT)                             
FLD1104  DFLD  POS=(11,04),LTH=0001,ATTR=(ALPHA,MOD)                            
         DFLD  'Starta printning av KVANTORDER    ',                   *        
               POS=(11,08),LTH=0034,ATTR=(NUM,PROT)                             
         DFLD  '13              14              15              16     *        
                        17              18              19             *        
                20 Dirlevprint  21              10 WHELP',             *        
               POS=(21,02),LTH=0152,ATTR=(NUM,PROT)                             
FLD2302  DFLD  POS=(23,02),LTH=0055,ATTR=(NUM,PROT,HI)                          
         DFLD  ' VCP ',POS=(23,58)                                              
FLD2364  DFLD  POS=(23,64),LTH=008,ATTR=(NUM,PROT)                              
FLD2373  DFLD  POS=(23,73),LTH=008,ATTR=(NUM,PROT)                              
FSYSMSG  DFLD  POS=(24,02),LTH=0079,ATTR=(NUM,PROT,HI)                          
         FMTEND                                                                 
         EJECT                                                                  
W0O60801 MSG   TYPE=OUTPUT,                                            *        
               SOR=(W0F608,IGNORE),                                    *        
               OPT=2,                                                  *        
               NXT=W0I60801,                                           *        
               FILL=PT,                                                *        
               PAGE=NO                                                          
         SEG                                                                    
         MFLD  FLD0102,LTH=0001                                                 
         MFLD  FLD0104,LTH=0001                                                 
         MFLD  FLD0106,LTH=0001                                                 
         MFLD  FLD0108,LTH=0001                                                 
         MFLD  FLD0141,LTH=0040                                                 
         MFLD  FLD1004,LTH=0003,ATTR=YES                                        
         MFLD  FLD1104,LTH=0003,ATTR=YES                                        
         MFLD  FLD2302,LTH=0055                                                 
         MFLD  (FLD2364,DATE4)                                                  
         MFLD  (FLD2373,TIME)                                                   
         MFLD  (FSYSMSG,' '),LTH=0001                                           
         MSGEND                                                                 
         EJECT                                                                  
W0O60802 MSG   TYPE=OUTPUT,                                            *        
               SOR=(W0F608,IGNORE),                                    *        
               OPT=2,                                                  *        
               NXT=W0I60801,                                           *        
               FILL=PT,                                                *        
               PAGE=NO                                                          
         SEG                                                                    
         MFLD  FLD0102,LTH=0001                                                 
         MFLD  FLD0104,LTH=0001                                                 
         MFLD  FLD0106,LTH=0001                                                 
         MFLD  FLD0108,LTH=0001                                                 
         MFLD  FLD0141,LTH=0040                                                 
         MFLD  FLD0210,LTH=0002                                                 
         MFLD  FLD0310,LTH=0008                                                 
         MFLD  FLD0225,LTH=0002                                                 
         MFLD  FLD0325,LTH=0008                                                 
         MFLD  (FLD1004,' '),LTH=0001                                           
         MFLD  (FLD1104,' '),LTH=0001                                           
         MFLD  FLD2302,LTH=0055                                                 
         MFLD  (FLD2364,DATE4)                                                  
         MFLD  (FLD2373,TIME)                                                   
         MFLD  (FSYSMSG,' '),LTH=0001                                           
         MSGEND                                                                 
         EJECT                                                                  
W0I60801 MSG   TYPE=INPUT,                                             *        
               SOR=W0F608,                                             *        
               OPT=2,                                                  *        
               NXT=W0O60801                                                     
         SEG                                                                    
         MFLD  FLDPFK,LTH=008,FILL=NULL                                         
         MFLD  'W',LTH=0001                                                     
         MFLD  FLD0102,LTH=0001,FILL=C'0'                                       
         MFLD  'T',LTH=0001                                                     
         MFLD  FLD0104,LTH=0001,FILL=C'6'                                       
         MFLD  FLD0106,LTH=0001,FILL=C'0'                                       
         MFLD  FLD0108,LTH=0001,FILL=C'8'                                       
         MFLD  '  ',LTH=002                                                     
         MFLD  '06081',LTH=0005                                                 
         MFLD  (FLD1004,'+'),LTH=0001,FILL=C' '                                 
         MFLD  (FLD1104,'+'),LTH=0001,FILL=C' '                                 
         MSGEND                                                                 
         EJECT                                                                  
         END                                                                    
