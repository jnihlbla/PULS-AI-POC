               FEAT=IGNORE,                                            +        
               SYSMSG=FSYSMSG,                                         +        
               DSCA=X'0080'                                                     
         DIV   TYPE=INOUT                                                       
FORMAT   DPAGE FILL=NONE                                                        
FLD0202  DFLD  POS=(2,2),LTH=13,                                       +        
