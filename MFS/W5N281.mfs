         TITLE 'Urval till ACS                  '                               
W5N281   FMT                                                                    
         DEV   TYPE=(3270,2),                                          +        
               FEAT=IGNORE,                                            +        
               SYSMSG=FSYSMSG,                                         +        
               DSCA=X'0080',                                           +        
               PFK=(FLDPFK,                                            +        
               1='W0T501  ',                                           +        
               2='W0T501  ',                                           +        
               3='W0T501  ',                                           +        
               4='W0T501  ',                                           +        
               5='W0T501  ',                                           +        
               6='W0T501  ',                                           +        
               7='W0T501  ',                                           +        
               8='W0T501  ',                                           +        
               9='W0T501  ',                                           +        
               10='WHELP   ',                                          +        
               11='W5T281U ',                                          +        
               12='/RCL.   ',                                          +        
               13='W0T501  ',                                          +        
               14='W0T501  ',                                          +        
               15='W0T501  ',                                          +        
               16='W0T501  ',                                          +        
               17='W0T501  ',                                          +        
               18='W0T501  ',                                          +        
               19='W0T501  ',                                          +        
               20='W0T501  ',                                          +        
               21='W0T501  ',                                          +        
               22='WHELP   ',                                          +        
               23='W0T501  ',                                          +        
               24='/RCL.   ')                                                   
         DIV   TYPE=INOUT                                                       
FORMAT   DPAGE CURSOR=((7,46)),                                        +        
               FILL=NONE                                                        
FLD0102  DFLD  POS=(1,2),LTH=1,                                        +        
               ATTR=(NOPROT)                                                    
FLD0104  DFLD  POS=(1,4),LTH=1,                                        +        
               ATTR=(NUM,NOPROT,MOD)                                            
FLD0106  DFLD  POS=(1,6),LTH=1,                                        +        
               ATTR=(NUM,NOPROT,MOD)                                            
FLD0108  DFLD  POS=(1,8),LTH=1,                                        +        
               ATTR=(NUM,NOPROT,MOD)                                            
         DFLD  'DOWNLOAD SELECTION',                                   +        
               POS=(1,11),LTH=18,                                      +        
               ATTR=(PROT)                                                      
FLD0141  DFLD  POS=(1,41),LTH=40,                                      +        
               ATTR=(PROT,HI)                                                   
         DFLD  'DC',                                                   +        
               POS=(2,2),LTH=2,                                        +        
               ATTR=(NUM,PROT)                                                  
DGIA0000 DFLD  POS=(2,5),LTH=2,                                        +        
               ATTR=(PROT)                                                      
DGIA0001 DFLD  POS=(3,5),LTH=2,                                        +        
               ATTR=(PROT,MOD)                                                  
         DFLD  'Selection will be performed with the following exclusio+        
               ns;',                                                   +        
               POS=(5,2),LTH=58,                                       +        
               ATTR=(PROT)                                                      
         DFLD  '1. Average cost less than',                            +        
               POS=(7,2),LTH=25,                                       +        
               ATTR=(PROT)                                                      
         DFLD  ':',                                                    +        
               POS=(7,44),LTH=1,                                       +        
               ATTR=(PROT)                                                      
AVCOST   DFLD  POS=(7,46),LTH=10,                                      +        
               ATTR=(NUM,NOPROT)                                                
         DFLD  'and',                                                  +        
               POS=(7,63),LTH=3,                                       +        
               ATTR=(PROT)                                                      
         DFLD  'Extended average cost less than',                      +        
               POS=(8,5),LTH=31,                                       +        
               ATTR=(PROT)                                                      
         DFLD  ':',                                                    +        
               POS=(8,44),LTH=1,                                       +        
               ATTR=(PROT)                                                      
EXAVCOST DFLD  POS=(8,46),LTH=16,                                      +        
               ATTR=(NUM,NOPROT)                                                
         DFLD  '2. No activity prior physical stocktaking :',          +        
               POS=(9,2),LTH=43,                                       +        
               ATTR=(PROT)                                                      
FLONHAND DFLD  POS=(9,46),LTH=1,                                       +        
               ATTR=(NOPROT)                                                    
         DFLD  '(Y or N)',                                             +        
               POS=(9,50),LTH=8,                                       +        
               ATTR=(PROT)                                                      
         DFLD  '3. Bufferparts not compulsory',                        +        
               POS=(10,2),LTH=29,                                      +        
               ATTR=(PROT)                                                      
         DFLD  ':',                                                    +        
               POS=(10,44),LTH=1,                                      +        
               ATTR=(PROT)                                                      
FLBUFFER DFLD  POS=(10,46),LTH=1,                                      +        
               ATTR=(NOPROT)                                                    
         DFLD  '(Y or N)',                                             +        
               POS=(10,50),LTH=8,                                      +        
               ATTR=(PROT)                                                      
         DFLD  'Download ACS:',                                        +        
               POS=(17,2),LTH=13,                                      +        
               ATTR=(PROT)                                                      
FLLOAD   DFLD  POS=(17,16),LTH=1,                                      +        
               ATTR=(NOPROT)                                                    
         DFLD  '(Y or N)',                                             +        
               POS=(17,20),LTH=8,                                      +        
               ATTR=(PROT)                                                      
         DFLD  'F10=WHELP  F11=Start process',                         +        
               POS=(21,2),LTH=28,                                      +        
               ATTR=(PROT)                                                      
FLD2302  DFLD  POS=(22,2),LTH=55,                                      +        
               ATTR=(PROT,HI)                                                   
         DFLD  'VCCS',                                                 +        
               POS=(22,59),LTH=4,                                      +        
               ATTR=(PROT)                                                      
FLD2364  DFLD  POS=(22,64),LTH=8,                                      +        
               ATTR=(PROT)                                                      
FLD2373  DFLD  POS=(22,73),LTH=8,                                      +        
               ATTR=(PROT)                                                      
FSYSMSG  DFLD  POS=(23,2),LTH=79,                                      +        
               ATTR=(PROT,HI)                                                   
         FMTEND                                                                 
W5O281N1 MSG   TYPE=OUTPUT,                                            +        
               SOR=(W5N281,IGNORE),                                    +        
               OPT=2,                                                  +        
               NXT=W5I281N1,                                           +        
               FILL=PT                                                          
MOD      LPAGE SOR=FORMAT                                                       
         SEG                                                                    
         MFLD  FLD0102,                                                +        
               LTH=1                                                            
         MFLD  FLD0104,                                                +        
               LTH=1                                                            
         MFLD  FLD0106,                                                +        
               LTH=1                                                            
         MFLD  FLD0108,                                                +        
               LTH=1                                                            
         MFLD  FLD0141,                                                +        
               LTH=40                                                           
         MFLD  DGIA0000,                                               +        
               LTH=2                                                            
         MFLD  DGIA0001,                                               +        
               LTH=2                                                            
         MFLD  AVCOST,                                                 +        
               LTH=12,                                                 +        
               ATTR=(YES)                                                       
         MFLD  EXAVCOST,                                               +        
               LTH=18,                                                 +        
               ATTR=(YES)                                                       
         MFLD  FLONHAND,                                               +        
               LTH=3,                                                  +        
               ATTR=(YES)                                                       
         MFLD  FLBUFFER,                                               +        
               LTH=3,                                                  +        
               ATTR=(YES)                                                       
         MFLD  FLLOAD,                                                 +        
               LTH=3,                                                  +        
               ATTR=(YES)                                                       
         MFLD  FLD2302,                                                +        
               LTH=55                                                           
         MFLD  (FLD2364,                                               +        
               DATE4)                                                           
         MFLD  (FLD2373,                                               +        
               TIME)                                                            
         MFLD  (FSYSMSG,                                               +        
               ' '),                                                   +        
               LTH=1                                                            
         MSGEND                                                                 
W5I281N1 MSG   TYPE=INPUT,                                             +        
               SOR=(W5N281),                                           +        
               OPT=2,                                                  +        
               NXT=W5O281N1                                                     
MID      LPAGE SOR=(FORMAT)                                                     
         SEG                                                                    
         MFLD  FLDPFK,                                                 +        
               LTH=8,                                                  +        
               FILL=NULL                                                        
         MFLD  'W',                                                    +        
               LTH=1                                                            
         MFLD  FLD0102,                                                +        
               LTH=1,                                                  +        
               FILL=X'F5'                                                       
         MFLD  'T',                                                    +        
               LTH=1                                                            
         MFLD  FLD0104,                                                +        
               LTH=1,                                                  +        
               FILL=X'F2'                                                       
         MFLD  FLD0106,                                                +        
               LTH=1,                                                  +        
               FILL=X'F8'                                                       
         MFLD  FLD0108,                                                +        
               LTH=1,                                                  +        
               FILL=X'F1'                                                       
         MFLD  '  ',                                                   +        
               LTH=2                                                            
         MFLD  '52812',                                                +        
               LTH=5                                                            
         MFLD  (DGIA0000,                                              +        
               '++'),                                                  +        
               LTH=2,                                                  +        
               JUST=R,                                                 +        
               FILL=X'F0'                                                       
         MFLD  DGIA0001,                                               +        
               LTH=2,                                                  +        
               JUST=R,                                                 +        
               FILL=X'F0'                                                       
         MFLD  (AVCOST,                                                +        
               '++++++++++'),                                          +        
               LTH=10,                                                 +        
               JUST=R,                                                 +        
               FILL=X'F0'                                                       
         MFLD  (EXAVCOST,                                              +        
               '++++++++++++++++'),                                    +        
               LTH=16,                                                 +        
               JUST=R,                                                 +        
               FILL=X'F0'                                                       
         MFLD  (FLONHAND,                                              +        
               '+'),                                                   +        
               LTH=1,                                                  +        
               FILL=X'40'                                                       
         MFLD  (FLBUFFER,                                              +        
               '+'),                                                   +        
               LTH=1,                                                  +        
               FILL=X'40'                                                       
         MFLD  (FLLOAD,                                                +        
               '+'),                                                   +        
               LTH=1,                                                  +        
               FILL=X'40'                                                       
         MSGEND                                                                 
         END                                                                    
