               POS=(18,02),LTH=0018,ATTR=(NUM,PROT)                             
FLD1821  DFLD  POS=(18,21),LTH=0002,ATTR=(NUM)                                  
         DFLD  'Måttkod           ',                                   *        
               POS=(19,02),LTH=0018,ATTR=(NUM,PROT)                             
FLD1921  DFLD  POS=(19,21),LTH=0001,ATTR=(ALPHA)                                
