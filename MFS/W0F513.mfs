               POS=(12,51),LTH=0009,ATTR=(NUM,PROT)                             
FLD1261  DFLD  POS=(12,61),LTH=0006,ATTR=(NUM,PROT)                             
         DFLD  'ISO språkkod      ',                                   *        
               POS=(13,02),LTH=0018,ATTR=(NUM,PROT)                             
FLD1321  DFLD  POS=(13,21),LTH=0008,ATTR=(ALPHA)                                
         DFLD  'Ändr-tid ',                                            *        
               POS=(13,51),LTH=0009,ATTR=(NUM,PROT)                             
FLD1361  DFLD  POS=(13,61),LTH=0008,ATTR=(NUM,PROT)                             
         DFLD  'Terminal          ',                                   *        
               POS=(14,02),LTH=0018,ATTR=(NUM,PROT)                             
FLD1421  DFLD  POS=(14,21),LTH=0008,ATTR=(ALPHA)                                
         DFLD  'Printerplacering  ',                                   *        
               POS=(15,02),LTH=0018,ATTR=(NUM,PROT)                             
FLD1521  DFLD  POS=(15,21),LTH=0003,ATTR=(NUM,PROT)                             
