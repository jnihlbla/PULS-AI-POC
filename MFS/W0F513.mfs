*        MPP-USER-INIT-SYSTEM EGEN-ÄNDRING                                      
*                                                                               
         PRINT NOGEN                                                            
W0F513   FMT                                                                    
         DEV   TYPE=(3270,2),                                          *        
               FEAT=IGNORE,                                            *        
               PFK=(FLDPFK,'W0T551U ','W0T501  ','W0T513U ','W0T501  ',*        
               'W0T501  ','W0T501  ','W0T513 7','W0T513 8','W0T501  ', *        
               'WHELP   ','W0T513U ','/RCL.   ','W0T513  ','W0T512  ', *        
               'W0T513  ','W0T514  ','W0T515  ','W0T501  ','W0T501  ', *        
               'W0T501  ','W0T501  ','WHELP   ','W0T513U ','/RCL.   '),*        
               DSCA=X'0080',SYSMSG=FSYSMSG                                      
         DIV   TYPE=INOUT                                                       
         DPAGE CURSOR=((02,11)),                                       *        
