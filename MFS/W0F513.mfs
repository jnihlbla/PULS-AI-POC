               POS=(10,02),LTH=0018,ATTR=(NUM,PROT)                             
FLD1021  DFLD  POS=(10,21),LTH=0002,ATTR=(NUM,PROT)                             
         DFLD  'Printer           ',                                   *        
               POS=(11,02),LTH=0018,ATTR=(NUM,PROT)                             
FLD1121  DFLD  POS=(11,21),LTH=0008,ATTR=(ALPHA)                                
         DFLD  'Start-dag',                                            *        
