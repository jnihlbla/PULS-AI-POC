W0I51301 MSG   TYPE=INPUT,                                             *        
               SOR=W0F513,                                             *        
               OPT=2,                                                  *        
               NXT=W0O51301                                                     
         SEG                                                                    
         MFLD  FLDPFK,LTH=0008,FILL=NULL                                        
         MFLD  'W',LTH=1                                                        
         MFLD  FLD0102,LTH=0001,FILL=C'0'                                       
         MFLD  'T',LTH=1                                                        
         MFLD  FLD0104,LTH=0001,FILL=C'5'                                       
         MFLD  FLD0106,LTH=0001,FILL=C'1'                                       
         MFLD  FLD0108,LTH=0001,FILL=C'3'                                       
         MFLD  '  ',LTH=2                                                       
         MFLD  '05131',LTH=5                                                    
         MFLD  (FLD0211,'++++++++'),LTH=0008,FILL=C' '                          
         MFLD  FLD0311,LTH=0008,FILL=C' '                                       
         MFLD  (FLD0621,'+++++++++++++++++++++++++'),LTH=0025,FILL=C' '         
         MFLD  (FLD0721,'+++++'),LTH=0005,FILL=C' '                             
         MFLD  (FLD1021,'++'),LTH=0002,FILL=C' '                                
         MFLD  (FLD1121,'++++++++'),LTH=0008,FILL=C' '                          
         MFLD  (FLD1221,'++++++++'),LTH=0008,FILL=C' '                          
         MFLD  (FLD1321,'++'),LTH=0002,FILL=C' '                                
         MFLD  (FLD1421,'++++++++'),LTH=0008,FILL=C' '                          
         MFLD  (FLD1621,'++++++++++++++++++++'),LTH=0020,FILL=C' '              
