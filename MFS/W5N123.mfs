               ATTR=(PROT)                                                      
TEMFSINF DFLD  POS=(23,2),LTH=55,                                      +        
               ATTR=(ALPHA,PROT,HI)                                             
DATE     DFLD  POS=(23,64),LTH=8,                                      +        
