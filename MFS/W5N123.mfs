         FMTEND                                                                 
W5O123N1 MSG   TYPE=OUTPUT,                                            +        
               SOR=(W5N123,IGNORE),                                    +        
               OPT=2,                                                  +        
               NXT=W5I123N1,                                           +        
               FILL=PT                                                          
DGI00002 LPAGE SOR=(DGI00001)                                                   
         SEG                                                                    
         MFLD  FLD0102,                                                +        
               LTH=1                                                            
         MFLD  FLD0104,                                                +        
               LTH=1                                                            
         MFLD  FLD0106,                                                +        
               LTH=1                                                            
         MFLD  FLD0108,                                                +        
