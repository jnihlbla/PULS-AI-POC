FLD0108  DFLD  POS=(1,8),LTH=1,                                        +        
               ATTR=(NUM,NOPROT,MOD)                                            
         DFLD  'CURRENCY RATE',                                        +        
               POS=(1,12),LTH=13,                                      +        
