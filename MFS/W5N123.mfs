REGDAT   DFLD  POS=(7,58),                                             +        
               LTH=6,                                                  +        
               ATTR=(ALPHA,PROT)                                                
         ENDDO                                                                  
         DFLD  '13',                                                   +        
               POS=(21,2),LTH=2,                                       +        
