*        FORMAR FÖR LOGON TILL IMS (PROGRAM SAKNAS)                             
*                                                                               
         PRINT NOGEN                                                            
W0F501   FMT                                                                    
         DEV   TYPE=(3270,2),                                          *        
               FEAT=IGNORE,                                            *        
               PFK=(FLDPFK,'W0T501  ','WINFO   ','W0T501  ','W0T501  ',*        
               'W0T501  ','W0T501  ','W0T501  ','W0T501  ','W0T501  ', *        
               'WHELP   ','W0T501  ','/RCL.   ','W0T501  ','W0T501  ', *        
               'W0T501  ','W0T501  ','W0T501  ','W0T501  ','W0T501  ', *        
               'W0T501  ','W0T501  ','WHELP   ','W0T501  ','/RCL.   '),*        
               DSCA=X'0080',                                           *        
               SYSMSG=FSYSMSG                                                   
         STACK ON                                                               
         DIV   TYPE=INOUT                                                       
         DPAGE CURSOR=((04,12)),                                       *        
               FILL=NONE                                                        
         ALPHA 'abcdefghijklmnopqrstuvwxyzåäö'                                  
FLD0102  DFLD  POS=(01,02),LTH=0001,ATTR=(ALPHA)                                
FLD0104  DFLD  POS=(01,04),LTH=0001,ATTR=(NUM)                                  
FLD0106  DFLD  POS=(01,06),LTH=0001,ATTR=(NUM)                                  
FLD0108  DFLD  POS=(01,08),LTH=0001,ATTR=(NUM)                                  
         DFLD  'SIGN ON    ( Identify Yourself to the Computer )',     *        
               POS=(01,12),LTH=0048,ATTR=(NUM,PROT)                             
FLD0223  DFLD  POS=(02,23),LTH=0058,ATTR=(NUM,PROT)                             
         DFLD  'USER-ID: ',                                            *        
               POS=(04,02),LTH=0009,ATTR=(NUM,PROT)                             
FLD0412  DFLD  POS=(04,12),LTH=0007,ATTR=(ALPHA,MOD)                            
         DFLD  '( The Identification assigned to You by the Computer de*        
               p.)',                                                   *        
               POS=(04,23),LTH=0058,ATTR=(NUM,PROT)                             
FLD0523  DFLD  POS=(05,23),LTH=0058,ATTR=(NUM,PROT)                             
         DFLD  'PASSWORD:',                                            *        
               POS=(07,02),LTH=0009,ATTR=(NUM,PROT)                             
FLD0712  DFLD  POS=(07,12),LTH=0008,ATTR=(ALPHA,NODISP,MOD)                     
         DFLD  '( Your secret code )',                                 *        
               POS=(07,23),LTH=0020,ATTR=(NUM,PROT)                             
FLD0823  DFLD  POS=(08,23),LTH=0058,ATTR=(NUM,PROT)                             
FLD1002  DFLD  POS=(10,02),LTH=0079,ATTR=(NUM,PROT)                             
FLD1102  DFLD  POS=(11,02),LTH=0079,ATTR=(NUM,PROT)                             
FLD1202  DFLD  POS=(12,02),LTH=0079,ATTR=(NUM,PROT)                             
FLD1302  DFLD  POS=(13,02),LTH=0079,ATTR=(NUM,PROT)                             
FLD1402  DFLD  POS=(14,02),LTH=0079,ATTR=(NUM,PROT)                             
FLD1502  DFLD  POS=(15,02),LTH=0079,ATTR=(NUM,PROT)                             
FLD1602  DFLD  POS=(16,02),LTH=0079,ATTR=(NUM,PROT)                             
FLD1702  DFLD  POS=(17,02),LTH=0079,ATTR=(NUM,PROT)                             
FLD1802  DFLD  POS=(18,02),LTH=0079,ATTR=(NUM,PROT)                             
FLD1902  DFLD  POS=(19,02),LTH=0079,ATTR=(NUM,PROT)                             
FLD2002  DFLD  POS=(20,02),LTH=0079,ATTR=(NUM,PROT)                             
FLD2102  DFLD  POS=(21,02),LTH=0079,ATTR=(NUM,PROT)                             
FLD2202  DFLD  POS=(22,02),LTH=0079,ATTR=(NUM,PROT)                             
FLD2302  DFLD  POS=(23,02),LTH=0055,ATTR=(NUM,PROT,HI)                          
         DFLD  ' VCP ',POS=(23,58)                                              
FLD2364  DFLD  POS=(23,64),LTH=0008,ATTR=(NUM,PROT)                             
FLD2373  DFLD  POS=(23,73),LTH=0008,ATTR=(NUM,PROT)                             
FSYSMSG  DFLD  POS=(24,02),LTH=0079,ATTR=(NUM,PROT,HI)                          
         STACK OFF                                                              
         DEV   TYPE=3270-A7,                                           *        
               FEAT=IGNORE,                                            *        
               PFK=(FLDPFK,'W0T501  ','WINFO   ','W0T501  ','W0T501  ',*        
               'W0T501  ','W0T501  ','W0T501  ','W0T501  ','W0T501  ', *        
               'WHELP   ','W0T501  ','/RCL.   ','W0T501  ','W0T501  ', *        
               'W0T501  ','W0T501  ','W0T501  ','W0T501  ','W0T501  ', *        
               'W0T501  ','W0T501  ','WHELP   ','W0T501  ','/RCL.   '),*        
               DSCA=X'0080',                                           *        
               SYSMSG=FSYSMSG                                                   
         UNSTACK                                                                
         FMTEND                                                                 
         EJECT                                                                  
W0I50101 MSG   TYPE=INPUT,                                             *        
               SOR=W0F501,                                             *        
               OPT=2,                                                  *        
               NXT=WSLOGON                                                      
         SEG                                                                    
         MFLD  FLDPFK,LTH=0008,FILL=NULL                                        
         MFLD  FLD0102,LTH=0001,FILL=NULL                                       
         MFLD  FLD0104,LTH=0001,FILL=NULL                                       
         MFLD  FLD0106,LTH=0001,FILL=NULL                                       
         MFLD  FLD0108,LTH=0001,FILL=NULL                                       
         MFLD  '/SIGN ON ',LTH=0009                                             
         MFLD  FLD0412,LTH=0007,FILL=C' '                                       
         MFLD  ' ',LTH=0001                                                     
         MFLD  FLD0712,LTH=0008,FILL=NULL                                       
         MSGEND                                                                 
         EJECT                                                                  
W0I50102 MSG   TYPE=INPUT,                                             *        
               SOR=W0F501,                                             *        
               OPT=2,                                                  *        
               NXT=WELOGON                                                      
         SEG                                                                    
         MFLD  FLDPFK,LTH=0008,FILL=NULL                                        
         MFLD  FLD0102,LTH=0001,FILL=NULL                                       
         MFLD  FLD0104,LTH=0001,FILL=NULL                                       
         MFLD  FLD0106,LTH=0001,FILL=NULL                                       
         MFLD  FLD0108,LTH=0001,FILL=NULL                                       
         MFLD  '/SIGN ON ',LTH=0009                                             
         MFLD  FLD0412,LTH=0007,FILL=C' '                                       
         MFLD  ' ',LTH=0001                                                     
         MFLD  FLD0712,LTH=0008,FILL=NULL                                       
         MSGEND                                                                 
         EJECT                                                                  
WSLOGON  MSG   TYPE=OUTPUT,                                            *        
               SOR=(W0F501,IGNORE),                                    *        
               OPT=2,                                                  *        
               NXT=W0I50101,                                           *        
               FILL=PT,                                                *        
               PAGE=NO                                                          
         SEG                                                                    
         MFLD  FLD0102,LTH=0001                                                 
         MFLD  FLD0104,LTH=0001                                                 
         MFLD  FLD0106,LTH=0001                                                 
         MFLD  FLD0108,LTH=0001                                                 
         MFLD  (FLD0223,'( Tala om för datorn vem du är )'),           *        
               LTH=0058                                                         
         MFLD  (FLD0412,' '),LTH=0001                                           
         MFLD  (FLD0523,'( Den identifikation du fått av din data-avdel*        
               ning )'),                                               *        
               LTH=0058                                                         
         MFLD  (FLD0712,' '),LTH=0001                                           
         MFLD  (FLD0823,'( Ditt hemliga lösenord )'),                  *        
               LTH=0058                                                         
         MFLD  (FLD1002,'Följande meddelande kan fås på sista raden:   *        
                      Det betyder:              '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1102,'DFS058 XX:XX:XX SIGN COMMAND COMPLETED        *        
                      Bra! Välj bild.           '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1202,'DFSU905 XX:XX:XX ACF2: YOUR LOGONID MUST BE SU*        
               PPLIED Fel! Inget data ifyllt.   '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1302,'DFSU912 XX:XX:XX ACF2: LOGONID SPECIFIED DOES *        
               NOT EXIST                        '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1402,'                                              *        
                      Fel! Ej rätt userid.      '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1502,'DFSU933 XX:XX:XX ACF2: PASSWORD NOT MATCHED   *        
                      Fel! Ej rätt password.    '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1602,'DFSU936 XX:XX:XX ACF2: PASSWORD HAS EXPIRED   *        
                      Fel! Gammalt password.    '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1702,'                                              *        
                      Byt password, bild 05021  '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1802,'DFSU932 XX:XX:XX ACF2: LOGONID SUSPENDED      *        
                      Fel! Ring 662129.         '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1902,'DFSU934 XX:XX:XX ACF2: LOGONID SUSPENDED BECAU*        
               SE OF PASSWORD VIOLATION.        '),                    *        
               LTH=0079                                                         
         MFLD  (FLD2002,'                                              *        
                      Fel! Ring 662129.         '),                    *        
               LTH=0079                                                         
         MFLD  (FLD2102,'DFSU908 XX:XX:XX ACF2: YOUR LOGONID IS ALLREAD*        
               Y IN USE - CALL SECURITY         '),                    *        
               LTH=0079                                                         
         MFLD  (FLD2202,'                       Fel! Du är redan pålogg*        
               ad på en annan terminal.         '),                    *        
               LTH=0079                                                         
         MFLD  FLD2302,LTH=0055                                                 
         MFLD  (FLD2364,DATE4)                                                  
         MFLD  (FLD2373,TIME)                                                   
         MFLD  (FSYSMSG,' '),LTH=0001                                           
         MSGEND                                                                 
         EJECT                                                                  
WELOGON  MSG   TYPE=OUTPUT,                                            *        
               SOR=(W0F501,IGNORE),                                    *        
               OPT=2,                                                  *        
               NXT=W0I50102,                                           *        
               FILL=PT,                                                *        
               PAGE=NO                                                          
         SEG                                                                    
         MFLD  FLD0102,LTH=0001                                                 
         MFLD  FLD0104,LTH=0001                                                 
         MFLD  FLD0106,LTH=0001                                                 
         MFLD  FLD0108,LTH=0001                                                 
         MFLD  (FLD0223,'( Maak u bekent aan de Computer )'),          *        
               LTH=0058                                                         
         MFLD  (FLD0412,' '),LTH=0001                                           
         MFLD  (FLD0523,'( Uw Identifikatienummer )'),                 *        
               LTH=0058                                                         
         MFLD  (FLD0712,' '),LTH=0001                                           
         MFLD  (FLD0823,'( Uw passwoord )'),                           *        
               LTH=0058                                                         
         MFLD  (FLD1002,'You get one of these messages on the last line*        
               :      Explanation:              '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1102,'DFS058 XX:XX:XX SIGN COMMAND COMPLETED        *        
                      OK! Continue.             '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1202,'DFSU905 XX:XX:XX ACF2: YOUR LOGONID MUST BE SU*        
               PPLIED ERROR! No data given.     '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1302,'DFSU912 XX:XX:XX ACF2: LOGONID SPECIFIED DOES *        
               NOT EXIST                        '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1402,'                                              *        
                      ERROR! Wrong userid.      '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1502,'DFSU933 XX:XX:XX ACF2: PASSWORD NOT MATCHED   *        
                      ERROR! Wrong password.    '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1602,'DFSU936 XX:XX:XX ACF2: PASSWORD HAS EXPIRED   *        
                      ERROR! Password to old.   '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1702,'                                              *        
                      Change it, Picture 05022  '),                    *        
               LTH=0079                                                         
         MFLD  (FLD1802,'DFSU932 XX:XX:XX ACF2: LOGONID SUSPENDED      *        
                      ERROR! Call 00946 31662129'),                    *        
               LTH=0079                                                         
         MFLD  (FLD1902,'DFSU934 XX:XX:XX ACF2: LOGONID SUSPENDED BECAU*        
               SE OF PASSWORD VIOLATION.        '),                    *        
               LTH=0079                                                         
         MFLD  (FLD2002,'                                              *        
                      ERROR! Call 00946 31662129'),                    *        
               LTH=0079                                                         
         MFLD  (FLD2102,'DFSU908 XX:XX:XX ACF2: YOUR LOGONID IS ALLREAD*        
               Y IN USE - CALL SECURITY         '),                    *        
               LTH=0079                                                         
         MFLD  (FLD2202,'                       You are already in use *        
               at an other terminal.            '),                    *        
               LTH=0079                                                         
         MFLD  FLD2302,LTH=0055                                                 
         MFLD  (FLD2364,DATE4)                                                  
         MFLD  (FLD2373,TIME)                                                   
         MFLD  (FSYSMSG,' '),LTH=0001                                           
         MSGEND                                                                 
         END                                                                    
