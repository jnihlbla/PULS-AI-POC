         TITLE 'HELP INFORMATION FOR VCP SCREENS'                               
         PRINT ON,NOGEN                                                         
         ALPHA 'abcdefghijklmnopqrstuvwxyzˆÈ¸‰Â…'                               
W0N551   FMT                                                                    
         DEV   TYPE=(3270,2),                                          +        
               FEAT=IGNORE,                                            +        
               SYSMSG=FSYSMSG,                                         +        
               DSCA=X'0080',                                           +        
               PFK=(FLDPFK,                                            +        
               1='W0T501  ',                                           +        
               2='W0T501  ',                                           +        
               3='W0T551 3',                                           +        
               4='W0T501  ',                                           +        
               5='W0T501  ',                                           +        
               6='W0T501  ',                                           +        
               7='W0T551 7',                                           +        
               8='W0T551 8',                                           +        
               9='W0T501  ',                                           +        
               10='WHELP   ',                                          +        
               11='W0T501  ',                                          +        
               12='/RCL.   ',                                          +        
               13='W0T551  ',                                          +        
               14='W0T552  ',                                          +        
               15='W0T553  ',                                          +        
               16='W0T501  ',                                          +        
               17='W0T555  ',                                          +        
               18='W0T501  ',                                          +        
               19='W0T501  ',                                          +        
               20='W0T501  ',                                          +        
               21='W0T501  ',                                          +        
               22='WHELP   ',                                          +        
               23='W0T501  ',                                          +        
               24='/RCL.   ')                                                   
         DIV   TYPE=INOUT                                                       
         DPAGE CURSOR=((2,7)),                                         +        
               FILL=NONE                                                        
FLD0102  DFLD  POS=(1,2),LTH=1,                                        +        
               ATTR=(ALPHA,NOPROT,MOD)                                          
FLD0104  DFLD  POS=(1,4),LTH=1,                                        +        
               ATTR=(NUM,NOPROT)                                                
FLD0106  DFLD  POS=(1,6),LTH=1,                                        +        
               ATTR=(NUM,NOPROT)                                                
FLD0108  DFLD  POS=(1,8),LTH=1,                                        +        
               ATTR=(NUM,NOPROT)                                                
         DFLD  'HELP INFORMATION ',                                    +        
               POS=(1,12),LTH=17,                                      +        
               ATTR=(NUM,PROT)                                                  
FLD0141  DFLD  POS=(1,41),LTH=40,                                      +        
               ATTR=(NUM,PROT,HI)                                               
         DFLD  'Type',                                                 +        
               POS=(2,2),LTH=4,                                        +        
               ATTR=(NUM,PROT)                                                  
IDDOKTYI DFLD  POS=(2,7),LTH=8,                                        +        
               ATTR=(NOPROT)                                                    
         DFLD  'Id',                                                   +        
               POS=(2,17),LTH=2,                                       +        
               ATTR=(NUM,PROT)                                                  
IDDOKI   DFLD  POS=(2,20),LTH=8,                                       +        
               ATTR=(NOPROT)                                                    
IDDOKTYU DFLD  POS=(3,7),LTH=8,                                        +        
               ATTR=(NUM,PROT,MOD)                                              
IDDOKU   DFLD  POS=(3,20),LTH=8,                                       +        
               ATTR=(NUM,PROT,MOD)                                              
         DFLD  'Page',                                                 +        
               POS=(2,29),LTH=4,                                       +        
               ATTR=(NUM,PROT)                                                  
IDSID    DFLD  POS=(2,34),LTH=3,                                       +        
               ATTR=(NUM,NOPROT,MOD)                                            
FLD0501  DFLD  POS=(5,1),LTH=1200,                                     +        
               ATTR=(NUM,PROT)                                                  
         DFLD  'F3=Return       F7=First page   F8=Next page    F10=Whe+        
               lp                      ',                              +        
               POS=(21,02),                                            +        
               LTH=0079,                                               +        
               ATTR=(NUM,PROT)                                                  
FLD2302  DFLD  POS=(23,2),LTH=55,                                      +        
               ATTR=(NUM,PROT,HI)                                               
         DFLD  ' VCP ',POS=(23,58),                                    +        
               LTH=5,                                                  +        
               ATTR=(NUM,PROT)                                                  
FLD2364  DFLD  POS=(23,64),LTH=8,                                      +        
               ATTR=(NUM,PROT)                                                  
FLD2373  DFLD  POS=(23,73),LTH=8,                                      +        
               ATTR=(NUM,PROT)                                                  
FSYSMSG  DFLD  POS=(24,2),LTH=79,                                      +        
               ATTR=(NUM,PROT,HI)                                               
         FMTEND                                                                 
W0I551N1 MSG   TYPE=INPUT,                                             +        
               SOR=(W0N551),                                           +        
               OPT=2,                                                  +        
               NXT=W0O551N1                                                     
         SEG                                                                    
         MFLD  FLDPFK,                                                 +        
               LTH=8,                                                  +        
               FILL=NULL                                                        
         MFLD  'W',                                                    +        
               LTH=1                                                            
         MFLD  FLD0102,                                                +        
               LTH=1,                                                  +        
               FILL=X'F0'                                                       
         MFLD  'T',                                                    +        
               LTH=1                                                            
         MFLD  FLD0104,                                                +        
               LTH=1,                                                  +        
               FILL=X'F5'                                                       
         MFLD  FLD0106,                                                +        
               LTH=1,                                                  +        
               FILL=X'F5'                                                       
         MFLD  FLD0108,                                                +        
               LTH=1,                                                  +        
               FILL=X'F1'                                                       
         MFLD  '  ',                                                   +        
               LTH=2                                                            
         MFLD  '05512',                                                +        
               LTH=5                                                            
         MFLD  (IDDOKTYI,                                              +        
               '++++++++'),                                            +        
               LTH=8,                                                  +        
               FILL=X'40'                                                       
         MFLD  IDDOKTYU,                                               +        
               LTH=8                                                            
         MFLD  (IDDOKI,                                                +        
               '++++++++'),                                            +        
               LTH=8,                                                  +        
               FILL=X'40'                                                       
         MFLD  IDDOKU,                                                 +        
               LTH=8                                                            
         MFLD  (IDSID,                                                 +        
               '000'),                                                 +        
               LTH=3,                                                  +        
               JUST=R,                                                 +        
               FILL=X'F0'                                                       
         MSGEND                                                                 
W0O551N1 MSG   TYPE=OUTPUT,                                            +        
               SOR=(W0N551,IGNORE),                                    +        
               OPT=2,                                                  +        
               NXT=W0I551N1,                                           +        
               PAGE=NO,                                                +        
               FILL=PT                                                          
         SEG                                                                    
         MFLD  FLD0102,                                                +        
               LTH=1                                                            
         MFLD  FLD0104,                                                +        
               LTH=1                                                            
         MFLD  FLD0106,                                                +        
               LTH=1                                                            
         MFLD  FLD0108,                                                +        
               LTH=1                                                            
         MFLD  FLD0141,                                                +        
               LTH=40                                                           
         MFLD  IDDOKTYI,                                               +        
               LTH=8                                                            
         MFLD  IDDOKTYU,                                               +        
               LTH=8                                                            
         MFLD  IDDOKI,                                                 +        
               LTH=8                                                            
         MFLD  IDDOKU,                                                 +        
               LTH=8                                                            
         MFLD  IDSID,                                                  +        
               LTH=3                                                            
         MFLD  FLD0501,                                                +        
               LTH=1200                                                         
         MFLD  FLD2302,                                                +        
               LTH=55                                                           
         MFLD  (FLD2364,                                               +        
               DATE4)                                                           
         MFLD  (FLD2373,                                               +        
               TIME)                                                            
         MFLD  (FSYSMSG,                                               +        
               ' '),                                                   +        
               LTH=1                                                            
         MSGEND                                                                 
         END                                                                    
