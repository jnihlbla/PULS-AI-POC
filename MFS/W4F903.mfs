         MFLD  FLD0337,LTH=0001                                                 
         MFLD  FLD0402,LTH=0002                                                 
         MFLD  FLD0405,LTH=0001                                                 
         MFLD  FLD0410,LTH=0002                                                 
         MFLD  FLD0413,LTH=0001                                                 
         DO    14,SUF=06                                                        
         MFLD  COL04,LTH=0067                                                   
