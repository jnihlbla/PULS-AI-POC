*          DATA SET W4F903FII0 AT LEVEL 001 AS OF 89/02/09                      
         PRINT NOGEN                                                            
W4F903   FMT                                                                    
         DEV   TYPE=(3270,2),                                          *        
               FEAT=IGNORE,                                            *        
               PFK=(FLDPFK,'W0T501  ','W0T501  ','W0T501  ','W0T501  ',*        
               'W0T501  ','W0T501  ','W4T903 7','W4T903 8','W0T501  ', *        
               'WHELP   ','W0T501  ','/RCL.   ','W4T901  ','W4T902  ', *        
