         MFLD  FLD0104,LTH=0001,FILL=C'9'                                       
         MFLD  FLD0106,LTH=0001,FILL=C'0'                                       
         MFLD  FLD0108,LTH=0001,FILL=C'3'                                       
         MFLD  '  ',LTH=0002                                                    
         MFLD  '49031',LTH=0005                                                 
         MFLD  (FLD0208,'++++'),LTH=0004,FILL=C'0',JUST=R                       
         MFLD  FLD0308,LTH=0004,FILL=C'0'                                       
         MFLD  (FLD0218,'++++++'),LTH=0006,FILL=C'0',JUST=R                     
         MFLD  FLD0318,LTH=0006,FILL=C'0'                                       
         MFLD  (FLD0228,'++'),LTH=0002,FILL=C'0'                                
         MFLD  FLD0328,LTH=0002,FILL=C'0'                                       
         MFLD  (FLD0237,'+'),LTH=0001                                           
         MFLD  FLD0337,LTH=0001,FILL=C'0'                                       
