               POS=(02,13),LTH=0004,ATTR=(NUM,PROT)                             
FLD0218  DFLD  POS=(02,18),LTH=0006,ATTR=(NUM)                                  
FLD0318  DFLD  POS=(03,18),LTH=0006,ATTR=(NUM,PROT,MOD)                         
         DFLD  'Fk',                                                   *        
               POS=(02,25),LTH=0002,ATTR=(NUM,PROT)                             
FLD0228  DFLD  POS=(02,28),LTH=0002,ATTR=(NUM)                                  
FLD0328  DFLD  POS=(03,28),LTH=0002,ATTR=(NUM,PROT,MOD)                         
         DFLD  'Klass',                                                *        
               POS=(02,31),LTH=0005,ATTR=(NUM,PROT)                             
FLD0237  DFLD  POS=(02,37),LTH=0001,ATTR=(NUM)                                  
FLD0337  DFLD  POS=(03,37),LTH=0001,ATTR=(NUM,PROT,MOD)                         
FLD0402  DFLD  POS=(04,02),LTH=0002,ATTR=(NUM,PROT,MOD,NODISP)                  
FLD0405  DFLD  POS=(04,05),LTH=0001,ATTR=(NUM,PROT,MOD,NODISP)                  
FLD0410  DFLD  POS=(04,10),LTH=0002,ATTR=(NUM,PROT,MOD,NODISP)                  
FLD0413  DFLD  POS=(04,13),LTH=0001,ATTR=(NUM,PROT,MOD,NODISP)                  
         DFLD  'Kundnr    Fk    Klass   Frisl.   Startdag   Jämn       *        
                 Udda',                                                *        
               POS=(05,04),LTH=0061,ATTR=(NUM,PROT)                             
         DO    14,SUF=06                                                        
COL04    DFLD  POS=(06,04),LTH=0067,ATTR=(NUM,PROT)                             
         ENDDO                                                                  
         DFLD  '13 Aktiva order 14 Fys. avvik.  15 Ro-rel.fråga 16 Ro-r*        
               el.ändra 17              18              19             *        
                20              21              10 WHELP',             *        
               POS=(21,02),LTH=0152,ATTR=(NUM,PROT)                             
FLD2302  DFLD  POS=(23,02),LTH=0055,ATTR=(NUM,PROT,HI)                          
         DFLD  ' VCP ',POS=(23,58)                                              
FLD2364  DFLD  POS=(23,64),LTH=0008,ATTR=(NUM,PROT)                             
FLD2373  DFLD  POS=(23,73),LTH=0008,ATTR=(NUM,PROT)                             
FSYSMSG  DFLD  POS=(24,02),LTH=0079,ATTR=(NUM,PROT,HI)                          
         FMTEND                                                                 
         EJECT                                                                  
W4O90301 MSG   TYPE=OUTPUT,                                            *        
               SOR=(W4F903,IGNORE),                                    *        
               OPT=2,                                                  *        
               NXT=W4I90301,                                           *        
               FILL=PT,                                                *        
               PAGE=NO                                                          
