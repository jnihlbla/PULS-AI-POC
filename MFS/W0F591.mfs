*        FORMAT FÖR ATT TESTA PROGRAM UTAN EGNA FORMAT                          
*                                                                               
         PRINT NOGEN                                                            
W0F591   FMT                                                                    
         DEV   TYPE=(3270,2),                                          *        
               FEAT=IGNORE,                                            *        
               PFK=(FLDPFK,'W0T501  ','W0T501  ','W0T501  ','W0T501  ',*        
               'W0T501  ','W0T501  ','W0T501  ','W0T501  ','W0T501  ', *        
               'WHELP   ','W0T501  ','/RCL.   ','W0T501  ','W0T501  ', *        
               'W0T501  ','W0T501  ','W0T501  ','W0T501  ','W0T501  ', *        
               'W0T501  ','W0T501  ','WHELP   ','W0T501  ','/RCL.   '),*        
               DSCA=X'0080',SYSMSG=FSYSMSG                                      
         DIV   TYPE=INOUT                                                       
         DPAGE CURSOR=((02,02)),                                       *        
               FILL=NONE                                                        
         ALPHA 'abcdefghijklmnopqrstuvwxyzåäöé'                                 
         DFLD  'Format för att testa program utan eget format',        *        
               POS=(01,02)                                                      
FLD0102  DFLD  POS=(02,02),LTH=0013,ATTR=(ALPHA,NOPROT,MOD)                     
         DFLD  'KDTRANS+iIDTRANS+KDMFSFOR=13 pos. (Rad3-22 data)',     *        
               POS=(02,16)                                                      
FLD0201  DFLD  POS=(03,01),LTH=1600,ATTR=(ALPHA,NOPROT,MOD)                     
FLD2302  DFLD  POS=(23,02),LTH=0055,ATTR=(NUM,PROT,HI)                          
         DFLD  ' VCP ',POS=(23,58)                                              
FLD2364  DFLD  POS=(23,64),LTH=0008,ATTR=(NUM,PROT)                             
FLD2373  DFLD  POS=(23,73),LTH=0008,ATTR=(NUM,PROT)                             
FSYSMSG  DFLD  POS=(24,02),LTH=0079,ATTR=(NUM,PROT,HI)                          
         FMTEND                                                                 
         EJECT                                                                  
W0O59101 MSG   TYPE=OUTPUT,                                            *        
               SOR=(W0F591,IGNORE),                                    *        
               OPT=2,                                                  *        
               NXT=W0I59101,                                           *        
               FILL=PT,                                                *        
               PAGE=NO                                                          
         SEG                                                                    
         MFLD  FLD0201,LTH=1600                                                 
         MFLD  FLD2302,LTH=0055                                                 
         MFLD  (FLD2364,DATE4)                                                  
         MFLD  (FLD2373,TIME)                                                   
         MFLD  (FSYSMSG,' '),LTH=1                                              
         MSGEND                                                                 
         EJECT                                                                  
W0I59101 MSG   TYPE=INPUT,                                             *        
               SOR=W0F591,                                             *        
               OPT=2,                                                  *        
               NXT=W0O59101                                                     
         SEG                                                                    
         MFLD  FLDPFK,LTH=0008,FILL=NULL                                        
         MFLD  FLD0102,LTH=0013,FILL=C' '                                       
         MFLD  FLD0201,LTH=1600,FILL=C' '                                       
         MSGEND                                                                 
         END                                                                    
