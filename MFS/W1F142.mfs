*          DATA SET W1F142FII0 AT LEVEL 001 AS OF 88/11/16                      
         PRINT NOGEN                                                            
W1F142   FMT                                                                    
         DEV   TYPE=(3270,2),                                          *        
               FEAT=IGNORE,                                            *        
               PFK=(FLDPFK,'W0T501  ','W0T501  ','W0T501  ','W0T501  ',*        
               'W0T501  ','W0T501  ','W1T142 7','W1T142 8','W0T501  ', *        
               'WHELP   ','W1T142U ','/RCL.   ','W0T501  ','W1T142  ', *        
