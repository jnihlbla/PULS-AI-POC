               'W0T501  ','W0T501  ','WHELP   ','W1T142U ','/RCL.   '),*        
               DSCA=X'0080',SYSMSG=FSYSMSG                                      
         DIV   TYPE=INOUT                                                       
         DPAGE CURSOR=((02,09)),                                       *        
               FILL=NONE                                                        
FLD0102  DFLD  POS=(01,02),LTH=0001,ATTR=(ALPHA,NOPROT,MOD)                     
FLD0104  DFLD  POS=(01,04),LTH=0001,ATTR=(NUM)                                  
FLD0106  DFLD  POS=(01,06),LTH=0001,ATTR=(NUM)                                  
FLD0108  DFLD  POS=(01,08),LTH=0001,ATTR=(NUM)                                  
         DFLD  'ARTIKELNUMMER PER PROJEKT/ ÄO',                        *        
               POS=(01,11),LTH=0029,ATTR=(NUM,PROT)                             
FLD0141  DFLD  POS=(01,41),LTH=0040,ATTR=(NUM,PROT,HI)                          
         DFLD  'BERED',                                                *        
               POS=(02,02),LTH=0005,ATTR=(NUM,PROT)                             
FLD0209  DFLD  POS=(02,09),LTH=0002,ATTR=(NUM)                                  
         DFLD  'ÄO',                                                   *        
               POS=(02,14),LTH=0002,ATTR=(NUM,PROT)                             
FLD0218  DFLD  POS=(02,18),LTH=0010,ATTR=(ALPHA)                                
         DFLD  'PROJ',                                                 *        
               POS=(02,29),LTH=0004,ATTR=(NUM,PROT)                             
FLD0236  DFLD  POS=(02,36),LTH=0004,ATTR=(ALPHA)                                
FLD0309  DFLD  POS=(03,09),LTH=0002,ATTR=(NUM,PROT,MOD)                         
FLD0318  DFLD  POS=(03,18),LTH=0010,ATTR=(ALPHA,PROT,MOD)                       
FLD0336  DFLD  POS=(03,36),LTH=0004,ATTR=(ALPHA,PROT,MOD)                       
FLD0410  DFLD  POS=(04,10),LTH=0010,ATTR=(ALPHA,PROT,MOD,NODISP)                
FLD0421  DFLD  POS=(04,21),LTH=0010,ATTR=(ALPHA,PROT,MOD,NODISP)                
FLD0432  DFLD  POS=(04,32),LTH=0009,ATTR=(NUM,PROT,MOD,NODISP)                  
FLD0442  DFLD  POS=(04,42),LTH=0009,ATTR=(NUM,PROT,MOD,NODISP)                  
         DFLD  '   ARTNR BENÄMNING       ÄO-NUMMER  FGRP RS SLEV PROJ F*        
               BER UPPF NY  KOM      S                                 *        
                                                BER     B',            *        
               POS=(05,05),LTH=0156,ATTR=(NUM,PROT)                             
         DO    13,SUF=07                                                        
COL02    DFLD  POS=(07,02),LTH=0001,ATTR=(ALPHA)                                
COL04    DFLD  POS=(07,04),LTH=0009,ATTR=(NUM,PROT,MOD)                         
COL14    DFLD  POS=(07,14),LTH=0015,ATTR=(NUM,PROT)                             
COL30    DFLD  POS=(07,30),LTH=0015,ATTR=(NUM,PROT)                             
COL47    DFLD  POS=(07,47),LTH=0001,ATTR=(ALPHA)                                
COL49    DFLD  POS=(07,49),LTH=0004,ATTR=(NUM,PROT)                             
COL54    DFLD  POS=(07,54),LTH=0004,ATTR=(NUM,PROT)                             
COL59    DFLD  POS=(07,59),LTH=0004,ATTR=(NUM,PROT)                             
COL64    DFLD  POS=(07,64),LTH=0004,ATTR=(NUM)                                  
COL70    DFLD  POS=(07,70),LTH=0002,ATTR=(NUM)                                  
COL73    DFLD  POS=(07,73),LTH=0001,ATTR=(NUM,PROT)                             
COL77    DFLD  POS=(07,77),LTH=0001,ATTR=(ALPHA)                                
COL79    DFLD  POS=(07,79),LTH=0001,ATTR=(ALPHA,PROT)                           
         ENDDO                                                                  
         DFLD  '13              14 ART PROJ/ÄO  15              16     *        
                        17              18              19             *        
                20              21               9         ',          *        
               POS=(21,02),LTH=0157,ATTR=(NUM,PROT)                             
FLD2302  DFLD  POS=(23,02),LTH=0055,ATTR=(NUM,PROT,HI)                          
         DFLD  ' VCP ',POS=(23,58)                                              
FLD2364  DFLD  POS=(23,64),LTH=0008,ATTR=(NUM,PROT)                             
FLD2373  DFLD  POS=(23,73),LTH=0008,ATTR=(NUM,PROT)                             
FSYSMSG  DFLD  POS=(24,02),LTH=0079,ATTR=(NUM,PROT,HI)                          
         FMTEND                                                                 
         EJECT                                                                  
W1O14201 MSG   TYPE=OUTPUT,                                            *        
               SOR=(W1F142,IGNORE),                                    *        
               OPT=2,                                                  *        
               NXT=W1I14201,                                           *        
               FILL=PT,                                                *        
               PAGE=NO                                                          
         SEG                                                                    
         MFLD  FLD0102,LTH=0001                                                 
         MFLD  FLD0104,LTH=0001                                                 
         MFLD  FLD0106,LTH=0001                                                 
         MFLD  FLD0108,LTH=0001                                                 
         MFLD  FLD0141,LTH=0040                                                 
         MFLD  FLD0209,LTH=0002                                                 
         MFLD  FLD0309,LTH=0002                                                 
         MFLD  FLD0218,LTH=0002                                                 
         MFLD  FLD0318,LTH=0010                                                 
         MFLD  FLD0236,LTH=0002                                                 
         MFLD  FLD0336,LTH=0004                                                 
         MFLD  FLD0410,LTH=0010                                                 
         MFLD  FLD0421,LTH=0010                                                 
         MFLD  FLD0432,LTH=0009                                                 
         MFLD  FLD0442,LTH=0009                                                 
         DO    13,SUF=07                                                        
         MFLD  COL02,LTH=0001                                                   
         MFLD  COL04,LTH=0011,ATTR=YES                                          
         MFLD  COL14,LTH=0025                                                   
         MFLD  COL30,LTH=0015                                                   
         MFLD  COL47,LTH=0004,ATTR=YES                                          
         MFLD  COL49,LTH=0006                                                   
         MFLD  COL54,LTH=0004                                                   
         MFLD  COL59,LTH=0006                                                   
         MFLD  COL64,LTH=0008,ATTR=YES                                          
         MFLD  COL70,LTH=0004,ATTR=YES                                          
         MFLD  COL73,LTH=0001                                                   
         MFLD  COL77,LTH=0004,ATTR=YES                                          
         MFLD  COL79,LTH=0001                                                   
         ENDDO                                                                  
         MFLD  FLD2302,LTH=0055                                                 
         MFLD  (FLD2364,DATE4)                                                  
         MFLD  (FLD2373,TIME)                                                   
         MFLD  (FSYSMSG,' '),LTH=0001                                           
         MSGEND                                                                 
         EJECT                                                                  
W1I14201 MSG   TYPE=INPUT,                                             *        
               SOR=W1F142,                                             *        
               OPT=2,                                                  *        
               NXT=W1O14201                                                     
         SEG                                                                    
         MFLD  FLDPFK,LTH=008,FILL=NULL                                         
         MFLD  'W',LTH=001                                                      
         MFLD  FLD0102,LTH=0001,FILL=C'1'                                       
         MFLD  'T',LTH=001                                                      
         MFLD  FLD0104,LTH=0001,FILL=C'1'                                       
         MFLD  FLD0106,LTH=0001,FILL=C'4'                                       
         MFLD  FLD0108,LTH=0001,FILL=C'2'                                       
         MFLD  '  ',LTH=002                                                     
         MFLD  '11421',LTH=0005                                                 
         MFLD  (FLD0209,'++'),LTH=0002,FILL=C'0',JUST=R                         
         MFLD  FLD0309,LTH=0002,FILL=C'0',JUST=R                                
         MFLD  (FLD0218,'++++++++++'),LTH=0010,FILL=C' ',JUST=L                 
         MFLD  FLD0318,LTH=0010,FILL=C' ',JUST=L                                
         MFLD  (FLD0236,'++++'),LTH=0004,FILL=C' ',JUST=L                       
         MFLD  FLD0336,LTH=0004,FILL=C' ',JUST=L                                
         MFLD  FLD0410,LTH=0010,FILL=C' ',JUST=L                                
         MFLD  FLD0421,LTH=0010,FILL=C' ',JUST=L                                
         MFLD  FLD0432,LTH=0009,FILL=C'0',JUST=R                                
         MFLD  FLD0442,LTH=0009,FILL=C'0',JUST=R                                
         DO    13,SUF=07                                                        
         MFLD  (COL02,'+'),LTH=0001,FILL=C' ',JUST=L                            
         MFLD  COL04,LTH=0009,FILL=C'0',JUST=R                                  
         MFLD  (COL47,'+'),LTH=0001,FILL=C' ',JUST=L                            
         MFLD  (COL64,'++++++'),LTH=0006,FILL=C' ',JUST=L                       
         MFLD  (COL70,'++'),LTH=0002,FILL=C'0',JUST=R                           
         MFLD  (COL77,'+'),LTH=0001,FILL=C' ',JUST=L                            
         ENDDO                                                                  
         MSGEND                                                                 
         EJECT                                                                  
         END                                                                    
