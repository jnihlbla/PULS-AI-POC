         PRINT NOGEN                                                            
W0F691   FMT                                                                    
         DEV   TYPE=(3270,2),                                          *        
               FEAT=IGNORE,                                            *        
               PFK=(FLDPFK,'W0T551U ','W0T501  ','W0T591U ','W0T501  ',*        
               'W0T501  ','W0T501  ','W0T501  ','W0T501  ','W0T501  ', *        
               'WHELP   ','W0T691U ','/RCL.   ','W0T501  ','W0T501  ', *        
               'W0T501  ','W0T501  ','W0T501  ','W0T501  ','W0T501  ', *        
               'W0T501  ','W0T501  ','WHELP   ','W0T691U ','/RCL.   '),*        
               DSCA=X'0080',SYSMSG=FSYSMSG                                      
         DIV   TYPE=INOUT                                                       
         DPAGE CURSOR=((02,10)),                                       *        
               FILL=NONE                                                        
         ALPHA 'abcdefghijklmnopqrstuvwxyzåäöé'                                 
         TITLE 'ÅTERSTART SPOOL-API             '                               
FLD0102  DFLD  POS=(01,02),LTH=0001,ATTR=(ALPHA,NOPROT,MOD)                     
FLD0104  DFLD  POS=(01,04),LTH=0001,ATTR=(NUM)                                  
FLD0106  DFLD  POS=(01,06),LTH=0001,ATTR=(NUM)                                  
FLD0108  DFLD  POS=(01,08),LTH=0001,ATTR=(NUM)                                  
         DFLD  'RESTART TO PRINTER OR FAX    ',                        *        
               POS=(01,11),LTH=0029,ATTR=(NUM,PROT)                             
FLD0141  DFLD  POS=(01,41),LTH=0040,ATTR=(NUM,PROT,HI)                          
         DFLD  'Printer',                                              *        
               POS=(02,02),LTH=0007,ATTR=(NUM,PROT)                             
FLD0210  DFLD  POS=(02,10),LTH=0008,ATTR=(ALPHA,MOD)                            
         DFLD  'Date',                                                 *        
               POS=(02,19),LTH=0004,ATTR=(NUM,PROT)                             
FLD0224  DFLD  POS=(02,24),LTH=0006,ATTR=(NUM,MOD)                              
         DFLD  'Time',                                                 *        
               POS=(02,31),LTH=0004,ATTR=(NUM,PROT)                             
FLD0236  DFLD  POS=(02,36),LTH=0009,ATTR=(NUM,MOD)                              
         DFLD  'Backup-printer',                                       *        
               POS=(02,46),LTH=0014,ATTR=(NUM,PROT)                             
FLD0261  DFLD  POS=(02,61),LTH=0008,ATTR=(ALPHA,MOD)                            
         DFLD  'Fax-number',                                           *        
               POS=(05,02),LTH=0010,ATTR=(NUM,PROT)                             
FLD0515  DFLD  POS=(05,15),LTH=0020,ATTR=(ALPHA,MOD)                            
         DFLD  'Info-text 1 ',                                         *        
               POS=(06,02),LTH=0012,ATTR=(NUM,PROT)                             
FLD0615  DFLD  POS=(06,15),LTH=0050,ATTR=(ALPHA,MOD)                            
         DFLD  '          2 ',                                         *        
               POS=(07,02),LTH=0012,ATTR=(NUM,PROT)                             
FLD0715  DFLD  POS=(07,15),LTH=0050,ATTR=(ALPHA,MOD)                            
         DFLD  '          3 ',                                         *        
               POS=(08,02),LTH=0012,ATTR=(NUM,PROT)                             
FLD0815  DFLD  POS=(08,15),LTH=0050,ATTR=(ALPHA,MOD)                            
         DFLD  '          4 ',                                         *        
               POS=(09,02),LTH=0012,ATTR=(NUM,PROT)                             
FLD0915  DFLD  POS=(09,15),LTH=0050,ATTR=(ALPHA,MOD)                            
         DFLD  '          5 ',                                         *        
               POS=(10,02),LTH=0012,ATTR=(NUM,PROT)                             
FLD1015  DFLD  POS=(10,15),LTH=0050,ATTR=(ALPHA,MOD)                            
         DFLD  'Fax-number examples:',                                 *        
               POS=(15,02),LTH=0019,ATTR=(NUM,PROT)                             
         DFLD  'To Göteborg       :0123456       0 + fax no',          *        
               POS=(16,02),LTH=0079,ATTR=(NUM,PROT)                             
         DFLD  'To rest of Sweden :0021123456    0 + normal area code +*        
                fax no',                                               *        
               POS=(17,02),LTH=0079,ATTR=(NUM,PROT)                             
         DFLD  'To other country  :0004761123456 0 + 00 + country code *        
               + area code + fax no',                                  *        
               POS=(18,02),LTH=0079,ATTR=(NUM,PROT)                             
         DFLD  'F1=Help          F10=WHELP F11=Update F12=Logoff',     *        
               POS=(22,02),LTH=0048,ATTR=(NUM,PROT)                             
FLD2302  DFLD  POS=(23,02),LTH=0055,ATTR=(NUM,PROT,HI)                          
         DFLD  ' VCP ',POS=(23,58),ATTR=(NUM,PROT)                              
FLD2364  DFLD  POS=(23,64),LTH=0008,ATTR=(NUM,PROT)                             
FLD2373  DFLD  POS=(23,73),LTH=0008,ATTR=(NUM,PROT)                             
FSYSMSG  DFLD  POS=(24,02),LTH=0079,ATTR=(NUM,PROT,HI)                          
         FMTEND                                                                 
         EJECT                                                                  
