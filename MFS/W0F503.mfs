FLD1102  DFLD  POS=(11,02),LTH=0079,ATTR=PROT                                   
FLD1202  DFLD  POS=(12,02),LTH=0079,ATTR=PROT                                   
FLD1302  DFLD  POS=(13,02),LTH=0079,ATTR=PROT                                   
FLD1402  DFLD  POS=(14,02),LTH=0079,ATTR=PROT                                   
