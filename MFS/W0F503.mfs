         TITLE 'PARTS MENY FÖR WINFO'                                           
         PRINT NOGEN                                                            
W0F503   FMT                                                                    
         DEV   TYPE=(3270,2),                                          *        
               FEAT=IGNORE,                                            *        
               PFK=(FLDPFK,'W0T551U ','WINFO   ','W0T503  ','W0T501  ',*        
               'W0T501  ','W0T501  ','W0T503 7','W0T503 8','W0T501  ', *        
               'WHELP   ','W0T503  ','/RCL.   ','MEMORS  ','MEMOPV  ', *        
               'W0T501  ','W0T501  ','W0T501  ','W0T501  ','W0T501  ', *        
               'W0T501  ','W0T501  ','RHELP   ','W0T503  ','/RCL.   '),*        
               DSCA=X'0080',                                           *        
               SYSMSG=FSYSMSG                                                   
         STACK ON,FORM                                                          
         DIV   TYPE=INOUT                                                       
         DPAGE CURSOR=((02,25)),FILL=NONE                                       
         ALPHA 'abcdefghijklmnopqrstuvwxyzåäöéü'                                
         DFLD  'WINFO    ',POS=(01,02)                                          
         DFLD  'Parts-info/news  / Parts-info/news    ',POS=(01,12)             
         DFLD  'VOLVO CAR AFTERSALES',POS=(01,58)                               
         DFLD  'Välj bild eller meny  ',POS=(02,02)                             
IDTRANS  DFLD  POS=(02,25),LTH=0005,ATTR=(ALPHA,MOD)                            
         DFLD  'tryck PF10',POS=(02,31)                                         
         DFLD  'Select picture or menu',POS=(03,02)                             
         DFLD  'press PF10',POS=(03,31)                                         
FLD0402  DFLD  POS=(04,02),LTH=0079,ATTR=PROT                                   
FLD0502  DFLD  POS=(05,02),LTH=0079,ATTR=PROT                                   
FLD0602  DFLD  POS=(06,02),LTH=0079,ATTR=PROT                                   
FLD0702  DFLD  POS=(07,02),LTH=0079,ATTR=PROT                                   
