FLD1702  DFLD  POS=(17,02),LTH=0079,ATTR=PROT                                   
FLD1802  DFLD  POS=(18,02),LTH=0079,ATTR=PROT                                   
FLD1902  DFLD  POS=(19,02),LTH=0079,ATTR=PROT                                   
FLD2002  DFLD  POS=(20,02),LTH=0079,ATTR=PROT                                   
FLD2102  DFLD  POS=(21,02),LTH=0079,ATTR=PROT                                   
FLD2202  DFLD  POS=(22,02),LTH=0079,ATTR=PROT                                   
FLD2302  DFLD  POS=(23,02),LTH=0055,ATTR=(NUM,PROT,HI)                          
         DFLD  ' VCP ',POS=(23,58)                                              
FLD2364  DFLD  POS=(23,64),LTH=0008,ATTR=(NUM,PROT)                             
FLD2373  DFLD  POS=(23,73),LTH=0008,ATTR=(NUM,PROT)                             
FSYSMSG  DFLD  POS=(24,02),LTH=0079,ATTR=(NUM,PROT,HI)                          
         STACK OFF                                                              
         DEV   TYPE=3270-A7,                                           *        
               FEAT=IGNORE,                                            *        
               PFK=(FLDPFK,'W0T551U ','WINFO   ','W0T503  ','W0T501  ',*        
               'W0T501  ','W0T501  ','W0T503 7','W0T503 8','W0T501  ', *        
               'WHELP   ','W0T503  ','/RCL.   ','MEMORS  ','MEMOPV  ', *        
               'W0T501  ','W0T501  ','W0T501  ','W0T501  ','W0T501  ', *        
               'W0T501  ','W0T501  ','RHELP   ','W0T503  ','/RCL.   '),*        
               DSCA=X'0080',                                           *        
               SYSMSG=FSYSMSG                                                   
         UNSTACK FORM,DELETE                                                    
         FMTEND                                                                 
         EJECT                                                                  
W0I50301 MSG   TYPE=INPUT,                                             *        
               SOR=W0F503,                                             *        
               OPT=2,                                                  *        
               NXT=W0O50301                                                     
         SEG                                                                    
         MFLD  FLDPFK,LTH=008,FILL=NULL                                         
         MFLD  'WINFO   ',LTH=008                                               
         MFLD  IDTRANS,LTH=0005,FILL=C'0'                                       
         MSGEND                                                                 
         EJECT                                                                  
W0O50301 MSG   TYPE=OUTPUT,                                            *        
               SOR=(W0F503,IGNORE),                                    *        
               OPT=2,                                                  *        
               NXT=W0I50301,                                           *        
               FILL=PT,                                                *        
               PAGE=NO                                                          
         SEG                                                                    
         MFLD  IDTRANS,LTH=0005                                                 
         MFLD  (FLD0402,' '),LTH=0001                                           
         MFLD  FLD0502,LTH=0079                                                 
         MFLD  FLD0602,LTH=0079                                                 
         MFLD  FLD0702,LTH=0079                                                 
         MFLD  FLD0802,LTH=0079                                                 
         MFLD  FLD0902,LTH=0079                                                 
         MFLD  FLD1002,LTH=0079                                                 
         MFLD  FLD1102,LTH=0079                                                 
