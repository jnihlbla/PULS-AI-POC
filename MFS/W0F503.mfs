         MFLD  (FLD2102,' '),LTH=0001                                           
         MFLD  (FLD2202,'PF1=Hjälp/Help   PF2=Info./News   PF13=MEMORS *        
                 PF14 MEMOPV   PF22=RHELP '),                          *        
               LTH=0079                                                         
         MFLD  FLD2302,LTH=0055                                                 
         MFLD  (FLD2364,DATE4)                                                  
         MFLD  (FLD2373,TIME)                                                   
         MFLD  (FSYSMSG,' '),LTH=0001                                           
         MSGEND                                                                 
