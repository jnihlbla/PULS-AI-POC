W1N161   FMT                                                                    
         DEV   TYPE=(3270,2),                                          *        
               FEAT=IGNORE,                                            *        
               PFK=(FLDPFK,'W0T501  ','W0T501  ','W0T501  ','W0T501  ',*        
               'W0T501  ','W0T501  ','W1T161 7','W1T161 8','W1T114  ', *        
               'WHELP   ','W0T501  ','/RCL.   ','W1T161  ','W0T501  ', *        
               'W0T501  ','W0T501  ','W0T501  ','W0T501  ','W0T501  ', *        
               'W0T501  ','W0T501  ','WHELP   ','W0T501  ','/RCL.   '),*        
               DSCA=X'0080',SYSMSG=FSYSMSG                                      
         DIV   TYPE=INOUT                                                       
         DPAGE CURSOR=((02,12)),                                       *        
               FILL=NONE                                                        
FLD0102  DFLD  POS=(01,02),LTH=0001,ATTR=(ALPHA,NOPROT,MOD)                     
FLD0104  DFLD  POS=(01,04),LTH=0001,ATTR=(NUM)                                  
FLD0106  DFLD  POS=(01,06),LTH=0001,ATTR=(NUM)                                  
FLD0108  DFLD  POS=(01,08),LTH=0001,ATTR=(NUM)                                  
         DFLD  'PART NUMBER DCN/PROJECT   ',                           *        
               POS=(01,10),LTH=0026,ATTR=(NUM,PROT)                             
FLD0141  DFLD  POS=(01,41),LTH=0040,ATTR=(NUM,PROT,HI)                          
         DFLD  'Project ',                                             *        
               POS=(02,02),LTH=0008,ATTR=(NUM,PROT)                             
FLD0212  DFLD  POS=(02,12),LTH=0004,ATTR=(ALPHA)                                
         DFLD  'Dcn No. ',                                             *        
               POS=(02,23),LTH=0008,ATTR=(NUM,PROT)                             
FLD0234  DFLD  POS=(02,34),LTH=0010,ATTR=(ALPHA)                                
FLD0312  DFLD  POS=(03,12),LTH=0004,ATTR=(NUM,PROT,MOD)                         
FLD0334  DFLD  POS=(03,34),LTH=0010,ATTR=(NUM,PROT,MOD)                         
FLD0402  DFLD  POS=(04,02),LTH=0009,ATTR=(NUM,PROT,MOD,NODISP)                  
FLD0415  DFLD  POS=(04,15),LTH=0010,ATTR=(NUM,PROT,MOD,NODISP)                  
FLD0430  DFLD  POS=(04,30),LTH=0009,ATTR=(NUM,PROT,MOD,NODISP)                  
FLD0445  DFLD  POS=(04,45),LTH=0010,ATTR=(NUM,PROT,MOD,NODISP)                  
         DFLD  'S    Part no. Dcn no.     S    Part no. Dcn no.     S  *        
                 Part no. Dcn no.',                                    *        
               POS=(05,02),LTH=0073,ATTR=(NUM,PROT)                             
         DO    14,SUF=06                                                        
COL02    DFLD  POS=(06,02),LTH=0001,ATTR=(ALPHA)                                
COL06    DFLD  POS=(06,06),LTH=0009,ATTR=(NUM,PROT,MOD)                         
COL16    DFLD  POS=(06,16),LTH=0010,ATTR=(NUM,PROT)                             
         ENDDO                                                                  
         DO    14,SUF=06                                                        
COL28    DFLD  POS=(06,28),LTH=0001,ATTR=(ALPHA)                                
COL32    DFLD  POS=(06,32),LTH=0009,ATTR=(NUM,PROT,MOD)                         
COL42    DFLD  POS=(06,42),LTH=0010,ATTR=(NUM,PROT)                             
         ENDDO                                                                  
         DO    14,SUF=06                                                        
COL54    DFLD  POS=(06,54),LTH=0001,ATTR=(ALPHA)                                
COL58    DFLD  POS=(06,58),LTH=0009,ATTR=(NUM,PROT,MOD)                         
COL68    DFLD  POS=(06,68),LTH=0010,ATTR=(NUM,PROT)                             
         ENDDO                                                                  
         DFLD  '13 PART DSN/PROJ 4              15             16      *        
                        17              18              19             *        
                20              9 MARKET REG    22 WHELP   ',          *        
               POS=(21,02),LTH=0156,ATTR=(NUM,PROT)                             
FLD2302  DFLD  POS=(23,02),LTH=0055,ATTR=(NUM,PROT,HI)                          
         DFLD  ' VCP ',POS=(23,58)                                              
FLD2364  DFLD  POS=(23,64),LTH=0008,ATTR=PROT                                   
FLD2373  DFLD  POS=(23,73),LTH=0008,ATTR=PROT                                   
FSYSMSG  DFLD  POS=(24,02),LTH=0079,ATTR=(NUM,PROT,HI)                          
         FMTEND                                                                 
         EJECT                                                                  
W1O161N1 MSG   TYPE=OUTPUT,                                            *        
               SOR=(W1N161,IGNORE),                                    *        
               OPT=2,                                                  *        
               NXT=W1I161N1,                                           *        
               FILL=PT,                                                *        
               PAGE=NO                                                          
         SEG                                                                    
         MFLD  FLD0102,LTH=0001                                                 
         MFLD  FLD0104,LTH=0001                                                 
         MFLD  FLD0106,LTH=0001                                                 
         MFLD  FLD0108,LTH=0001                                                 
         MFLD  FLD0141,LTH=0040                                                 
         MFLD  FLD0212,LTH=0004                                                 
         MFLD  FLD0234,LTH=0010                                                 
         MFLD  FLD0312,LTH=0004                                                 
         MFLD  FLD0334,LTH=0010                                                 
         MFLD  FLD0402,LTH=0009                                                 
         MFLD  FLD0415,LTH=0010                                                 
         MFLD  FLD0430,LTH=0009                                                 
         MFLD  FLD0445,LTH=0010                                                 
         DO    14,SUF=06                                                        
         MFLD  COL02,LTH=0001                                                   
         MFLD  COL06,LTH=0009                                                   
         MFLD  COL16,LTH=0010                                                   
         ENDDO                                                                  
         DO    14,SUF=06                                                        
         MFLD  COL28,LTH=0001                                                   
         MFLD  COL32,LTH=0009                                                   
         MFLD  COL42,LTH=0010                                                   
         ENDDO                                                                  
         DO    14,SUF=06                                                        
         MFLD  COL54,LTH=0001                                                   
         MFLD  COL58,LTH=0009                                                   
         MFLD  COL68,LTH=0010                                                   
         ENDDO                                                                  
         MFLD  FLD2302,LTH=0055                                                 
         MFLD  (FLD2364,DATE4)                                                  
         MFLD  (FLD2373,TIME)                                                   
         MFLD  (FSYSMSG,' '),LTH=1                                              
         MSGEND                                                                 
         EJECT                                                                  
W1I161N1 MSG   TYPE=INPUT,                                             *        
               SOR=W1N161,                                             *        
               OPT=2,                                                  *        
               NXT=W1O161N1                                                     
         SEG                                                                    
         MFLD  FLDPFK,LTH=0008,FILL=NULL                                        
         MFLD  'W',LTH=1                                                        
         MFLD  FLD0102,LTH=0001,FILL=C'1'                                       
         MFLD  'T',LTH=1                                                        
         MFLD  FLD0104,LTH=0001,FILL=C'1'                                       
         MFLD  FLD0106,LTH=0001,FILL=C'6'                                       
         MFLD  FLD0108,LTH=0001,FILL=C'1'                                       
         MFLD  '  ',LTH=2                                                       
         MFLD  '11612',LTH=5                                                    
         MFLD  (FLD0212,'++++'),LTH=0004,FILL=C' ',JUST=L                       
         MFLD  (FLD0234,'++++++++++'),LTH=0010,FILL=C' ',JUST=L                 
         MFLD  FLD0312,LTH=0004,FILL=C' '                                       
         MFLD  FLD0334,LTH=0010,FILL=C' '                                       
         MFLD  FLD0402,LTH=0009,FILL=C'0',JUST=R                                
         MFLD  FLD0415,LTH=0010,FILL=C' '                                       
         MFLD  FLD0430,LTH=0009,FILL=C'0',JUST=R                                
         MFLD  FLD0445,LTH=0010,FILL=C' '                                       
         DO    14,SUF=06                                                        
         MFLD  (COL02,'+'),LTH=0001,FILL=C' '                                   
         MFLD  COL06,LTH=0009,FILL=C'0',JUST=R                                  
         ENDDO                                                                  
         DO    14,SUF=06                                                        
         MFLD  (COL28,'+'),LTH=0001,FILL=C' '                                   
         MFLD  COL32,LTH=0009,FILL=C'0',JUST=R                                  
         ENDDO                                                                  
         DO    14,SUF=06                                                        
         MFLD  (COL54,'+'),LTH=0001,FILL=C' '                                   
         MFLD  COL58,LTH=0009,FILL=C'0',JUST=R                                  
         ENDDO                                                                  
         MSGEND                                                                 
         EJECT                                                                  
         END                                                                    
